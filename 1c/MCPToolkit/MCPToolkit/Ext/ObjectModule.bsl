	ИначеЕсли ИмяИнструмента = "execute_code" Тогда Включен = КонтекстРантайма.ИнструментВключен_ExecuteCode;
	ИначеЕсли ИмяИнструмента = "get_metadata" Тогда Включен = КонтекстРантайма.ИнструментВключен_GetMetadata;
	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда Включен = КонтекстРантайма.ИнструментВключен_GetEventLog;
	ИначеЕсли ИмяИнструмента = "get_object_by_link" Тогда Включен = КонтекстРантайма.ИнструментВключен_GetObjectByLink;
	ИначеЕсли ИмяИнструмента = "get_link_of_object" Тогда Включен = КонтекстРантайма.ИнструментВключен_GetLinkOfObject;
	ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда Включен = КонтекстРантайма.ИнструментВключен_FindReferences;
	ИначеЕсли ИмяИнструмента = "get_access_rights" Тогда Включен = КонтекстРантайма.ИнструментВключен_GetAccessRights;
	ИначеЕсли ИмяИнструмента = "get_bsl_syntax_help" Тогда Включен = КонтекстРантайма.ИнструментВключен_GetBslSyntaxHelp;
	ИначеЕсли ИмяИнструмента = "submit_for_deanonymization" Тогда Включен = КонтекстРантайма.ИнструментВключен_SubmitDeanon;
	ИначеЕсли ИмяИнструмента = "get_screenshot" Тогда Включен = КонтекстРантайма.ИнструментВключен_GetScreenshot;
	ИначеЕсли ИмяИнструмента = "restart_1c_session" Тогда Включен = КонтекстРантайма.ИнструментВключен_Restart1cSession;
	ИначеЕсли ИмяИнструмента = "close_1c_session" Тогда Включен = КонтекстРантайма.ИнструментВключен_Close1cSession;
	КонецЕсли;
	Если НЕ Включен Тогда
		Возврат ОтказВызоваИнструментаMCP("disabled", "Инструмент " + ИмяИнструмента + " выключен в настройках встроенного сервера.", 403);
	КонецЕсли;
	Если ИмяИнструмента = "get_bsl_syntax_help" И КонтекстРантайма.КомпонентаSyntaxHelp = Неопределено Тогда
		Возврат ОтказВызоваИнструментаMCP("unavailable", "Справка BSL недоступна: компонента справки не загружена.", 200);
	ИначеЕсли ИмяИнструмента = "get_screenshot" И КонтекстРантайма.КомпонентаScreenCapture = Неопределено Тогда
		Возврат ОтказВызоваИнструментаMCP("unavailable", "Снимок экрана недоступен: компонента захвата экрана не загружена.", 200);
	ИначеЕсли ИмяИнструмента = "submit_for_deanonymization" И НЕ КонтекстРантайма.ИспользоватьТочнуюАнонимизацию Тогда
		Возврат ОтказВызоваИнструментаMCP("unavailable", "Деанонимизация недоступна: анонимизация выключена.", 200);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьКэшТокеновМетаданныхРасширений(КонтекстРантайма)
	Если КонтекстРантайма.КэшТокеновМетаданныхРасширений = Неопределено Тогда
		КонтекстРантайма.КэшТокеновМетаданныхРасширений = Новый Соответствие;
	КонецЕсли;
	Возврат КонтекстРантайма.КэшТокеновМетаданныхРасширений;
КонецФункции

Функция ПодготовитьСервернуюКоманду(КонтекстРантайма, Команда) Экспорт
	ИмяИнструмента = "";
	Попытка
		ИмяИнструмента = КаноническоеИмяИнструментаMCP(Команда.tool);
	Исключение
		ИмяИнструмента = "";
	КонецПопытки;

	Если КаноническоеИмяИнструментаMCP(ИмяИнструмента) = Неопределено Тогда
		ВызватьИсключение "Неизвестный инструмент.";
	КонецЕсли;

	// Важно: Команда может быть фиксированной структурой (read-only), поэтому НЕ модифицируем ее.
	// Всегда работаем с копией params в обычной Структуре.
	ПараметрыИсходные = Неопределено;
	Если Команда.Свойство("params") Тогда
		ПараметрыИсходные = Команда.params;
	КонецЕсли;

	// ВАЖНО: имя "Параметры" в модуле формы может конфликтовать с одноименным
	// системным/форменным свойством (read-only). Используем уникальное имя.
	ПараметрыКоманды = Новый Структура;
	Если ПараметрыИсходные <> Неопределено Тогда
		Попытка
			Для Каждого Пара Из ПараметрыИсходные Цикл
				ПараметрыКоманды.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
		Исключение
			// Если params не коллекция/не итерируется - оставляем пустыми
		КонецПопытки;
	КонецЕсли;

	ИмяРасширения = Неопределено;
	Фильтр = "";
	Секции = Неопределено;
	НастройкиТиповКэша = Неопределено;

	Если ИмяИнструмента = "get_metadata" И ПараметрыКоманды <> Неопределено Тогда
		Если ПараметрыКоманды.Свойство("extension_name") Тогда
			ИмяРасширения = ПараметрыКоманды.extension_name;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("filter") Тогда
			Фильтр = ПараметрыКоманды.filter;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("sections") Тогда
			Секции = ПараметрыКоманды.sections;
		КонецЕсли;
		// Нормализованные настройки листания типов — общий helper с серверной валидацией;
		// при ошибке параметров ключ строится без types-суффикса: команда получит ошибку на сервере.
		ПроверкаТиповКэша = НормализоватьИПроверитьНастройкиТипов(ПараметрыКоманды);
		Если ПроверкаТиповКэша.ДетальОшибки = Неопределено Тогда
			НастройкиТиповКэша = ПроверкаТиповКэша.Настройки;
		КонецЕсли;

	КонецЕсли;

	КлючДеталей = "";

	// Добавляем токены кэша только для режима "объекты расширения" (extension_name="Имя")
	Если ИмяИнструмента = "get_metadata"
		И ИмяРасширения <> Неопределено
		И ТипЗнч(ИмяРасширения) = Тип("Строка")
		И НЕ ПустаяСтрока(ИмяРасширения) Тогда

		Кэш = ПолучитьКэшТокеновМетаданныхРасширений(КонтекстРантайма);
		Запись = Кэш.Получить(ИмяРасширения);

		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"hash, data_token, index_token, details, details_order",
				"",
				Неопределено,
				Неопределено,
				Новый Соответствие,
				Новый Массив
			);
			Кэш.Вставить(ИмяРасширения, Запись);
		КонецЕсли;

		Если Запись.hash <> "" Тогда
			ПараметрыКоманды.Вставить("mcp_cache_hash", Запись.hash);
		КонецЕсли;
		Если Запись.data_token <> Неопределено Тогда
			ПараметрыКоманды.Вставить("mcp_cache_data_token", Запись.data_token);
		КонецЕсли;
		Если Запись.index_token <> Неопределено Тогда
			ПараметрыКоманды.Вставить("mcp_cache_index_token", Запись.index_token);
		КонецЕсли;

		Если НЕ ПустаяСтрока(Фильтр) Тогда
			КлючДеталей = СформироватьКлючКэшаДеталейРасширения(Фильтр, Секции, НастройкиТиповКэша);
			ТокенДеталей = Запись.details.Получить(КлючДеталей);
			Если ТокенДеталей <> Неопределено Тогда
				ПараметрыКоманды.Вставить("mcp_cache_details_token", ТокенДеталей);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Передаем на сервер копию команды с измененными params (если добавили токены кэша)
	КомандаНаСервер = Новый Структура;
	Попытка
		Если Команда.Свойство("id") Тогда
			КомандаНаСервер.Вставить("id", Команда.id);
		КонецЕсли;
	Исключение
	КонецПопытки;
	АнонСхемаПринудительно = Ложь;
	Если КонтекстРантайма.РежимПодключения <> 0 И КонтекстРантайма.ИспользоватьТочнуюАнонимизацию
		И ИмяИнструмента = "execute_query" Тогда
		АнонАгентЗапросилСхему = ПараметрыКоманды.Свойство("include_schema")
			И ПараметрыКоманды.include_schema = Истина;
		Если НЕ АнонАгентЗапросилСхему Тогда
			ПараметрыКоманды.Вставить("include_schema", Истина);
			АнонСхемаПринудительно = Истина;
		КонецЕсли;
	КонецЕсли;
	КомандаНаСервер.Вставить("tool", ИмяИнструмента);
	КомандаНаСервер.Вставить("params", ПараметрыКоманды);
	Если ИмяИнструмента = "get_metadata" И ТипЗнч(ИмяРасширения) = Тип("Строка") Тогда
		Если НЕ ПустаяСтрока(ИмяРасширения) Тогда
			КомандаНаСервер.Вставить("ВладелецКэшаМетаданных", КонтекстРантайма.ВладелецХранилища);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура(
		"Команда, ИмяРасширения, Фильтр, Секции, НастройкиТиповКэша, КлючДеталей, АнонСхемаПринудительно",
		КомандаНаСервер, ИмяРасширения, Фильтр, Секции, НастройкиТиповКэша, КлючДеталей, АнонСхемаПринудительно);
КонецФункции

Функция АдресаКэшаМетаданныхРасширения(ЗаписьКэша)
	Адреса = Новый Соответствие;
	Если ТипЗнч(ЗаписьКэша.data_token) = Тип("Строка") И НЕ ПустаяСтрока(ЗаписьКэша.data_token) Тогда
		Адреса.Вставить(ЗаписьКэша.data_token, Истина);
	КонецЕсли;
	Если ТипЗнч(ЗаписьКэша.index_token) = Тип("Строка") И НЕ ПустаяСтрока(ЗаписьКэша.index_token) Тогда
		Адреса.Вставить(ЗаписьКэша.index_token, Истина);
	КонецЕсли;
	Для Каждого ПараДеталей Из ЗаписьКэша.details Цикл
		Если ТипЗнч(ПараДеталей.Значение) = Тип("Строка") И НЕ ПустаяСтрока(ПараДеталей.Значение) Тогда
			Адреса.Вставить(ПараДеталей.Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Адреса;
КонецФункции

Процедура УдалитьУстаревшийКэшМетаданныхНаСервере(АдресаКэша)
	Для Каждого АдресКэша Из АдресаКэша Цикл
		Попытка
			УдалитьИзВременногоХранилища(АдресКэша);
		Исключение
			// Адрес мог уже исчезнуть при восстановлении сеанса.
			// Оставшиеся привязанные значения удалятся при закрытии формы.
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ВсеОперацииАвтоРазрешены(КонтекстРантайма, МассивОпасныхСлов) Экспорт

	// Соответствие ключевых слов и флагов автоматического разрешения
	СоответствиеФлагов = Новый Соответствие;
	СоответствиеФлагов.Вставить("ЗАПИСАТЬ", КонтекстРантайма.АвтоРазрешитьЗаписать);
	СоответствиеФлагов.Вставить("WRITE", КонтекстРантайма.АвтоРазрешитьЗаписать);
	СоответствиеФлагов.Вставить("УСТАНОВИТЬПРИВИЛЕГИРОВАННЫЙРЕЖИМ", КонтекстРантайма.АвтоРазрешитьПривилегированныйРежим);
	СоответствиеФлагов.Вставить("SETPRIVILEGEDMODE", КонтекстРантайма.АвтоРазрешитьПривилегированныйРежим);

	// Проверка каждого опасного слова
	Для Каждого Слово Из МассивОпасныхСлов Цикл
		СловоВерхнийРегистр = ВРег(Слово);
		ФлагРазрешения = СоответствиеФлагов.Получить(СловоВерхнийРегистр);

		Если ФлагРазрешения = Неопределено Или ФлагРазрешения = Ложь Тогда
			Возврат Ложь; // Есть неразрешённая операция
		КонецЕсли;
	КонецЦикла;

	Возврат Истина; // Все операции автоматически разрешены

КонецФункции

Функция СформироватьСхемуОбъектаДляАнонимизации(МетаданныеОбъекта, ПолноеИмяОбъекта, ЭтоВнешняяТаблица)

	МассивКолонок = Новый Массив;

	// _presentation — только для обычных объектов.
	// Для внешних источников _presentation = "" — в схему не добавляем.
	// source = ПолноеИмяОбъекта + ".Ссылка" — чтобы exact source rules
	// (напр. Справочник.Контрагенты.Ссылка) работали и для _presentation.
	Если НЕ ЭтоВнешняяТаблица Тогда
		ЧастиИмени = РазделитьСтрокуПоРазделителю(ПолноеИмяОбъекта, ".");
		ТипСсылкиStr = "";
		Если ЧастиИмени.Количество() >= 2 Тогда
			ТипСсылкиStr = ЧастиИмени[0] + "Ссылка." + ЧастиИмени[1];
		КонецЕсли;
		МассивИсточников = Новый Массив;
		МассивИсточников.Добавить(ПолноеИмяОбъекта + ".Ссылка");
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипСсылкиStr);
		МассивКолонок.Добавить(Новый Структура("name, types, sources",
			"_presentation", МассивТипов, МассивИсточников));
	КонецЕсли;

	// Стандартные реквизиты (Код, Наименование, Дата, Номер) — только для обычных объектов
	Если НЕ ЭтоВнешняяТаблица Тогда
		Попытка
			Для Каждого СтдРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				МассивТипов = Новый Массив;
				Для Каждого Тип Из СтдРеквизит.Тип.Типы() Цикл
					МассивТипов.Добавить(ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип));
				КонецЦикла;
				МассивИсточников = Новый Массив;
				МассивИсточников.Добавить(ПолноеИмяОбъекта + "." + СтдРеквизит.Имя);
				МассивКолонок.Добавить(Новый Структура("name, types, sources",
					СтдРеквизит.Имя, МассивТипов, МассивИсточников));
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Пользовательские реквизиты / поля внешней таблицы
	Если ЭтоВнешняяТаблица Тогда
		КоллекцияРеквизитов = МетаданныеОбъекта.Поля;
	Иначе
		КоллекцияРеквизитов = МетаданныеОбъекта.Реквизиты;
	КонецЕсли;
	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
		МассивТипов = Новый Массив;
		Попытка
			Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
				МассивТипов.Добавить(ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип));
			КонецЦикла;
		Исключение
		КонецПопытки;
		МассивИсточников = Новый Массив;
		МассивИсточников.Добавить(ПолноеИмяОбъекта + "." + Реквизит.Имя);
		МассивКолонок.Добавить(Новый Структура("name, types, sources",
			Реквизит.Имя, МассивТипов, МассивИсточников));
	КонецЦикла;

	// Табличные части — только для обычных объектов
	СоответствиеТЧ = Новый Соответствие;
	Если НЕ ЭтоВнешняяТаблица Тогда
		Попытка
			Для Каждого ТЧ Из МетаданныеОбъекта.ТабличныеЧасти Цикл
				МассивКолТЧ = Новый Массив;
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					МассивТипов = Новый Массив;
					Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
						МассивТипов.Добавить(ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип));
					КонецЦикла;
					МассивИсточников = Новый Массив;
					МассивИсточников.Добавить(ПолноеИмяОбъекта + "." + ТЧ.Имя + "." + Реквизит.Имя);
					МассивКолТЧ.Добавить(Новый Структура("name, types, sources",
						Реквизит.Имя, МассивТипов, МассивИсточников));
				КонецЦикла;
				СоответствиеТЧ.Вставить(ТЧ.Имя, Новый Структура("columns", МассивКолТЧ));
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("columns, tabular_sections", МассивКолонок, СоответствиеТЧ);

КонецФункции

Функция ПрименитьТочнуюPolicyКРезультатуExecuteQuery(КонтекстРантайма, Результат, ОтключитьАгрессивныйРежим = Ложь) Экспорт

	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ Результат.Свойство("schema") Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат.schema = Неопределено Или ТипЗнч(Результат.schema) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат);
	Если НастройкиАнонимизации = Неопределено Тогда Возврат Результат; КонецЕсли;
	ПравилаТочнойАнонимизации = НастройкиАнонимизации.Правила;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;
	Если ОтключитьАгрессивныйРежим Тогда
		АгрессивныйРежим = Ложь;
	КонецЕсли;
	КешРазыменования = Неопределено;
	Если НуженКешРазыменования(Результат.schema, ПравилаТочнойАнонимизации) Тогда
		КешРазыменования = ВычислитьКешРазыменованияДляSchema(Результат.schema, ПравилаТочнойАнонимизации);
	КонецЕсли;
	ПрименитьТочнуюPolicyКSchema(Результат.schema, ПравилаТочнойАнонимизации, КешРазыменования, АгрессивныйРежим);
	Возврат Результат;

КонецФункции

Функция ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(КонтекстРантайма, Результат) Экспорт

	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат Результат; КонецЕсли;
	Если НЕ Результат.Свойство("data") Или ТипЗнч(Результат.data) <> Тип("Структура") Тогда Возврат Результат; КонецЕсли;

	ТипОбъекта = "";
	Если НЕ Результат.data.Свойство("_type", ТипОбъекта) Тогда
		// Fail-closed: тип объекта неизвестен — нет схемы, слепая анонимизация строк
		Результат.Вставить("_blind_anonymization", Истина);
		Результат.Вставить("_anon_schema_forced",  Истина);
		Возврат Результат;
	КонецЕсли;

	ЭтоВнешняяТаблица = (НРег(Лев(ТипОбъекта, СтрДлина("внешнийисточникданных."))) = "внешнийисточникданных.");

	МетаданныеОбъекта = Неопределено;
	Попытка
		Если ЭтоВнешняяТаблица Тогда
			// Парсим "ВнешнийИсточникДанных.ИмяИсточника.Таблица.ИмяТаблицы"
			Части = РазделитьСтрокуПоРазделителю(ТипОбъекта, ".");
			Если Части.Количество() = 4 Тогда
				МетаИсточника = Метаданные.ВнешниеИсточникиДанных.Найти(Части[1]);
				Если МетаИсточника <> Неопределено Тогда
					МетаданныеОбъекта = МетаИсточника.Таблицы.Найти(Части[3]);
				КонецЕсли;
			КонецЕсли;
		Иначе
			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ТипОбъекта);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если МетаданныеОбъекта = Неопределено Тогда
		// Fail-closed: метаданные недоступны — слепая анонимизация строк
		Результат.Вставить("_blind_anonymization", Истина);
		Результат.Вставить("_anon_schema_forced",  Истина);
		Возврат Результат;
	КонецЕсли;

	Схема = СформироватьСхемуОбъектаДляАнонимизации(МетаданныеОбъекта, ТипОбъекта, ЭтоВнешняяТаблица);

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат);
	Если НастройкиАнонимизации = Неопределено Тогда Возврат Результат; КонецЕсли;
	Правила = НастройкиАнонимизации.Правила;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;

	// Основные колонки
	КешРазыменования = Неопределено;
	Если НуженКешРазыменования(Схема, Правила) Тогда
		КешРазыменования = ВычислитьКешРазыменованияДляSchema(Схема, Правила);
	КонецЕсли;
	ПрименитьТочнуюPolicyКSchema(Схема, Правила, КешРазыменования, АгрессивныйРежим);

	// Табличные части
	Для Каждого КВП Из Схема.tabular_sections Цикл
		СхемаТЧ = КВП.Значение;
		КешТЧ = Неопределено;
		Если НуженКешРазыменования(СхемаТЧ, Правила) Тогда
			КешТЧ = ВычислитьКешРазыменованияДляSchema(СхемаТЧ, Правила);
		КонецЕсли;
		ПрименитьТочнуюPolicyКSchema(СхемаТЧ, Правила, КешТЧ, АгрессивныйРежим);
	КонецЦикла;

	Результат.Вставить("_anon_schema_forced", Истина);
	Результат.Вставить("schema", Схема);
	Возврат Результат;

КонецФункции

Функция НормализоватьКлючПутиАнонимизации(ПутьИсточника)
	Возврат ВРег(ПутьИсточника);
КонецФункции

Функция ПолучитьПравилоПоПутиАнонимизации(ИндексПравил, ПутьИсточника)
	Возврат ИндексПравил.Получить(НормализоватьКлючПутиАнонимизации(ПутьИсточника));
КонецФункции

Функция ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат)

	Попытка
		Возврат КонтекстРантайма.НастройкиТочнойАнонимизации;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если Найти(ТекстОшибки, "MCP_EXACT_RULE_CONFLICT:") = 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		ЗаписатьКонфликтТочныхПравилВРезультат(Результат, ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ЗаписатьКонфликтТочныхПравилВРезультат(Результат, ТекстОшибки)

	// Меняем тот же объект: все контексты отправки увидят ошибку без копий исходных данных.
	Результат.Очистить();
	Результат.Вставить("success", Ложь);
	Результат.Вставить("error", Сред(ТекстОшибки, Найти(ТекстОшибки, "MCP_EXACT_RULE_CONFLICT:")));

КонецПроцедуры

Процедура ПрименитьТочнуюPolicyКSchema(Schema, ПравилаТочнойАнонимизации, КешРазыменования = Неопределено, АгрессивныйРежим = Ложь)

	Колонки = Неопределено;
	Если НЕ Schema.Свойство("columns", Колонки) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Колонка.Вставить("anonymization_mode", "default");
		Колонка.Вставить("reference_presentation_mode", "default");
		Если ЭтоБулеваКолонкаСхемы(Колонка) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоПеречислениеКолонкаСхемы(Колонка) Тогда
			Колонка.Вставить("anonymization_mode", "force_keep");
			Колонка.Вставить("reference_presentation_mode", "force_keep");
			Продолжить;
		КонецЕсли;

		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		ТекущийРежим = ВычислитьРежимПоSources(Sources, ПравилаТочнойАнонимизации);
		Если ТекущийРежим = "default" И КешРазыменования <> Неопределено Тогда
			ТекущийРежим = ВычислитьРежимПоSourcesИзКеша(Sources, ПравилаТочнойАнонимизации, КешРазыменования);
		КонецЕсли;
		// Строковые колонки, чьи источники через метаданные ведут к ПланыСчетов —
		// защищаем по умолчанию (например, СчетДт.Представление, СчетДт.Код).
		Если КолонкаСтроковаяПоСхеме(Колонка)
			И ТекущийРежим <> "force_anonymize"
			И ИсточникиВедутКПланамСчетов(Sources) Тогда
			Колонка.Вставить("anonymization_mode", "force_keep");
			Колонка.Вставить("reference_presentation_mode", "force_keep");
			Продолжить;
		КонецЕсли;
		РежимПредставленияСсылки = ВычислитьРежимПредставленияСсылки(Колонка, Sources, ПравилаТочнойАнонимизации);
		// Планы счетов — нормативные данные без персональных данных: по умолчанию не анонимизируем.
		// Оба режима уже вычислены из явных правил. Если нет явного force_anonymize — защищаем.
		Если ЭтоПланСчетовКолонкаСхемы(Колонка)
			И ТекущийРежим <> "force_anonymize"
			И РежимПредставленияСсылки <> "force_anonymize" Тогда
			Колонка.Вставить("anonymization_mode", "force_keep");
			Колонка.Вставить("reference_presentation_mode", "force_keep");
			Продолжить;
		КонецЕсли;

		Если КолонкаСтроковаяПоСхеме(Колонка) И РежимПредставленияСсылки <> "default" Тогда
			ТекущийРежим = ОбъединитьРежимыPolicy(ТекущийРежим, РежимПредставленияСсылки);
		Иначе
			Колонка.Вставить("reference_presentation_mode", РежимПредставленияСсылки);
		КонецЕсли;

		Колонка.Вставить("anonymization_mode", ТекущийРежим);
	КонецЦикла;

КонецПроцедуры

Функция НуженКешРазыменования(Schema, ПравилаТочнойАнонимизации)

	Колонки = Неопределено;
	Если НЕ Schema.Свойство("columns", Колонки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		Для Каждого SourcePath Из Sources Цикл
			Если ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, SourcePath) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КоличествоТочек = СтрДлина(SourcePath) - СтрДлина(СтрЗаменить(SourcePath, ".", ""));
			Если КоличествоТочек >= 3 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НайтиВКоллекцииПоИмени(Коллекция, ИмяПоля)
	Попытка
		Для Каждого Рекв Из Коллекция Цикл
			Если НРег(Рекв.Имя) = НРег(ИмяПоля) Тогда
				Возврат Рекв;
			КонецЕсли;
		КонецЦикла;
	Исключение КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция НайтиРеквизитВКоллекциях(ОбъектМД, ИмяПоля)

	Рекв = Неопределено;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.СтандартныеРеквизиты, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.Реквизиты, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.Измерения, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.Ресурсы, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.РеквизитыАдресации, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция РазрешитьВиртуальныйОбъектРегистраБухгалтерии(ОбъМД, ИмяСегмента)
	// Если текущий объект — РегистрБухгалтерии И сегмент — одно из виртуальных
	// полей счёта (Счет, СчетДт, СчетКт), возвращает объект метаданных плана счетов.
	// В остальных случаях возвращает Неопределено.
	Если ОбъМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПолноеИмя = "";
	Попытка
		ПолноеИмя = ОбъМД.ПолноеИмя();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Лев(ПолноеИмя, СтрДлина("РегистрБухгалтерии.")) <> "РегистрБухгалтерии." Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНиж = НРег(ИмяСегмента);
	Если ИмяНиж <> "счет" И ИмяНиж <> "счетдт" И ИмяНиж <> "счеткт" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПланМД = Неопределено;
	Попытка
		ПланМД = ОбъМД.ПланСчетов;
	Исключение
	КонецПопытки;

	Возврат ПланМД;

КонецФункции

Функция РазрешитьПутиРазыменования(SourcePath)

	Результат = Новый Массив;
	Части = РазделитьСтрокуПоРазделителю(SourcePath, ".");

	Если Части.Количество() <= 3 Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяОбъекта = Части[0] + "." + Части[1];
	ТекущийОбъект = Неопределено;
	Попытка
		ТекущийОбъект = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Исключение КонецПопытки;
	Если ТекущийОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Контекст ТЧ хранится только на сервере. После разыменования реквизита
	// владелец сбрасывается: следующая ТЧ может принадлежать другому объекту.
	ТекущиеСостояния = Новый Массив;
	ТекущиеСостояния.Добавить(Новый Структура("ОбъектМД,ВладелецТЧ,СлужебнаяСсылкаТЧ",
		ТекущийОбъект, Неопределено, Ложь));

	КоличествоЧастей = Части.Количество();
	Для Инд = 2 По КоличествоЧастей - 2 Цикл
		СледующиеСостоянияСет = Новый Соответствие;
		Для Каждого Состояние Из ТекущиеСостояния Цикл
			ОбъМД = Состояние.ОбъектМД;
			ИмяСегмента = Части[Инд];
			Если Состояние.СлужебнаяСсылкаТЧ И ВРег(ИмяСегмента) = "ССЫЛКА"
				И Состояние.ВладелецТЧ <> Неопределено Тогда
				// В языке запросов Ссылка обычной ТЧ указывает на владельца,
				// хотя в реквизитах метаданных самой ТЧ этого поля может не быть.
				// Подтверждаем ссылочную природу владельца его стандартным полем.
				ВладелецТЧ = Состояние.ВладелецТЧ;
				СсылкаВладельца = Неопределено;
				Попытка
					СсылкаВладельца = НайтиВКоллекцииПоИмени(ВладелецТЧ.СтандартныеРеквизиты, "Ссылка");
				Исключение
					СсылкаВладельца = Неопределено;
				КонецПопытки;
				Если СсылкаВладельца <> Неопределено Тогда
					ЭтоСсылочныйВладелец = Ложь;
					Попытка
						Для Каждого ТипСсылки Из СсылкаВладельца.Тип.Типы() Цикл
							ОбъектСсылки = Метаданные.НайтиПоТипу(ТипСсылки);
							Если ОбъектСсылки <> Неопределено
								И ВРег(ОбъектСсылки.ПолноеИмя()) = ВРег(ВладелецТЧ.ПолноеИмя()) Тогда
								ЭтоСсылочныйВладелец = Истина;
							КонецЕсли;
						КонецЦикла;
					Исключение
						ЭтоСсылочныйВладелец = Ложь;
					КонецПопытки;
					Если ЭтоСсылочныйВладелец Тогда
						СледующиеСостоянияСет.Вставить("Объект:" + ВРег(ВладелецТЧ.ПолноеИмя()),
							Новый Структура("ОбъектМД,ВладелецТЧ,СлужебнаяСсылкаТЧ",
								ВладелецТЧ, Неопределено, Ложь));
					КонецЕсли;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Реквизит = НайтиРеквизитВКоллекциях(ОбъМД, ИмяСегмента);
			Если Реквизит <> Неопределено Тогда
				Попытка
					Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
						СледОбъект = Неопределено;
						Попытка
							СледОбъект = Метаданные.НайтиПоТипу(Тип);
						Исключение КонецПопытки;
						Если СледОбъект <> Неопределено Тогда
							СледующиеСостоянияСет.Вставить("Объект:" + ВРег(СледОбъект.ПолноеИмя()),
								Новый Структура("ОбъектМД,ВладелецТЧ,СлужебнаяСсылкаТЧ",
									СледОбъект, Неопределено, Ложь));
						КонецЕсли;
					КонецЦикла;
				Исключение КонецПопытки;
			Иначе
				// Fallback: виртуальные поля счёта у РегистраБухгалтерии (СчетДт, СчетКт, Счет)
				ВиртуальныйОбъект = РазрешитьВиртуальныйОбъектРегистраБухгалтерии(ОбъМД, ИмяСегмента);
				Если ВиртуальныйОбъект <> Неопределено Тогда
					СледующиеСостоянияСет.Вставить("Объект:" + ВРег(ВиртуальныйОбъект.ПолноеИмя()),
						Новый Структура("ОбъектМД,ВладелецТЧ,СлужебнаяСсылкаТЧ",
							ВиртуальныйОбъект, Неопределено, Ложь));
				КонецЕсли;
			КонецЕсли;
			// Fallback: сегмент может быть табличной частью (Товары, Строки и т.п.)
			Попытка
				ТабЧасть = НайтиВКоллекцииПоИмени(ОбъМД.ТабличныеЧасти, ИмяСегмента);
				Если ТабЧасть <> Неопределено Тогда
					КлючТЧ = "ТЧ:" + ВРег(ОбъМД.ПолноеИмя()) + ":" + ВРег(ТабЧасть.ПолноеИмя());
					СледующиеСостоянияСет.Вставить(КлючТЧ,
						Новый Структура("ОбъектМД,ВладелецТЧ,СлужебнаяСсылкаТЧ", ТабЧасть, ОбъМД, Истина));
				КонецЕсли;
			Исключение КонецПопытки;
			Попытка
				ТабЧасть = НайтиВКоллекцииПоИмени(ОбъМД.СтандартныеТабличныеЧасти, ИмяСегмента);
				Если ТабЧасть <> Неопределено Тогда
					// Для стандартных ТЧ сохраняем прежний обход реквизитов.
					// Их служебную ссылку не предполагаем по аналогии с обычной ТЧ.
					КлючТЧ = "СтандартнаяТЧ:" + ВРег(ОбъМД.ПолноеИмя()) + ":" + ВРег(ТабЧасть.ПолноеИмя());
					СледующиеСостоянияСет.Вставить(КлючТЧ,
						Новый Структура("ОбъектМД,ВладелецТЧ,СлужебнаяСсылкаТЧ", ТабЧасть, ОбъМД, Ложь));
				КонецЕсли;
			Исключение КонецПопытки;
		КонецЦикла;
		СледующиеСостояния = Новый Массив;
		Для Каждого КвП Из СледующиеСостоянияСет Цикл
			СледующиеСостояния.Добавить(КвП.Значение);
		КонецЦикла;
		ТекущиеСостояния = СледующиеСостояния;
		Если ТекущиеСостояния.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	ИмяПоследнегоПоля = Части[КоличествоЧастей - 1];
	РезультатСет = Новый Соответствие;
	Для Каждого Состояние Из ТекущиеСостояния Цикл
		ОбъМД = Состояние.ОбъектМД;
		Попытка
			РезультатСет.Вставить(ОбъМД.ПолноеИмя() + "." + ИмяПоследнегоПоля, Истина);
		Исключение КонецПопытки;
	КонецЦикла;
	Для Каждого КвП Из РезультатСет Цикл
		Результат.Добавить(КвП.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВычислитьКешРазыменованияДляSchema(Schema, ПравилаТочнойАнонимизации)

	Кеш = Новый Соответствие;
	Колонки = Неопределено;
	Если НЕ Schema.Свойство("columns", Колонки) Тогда
		Возврат Кеш;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Кеш;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		Для Каждого SourcePath Из Sources Цикл
			Если Кеш.Получить(НормализоватьКлючПутиАнонимизации(SourcePath)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, SourcePath) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Части = РазделитьСтрокуПоРазделителю(SourcePath, ".");
			Если Части.Количество() <= 3 Тогда
				Продолжить;
			КонецЕсли;
			КандидатыВсе = РазрешитьПутиРазыменования(SourcePath);
			КандидатыПути = Новый Массив;
			Для Каждого КандидатПуть Из КандидатыВсе Цикл
				Если ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, КандидатПуть) <> Неопределено Тогда
					КандидатыПути.Добавить(КандидатПуть);
				КонецЕсли;
			КонецЦикла;
			Кеш.Вставить(НормализоватьКлючПутиАнонимизации(SourcePath), КандидатыПути);
		КонецЦикла;
	КонецЦикла;

	Возврат Кеш;

КонецФункции

Функция ВычислитьРежимПоSourcesИзКеша(Sources, ПравилаТочнойАнонимизации, КешРазыменования)

	ЕстьKeep = Ложь;
	Для Каждого SourcePath Из Sources Цикл
		КандидатыПути = КешРазыменования.Получить(НормализоватьКлючПутиАнонимизации(SourcePath));
		Если КандидатыПути = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КандидатПуть Из КандидатыПути Цикл
			Если ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, КандидатПуть) <> Неопределено Тогда
				Action = ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, КандидатПуть);
				Если Action.action = "anonymize" Тогда
					Возврат "force_anonymize";
				ИначеЕсли Action.action = "keep" Тогда
					ЕстьKeep = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ЕстьKeep Тогда Возврат "force_keep"; КонецЕсли;
	Возврат "default";

КонецФункции

Функция ВычислитьРежимПоSources(Sources, ПравилаТочнойАнонимизации)

	ЕстьKeep = Ложь;
	Для Каждого SourcePath Из Sources Цикл
		Если ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, SourcePath) <> Неопределено Тогда
			Action = ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, SourcePath);
			Если Action.action = "anonymize" Тогда
				Возврат "force_anonymize";
			ИначеЕсли Action.action = "keep" Тогда
				ЕстьKeep = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьKeep Тогда
		Возврат "force_keep";
	КонецЕсли;

	Возврат "default";

КонецФункции

Функция ВычислитьРежимПредставленияСсылки(Колонка, Sources, ПравилаТочнойАнонимизации)

	ЕстьKeep = Ложь;
	Для Каждого SourcePath Из Sources Цикл
		Если СтрДлина(SourcePath) >= 7 И ВРег(Сред(SourcePath, СтрДлина(SourcePath) - 6, 7)) = ".ССЫЛКА" Тогда
			ПутьНаименования = ПолучитьПутьНаименованияПоИсточникуСсылки(SourcePath);
			Правило = ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, ПутьНаименования);
			Если Правило <> Неопределено Тогда
				Если Правило.action = "keep" Тогда
					ЕстьKeep = Истина;
				Иначе
					Возврат "force_anonymize";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьKeep Тогда Возврат "force_keep"; КонецЕсли;

	Если КолонкаСсылочнаяПоСхеме(Колонка) Тогда
		ПутьНаименования = ПолучитьПутьНаименованияПоТипамКолонки(Колонка);
		Если ЗначениеЗаполнено(ПутьНаименования) И ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, ПутьНаименования) <> Неопределено Тогда
			Возврат ?(ПолучитьПравилоПоПутиАнонимизации(ПравилаТочнойАнонимизации, ПутьНаименования).action = "keep", "force_keep", "force_anonymize");
		КонецЕсли;
	КонецЕсли;

	Возврат "default";

КонецФункции

Функция ОбъединитьРежимыPolicy(ОсновнойРежим, ДополнительныйРежим)

	Если ОсновнойРежим = "force_anonymize" Или ДополнительныйРежим = "force_anonymize" Тогда
		Возврат "force_anonymize";
	КонецЕсли;
	Если ОсновнойРежим = "force_keep" Или ДополнительныйРежим = "force_keep" Тогда
		Возврат "force_keep";
	КонецЕсли;
	Возврат "default";

КонецФункции

Функция ПолучитьМассивСтрокИзСвойства(СтруктураДанных, ИмяСвойства)

	Результат = Новый Массив;
	ЗначениеСвойства = Неопределено;
	Если НЕ СтруктураДанных.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ЗначениеСвойства) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементМассива Из ЗначениеСвойства Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Строка") И НЕ ПустаяСтрока(ЭлементМассива) Тогда
			Результат.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

