Функция ПроверитьПрежнегоВладельца(Состояние, ТолькоПроверка = Ложь)
	Если НЕ ЗначениеЗаполнено(Состояние.job_id) И НЕ Состояние.Свойство("start_key") Тогда Возврат Ложь; КонецЕсли;
	Задание = НайтиУправляющееЗаданиеСервераMCP(Состояние);
	Если Задание = Неопределено И Состояние.Свойство("start_pending") И Состояние.start_pending Тогда
		ВызватьИсключение "Исход постановки задания пока неизвестен. Обновите состояние.";
	КонецЕсли;
	Если Задание = Неопределено Тогда
		Если Состояние.state = "stopped" Или Состояние.state = "failed" Тогда ПроверитьДочерниеСервераMCP(Состояние, Ложь, ТолькоПроверка); Возврат Ложь; КонецЕсли;
		ВызватьИсключение "Прежнее задание сервера не найдено. Нажмите «Остановить», чтобы проверить завершение работы, затем повторите сохранение или запуск.";
	КонецЕсли;
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда Возврат Истина; КонецЕсли;
	ПроверитьДочерниеСервераMCP(Состояние, Ложь, ТолькоПроверка);
	Возврат Ложь;
КонецФункции

Процедура СохранитьПрофильСервераMCP(СсылкаРегистрации, ПортСервераMCP, АдресПривязки, ТокенСервераMCP, НастройкиПрофиля, ОжидаемоеПоколение) Экспорт
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Карточка = СсылкаРегистрации.ПолучитьОбъект();
		ЗаполнитьПрофильКарточкиСервераMCP(Карточка, ПортСервераMCP, АдресПривязки, ТокенСервераMCP, НастройкиПрофиля, ОжидаемоеПоколение);
		Карточка.Записать();
		ЗафиксироватьТранзакцию();
	Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
КонецПроцедуры

Процедура ЗаполнитьПрофильКарточкиСервераMCP(Карточка, ПортСервераMCP, АдресПривязки, ТокенСервераMCP, НастройкиПрофиля, ОжидаемоеПоколение)
	Если Найти(НРег(СтрокаСоединенияИнформационнойБазы()), "file=") > 0 Тогда
		ВызватьИсключение "Независимый серверный запуск требует клиент-серверной базы.";
	КонецЕсли;
	ПроверитьНастройкиСервераMCP(НастройкиПрофиля);
	Если НастройкиПрофиля.transport = "embedded" И (ПортСервераMCP < 1024 Или ПортСервераMCP > 65535 Или ПортСервераMCP <> Цел(ПортСервераMCP)) Тогда
		ВызватьИсключение "Порт должен быть целым числом от 1024 до 65535.";
	КонецЕсли;
	Если НастройкиПрофиля.transport = "embedded" И (НЕ ЗначениеЗаполнено(АдресПривязки) Или НЕ ЗначениеЗаполнено(ТокенСервераMCP)) Тогда
		ВызватьИсключение "Укажите адрес привязки и токен.";
	КонецЕсли;
	Хранилище = ПрочитатьХранилищеСервераMCP(Карточка.ХранилищеНастроек);
	Прежнее = ПрочитатьСостояниеПодБлокировкойСервераMCP(Карточка.Ссылка, Истина);
	ПоколениеПрофиля = 0;
	Если Прежнее <> Неопределено Тогда
		Если ПроверитьПрежнегоВладельца(Прежнее) Тогда ВызватьИсключение "Сначала остановите сервер MCP."; КонецЕсли;
		ПроверитьДочерниеСервераMCP(Прежнее);
		ПоколениеПрофиля = Прежнее.settings_revision;
	КонецЕсли;
	Если ОжидаемоеПоколение <> ПоколениеПрофиля Тогда ВызватьИсключение "Профиль изменён другим сеансом. Загрузите его заново."; КонецЕсли;
	Настройки = Новый Структура("version,port,bind,token,settings_user_id,settings_revision,build,binary_hash,settings,settings_changed_at",
		2, ПортСервераMCP, АдресПривязки, ТокенСервераMCP, ИдПользователяСервераMCP(), ПоколениеПрофиля + 1,
		СборкаПараллельногоЯдра(), ХешБинарникаСервераMCP(Карточка.ХранилищеОбработки.Получить()), НастройкиПрофиля, ТекущаяДатаСеанса());
	Состояние = Новый Структура("settings_revision,instance,epoch,desired,state,job_id,user_id,error,storage,children,changed_at",
		Настройки.settings_revision, "", 0, Ложь, "stopped", "", ИдПользователяСервераMCP(), "", "", Новый Массив, ТекущаяДатаСеанса());
	Состояние.Вставить("start_key", ""); Состояние.Вставить("start_pending", Ложь); Состояние.Вставить("start_user_id", "");
	СохранитьИсполнениеСервераMCP(Карточка.Ссылка, Состояние);
	Хранилище.Вставить("MCPToolkitServer", Настройки);
	Карточка.ХранилищеНастроек = Новый ХранилищеЗначения(Хранилище);
КонецПроцедуры

Процедура НачатьТранзакциюСервераMCP()
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Управление MCP недоступно внутри незавершённой транзакции."; КонецЕсли;
	НачатьТранзакцию();
