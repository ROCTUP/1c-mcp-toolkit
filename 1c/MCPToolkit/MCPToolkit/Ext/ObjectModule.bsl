Процедура СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние)
	Если НЕ ТранзакцияАктивна() Тогда ВызватьИсключение "Запись состояния MCP требует транзакции."; КонецЕсли;
	КлючРегистрации = Строка(СсылкаРегистрации.УникальныйИдентификатор());
	Исполнение = Новый Структура("schema_version,registration_id", 1, КлючРегистрации);
	Для Каждого ИмяПоля Из РазделитьСтрокуПоРазделителю(ПоляИсполненияСервераMCP(), ",") Цикл
		ЗначениеПоля = Неопределено;
		Если Состояние.Свойство(ИмяПоля, ЗначениеПоля) Тогда Исполнение.Вставить(ИмяПоля, ЗначениеПоля); КонецЕсли;
	КонецЦикла;
	ЗаписатьИсполнениеСервераMCP(КлючРегистрации, Исполнение);
КонецПроцедуры

Функция ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации, РазрешитьСтарыйФормат = Ложь)
	Настройки = ПрочитатьНастройкиРегистрацииСервераMCP(СсылкаРегистрации);
	Если Настройки = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Если ТипЗнч(Настройки) <> Тип("Структура") Или НЕ Настройки.Свойство("version") Тогда
		ВызватьИсключение "Неверный формат настроек сервера MCP.";
	КонецЕсли;
	Если Настройки.version = 1 Тогда
		Если НЕ РазрешитьСтарыйФормат Тогда ВызватьИсключение "Сохраните настройки после обновления обработки перед запуском MCP."; КонецЕсли;
		Настройки.Вставить("settings_revision", Настройки.epoch);
		Возврат Настройки;
	КонецЕсли;
	Если Настройки.version <> 2 Тогда ВызватьИсключение "Неизвестная версия настроек сервера MCP."; КонецЕсли;
	КлючРегистрации = Строка(СсылкаРегистрации.УникальныйИдентификатор());
	Исполнение = ПрочитатьИсполнениеСервераMCP(КлючРегистрации);
	Если ТипЗнч(Исполнение) <> Тип("Структура") Тогда
		ВызватьИсключение "Служебное состояние MCP отсутствует или повреждено. Исход прежнего запуска не установлен.";
	КонецЕсли;
	Для Каждого ИмяПоля Из РазделитьСтрокуПоРазделителю("schema_version,registration_id,settings_revision,instance,epoch,desired,state,job_id,user_id,error,storage,children,changed_at,start_key,start_pending,start_user_id", ",") Цикл
		Если НЕ Исполнение.Свойство(ИмяПоля) Тогда ВызватьИсключение "Служебное состояние MCP повреждено: отсутствует " + ИмяПоля; КонецЕсли;
	КонецЦикла;
	Если Исполнение.schema_version <> 1 Или Исполнение.registration_id <> КлючРегистрации
		Или Исполнение.settings_revision <> Настройки.settings_revision Тогда
		ВызватьИсключение "Служебное состояние MCP не соответствует сохранённым настройкам. Новый запуск запрещён.";
	КонецЕсли;
	Если ТипЗнч(Исполнение.desired) <> Тип("Булево") Или ТипЗнч(Исполнение.epoch) <> Тип("Число")
		Или ТипЗнч(Исполнение.start_pending) <> Тип("Булево") Или ТипЗнч(Исполнение.children) <> Тип("Массив") Тогда
		ВызватьИсключение "Неверный формат служебного состояния MCP.";
	КонецЕсли;
	Для Каждого ИмяПоля Из РазделитьСтрокуПоРазделителю("instance,state,job_id,user_id,error,storage,start_key,start_user_id", ",") Цикл
		Если ТипЗнч(Исполнение[ИмяПоля]) <> Тип("Строка") Тогда ВызватьИсключение "Неверный формат служебного состояния MCP: " + ИмяПоля; КонецЕсли;
	КонецЦикла;
	Если РазделитьСтрокуПоРазделителю("starting,running,draining,stopped,failed", ",").Найти(Исполнение.state) = Неопределено
		Или Исполнение.epoch < 0 Или Исполнение.epoch <> Цел(Исполнение.epoch) Тогда ВызватьИсключение "Неверное состояние запуска MCP."; КонецЕсли;
	Если Исполнение.state <> "stopped" И Исполнение.state <> "failed"
		И (Исполнение.instance = "" Или (Исполнение.job_id = "" И Исполнение.start_key = "")) Тогда
		ВызватьИсключение "Не удалось установить владельца MCP по сохранённому состоянию. Новый запуск запрещён.";
	КонецЕсли;
	Для Каждого ИмяПоля Из РазделитьСтрокуПоРазделителю(ПоляИсполненияСервераMCP(), ",") Цикл
		ЗначениеПоля = Неопределено;
		Если Исполнение.Свойство(ИмяПоля, ЗначениеПоля) Тогда Настройки.Вставить(ИмяПоля, ЗначениеПоля); КонецЕсли;
	КонецЦикла;
	Возврат Настройки;
КонецФункции

Функция ТотЖеЭкземплярСервераMCP(Актуальное, Контекст)
	Возврат Актуальное.instance = Контекст.instance И Актуальное.epoch = Контекст.epoch
		И Актуальное.settings_revision = Контекст.settings_revision;
КонецФункции

Функция СостояниеСервераMCP(СсылкаРегистрации) Экспорт
	СвояТранзакция = НЕ ТранзакцияАктивна();
	Если СвояТранзакция Тогда НачатьТранзакцию(); КонецЕсли;
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Состояние = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации, Истина);
		Если СвояТранзакция Тогда ЗафиксироватьТранзакцию(); КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Состояние <> Неопределено Тогда ДополнитьФактическоеСостояниеСервераMCP(Состояние); КонецЕсли;
	Возврат Состояние;
КонецФункции

Процедура ДополнитьФактическоеСостояниеСервераMCP(Состояние)
	// Диагностика чтения: не перезаписывает состояние другого экземпляра.
	Состояние.Вставить("saved_state", Состояние.state);
	Если НЕ ЗначениеЗаполнено(Состояние.job_id) Тогда Возврат; КонецЕсли;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Состояние.job_id));
	Если Задание = Неопределено Тогда Возврат; КонецЕсли;
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда Возврат; КонецЕсли;
	Если Задание.ИнформацияОбОшибке <> Неопределено И Состояние.error = "" Тогда
		Состояние.error = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;
	Если Состояние.state = "starting" Или Состояние.state = "running" Тогда
		Состояние.state = "failed";
		Если Состояние.error = "" Тогда Состояние.error = "Управляющее задание завершилось без сохранения итогового состояния."; КонецЕсли;
	ИначеЕсли Состояние.state = "draining" Тогда
		// После истечения срока остановки дети могут завершиться позже владельца.
		// Уточняем только прочитанный снимок, сохраняя saved_state и прежнюю ошибку.
		Если НЕ Состояние.Свойство("children") Тогда Возврат; КонецЕсли;
		Попытка
			Для Каждого Дочернее Из Состояние.children Цикл
				ЗаданиеДочернего = НайтиЗаданиеПараллельнойОперации(Дочернее.job_id, Дочернее.key);
				Если ЗаданиеДочернего = Неопределено Тогда Возврат; КонецЕсли;
				Если ЗаданиеДочернего.Состояние = СостояниеФоновогоЗадания.Активно Тогда Возврат; КонецЕсли;
			КонецЦикла;
		Исключение
			// Отсутствие доступа или сведений о задании не подтверждает остановку.
			Возврат;
		КонецПопытки;
		Состояние.state = "stopped";
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьЖелаемоеСостояние(СсылкаРегистрации, Запуск, ОжидаемыйЭкземпляр = Неопределено, ОжидаемоеПоколение = Неопределено)
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Состояние = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации);
		Если Состояние = Неопределено Тогда ВызватьИсключение "Сначала сохраните настройки."; КонецЕсли;
		Если ВладелецНастроекСервераMCP(Состояние) <> ИдПользователяСервераMCP() Тогда ВызватьИсключение "Пользователь отличается от пользователя, сохранившего настройки."; КонецЕсли;
		Если ОжидаемыйЭкземпляр <> Неопределено И ОжидаемыйЭкземпляр <> Состояние.instance Тогда
			ВызватьИсключение "Экземпляр сервера изменился. Обновите состояние.";
		КонецЕсли;
		Если Запуск Тогда ВызватьИсключение "Запуск выполняется через отдельный резерв."; КонецЕсли;
		Если ОжидаемоеПоколение <> Неопределено И ОжидаемоеПоколение <> Состояние.epoch Тогда ВызватьИсключение "Экземпляр сервера изменился. Обновите состояние."; КонецЕсли;
		Задание = НайтиУправляющееЗаданиеСервераMCP(Состояние);
		ПостановкаНеЗавершена = Состояние.Свойство("start_pending") И Состояние.start_pending;
		Если Задание = Неопределено И НЕ ПостановкаНеЗавершена Тогда
			// Проверка выполняется пользователем профиля. Отсутствие истории
			// завершённого задания не должно навсегда блокировать ручную остановку.
			Если Состояние.Свойство("start_key") И ЗначениеЗаполнено(Состояние.start_key) Тогда
				Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ", Состояние.start_key)).Количество() <> 0 Тогда
					ВызватьИсключение "Обнаружены задания прежнего запуска. Обновите состояние перед остановкой.";
				КонецЕсли;
			КонецЕсли;
			ПроверитьДочерниеСервераMCP(Состояние, Истина);
			Состояние.state = "stopped";
			Состояние.error = "";
		КонецЕсли;
		Состояние.desired = Запуск;
		Состояние.changed_at = ТекущаяДатаСеанса();
		СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция НайтиУправляющееЗаданиеСервераMCP(Состояние)
	Если ЗначениеЗаполнено(Состояние.job_id) Тогда
		Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Состояние.job_id));
	КонецЕсли;
	Если Состояние.Свойство("start_key") И ЗначениеЗаполнено(Состояние.start_key) Тогда
		Возврат НайтиЗаданиеПараллельнойОперации(Неопределено, Состояние.start_key);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЗапуститьСерверMCP(СсылкаРегистрации) Экспорт
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Карточка = СсылкаРегистрации.ПолучитьОбъект();
		Состояние = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации);
		Если Состояние = Неопределено Тогда ВызватьИсключение "Сначала сохраните настройки."; КонецЕсли;
		Если ВладелецНастроекСервераMCP(Состояние) <> ИдПользователяСервераMCP() Тогда ВызватьИсключение "Пользователь отличается от пользователя, сохранившего настройки."; КонецЕсли;
		Если ПроверитьПрежнегоВладельца(Состояние) Тогда
			Если НЕ Состояние.desired Тогда ВызватьИсключение "Остановка ещё не завершена."; КонецЕсли;
			ЗафиксироватьТранзакцию(); Возврат Состояние.job_id;
		КонецЕсли;
		ПроверитьСборкуСервераMCP(Карточка, Состояние);
		ПроверитьНастройкиСервераMCP(Состояние.settings);
		Состояние.instance = Строка(Новый УникальныйИдентификатор);
		Состояние.epoch = Состояние.epoch + 1;
		Состояние.job_id = ""; Состояние.state = "starting"; Состояние.desired = Истина;
		Состояние.error = "";
		Состояние.Вставить("start_key", "MCPManual-" + Состояние.instance);
		Состояние.Вставить("start_pending", Истина);
		Состояние.Вставить("start_user_id", ИдПользователяСервераMCP());
		СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние); ЗафиксироватьТранзакцию();
	Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
	АргументыЗапуска = Новый Массив;
	АргументыЗапуска.Добавить(СсылкаРегистрации); АргументыЗапуска.Добавить("СерверныйЦикл");
	// Не повторять постановку при неизвестном исходе: резерв остаётся доступен по уникальному ключу.
	Задание = ФоновыеЗадания.Выполнить("ДополнительныеОтчетыИОбработки.ВыполнитьОбработкуПоРегламентномуЗаданию",
		АргументыЗапуска, Состояние.start_key, "MCP Toolkit: сервер");
	СохранитьПостановкуСервераMCP(СсылкаРегистрации, Состояние, Строка(Задание.УникальныйИдентификатор));
	Возврат Строка(Задание.УникальныйИдентификатор);
КонецФункции

Процедура СохранитьПостановкуСервераMCP(СсылкаРегистрации, Резерв, ИдЗадания)
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Состояние = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации);
		Если Состояние = Неопределено Тогда ВызватьИсключение "Сначала сохраните настройки."; КонецЕсли;
		Если ТотЖеЭкземплярСервераMCP(Состояние, Резерв)
			И Состояние.start_key = Резерв.start_key И Состояние.start_pending Тогда
			// Задание могло уже принять резерв или получить остановку: эти поля не меняем.
			Состояние.job_id = ИдЗадания;
			СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
КонецПроцедуры

Процедура ОстановитьСерверMCP(СсылкаРегистрации, ОжидаемыйЭкземпляр, ОжидаемоеПоколение = Неопределено) Экспорт
	УстановитьЖелаемоеСостояние(СсылкаРегистрации, Ложь, ОжидаемыйЭкземпляр, ОжидаемоеПоколение);
КонецПроцедуры

Функция ЗахватитьВладениеСерверомMCP(СсылкаРегистрации, ИдЗадания, КлючЗадания = "")
	Результат = Неопределено;
	ПричинаОтказа = "";
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Карточка = СсылкаРегистрации.ПолучитьОбъект();
		Состояние = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации);
		Если Состояние = Неопределено Тогда ВызватьИсключение "Сначала сохраните настройки."; КонецЕсли;
		РучнойВход = Лев(КлючЗадания, 10) = "MCPManual-";
		РезервСвой = РучнойВход И Состояние.Свойство("start_key") И Состояние.start_key = КлючЗадания;
		РезервПринят = РезервСвой И Состояние.Свойство("start_pending") И Состояние.start_pending;
		Если РучнойВход И НЕ РезервПринят Тогда ЗафиксироватьТранзакцию(); Возврат Неопределено; КонецЕсли;
		Если РезервПринят И НЕ Состояние.desired Тогда
			Состояние.start_pending = Ложь; Состояние.job_id = ИдЗадания; Состояние.state = "stopped";
			СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние);
			ЗафиксироватьТранзакцию(); Возврат Неопределено;
		КонецЕсли;
		ПользовательРезерва = Неопределено;
		Если НЕ Состояние.Свойство("start_user_id", ПользовательРезерва) Тогда
			ПользовательРезерва = ВладелецНастроекСервераMCP(Состояние);
		КонецЕсли;
		Если РезервПринят И ПользовательРезерва <> ИдПользователяСервераMCP() Тогда
			ПричинаОтказа = "Запуск отклонён: пользователь задания отличается от пользователя профиля.";
			// Отказ относится к попытке запуска, а не к прежнему владельцу.
			// Его state/job_id/instance/error/desired остаются без изменений.
		ИначеЕсли РезервПринят Или НЕ ПроверитьПрежнегоВладельца(Состояние) Тогда
			Попытка
				ПроверитьСборкуСервераMCP(Карточка, Состояние);
				ПроверитьНастройкиСервераMCP(Состояние.settings);
			Исключение
				ПричинаОтказа = ОписаниеОшибки();
			КонецПопытки;
			Если ПричинаОтказа = "" Тогда
				// Сохраняем владельца настроек отдельно от пользователя конкретного запуска.
				Состояние.Вставить("settings_user_id", ВладелецНастроекСервераMCP(Состояние));
				Состояние.user_id = ИдПользователяСервераMCP();
				Если НЕ РезервПринят Тогда
					Состояние.epoch = Состояние.epoch + 1;
					Состояние.instance = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
				Состояние.Вставить("start_pending", Ложь);
				Состояние.Вставить("start_key", КлючЗадания);
				Состояние.desired = Истина;
				Состояние.job_id = ИдЗадания;
				Состояние.state = "starting";
				Состояние.error = "";
				Состояние.storage = "";
				Состояние.Удалить("last_start_failure");
				Состояние.Вставить("children", Новый Массив);
				Состояние.Удалить("parallel_environment");
				СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние);
				Результат = Состояние;
			КонецЕсли;
		КонецЕсли;
		Если ПричинаОтказа <> "" Тогда
			Состояние.Вставить("last_start_failure", Новый Структура("job_id,user_id,error,occurred_at",
				ИдЗадания, ИдПользователяСервераMCP(), ПричинаОтказа, ТекущаяДатаСеанса()));
			СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	// Исключение после фиксации: БСП может поглотить его, но причина уже сохранена.
	Если ПричинаОтказа <> "" Тогда ВызватьИсключение ПричинаОтказа; КонецЕсли;
	Если Результат <> Неопределено Тогда
		СобытиеСервераMCP(СсылкаРегистрации, Результат, ?(Результат.settings.transport = "proxy",
			"Запускается фоновое задание для подключения к прокси", "Сервер запускается"));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьИсходСервераMCP(СсылкаРегистрации, Контекст, Итог, ТекстОшибки = "")
	Изменилось = Ложь;
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Карточка = СсылкаРегистрации.ПолучитьОбъект();
		Состояние = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации);
		Если Состояние = Неопределено Тогда ВызватьИсключение "Сначала сохраните настройки."; КонецЕсли;
		Если ТотЖеЭкземплярСервераMCP(Состояние, Контекст) Тогда
			Если Итог = "running" Тогда
				Если НЕ Состояние.desired Тогда ВызватьИсключение "Запуск отменён."; КонецЕсли;
				ПроверитьСборкуСервераMCP(Карточка, Состояние);
			КонецЕсли;
			БылаОшибка = Состояние.error <> "";
			Изменилось = Состояние.state <> Итог Или Состояние.error <> ТекстОшибки;
			Состояние.state = Итог;
			Состояние.error = ТекстОшибки;
			Состояние.storage = Контекст.storage;
			Если Контекст.Свойство("syntax_help_status") Тогда
				Состояние.Вставить("syntax_help_status", Контекст.syntax_help_status);
				Состояние.Вставить("syntax_help_error", Контекст.syntax_help_error);
			КонецЕсли;
			Состояние.changed_at = ТекущаяДатаСеанса();
			СохранитьИсполнениеСервераMCP(СсылкаРегистрации, Состояние);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Изменилось Тогда
		РаботаЗавершена = Итог = "stopped" Или Итог = "failed";
		Если РаботаЗавершена И Контекст.Свойство("events_active") Тогда Контекст.events_active.Очистить(); КонецЕсли;
		Если Контекст.settings.transport = "proxy" Тогда
			Представления = Новый Структура("starting,running,draining,stopped,failed",
				"Запускается фоновое задание для подключения к прокси", "Фоновое задание готово к работе с прокси",
				"Останавливается фоновое задание подключения к прокси", "Фоновое задание подключения к прокси остановлено",
				"Ошибка фонового задания. См. поле «Состояние».");
			Текст = "Состояние фонового задания изменилось"; Представления.Свойство(Итог, Текст);
			Если Итог = "starting" Или Итог = "running" Тогда
				// Здесь передаются готовые сообщения подключения/опроса прокси, а не ошибки инструментов.
				Если ТекстОшибки <> "" Тогда Текст = ТекстОшибки;
				ИначеЕсли БылаОшибка Тогда Текст = "Связь с прокси восстановлена"; КонецЕсли;
			ИначеЕсли ТекстОшибки <> "" Тогда
				Текст = "Ошибка фонового задания. См. поле «Состояние».";
			КонецЕсли;
		Иначе
			Представления = Новый Структура("starting,running,draining,stopped,failed", "Сервер запускается", "Сервер работает", "Сервер останавливается", "Сервер остановлен", "Ошибка сервера");
			Текст = "Состояние сервера изменилось"; Представления.Свойство(Итог, Текст);
			Если ТекстОшибки <> "" Тогда Текст = "Ошибка сервера. См. поле «Состояние»."; КонецЕсли;
		КонецЕсли;
		СобытиеСервераMCP(СсылкаРегистрации, Контекст, Текст);
	КонецЕсли;
КонецПроцедуры

Функция РегламентноеЗаданиеСервераMCP(ИдЗадания)
	Если НЕ ЗначениеЗаполнено(ИдЗадания) Тогда Возврат Неопределено; КонецЕсли;
	Задание = Неопределено;
	ВерсияБСП = "";
	Выполнить("ВерсияБСП = СтандартныеПодсистемыСервер.ВерсияБиблиотеки();");
	// В БСП 2.1 и 2.2 модуль РегламентныеЗаданияСервер есть, но метода Задание в нём нет.
	ЭтоБСП21Или22 = Лев(ВерсияБСП, 4) = "2.1." Или Лев(ВерсияБСП, 4) = "2.2.";
	Если НЕ ЭтоБСП21Или22 И Метаданные.ОбщиеМодули.Найти("РегламентныеЗаданияСервер") <> Неопределено Тогда
		Выполнить("Задание = РегламентныеЗаданияСервер.Задание(ИдЗадания);");
	Иначе
		Выполнить("Задание = ДополнительныеОтчетыИОбработкиРегламентныеЗадания.НайтиЗадание(ИдЗадания);");
	КонецЕсли;
	Возврат Задание;
КонецФункции

Функция РасписаниеКарточкиСервераMCP(Карточка)
	Команда = Карточка.Команды.Найти("СерверныйЦикл", "Идентификатор");
	Если Команда = Неопределено Тогда ВызватьИсключение "В регистрации нет команды серверного запуска. Обновите обработку в карточке."; КонецЕсли;
	СерверныйМетод = Неопределено;
	Выполнить("СерверныйМетод = Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода;");
	Если Команда.ВариантЗапуска <> СерверныйМетод Тогда ВызватьИсключение "Команда серверного запуска имеет другой вариант выполнения."; КонецЕсли;
	Задание = РегламентноеЗаданиеСервераMCP(Команда.РегламентноеЗаданиеGUID);
	Расписание = Неопределено; Использование = Ложь;
	Если Задание <> Неопределено Тогда Расписание = Задание.Расписание; Использование = Задание.Использование; КонецЕсли;
	Публикация = Ложь;
	Выполнить("Публикация = Карточка.Публикация <> Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена;");
	Снимок = ЗначениеВСтрокуВнутр(Новый Структура("publication,id,enabled,schedule", Карточка.Публикация, Команда.РегламентноеЗаданиеGUID, Использование, Расписание));
	Возврат Новый Структура("enabled,schedule,publication,snapshot", Использование И Публикация, Расписание, Публикация, Снимок);
КонецФункции

Функция РасписаниеСервераMCP(СсылкаРегистрации) Экспорт
	Возврат РасписаниеКарточкиСервераMCP(СсылкаРегистрации.ПолучитьОбъект());
КонецФункции

Процедура ЗаполнитьРасписаниеКарточкиСервераMCP(Карточка, НовоеРасписание, ОжидаемыйСнимок)
	Текущее = РасписаниеКарточкиСервераMCP(Карточка);
	Если Текущее.snapshot <> ОжидаемыйСнимок Тогда ВызватьИсключение "Расписание изменено другим сеансом. Перечитайте настройки."; КонецЕсли;
	Если НовоеРасписание.enabled И НЕ Текущее.publication Тогда ВызватьИсключение "Публикация обработки отключена. Включите её в карточке дополнительной обработки."; КонецЕсли;
	Если НовоеРасписание.enabled И НЕ РасписаниеСервераЗаданоMCP(НовоеРасписание.schedule) Тогда ВызватьИсключение "Расписание не задано."; КонецЕсли;
	Команды = Карточка.Команды.Выгрузить();
	Команды.Колонки.Добавить("РегламентноеЗаданиеИспользование");
	Команды.Колонки.Добавить("РегламентноеЗаданиеРасписание");
	Для Каждого Команда Из Команды Цикл
		Команда.РегламентноеЗаданиеИспользование = Ложь;
		Команда.РегламентноеЗаданиеРасписание = Новый СписокЗначений;
		Задание = РегламентноеЗаданиеСервераMCP(Команда.РегламентноеЗаданиеGUID);
		Если Задание <> Неопределено Тогда
			Команда.РегламентноеЗаданиеИспользование = Задание.Использование;
			Команда.РегламентноеЗаданиеРасписание.Добавить(Задание.Расписание);
		КонецЕсли;
		Если Команда.Идентификатор = "СерверныйЦикл" Тогда
			Команда.РегламентноеЗаданиеИспользование = НовоеРасписание.enabled;
			Команда.РегламентноеЗаданиеРасписание.Очистить();
			Если НовоеРасписание.schedule <> Неопределено Тогда Команда.РегламентноеЗаданиеРасписание.Добавить(НовоеРасписание.schedule); КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Карточка.ДополнительныеСвойства.Вставить("АктуальныеКоманды", Команды);
КонецПроцедуры

Функция РасписаниеСервераЗаданоMCP(Расписание) Экспорт
	Возврат Расписание <> Неопределено И Строка(Расписание) <> Строка(Новый РасписаниеРегламентногоЗадания);
КонецФункции

Процедура СохранитьНастройкиФормыСервераMCP(СсылкаРегистрации, ДанныеПрофиля, НовоеРасписание, ОжидаемыйСнимок, ИзмененПрофиль, ИзмененоРасписание, Поколение) Экспорт
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Карточка = СсылкаРегистрации.ПолучитьОбъект();
		Если ИзмененоРасписание Тогда ЗаполнитьРасписаниеКарточкиСервераMCP(Карточка, НовоеРасписание, ОжидаемыйСнимок); КонецЕсли;
		// После обновления EPF значения полей могут остаться прежними.
		// Сохранение должно обновить и привязку настроек к зарегистрированной сборке.
		Если НЕ ИзмененПрофиль Тогда
			Хранилище = ПрочитатьХранилищеСервераMCP(Карточка.ХранилищеНастроек);
			Состояние = Неопределено;
			Хранилище.Свойство("MCPToolkitServer", Состояние);
			ИзмененПрофиль = НЕ СборкаСервераMCPСовпадает(Карточка, Состояние);
			Если ИзмененПрофиль И ИзмененоРасписание Тогда
				Прежнее = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации, Истина);
				Если Прежнее <> Неопределено Тогда
					// Расписание сохраняется и при живом либо неподтверждённом владельце.
					// Привязку сборки обновляем вместе с ним только после завершения заданий.
					Попытка
						Задание = НайтиУправляющееЗаданиеСервераMCP(Прежнее);
						Если Задание <> Неопределено Тогда
							ИзмененПрофиль = Задание.Состояние <> СостояниеФоновогоЗадания.Активно;
						Иначе
							ПостановкаНеЗавершена = Прежнее.Свойство("start_pending") И Прежнее.start_pending;
							ИзмененПрофиль = (Прежнее.state = "stopped" Или Прежнее.state = "failed")
								И НЕ ПостановкаНеЗавершена;
						КонецЕсли;
						Если ИзмененПрофиль И Прежнее.Свойство("children") Тогда
							Для Каждого Дочернее Из Прежнее.children Цикл
								ЗаданиеДочернего = НайтиЗаданиеПараллельнойОперации(Дочернее.job_id, Дочернее.key);
								Если ЗаданиеДочернего = Неопределено Тогда ИзмененПрофиль = Ложь; Прервать; КонецЕсли;
								Если ЗаданиеДочернего.Состояние = СостояниеФоновогоЗадания.Активно Тогда ИзмененПрофиль = Ложь; Прервать; КонецЕсли;
							КонецЦикла;
						КонецЕсли;
					Исключение ИзмененПрофиль = Ложь; КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ИзмененПрофиль Тогда
			ЗаполнитьПрофильКарточкиСервераMCP(Карточка, ДанныеПрофиля.port, ДанныеПрофиля.bind, ДанныеПрофиля.token, ДанныеПрофиля.settings, Поколение);
		КонецЕсли;
		Если ИзмененПрофиль Или ИзмененоРасписание Тогда Карточка.Записать(); КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
КонецПроцедуры

Функция ПрочитатьБуферСобытийСервераMCP(КлючРегистрации)
	Возврат ХранилищеОбщихНастроек.Загрузить("MCPToolkitServerEvents.v1", КлючРегистрации, , "");
КонецФункции

Процедура ЗаписатьБуферСобытийСервераMCP(КлючРегистрации, Буфер)
	ХранилищеОбщихНастроек.Сохранить("MCPToolkitServerEvents.v1", КлючРегистрации, Буфер, , "");
КонецПроцедуры

Функция НовыйБуферСобытийСервераMCP()
	Возврат Новый Структура("stream_id,next_sequence,items", Строка(Новый УникальныйИдентификатор), 1, Новый Массив);
КонецФункции

Процедура ДобавитьСобытиеВБуферСервераMCP(Буфер, Событие)
	Для Каждого Прежнее Из Буфер.items Цикл
		Если Событие.operation <> "" И Прежнее.instance = Событие.instance И Прежнее.operation = Событие.operation И Прежнее.kind = Событие.kind Тогда Возврат; КонецЕсли;
	КонецЦикла;
	Событие.Вставить("sequence", Буфер.next_sequence);
	Буфер.next_sequence = Буфер.next_sequence + 1;
	Буфер.items.Добавить(Событие);
	Пока Буфер.items.Количество() > 500 Цикл Буфер.items.Удалить(0); КонецЦикла;
КонецПроцедуры

Функция ПорцияСобытийСервераMCP(Буфер, Поток, Позиция)
	Ответ = Новый Структура("stream_id,cursor,lost,reset,items", Буфер.stream_id, Позиция, 0, Ложь, Новый Массив);
	Если Буфер.Свойство("active") Тогда Ответ.Вставить("active", Буфер.active); КонецЕсли;
	Ответ.Вставить("last_sequence", Буфер.next_sequence - 1);
	// Событие ребёнка может быть новее снимка владельца. Сохраняем номера всех
	// запросов, представленных в кольце, включая ещё не прочитанные порции.
	СохраненныеКлючи = Новый Массив;
	Для Каждого Событие Из Буфер.items Цикл
		Если Событие.operation = "" Тогда Продолжить; КонецЕсли;
		Ключ = Событие.instance + ":" + Событие.operation;
		Если СохраненныеКлючи.Найти(Ключ) = Неопределено Тогда СохраненныеКлючи.Добавить(Ключ); КонецЕсли;
	КонецЦикла;
	Ответ.Вставить("retained", СохраненныеКлючи);
	Если Поток = "" Тогда Ответ.cursor = Буфер.next_sequence - 1; Возврат Ответ; КонецЕсли;
	Если Поток <> Буфер.stream_id Тогда Ответ.reset = Истина; Позиция = 0; КонецЕсли;
	Если Буфер.items.Количество() > 0 Тогда Ответ.lost = Макс(0, Буфер.items[0].sequence - Позиция - 1); КонецЕсли;
	Для Каждого Событие Из Буфер.items Цикл
		Если Событие.sequence <= Позиция Тогда Продолжить; КонецЕсли;
		Ответ.items.Добавить(Событие); Ответ.cursor = Событие.sequence;
		Если Ответ.items.Количество() >= 100 Тогда Прервать; КонецЕсли;
	КонецЦикла;
	Если Ответ.items.Количество() = 0 И Ответ.reset Тогда Ответ.cursor = Буфер.next_sequence - 1; КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция СобытияСервераMCP(СсылкаРегистрации, Поток = "", Позиция = 0) Экспорт
	// Проверка доступа выполняется до чтения общего ключа.
	Карточка = СсылкаРегистрации.ПолучитьОбъект();
	Если Карточка = Неопределено Тогда ВызватьИсключение "Регистрация недоступна."; КонецЕсли;
	Буфер = ПрочитатьБуферСобытийСервераMCP(Строка(СсылкаРегистрации.УникальныйИдентификатор()));
	Если Буфер = Неопределено Тогда
		Буфер = НовыйБуферСобытийСервераMCP();
		// Пустой буфер не сохраняется опросом; первый издатель создаст поток.
		Буфер.stream_id = "empty";
	КонецЕсли;
	Возврат ПорцияСобытийСервераMCP(Буфер, Поток, Позиция);
КонецФункции

Процедура СобытиеСервераMCP(СсылкаРегистрации, Профиль, Вид, Операция = "", Инструмент = "", ВремяСобытия = Неопределено, Детали = "")
	ОбновитьАктивныеЗапросыЖурналаMCP(Профиль, Вид, Операция);
	Если ВремяСобытия = Неопределено Тогда ВремяСобытия = ТекущаяДатаСеанса(); КонецЕсли;
	Если НЕ Профиль.Свойство("events_lost") Тогда Профиль.Вставить("events_lost", 0); КонецЕсли;
	Если ТранзакцияАктивна() Тогда Профиль.events_lost = Профиль.events_lost + 1; Возврат; КонецЕсли;
	Попытка
		НачатьТранзакцию();
		БлокироватьКарточкуСервераMCP(СсылкаРегистрации);
		Актуальное = ПрочитатьСостояниеПодБлокировкойСервераMCP(СсылкаРегистрации);
		Если Актуальное = Неопределено Тогда ВызватьИсключение "Сначала сохраните настройки."; КонецЕсли;
		Если НЕ ТотЖеЭкземплярСервераMCP(Актуальное, Профиль) Тогда
			ЗафиксироватьТранзакцию(); Возврат;
		КонецЕсли;
		КлючРегистрации = Строка(СсылкаРегистрации.УникальныйИдентификатор());
		Буфер = ПрочитатьБуферСобытийСервераMCP(КлючРегистрации);
		Если Буфер = Неопределено Тогда Буфер = НовыйБуферСобытийСервераMCP(); КонецЕсли;
		Если Профиль.events_lost > 0 Тогда
			Потеря = Новый Структура("time,instance,operation,kind,tool", ТекущаяДатаСеанса(), Профиль.instance, "", "Пропущено событий: " + Строка(Профиль.events_lost), "");
			ДобавитьСобытиеВБуферСервераMCP(Буфер, Потеря);
		КонецЕсли;
		Событие = Новый Структура("time,instance,operation,kind,tool,details", ВремяСобытия, Профиль.instance, Строка(Операция), Лев(Вид, 500), Лев(Инструмент, 100), Детали);
		ДобавитьСобытиеВБуферСервераMCP(Буфер, Событие);
		Если Профиль.Свойство("events_active") Тогда
			Активные = Новый Массив;
			Для Каждого Пара Из Профиль.events_active Цикл Активные.Добавить(Пара.Ключ); КонецЦикла;
			Буфер.Вставить("active", Активные);
		КонецЕсли;
		ЗаписатьБуферСобытийСервераMCP(КлючРегистрации, Буфер);
		ЗафиксироватьТранзакцию(); Профиль.events_lost = 0;
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Профиль.events_lost = Профиль.events_lost + 1;
	КонецПопытки;
КонецПроцедуры

Функция КомпонентаСервераMCP(ИмяМакета, Псевдоним, Класс, КлючСервераMCP, РежимПодключения)
	Режим = РежимПодключенияКомпонентСервераMCP(Новый Структура("component_connection_mode", РежимПодключения));
	Если Режим = "isolated" Тогда
		ТипПодключения = ТипПодключенияВнешнейКомпоненты.Изолированно;
		НазваниеРежима = "Изолированно";
	Иначе
		ТипПодключения = ТипПодключенияВнешнейКомпоненты.НеИзолированно;
		НазваниеРежима = "Неизолированно";
	КонецЕсли;
	Данные = ПолучитьМакет(ИмяМакета);
	// Для неизменного макета путь одинаков во всех повторных запусках задания.
	// Ключ регистрации разделяет файлы независимо зарегистрированных серверов MCP.
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	ХешМакета = Base64Строка(Хеширование.ХешСумма);
	ИмяХеша = СтрЗаменить(СтрЗаменить(СтрЗаменить(ХешМакета, "/", "_"), "+", "-"), "=", "");
	Расширение = ?(Найти(КаталогВременныхФайлов(), "\") > 0, ".dll", ".so");
	ИмяФайла = КаталогВременныхФайлов() + "mcp-server-" + КлючСервераMCP + "-" + ИмяМакета + "-" + ИмяХеша + Расширение;
	ФайлКомпоненты = Новый Файл(ИмяФайла);
	Если НЕ ФайлКомпоненты.Существует() Тогда
		// Подготовку из формы выполняют до разрешения запуска фонового задания.
		Данные.Записать(ИмяФайла);
	КонецЕсли;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Новый ДвоичныеДанные(ИмяФайла));
	Если Base64Строка(Хеширование.ХешСумма) <> ХешМакета Тогда
		ВызватьИсключение "Файл компоненты сервера MCP повреждён: " + ИмяФайла;
	КонецЕсли;
	Попытка
		Подключена = ПодключитьВнешнююКомпоненту(ИмяФайла, Псевдоним, ТипВнешнейКомпоненты.Native, ТипПодключения);
	Исключение
		ВызватьИсключение "Не подключена компонента " + ИмяМакета + ". Запрошенный режим: " + НазваниеРежима
			+ ". Причина: " + ОписаниеОшибки();
	КонецПопытки;
	Если НЕ Подключена Тогда
		ВызватьИсключение "Не подключена компонента " + ИмяМакета + ". Запрошенный режим: " + НазваниеРежима
			+ ". ПодключитьВнешнююКомпоненту вернул Ложь.";
	КонецЕсли;
	Попытка
		Возврат Новый("AddIn." + Псевдоним + "." + Класс);
	Исключение
		Причина = ОписаниеОшибки();
		Рекомендация = "";
		Если Режим = "isolated" Тогда
			Рекомендация = " Если в этом рабочем процессе менялись набор или порядок подключения компонент либо обновлялась EPF,"
				+ " повторите запуск в новом рабочем процессе сервера 1С; перезапуска клиента недостаточно.";
		КонецЕсли;
		ВызватьИсключение "Не удалось создать серверную компоненту " + ИмяМакета
			+ ". Запрошенный режим: " + НазваниеРежима + ". Причина: " + Причина
			+ ". Файл: " + ИмяФайла + Рекомендация;
	КонецПопытки;
КонецФункции

Функция ХешБинарникаСервераMCP(Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

Функция СборкаСервераMCPСовпадает(Карточка, Состояние)
	Если Состояние = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Возврат Состояние.version = 2 И Состояние.build = СборкаПараллельногоЯдра()
		И Состояние.binary_hash = ХешБинарникаСервераMCP(Карточка.ХранилищеОбработки.Получить());
КонецФункции

Процедура ПроверитьСборкуСервераMCP(Карточка, Состояние)
	Если НЕ СборкаСервераMCPСовпадает(Карточка, Состояние) Тогда
		ВызватьИсключение "Зарегистрированная сборка изменилась. Остановите сервер, заново откройте управление MCP на сервере 1С из зарегистрированной обработки и нажмите «Сохранить настройки», затем «Запустить».";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСборкуРегистрацииСервераMCP(СсылкаРегистрации, Состояние)
	// Контроллер записывает состояние в ту же карточку. ПолучитьОбъект() вне
	// транзакции может конфликтовать с этой записью, даже если EPF не менялась.
	// Для проверки сборки читаем запросом только хранилище бинарника.
	Запрос = Новый Запрос("ВЫБРАТЬ ХранилищеОбработки ИЗ Справочник.ДополнительныеОтчетыИОбработки ГДЕ Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", СсылкаРегистрации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда ВызватьИсключение "Регистрация недоступна."; КонецЕсли;
	ПроверитьСборкуСервераMCP(Выборка, Состояние);
КонецПроцедуры

Функция РежимПодключенияКомпонентСервераMCP(Настройки) Экспорт
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда ВызватьИсключение "Неверный профиль сервера."; КонецЕсли;
	Если НЕ Настройки.Свойство("component_connection_mode") Тогда Возврат "isolated"; КонецЕсли;
	Режим = Настройки.component_connection_mode;
	Если ТипЗнч(Режим) <> Тип("Строка") Тогда ВызватьИсключение "Неверный режим подключения внешних компонент."; КонецЕсли;
	Если Режим <> "isolated" И Режим <> "not_isolated" Тогда
		ВызватьИсключение "Неверный режим подключения внешних компонент: " + Режим;
	КонецЕсли;
	Возврат Режим;
КонецФункции

Функция НастройкиСервераMCPПоУмолчанию() Экспорт
	Правила = ПрочитатьJSON2(ПолучитьМакет("НастройкиТочнойАнонимизацииПоУмолчанию").ПолучитьТекст());
	Регекс = ПрочитатьJSON2(ПолучитьМакет("НастройкиRegexПоУмолчанию").ПолучитьТекст());
	Настройки = Новый Структура("transport,parallel,anonymization,aggressive,format,allow_write,allow_privileged",
		"embedded", Ложь, Истина, Истина, 1, Ложь, Ложь);
	Настройки.Вставить("exact_rules", Правила.rules);
	Настройки.Вставить("include_infobase", Ложь);
	Настройки.Вставить("deanonymization_api_enabled", Ложь);
	Настройки.Вставить("component_connection_mode", "isolated");
	Настройки.Вставить("regex_rules", Регекс.rules);
	Настройки.Вставить("proxy_url", "http://127.0.0.1:6003");
	Настройки.Вставить("proxy_channel", "default");
	Инструменты = КаталогИнструментовСервераMCP();
	Настройки.Вставить("tools", Инструменты);
	Возврат Настройки;
КонецФункции

Процедура ПроверитьНастройкиСервераMCP(Настройки)
	РежимПодключенияКомпонентСервераMCP(Настройки);
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда ВызватьИсключение "Неверный профиль сервера."; КонецЕсли;
	Если Настройки.Свойство("deanonymization_api_enabled") И ТипЗнч(Настройки.deanonymization_api_enabled) <> Тип("Булево") Тогда
		ВызватьИсключение "Неверный флаг профиля: deanonymization_api_enabled";
	КонецЕсли;
	Если Настройки.Свойство("include_infobase") И ТипЗнч(Настройки.include_infobase) <> Тип("Булево") Тогда
		ВызватьИсключение "Неверный флаг профиля: include_infobase";
	КонецЕсли;
	Если Настройки.transport <> "embedded" И Настройки.transport <> "proxy" Тогда
		ВызватьИсключение "Неизвестный транспорт сервера MCP.";
	КонецЕсли;
	Если Настройки.transport = "proxy" Тогда АдресПроксиСервераMCP(Настройки); КонецЕсли;
	Для Каждого ИмяФлага Из РазделитьСтрокуПоРазделителю("parallel,anonymization,aggressive,allow_write,allow_privileged", ",") Цикл
		Если ТипЗнч(Настройки[ИмяФлага]) <> Тип("Булево") Тогда ВызватьИсключение "Неверный флаг профиля: " + ИмяФлага; КонецЕсли;
	КонецЦикла;
	Если Настройки.format <> 0 И Настройки.format <> 1 Тогда ВызватьИсключение "Неизвестный формат ответа."; КонецЕсли;
	Если ТипЗнч(Настройки.tools) <> Тип("Массив") Или ТипЗнч(Настройки.exact_rules) <> Тип("Массив")
		Или ТипЗнч(Настройки.regex_rules) <> Тип("Массив") Тогда ВызватьИсключение "Неверные коллекции профиля."; КонецЕсли;
	Доступные = КаталогИнструментовСервераMCP();
	Для Каждого ИмяИнструмента Из Настройки.tools Цикл
		Найден = Ложь;
		Для Каждого Инструмент Из Доступные Цикл Если Инструмент = ИмяИнструмента Тогда Найден = Истина; КонецЕсли; КонецЦикла;
		Если НЕ Найден Тогда ВызватьИсключение "Инструмент недоступен на сервере: " + Строка(ИмяИнструмента); КонецЕсли;
	КонецЦикла;
	Для Каждого Правило Из Настройки.exact_rules Цикл
		Если Правило.action <> "keep" И Правило.action <> "anonymize" Тогда ВызватьИсключение "Неизвестное действие точного правила."; КонецЕсли;
		Если НЕ ПустаяСтрока(Правило.token_category) И НЕ ЭтоВалидныйТокенФормат("[" + Правило.token_category + "-00001]") Тогда
			ВызватьИсключение "Неверная категория точного правила.";
		КонецЕсли;
	КонецЦикла;
	ИндексПравил = ПостроитьИндексПравилТочнойАнонимизации(Настройки.exact_rules);
	Для Каждого Правило Из Настройки.regex_rules Цикл
		Если ТипЗнч(Правило.enabled) <> Тип("Булево") Или ТипЗнч(Правило.pattern) <> Тип("Строка")
			Или НЕ ЭтоВалидныйТокенФормат("[" + Правило.category + "-00001]") Тогда ВызватьИсключение "Неверное Regex-правило."; КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СоздатьРантаймСервераMCP(Профиль, Владелец)
	// Локальное состояние управляющего задания; в профиль регистрации не сохраняется.
	Профиль.Вставить("events_active", Новый Соответствие);
	Рантайм = СоздатьКонтекстРантайма(Владелец, Профиль.instance, Профиль.epoch, Профиль.user_id);
	Рантайм.Вставить("ДеанонимизацияЧерезAPI", Ложь);
	Если Профиль.settings.Свойство("deanonymization_api_enabled") Тогда
		Рантайм.ДеанонимизацияЧерезAPI = Профиль.settings.deanonymization_api_enabled = Истина;
	КонецЕсли;
	ДобавлятьБазу = Ложь;
	Если Профиль.settings.Свойство("include_infobase") Тогда ДобавлятьБазу = Профиль.settings.include_infobase; КонецЕсли;
	ИсточникБазы = Null;
	Если ДобавлятьБазу Тогда
		Попытка ИсточникБазы = БезопасныйИсточникИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		Исключение КонецПопытки;
	КонецЕсли;
	Рантайм.Вставить("ИсточникОтвета", Новый Структура("Включен,База", ДобавлятьБазу, ИсточникБазы));
	Рантайм.ПоколениеТокенов = ВРег(СтрЗаменить(Профиль.instance, "-", ""));
	Рантайм.ИспользоватьТочнуюАнонимизацию = Профиль.settings.anonymization;
	Рантайм.ФорматОтветаВстроенный = Профиль.settings.format;
	Если Профиль.settings.transport = "proxy" Тогда
		// Деанонимизация, точные/Regex-замены и форматирование принадлежат Python.
		Рантайм.ИспользоватьТочнуюАнонимизацию = Ложь;
		Рантайм.ФорматОтветаВстроенный = 0;
	КонецЕсли;
	Рантайм.АвтоРазрешитьЗаписать = Профиль.settings.allow_write;
	Рантайм.АвтоРазрешитьПривилегированныйРежим = Профиль.settings.allow_privileged;
	Рантайм.ПравилаRegex = НормализоватьСтандартныеRegexПравила(Профиль.settings.regex_rules);
	Рантайм.НастройкиТочнойАнонимизации = Новый Структура("Правила,АгрессивныйРежим",
		ПостроитьИндексПравилТочнойАнонимизации(Профиль.settings.exact_rules), Профиль.settings.aggressive);
	Суффиксы = РазделитьСтрокуПоРазделителю("ExecuteQuery,ExecuteCode,GetMetadata,GetEventLog,GetObjectByLink,GetLinkOfObject,FindReferences,GetAccessRights,GetBslSyntaxHelp", ",");
	Имена = РазделитьСтрокуПоРазделителю("execute_query,execute_code,get_metadata,get_event_log,get_object_by_link,get_link_of_object,find_references_to_object,get_access_rights,get_bsl_syntax_help", ",");
	Для Индекс = 0 По Имена.Количество() - 1 Цикл
		// В прокси публикуем возможности сервера; включение инструментов задаётся на прокси.
		Рантайм["ИнструментВключен_" + Суффиксы[Индекс]] = Профиль.settings.transport = "proxy"
			Или Профиль.settings.tools.Найти(Имена[Индекс]) <> Неопределено;
	КонецЦикла;
	Рантайм.Вставить("Профиль", Профиль);
	Рантайм.Вставить("Транспорт", Неопределено);
	Рантайм.Вставить("Планировщик", СоздатьПланировщикКоманд(Профиль.instance, Профиль.epoch));
	Рантайм.Вставить("СредаЗаданий", Неопределено);
	Рантайм.Вставить("ПринимаютсяУправляющиеСобытия", Ложь);
	Рантайм.Вставить("ОжидаетсяПроверкаОтмен", Ложь);
	Рантайм.Вставить("ИсполнительСправки", СоздатьИсполнительСправки());
	Рантайм.Вставить("Регистрация", Неопределено);
	Рантайм.Вставить("КомпонентаRegex", Неопределено);
	Рантайм.Вставить("ЗагруженнаяКомпонентаСправки", Неопределено);
	Рантайм.Вставить("Прокси", Новый Структура("lease,generation,states,connected,error", "", "", Новый Соответствие, Ложь, ""));
	Возврат Рантайм;
КонецФункции

Функция ПодключитьКомплектКомпонентСервераMCP(КлючРегистрации, РежимПодключения)
	// Состав и порядок не зависят от функций профиля и транспорта: изолированные
	// подключения в рабочем процессе должны повторяться без вставки/пропуска DLL.
	Комплект = Новый Структура("Транспорт,КомпонентаRegex,КомпонентаLineage,КомпонентаТун,КомпонентаСправки,ОшибкаСправки",
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, "");
	Комплект.Транспорт = КомпонентаСервераMCP("MCPHttpTransport", "MCPServerHTTP", "MCPHttpTransport", КлючРегистрации, РежимПодключения);
	Комплект.КомпонентаRegex = КомпонентаСервераMCP("RegexHelper", "MCPServerRegex", "RegexHelper", КлючРегистрации, РежимПодключения);
	Комплект.КомпонентаLineage = КомпонентаСервераMCP("QueryLineageAnalyzer", "MCPServerLineage", "QueryLineageAnalyzer", КлючРегистрации, РежимПодключения);
	Комплект.КомпонентаТун = КомпонентаСервераMCP("ToonConverter", "MCPServerToon", "ToonConverter", КлючРегистрации, РежимПодключения);
	Попытка
		Комплект.КомпонентаСправки = КомпонентаСервераMCP("SyntaxHelpReader", "MCPServerSyntaxHelp", "SyntaxHelpReader", КлючРегистрации, РежимПодключения);
	Исключение
		// Необязательная компонента всегда последняя; её отказ не меняет базовый набор.
		Комплект.ОшибкаСправки = ОписаниеОшибки();
	КонецПопытки;
	Возврат Комплект;
КонецФункции

Функция ПолучитьСетевыеАдресаСервераMCP(СсылкаРегистрации, РежимПодключения = "isolated") Экспорт
	Ответ = Новый Структура("success,server_name,addresses,error", Ложь, "", Новый Массив, "");
	Комплект = Неопределено;
	Попытка
		Режим = РежимПодключенияКомпонентСервераMCP(Новый Структура("component_connection_mode", РежимПодключения));
		Ответ.server_name = ИмяКомпьютера();
		// Чтение регистрации обычными правами; сохранённый профиль не требуется.
		ЗапросРегистрации = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ДополнительныеОтчетыИОбработки ГДЕ Ссылка = &Ссылка");
		ЗапросРегистрации.УстановитьПараметр("Ссылка", СсылкаРегистрации);
		Если ЗапросРегистрации.Выполнить().Пустой() Тогда ВызватьИсключение "Регистрация обработки недоступна."; КонецЕсли;
		Сохраненные = ПрочитатьНастройкиРегистрацииСервераMCP(СсылкаРегистрации);
		Если Сохраненные <> Неопределено И РежимПодключенияКомпонентСервераMCP(Сохраненные.settings) <> Режим Тогда
			Попытка
				Состояние = СостояниеСервераMCP(СсылкаРегистрации);
				Если Состояние = Неопределено Тогда ВызватьИсключение "Состояние MCP не определено."; КонецЕсли;
				Если ПроверитьПрежнегоВладельца(Состояние, Истина) Тогда ВызватьИсключение "Фоновое задание выполняется."; КонецЕсли;
				ПроверитьДочерниеСервераMCP(Состояние, Ложь, Истина);
			Исключение
				ВызватьИсключение "Для обновления адресов с другим режимом подключения компонент сначала остановите MCP. " + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		Комплект = ПодключитьКомплектКомпонентСервераMCP(Строка(СсылкаРегистрации.УникальныйИдентификатор()), Режим);
		Адреса = ПрочитатьJSON2(Комплект.Транспорт.GetLocalAddresses());
		Если ТипЗнч(Адреса) <> Тип("Массив") Тогда ВызватьИсключение "Компонента вернула неверный список адресов."; КонецЕсли;
		Для Каждого Адрес Из Адреса Цикл
			Если ТипЗнч(Адрес) <> Тип("Структура") Тогда ВызватьИсключение "Компонента вернула неверную запись адреса."; КонецЕсли;
			Для Каждого ИмяПоля Из РазделитьСтрокуПоРазделителю("id,displayName,address", ",") Цикл
				Если НЕ Адрес.Свойство(ИмяПоля) Тогда ВызватьИсключение "В записи адреса отсутствует поле " + ИмяПоля; КонецЕсли;
				Если ТипЗнч(Адрес[ИмяПоля]) <> Тип("Строка") Тогда ВызватьИсключение "Неверный тип поля адреса " + ИмяПоля; КонецЕсли;
			КонецЦикла;
			Если НЕ ЭтоIPv4АдресСервераMCP(Адрес.address) Тогда ВызватьИсключение "Компонента вернула неверный IPv4-адрес."; КонецЕсли;
		КонецЦикла;
		Ответ.addresses = Адреса;
		Ответ.success = Истина;
	Исключение
		Ответ.error = ОписаниеОшибки();
	КонецПопытки;
	Комплект = Неопределено;
	Возврат Ответ;
КонецФункции

Функция ЭтоIPv4АдресСервераMCP(Адрес)
	Части = РазделитьСтрокуПоРазделителю(Адрес, ".");
	Если Части.Количество() <> 4 Тогда Возврат Ложь; КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Если СтрДлина(Часть) = 0 Или СтрДлина(Часть) > 3 Тогда Возврат Ложь; КонецЕсли;
		Для Индекс = 1 По СтрДлина(Часть) Цикл
			Если Найти("0123456789", Сред(Часть, Индекс, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
		КонецЦикла;
		Если Число(Часть) > 255 Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ЗагрузитьКомпонентыСервераMCP(Рантайм, КлючРегистрации)
	Режим = РежимПодключенияКомпонентСервераMCP(Рантайм.Профиль.settings);
	Комплект = ПодключитьКомплектКомпонентСервераMCP(КлючРегистрации, Режим);
	Рантайм.Транспорт = Комплект.Транспорт;
	Рантайм.КомпонентаRegex = Комплект.КомпонентаRegex;
	Рантайм.КомпонентаLineage = Комплект.КомпонентаLineage;
	Рантайм.КомпонентаТун = Комплект.КомпонентаТун;
	Рантайм.КомпонентаSyntaxHelp = Неопределено;
	Рантайм.ЗагруженнаяКомпонентаСправки = Комплект.КомпонентаСправки;
	Рантайм.Профиль.Вставить("syntax_help_status", ?(Рантайм.ИнструментВключен_GetBslSyntaxHelp, "недоступна", "выключена"));
	Рантайм.Профиль.Вставить("syntax_help_error", Комплект.ОшибкаСправки);
	// Сначала подключаем весь комплект, затем проверяем и настраиваем его функции.
	Возможности = ПрочитатьJSON2(Рантайм.Транспорт.GetRequestStates(""));
	Если Возможности.version <> 1 Или Рантайм.Транспорт.IsRunning Тогда ВызватьИсключение "Неверное состояние HTTP-компоненты."; КонецЕсли;
	Событие = ПрочитатьJSON2(Рантайм.Транспорт.WaitNextEvent(0));
	Если Событие.version <> 1 Или Событие.outcome <> "stopped" Тогда ВызватьИсключение "Требуется HTTP-компонента с очередью событий."; КонецЕсли;
	Если ПрофильПроксиСервераMCP(Рантайм) Тогда Рантайм.Транспорт.WaitMilliseconds(0); КонецЕсли;
	Схема = ПрочитатьJSON2(Рантайм.КомпонентаLineage.AnalyzeSources("ВЫБРАТЬ 42 КАК Значение", "{""columns"":[{""name"":""Значение""}]}"));
	Если НЕ Схема.Свойство("columns") Тогда ВызватьИсключение "Lineage не подтвердил готовность."; КонецЕсли;
	Если Рантайм.КомпонентаТун.JsonToToon("{""value"":42}") <> "value: 42" Тогда ВызватьИсключение "TOON не подтвердил готовность."; КонецЕсли;
	Совпадения = ПрочитатьJSON2(Рантайм.КомпонентаRegex.FindMatchesInTexts("[{""pattern"":""[0-9]+"",""category"":""NUM""}]", "[""stage42""]"));
	Если Совпадения.Количество() <> 1 Или Совпадения[0].Количество() <> 1
		Или Совпадения[0][0].match <> "42" Тогда ВызватьИсключение "Regex не подтвердил готовность."; КонецЕсли;
	Если Рантайм.ИспользоватьТочнуюАнонимизацию Тогда
		Для Каждого Правило Из Рантайм.ПравилаRegex Цикл
			Если Правило.enabled И Рантайм.КомпонентаRegex.ValidatePattern(Правило.pattern) <> "" Тогда
				ВызватьИсключение "Некорректное регулярное выражение серверного профиля.";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ПодготовитьСправкуСервераMCP(Рантайм);
КонецПроцедуры

Функция ПодготовитьСерверMCP(СсылкаРегистрации) Экспорт
	Профиль = СостояниеСервераMCP(СсылкаРегистрации);
	Если Профиль = Неопределено Тогда ВызватьИсключение "Сначала сохраните профиль."; КонецЕсли;
	Если ВладелецНастроекСервераMCP(Профиль) <> ИдПользователяСервераMCP() Тогда ВызватьИсключение "Проверку компонент выполняет пользователь, сохранивший настройки."; КонецЕсли;
	Если ПроверитьПрежнегоВладельца(Профиль) Тогда ВызватьИсключение "Сначала остановите сервер."; КонецЕсли;
	ПроверитьСборкуРегистрацииСервераMCP(СсылкаРегистрации, Профиль);
	Профиль.instance = Строка(Новый УникальныйИдентификатор);
	Рантайм = СоздатьРантаймСервераMCP(Профиль, Новый УникальныйИдентификатор);
	ЗагрузитьКомпонентыСервераMCP(Рантайм, Строка(СсылкаРегистрации.УникальныйИдентификатор()));
	Возврат "Обязательные компоненты проверены на сервере. Справка: " + Рантайм.Профиль.syntax_help_status
		+ ?(Рантайм.Профиль.syntax_help_error = "", "", "; " + Рантайм.Профиль.syntax_help_error);
КонецФункции

Процедура ВыполнитьЗаданиеБСП21(ОпцииКоманды)
	Если ТипЗнч(ОпцииКоманды) <> Тип("Структура") Тогда ВызватьИсключение "Служебная команда MCP требует пакет фонового задания."; КонецЕсли;
	ПакетЗапуска = Неопределено;
	Если НЕ ОпцииКоманды.Свойство("ПакетMCP", ПакетЗапуска) Тогда ВызватьИсключение "Служебная команда MCP не предназначена для ручного запуска или расписания."; КонецЕсли;
	Если ТипЗнч(ПакетЗапуска) <> Тип("Структура") Тогда ВызватьИсключение "Неверный пакет запуска MCP."; КонецЕсли;
	Пакет = Неопределено;
	Если НЕ ПакетЗапуска.Свойство("packet", Пакет) Тогда ВызватьИсключение "Не передан пакет команды MCP."; КонецЕсли;
	ПроверитьПакетЗаданияБСП21(ПакетЗапуска, Пакет);
	Регистрация = Неопределено;
	Если НЕ ОпцииКоманды.Свойство("ДополнительнаяОбработкаСсылка", Регистрация) Тогда ВызватьИсключение "Не передана регистрация MCP."; КонецЕсли;
	Если Регистрация <> ПакетЗапуска.registration Тогда ВызватьИсключение "Не совпадает регистрация фонового задания."; КонецЕсли;
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если Задание = Неопределено Тогда ВызватьИсключение "Служебная команда MCP доступна только в фоновом задании."; КонецЕсли;
	Если Задание.Ключ <> Пакет.key Тогда ВызватьИсключение "Не совпадает ключ фонового задания MCP."; КонецЕсли;
	// Проверяем карточку и именно загруженный объект: хеш карточки не доказывает версию объекта БСП.
	ПроверитьРегистрациюДляЗаданияБСП21(ПакетЗапуска);
	ПроверитьСборкуРегистрацииСервераMCP(Регистрация, Новый Структура("version,build,binary_hash", 2, Пакет.build, ПакетЗапуска.binary_hash));
	Если ХешЗагруженнойОбработкиБСП21() <> ПакетЗапуска.binary_hash Тогда
		ВызватьИсключение "БСП загрузила другую сборку MCP Toolkit; фоновое задание отклонено.";
	КонецЕсли;
	Если ПакетЗапуска.source = "server" Тогда
		ВыполнитьЗаданиеСервераMCP(ПакетЗапуска, Пакет.result_address);
	Иначе
		Конверт = ВыполнитьФоновуюКоманду(Пакет);
	КонецЕсли;
КонецПроцедуры

Функция ХешЗагруженнойОбработкиБСП21()
	ИмяИсточника = ЭтотОбъект.ИспользуемоеИмяФайла;
	АдресИсточника = СтрЗаменить(ИмяИсточника, "\", "/");
	Если ЭтоАдресВременногоХранилища(АдресИсточника) Тогда
		ДанныеИсточника = ПолучитьИзВременногоХранилища(АдресИсточника);
	ИначеЕсли ПустаяСтрока(ИмяИсточника) Или Лев(НРег(АдресИсточника), 6) = "e1cib/" Тогда
		ВызватьИсключение "Не удалось подтвердить сборку загруженного рабочего объекта MCP Toolkit.";
	Иначе
		ДанныеИсточника = Новый ДвоичныеДанные(ИмяИсточника);
	КонецЕсли;
	Если ТипЗнч(ДанныеИсточника) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Данные загруженного рабочего объекта MCP Toolkit недоступны.";
	КонецЕсли;
	Возврат ХешБинарникаСервераMCP(ДанныеИсточника);
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды = Неопределено) Экспорт
	Если ИдентификаторКоманды = "ВыполнитьФоновуюКомандуMCP" Тогда
		ВыполнитьЗаданиеБСП21(ПараметрыКоманды);
		Возврат;
	КонецЕсли;
	Если ИдентификаторКоманды <> "СерверныйЦикл" Тогда ВызватьИсключение "Неизвестная команда серверного запуска."; КонецЕсли;
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если Задание = Неопределено Тогда ВызватьИсключение "Серверный цикл доступен только в фоновом задании."; КонецЕсли;
	СсылкаРегистрации = ПараметрыКоманды.ДополнительнаяОбработкаСсылка;
	Профиль = ЗахватитьВладениеСерверомMCP(СсылкаРегистрации, Строка(Задание.УникальныйИдентификатор), Задание.Ключ);
	Если Профиль = Неопределено Тогда Возврат; КонецЕсли;
	Рантайм = Неопределено;
	ОшибкаРаботы = "";
	Попытка
		// Выключить режим, включённый вызывающим кодом, из этой процедуры нельзя.
		Если ПривилегированныйРежим() Тогда ВызватьИсключение "Сервер MCP нельзя запускать из привилегированного контекста."; КонецЕсли;
		Рантайм = СоздатьРантаймСервераMCP(Профиль, Задание.УникальныйИдентификатор);
		Рантайм.Регистрация = СсылкаРегистрации;
		ЗагрузитьКомпонентыСервераMCP(Рантайм, Строка(СсылкаРегистрации.УникальныйИдентификатор()));
		Если Рантайм.ИспользоватьТочнуюАнонимизацию Тогда
			ЗаполнитьСловарьАнонимизации(Рантайм, СловарьСервераMCP(Профиль.settings.exact_rules));
		КонецЕсли;
		Профиль.storage = ПоместитьВоВременноеХранилище(Профиль.instance, Задание.УникальныйИдентификатор);
		Если НЕ ПрофильПроксиСервераMCP(Рантайм) Тогда
			Если НЕ Рантайм.Транспорт.StartQueued(Профиль.port, Профиль.bind) Тогда
				ВызватьИсключение "Не удалось запустить встроенный MCP-сервер на " + Профиль.bind + ":" + Формат(Профиль.port, "ЧГ=0")
					+ ". Проверьте доступность адреса на рабочем сервере 1С и занятость порта.";
			КонецЕсли;
			Если Рантайм.Транспорт.Port <> Профиль.port Тогда ВызватьИсключение "Заданный порт занят."; КонецЕсли;
		КонецЕсли;
		Если Профиль.settings.parallel Тогда ПодготовитьЗаданияСервераMCP(Рантайм); КонецЕсли;
		ГотовностьОпубликована = НЕ Профиль.settings.parallel;
		ОшибкаСвязи = "";
		Если ГотовностьОпубликована Тогда ЗаписатьИсходСервераMCP(СсылкаРегистрации, Профиль, "running"); КонецЕсли;
		Пока Истина Цикл
			Актуальное = СостояниеСервераMCP(СсылкаРегистрации);
			Если НЕ Актуальное.desired Или НЕ ТотЖеЭкземплярСервераMCP(Актуальное, Профиль) Тогда Прервать; КонецЕсли;
			Если ПрофильПроксиСервераMCP(Рантайм) Тогда
				ПодключитьПроксиСервераMCP(Рантайм);
				ОбновитьСостоянияПроксиСервераMCP(Рантайм);
			ИначеЕсли НЕ Рантайм.Транспорт.IsRunning Тогда ВызватьИсключение "HTTP-транспорт остановился."; КонецЕсли;
			ПроходИсполнителяСервераMCP(Рантайм);
			ПроходЗаданийСервераMCP(Рантайм);
			Если НЕ ГотовностьОпубликована И Рантайм.СредаЗаданий.ready Тогда
				ЗаписатьИсходСервераMCP(СсылкаРегистрации, Профиль, "running");
				ГотовностьОпубликована = Истина;
			КонецЕсли;
			Если Рантайм.ОжидаетсяПроверкаОтмен Тогда
				// До конца прохода отмен новые инструменты только принимаются в учёт.
				Если ПрофильПроксиСервераMCP(Рантайм) Тогда Рантайм.Транспорт.WaitMilliseconds(100); КонецЕсли;
				Продолжить;
			КонецЕсли;
			Ожидание = ?(Рантайм.Планировщик.Операции.Количество() > 0, 100, 1000);
			Если ПрофильПроксиСервераMCP(Рантайм) Тогда
				Если ГотовностьОпубликована Тогда ОпросПроксиСервераMCP(Рантайм, Ожидание);
				Иначе Рантайм.Транспорт.WaitMilliseconds(100); КонецЕсли;
				Если ОшибкаСвязи <> Рантайм.Прокси.error Тогда
					ОшибкаСвязи = Рантайм.Прокси.error;
					ЗаписатьИсходСервераMCP(СсылкаРегистрации, Профиль, ?(ГотовностьОпубликована, "running", "starting"), ОшибкаСвязи);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Событие = ПрочитатьJSON2(Рантайм.Транспорт.WaitNextEvent(Ожидание));
			Если Событие.outcome = "stopped" Тогда ВызватьИсключение "Очередь HTTP остановилась."; КонецЕсли;
			Если Событие.outcome = "event" Тогда
				Актуальное = СостояниеСервераMCP(СсылкаРегистрации);
				Если НЕ Актуальное.desired Или НЕ ТотЖеЭкземплярСервераMCP(Актуальное, Профиль) Тогда Прервать; КонецЕсли;
				ОбработатьСобытиеСервераMCP(Рантайм, Событие);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОшибкаРаботы = ОписаниеОшибки();
	КонецПопытки;
	Если Рантайм <> Неопределено Тогда
		Если ПрофильПроксиСервераMCP(Рантайм) Тогда
			Попытка ЗапросПроксиСервераMCP(Рантайм, "/1c/host/release", Новый Структура);
			Исключение КонецПопытки;
			Рантайм.Прокси.lease = "";
		КонецЕсли;
		Если Рантайм.СредаЗаданий <> Неопределено Или Рантайм.Планировщик.Операции.Количество() > 0 Тогда
			Попытка ОстановитьЗаданияСервераMCP(Рантайм);
			Исключение ОшибкаРаботы = ОшибкаРаботы + Символы.ПС + "Ошибка завершения дочерних заданий: " + ОписаниеОшибки(); КонецПопытки;
		КонецЕсли;
		Если Рантайм.Транспорт <> Неопределено Тогда
			Попытка Рантайм.Транспорт.Stop();
			Исключение ОшибкаРаботы = ОшибкаРаботы + Символы.ПС + "Не подтверждена остановка HTTP-компоненты: " + ОписаниеОшибки(); КонецПопытки;
		КонецЕсли;
		Если Рантайм.Планировщик.Операции.Количество() = 0 И НЕ Рантайм.ИсполнительСправки.Запущен И НЕ Рантайм.ИсполнительСправки.Остановка Тогда
			Попытка ОсвободитьКэшСервераMCP(Рантайм);
			Исключение ОшибкаРаботы = ОшибкаРаботы + Символы.ПС + "Ошибка освобождения кэша: " + ОписаниеОшибки(); КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	ЕстьНеоконченные = Рантайм <> Неопределено И (Рантайм.Планировщик.Операции.Количество() > 0
		Или Рантайм.ИсполнительСправки.Запущен Или Рантайм.ИсполнительСправки.Остановка);
	Рантайм = Неопределено;
	Если НЕ ЕстьНеоконченные И ЗначениеЗаполнено(Профиль.storage) Тогда
		Попытка УдалитьИзВременногоХранилища(Профиль.storage); Исключение КонецПопытки;
		Профиль.storage = "";
	КонецЕсли;
	Попытка ЗаписатьИсходСервераMCP(СсылкаРегистрации, Профиль, ?(ЕстьНеоконченные, "draining", ?(ОшибкаРаботы = "", "stopped", "failed")), ОшибкаРаботы);
	Исключение ОшибкаРаботы = ОшибкаРаботы + Символы.ПС + "Не удалось сохранить итоговое состояние: " + ОписаниеОшибки(); КонецПопытки;
	Если ОшибкаРаботы <> "" Тогда ВызватьИсключение ОшибкаРаботы; КонецЕсли;
КонецПроцедуры

Процедура ОсвободитьКэшСервераMCP(Рантайм)
	Если Рантайм.КэшТокеновМетаданныхРасширений = Неопределено Тогда Возврат; КонецЕсли;
	Для Каждого ЗаписьКэша Из Рантайм.КэшТокеновМетаданныхРасширений Цикл
		УдаляемыеАдреса = Новый Массив;
		Для Каждого ПараАдреса Из АдресаКэшаМетаданныхРасширения(ЗаписьКэша.Значение) Цикл
			УдаляемыеАдреса.Добавить(ПараАдреса.Ключ);
		КонецЦикла;
		УдалитьУстаревшийКэшМетаданныхНаСервере(УдаляемыеАдреса);
	КонецЦикла;
КонецПроцедуры

Функция ЗапросСервераMCPАктуален(Рантайм, ИдHTTP)
	Состояния = ПрочитатьJSON2(Рантайм.Транспорт.GetRequestStates(ИдHTTP));
	Для Каждого Элемент Из Состояния.items Цикл
		Если Элемент.id = ИдHTTP Тогда Возврат Элемент.active И (Элемент.remaining_ms = -1 Или Элемент.remaining_ms > 0); КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОтветСервераMCP(Рантайм, ЗапросHTTP, Код, Тело, ИдСессии = Неопределено, Маршрут = Неопределено)
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если ПолучитьЗначениеОбъекта(ЗапросHTTP, "path") = "/api/deanonymize" Тогда Заголовки.Вставить("Cache-Control", "no-store"); КонецЕсли;
	Если ИдСессии <> Неопределено Тогда Заголовки.Вставить("Mcp-Session-Id", ИдСессии); КонецЕсли;
	Успех = Ложь;
	Попытка Успех = Рантайм.Транспорт.SendResponse(ЗапросHTTP.id, Код, ЗаписатьJSON2(Заголовки), Тело);
	Исключение
		ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Ложь); ВызватьИсключение;
	КонецПопытки;
	ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Успех);
	Возврат Успех;
КонецФункции

Процедура ЗакрытьСессиюСервераMCP(Рантайм, ИдСессии)
	ОтменитьМаршрутыСервераMCP(Рантайм, ИдСессии);
	ИдПотока = Рантайм.SSEПотоки.Получить(ИдСессии);
	Если ИдПотока <> Неопределено Тогда Рантайм.Транспорт.CloseSSEStream(ИдПотока); КонецЕсли;
	Рантайм.SSEПотоки.Удалить(ИдСессии);
	Рантайм.МСПСессии.Удалить(ИдСессии);
КонецПроцедуры

Процедура ОбработатьСобытиеСервераMCP(Рантайм, Событие)
	ЗапросHTTP = Событие.data;
	Если Событие.event = "SSE_CLOSED" Тогда
		УдалитьЗакрытыйПотокСервераMCP(Рантайм.SSEПотоки, ЗапросHTTP.id);
		УдалитьЗакрытыйПотокСервераMCP(Рантайм.ЛегасиССЕПотоки, ЗапросHTTP.id);
		Возврат;
	КонецЕсли;
	// JSON headers содержат дефисы, поэтому всегда используются как соответствие.
	Если ТипЗнч(ЗапросHTTP.headers) <> Тип("Соответствие") Тогда
		Заголовки = Новый Соответствие;
		Для Каждого Заголовок Из ЗапросHTTP.headers Цикл Заголовки.Вставить(НРег(Заголовок.Ключ), Заголовок.Значение); КонецЦикла;
		ЗапросHTTP.headers = Заголовки;
	КонецЕсли;
	Если НЕ ТокенЗапросаРазрешен(ЗапросHTTP, Рантайм.Профиль.token) Тогда
		ОтветСервераMCP(Рантайм, ЗапросHTTP, 401, "{""error"":""Unauthorized""}"); Возврат;
	КонецЕсли;
	Если Событие.event <> "SSE_LEGACY_MESSAGE" И НЕ ЗапросСервераMCPАктуален(Рантайм, ЗапросHTTP.id) Тогда Возврат; КонецЕсли;
	Попытка
		Если ЗапросHTTP.path = "/health" Тогда
			ОтветСервераMCP(Рантайм, ЗапросHTTP, 200, ЗаписатьJSON2(Новый Структура("status,ready,mode,port,instance,epoch",
				"healthy", НЕ Рантайм.Профиль.settings.parallel Или (Рантайм.СредаЗаданий <> Неопределено И Рантайм.СредаЗаданий.ready), "server", Рантайм.Профиль.port, Рантайм.Профиль.instance, Рантайм.Профиль.epoch)));
		ИначеЕсли Событие.event = "SSE_CONNECT" Или Событие.event = "SSE_LEGACY_CONNECT" Тогда
			ОткрытьПотокСервераMCP(Рантайм, ЗапросHTTP, Событие.event = "SSE_LEGACY_CONNECT");
		ИначеЕсли Событие.event = "SSE_LEGACY_MESSAGE" Тогда
			ОбработатьLegacyСервераMCP(Рантайм, ЗапросHTTP);
		ИначеЕсли ЗапросHTTP.path = "/mcp" Или ЗапросHTTP.path = "/mcp/" Тогда
			Если ЗапросHTTP.method = "DELETE" Тогда
				ОшибкаСессии = ОшибкаПротоколВерсию(ЗапросHTTP);
				Если ОшибкаСессии = Неопределено Тогда ОшибкаСессии = ОшибкаСессию(Рантайм, ЗапросHTTP); КонецЕсли;
				Если ОшибкаСессии <> Неопределено Тогда
					ОтветСервераMCP(Рантайм, ЗапросHTTP, ОшибкаСессии.Статус, СформироватьТелоJSONRPCОшибка(ОшибкаСессии.Сообщение, ОшибкаСессии.Код));
				Иначе
					ЗакрытьСессиюСервераMCP(Рантайм, ЗапросHTTP.headers["mcp-session-id"]);
					ОтветСервераMCP(Рантайм, ЗапросHTTP, 200, "");
				КонецЕсли;
			ИначеЕсли ЗапросHTTP.method = "POST" Тогда
				ЗапросHTTP.Вставить("body", Рантайм.Транспорт.GetRequestBody(ЗапросHTTP.id));
				Разбор = РазобратьMCPPost(Рантайм, ЗапросHTTP);
				Если Разбор.Ошибка <> Неопределено Тогда
					ОтветСервераMCP(Рантайм, ЗапросHTTP, Разбор.Ошибка.Статус, СформироватьТелоJSONRPCОшибка(Разбор.Ошибка.Сообщение, Разбор.Ошибка.Код));
				ИначеЕсли НЕ Разбор.ЭтоЗапрос Тогда
					ОтменитьRPCСервераMCP(Рантайм, Разбор.ТелоJSON, ЗапросHTTP.headers["mcp-session-id"], "rpc");
					ОтветСервераMCP(Рантайм, ЗапросHTTP, 202, "");
				Иначе
					ИдСессии = Неопределено;
					ЭтоСправка = ПолучитьЗначениеОбъекта(ПолучитьЗначениеОбъекта(Разбор.ТелоJSON, "params"), "name") = "get_bsl_syntax_help";
					Маршрут = МаршрутСервераMCP(Рантайм, ЗапросHTTP, "rpc", Разбор.ТелоJSON.id, "", ЭтоСправка);
					ОтветRPC = ВыполнитьRPCСервераMCP(Рантайм, Разбор.ТелоJSON, ИдСессии, Маршрут);
					Если ОтветRPC <> Неопределено И ЗапросСервераMCPАктуален(Рантайм, ЗапросHTTP.id) Тогда ОтветСервераMCP(Рантайм, ЗапросHTTP, 200, ОтветRPC, ИдСессии, Маршрут);
					ИначеЕсли ОтветRPC <> Неопределено Тогда ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Ложь); КонецЕсли;
				КонецЕсли;
			Иначе
				ОтветСервераMCP(Рантайм, ЗапросHTTP, 405, "{""error"":""Method not allowed""}");
			КонецЕсли;
		ИначеЕсли ЗапросHTTP.path = "/api/deanonymize" Тогда
			Если Рантайм.ДеанонимизацияЧерезAPI И ЗапросHTTP.method = "POST" Тогда
				ЗапросHTTP.Вставить("body", Рантайм.Транспорт.GetRequestBody(ЗапросHTTP.id));
			КонецЕсли;
			Ответ = ОбработатьДеанонимизациюAPI(Рантайм, ЗапросHTTP, Рантайм.ДеанонимизацияЧерезAPI);
			ОтветСервераMCP(Рантайм, ЗапросHTTP, Ответ.КодОтвета, Ответ.Тело);
		ИначеЕсли Лев(ЗапросHTTP.path, 5) = "/api/" Тогда
			ОбработатьRESTСервераMCP(Рантайм, ЗапросHTTP);
		Иначе
			ОтветСервераMCP(Рантайм, ЗапросHTTP, 404, "{""error"":""Not found""}");
		КонецЕсли;
	Исключение
		// Исключение может содержать исходные данные запроса. Не отправляем его как fallback.
		ОтветСервераMCP(Рантайм, ЗапросHTTP, 500, "{""error"":""Server request processing failed""}");
	КонецПопытки;
КонецПроцедуры

Процедура УдалитьЗакрытыйПотокСервераMCP(Потоки, ИдПотока)
	Ключи = Новый Массив;
	Для Каждого Поток Из Потоки Цикл Если Поток.Значение = ИдПотока Тогда Ключи.Добавить(Поток.Ключ); КонецЕсли; КонецЦикла;
	Для Каждого Ключ Из Ключи Цикл Потоки.Удалить(Ключ); КонецЦикла;
КонецПроцедуры

Процедура ОткрытьПотокСервераMCP(Рантайм, ЗапросHTTP, Legacy)
	Ошибка = ОшибкаAcceptSSE(ЗапросHTTP);
	Если Ошибка = Неопределено И НЕ Legacy Тогда Ошибка = ОшибкаПротоколВерсию(ЗапросHTTP); КонецЕсли;
	Если Ошибка <> Неопределено Тогда
		ОтветСервераMCP(Рантайм, ЗапросHTTP, Ошибка.Статус, СформироватьТелоJSONRPCОшибка(Ошибка.Сообщение, Ошибка.Код)); Возврат;
	КонецЕсли;
	ИдСессии = ЗапросHTTP.headers["mcp-session-id"];
	Если Legacy Тогда
		ИдСессии = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		Рантайм.ЛегасиССЕПотоки.Вставить(ИдСессии, ЗапросHTTP.id);
	Иначе
		Если ИдСессии <> Неопределено Тогда
			Если ОшибкаСессию(Рантайм, ЗапросHTTP) <> Неопределено Тогда ОтветСервераMCP(Рантайм, ЗапросHTTP, 404, "{}"); Возврат; КонецЕсли;
			Если Рантайм.SSEПотоки.Получить(ИдСессии) <> Неопределено Тогда ОтветСервераMCP(Рантайм, ЗапросHTTP, 409, "{}"); Возврат; КонецЕсли;
		Иначе
			ИдСессии = ЗапросHTTP.id;
		КонецЕсли;
		Рантайм.SSEПотоки.Вставить(ИдСессии, ЗапросHTTP.id);
	КонецЕсли;
	Если НЕ Рантайм.Транспорт.SendSSEEvent(ЗапросHTTP.id, "", СформироватьSSEЗаголовки(ЗапросHTTP), "message") Тогда
		Рантайм.SSEПотоки.Удалить(ИдСессии);
		Рантайм.ЛегасиССЕПотоки.Удалить(ИдСессии);
		Возврат;
	КонецЕсли;
	Если Legacy Тогда
		Если НЕ Рантайм.Транспорт.SendSSEEvent(ЗапросHTTP.id, "/mcp/message?session_id=" + ИдСессии, "{}", "endpoint") Тогда
			Рантайм.ЛегасиССЕПотоки.Удалить(ИдСессии);
			Рантайм.Транспорт.CloseSSEStream(ЗапросHTTP.id);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ИдLegacyСессииСервераMCP(ЗапросHTTP)
	Значения = ПолучитьЗначениеОбъекта(ЗапросHTTP.query, "session_id");
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда Возврат ""; КонецЕсли;
	Если Значения.Количество() = 0 Тогда Возврат ""; КонецЕсли;
	Возврат Значения[0];
КонецФункции

Процедура ОбработатьLegacyСервераMCP(Рантайм, ЗапросHTTP)
	ИдLegacyСессии = ИдLegacyСессииСервераMCP(ЗапросHTTP);
	ИдПотока = Рантайм.ЛегасиССЕПотоки.Получить(ИдLegacyСессии);
	Если ИдПотока = Неопределено Или НЕ ЗапросСервераMCPАктуален(Рантайм, ИдПотока) Тогда Возврат; КонецЕсли;
	НачалоОбработки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ЗапросHTTP.remaining_ms <= 0 Тогда Возврат; КонецЕсли;
	ТелоJSON = ПрочитатьJSON2(ЗапросHTTP.body);
	Ид = Неопределено;
	Если НЕ ТелоJSON.Свойство("id", Ид) Или Ид = Null Тогда
		ОтменитьRPCСервераMCP(Рантайм, ТелоJSON, ИдLegacyСессии, "legacy");
		Возврат;
	КонецЕсли;
	ИдСессии = Неопределено;
	Маршрут = Неопределено;
	Если ТелоJSON.method = "initialize" Тогда
		Ответ = ОбработатьLegacyInitialize(ТелоJSON, Ид);
	Иначе
		ЭтоСправка = ПолучитьЗначениеОбъекта(ПолучитьЗначениеОбъекта(ТелоJSON, "params"), "name") = "get_bsl_syntax_help";
		Маршрут = МаршрутСервераMCP(Рантайм, ЗапросHTTP, "legacy", Ид, ИдПотока, ЭтоСправка);
		Ответ = ВыполнитьRPCСервераMCP(Рантайм, ТелоJSON, ИдСессии, Маршрут);
	КонецЕсли;
	Если Ответ <> Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОбработки < ЗапросHTTP.remaining_ms
		И ЗапросСервераMCPАктуален(Рантайм, ИдПотока) Тогда ОтветSSEСервераMCP(Рантайм, ИдПотока, Ответ, Маршрут);
	ИначеЕсли Ответ <> Неопределено Тогда ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Ложь); КонецЕсли;
КонецПроцедуры

Функция ВыполнитьRPCСервераMCP(Рантайм, ТелоJSON, ИдСессии, Маршрут = Неопределено)
	Если ТелоJSON.method = "initialize" Тогда
		Пока Рантайм.МСПСессии.Количество() >= 5 Цикл ЗакрытьСессиюСервераMCP(Рантайм, НайтиСтарейшуюМСПСессию(Рантайм)); КонецЦикла;
		ИдСессии = Строка(Новый УникальныйИдентификатор);
		Рантайм.МСПСессии.Вставить(ИдСессии, ТекущаяДатаСеанса());
		Результат = ПодготовитьРезультатInitialize(ТелоJSON);
	ИначеЕсли ТелоJSON.method = "tools/list" Тогда
		Результат = ПолучитьСхемыИнструментов(Рантайм);
	ИначеЕсли ТелоJSON.method = "ping" Тогда
		Результат = Новый Структура;
	ИначеЕсли ТелоJSON.method = "tools/call" Тогда
		Аргументы = Новый Структура;
		Если НЕ ТелоJSON.Свойство("params") Или ТипЗнч(ТелоJSON.params) <> Тип("Структура")
			Или НЕ ТелоJSON.params.Свойство("name") Тогда
			Возврат СформироватьJSONRPCОшибку(ТелоJSON.id, -32602, "Missing tool name");
		КонецЕсли;
		Если НЕ ТелоJSON.params.Свойство("arguments", Аргументы) Тогда Аргументы = Новый Структура; КонецЕсли;
		ОтветИнструмента = ВыполнитьИнструментСервераMCP(Рантайм, ТелоJSON.params.name, Аргументы, Маршрут);
		Если ОтветИнструмента = Неопределено Тогда Возврат Неопределено; КонецЕсли;
		ПодготовитьЖурналРезультатаСервераMCP(Маршрут, ОтветИнструмента);
		Результат = СформироватьСодержимоеToolsCall(ОтветИнструмента, Истина);
	Иначе
		Возврат СформироватьJSONRPCОшибку(ТелоJSON.id, -32601, "Method not found");
	КонецЕсли;
	Возврат СформироватьJSONRPCОтвет(ТелоJSON.id, Результат);
КонецФункции

Процедура ОбработатьRESTСервераMCP(Рантайм, ЗапросHTTP)
	Если ЗапросHTTP.method <> "POST" И ЗапросHTTP.method <> "GET" Тогда ОтветСервераMCP(Рантайм, ЗапросHTTP, 405, "{}"); Возврат; КонецЕсли;
	Аргументы = Новый Структура;
	Если ЗапросHTTP.method = "POST" Тогда
		Попытка Аргументы = ПрочитатьJSON2(Рантайм.Транспорт.GetRequestBody(ЗапросHTTP.id));
		Исключение ОтветСервераMCP(Рантайм, ЗапросHTTP, 400, "{""success"":false,""error"":""Invalid JSON""}"); Возврат; КонецПопытки;
	Иначе
		СписковыеПоля = РазделитьСтрокуПоРазделителю("meta_type,sections,levels,events,rights_filter,roles_filter,names,users,keywords", ",");
		Для Каждого Поле Из ЗапросHTTP.query Цикл
			Если Поле.Ключ = "channel" Тогда Продолжить; КонецЕсли;
			Значения = Поле.Значение;
			Если СписковыеПоля.Найти(Поле.Ключ) <> Неопределено Тогда
				СписокЗначений = НормализоватьRESTQueryСписок(Значения);
				Если СписокЗначений <> Неопределено Тогда
					Если СписокЗначений.Количество() = 1 И Поле.Ключ <> "keywords" Тогда
						Аргументы.Вставить(Поле.Ключ, СписокЗначений[0]);
					Иначе
						Аргументы.Вставить(Поле.Ключ, СписокЗначений);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ТипЗнч(Значения) = Тип("Массив") И Значения.Количество() = 1 Тогда
				Аргументы.Вставить(Поле.Ключ, Значения[0]);
			Иначе
				Аргументы.Вставить(Поле.Ключ, Значения);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ИмяПоля Из РазделитьСтрокуПоРазделителю("limit,offset,types_limit,types_offset,max_depth,same_second_offset,content_page", ",") Цикл
			Ошибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(Аргументы, ИмяПоля);
			Если Ошибка <> Неопределено Тогда
				Если ЭтоИзвестныйИнструментMCP(Сред(ЗапросHTTP.path, 6)) Тогда
					Ошибка = РезультатСИсточникомБазы(Ошибка, Рантайм);
				КонецЕсли;
				ОтветСервераMCP(Рантайм, ЗапросHTTP, 400, ЗаписатьJSON2(Ошибка));
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЭтоСправка = Сред(ЗапросHTTP.path, 6) = "get_bsl_syntax_help";
	Маршрут = МаршрутСервераMCP(Рантайм, ЗапросHTTP, "rest", , , ЭтоСправка);
	ОтказВызова = Неопределено;
	Результат = ВыполнитьИнструментСервераMCP(Рантайм, Сред(ЗапросHTTP.path, 6), Аргументы, Маршрут, ОтказВызова);
	HTTPСтатус = ?(ОтказВызова = Неопределено, 200, ОтказВызова.HTTPСтатус);
	Если Результат <> Неопределено Тогда ПодготовитьЖурналРезультатаСервераMCP(Маршрут, Результат); КонецЕсли;
	Если Результат <> Неопределено И ЗапросСервераMCPАктуален(Рантайм, ЗапросHTTP.id) Тогда ОтветСервераMCP(Рантайм, ЗапросHTTP, HTTPСтатус, ЗаписатьJSON2(Результат), , Маршрут);
	ИначеЕсли Результат <> Неопределено Тогда ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Ложь); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьТокеныСервераMCP(Рантайм, Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Позиция = 1;
		Пока Позиция <= СтрДлина(Значение) Цикл
			Начало = Найти(Сред(Значение, Позиция), "[");
			Если Начало = 0 Тогда Прервать; КонецЕсли;
			Начало = Начало + Позиция - 1;
			Конец = Найти(Сред(Значение, Начало), "]");
			Если Конец = 0 Тогда Прервать; КонецЕсли;
			Кандидат = Сред(Значение, Начало, Конец);
			Если ЭтоВалидныйТокенФормат(Кандидат) И НЕ ЭтоИзвестныйТокенАнонимизации(Рантайм, Кандидат) Тогда
				ВызватьИсключение "Неизвестный токен анонимизации: получите данные заново в текущем серверном сеансе.";
			КонецЕсли;
			Позиция = Начало + Конец;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого Поле Из Значение Цикл ПроверитьТокеныСервераMCP(Рантайм, Поле.Значение); КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл ПроверитьТокеныСервераMCP(Рантайм, Элемент); КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ВыполнитьИнструментСервераMCP(Рантайм, ИмяИнструмента, Аргументы, Маршрут = Неопределено, ОтказВызова = Неопределено)
	КонтекстИсточника = Новый Структура;
	Если ЭтоИзвестныйИнструментMCP(ИмяИнструмента) И Рантайм.Свойство("ИсточникОтвета") Тогда
		КонтекстИсточника.Вставить("ИсточникОтвета", Рантайм.ИсточникОтвета);
		Если Маршрут <> Неопределено Тогда Маршрут.Вставить("ИсточникОтвета", Рантайм.ИсточникОтвета); КонецЕсли;
	КонецЕсли;
	Результат = ВыполнитьПринятыйИнструментСервераMCP(Рантайм, ИмяИнструмента, Аргументы, Маршрут, ОтказВызова);
	Возврат РезультатСИсточникомБазы(Результат, КонтекстИсточника);
КонецФункции

Функция ВыполнитьПринятыйИнструментСервераMCP(Рантайм, ИмяИнструмента, Аргументы, Маршрут, ОтказВызова = Неопределено)
	ОтказВызова = ПроверитьИмяИнструментаMCP(ИмяИнструмента);
	Если ОтказВызова <> Неопределено Тогда Возврат РезультатОтказаИнструментаMCP(ОтказВызова); КонецЕсли;
	ИмяИнструмента = КаноническоеИмяИнструментаMCP(ИмяИнструмента);
	ИдПрямогоВыполнения = Строка(Новый УникальныйИдентификатор);
	Если Маршрут <> Неопределено Тогда
		Маршрут.Вставить("ЖурналИд", ИдПрямогоВыполнения);
		Маршрут.Вставить("ЖурналИнструмент", ИмяИнструмента);
	КонецЕсли;
	// Форматируем полученные аргументы до деанонимизации, как на главной форме.
	ДеталиКоманды = "";
	Попытка ДеталиКоманды = ПолучитьТекстКоманды(Новый Структура("tool,params", ИмяИнструмента, Аргументы));
	Исключение ДеталиКоманды = "    (не удалось представить параметры команды)"; КонецПопытки;
	СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Получена команда", ИдПрямогоВыполнения, ИмяИнструмента, , ДеталиКоманды);
	Если КаталогИнструментовСервераMCP().Найти(ИмяИнструмента) = Неопределено Тогда
		Причина = "эта команда не поддерживается при серверном запуске";
		Если ИмяИнструмента = "get_screenshot" Тогда
			Причина = "нет клиентского интерфейса для захвата экрана";
		ИначеЕсли ИмяИнструмента = "restart_1c_session" Или ИмяИнструмента = "close_1c_session" Тогда
			Причина = "нет клиентского сеанса для закрытия или перезапуска";
		ИначеЕсли ИмяИнструмента = "submit_for_deanonymization" Тогда
			Причина = "нет пользовательского интерфейса для подтверждения деанонимизации";
		КонецЕсли;
		Возврат Новый Структура("success,error", Ложь, "Инструмент " + ИмяИнструмента
			+ " недоступен: обработка работает на сервере 1С, " + Причина + ".");
	КонецЕсли;
	Если НЕ ПрофильПроксиСервераMCP(Рантайм) Тогда
		Если Рантайм.Профиль.settings.tools.Найти(ИмяИнструмента) = Неопределено Тогда
			ОтказВызова = ОтказВызоваИнструментаMCP("disabled", "Инструмент " + ИмяИнструмента + " выключен в настройках встроенного сервера.", 403);
			Возврат РезультатОтказаИнструментаMCP(ОтказВызова);
		КонецЕсли;
		ОтказВызова = ПроверитьДоступностьИнструментаMCP(Рантайм, ИмяИнструмента);
		Если ОтказВызова <> Неопределено Тогда
			Если ИмяИнструмента = "get_bsl_syntax_help" И ОтказВызова.ВидОтказа = "unavailable" Тогда
				ОтказВызова.Сообщение = "Справка BSL недоступна на сервере. Проверьте состояние справки в управлении сервером MCP.";
			КонецЕсли;
			Возврат РезультатОтказаИнструментаMCP(ОтказВызова);
		КонецЕсли;
	КонецЕсли;
	ОтказВызова = ПроверитьВнешниеАргументыMCP(Аргументы);
	Если ОтказВызова <> Неопределено Тогда Возврат РезультатОтказаИнструментаMCP(ОтказВызова); КонецЕсли;
	Если ИмяИнструмента = "execute_code" И ПолучитьЗначениеОбъекта(Аргументы, "execution_context") = "client" Тогда
		Возврат Новый Структура("success,error", Ложь, "execute_code с execution_context=""client"" недоступен: обработка работает на сервере 1С. Поддерживается только execution_context=""server"".");
	КонецЕсли;
	Команда = Новый Структура("tool,params", ИмяИнструмента, Аргументы);
	Если ИмяИнструмента = "get_bsl_syntax_help" Тогда
		Если Рантайм.КомпонентаSyntaxHelp = Неопределено Тогда
			Возврат Новый Структура("success,error", Ложь, "Справка BSL недоступна на сервере. Проверьте состояние справки в управлении сервером MCP.");
		КонецЕсли;
		ОшибкаСправки = ПроверитьИНормализоватьАргументыИнструмента(ИмяИнструмента, Аргументы);
		Если ОшибкаСправки <> Неопределено Тогда Возврат Новый Структура("success,error", Ложь, ОшибкаСправки); КонецЕсли;
		Если Маршрут = Неопределено Тогда Возврат Новый Структура("success,error", Ложь, "Справка требует маршрут запроса"); КонецЕсли;
		Возврат ПринятьЗаданиеСервераMCP(Рантайм, Новый Структура("Команда", Команда), Маршрут, "owner_help");
	КонецЕсли;
	Попытка
		Если НЕ ПрофильПроксиСервераMCP(Рантайм) Тогда ПроверитьТокеныСервераMCP(Рантайм, Аргументы); КонецЕсли;
	Исключение
		Возврат Новый Структура("success,error", Ложь, "Неизвестный или устаревший токен анонимизации. Получите данные заново.");
	КонецПопытки;
	Если Рантайм.ИспользоватьТочнуюАнонимизацию Тогда ДеАнонимизироватьПараметрыКомандыИВытеснить(Рантайм, Команда); КонецЕсли;
	Аргументы = Команда.params;
	Ошибка = ПроверитьИНормализоватьАргументыИнструмента(ИмяИнструмента, Аргументы);
	Если Ошибка <> Неопределено Тогда
		Возврат Новый Структура("success,error", Ложь, ?(Рантайм.ИспользоватьТочнуюАнонимизацию, "Некорректные аргументы инструмента.", Ошибка));
	КонецЕсли;
	Если ИмяИнструмента = "execute_code" Тогда
		ОпасныеСлова = ПроверитьОпасныеСлова(Аргументы.code);
		Если ОпасныеСлова.Количество() > 0 И НЕ ВсеОперацииАвтоРазрешены(Рантайм, ОпасныеСлова) Тогда
			Возврат Новый Структура("success,error", Ложь, "Опасная операция не разрешена серверным профилем.");
		КонецЕсли;
	КонецЕсли;
	Попытка
		Если ПривилегированныйРежим() Тогда ВызватьИсключение "Серверная команда вызвана из привилегированного контекста."; КонецЕсли;
		Подготовка = ПодготовитьСервернуюКоманду(Рантайм, Команда);
		Если Маршрут <> Неопределено И Рантайм.ПринимаютсяУправляющиеСобытия И НЕ Рантайм.Профиль.settings.parallel Тогда
			Возврат ПринятьЗаданиеСервераMCP(Рантайм, Подготовка, Маршрут, "owner_command");
		КонецЕсли;
		Если Рантайм.Профиль.settings.parallel И Маршрут <> Неопределено Тогда
			Возврат ПринятьЗаданиеСервераMCP(Рантайм, Подготовка, Маршрут);
		КонецЕсли;
		СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Начато выполнение", ИдПрямогоВыполнения, ИмяИнструмента);
		Результат = ВыполнитьКомандуНаСервере(Подготовка.Команда);
		Итог = ЗавершитьИнструментСервераMCP(Рантайм, Подготовка, Результат, Маршрут);
		Если НЕ Итог.success Тогда СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Ошибка обработки результата", ИдПрямогоВыполнения, ИмяИнструмента); КонецЕсли;
		Возврат Итог;
	Исключение
		СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Ошибка выполнения", ИдПрямогоВыполнения, ИмяИнструмента);
		Возврат ОшибкаБезДанныхСервераMCP();
	КонецПопытки;
КонецФункции

Функция ЗавершитьИнструментСервераMCP(Рантайм, Подготовка, Результат, Маршрут = Неопределено)
	ИмяИнструмента = Подготовка.Команда.tool;
	Попытка
		Если НЕ Результат.success Тогда
			Если Рантайм.ИспользоватьТочнуюАнонимизацию Тогда Возврат ОшибкаБезДанныхСервераMCP(); КонецЕсли;
			Возврат Новый Структура("success,error", Ложь, Результат.error);
		КонецЕсли;
		Результат = ЗавершитьРезультатСервераMCP(Рантайм, Подготовка, Результат);
		Если НЕ Результат.success Тогда Возврат Результат; КонецЕсли;
		Результат = ЗавершитьКэшСервернойКоманды(Рантайм, Результат, ИмяИнструмента,
			Подготовка.ИмяРасширения, Подготовка.КлючДеталей, Подготовка.Фильтр, Подготовка.Секции, Подготовка.НастройкиТиповКэша);
		Возврат УпаковатьРезультатСервераMCP(Рантайм, Результат, Маршрут);
	Исключение
		Возврат ОшибкаБезДанныхСервераMCP();
	КонецПопытки;
КонецФункции

Функция ОшибкаБезДанныхСервераMCP()
	Возврат Новый Структура("success,error", Ложь, "Не удалось безопасно выполнить или обработать результат команды. Исходные данные не переданы.");
КонецФункции

Функция ЗавершитьРезультатСервераMCP(Рантайм, Подготовка, Результат)
	ИмяИнструмента = Подготовка.Команда.tool;
	ТекстЗапроса = ПолучитьТекстЗапросаLineageИзКоманды(Подготовка.Команда);
	Если НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапроса, Результат) Тогда
		СхемаJSON = Рантайм.КомпонентаLineage.AnalyzeSources(ТекстЗапроса, ЗаписатьJSON2(Результат.schema));
		Схема = ПрочитатьJSON2(СхемаJSON);
		Если ТипЗнч(Схема) <> Тип("Структура") Или НЕ Схема.Свойство("columns") Тогда ВызватьИсключение "Некорректный результат Lineage"; КонецЕсли;
		Если ТипЗнч(Схема.columns) <> Тип("Массив") Или Схема.columns.Количество() <> Результат.schema.columns.Количество() Тогда
			ВызватьИсключение "Неполный результат Lineage";
		КонецЕсли;
		Для ИндексКолонки = 0 По Схема.columns.Количество() - 1 Цикл
			Если Схема.columns[ИндексКолонки].name <> Результат.schema.columns[ИндексКолонки].name Тогда ВызватьИсключение "Изменена структура Lineage"; КонецЕсли;
		КонецЦикла;
		Результат.schema = Схема;
	КонецЕсли;
	Если Рантайм.ИспользоватьТочнуюАнонимизацию Тогда
		РегексКонтекст = Новый Структура("Результат,ВключённыеПравилаJSON,ТекстыJSON,ЕстьТекстыДляRegex,МаппингИндексов,МаппингПутей",
			Результат, "", "", Ложь, Неопределено, Неопределено);
		Если ИмяИнструмента = "execute_query" Тогда
			Результат = ПрименитьТочнуюPolicyКРезультатуExecuteQuery(Рантайм, Результат);
			АнонимизироватьРезультатВстроенный(Рантайм, Результат, РегексКонтекст);
		ИначеЕсли ИмяИнструмента = "execute_code" Тогда
			РегексКонтекст.Вставить("ЭтоExecuteCode", Истина);
			АнонимизироватьExecuteCodeВстроенный(Рантайм, Результат, РегексКонтекст);
		ИначеЕсли ИмяИнструмента = "get_object_by_link" Тогда
			РегексКонтекст.Вставить("ЭтоОбъект", Истина);
			Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Рантайм, Результат);
			АнонимизироватьОбъектВстроенный(Рантайм, Результат, РегексКонтекст);
		ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда
			РегексКонтекст.Вставить("ЭтоFindReferences", Истина);
			АнонимизироватьРезультатFindReferencesВстроенный(Рантайм, Результат, РегексКонтекст);
		ИначеЕсли ИмяИнструмента = "get_event_log" Тогда
			РегексКонтекст.Вставить("ЭтоGetEventLog", Истина);
			АнонимизироватьРезультатGetEventLogВстроенный(Рантайм, Результат, РегексКонтекст);
		ИначеЕсли ИмяИнструмента = "get_access_rights" Тогда
			АнонимизироватьРезультатGetAccessRights(Рантайм, Результат);
		КонецЕсли;
		Если РегексКонтекст.ЕстьТекстыДляRegex Тогда
			Если Рантайм.КомпонентаRegex = Неопределено Тогда ВызватьИсключение "Regex недоступен"; КонецЕсли;
			Совпадения = НайтиСовпаденияRegexСЗащитой(Рантайм.КомпонентаRegex, РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
			ПроверенныеСовпадения = ПрочитатьJSON2(Совпадения);
			ИсходныеТексты = ПрочитатьJSON2(РегексКонтекст.ТекстыJSON);
			Если ТипЗнч(ПроверенныеСовпадения) <> Тип("Массив") Тогда ВызватьИсключение "Некорректный ответ Regex"; КонецЕсли;
			Если ПроверенныеСовпадения.Количество() <> ИсходныеТексты.Количество() Тогда ВызватьИсключение "Неполный ответ Regex"; КонецЕсли;
			Для Каждого СовпаденияТекста Из ПроверенныеСовпадения Цикл
				Если ТипЗнч(СовпаденияТекста) <> Тип("Массив") Тогда ВызватьИсключение "Некорректные совпадения Regex"; КонецЕсли;
			КонецЦикла;
			Если НЕ ПрименитьРезультатRegex(Рантайм, Совпадения, РегексКонтекст) Тогда Возврат ОшибкаБезДанныхСервераMCP(); КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ПрофильПроксиСервераMCP(Рантайм) И (Подготовка.АнонСхемаПринудительно Или ИмяИнструмента = "get_object_by_link") Тогда Результат.Удалить("schema"); КонецЕсли;
	Возврат Результат;
КонецФункции

Функция МаршрутСервераMCP(Рантайм, ЗапросHTTP, Режим, ИдRPC = Неопределено, ИдПотока = "", ЭтоСправка = Ложь)
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИдТранспорта = ?(Режим = "legacy", ИдПотока, ЗапросHTTP.id);
	Остаток = 0;
	Если Режим = "legacy" Тогда
		Остаток = ЗапросHTTP.remaining_ms;
	Иначе
		Состояния = ПрочитатьJSON2(Рантайм.Транспорт.GetRequestStates(ИдТранспорта));
		Для Каждого Состояние Из Состояния.items Цикл
			Если Состояние.id = ИдТранспорта И Состояние.active Тогда Остаток = Состояние.remaining_ms; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// У обычного HTTP должен быть конечный срок; -1 относится к SSE-потоку.
	Если Остаток < 0 Тогда Остаток = 0; КонецЕсли;
	Сессия = ?(Режим = "legacy", ИдLegacyСессииСервераMCP(ЗапросHTTP), ЗапросHTTP.headers["mcp-session-id"]);
	Возврат Новый Структура("Режим,HTTP,RPC,Сессия,Срок", Режим, ИдТранспорта, ИдRPC, Сессия, Сейчас + Остаток);
КонецФункции

Функция ПринятьЗаданиеСервераMCP(Рантайм, Подготовка, Маршрут, ИсполнительВладельца = "")
	Если ИсполнительВладельца = "" И (Рантайм.СредаЗаданий = Неопределено Или НЕ Рантайм.СредаЗаданий.ready) Тогда
		Возврат Новый Структура("success,error", Ложь, "Сервер проверяет возможность параллельного выполнения.");
	КонецЕсли;
	// Сравниваются и тип, и значение RPC ID, только внутри исходной сессии/транспорта.
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Прежний = Пара.Значение.Маршрут;
		Если Маршрут.Режим <> "rest" И Прежний.Режим = Маршрут.Режим И Прежний.Сессия = Маршрут.Сессия
			И ТипЗнч(Прежний.RPC) = ТипЗнч(Маршрут.RPC) И Прежний.RPC = Маршрут.RPC Тогда
			Возврат Новый Структура("success,error", Ложь, "Request ID is already pending in this session");
		КонецЕсли;
	КонецЦикла;
	Ид = Маршрут.ЖурналИд;
	Ответ = ПринятьКомандуПланировщика(Рантайм.Планировщик, Ид, Подготовка.Команда, Маршрут,
		Новый Структура, Маршрут.Срок, ТекущаяУниверсальнаяДатаВМиллисекундах(), ИсполнительВладельца);
	Если НЕ Ответ.accepted Тогда Возврат Новый Структура("success,error", Ложь, Ответ.reason); КонецЕсли;
	Рантайм.Планировщик.Операции[Ид].Вставить("Подготовка", Подготовка);
	Если ИсполнительВладельца = "owner_help" Тогда
		ПодготовкаПоиска = ПодготовитьЗапросСправкиBSL(Рантайм, Подготовка.Команда.params);
		Рантайм.Планировщик.Операции[Ид].Вставить("ПодготовкаПоиска", ПодготовкаПоиска);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ОтменитьRPCСервераMCP(Рантайм, Тело, Сессия, Режим)
	Если ТипЗнч(Тело) <> Тип("Структура") Или НЕ Тело.Свойство("method") Тогда Возврат; КонецЕсли;
	Если Тело.method <> "notifications/cancelled" Или НЕ Тело.Свойство("params") Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Тело.params) <> Тип("Структура") Или НЕ Тело.params.Свойство("requestId") Тогда Возврат; КонецЕсли;
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Маршрут = Операция.Маршрут;
		Если Маршрут.Режим = Режим И Маршрут.Сессия = Сессия
			И ТипЗнч(Маршрут.RPC) = ТипЗнч(Тело.params.requestId) И Маршрут.RPC = Тело.params.requestId Тогда
			ПрерватьОперациюПланировщика(Операция, "Request cancelled");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОтменитьМаршрутыСервераMCP(Рантайм, Сессия)
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Маршрут = Операция.Маршрут;
		Если Маршрут.Режим = "rpc" И Маршрут.Сессия = Сессия Тогда
			ПрерватьОперациюПланировщика(Операция, "MCP session closed");
			// После удаления сессии обычная выдача результата запрещена. Завершаем
			// HTTP сейчас, иначе запрос удерживает лимит транспорта до таймаута.
			// Учёт и отмена живого задания продолжаются в планировщике.
			Если НЕ Операция.ОтветВыдан И ЗапросСервераMCPАктуален(Рантайм, Маршрут.HTTP) Тогда
				Ошибка = Новый Структура("success,error", Ложь, "MCP session closed");
				Ошибка = РезультатСИсточникомБазы(Ошибка, Маршрут);
				Тело = СформироватьJSONRPCОтвет(Маршрут.RPC, СформироватьСодержимоеToolsCall(Ошибка, Истина));
				ОтветСервераMCP(Рантайм, Новый Структура("id", Маршрут.HTTP), 200, Тело);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция МаршрутЗаданияСервераАктуален(Рантайм, Операция)
	Если Операция.Маршрут.Режим = "probe" Тогда Возврат Истина; КонецЕсли;
	Если Операция.Срок <= ТекущаяУниверсальнаяДатаВМиллисекундах() Тогда Возврат Ложь; КонецЕсли;
	Если Операция.Маршрут.Режим = "proxy" Тогда
		Возврат Рантайм.Прокси.connected И Операция.Маршрут.Сессия = Рантайм.Прокси.lease
			И Рантайм.Прокси.states.Получить(Операция.Маршрут.HTTP) = Истина;
	КонецЕсли;
	Если Операция.Маршрут.Режим = "rpc" И ЗначениеЗаполнено(Операция.Маршрут.Сессия)
		И Рантайм.МСПСессии.Получить(Операция.Маршрут.Сессия) = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Если Операция.Маршрут.Режим = "legacy"
		И Рантайм.ЛегасиССЕПотоки.Получить(Операция.Маршрут.Сессия) <> Операция.Маршрут.HTTP Тогда Возврат Ложь; КонецЕсли;
	Возврат ЗапросСервераMCPАктуален(Рантайм, Операция.Маршрут.HTTP);
КонецФункции

Процедура СохранитьЗаданияСервераMCP(Рантайм)
	Дочерние = Новый Массив;
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Если Операция.ЗанимаетСлот И Операция.Свойство("ЗапускЗафиксирован") И Операция.ЗапускЗафиксирован Тогда
			Дочерние.Добавить(Новый Структура("id,key,job_id", Операция.Ид, Операция.КлючЗапуска, Операция.ИдЗадания));
		КонецЕсли;
	КонецЦикла;
	НачатьТранзакциюСервераMCP();
	Попытка
		БлокироватьКарточкуСервераMCP(Рантайм.Регистрация);
		Состояние = ПрочитатьСостояниеПодБлокировкойСервераMCP(Рантайм.Регистрация);
		Если Состояние = Неопределено Тогда ВызватьИсключение "Сначала сохраните настройки."; КонецЕсли;
		Если НЕ ТотЖеЭкземплярСервераMCP(Состояние, Рантайм.Профиль) Тогда
			ВызватьИсключение "Владелец серверных заданий изменился.";
		КонецЕсли;
		Состояние.Вставить("children", Дочерние);
		Состояние.Вставить("parallel_environment", Рантайм.СредаЗаданий);
		СохранитьИсполнениеСервераMCP(Рантайм.Регистрация, Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ПроверитьДочерниеСервераMCP(Состояние, РучнаяОстановка = Ложь, ТолькоПроверка = Ложь)
	Если НЕ Состояние.Свойство("children") Тогда Возврат; КонецЕсли;
	ЕстьАктивные = Ложь;
	Для Каждого Дочернее Из Состояние.children Цикл
		Задание = НайтиЗаданиеПараллельнойОперации(Дочернее.job_id, Дочернее.key);
		Если Задание = Неопределено Тогда
			// Задание с известным ID было поставлено. При ручном восстановлении
			// отсутствие и ID, и ключа допускает остановку, но не повтор команды.
			Если РучнаяОстановка И ЗначениеЗаполнено(Дочернее.job_id)
				И ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ", Дочернее.key)).Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			// Только служебная проба не выполняет бизнес-код. После окончания
			// владельца отсутствие её задания не должно навсегда блокировать профиль.
			Если Дочернее.Свойство("id") И Дочернее.id = "probe"
				И Дочернее.key = Состояние.instance + ":" + Формат(Состояние.epoch, "ЧГ=0") + ":probe"
				И НЕ ЗначениеЗаполнено(Дочернее.job_id)
				И ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ", Дочернее.key)).Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ВызватьИсключение "Исход дочернего задания неизвестен; автоматический перезапуск запрещён: " + Дочернее.key;
		КонецЕсли;
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Если ТолькоПроверка Тогда ВызватьИсключение "Дочернее задание MCP ещё выполняется."; КонецЕсли;
			Задание.Отменить();
			ЕстьАктивные = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьАктивные Тогда ВызватьИсключение "Запрошена отмена дочерних заданий прежнего экземпляра. Повторите запуск после их завершения."; КонецЕсли;
	Если ТолькоПроверка Тогда Возврат; КонецЕсли;
	Если Состояние.Свойство("parallel_environment") И Состояние.parallel_environment <> Неопределено Тогда
		// После аварии временное хранилище старого owner может уже отсутствовать.
		Среда = КопироватьПакетПланировщика(Состояние.parallel_environment);
		Среда.binary_address = "";
		Если Среда.file_path <> "" Тогда
			ФайлСреды = Новый Файл(Среда.file_path);
			Если НЕ ФайлСреды.Существует() Тогда Среда.file_path = ""; КонецЕсли;
		КонецЕсли;
		ОсвободитьСредуПараллельногоВыполнения(Среда, Новый Массив);
	КонецЕсли;
	Если РучнаяОстановка Тогда
		Состояние.children.Очистить();
		Состояние.Удалить("parallel_environment");
	КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьЗаданияСервераMCP(Рантайм)
	ПроверитьСборкуРегистрацииСервераMCP(Рантайм.Регистрация, Рантайм.Профиль);
	КонтекстРегистрации = Новый Структура("registration,binary_hash,source", Рантайм.Регистрация, Рантайм.Профиль.binary_hash, "server");
	Возможности = ВозможностиПараллельногоВыполнения(Рантайм.ВладелецХранилища, КонтекстРегистрации);
	Если НЕ Возможности.available Тогда ВызватьИсключение Возможности.reason; КонецЕсли;
	// Зарегистрированная EPF загружается БСП уже внутри дочернего задания.
	// Передача бинарника в ВыполнитьФункцию повторно открывает временный файл
	// в контроллере и может вызвать интерактивное предупреждение платформы.
	Рантайм.СредаЗаданий = Новый Структура("owner,instance,generation,build,adapter,bsp,user,safe_mode,privileged,binary_address,file_path,file_id,ready",
		Рантайм.ВладелецХранилища, Рантайм.Профиль.instance, Рантайм.Профиль.epoch,
		СборкаПараллельногоЯдра(), "registered", Возможности.bsp, Возможности.user,
		Возможности.safe_mode, Возможности.privileged, "", "", "", Ложь);
	Если Возможности.adapter = "bsp21_registered" Тогда
		Рантайм.СредаЗаданий.adapter = Возможности.adapter;
		Рантайм.СредаЗаданий.Вставить("registration_context", КонтекстРегистрации);
	КонецЕсли;
	Рантайм.СредаЗаданий.Вставить("controller_job", Рантайм.Профиль.job_id);
	Рантайм.Планировщик.Режим = "enabled";
	Команда = Новый Структура("tool,params", "execute_code", Новый Структура("code", "Результат = 1;"));
	Маршрут = Новый Структура("Режим,HTTP,RPC,Сессия", "probe", "", Неопределено, Неопределено);
	ПринятьКомандуПланировщика(Рантайм.Планировщик, "probe", Команда, Маршрут, Новый Структура,
		ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000, ТекущаяУниверсальнаяДатаВМиллисекундах());
	Рантайм.Планировщик.Операции["probe"].Вставить("Подготовка", Новый Структура("Команда,КлючДеталей", Команда, ""));
	СохранитьЗаданияСервераMCP(Рантайм);
КонецПроцедуры

Процедура НачатьЗаданиеСервераMCP(Рантайм, Операция)
	Попытка
		Пакет = ПодготовитьПакетФоновойКоманды(Рантайм.СредаЗаданий, Операция.Ид, Операция.КлючЗапуска,
			Операция.Подготовка.Команда, Операция.Подготовка.КлючДеталей,
			(Операция.Срок - ТекущаяУниверсальнаяДатаВМиллисекундах()) / 1000, Операция.Маршрут.Режим = "probe");
		Операция.АдресРезультата = Пакет.result_address;
		Операция.Вставить("АдресПакета", Пакет.packet_address);
		// Фиксируем ключ до запуска. Потерянный ответ не разрешает повтор.
		Операция.Вставить("ЗапускЗафиксирован", Истина);
	Исключение
		Операция.ЗанимаетСлот = Ложь;
		Операция.СостояниеСтарта = "not_started";
		Операция.Вставить("ЗапускЗафиксирован", Ложь);
		ПрерватьОперациюПланировщика(Операция, "Command preparation failed; execution was not started");
		Возврат;
	КонецПопытки;
	Попытка
		СохранитьЗаданияСервераMCP(Рантайм);
	Исключение
		Операция.ЗанимаетСлот = Ложь;
		Операция.СостояниеСтарта = "not_started";
		Операция.Вставить("ЗапускЗафиксирован", Ложь);
		ПрерватьОперациюПланировщика(Операция, ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	Старт = НачатьЗарегистрированноеЗаданиеСервераMCP(Рантайм, Пакет);
	Операция.Вставить("АдресРезультатаБСП", Старт.bsp_result_address);
	ПрименитьСтартПланировщика(Рантайм.Планировщик, Операция.Ид, Операция.Поколение, Старт);
	СохранитьЗаданияСервераMCP(Рантайм);
КонецПроцедуры

Функция НачатьЗарегистрированноеЗаданиеСервераMCP(Рантайм, Дескриптор)
	Если Рантайм.СредаЗаданий.adapter = "bsp21_registered" Тогда
		Возврат НачатьПараллельноеЗадание(Рантайм.СредаЗаданий, Дескриптор);
	КонецЕсли;
	Ответ = Новый Структура("state,job_id,result_address,bsp_result_address,error,result",
		"not_started", Неопределено, Дескриптор.result_address, "", "", Неопределено);
	Попытка
		Пакет = ПолучитьИзВременногоХранилища(Дескриптор.packet_address);
		Если Пакет = Неопределено Тогда ВызватьИсключение "Prepared command packet is no longer available"; КонецЕсли;
		Если Пакет.deadline <= ТекущаяУниверсальнаяДата() Тогда ВызватьИсключение "Operation expired before start"; КонецЕсли;
		ПакетЗапуска = Новый Структура("registration,binary_hash,packet", Рантайм.Регистрация, Рантайм.Профиль.binary_hash, Пакет);
		Опции = Новый Структура("ЭтоВнешняяОбработка,ИмяОбработки,ИмяМетода,ПараметрыВыполнения,БезопасныйРежим,ДополнительнаяОбработкаСсылка",
			Истина, "", "ВыполнитьЗаданиеСервераMCP", ПакетЗапуска, Пакет.safe_mode, Рантайм.Регистрация);
		Аргументы = Новый Массив;
		Аргументы.Добавить(Опции); Аргументы.Добавить(Дескриптор.result_address);
	Исключение Ответ.error = ОписаниеОшибки(); Возврат Ответ; КонецПопытки;
	// Платформенный запуск гарантирует отдельное задание; БСП отвечает за
	// подключение регистрации, включая отличия своих версий 2.2 / 3.0 / 3.1.
	Ответ.state = "start_unknown";
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			Аргументы, Пакет.key, "MCP " + Строка(Пакет.id));
		Ответ.job_id = Задание.УникальныйИдентификатор;
		Ответ.state = "started";
	Исключение Ответ.error = ОписаниеОшибки(); КонецПопытки;
	Возврат Ответ;
КонецФункции

Процедура ВыполнитьЗаданиеСервераMCP(ПакетЗапуска, АдресРезультата) Экспорт
	Пакет = ПакетЗапуска.packet;
	ПроверитьУправляющееЗаданиеКоманды(Пакет);
	Профиль = СостояниеСервераMCP(ПакетЗапуска.registration);
	Если Профиль = Неопределено Тогда ВызватьИсключение "Server profile is unavailable; command not executed"; КонецЕсли;
	Если НЕ Профиль.desired Или Профиль.instance <> Пакет.instance Или Профиль.epoch <> Пакет.generation
		Или Профиль.job_id <> Пакет.controller_job Или Профиль.user_id <> ИдПользователяСервераMCP()
		Или Профиль.binary_hash <> ПакетЗапуска.binary_hash Или Профиль.build <> Пакет.build Тогда
		ВызватьИсключение "Server profile changed; command not executed";
	КонецЕсли;
	ПроверитьСборкуРегистрацииСервераMCP(ПакетЗапуска.registration, Профиль);
	Если АдресРезультата <> Пакет.result_address Тогда ВызватьИсключение "Server result address mismatch"; КонецЕсли;
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если Задание.Ключ <> Пакет.key Тогда ВызватьИсключение "Server worker key mismatch"; КонецЕсли;
	Если НЕ Пакет.probe Тогда СобытиеСервераMCP(ПакетЗапуска.registration, Профиль, "Начато выполнение", Пакет.id, Пакет.command.tool); КонецЕсли;
	Конверт = ВыполнитьФоновуюКоманду(Пакет);
КонецПроцедуры

Функция КонвертЗаданияСервераВерный(Рантайм, Операция, Конверт)
	Попытка
		Возврат Конверт.protocol = ВерсияПараллельногоПротокола() И Конверт.build = Рантайм.СредаЗаданий.build
			И Конверт.instance = Операция.Экземпляр И Конверт.generation = Операция.Поколение
			И Конверт.id = Операция.Ид И Конверт.user = Рантайм.СредаЗаданий.user
			И Конверт.privileged = Рантайм.СредаЗаданий.privileged И Конверт.background
			И (НЕ Рантайм.СредаЗаданий.safe_mode Или Конверт.safe_mode);
	Исключение Возврат Ложь; КонецПопытки;
КонецФункции

Функция РезультатЗаданияСервераMCP(Рантайм, Операция)
	Если Операция.ЗавершениеЗапрошено Тогда Возврат Новый Структура("success,error", Ложь, Операция.ПричинаЗавершения); КонецЕсли;
	Если Операция.ИсполнительВладельца = "owner_help" Тогда
		Возврат УпаковатьРезультатСервераMCP(Рантайм, Операция.Результат, Операция.Маршрут);
	ИначеЕсли Операция.ИсполнительВладельца = "owner_command" Тогда
		Возврат ЗавершитьИнструментСервераMCP(Рантайм, Операция.Подготовка, Операция.Результат, Операция.Маршрут);
	КонецЕсли;
	Конверт = Операция.Результат;
	Если НЕ КонвертЗаданияСервераВерный(Рантайм, Операция, Конверт) Тогда Возврат ОшибкаБезДанныхСервераMCP(); КонецЕсли;
	Результат = Конверт.body;
	Если Конверт.cache <> Неопределено Тогда
		Если Конверт.cache.extension <> Операция.Подготовка.ИмяРасширения
			Или Конверт.cache.key <> Операция.Подготовка.КлючДеталей Тогда Возврат ОшибкаБезДанныхСервераMCP(); КонецЕсли;
		Ожидаемый = Новый Структура("id,instance,generation,extension,key,hash", Операция.Ид, Операция.Экземпляр,
			Операция.Поколение, Конверт.cache.extension, Конверт.cache.key, Конверт.cache.hash);
		Токены = СохранитьКэшИзЗадания(Операция.АдресРезультата, Рантайм.ВладелецХранилища, Ожидаемый);
		Для Каждого Токен Из Токены Цикл Результат.Вставить(Токен.Ключ, Токен.Значение); КонецЦикла;
	КонецЕсли;
	Возврат ЗавершитьИнструментСервераMCP(Рантайм, Операция.Подготовка, Результат, Операция.Маршрут);
КонецФункции

Процедура ПроходЗаданийСервераMCP(Рантайм, Остановка = Ложь)
	Планировщик = Рантайм.Планировщик;
	Для Каждого Пара Из Планировщик.Операции Цикл
		Если Пара.Значение.ИсполнительВладельца <> "" И Пара.Значение.Маршрут.Режим = "proxy"
			И НЕ Рантайм.Прокси.connected И Пара.Значение.Маршрут.Сессия = Рантайм.Прокси.lease Тогда Продолжить; КонецЕсли;
		Если НЕ Остановка И НЕ Пара.Значение.ЗавершениеЗапрошено И НЕ МаршрутЗаданияСервераАктуален(Рантайм, Пара.Значение) Тогда
			СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Запрос завершён: истёк срок или потеряно соединение", Пара.Значение.Ид, Пара.Значение.Команда.tool);
		ПрерватьОперациюПланировщика(Пара.Значение, "Request expired or disconnected");
		КонецЕсли;
	КонецЦикла;
	Действия = ПодготовитьПроходПланировщика(Планировщик, ТекущаяУниверсальнаяДатаВМиллисекундах());
	Для Каждого Ид Из Действия.start Цикл НачатьЗаданиеСервераMCP(Рантайм, Планировщик.Операции[Ид]); КонецЦикла;
	Опрос = Новый Массив;
	Для Каждого Пара Из Планировщик.Операции Цикл Если Пара.Значение.ЗанимаетСлот Тогда Опрос.Добавить(Пара.Значение); КонецЕсли; КонецЦикла;
	Если Опрос.Количество() > 0 Тогда
		Для Каждого Ответ Из СостоянияПараллельныхЗаданий(Опрос) Цикл
			Операция = Планировщик.Операции[Ответ.id];
			Если ЗначениеЗаполнено(Ответ.job_id) Тогда Операция.ИдЗадания = Ответ.job_id; КонецЕсли;
			Если Ответ.state = "finished" Тогда
				ПрименитьЗавершениеЗадания(Планировщик, Ответ.id, Ответ.generation,
					?(Ответ.error = "", Ответ.result, ОшибкаБезДанныхСервераMCP()));
				Если Остановка Тогда СохранитьЗаданияПриОстановкеСервераMCP(Рантайм);
				Иначе СохранитьЗаданияСервераMCP(Рантайм); КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Отмены = Новый Массив;
	Для Каждого Пара Из Планировщик.Операции Цикл
		Если Пара.Значение.ЗанимаетСлот И Пара.Значение.ЗавершениеЗапрошено И НЕ Пара.Значение.ОтменаОтправлена Тогда Отмены.Добавить(Пара.Значение); КонецЕсли;
	КонецЦикла;
	Для Каждого Ответ Из ОтменитьПараллельныеЗадания(Отмены) Цикл Планировщик.Операции[Ответ.id].ОтменаОтправлена = Ответ.requested; КонецЦикла;
	// Ограничиваем финализацию двумя результатами за проход, чтобы принимать отмены.
	Для Номер = 1 По 2 Цикл
		Операция = ВзятьРезультатПланировщика(Планировщик);
		Если Операция = Неопределено Тогда Прервать; КонецЕсли;
		ПередачаВыполнена = Ложь;
		Если Операция.Маршрут.Режим = "probe" Тогда
			Если НЕ Остановка Тогда
				Если Операция.ЗавершениеЗапрошено Или НЕ КонвертЗаданияСервераВерный(Рантайм, Операция, Операция.Результат)
					Или НЕ Операция.Результат.body.success Или Операция.Результат.body.data <> "MCP_PARALLEL_READY" Тогда
					ВызватьИсключение "Пробное задание не подтвердило серверную параллельность.";
				КонецЕсли;
				Рантайм.СредаЗаданий.ready = Истина;
			КонецЕсли;
		ИначеЕсли НЕ Остановка И МаршрутЗаданияСервераАктуален(Рантайм, Операция) Тогда
			Попытка Результат = РезультатЗаданияСервераMCP(Рантайм, Операция);
			Исключение Результат = ОшибкаБезДанныхСервераMCP(); КонецПопытки;
			Если НЕ Результат.success Тогда СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Ошибка обработки результата", Операция.Ид, Операция.Команда.tool); КонецЕсли;
			// Проверка повторяется после Lineage/Regex/TOON: поздний успех не отправляется.
			Если МаршрутЗаданияСервераАктуален(Рантайм, Операция) Тогда
				ПередачаВыполнена = Истина;
				Маршрут = Операция.Маршрут;
				Результат = РезультатСИсточникомБазы(Результат, Маршрут);
				ПодготовитьЖурналРезультатаСервераMCP(Маршрут, Результат);
				Если Маршрут.Режим = "proxy" Тогда
					ОтветПроксиСервераMCP(Рантайм, Маршрут, Результат);
				Иначе
				Тело = ?(Маршрут.Режим = "rest", ЗаписатьJSON2(Результат),
					СформироватьJSONRPCОтвет(Маршрут.RPC, СформироватьСодержимоеToolsCall(Результат, Истина)));
				Если Маршрут.Режим = "legacy" Тогда ОтветSSEСервераMCP(Рантайм, Маршрут.HTTP, Тело, Маршрут);
				Иначе ОтветСервераMCP(Рантайм, Новый Структура("id", Маршрут.HTTP), 200, Тело, , Маршрут); КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Операция.Маршрут.Режим <> "probe" И НЕ ПередачаВыполнена Тогда
			СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, ?(Операция.ЗавершениеЗапрошено, "Запрос отменён", "Запрос завершён: истёк срок или потеряно соединение"), Операция.Ид, Операция.Команда.tool);
		КонецЕсли;
		ЗавершитьВыдачуПланировщика(Планировщик, Операция.Ид, Операция.Поколение);
	КонецЦикла;
	Удаляемые = Новый Массив;
	Для Каждого Пара Из Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Если Операция.ОтветВыдан И НЕ Операция.ЗанимаетСлот И (Операция.ИсполнительВладельца <> "" Или ОсвободитьРезультатПараллельнойОперации(Операция)) Тогда
			Операция.РесурсыОсвобождены = Истина;
			Удаляемые.Добавить(Операция.Ид);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ид Из Удаляемые Цикл УдалитьОперациюПланировщика(Планировщик, Ид); КонецЦикла;
КонецПроцедуры

Процедура ДобавитьОшибкуОстановкиСервераMCP(Рантайм, Текст)
	Если НЕ Рантайм.Свойство("ОшибкаОстановки") Тогда Рантайм.Вставить("ОшибкаОстановки", ""); КонецЕсли;
	Если Найти(Рантайм.ОшибкаОстановки, Текст) = 0 Тогда Рантайм.ОшибкаОстановки = Рантайм.ОшибкаОстановки + Символы.ПС + Текст; КонецЕсли;
КонецПроцедуры

Процедура СохранитьЗаданияПриОстановкеСервераMCP(Рантайм)
	Попытка СохранитьЗаданияСервераMCP(Рантайм);
	Исключение ДобавитьОшибкуОстановкиСервераMCP(Рантайм, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

Процедура ОстановитьЗаданияСервераMCP(Рантайм)
	// Новые задания не стартуют; уже работающим даётся короткое время на завершение.
	Рантайм.Планировщик.Режим = "checking";
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Если НЕ Операция.ЗанимаетСлот Тогда ПрерватьОперациюПланировщика(Операция, "Server is stopping"); КонецЕсли;
		// Отправка могла оборваться исключением после взятия результата.
		Если Операция.ВыдачаНачата И НЕ Операция.ОтветВыдан Тогда
			ЗавершитьВыдачуПланировщика(Рантайм.Планировщик, Операция.Ид, Операция.Поколение);
		КонецЕсли;
	КонецЦикла;
	Рантайм.Вставить("ОшибкаОстановки", "");
	Попытка ЗаписатьИсходСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "draining");
	Исключение ДобавитьОшибкуОстановкиСервераMCP(Рантайм, ОписаниеОшибки()); КонецПопытки;
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
	СрокЗавершения = ТекущаяУниверсальнаяДатаВМиллисекундах() + 1000;
	Пока Рантайм.Планировщик.Операции.Количество() > 0 Или Рантайм.ИсполнительСправки.Запущен Или Рантайм.ИсполнительСправки.Остановка Цикл
		Попытка ПроходПараллельнойСправкиСервераMCP(Рантайм, Ложь);
		Исключение ДобавитьОшибкуОстановкиСервераMCP(Рантайм, ОписаниеОшибки()); КонецПопытки;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= СрокЗавершения Тогда
			ОстановитьПланировщикКоманд(Рантайм.Планировщик, "Server is stopping");
		КонецЕсли;
		Попытка ПроходЗаданийСервераMCP(Рантайм, Истина);
		Исключение
			ДобавитьОшибкуОстановкиСервераMCP(Рантайм, ОписаниеОшибки());
			// Даже ошибка опроса не отменяет попытку отменить собственные известные задания.
			Отмены = Новый Массив;
			Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
				Если Пара.Значение.ЗанимаетСлот Тогда Отмены.Добавить(Пара.Значение); КонецЕсли;
			КонецЦикла;
			Попытка ОтменитьПараллельныеЗадания(Отмены);
			Исключение ДобавитьОшибкуОстановкиСервераMCP(Рантайм, ОписаниеОшибки()); КонецПопытки;
		КонецПопытки;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Срок Тогда
			ВызватьИсключение "Дочерние задания ещё не завершены; новый запуск проверит их по сохранённым ключам." + Рантайм.ОшибкаОстановки;
		КонецЕсли;
		Если Рантайм.Планировщик.Операции.Количество() > 0 Тогда
			Попытка
			Если ПрофильПроксиСервераMCP(Рантайм) Тогда Рантайм.Транспорт.WaitMilliseconds(100); Продолжить; КонецЕсли;
			Событие = ПрочитатьJSON2(Рантайм.Транспорт.WaitNextEvent(100));
			Если Событие.outcome = "stopped" Тогда
				ОстановитьПланировщикКоманд(Рантайм.Планировщик, "HTTP transport stopped");
				ПроходЗаданийСервераMCP(Рантайм, Истина);
				ДобавитьОшибкуОстановкиСервераMCP(Рантайм, "Транспорт остановлен до завершения дочерних заданий.");
			КонецЕсли;
			Если Событие.outcome = "event" И Событие.event <> "SSE_CLOSED" Тогда
				ОтветСервераMCP(Рантайм, Событие.data, 503, "{}");
			КонецЕсли;
			Исключение ДобавитьОшибкуОстановкиСервераMCP(Рантайм, ОписаниеОшибки()); КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Если Рантайм.СредаЗаданий <> Неопределено Тогда ОсвободитьСредуПараллельногоВыполнения(Рантайм.СредаЗаданий, Новый Массив); КонецЕсли;
	Рантайм.СредаЗаданий = Неопределено;
	СохранитьЗаданияПриОстановкеСервераMCP(Рантайм);
	Если Рантайм.ОшибкаОстановки <> "" Тогда ВызватьИсключение Рантайм.ОшибкаОстановки; КонецЕсли;
КонецПроцедуры

Функция СловарьСервераMCP(Правила)
	// В автономном режиме ошибка запроса должна прервать запуск,
	// чтобы не обслуживать запросы с неполным словарём анонимизации.
	Результат = ПостроитьСловарьАнонимизацииПоПравилам(Правила, Истина);
	Возврат Результат.Данные;
КонецФункции



Функция ПрофильПроксиСервераMCP(Рантайм)
	Возврат Рантайм.Профиль.settings.transport = "proxy";
КонецФункции

Функция АдресПроксиСервераMCP(Настройки)
	Адрес = Настройки.proxy_url;
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда ВызватьИсключение "Укажите HTTP(S)-адрес прокси."; КонецЕсли;
	Защищенный = Лев(НРег(Адрес), 8) = "https://";
	Если НЕ Защищенный И Лев(НРег(Адрес), 7) <> "http://" Тогда ВызватьИсключение "Укажите HTTP(S)-адрес прокси."; КонецЕсли;
	Для Каждого Символ Из РазделитьСтрокуПоРазделителю("@,?,#", ",") Цикл
		Если Найти(Адрес, Символ) > 0 Тогда ВызватьИсключение "В адресе прокси не допускаются пользователь, параметры и фрагмент."; КонецЕсли;
	КонецЦикла;
	Остаток = Сред(Адрес, ?(Защищенный, 9, 8));
	Путь = "";
	Разделитель = Найти(Остаток, "/");
	Если Разделитель > 0 Тогда Путь = Сред(Остаток, Разделитель); Остаток = Лев(Остаток, Разделитель - 1); КонецЕсли;
	Пока Прав(Путь, 1) = "/" Цикл Путь = Лев(Путь, СтрДлина(Путь) - 1); КонецЦикла;
	Порт = ?(Защищенный, 443, 80);
	Разделитель = Найти(Остаток, ":");
	Если Разделитель > 0 Тогда
		ТекстПорта = Сред(Остаток, Разделитель + 1);
		Если ПустаяСтрока(ТекстПорта) Тогда ВызватьИсключение "Пустой порт прокси."; КонецЕсли;
		Для Индекс = 1 По СтрДлина(ТекстПорта) Цикл
			Если Найти("0123456789", Сред(ТекстПорта, Индекс, 1)) = 0 Тогда ВызватьИсключение "Неверный порт прокси."; КонецЕсли;
		КонецЦикла;
		Порт = Число(ТекстПорта);
		Остаток = Лев(Остаток, Разделитель - 1);
	КонецЕсли;
	Если ПустаяСтрока(Остаток) Или Порт < 1 Или Порт > 65535 Тогда ВызватьИсключение "Неверный адрес прокси."; КонецЕсли;
	Канал = Настройки.proxy_channel;
	Если ТипЗнч(Канал) <> Тип("Строка") Тогда ВызватьИсключение "Неверный канал прокси."; КонецЕсли;
	Если Канал = "" Тогда Канал = "default"; КонецЕсли;
	Если СтрДлина(Канал) > 64 Тогда ВызватьИсключение "Канал прокси длиннее 64 символов."; КонецЕсли;
	Для Индекс = 1 По СтрДлина(Канал) Цикл
		Если Найти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-", Сред(Канал, Индекс, 1)) = 0 Тогда
			ВызватьИсключение "Канал прокси: допустимы латинские буквы, цифры, дефис и подчёркивание.";
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("host,port,path,secure,channel", Остаток, Порт, Путь, Защищенный, Канал);
КонецФункции

Функция ЗапросПроксиСервераMCP(Рантайм, ПутьМетода, Тело = Неопределено, ДопЗапрос = "", Таймаут = 2)
	Адрес = АдресПроксиСервераMCP(Рантайм.Профиль.settings);
	SSL = Неопределено;
	Если Адрес.secure Тогда SSL = Новый ЗащищенноеСоединениеOpenSSL; КонецЕсли;
	Соединение = Новый HTTPСоединение(Адрес.host, Адрес.port, , , , Таймаут, SSL);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если Рантайм.Прокси.lease <> "" Тогда Заголовки.Вставить("X-MCP-Host-Lease", Рантайм.Прокси.lease); КонецЕсли;
	ЗапросHTTP = Новый HTTPЗапрос(Адрес.path + ПутьМетода + "?channel=" + Адрес.channel + ДопЗапрос, Заголовки);
	Если Тело = Неопределено Тогда
		ОтветHTTP = Соединение.Получить(ЗапросHTTP);
	Иначе
		ЗапросHTTP.УстановитьТелоИзСтроки(ЗаписатьJSON2(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
	КонецЕсли;
	Если ОтветHTTP.КодСостояния = 409 Тогда
		Рантайм.Прокси.lease = "";
		Рантайм.Прокси.connected = Ложь;
		ВызватьИсключение "Регистрация серверного экземпляра на прокси утрачена или канал занят.";
	КонецЕсли;
	Если ОтветHTTP.КодСостояния = 204 Тогда Возврат Неопределено; КонецЕсли;
	Если ОтветHTTP.КодСостояния <> 200 Тогда ВызватьИсключение "Прокси вернул HTTP " + Строка(ОтветHTTP.КодСостояния); КонецЕсли;
	Возврат ПрочитатьJSON2(ОтветHTTP.ПолучитьТелоКакСтроку());
КонецФункции

Процедура ПодключитьПроксиСервераMCP(Рантайм)
	Если Рантайм.Прокси.lease <> "" Тогда Возврат; КонецЕсли;
	Попытка
		Профиль = Рантайм.Профиль;
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(СтрокаСоединенияИнформационнойБазы());
		Тело = Новый Структура("version,finalization_owner,base,registration,user,instance,epoch,tools", 1, "proxy",
			Base64Строка(Хеш.ХешСумма), Строка(Рантайм.Регистрация.УникальныйИдентификатор()), Профиль.user_id,
			Профиль.instance, Формат(Профиль.epoch, "ЧГ=0"), ДоступныеИнструментыСервераMCP(Рантайм));
		Тело.Вставить("anon_confirm", Ложь);
		// При регистрации прокси может впервые загружать модель анонимизации.
		Ответ = ЗапросПроксиСервераMCP(Рантайм, "/1c/host/register", Тело, , 30);
		Если Ответ.version <> 1 Или Ответ.finalization_owner <> "proxy" Или ПустаяСтрока(Ответ.lease)
			Или ПустаяСтрока(Ответ.generation) Тогда ВызватьИсключение "Прокси не подтвердил серверный протокол."; КонецЕсли;
		Рантайм.Прокси.lease = Ответ.lease;
		Рантайм.Прокси.generation = Ответ.generation;
		Рантайм.Прокси.connected = Истина;
		Рантайм.Прокси.error = "";
		СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Подключено к прокси");
	Исключение
		Рантайм.Прокси.connected = Ложь;
		Рантайм.Прокси.error = "Не удалось зарегистрироваться на прокси. Проверьте адрес, версию прокси и владельца канала. Повтор подключения выполняется автоматически.";
	КонецПопытки;
КонецПроцедуры

Процедура ОбновитьСостоянияПроксиСервераMCP(Рантайм)
	Рантайм.Прокси.states.Очистить();
	Если Рантайм.Прокси.lease = "" Тогда Возврат; КонецЕсли;
	Список = "";
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Маршрут = Пара.Значение.Маршрут;
		Если Маршрут.Режим = "proxy" И Маршрут.Сессия = Рантайм.Прокси.lease Тогда
			Список = Список + ?(Список = "", "", ",") + Маршрут.HTTP;
		КонецЕсли;
	КонецЦикла;
	Если Список = "" Тогда Возврат; КонецЕсли;
	Попытка
		Ответ = ЗапросПроксиСервераMCP(Рантайм, "/1c/host/status", , "&ids=" + Список);
		Если Ответ.version <> 1 Тогда ВызватьИсключение "Неверная версия статусов прокси."; КонецЕсли;
		Для Каждого Состояние Из Ответ.items Цикл
			Рантайм.Прокси.states.Вставить(Состояние.id, Состояние.active И Состояние.remaining_ms > 0);
		КонецЦикла;
		Рантайм.Прокси.connected = Истина;
	Исключение
		// Не повторять команду с неизвестным исходом при разрыве связи.
		Рантайм.Прокси.connected = Ложь;
	КонецПопытки;
КонецПроцедуры

Процедура ОпросПроксиСервераMCP(Рантайм, Ожидание)
	Если Рантайм.Прокси.lease = "" Тогда Рантайм.Транспорт.WaitMilliseconds(1000); Возврат; КонецЕсли;
	Попытка
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Команда = ЗапросПроксиСервераMCP(Рантайм, "/1c/host/poll", , "&timeout=" + ?(Ожидание = 100, "0.1", "1"), 2);
		Рантайм.Прокси.connected = Истина;
		Рантайм.Прокси.error = "";
		Если Команда = Неопределено Тогда Возврат; КонецЕсли;
		Если Команда.version <> 1 Или Команда.lease <> Рантайм.Прокси.lease Тогда ВызватьИсключение "Неверный владелец команды прокси."; КонецЕсли;
		Маршрут = Новый Структура("Режим,HTTP,RPC,Сессия,Срок", "proxy", Команда.id, Команда.id,
			Команда.lease, Начало + Команда.remaining_ms);
		Если Маршрут.Срок <= ТекущаяУниверсальнаяДатаВМиллисекундах() Тогда Возврат; КонецЕсли;
	Исключение
		Рантайм.Прокси.connected = Ложь;
		Рантайм.Прокси.error = "Связь с прокси прервана. Повтор подключения выполняется автоматически; начатые команды не повторяются.";
		Рантайм.Транспорт.WaitMilliseconds(1000);
		Возврат;
	КонецПопытки;
	// Отказы управляющего состояния должны завершать контроллер, а не повторять poll.
	Актуальное = СостояниеСервераMCP(Рантайм.Регистрация);
	Если НЕ Актуальное.desired Или НЕ ТотЖеЭкземплярСервераMCP(Актуальное, Рантайм.Профиль) Тогда Возврат; КонецЕсли;
	Результат = ВыполнитьИнструментСервераMCP(Рантайм, Команда.tool, Команда.params, Маршрут);
	Если Результат <> Неопределено Тогда ОтветПроксиСервераMCP(Рантайм, Маршрут, Результат); КонецЕсли;
КонецПроцедуры

Функция ОтветПроксиСервераMCP(Рантайм, Маршрут, Результат)
	ПодготовитьЖурналРезультатаСервераMCP(Маршрут, Результат);
	Если Маршрут.Сессия <> Рантайм.Прокси.lease Или Маршрут.Срок <= ТекущаяУниверсальнаяДатаВМиллисекундах() Тогда ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Ложь); Возврат Ложь; КонецЕсли;
	Успех = Ложь;
	Попытка
		// Маршрут не переносится на новую регистрацию; повторной отправки нет.
		Тело = Новый Структура("id", Маршрут.HTTP);
		Для Каждого Поле Из Результат Цикл Тело.Вставить(Поле.Ключ, Поле.Значение); КонецЦикла;
		Ответ = ЗапросПроксиСервераMCP(Рантайм, "/1c/result", Тело);
		Успех = ПолучитьЗначениеОбъекта(Ответ, "status") = "ok";
	Исключение Рантайм.Прокси.connected = Ложь; КонецПопытки;
	ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Успех);
	Возврат Успех;
КонецФункции

Функция УпаковатьРезультатСервераMCP(Рантайм, Результат, Маршрут = Неопределено)
	Если НЕ Результат.success Тогда Возврат Результат; КонецЕсли;
		Если ПрофильПроксиСервераMCP(Рантайм) Тогда Возврат Результат; КонецЕсли;
		Результат = ПодготовитьДанныеУспешногоToolsCall(Результат);
		Если Рантайм.ФорматОтветаВстроенный = 1 И Результат.Свойство("data") Тогда
			Если Рантайм.КомпонентаТун = Неопределено Тогда ВызватьИсключение "TOON недоступен"; КонецЕсли;
			Тун = Рантайм.КомпонентаТун.JsonToToon(ЗаписатьJSON2(Результат.data));
			Если НЕ ЗначениеЗаполнено(Тун) Тогда ВызватьИсключение "TOON не вернул результат"; КонецЕсли;
			// Уже анонимизированные данные; сохраняем представление только после успешной конвертации.
			ПодготовитьЖурналРезультатаСервераMCP(Маршрут, Результат);
			Результат.data = Тун;
		КонецЕсли;
		Возврат Результат;
КонецФункции

Функция КаталогИнструментовСервераMCP()
	Возврат РазделитьСтрокуПоРазделителю("execute_query,execute_code,get_metadata,get_event_log,get_object_by_link,get_link_of_object,find_references_to_object,get_access_rights,get_bsl_syntax_help", ",");
КонецФункции

Функция ДоступныеИнструментыСервераMCP(Рантайм)
	Имена = Новый Массив;
	Для Каждого Инструмент Из ПолучитьСхемыИнструментов(Рантайм).tools Цикл Имена.Добавить(Инструмент.name); КонецЦикла;
	Возврат Имена;
КонецФункции

Процедура ПодготовитьСправкуСервераMCP(Рантайм)
	Рантайм.КомпонентаSyntaxHelp = Неопределено;
	Если НЕ Рантайм.ИнструментВключен_GetBslSyntaxHelp Тогда
		Рантайм.Профиль.syntax_help_status = "выключена";
		Возврат;
	КонецЕсли;
	Рантайм.Профиль.syntax_help_status = "недоступна";
	Если Рантайм.ЗагруженнаяКомпонентаСправки = Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		КомпонентаСправки = Рантайм.ЗагруженнаяКомпонентаСправки;
		ЧислоТем = КомпонентаСправки.Инициализировать(КаталогПрограммы());
		Если ЧислоТем <= 0 Тогда ВызватьИсключение "Не удалось прочитать темы справки из каталога платформы сервера."; КонецЕсли;
		Рантайм.КомпонентаSyntaxHelp = КомпонентаСправки;
		Рантайм.Профиль.syntax_help_status = "готова";
		Рантайм.Профиль.syntax_help_error = "";
	Исключение
		Рантайм.Профиль.syntax_help_status = "недоступна";
		Рантайм.Профиль.syntax_help_error = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

Функция ПроверитьОтменыПередСправкойСервераMCP(Рантайм)
	Если ПрофильПроксиСервераMCP(Рантайм) Тогда
		ОбновитьСостоянияПроксиСервераMCP(Рантайм);
		Возврат Рантайм.Прокси.connected;
	КонецЕсли;
	Рантайм.ПринимаютсяУправляющиеСобытия = Истина;
	Попытка
		Для НомерСобытия = 1 По 128 Цикл
			Событие = ПрочитатьJSON2(Рантайм.Транспорт.WaitNextEvent(0));
			Если Событие.outcome = "stopped" Тогда ВызватьИсключение "Очередь HTTP остановилась."; КонецЕсли;
			Если Событие.outcome = "timeout" Тогда
				Рантайм.ПринимаютсяУправляющиеСобытия = Ложь;
				Возврат Истина;
			КонецЕсли;
			ОбработатьСобытиеСервераMCP(Рантайм, Событие);
		КонецЦикла;
	Исключение
		Рантайм.ПринимаютсяУправляющиеСобытия = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	Рантайм.ПринимаютсяУправляющиеСобытия = Ложь;
	Возврат Ложь;
КонецФункции

Процедура ПроходИсполнителяСервераMCP(Рантайм)
	ПараллельнаяСправка = Рантайм.Планировщик.Режим = "enabled"
		И Рантайм.СредаЗаданий <> Неопределено И Рантайм.СредаЗаданий.ready;
	ПроходПараллельнойСправкиСервераMCP(Рантайм, ПараллельнаяСправка);
	Если Рантайм.Планировщик.Операции.Количество() = 0 Тогда
		Рантайм.ОжидаетсяПроверкаОтмен = Ложь;
		Возврат;
	КонецЕсли;
	Если НЕ Рантайм.ОжидаетсяПроверкаОтмен Тогда
		Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
			Операция = Пара.Значение;
			Если Операция.Состояние <> "owner_queued" Тогда Продолжить; КонецЕсли;
			Если Операция.ИсполнительВладельца = "owner_help" Тогда
				Если Рантайм.ИсполнительСправки.Запущен Или Рантайм.ИсполнительСправки.Остановка Тогда Продолжить; КонецЕсли;
				Если ПараллельнаяСправка И Рантайм.ИсполнительСправки.Доступен <> Ложь И Рантайм.ИсполнительСправки.Ошибка = "" Тогда Продолжить; КонецЕсли;
			КонецЕсли;
			Если НЕ МаршрутЗаданияСервераАктуален(Рантайм, Операция) Тогда ПрерватьОперациюПланировщика(Операция, "Request expired or disconnected"); Продолжить; КонецЕсли;
			Операция.Состояние = "owner_running";
			СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Начато выполнение", Операция.Ид, Операция.Команда.tool);
			Попытка
				Если ПривилегированныйРежим() Тогда ВызватьИсключение "Недопустимый привилегированный контекст"; КонецЕсли;
				Если Операция.ИсполнительВладельца = "owner_help" Тогда
					Операция.Результат = ПолучитьСправкуПоBSL(Рантайм, Операция.Команда.params);
				Иначе
					Операция.Результат = ВыполнитьКомандуНаСервере(Операция.Подготовка.Команда);
				КонецЕсли;
			Исключение Операция.Результат = ОшибкаБезДанныхСервераMCP(); КонецПопытки;
			Операция.Состояние = "owner_ready";
			Рантайм.ОжидаетсяПроверкаОтмен = Истина;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Если Пара.Значение.Состояние = "owner_ready" Тогда Рантайм.ОжидаетсяПроверкаОтмен = Истина; КонецЕсли;
	КонецЦикла;
	Если НЕ Рантайм.ОжидаетсяПроверкаОтмен Тогда Возврат; КонецЕсли;
	Если НЕ ПроверитьОтменыПередСправкойСервераMCP(Рантайм) Тогда Возврат; КонецЕсли;
	Актуальное = СостояниеСервераMCP(Рантайм.Регистрация);
	Если НЕ Актуальное.desired Или НЕ ТотЖеЭкземплярСервераMCP(Актуальное, Рантайм.Профиль) Тогда
		ВызватьИсключение "Владелец сервера изменён или остановлен.";
	КонецЕсли;
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Если Пара.Значение.Состояние = "owner_ready" Тогда Пара.Значение.Состояние = "result_ready"; КонецЕсли;
	КонецЦикла;
	Рантайм.ОжидаетсяПроверкаОтмен = Ложь;
КонецПроцедуры

Процедура ПроходПараллельнойСправкиСервераMCP(Рантайм, Параллельно)
	Если Рантайм.КомпонентаSyntaxHelp = Неопределено Тогда Возврат; КонецЕсли;
	Исполнитель = Рантайм.ИсполнительСправки;
	Для НомерВызова = 1 По 16 Цикл
		Вызов = СледующийВызовИсполнителяСправки(Исполнитель, Рантайм.Планировщик, Параллельно, ТекущаяУниверсальнаяДатаВМиллисекундах());
		Если Вызов = Неопределено Тогда Прервать; КонецЕсли;
		Попытка
			КомпонентаСправки = Рантайм.КомпонентаSyntaxHelp;
			Метод = Вызов.Метод;
			Если Метод = "GetCapabilities" Тогда ОтветJSON = КомпонентаСправки.GetCapabilities();
			ИначеЕсли Метод = "StartSearchExecutor" Тогда ОтветJSON = КомпонентаСправки.StartSearchExecutor();
			ИначеЕсли Метод = "GetSearchStates" Тогда ОтветJSON = КомпонентаСправки.GetSearchStates();
			ИначеЕсли Метод = "ReadSearchResult" Тогда ОтветJSON = КомпонентаСправки.ReadSearchResult(Вызов.Ид);
			ИначеЕсли Метод = "AcknowledgeSearch" Тогда ОтветJSON = КомпонентаСправки.AcknowledgeSearch(Вызов.Ид);
			ИначеЕсли Метод = "CancelSearch" Тогда ОтветJSON = КомпонентаСправки.CancelSearch(Вызов.Ид);
			ИначеЕсли Метод = "BeginShutdown" Тогда ОтветJSON = КомпонентаСправки.BeginShutdown();
			ИначеЕсли Метод = "GetShutdownState" Тогда ОтветJSON = КомпонентаСправки.GetShutdownState();
			ИначеЕсли Метод = "SubmitSearch" Тогда
				Подготовка = Рантайм.Планировщик.Операции[Вызов.Ид].ПодготовкаПоиска;
				ОтветJSON = КомпонентаСправки.SubmitSearch(Вызов.Ид, Подготовка.КлючевыеСловаJSON, Подготовка.РежимВсе);
			Иначе ВызватьИсключение "Unknown help action";
			КонецЕсли;
			ОтветСправки = ПрочитатьJSON2(ОтветJSON);
			Если Метод = "GetSearchStates" Тогда
				Для Каждого СостояниеПоиска Из ОтветСправки.items Цикл
					ЗаписатьНачалоПоискаСервераMCP(Рантайм, СостояниеПоиска);
				КонецЦикла;
			КонецЕсли;
			Если Метод = "ReadSearchResult" Тогда ЗаписатьНачалоПоискаСервераMCP(Рантайм, ОтветСправки); КонецЕсли;
			ПринятьОтветИсполнителяСправки(Исполнитель, Рантайм.Планировщик, Вызов, ОтветСправки);
		Исключение
			ОшибкаВызоваИсполнителяСправки(Исполнитель, Рантайм.Планировщик, Вызов);
			Если Вызов.Метод = "GetCapabilities" Тогда
				Рантайм.Профиль.syntax_help_error = "Компонента поддерживает только последовательный поиск справки.";
			КонецЕсли;
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Для Каждого Пара Из Рантайм.Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Если Операция.ПоискСостояние <> "released" Или Операция.Состояние <> "owner_ready" Тогда Продолжить; КонецЕсли;
		Попытка
			Операция.Результат = СформироватьРезультатСправкиBSL(Операция.ПоискРезультатJSON, Операция.ПодготовкаПоиска);
		Исключение Операция.Результат = ОшибкаБезДанныхСервераMCP(); КонецПопытки;
		Операция.ПоискРезультатJSON = Неопределено;
		Операция.ПоискСостояние = "formatted";
	КонецЦикла;
КонецПроцедуры


Процедура ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Успех)
	Если Маршрут = Неопределено Или НЕ Маршрут.Свойство("ЖурналИд") Тогда Возврат; КонецЕсли;
	СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль,
		?(Успех, "Результат отправлен", "Ошибка отправки результата"), Маршрут.ЖурналИд, Маршрут.ЖурналИнструмент, ,
		?(Маршрут.Свойство("ЖурналРезультат"), Маршрут.ЖурналРезультат, ""));
КонецПроцедуры

Функция ОтветSSEСервераMCP(Рантайм, ИдПотока, Тело, Маршрут = Неопределено)
	Успех = Ложь;
	Попытка Успех = Рантайм.Транспорт.SendSSEEvent(ИдПотока, Тело, "{}", "message");
	Исключение
		ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Ложь); ВызватьИсключение;
	КонецПопытки;
	ЗаписатьОтправкуСервераMCP(Рантайм, Маршрут, Успех);
	Возврат Успех;
КонецФункции

Процедура ЗаписатьНачалоПоискаСервераMCP(Рантайм, СостояниеПоиска)
	Если НЕ СостояниеПоиска.Свойство("started_at") Или СостояниеПоиска.started_at <= 0 Тогда Возврат; КонецЕсли;
	Операция = Рантайм.Планировщик.Операции[СостояниеПоиска.id];
	Если Операция = Неопределено Или Операция.Свойство("НачалоЗаписаноВЖурнал") Тогда Возврат; КонецЕсли;
	ВремяНачала = Дата(1970, 1, 1) + СостояниеПоиска.started_at
		+ (ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата());
	СобытиеСервераMCP(Рантайм.Регистрация, Рантайм.Профиль, "Начато выполнение", СостояниеПоиска.id, "get_bsl_syntax_help", ВремяНачала);
	Операция.Вставить("НачалоЗаписаноВЖурнал", Истина);
КонецПроцедуры

Процедура ОбновитьАктивныеЗапросыЖурналаMCP(Профиль, Вид, Операция)
	Если НЕ Профиль.Свойство("events_active") Тогда Возврат; КонецЕсли;
	Если Операция <> "" Тогда
		Ключ = Профиль.instance + ":" + Строка(Операция);
		Если Вид = "Получена команда" Тогда
			Профиль.events_active.Вставить(Ключ, Истина);
		ИначеЕсли Вид = "Результат отправлен" Или Вид = "Ошибка отправки результата"
			Или Вид = "Запрос отменён" Или Вид = "Запрос завершён: истёк срок или потеряно соединение" Тогда
			Профиль.events_active.Удалить(Ключ);
		КонецЕсли;
	КонецЕсли;
