Функция ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим)

	Если Найти(ТипОбъекта, "ПеречислениеСсылка.") = 1 Тогда Возврат "force_keep"; КонецЕсли;
	ПутьНаименования = ПолучитьПутьНаименованияПоТипуОбъекта(ТипОбъекта);
	Режим = "default";
	Если НЕ ПустаяСтрока(ПутьНаименования) Тогда
		Правило = ПолучитьПравилоПоПутиАнонимизации(ПравилаАнонимизации, ПутьНаименования);
		Если Правило <> Неопределено Тогда
			Режим = ?(Правило.action = "keep", "force_keep", "force_anonymize");
		КонецЕсли;
	КонецЕсли;
	// Планы счетов — force_keep если нет явного правила force_anonymize.
	// Проверка ДО агрессивного режима: aggressive mode не затрагивает планы счетов.
	Если Найти(ТипОбъекта, "ПланСчетовСсылка.") = 1 И Режим <> "force_anonymize" Тогда
		Возврат "force_keep";
	КонецЕсли;
	// Агрессивная обработка выбирается при обработке значения, отдельно от явного режима.
	Возврат Режим;

КонецФункции

Функция НайтиПозициюПоследнейТочки(СтрокаПути)

	ПозицияТочки = 0;
	ПозицияПоиска = 1;
	Пока Истина Цикл
		СледующаяПозиция = Найти(Сред(СтрокаПути, ПозицияПоиска), ".");
		Если СледующаяПозиция = 0 Тогда
			Прервать;
		КонецЕсли;
		СледующаяПозиция = ПозицияПоиска + СледующаяПозиция - 1;
		ПозицияТочки = СледующаяПозиция;
		ПозицияПоиска = СледующаяПозиция + 1;
	КонецЦикла;

	Возврат ПозицияТочки;

КонецФункции

Функция ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(Результат) Экспорт

	Попытка Результат.Удалить("_original_data_json");        Исключение КонецПопытки;
	Попытка Результат.Удалить("_original_data_anon_marker"); Исключение КонецПопытки;
	Попытка Результат.Удалить("_cmd_arguments_json");        Исключение КонецПопытки;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ Результат.Свойство("schema") Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат.schema = Неопределено Или ТипЗнч(Результат.schema) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Колонки = Неопределено;
	Если НЕ Результат.schema.Свойство("columns", Колонки) Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Колонка.Удалить("anonymization_mode");
		Исключение
		КонецПопытки;
		Попытка
			Колонка.Удалить("reference_presentation_mode");
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура АнонимизаторИнициализировать(КонтекстРантайма)

	Если КонтекстРантайма.МаппингАнонимизации = Неопределено Тогда
		КонтекстРантайма.МаппингАнонимизации   = Новый Соответствие;
	КонецЕсли;
	Если КонтекстРантайма.МаппингДеанонимизации = Неопределено Тогда
		КонтекстРантайма.МаппингДеанонимизации = Новый Соответствие;
	КонецЕсли;
	Если КонтекстРантайма.СчетчикиТокенов = Неопределено Тогда
		КонтекстРантайма.СчетчикиТокенов       = Новый Соответствие;
	КонецЕсли;
	Если КонтекстРантайма.СловарьАнонимизации = Неопределено Тогда
		КонтекстРантайма.СловарьАнонимизации   = Новый Массив;
	КонецЕсли;
	Если КонтекстРантайма.БакетИндексСловаря = Неопределено Тогда
		КонтекстРантайма.БакетИндексСловаря    = Новый Соответствие;
	КонецЕсли;
	Если КонтекстРантайма.СловарьПостроен = Неопределено Тогда
		КонтекстРантайма.СловарьПостроен       = Ложь;
	КонецЕсли;
	Если КонтекстРантайма.ОчередьВставки = Неопределено Тогда
		КонтекстРантайма.ОчередьВставки        = Новый Массив;
	КонецЕсли;
	Если КонтекстРантайма.ГоловаОчереди = Неопределено Тогда
		КонтекстРантайма.ГоловаОчереди         = 0;
	КонецЕсли;

КонецПроцедуры

Функция АнонимизаторТокенизировать(КонтекстРантайма, Значение, Категория)

	АнонимизаторИнициализировать(КонтекстРантайма);

	СуществующийТокен = КонтекстРантайма.МаппингАнонимизации.Получить(Значение);
	Если СуществующийТокен <> Неопределено Тогда
		Возврат СуществующийТокен;
	КонецЕсли;

	Счётчик = КонтекстРантайма.СчетчикиТокенов.Получить(Категория);
	Если Счётчик = Неопределено Тогда
		Счётчик = 0;
	КонецЕсли;
	Счётчик = Счётчик + 1;
	КонтекстРантайма.СчетчикиТокенов.Вставить(Категория, Счётчик);

	Префикс = КонтекстРантайма.ПоколениеТокенов;
	Токен = "[" + Категория + "-" + ?(Префикс = "", "", Префикс + "-")
		+ Формат(Счётчик, "ЧЦ=5; ЧВН=; ЧН=0; ЧГ=0") + "]";
	КонтекстРантайма.МаппингАнонимизации.Вставить(Значение, Токен);
	КонтекстРантайма.МаппингДеанонимизации.Вставить(ВРег(Токен), Значение);
	// Только копим порядок вставки; вытеснение — на границе запроса (АнонимизаторВытеснитьДоЛимита),
	// иначе крупный ответ вытеснил бы собственные токены до отдачи агенту.
	КонтекстРантайма.ОчередьВставки.Добавить(Значение);

	Возврат Токен;

КонецФункции

Процедура АнонимизаторВытеснитьДоЛимита(КонтекстРантайма) Экспорт

	АнонимизаторИнициализировать(КонтекстРантайма);

	Если КонтекстРантайма.ЛимитМаппингаВстроенный <= 0 Тогда
		Возврат;
	КонецЕсли;

	Пока КонтекстРантайма.МаппингАнонимизации.Количество() > КонтекстРантайма.ЛимитМаппингаВстроенный
	      И КонтекстРантайма.ГоловаОчереди < КонтекстРантайма.ОчередьВставки.Количество() Цикл
		СтароеЗначение = КонтекстРантайма.ОчередьВставки[КонтекстРантайма.ГоловаОчереди];
		КонтекстРантайма.ГоловаОчереди  = КонтекстРантайма.ГоловаОчереди + 1;   // сдвигаем голову, массив не трогаем
		СтарыйТокен = КонтекстРантайма.МаппингАнонимизации.Получить(СтароеЗначение);
		КонтекстРантайма.МаппингАнонимизации.Удалить(СтароеЗначение);
		Если СтарыйТокен <> Неопределено Тогда
			КонтекстРантайма.МаппингДеанонимизации.Удалить(ВРег(СтарыйТокен));
		КонецЕсли;
	КонецЦикла;

	// Редкая компактизация: срезаем «съеденный» префикс за один проход,
	// только когда он большой (амортизированно линейно).
	Если КонтекстРантайма.ГоловаОчереди > 1000 И КонтекстРантайма.ГоловаОчереди * 2 > КонтекстРантайма.ОчередьВставки.Количество() Тогда
		НовыйМассив = Новый Массив;
		Для Инд = КонтекстРантайма.ГоловаОчереди По КонтекстРантайма.ОчередьВставки.Количество() - 1 Цикл
			НовыйМассив.Добавить(КонтекстРантайма.ОчередьВставки[Инд]);
		КонецЦикла;
		КонтекстРантайма.ОчередьВставки = НовыйМассив;
		КонтекстРантайма.ГоловаОчереди  = 0;
	КонецЕсли;

КонецПроцедуры

Функция ЭтоВалидныйТокенФормат(Строка)

	// Формат: [CATEGORY-NNNNN] — буквы, дефис, минимум 5 цифр (счётчик > 99999 даёт > 5 знаков)
	Длина = СтрДлина(Строка);
	Если Длина < 9 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Лев(Строка, 1) <> "[" Или Прав(Строка, 1) <> "]" Тогда
		Возврат Ложь;
	КонецЕсли;
	Внутренняя = Сред(Строка, 2, Длина - 2);
	ПозицияДефиса = Найти(Внутренняя, "-");
	Если ПозицияДефиса < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	ЧастьКатегории = Лев(Внутренняя, ПозицияДефиса - 1);
	ЧастьНомера    = Сред(Внутренняя, ПозицияДефиса + 1);
	// Серверный host использует UUID поколения, клиент сохраняет прежний формат.
	ДефисПоколения = Найти(ЧастьНомера, "-");
	Если ДефисПоколения > 0 Тогда
		ПоколениеТокена = Лев(ЧастьНомера, ДефисПоколения - 1);
		Если СтрДлина(ПоколениеТокена) <> 32 Или НЕ СтрокаСостоитИзHexСимволов(ПоколениеТокена) Тогда Возврат Ложь; КонецЕсли;
		ЧастьНомера = Сред(ЧастьНомера, ДефисПоколения + 1);
	КонецЕсли;
	Если СтрДлина(ЧастьНомера) < 5 Тогда // минимум 5 цифр — счётчик > 99999 будет > 5 знаков
		Возврат Ложь;
	КонецЕсли;
	// категория — только буквы
	Для Инд = 1 По СтрДлина(ЧастьКатегории) Цикл
		СимВРег = ВРег(Сред(ЧастьКатегории, Инд, 1));
		КодСим  = КодСимвола(СимВРег);
		Если КодСим < 65 Или КодСим > 90 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	// номер — только цифры
	Для Инд = 1 По СтрДлина(ЧастьНомера) Цикл
		КодСим = КодСимвола(Сред(ЧастьНомера, Инд, 1));
		Если КодСим < 48 Или КодСим > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция АнонимизаторДеТокенизироватьСтроку(КонтекстРантайма, Текст, НеизвестныеТокены = Неопределено)

	АнонимизаторИнициализировать(КонтекстРантайма);

	Если КонтекстРантайма.МаппингДеанонимизации.Количество() = 0 И НеизвестныеТокены = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = "";
	УжеНеизвестные = Новый Соответствие;
	Позиция   = 1;
	Длина     = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		ПозОткр = Найти(Сред(Текст, Позиция), "[");
		Если ПозОткр = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;
		ПозОткр = Позиция + ПозОткр - 1;
		Результат = Результат + Сред(Текст, Позиция, ПозОткр - Позиция);

		ПозЗакр = Найти(Сред(Текст, ПозОткр), "]");
		Если ПозЗакр = 0 Тогда
			Результат = Результат + Сред(Текст, ПозОткр);
			Прервать;
		КонецЕсли;
		ПозЗакр = ПозОткр + ПозЗакр - 1;

		Кандидат = Сред(Текст, ПозОткр, ПозЗакр - ПозОткр + 1);
		Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
			Оригинал = КонтекстРантайма.МаппингДеанонимизации.Получить(ВРег(Кандидат));
			Если Оригинал <> Неопределено Тогда
				Результат = Результат + Оригинал;
			Иначе
				Результат = Результат + Кандидат;
				Если НеизвестныеТокены <> Неопределено И УжеНеизвестные.Получить(ВРег(Кандидат)) = Неопределено Тогда
					НеизвестныеТокены.Добавить(Кандидат);
					УжеНеизвестные.Вставить(ВРег(Кандидат), Истина);
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Внешние скобки JSON/Markdown не поглощают внутренний токен.
			Результат = Результат + "[";
			Позиция = ПозОткр + 1;
			Продолжить;
		КонецЕсли;

		Позиция = ПозЗакр + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПроверитьJSONДеанонимизацииAPI(Текст, Позиция, ИменаПолей, Уровень = 0)
	// Только синтаксис и корневые имена: значения декодирует штатный ПрочитатьJSON2.
	Длина = СтрДлина(Текст);
	Пробелы = " " + Символы.Таб + Символы.ВК + Символы.ПС;
	jsonПрочитатьПропуститьФорматирование(Текст, Истина, Позиция, Длина, Пробелы);
	Если Позиция > Длина Тогда Возврат Ложь; КонецЕсли;
	Знак = Сред(Текст, Позиция, 1);
	Если Знак = """" Тогда
		Позиция = Позиция + 1;
		Закрыта = Ложь;
		Пока Позиция <= Длина Цикл
			Знак = Сред(Текст, Позиция, 1); Позиция = Позиция + 1;
			Если Знак = """" Тогда Закрыта = Истина; Прервать; КонецЕсли;
			Если КодСимвола(Знак) < 32 Тогда Возврат Ложь; КонецЕсли;
			Если Знак = "\" Тогда
				Если Позиция > Длина Тогда Возврат Ложь; КонецЕсли;
				Экранирование = Сред(Текст, Позиция, 1); Позиция = Позиция + 1;
				Если Экранирование = "u" Тогда
					Для Разряд = 1 По 4 Цикл
						Если Позиция > Длина Тогда Возврат Ложь; КонецЕсли;
						Если Найти("0123456789abcdefABCDEF", Сред(Текст, Позиция, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
						Позиция = Позиция + 1;
					КонецЦикла;
				ИначеЕсли Найти("""\/bfnrt", Экранирование) = 0 Тогда Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Закрыта Тогда Возврат Ложь; КонецЕсли;
	ИначеЕсли Знак = "{" Или Знак = "[" Тогда
		ОбъектJSON = Знак = "{"; Закрывающий = ?(ОбъектJSON, "}", "]");
		Позиция = Позиция + 1;
		jsonПрочитатьПропуститьФорматирование(Текст, Истина, Позиция, Длина, Пробелы);
		Если Сред(Текст, Позиция, 1) <> Закрывающий Тогда
			Пока Истина Цикл
				Если ОбъектJSON Тогда
					Если Сред(Текст, Позиция, 1) <> """" Тогда Возврат Ложь; КонецЕсли;
					НачалоИмени = Позиция;
					Если НЕ ПроверитьJSONДеанонимизацииAPI(Текст, Позиция, ИменаПолей, Уровень + 1) Тогда Возврат Ложь; КонецЕсли;
					Если Уровень = 0 Тогда ИменаПолей.Добавить(ПрочитатьJSON2(Сред(Текст, НачалоИмени, Позиция - НачалоИмени))); КонецЕсли;
					Если Сред(Текст, Позиция, 1) <> ":" Тогда Возврат Ложь; КонецЕсли;
					Позиция = Позиция + 1;
				КонецЕсли;
				Если НЕ ПроверитьJSONДеанонимизацииAPI(Текст, Позиция, ИменаПолей, Уровень + 1) Тогда Возврат Ложь; КонецЕсли;
				Если Сред(Текст, Позиция, 1) = Закрывающий Тогда Прервать; КонецЕсли;
				Если Сред(Текст, Позиция, 1) <> "," Тогда Возврат Ложь; КонецЕсли;
				Позиция = Позиция + 1;
				jsonПрочитатьПропуститьФорматирование(Текст, Истина, Позиция, Длина, Пробелы);
			КонецЦикла;
		КонецЕсли;
		Позиция = Позиция + 1;
	ИначеЕсли Сред(Текст, Позиция, 4) = "true" Или Сред(Текст, Позиция, 4) = "null" Тогда
		Позиция = Позиция + 4;
	ИначеЕсли Сред(Текст, Позиция, 5) = "false" Тогда
		Позиция = Позиция + 5;
	Иначе
		Если Знак = "-" Тогда Позиция = Позиция + 1; КонецЕсли;
		Если Позиция > Длина Тогда Возврат Ложь; КонецЕсли;
		Знак = Сред(Текст, Позиция, 1);
		Если Знак = "0" Тогда Позиция = Позиция + 1;
		Иначе
			Если Найти("123456789", Знак) = 0 Тогда Возврат Ложь; КонецЕсли;
			Пока Позиция <= Длина И Найти("0123456789", Сред(Текст, Позиция, 1)) > 0 Цикл Позиция = Позиция + 1; КонецЦикла;
		КонецЕсли;
		Если Сред(Текст, Позиция, 1) = "." Тогда
			Позиция = Позиция + 1; НачалоЦифр = Позиция;
			Пока Позиция <= Длина И Найти("0123456789", Сред(Текст, Позиция, 1)) > 0 Цикл Позиция = Позиция + 1; КонецЦикла;
			Если Позиция = НачалоЦифр Тогда Возврат Ложь; КонецЕсли;
		КонецЕсли;
		Знак = Сред(Текст, Позиция, 1);
		Если Знак = "e" Или Знак = "E" Тогда
			Позиция = Позиция + 1; Знак = Сред(Текст, Позиция, 1);
			Если Знак = "+" Или Знак = "-" Тогда Позиция = Позиция + 1; КонецЕсли;
			НачалоЦифр = Позиция;
			Пока Позиция <= Длина И Найти("0123456789", Сред(Текст, Позиция, 1)) > 0 Цикл Позиция = Позиция + 1; КонецЦикла;
			Если Позиция = НачалоЦифр Тогда Возврат Ложь; КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	jsonПрочитатьПропуститьФорматирование(Текст, Истина, Позиция, Длина, Пробелы);
	Возврат Истина;
КонецФункции

Функция ОбработатьДеанонимизациюAPI(КонтекстРантайма, ДанныеЗапроса, Включено) Экспорт
	Если Включено <> Истина Тогда Возврат СформироватьRESTОшибка(404, "Not Found"); КонецЕсли;
	Если ДанныеЗапроса.method <> "POST" Тогда Возврат СформироватьRESTОшибка(405, "Method not allowed"); КонецЕсли;
	ТипСодержимого = ПолучитьЗначениеОбъекта(ДанныеЗапроса.headers, "content-type");
	Если ТипЗнч(ТипСодержимого) <> Тип("Строка") Тогда ТипСодержимого = ""; КонецЕсли;
	Разделитель = Найти(ТипСодержимого, ";");
	Если Разделитель > 0 Тогда ТипСодержимого = Лев(ТипСодержимого, Разделитель - 1); КонецЕсли;
	Если НРег(СокрЛП(ТипСодержимого)) <> "application/json" Тогда Возврат СформироватьRESTОшибка(415, "Content-Type must be application/json"); КонецЕсли;
	Каналы = ПолучитьЗначениеОбъекта(ДанныеЗапроса.query, "channel");
	Если Каналы <> Неопределено Тогда
		Если ТипЗнч(Каналы) <> Тип("Массив") Тогда Возврат СформироватьRESTОшибка(400, "Invalid channel"); КонецЕсли;
		Если Каналы.Количество() <> 1 Тогда Возврат СформироватьRESTОшибка(400, "Invalid channel"); КонецЕсли;
		Если Каналы[0] <> "default" Тогда Возврат СформироватьRESTОшибка(400, "Invalid channel"); КонецЕсли;
	КонецЕсли;
	Попытка
		Если ТипЗнч(ДанныеЗапроса.body) <> Тип("Строка") Тогда Возврат СформироватьRESTОшибка(400, "Expected a JSON object"); КонецЕсли;
		ТекстJSON = ДанныеЗапроса.body;
		ПозицияJSON = 1; ИменаПолей = Новый Массив;
		jsonПрочитатьПропуститьФорматирование(ТекстJSON, Истина, ПозицияJSON, СтрДлина(ТекстJSON), " " + Символы.Таб + Символы.ВК + Символы.ПС);
		Если Сред(ТекстJSON, ПозицияJSON, 1) <> "{" Тогда Возврат СформироватьRESTОшибка(400, "Expected a JSON object"); КонецЕсли;
		Если НЕ ПроверитьJSONДеанонимизацииAPI(ТекстJSON, ПозицияJSON, ИменаПолей) Или ПозицияJSON <= СтрДлина(ТекстJSON) Тогда
			Возврат СформироватьRESTОшибка(400, "Expected a JSON object");
		КонецЕсли;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Если ИмяПоля <> "text" Тогда Возврат СформироватьRESTОшибка(422, "Expected only the string field text"); КонецЕсли;
		КонецЦикла;
		ТелоЗапроса = ПрочитатьJSON2(ДанныеЗапроса.body);
	Исключение
		Возврат СформироватьRESTОшибка(400, "Expected a JSON object");
	КонецПопытки;
	Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") И ТипЗнч(ТелоЗапроса) <> Тип("Соответствие") Тогда
		Возврат СформироватьRESTОшибка(400, "Expected a JSON object");
	КонецЕсли;
	Текст = ПолучитьЗначениеОбъекта(ТелоЗапроса, "text");
	Если ТелоЗапроса.Количество() <> 1 Или ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат СформироватьRESTОшибка(422, "Expected only the string field text");
	КонецЕсли;
	Попытка
		Неизвестные = Новый Массив;
		Текст = АнонимизаторДеТокенизироватьСтроку(КонтекстРантайма, Текст, Неизвестные);
		Ответ = Новый Структура("success,text,unresolved_tokens", Истина, Текст, Неизвестные);
		Возврат Новый Структура("КодОтвета,Тело", 200, ЗаписатьJSON2(Ответ));
	Исключение
		Возврат СформироватьRESTОшибка(500, "Text restoration failed");
	КонецПопытки;
КонецФункции

Функция АнонимизаторДеТокенизироватьСтрокуВBSL(КонтекстРантайма, Текст)
	// Аналог АнонимизаторДеТокенизироватьСтроку, но при подстановке экранирует " → ""
	// чтобы замена токена не ломала строковый литерал BSL (актуально для params.code в execute_code)

	АнонимизаторИнициализировать(КонтекстРантайма);

	Если КонтекстРантайма.МаппингДеанонимизации.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = "";
	Позиция   = 1;
	Длина     = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		ПозОткр = Найти(Сред(Текст, Позиция), "[");
		Если ПозОткр = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;
		ПозОткр = Позиция + ПозОткр - 1;
		Результат = Результат + Сред(Текст, Позиция, ПозОткр - Позиция);

		ПозЗакр = Найти(Сред(Текст, ПозОткр), "]");
		Если ПозЗакр = 0 Тогда
			Результат = Результат + Сред(Текст, ПозОткр);
			Прервать;
		КонецЕсли;
		ПозЗакр = ПозОткр + ПозЗакр - 1;

		Кандидат = Сред(Текст, ПозОткр, ПозЗакр - ПозОткр + 1);
		Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
			Оригинал = КонтекстРантайма.МаппингДеанонимизации.Получить(ВРег(Кандидат));
			Если Оригинал <> Неопределено Тогда
				Результат = Результат + СтрЗаменить(Оригинал, """", """""");
			Иначе
				Результат = Результат + Кандидат;
			КонецЕсли;
		Иначе
			Результат = Результат + Кандидат;
		КонецЕсли;

		Позиция = ПозЗакр + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АнонимизаторДеТокенизироватьСтрокуДляЗапроса(КонтекстРантайма, Текст)
	// Детокенизация текста 1С запроса с контекстным экранированием кавычек.
	// State-machine отслеживает текущий режим кавычек:
	//   0 = снаружи строкового литерала
	//   1 = внутри "..." (двойные кавычки)
	//   2 = внутри '...' (одинарные кавычки)
	// При нахождении токена — экранирование выбирается по текущему состоянию.

	АнонимизаторИнициализировать(КонтекстРантайма);
	Если КонтекстРантайма.МаппингДеанонимизации.Количество() = 0 Тогда Возврат Текст; КонецЕсли;

	Результат         = "";
	Позиция           = 1;
	Длина             = СтрДлина(Текст);
	СостояниеКавычек  = 0; // 0=снаружи, 1=двойные, 2=одинарные

	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);

		// Обновляем состояние кавычек
		Если СостояниеКавычек = 0 Тогда
			Если Символ = """" Тогда
				СостояниеКавычек = 1;
				Результат = Результат + Символ;
				Позиция = Позиция + 1;
				Продолжить;
			ИначеЕсли Символ = "'" Тогда
				СостояниеКавычек = 2;
				Результат = Результат + Символ;
				Позиция = Позиция + 1;
				Продолжить;
			КонецЕсли;
		ИначеЕсли СостояниеКавычек = 1 Тогда // внутри "..."
			Если Символ = """" Тогда
				Если Позиция < Длина И Сред(Текст, Позиция + 1, 1) = """" Тогда
					// "" — экранированная кавычка, оставляем как есть
					Результат = Результат + """""";
					Позиция = Позиция + 2;
					Продолжить;
				Иначе
					СостояниеКавычек = 0; // закрывающая кавычка
					Результат = Результат + Символ;
					Позиция = Позиция + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СостояниеКавычек = 2 Тогда // внутри '...'
			Если Символ = "'" Тогда
				Если Позиция < Длина И Сред(Текст, Позиция + 1, 1) = "'" Тогда
					// '' — экранированная кавычка, оставляем как есть
					Результат = Результат + "''";
					Позиция = Позиция + 2;
					Продолжить;
				Иначе
					СостояниеКавычек = 0; // закрывающая кавычка
					Результат = Результат + Символ;
					Позиция = Позиция + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// Проверяем начало токена
		Если Символ = "[" Тогда
			ПозЗакр = Найти(Сред(Текст, Позиция), "]");
			Если ПозЗакр > 0 Тогда
				ПозЗакр = Позиция + ПозЗакр - 1;
				Кандидат = Сред(Текст, Позиция, ПозЗакр - Позиция + 1);
				Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
					Оригинал = КонтекстРантайма.МаппингДеанонимизации.Получить(ВРег(Кандидат));
					Если Оригинал <> Неопределено Тогда
						Если СостояниеКавычек = 1 Тогда
							Результат = Результат + СтрЗаменить(Оригинал, """", """""");
						ИначеЕсли СостояниеКавычек = 2 Тогда
							Результат = Результат + СтрЗаменить(Оригинал, "'", "''");
						Иначе
							Результат = Результат + Оригинал;
						КонецЕсли;
						Позиция = ПозЗакр + 1;
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Результат = Результат + Символ;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ОпределитьКатегориюТокена(ПолноеИмяПоля)

	Сегменты = РазложитьПутьНаСегменты(ПолноеИмяПоля);
	ИмяПоля  = ВРег(Сегменты[Сегменты.ВГраница()]);

	// По имени поля
	Если ИмяПоля = "ИНН"             Тогда Возврат "INN";       КонецЕсли;
	Если ИмяПоля = "КПП"             Тогда Возврат "KPP";       КонецЕсли;
	Если ИмяПоля = "ОГРН" Или ИмяПоля = "ОГРНИП"  Тогда Возврат "OGRN"; КонецЕсли;
	Если ИмяПоля = "СНИЛС"           Тогда Возврат "SNILS";     КонецЕсли;
	Если ИмяПоля = "БИК"             Тогда Возврат "BIK";       КонецЕсли;
	Если ИмяПоля = "СЧЕТ"            Тогда Возврат "ACC";       КонецЕсли;
	Если ИмяПоля = "АВТОР"           Или ИмяПоля = "ОТВЕТСТВЕННЫЙ" Или ИмяПоля = "ИСПОЛНИТЕЛЬ"
	  Или ИмяПоля = "ИЗМЕНИЛ"        Или ИмяПоля = "РЕДАКТОР"      Или ИмяПоля = "РЕДАКТИРУЕТ"
	  Или ИмяПоля = "ФАМИЛИЯ"        Или ИмяПоля = "ОТЧЕСТВО"
	  Или ИмяПоля = "ФИЗИЧЕСКОЕЛИЦО" Или ИмяПоля = "ФИЗЛИЦО"       Или ИмяПоля = "ФИО"           Тогда Возврат "PER"; КонецЕсли;
	Если ИмяПоля = "СТРАНА"          Или ИмяПоля = "ГОРОД"         Или ИмяПоля = "УЛИЦА"
	  Или ИмяПоля = "ДОМ"            Или ИмяПоля = "КВАРТИРА"                                     Тогда Возврат "LOC"; КонецЕсли;
	Если Найти(ИмяПоля, "ТЕЛЕФОН")     > 0 Или Найти(ИмяПоля, "PHONE")      > 0 Тогда Возврат "PHONE";    КонецЕсли;
	Если Найти(ИмяПоля, "EMAIL")       > 0 Или Найти(ИмяПоля, "ПОЧТА")      > 0 Тогда Возврат "EMAIL";    КонецЕсли;
	Если Найти(ИмяПоля, "ПАСПОРТ")     > 0 Или Найти(ИмяПоля, "PASSPORT")   > 0 Тогда Возврат "PASSPORT"; КонецЕсли;
	Если Найти(ИмяПоля, "ДАТА")        > 0 Или Найти(ИмяПоля, "DATE")       > 0 Тогда Возврат "DATE";     КонецЕсли;
	Если Найти(ИмяПоля, "АДРЕС")       > 0 Или Найти(ИмяПоля, "ADDRESS")    > 0 Тогда Возврат "LOC";      КонецЕсли;
	Если Найти(ИмяПоля, "РАСЧЕТНЫЙ")   > 0                                       Тогда Возврат "ACC";      КонецЕсли;
	Если Найти(ИмяПоля, "ОРГАНИЗАЦИЯ") > 0 Или Найти(ИмяПоля, "КОНТРАГЕНТ") > 0
	  Или Найти(ИмяПоля, "PARTNER")    > 0                                       Тогда Возврат "ORG";      КонецЕсли;
	Если Найти(ИмяПоля, "ФИЗЛИЦО")     > 0 Или Найти(ИмяПоля, "СОТРУДНИК")  > 0
	  Или Найти(ИмяПоля, "PERSON")     > 0                                       Тогда Возврат "PER";      КонецЕсли;

	// По имени объекта (второй сегмент)
	Если Сегменты.Количество() >= 2 Тогда
		ИмяОбъекта = ВРег(Сегменты[1]);
		Если Найти(ИмяОбъекта, "ФИЗЛИЦ")     > 0
		  Или Найти(ИмяОбъекта, "СОТРУДНИК") > 0
		  Или Найти(ИмяОбъекта, "PERSON")    > 0 Тогда
			Возврат "PER";
		КонецЕсли;
		Если Найти(ИмяОбъекта, "КОНТРАГЕНТ")  > 0
		  Или Найти(ИмяОбъекта, "ОРГАНИЗАЦИЯ") > 0
		  Или Найти(ИмяОбъекта, "PARTNER")    > 0 Тогда
			Возврат "ORG";
		КонецЕсли;
	КонецЕсли;

	Возврат "STR";

КонецФункции

Функция РазложитьПутьНаСегменты(Путь)

	Сегменты = Новый Массив;
	ОстатокПути = Путь;
	Пока Истина Цикл
		Поз = Найти(ОстатокПути, ".");
		Если Поз = 0 Тогда
			Сегменты.Добавить(ОстатокПути);
			Прервать;
		КонецЕсли;
		Сегменты.Добавить(Лев(ОстатокПути, Поз - 1));
		ОстатокПути = Сред(ОстатокПути, Поз + 1);
	КонецЦикла;
	Возврат Сегменты;

КонецФункции

Процедура ЗаполнитьСловарьАнонимизации(КонтекстРантайма, ДанныеСловаря) Экспорт

	АнонимизаторИнициализировать(КонтекстРантайма);

	// Данные уже отсортированы сервером по убыванию длины
	КонтекстРантайма.СловарьАнонимизации = Новый Массив;
	КонтекстРантайма.БакетИндексСловаря  = Новый Соответствие;

	Для Каждого Запись Из ДанныеСловаря Цикл
		КонтекстРантайма.СловарьАнонимизации.Добавить(Запись);

		Если Запись.Длина >= 3 Тогда
			Бакет = Лев(Запись.ЗначениеНижний, 3);
			МассивЗаписей = КонтекстРантайма.БакетИндексСловаря.Получить(Бакет);
			Если МассивЗаписей = Неопределено Тогда
				МассивЗаписей = Новый Массив;
				КонтекстРантайма.БакетИндексСловаря.Вставить(Бакет, МассивЗаписей);
			КонецЕсли;
			МассивЗаписей.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	КонтекстРантайма.СловарьПостроен = Истина;

КонецПроцедуры

Функция ЭтоБуквоЦифра(Символ)

	КодСим = КодСимвола(Символ);
	Если КодСим >= 48  И КодСим <= 57  Тогда Возврат Истина; КонецЕсли; // 0-9
	Если КодСим >= 65  И КодСим <= 90  Тогда Возврат Истина; КонецЕсли; // A-Z
	Если КодСим >= 97  И КодСим <= 122 Тогда Возврат Истина; КонецЕсли; // a-z
	Если КодСим >= 1040 И КодСим <= 1103 Тогда Возврат Истина; КонецЕсли; // А-я
	Если КодСим = 1025 Или КодСим = 1105 Тогда Возврат Истина; КонецЕсли; // Ё, ё
	Возврат Ложь;

КонецФункции

Функция ЭтоСимволТехническогоИдентификатора(Знак)
	Если ПустаяСтрока(Знак) Тогда Возврат Ложь; КонецЕсли;
	Если Найти("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-", Знак) > 0 Тогда Возврат Истина; КонецЕсли;
	Код = КодСимвола(Знак);
	Если Код < 128 Тогда Возврат Ложь; КонецЕсли;
	Если Код = 160 Или Код = 171 Или Код = 187 Или Код = 5760
		Или (Код >= 8192 И Код <= 8303) Или (Код >= 12288 И Код <= 12292)
		Или (Код >= 12296 И Код <= 12319) Тогда Возврат Ложь; КонецЕсли;
	// Консервативно: неизвестная Unicode-буква/диакритика не создаёт границу.
	Возврат Истина;
КонецФункции

Функция ДлинаТехническогоФрагмента(Текст, Начало)
	Длина = СтрДлина(Текст);
	Если Начало > 1 И ЭтоСимволТехническогоИдентификатора(Сред(Текст, Начало - 1, 1)) Тогда Возврат 0; КонецЕсли;
	КонецФрагмента = 0;
	Если Сред(Текст, Начало, 11) = "e1cib/data/" Тогда
		// Обрабатываются только стандартные ссылочные типы, не внешний источник данных.
		Хвост = Сред(Текст, Начало + 11);
		Разделитель = Найти(Хвост, "?ref=");
		Если Разделитель > 0 Тогда
			МетаданныеИмя = Лев(Хвост, Разделитель - 1);
			Точка = Найти(МетаданныеИмя, ".");
			Если Точка > 1 Тогда
				ТипМетаданных = Лев(МетаданныеИмя, Точка - 1);
				ИмяМетаданных = Сред(МетаданныеИмя, Точка + 1);
				ТипыСсылок = ",Справочник,Документ,Перечисление,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,ПланОбмена,БизнесПроцесс,Задача,Catalog,Document,Enum,ChartOfAccounts,ChartOfCharacteristicTypes,ChartOfCalculationTypes,ExchangePlan,BusinessProcess,Task,";
				ИмяВерно = НЕ ПустаяСтрока(ИмяМетаданных);
				Если ИмяВерно И Найти("0123456789", Лев(ИмяМетаданных, 1)) > 0 Тогда ИмяВерно = Ложь; КонецЕсли;
				Для ИндексИмени = 1 По СтрДлина(ИмяМетаданных) Цикл
					ЗнакИмени = Сред(ИмяМетаданных, ИндексИмени, 1);
					Если НЕ ЭтоСимволТехническогоИдентификатора(ЗнакИмени) Или ЗнакИмени = "-" Тогда ИмяВерно = Ложь; Прервать; КонецЕсли;
				КонецЦикла;
				НачалоRef = Начало + 11 + Разделитель + 4;
				Если ИмяВерно И Найти(ТипыСсылок, "," + ТипМетаданных + ",") > 0
					И СтрДлина(Сред(Текст, НачалоRef, 32)) = 32
					И СтрокаСостоитИзHexСимволов(Сред(Текст, НачалоRef, 32)) Тогда
					КонецФрагмента = НачалоRef + 31;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЭтоUUID(Сред(Текст, Начало, 36)) Тогда
		КонецФрагмента = Начало + 35;
	ИначеЕсли СтрДлина(Сред(Текст, Начало, 32)) = 32
		И СтрокаСостоитИзHexСимволов(Сред(Текст, Начало, 32)) Тогда
		КонецФрагмента = Начало + 31;
	КонецЕсли;
	Если КонецФрагмента = 0 Тогда Возврат 0; КонецЕсли;
	Если КонецФрагмента < Длина И ЭтоСимволТехническогоИдентификатора(Сред(Текст, КонецФрагмента + 1, 1)) Тогда Возврат 0; КонецЕсли;
	Возврат КонецФрагмента - Начало + 1;
КонецФункции

Функция ЗащищенныеДиапазоныАнонимизации(Текст)
	Диапазоны = Новый Массив;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		ДлинаФрагмента = 0;
		Если Сред(Текст, Позиция, 1) = "[" Тогда
			Закрытие = Найти(Сред(Текст, Позиция), "]");
			Если Закрытие > 0 И ЭтоВалидныйТокенФормат(Сред(Текст, Позиция, Закрытие)) Тогда ДлинаФрагмента = Закрытие; КонецЕсли;
		КонецЕсли;
		Если ДлинаФрагмента = 0 Тогда ДлинаФрагмента = ДлинаТехническогоФрагмента(Текст, Позиция); КонецЕсли;
		Если ДлинаФрагмента > 0 Тогда
			Диапазоны.Добавить(Новый Структура("Начало,Конец", Позиция, Позиция + ДлинаФрагмента - 1));
			Позиция = Позиция + ДлинаФрагмента;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Диапазоны;
КонецФункции

Функция ОбработатьСтрокуПоPolicy(КонтекстРантайма, Текст, Режим, РежимПредставления, АвтоматическиСкрывать, Sources, Правила)
	Если Режим = "force_keep" Тогда Возврат Текст; КонецЕсли;
	Если Режим = "force_anonymize" Или РежимПредставления = "force_anonymize" Тогда
		Возврат АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Текст, Sources, Правила);
	КонецЕсли;
	Если РежимПредставления = "force_keep" Тогда Возврат Текст; КонецЕсли;
	Если АвтоматическиСкрывать Тогда Возврат ТокенизироватьНезащищенныйТекст(КонтекстРантайма, Текст); КонецЕсли;
	Возврат ПрименитьСловарьКСтроке(КонтекстРантайма, Текст);
КонецФункции

Функция ТокенизироватьНезащищенныйТекст(КонтекстРантайма, Текст, Категория = "STR")
	РезультатТекст = "";
	Начало = 1;
	Диапазоны = ЗащищенныеДиапазоныАнонимизации(Текст);
	Если Диапазоны.Количество() = 0 Тогда Возврат АнонимизаторТокенизировать(КонтекстРантайма, Текст, Категория); КонецЕсли;
	Диапазоны.Добавить(Новый Структура("Начало,Конец", СтрДлина(Текст) + 1, СтрДлина(Текст)));
	Для Каждого Диапазон Из Диапазоны Цикл
		Участок = Сред(Текст, Начало, Диапазон.Начало - Начало);
		Участок = ТокенизироватьОбычныйУчасток(КонтекстРантайма, Участок, Категория);
		РезультатТекст = РезультатТекст + Участок + Сред(Текст, Диапазон.Начало, Диапазон.Конец - Диапазон.Начало + 1);
		Начало = Диапазон.Конец + 1;
	КонецЦикла;
	Возврат РезультатТекст;
КонецФункции

Функция ТокенизироватьОбычныйУчасток(КонтекстРантайма, Участок, Категория)
	РезультатТекст = "";
	НачалоСтроки = 1; Первый = 0; Последний = 0;
	Для Позиция = 1 По СтрДлина(Участок) + 1 Цикл
		Знак = Сред(Участок, Позиция, 1);
		Если Позиция > СтрДлина(Участок) Или Знак = Символы.ПС Или Знак = Символы.ВК Тогда
			Если Первый = 0 Тогда
				РезультатТекст = РезультатТекст + Сред(Участок, НачалоСтроки, Позиция - НачалоСтроки);
			Иначе
				РезультатТекст = РезультатТекст + Сред(Участок, НачалоСтроки, Первый - НачалоСтроки)
					+ АнонимизаторТокенизировать(КонтекстРантайма, Сред(Участок, Первый, Последний - Первый + 1), Категория)
					+ Сред(Участок, Последний + 1, Позиция - Последний - 1);
			КонецЕсли;
			РезультатТекст = РезультатТекст + Знак;
			НачалоСтроки = Позиция + 1; Первый = 0; Последний = 0;
		ИначеЕсли ЭтоСимволТехническогоИдентификатора(Знак) И Знак <> "_" И Знак <> "-" Тогда
			Если Первый = 0 Тогда Первый = Позиция; КонецЕсли;
			Последний = Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатТекст;
КонецФункции

Функция ПрименитьСловарьКСтроке(КонтекстРантайма, Текст)

	АнонимизаторИнициализировать(КонтекстРантайма);

	Если НЕ КонтекстРантайма.СловарьПостроен Или КонтекстРантайма.СловарьАнонимизации.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Длина = СтрДлина(Текст);
	Если Длина = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	ДиапазоныТокенов = ЗащищенныеДиапазоныАнонимизации(Текст);

	ТекстНижний = НРег(Текст);

	// Формируем список замен
	Замены       = Новый Массив;
	Позиция      = 1;
	ИндексТокена = 0;

	Пока Позиция <= Длина Цикл

		// Проверка: внутри существующего токена?
		ВнутриТокена = Ложь;
		КонецТокена  = 0;
		Для Инд = ИндексТокена По ДиапазоныТокенов.ВГраница() Цикл
			Диапазон = ДиапазоныТокенов[Инд];
			Если Позиция >= Диапазон.Начало И Позиция <= Диапазон.Конец Тогда
				ВнутриТокена = Истина;
				КонецТокена  = Диапазон.Конец;
				ИндексТокена = Инд;
				Прервать;
			КонецЕсли;
			Если Позиция < Диапазон.Начало Тогда Прервать; КонецЕсли;
		КонецЦикла;

		Если ВнутриТокена Тогда
			Позиция = КонецТокена + 1;
			Продолжить;
		КонецЕсли;

		Если Позиция + 2 > Длина Тогда
			Прервать;
		КонецЕсли;

		Бакет    = Сред(ТекстНижний, Позиция, 3);
		Кандидаты = КонтекстРантайма.БакетИндексСловаря.Получить(Бакет);
		Если Кандидаты = Неопределено Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		НашлиЗамену = Ложь;
		Для Каждого Кандидат Из Кандидаты Цикл
			ДлинаКандидата = Кандидат.Длина;
			Если ДлинаКандидата < 3 Тогда Продолжить; КонецЕсли;
			Если Позиция + ДлинаКандидата - 1 > Длина Тогда Продолжить; КонецЕсли;
			Если Сред(ТекстНижний, Позиция, ДлинаКандидата) <> Кандидат.ЗначениеНижний Тогда
				Продолжить;
			КонецЕсли;

			ГраницаОК = Истина;
			Если Позиция > 1 Тогда
				Если ЭтоБуквоЦифра(Сред(Текст, Позиция - 1, 1)) Тогда
					ГраницаОК = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если ГраницаОК И Позиция + ДлинаКандидата <= Длина Тогда
				Если ЭтоБуквоЦифра(Сред(Текст, Позиция + ДлинаКандидата, 1)) Тогда
					ГраницаОК = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если НЕ ГраницаОК Тогда Продолжить; КонецЕсли;

			ПересекаетЗащиту = Ложь;
			Для Каждого Диапазон Из ДиапазоныТокенов Цикл
				Если Позиция <= Диапазон.Конец И Позиция + ДлинаКандидата > Диапазон.Начало Тогда ПересекаетЗащиту = Истина; Прервать; КонецЕсли;
			КонецЦикла;
			Если ПересекаетЗащиту Тогда Продолжить; КонецЕсли;
			Токен   = АнонимизаторТокенизировать(КонтекстРантайма, Кандидат.ЗначениеОриг, Кандидат.Категория);
			Замены.Добавить(Новый Структура("Начало, Длина, Токен", Позиция, ДлинаКандидата, Токен));
			Позиция = Позиция + ДлинаКандидата;
			НашлиЗамену = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ НашлиЗамену Тогда
			Позиция = Позиция + 1;
		КонецЕсли;

	КонецЦикла;

	Если Замены.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	РезультатТекст  = "";
	ТекущаяПозиция  = 1;
	Для Каждого Замена Из Замены Цикл
		Если Замена.Начало > ТекущаяПозиция Тогда
			РезультатТекст = РезультатТекст + Сред(Текст, ТекущаяПозиция, Замена.Начало - ТекущаяПозиция);
		КонецЕсли;
		РезультатТекст = РезультатТекст + Замена.Токен;
		ТекущаяПозиция = Замена.Начало + Замена.Длина;
	КонецЦикла;
	Если ТекущаяПозиция <= Длина Тогда
		РезультатТекст = РезультатТекст + Сред(Текст, ТекущаяПозиция);
	КонецЕсли;

	Возврат РезультатТекст;

КонецФункции

Функция АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Значение, МассивSources, ПравилаАнонимизации)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	// Ищем явную категорию в правилах
	Категория = "";
	Для Каждого SourcePath Из МассивSources Цикл
		Правило = ПолучитьПравилоПоПутиАнонимизации(ПравилаАнонимизации, SourcePath);
		Если Правило = Неопределено Тогда Продолжить; КонецЕсли;
		КатегорияПравила = "";
		Попытка
			Правило.Свойство("token_category", КатегорияПравила);
		Исключение КонецПопытки;
		Если НЕ ПустаяСтрока(КатегорияПравила) Тогда
			Категория = КатегорияПравила;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Авто-определение если явная категория не задана
	Если ПустаяСтрока(Категория) Тогда
		НеSTR = "";
		Для Каждого SourcePath Из МассивSources Цикл
			АвтоКат = ОпределитьКатегориюТокена(SourcePath);
			Если АвтоКат <> "STR" Тогда
				НеSTR = АвтоКат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Категория = ?(НЕ ПустаяСтрока(НеSTR), НеSTR, "STR");
	КонецЕсли;

	Возврат АнонимизаторТокенизировать(КонтекстРантайма, Значение, Категория);

КонецФункции

Функция ЭтоБухгалтерскийСчет(Строка)
	Если ПустаяСтрока(Строка) Тогда Возврат Ложь; КонецЕсли;
	// Inline-разбор без серверного РазделитьСтрокуПоРазделителю
	ТекущийСегмент = "";
	НомерСегмента  = 0;
	Для СимИнд = 1 По СтрДлина(Строка) + 1 Цикл
		Если СимИнд > СтрДлина(Строка) Тогда
			Символ = ".";  // виртуальная точка для финального сегмента
		Иначе
			Символ = Сред(Строка, СимИнд, 1);
		КонецЕсли;
		Если Символ = "." Тогда
			Если СтрДлина(ТекущийСегмент) = 0 Тогда Возврат Ложь; КонецЕсли;
			МаксДлина = ?(НомерСегмента = 0, 2, 3);
			Если СтрДлина(ТекущийСегмент) > МаксДлина Тогда Возврат Ложь; КонецЕсли;
			НомерСегмента = НомерСегмента + 1;
			Если НомерСегмента > 4 Тогда Возврат Ложь; КонецЕсли;
			ТекущийСегмент = "";
		ИначеЕсли Найти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		Иначе
			ТекущийСегмент = ТекущийСегмент + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоВалюта(Строка)
	Если ПустаяСтрока(Строка) Тогда Возврат Ложь; КонецЕсли;
	ВерхРегистр = ВРег(СокрЛП(Строка));
	ВалютыISO = "RUB,USD,EUR,GBP,CNY,JPY,CHF,KZT,BYN,BYR,UAH,TRY,AED,INR,CAD,AUD,"
		+ "SEK,NOK,DKK,PLN,CZK,HUF,SGD,HKD,NZD,MXN,ZAR,KGS,UZS,AMD,AZN,GEL,MDL,TJS,РУБ.";
	Если Найти("," + ВалютыISO + ",", "," + ВерхРегистр + ",") > 0 Тогда Возврат Истина; КонецЕсли;
	НижРегистр = НРег(СокрЛП(Строка));
	ВалютыРус = "российский рубль,доллар сша,евро,фунт стерлингов,китайский юань,"
		+ "японская иена,швейцарский франк,казахстанский тенге,белорусский рубль,"
		+ "украинская гривна,рубль,доллар,юань,иена,тенге,гривна";
	Если Найти("," + ВалютыРус + ",", "," + НижРегистр + ",") > 0 Тогда Возврат Истина; КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ЭтоUUID(Строка)
	Если СтрДлина(Строка) <> 36 Тогда Возврат Ложь; КонецЕсли;
	Для СимИнд = 1 По 36 Цикл
		Символ = Сред(Строка, СимИнд, 1);
		Если СимИнд = 9 Или СимИнд = 14 Или СимИнд = 19 Или СимИнд = 24 Тогда
			Если Символ <> "-" Тогда Возврат Ложь; КонецЕсли;
		ИначеЕсли Найти("0123456789abcdefABCDEF", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоИсключениеАгрессивнойАнонимизации(Строка)
	Возврат ЭтоБухгалтерскийСчет(Строка) Или ЭтоВалюта(Строка) Или ДлинаТехническогоФрагмента(Строка, 1) = СтрДлина(Строка);
КонецФункции

Функция ЭтоИзвестныйТокенАнонимизации(КонтекстРантайма, Строка)
	Если НЕ ЭтоВалидныйТокенФормат(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;
	АнонимизаторИнициализировать(КонтекстРантайма);
	Возврат КонтекстРантайма.МаппингДеанонимизации.Получить(ВРег(Строка)) <> Неопределено;
КонецФункции

Процедура АнонимизироватьExecuteCodeВстроенный(КонтекстРантайма, Результат, РегексКонтекст) Экспорт
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;
	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат);
	Если НастройкиАнонимизации = Неопределено Тогда Возврат; КонецЕсли;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;
	Данные = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data", Данные) Тогда
		НовыеДанные = АнонимизироватьExecuteCodeЗначение(КонтекстРантайма, Данные, 0, АгрессивныйРежим);
		Результат.Вставить("data", НовыеДанные);
	КонецЕсли;
	СобратьТекстыДляRegexExecuteCode(КонтекстРантайма, Результат, РегексКонтекст);
КонецПроцедуры

Функция АнонимизироватьExecuteCodeЗначение(КонтекстРантайма, Значение, Глубина = 0, АгрессивныйРежим = Ложь, ВнутриКонтейнера = Ложь)
	Если Глубина > 10 Или Значение = Неопределено Тогда Возврат Значение; КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		АнонимизаторИнициализировать(КонтекстРантайма);
		СуществующийТокен = КонтекстРантайма.МаппингАнонимизации.Получить(Значение);
		Если СуществующийТокен <> Неопределено Тогда Возврат СуществующийТокен; КонецЕсли;
		// Защита от повторной токенизации: только реально существующие токены текущего сеанса
		Если ЭтоИзвестныйТокенАнонимизации(КонтекстРантайма, Значение) Тогда Возврат Значение; КонецЕсли;
		// Словарь идёт первым: сохраняет точные категории (PER, ORG, ...)
		РезультатСловаря = ПрименитьСловарьКСтроке(КонтекстРантайма, Значение);
		// Агрессивный режим — только если строка является полем структуры или элементом массива
		Если АгрессивныйРежим И ВнутриКонтейнера
			И НЕ ПустаяСтрока(Значение)
			И НЕ ЭтоИсключениеАгрессивнойАнонимизации(Значение) Тогда
			// Словарь полностью токенизировал строку — возвращаем точный токен
			Если ЭтоВалидныйТокенФормат(РезультатСловаря) Тогда Возврат РезультатСловаря; КонецЕсли;
			// Частичная или нулевая замена — токенизируем по оригиналу (не РезультатСловаря),
			// чтобы МаппингДеанонимизации хранил исходную строку без вложенных токенов
			Возврат ТокенизироватьНезащищенныйТекст(КонтекстРантайма, Значение, "STR");
		КонецЕсли;
		Возврат РезультатСловаря;

	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		ЭтоОбъектРеф = Ложь;
		Значение.Свойство("_objectRef", ЭтоОбъектРеф);
		НоваяСтруктура = Новый Структура;
		Для Каждого КВП Из Значение Цикл
			// Если это trusted-ссылка, технические поля копируем без анонимизации
			Если ЭтоОбъектРеф = Истина
				И (КВП.Ключ = "_objectRef"
					Или КВП.Ключ = "УникальныйИдентификатор"
					Или КВП.Ключ = "ТипОбъекта") Тогда
				НоваяСтруктура.Вставить(КВП.Ключ, КВП.Значение);
				Продолжить;
			КонецЕсли;
			// Все остальные поля (включая Представление и любые user-поля) — рекурсивно
			НоваяСтруктура.Вставить(КВП.Ключ,
				АнонимизироватьExecuteCodeЗначение(КонтекстРантайма, КВП.Значение, Глубина + 1, АгрессивныйРежим, Истина));
		КонецЦикла;
		Возврат НоваяСтруктура;

	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		НовыйМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			НовыйМассив.Добавить(АнонимизироватьExecuteCodeЗначение(КонтекстРантайма, Элемент, Глубина + 1, АгрессивныйРежим, Истина));
		КонецЦикла;
		Возврат НовыйМассив;
	КонецЕсли;

	Возврат Значение;
КонецФункции

Процедура СобратьТекстыДляRegexExecuteCode(КонтекстРантайма, Результат, РегексКонтекст)
	ВсеПравила = КонтекстРантайма.ПравилаRegex;
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") И Правило.enabled = Истина Тогда
			ВключённыеПравила.Добавить(Новый Структура("pattern, category",
				Правило.pattern, Правило.category));
		КонецЕсли;
	КонецЦикла;
	Если ВключённыеПравила.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь; Возврат;
	КонецЕсли;
	МассивПравилJSON = Новый Массив;
	Для Каждого П Из ВключённыеПравила Цикл
		МассивПравилJSON.Добавить(Новый Структура("pattern, category", П.pattern, П.category));
	КонецЦикла;
	РегексКонтекст.ВключённыеПравилаJSON = ЗаписатьJSON2(МассивПравилJSON);
	ТекстыМассив = Новый Массив;
	МаппингПутей = Новый Массив;
	Данные = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data", Данные) Тогда
		НачальныйПуть = Новый Массив;
		НачальныйПуть.Добавить("data");
		СобратьСтрокиExecuteCodeРекурсивно(КонтекстРантайма, Данные, НачальныйПуть,
			ТекстыМассив, МаппингПутей, 0);
	КонецЕсли;
	Если ТекстыМассив.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь; Возврат;
	КонецЕсли;
	РегексКонтекст.ТекстыJSON         = ЗаписатьJSON2(ТекстыМассив);
	РегексКонтекст.МаппингПутей       = МаппингПутей;
	РегексКонтекст.ЕстьТекстыДляRegex = Истина;
КонецПроцедуры

Процедура СобратьСтрокиExecuteCodeРекурсивно(КонтекстРантайма, Значение, ТекущийПуть,
	ТекстыМассив, МаппингПутей, Глубина)
	Если Глубина > 10 Или Значение = Неопределено Тогда Возврат; КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		// Не отправлять реальные токены текущего сеанса в regex — широкие правила могут их сломать
		Если НЕ ЭтоИзвестныйТокенАнонимизации(КонтекстРантайма, Значение) Тогда
			ТекстыМассив.Добавить(Значение);
			КопияПути = Новый Массив;
			Для Каждого Эл Из ТекущийПуть Цикл КопияПути.Добавить(Эл); КонецЦикла;
			МаппингПутей.Добавить(КопияПути);
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		ЭтоОбъектРеф = Ложь;
		Значение.Свойство("_objectRef", ЭтоОбъектРеф);
		Для Каждого КВП Из Значение Цикл
			// Технические поля trusted-ссылки не собираем
			Если ЭтоОбъектРеф = Истина
				И (КВП.Ключ = "_objectRef"
					Или КВП.Ключ = "УникальныйИдентификатор"
					Или КВП.Ключ = "ТипОбъекта") Тогда
				Продолжить;
			КонецЕсли;
			НовыйПуть = Новый Массив;
			Для Каждого Эл Из ТекущийПуть Цикл НовыйПуть.Добавить(Эл); КонецЦикла;
			НовыйПуть.Добавить(КВП.Ключ);
			СобратьСтрокиExecuteCodeРекурсивно(КонтекстРантайма, КВП.Значение, НовыйПуть,
				ТекстыМассив, МаппингПутей, Глубина + 1);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Инд = 0 По Значение.Количество() - 1 Цикл
			НовыйПуть = Новый Массив;
			Для Каждого Эл Из ТекущийПуть Цикл НовыйПуть.Добавить(Эл); КонецЦикла;
			НовыйПуть.Добавить(Инд);
			СобратьСтрокиExecuteCodeРекурсивно(КонтекстРантайма, Значение[Инд], НовыйПуть,
				ТекстыМассив, МаппингПутей, Глубина + 1);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ПрименитьRegexТокеныExecuteCode(КонтекстРантайма, РегексКонтекст, СовпаденияJSON) Экспорт
	Если НЕ ЗначениеЗаполнено(СовпаденияJSON) Тогда Возврат; КонецЕсли;
	РезСовпадений = Неопределено;
	Попытка РезСовпадений = ПрочитатьJSON2(СовпаденияJSON); Исключение Возврат; КонецПопытки;
	Если ТипЗнч(РезСовпадений) <> Тип("Массив") Тогда Возврат; КонецЕсли;
	МаппингПутей    = РегексКонтекст.МаппингПутей;
	КореньРезультат = РегексКонтекст.Результат;
	Для ТекстИнд = 0 По РезСовпадений.Количество() - 1 Цикл
		Если ТекстИнд >= МаппингПутей.Количество() Тогда Прервать; КонецЕсли;
		ЭлСовпадений = РезСовпадений[ТекстИнд];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Путь = МаппингПутей[ТекстИнд];
		Если Путь.Количество() = 0 Тогда Продолжить; КонецЕсли;
		// Обход от корня до родительского контейнера
		Контейнер = КореньРезультат;
		ОшибкаПути = Ложь;
		Для НавИнд = 0 По Путь.Количество() - 2 Цикл
			ЭлПути = Путь[НавИнд];
			Если ТипЗнч(Контейнер) = Тип("Массив") Тогда
				Контейнер = Контейнер[ЭлПути];
			ИначеЕсли ТипЗнч(Контейнер) = Тип("Структура") Тогда
				Вложенное = Неопределено;
				Контейнер.Свойство(ЭлПути, Вложенное);
				Контейнер = Вложенное;
			Иначе
				ОшибкаПути = Истина; Прервать;
			КонецЕсли;
			Если Контейнер = Неопределено Тогда ОшибкаПути = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		Если ОшибкаПути Тогда Продолжить; КонецЕсли;
		Ключ = Путь[Путь.Количество() - 1];
		Если ТипЗнч(Контейнер) = Тип("Массив") Тогда
			ТекущийТекст = Контейнер[Ключ];
		ИначеЕсли ТипЗнч(Контейнер) = Тип("Структура") Тогда
			ТекущийТекст = Неопределено;
			Контейнер.Свойство(Ключ, ТекущийТекст);
		Иначе
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Тогда Продолжить; КонецЕсли;
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = ""; МатчТекст = ""; Начало = 0; Длина = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория); С.Свойство("match", МатчТекст);
				С.Свойство("start", Начало);       С.Свойство("length", Длина);
			Иначе
				Категория = С["category"]; МатчТекст = С["match"];
				Начало = С["start"];       Длина = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(КонтекстРантайма, МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;
		Если ТипЗнч(Контейнер) = Тип("Массив") Тогда
			Контейнер[Ключ] = НовыйТекст;
		Иначе
			Контейнер.Вставить(Ключ, НовыйТекст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура АнонимизироватьРезультатВстроенный(КонтекстРантайма, Результат, РегексКонтекст = Неопределено) Экспорт

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат);
	Если НастройкиАнонимизации = Неопределено Тогда Возврат; КонецЕсли;
	ПравилаАнонимизации = НастройкиАнонимизации.Правила;

	// Строим карту политик колонок из уже проставленных полей schema
	СоответствиеPolicy = Новый Соответствие;
	Схема = Неопределено;
	Если НЕ Результат.Свойство("schema", Схема)
		Или ТипЗнч(Схема) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Колонки = Неопределено;
	Если НЕ Схема.Свойство("columns", Колонки)
		Или ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
		ИмяКолонки = "";
		Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
		Режим = "default";
		Колонка.Свойство("anonymization_mode", Режим);
		РежимСсылки = "default";
		Колонка.Свойство("reference_presentation_mode", РежимСсылки);
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		СоответствиеPolicy.Вставить(ИмяКолонки,
			Новый Структура("mode, ref_mode, sources, АвтоСтрока, АвтоПредставление", Режим, РежимСсылки, Sources,
				НастройкиАнонимизации.АгрессивныйРежим И КолонкаСтроковаяПоСхеме(Колонка),
				НастройкиАнонимизации.АгрессивныйРежим И КолонкаСсылочнаяПоСхеме(Колонка)));
	КонецЦикла;

	// Обходим строки данных
	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Данные Цикл
		Если ТипЗнч(Строка) <> Тип("Соответствие")
			И ТипЗнч(Строка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого PolicyЭлт Из СоответствиеPolicy Цикл
			ИмяКолонки = PolicyЭлт.Ключ;
			Policy      = PolicyЭлт.Значение;

			ЗначениеКолонки = Неопределено;
			Если ТипЗнч(Строка) = Тип("Структура") Тогда
				Если НЕ Строка.Свойство(ИмяКолонки, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
			Иначе
				ЗначениеКолонки = Строка[ИмяКолонки];
			КонецЕсли;
			Если ЗначениеКолонки = Неопределено Тогда Продолжить; КонецЕсли;

			Если ТипЗнч(ЗначениеКолонки) = Тип("Структура")
				И ЗначениеКолонки.Свойство("Представление") Тогда
				// Объектное значение — анонимизируем только Представление
				// Перечисления не анонимизируются никогда (в т.ч. при смешанном типе колонки)
				// Планы счетов по умолчанию не анонимизируются, если нет явного force_anonymize
				ТипОбъектаЗначения = "";
				ЗначениеКолонки.Свойство("ТипОбъекта", ТипОбъектаЗначения);
				Если Найти(ТипОбъектаЗначения, "ПеречислениеСсылка.") = 1 Тогда
					Продолжить;
				КонецЕсли;
				Если Найти(ТипОбъектаЗначения, "ПланСчетовСсылка.") = 1
					И Policy.mode <> "force_anonymize"
					И Policy.ref_mode <> "force_anonymize" Тогда
					Продолжить;
				КонецЕсли;
				Если Policy.mode = "force_keep" Тогда
					Продолжить;
				ИначеЕсли Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
					ЗначениеКолонки.Вставить("Представление",
						АнонимизироватьЗначениеВстроенный(КонтекстРантайма, ЗначениеКолонки.Представление, Policy.sources, ПравилаАнонимизации));
				ИначеЕсли Policy.ref_mode = "force_keep" Тогда
					Продолжить;
				Иначе
					ЗначениеКолонки.Вставить("Представление",
						ОбработатьСтрокуПоPolicy(КонтекстРантайма, ЗначениеКолонки.Представление, Policy.mode, Policy.ref_mode, Policy.АвтоПредставление, Policy.sources, ПравилаАнонимизации));
				КонецЕсли;

			ИначеЕсли ТипЗнч(ЗначениеКолонки) = Тип("Строка") Тогда
				// Строковое значение
				НовоеЗначение = Неопределено;
				Если Policy.mode = "force_anonymize" Тогда
					НовоеЗначение = АнонимизироватьЗначениеВстроенный(КонтекстРантайма, ЗначениеКолонки, Policy.sources, ПравилаАнонимизации);
				ИначеЕсли Policy.mode = "default" Тогда
					НовоеЗначение = ОбработатьСтрокуПоPolicy(КонтекстРантайма, ЗначениеКолонки, Policy.mode, "default", Policy.АвтоСтрока, Policy.sources, ПравилаАнонимизации);
				КонецЕсли;
				Если НовоеЗначение <> Неопределено Тогда
					Если ТипЗнч(Строка) = Тип("Структура") Тогда
						Строка.Вставить(ИмяКолонки, НовоеЗначение);
					Иначе
						Строка[ИмяКолонки] = НовоеЗначение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	// Фаза regex: собрать тексты после словарной анонимизации
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegex(КонтекстРантайма, Результат, РегексКонтекст);
	КонецЕсли;

КонецПроцедуры

Процедура АнонимизироватьРезультатFindReferencesВстроенный(КонтекстРантайма, Результат, РегексКонтекст = Неопределено) Экспорт

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат);
	Если НастройкиАнонимизации = Неопределено Тогда Возврат; КонецЕсли;
	ПравилаАнонимизации = НастройкиАнонимизации.Правила;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;

	Для Каждого Хит Из Хиты Цикл
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		РежимFound = "default";
		SourcesFoundInObject = Новый Массив;

		// 1. found_in_object.Представление (документы/справочники)
		НайденВОбъекте = Неопределено;
		Если Хит.Свойство("found_in_object", НайденВОбъекте)
			И ТипЗнч(НайденВОбъекте) = Тип("Структура") Тогда
			РезОбъекта = АнонимизироватьПредставлениеObjectRef(КонтекстРантайма, НайденВОбъекте, ПравилаАнонимизации, АгрессивныйРежим);
			РежимFound = РезОбъекта.Режим;
			SourcesFoundInObject = РезОбъекта.Sources;
		КонецЕсли;

		// 2. record_key.*.Представление (objectRef-измерения регистров)
		ВсеИзмеренияЗащищены = Истина;
		ЕстьСсылочноеИзмерение = Ложь;
		ЕстьИзмерениеForceAnonymize = Ложь;
		КлючЗаписи = Неопределено;
		Если Хит.Свойство("record_key", КлючЗаписи)
			И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
			Для Каждого КВП Из КлючЗаписи Цикл
				Если ТипЗнч(КВП.Значение) = Тип("Структура") Тогда
					РезКлюча = АнонимизироватьПредставлениеObjectRef(КонтекстРантайма, КВП.Значение, ПравилаАнонимизации, АгрессивныйРежим);
					ЕстьСсылочноеИзмерение = Истина;
					Если РезКлюча.Режим = "force_anonymize" Тогда
						ЕстьИзмерениеForceAnonymize = Истина;
					КонецЕсли;
					Если РезКлюча.Режим <> "force_keep" Тогда
						ВсеИзмеренияЗащищены = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВсеИзмеренияЗащищены = ВсеИзмеренияЗащищены И ЕстьСсылочноеИзмерение;

		// 3. note
		Примечание = Неопределено;
		Если Хит.Свойство("note", Примечание)
			И ТипЗнч(Примечание) = Тип("Строка")
			И НЕ ПустаяСтрока(Примечание) Тогда
			Если НайденВОбъекте <> Неопределено Тогда
				// Документ/справочник: note следует режиму found_in_object
				Если РежимFound = "force_anonymize" Тогда
					Хит.Вставить("note", АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Примечание, SourcesFoundInObject, ПравилаАнонимизации));
				ИначеЕсли РежимFound <> "force_keep" Тогда
					Хит.Вставить("note", ОбработатьСтрокуПоPolicy(КонтекстРантайма, Примечание, "default", "default", АгрессивныйРежим, SourcesFoundInObject, ПравилаАнонимизации));
				Иначе
				КонецЕсли;
			ИначеЕсли НЕ ВсеИзмеренияЗащищены Тогда
				// Регистр: обрабатываем если хотя бы одно измерение не force_keep
				Если ЕстьИзмерениеForceAnonymize Тогда
					Хит.Вставить("note", АнонимизаторТокенизировать(КонтекстРантайма, Примечание, "STR"));
				Иначе
					Хит.Вставить("note", ОбработатьСтрокуПоPolicy(КонтекстРантайма, Примечание, "default", "default", АгрессивныйРежим, SourcesFoundInObject, ПравилаАнонимизации));
				КонецЕсли;
			Иначе
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Phase 3: сбор текстов для regex-токенизации
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexFindReferences(КонтекстРантайма, Результат, РегексКонтекст, ПравилаАнонимизации, АгрессивныйРежим);
	КонецЕсли;

КонецПроцедуры

Функция АнонимизироватьПредставлениеObjectRef(КонтекстРантайма, ОписаниеОбъекта, ПравилаАнонимизации, АгрессивныйРежим)

	ПустойРезультат = Новый Структура("Режим, Sources", "default", Новый Массив);
	ЗащищённыйРезультат = Новый Структура("Режим, Sources", "force_keep", Новый Массив);

	ТипОбъекта = "";
	ОписаниеОбъекта.Свойство("ТипОбъекта", ТипОбъекта);
	Если Найти(ТипОбъекта, "ПеречислениеСсылка.") = 1 Тогда Возврат ЗащищённыйРезультат; КонецЕсли;

	Представление = Неопределено;
	Если НЕ ОписаниеОбъекта.Свойство("Представление", Представление) Тогда Возврат ПустойРезультат; КонецЕсли;
	Если ТипЗнч(Представление) <> Тип("Строка") Или ПустаяСтрока(Представление) Тогда Возврат ПустойРезультат; КонецЕсли;

	Режим = ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим);

	Если Режим = "force_keep" Тогда
		Возврат Новый Структура("Режим, Sources", Режим, Новый Массив);
	ИначеЕсли Режим = "force_anonymize" Тогда
		ПутьНаименования = ПолучитьПутьНаименованияПоТипуОбъекта(ТипОбъекта);
		МассивSources = Новый Массив;
		МассивSources.Добавить(?(НЕ ПустаяСтрока(ПутьНаименования), ПутьНаименования, ТипОбъекта));
		ОписаниеОбъекта.Вставить("Представление",
			АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Представление, МассивSources, ПравилаАнонимизации));
		Возврат Новый Структура("Режим, Sources", Режим, МассивSources);
	КонецЕсли;

	// Phase 2: нет правила, не агрессивный — словарная замена
	ОписаниеОбъекта.Вставить("Представление", ОбработатьСтрокуПоPolicy(КонтекстРантайма, Представление, Режим, "default", АгрессивныйРежим, Новый Массив, ПравилаАнонимизации));
	Возврат Новый Структура("Режим, Sources", "default", Новый Массив);

КонецФункции

Процедура СобратьТекстыДляRegexFindReferences(КонтекстРантайма, Результат, РегексКонтекст, ПравилаАнонимизации, АгрессивныйРежим)

	// Получить включённые regex-правила
	ВсеПравила = КонтекстРантайма.ПравилаRegex;
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") Тогда
			Включено = Истина;
			Попытка Правило.Свойство("enabled", Включено); Исключение КонецПопытки;
			Если Включено Тогда
				ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ВключённыеПравила.Количество() = 0 Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	ТекстыМассив = Новый Массив;
	МаппингИндексов = Новый Массив;

	Для ХитИндекс = 0 По Хиты.Количество() - 1 Цикл
		Хит = Хиты[ХитИндекс];
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// found_in_object.Представление
		НайденВОбъектеN = Неопределено;
		РежимFoundN = "default";
		Если Хит.Свойство("found_in_object", НайденВОбъектеN)
			И ТипЗнч(НайденВОбъектеN) = Тип("Структура") Тогда
			ТипОбъекта = "";
			НайденВОбъектеN.Свойство("ТипОбъекта", ТипОбъекта);
			РежимFoundN = ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим);
			Если РежимFoundN <> "force_keep" Тогда
				Представление = Неопределено;
				Если НайденВОбъектеN.Свойство("Представление", Представление)
					И ТипЗнч(Представление) = Тип("Строка")
					И НЕ ПустаяСтрока(Представление) Тогда
					ТекстыМассив.Добавить(Представление);
					МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид", ХитИндекс, "found_in_object"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// record_key.*.Представление
		ВсеИзмеренияЗащищеныN = Истина;
		ЕстьСсылочноеИзмерениеN = Ложь;
		ЕстьИзмерениеForceAnonymizeN = Ложь;
		КлючЗаписи = Неопределено;
		Если Хит.Свойство("record_key", КлючЗаписи)
			И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
			Для Каждого КВП Из КлючЗаписи Цикл
				Если ТипЗнч(КВП.Значение) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				ТипОбъектаПоля = "";
				КВП.Значение.Свойство("ТипОбъекта", ТипОбъектаПоля);
				РежимПоля = ВычислитьРежимObjectRef(ТипОбъектаПоля, ПравилаАнонимизации, АгрессивныйРежим);
				ЕстьСсылочноеИзмерениеN = Истина;
				Если РежимПоля = "force_anonymize" Тогда
					ЕстьИзмерениеForceAnonymizeN = Истина;
				КонецЕсли;
				Если РежимПоля = "force_keep" Тогда Продолжить; КонецЕсли;
				ВсеИзмеренияЗащищеныN = Ложь;
				ПредставлениеПоля = Неопределено;
				Если КВП.Значение.Свойство("Представление", ПредставлениеПоля)
					И ТипЗнч(ПредставлениеПоля) = Тип("Строка")
					И НЕ ПустаяСтрока(ПредставлениеПоля) Тогда
					ТекстыМассив.Добавить(ПредставлениеПоля);
					МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид, ИмяПоля",
						ХитИндекс, "record_key", КВП.Ключ));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВсеИзмеренияЗащищеныN = ВсеИзмеренияЗащищеныN И ЕстьСсылочноеИзмерениеN;

		// note
		Примечание = Неопределено;
		ДобавитьNote = Ложь;
		Если Хит.Свойство("note", Примечание)
			И ТипЗнч(Примечание) = Тип("Строка")
			И НЕ ПустаяСтрока(Примечание) Тогда
			Если НайденВОбъектеN <> Неопределено Тогда
				ДобавитьNote = (РежимFoundN <> "force_keep");
			Иначе
				ДобавитьNote = НЕ ВсеИзмеренияЗащищеныN И НЕ ЕстьИзмерениеForceAnonymizeN;
			КонецЕсли;
		КонецЕсли;
		Если ДобавитьNote Тогда
			ТекстыМассив.Добавить(Примечание);
			МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид", ХитИндекс, "note"));
		КонецЕсли;

	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда Возврат; КонецЕсли;

	РегексКонтекст.Вставить("ВключённыеПравилаJSON", ЗаписатьJSON2(ВключённыеПравила));
	РегексКонтекст.Вставить("ТекстыJSON",            ЗаписатьJSON2(ТекстыМассив));
	РегексКонтекст.Вставить("МаппингИндексов",       МаппингИндексов);
	РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Истина);

КонецПроцедуры

Процедура ПрименитьRegexТокеныFindReferences(КонтекстРантайма, РегексКонтекст, СовпаденияJSON) Экспорт

	Если ПустаяСтрока(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	МаппингИндексов = Неопределено;
	Если НЕ РегексКонтекст.Свойство("МаппингИндексов", МаппингИндексов)
		Или МаппингИндексов = Неопределено Тогда Возврат; КонецЕсли;

	Результат = Неопределено;
	Если НЕ РегексКонтекст.Свойство("Результат", Результат)
		Или ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	Попытка
		Совпадения = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Совпадения) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	// РезСовпадений — массив по тем же индексам, что и МаппингИндексов / ТекстыМассив.
	// Каждый элемент — массив совпадений {category, match, start, length}, отсортированных по start DESC.
	РезСовпадений = Совпадения;
	Для ТекстИндекс = 0 По МаппингИндексов.Количество() - 1 Цикл

		Если ТекстИндекс >= РезСовпадений.Количество() Тогда Прервать; КонецЕсли;

		ЭлСовпадений = РезСовпадений[ТекстИндекс];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда Продолжить; КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИндекс];
		Если ТипЗнч(МаппингЭлт) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		ХитИндекс = 0;
		МаппингЭлт.Свойство("ХитИндекс", ХитИндекс);
		Вид = "";
		МаппингЭлт.Свойство("Вид", Вид);

		Если ХитИндекс >= Хиты.Количество() Тогда Продолжить; КонецЕсли;
		Хит = Хиты[ХитИндекс];
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// Прочитать текущий текст из хита, сохранить ссылку для обратной записи
		ТекущийТекст    = "";
		СтруктураЗаписи = Неопределено; // структура, в которую пишем "Представление"
		ПрямаяЗапись    = Ложь;         // для "note" — пишем прямо в Хит

		Если Вид = "found_in_object" Тогда
			НайденВОбъекте = Неопределено;
			Если Хит.Свойство("found_in_object", НайденВОбъекте)
				И ТипЗнч(НайденВОбъекте) = Тип("Структура") Тогда
				НайденВОбъекте.Свойство("Представление", ТекущийТекст);
				СтруктураЗаписи = НайденВОбъекте;
			КонецЕсли;

		ИначеЕсли Вид = "record_key" Тогда
			ИмяПоля = "";
			МаппингЭлт.Свойство("ИмяПоля", ИмяПоля);
			КлючЗаписи = Неопределено;
			Если Хит.Свойство("record_key", КлючЗаписи)
				И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
				ЗначениеПоля = Неопределено;
				Если КлючЗаписи.Свойство(ИмяПоля, ЗначениеПоля)
					И ТипЗнч(ЗначениеПоля) = Тип("Структура") Тогда
					ЗначениеПоля.Свойство("Представление", ТекущийТекст);
					СтруктураЗаписи = ЗначениеПоля;
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли Вид = "note" Тогда
			Хит.Свойство("note", ТекущийТекст);
			ПрямаяЗапись = Истина;

		КонецЕсли;

		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Или ПустаяСтрока(ТекущийТекст) Тогда Продолжить; КонецЕсли;

		// Применить совпадения справа налево (отсортированы DESC по start)
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = "";
			МатчТекст = "";
			Начало    = 0;
			Длина     = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(КонтекстРантайма, МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		// Записать результат обратно
		Если ПрямаяЗапись Тогда
			Хит.Вставить("note", НовыйТекст);
		ИначеЕсли СтруктураЗаписи <> Неопределено Тогда
			СтруктураЗаписи.Вставить("Представление", НовыйТекст);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ЭтоGUID(Знач Строка)
	Возврат СтрДлина(Строка) = 36
		И Сред(Строка,  9, 1) = "-"
		И Сред(Строка, 14, 1) = "-"
		И Сред(Строка, 19, 1) = "-"
		И Сред(Строка, 24, 1) = "-";
КонецФункции

Процедура АнонимизироватьРезультатGetAccessRights(КонтекстРантайма, Результат) Экспорт

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;
	Если НЕ Результат.Свойство("success") Или НЕ Результат.success Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные) Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	ДанныеПользователя = Неопределено;
	Если НЕ Данные.Свойство("user", ДанныеПользователя) Тогда Возврат; КонецЕсли;
	Если ТипЗнч(ДанныеПользователя) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	// name → PER-токен
	ИмяПольз = "";
	Если ДанныеПользователя.Свойство("name", ИмяПольз)
		И ТипЗнч(ИмяПольз) = Тип("Строка")
		И НЕ ПустаяСтрока(ИмяПольз) Тогда
		ДанныеПользователя.Вставить("name", ТокенизироватьНезащищенныйТекст(КонтекстРантайма, ИмяПольз, "PER"));
	КонецЕсли;

	// full_name → PER-токен (поле опциональное)
	ПолноеИмя = "";
	Если ДанныеПользователя.Свойство("full_name", ПолноеИмя)
		И ТипЗнч(ПолноеИмя) = Тип("Строка")
		И НЕ ПустаяСтрока(ПолноеИмя) Тогда
		ДанныеПользователя.Вставить("full_name", ТокенизироватьНезащищенныйТекст(КонтекстРантайма, ПолноеИмя, "PER"));
	КонецЕсли;

КонецПроцедуры

Процедура АнонимизироватьРезультатGetEventLogВстроенный(КонтекстРантайма, Результат, РегексКонтекст = Неопределено) Экспорт

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Результат.Свойство("success", РезультатУспех);
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат);
	Если НастройкиАнонимизации = Неопределено Тогда Возврат; КонецЕсли;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;

	Для ЗаписьИндекс = 0 По Данные.Количество() - 1 Цикл
		Запись = Данные[ЗаписьИндекс];
		Если ТипЗнч(Запись) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// user - токенизируем как персону, если не UUID
		Польз = "";
		Если Запись.Свойство("user", Польз)
			И ТипЗнч(Польз) = Тип("Строка")
			И НЕ ПустаяСтрока(Польз)
			И НЕ ЭтоGUID(Польз) Тогда
			Запись.Вставить("user", ТокенизироватьНезащищенныйТекст(КонтекстРантайма, Польз, "PER"));
		КонецЕсли;

		// computer — всегда токенизируем как строку
		Комп = "";
		Если Запись.Свойство("computer", Комп)
			И ТипЗнч(Комп) = Тип("Строка")
			И НЕ ПустаяСтрока(Комп) Тогда
			Запись.Вставить("computer", ТокенизироватьНезащищенныйТекст(КонтекстРантайма, Комп, "STR"));
		КонецЕсли;

		// comment — словарная замена (regex-фаза позже)
		Коммент = "";
		Если Запись.Свойство("comment", Коммент)
			И ТипЗнч(Коммент) = Тип("Строка")
			И НЕ ПустаяСтрока(Коммент) Тогда
			Запись.Вставить("comment", ПрименитьСловарьКСтроке(КонтекстРантайма, Коммент));
		КонецЕсли;

		// data_presentation — агрессивный режим: целиком; иначе — словарная замена (regex-фаза позже)
		ДатаПред = "";
		Если Запись.Свойство("data_presentation", ДатаПред)
			И ТипЗнч(ДатаПред) = Тип("Строка")
			И НЕ ПустаяСтрока(ДатаПред) Тогда
			Если АгрессивныйРежим Тогда
				Запись.Вставить("data_presentation", ТокенизироватьНезащищенныйТекст(КонтекстРантайма, ДатаПред, "STR"));
			Иначе
				Запись.Вставить("data_presentation", ПрименитьСловарьКСтроке(КонтекстРантайма, ДатаПред));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Собрать тексты для regex-фазы
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexGetEventLog(КонтекстРантайма, Результат, РегексКонтекст, АгрессивныйРежим);
	КонецЕсли;

КонецПроцедуры

Процедура СобратьТекстыДляRegexGetEventLog(КонтекстРантайма, Результат, РегексКонтекст, АгрессивныйРежим = Ложь)

	ВсеПравила = КонтекстРантайма.ПравилаRegex;
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") Тогда
			Включено = Истина;
			Попытка Правило.Свойство("enabled", Включено); Исключение КонецПопытки;
			Если Включено Тогда
				ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ВключённыеПравила.Количество() = 0 Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	ТекстыМассив  = Новый Массив;
	МаппингИндексов = Новый Массив;

	Для ЗаписьИндекс = 0 По Данные.Количество() - 1 Цикл
		Запись = Данные[ЗаписьИндекс];
		Если ТипЗнч(Запись) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// comment (после словарной замены)
		Коммент = "";
		Если Запись.Свойство("comment", Коммент)
			И ТипЗнч(Коммент) = Тип("Строка")
			И НЕ ПустаяСтрока(Коммент) Тогда
			ТекстыМассив.Добавить(Коммент);
			МаппингИндексов.Добавить(Новый Структура("ЗаписьИндекс, ИмяПоля", ЗаписьИндекс, "comment"));
		КонецЕсли;

		// data_presentation (после словарной замены) — только если не агрессивный режим
		Если НЕ АгрессивныйРежим Тогда
			ДатаПред = "";
			Если Запись.Свойство("data_presentation", ДатаПред)
				И ТипЗнч(ДатаПред) = Тип("Строка")
				И НЕ ПустаяСтрока(ДатаПред) Тогда
				ТекстыМассив.Добавить(ДатаПред);
				МаппингИндексов.Добавить(Новый Структура("ЗаписьИндекс, ИмяПоля", ЗаписьИндекс, "data_presentation"));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда Возврат; КонецЕсли;

	РегексКонтекст.Вставить("ВключённыеПравилаJSON", ЗаписатьJSON2(ВключённыеПравила));
	РегексКонтекст.Вставить("ТекстыJSON",            ЗаписатьJSON2(ТекстыМассив));
	РегексКонтекст.Вставить("МаппингИндексов",       МаппингИндексов);
	РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Истина);

КонецПроцедуры

Процедура ПрименитьRegexТокеныGetEventLog(КонтекстРантайма, РегексКонтекст, СовпаденияJSON) Экспорт

	Если ПустаяСтрока(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	МаппингИндексов = Неопределено;
	Если НЕ РегексКонтекст.Свойство("МаппингИндексов", МаппингИндексов)
		Или МаппингИндексов = Неопределено Тогда Возврат; КонецЕсли;

	Результат = Неопределено;
	Если НЕ РегексКонтекст.Свойство("Результат", Результат)
		Или ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	Попытка
		Совпадения = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Совпадения) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	РезСовпадений = Совпадения;
	Для ТекстИндекс = 0 По МаппингИндексов.Количество() - 1 Цикл

		Если ТекстИндекс >= РезСовпадений.Количество() Тогда Прервать; КонецЕсли;

		ЭлСовпадений = РезСовпадений[ТекстИндекс];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда Продолжить; КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИндекс];
		Если ТипЗнч(МаппингЭлт) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		ЗаписьИндекс = 0;
		МаппингЭлт.Свойство("ЗаписьИндекс", ЗаписьИндекс);
		ИмяПоля = "";
		МаппингЭлт.Свойство("ИмяПоля", ИмяПоля);

		Если ЗаписьИндекс >= Данные.Количество() Тогда Продолжить; КонецЕсли;
		Запись = Данные[ЗаписьИндекс];
		Если ТипЗнч(Запись) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		ТекущийТекст = "";
		Запись.Свойство(ИмяПоля, ТекущийТекст);
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Или ПустаяСтрока(ТекущийТекст) Тогда Продолжить; КонецЕсли;

		// Применить совпадения справа налево (отсортированы DESC по start)
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = "";
			МатчТекст = "";
			Начало    = 0;
			Длина     = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(КонтекстРантайма, МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		Запись.Вставить(ИмяПоля, НовыйТекст);

	КонецЦикла;

КонецПроцедуры

Процедура АнонимизироватьОбъектВстроенный(КонтекстРантайма, Результат, РегексКонтекст = Неопределено) Экспорт

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Результат.Свойство("success", РезультатУспех);
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные) Или ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	// — BLIND MODE —
	ЕстьСхема = Результат.Свойство("schema") И НЕ Результат.Свойство("_blind_anonymization");
	Если НЕ ЕстьСхема Тогда
		// Технические ключи, которые нельзя трогать
		СлужебныеКлючи = Новый Соответствие;
		СлужебныеКлючи.Вставить("_type",               Истина);
		СлужебныеКлючи.Вставить("_objectRef",          Истина);
		СлужебныеКлючи.Вставить("ТипОбъекта",          Истина);
		СлужебныеКлючи.Вставить("УникальныйИдентификатор", Истина);

		Для Каждого КВП Из Данные Цикл
			Если СлужебныеКлючи[КВП.Ключ] = Истина Тогда Продолжить; КонецЕсли;
			Значение = КВП.Значение;
			Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
				Данные.Вставить(КВП.Ключ, ТокенизироватьНезащищенныйТекст(КонтекстРантайма, Значение, "STR"));
			ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
				// _objectRef или другая структура — токенизируем Представление
				ПредставлениеОбъекта = "";
				Если Значение.Свойство("Представление", ПредставлениеОбъекта)
					И ТипЗнч(ПредставлениеОбъекта) = Тип("Строка")
					И ПредставлениеОбъекта <> "" Тогда
					Значение.Вставить("Представление", ТокенизироватьНезащищенныйТекст(КонтекстРантайма, ПредставлениеОбъекта, "STR"));
				КонецЕсли;
			ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
				// ТЧ или массив строк (ФиксированныйМассив → Массив после ПреобразоватьЗначениеДляJSON)
				Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
					ЭлтМасс = Значение[ЭлтИнд];
					Если ТипЗнч(ЭлтМасс) = Тип("Строка") И ЭлтМасс <> "" Тогда
						Значение[ЭлтИнд] = ТокенизироватьНезащищенныйТекст(КонтекстРантайма, ЭлтМасс, "STR");
					ИначеЕсли ТипЗнч(ЭлтМасс) = Тип("Структура") Тогда
						Для Каждого КВПСтр Из ЭлтМасс Цикл
							Если СлужебныеКлючи[КВПСтр.Ключ] = Истина Тогда Продолжить; КонецЕсли;
							ЗнчСтр = КВПСтр.Значение;
							Если ТипЗнч(ЗнчСтр) = Тип("Строка") И ЗнчСтр <> "" Тогда
								ЭлтМасс.Вставить(КВПСтр.Ключ, ТокенизироватьНезащищенныйТекст(КонтекстРантайма, ЗнчСтр, "STR"));
							ИначеЕсли ТипЗнч(ЗнчСтр) = Тип("Структура") Тогда
								ПредстСтр = "";
								Если ЗнчСтр.Свойство("Представление", ПредстСтр)
									И ТипЗнч(ПредстСтр) = Тип("Строка") И ПредстСтр <> "" Тогда
									ЗнчСтр.Вставить("Представление", ТокенизироватьНезащищенныйТекст(КонтекстРантайма, ПредстСтр, "STR"));
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		// Regex в blind mode не запускаем — все строки уже целиком токенизированы
		// РегексКонтекст.ЕстьТекстыДляRegex остаётся Ложь
		Возврат;
	КонецЕсли;

	// — SCHEMA MODE —
	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииДляРезультата(КонтекстРантайма, Результат);
	Если НастройкиАнонимизации = Неопределено Тогда Возврат; КонецЕсли;
	ПравилаАнонимизации = НастройкиАнонимизации.Правила;

	Схема = Результат.schema;
	Колонки = Неопределено;
	Если НЕ Схема.Свойство("columns", Колонки) Или ТипЗнч(Колонки) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	// Карта политик основных колонок
	СоответствиеPolicy = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
		ИмяКолонки = "";
		Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
		Режим = "default";      Колонка.Свойство("anonymization_mode", Режим);
		РежимСсылки = "default"; Колонка.Свойство("reference_presentation_mode", РежимСсылки);
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		СоответствиеPolicy.Вставить(ИмяКолонки,
			Новый Структура("mode, ref_mode, sources, АвтоСтрока, АвтоПредставление", Режим, РежимСсылки, Sources,
				НастройкиАнонимизации.АгрессивныйРежим И КолонкаСтроковаяПоСхеме(Колонка),
				НастройкиАнонимизации.АгрессивныйРежим И КолонкаСсылочнаяПоСхеме(Колонка)));
	КонецЦикла;

	// Карты политик табличных частей
	СоответствиеPolicyТЧ = Новый Соответствие; // ИмяТЧ -> Соответствие (имя колонки -> policy)
	ТабличныеЧасти = Неопределено;
	Если Схема.Свойство("tabular_sections", ТабличныеЧасти) Тогда
		Для Каждого КВПтч Из ТабличныеЧасти Цикл
			ИмяТЧ    = КВПтч.Ключ;
			СхемаТЧ  = КВПтч.Значение;
			PolicyТЧ = Новый Соответствие;
			КолонкиТЧ = Неопределено;
			Если СхемаТЧ.Свойство("columns", КолонкиТЧ) Тогда
				Для Каждого КолТЧ Из КолонкиТЧ Цикл
					Если ТипЗнч(КолТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
					ИмяКол = ""; Если НЕ КолТЧ.Свойство("name", ИмяКол) Тогда Продолжить; КонецЕсли;
					Реж = "default";      КолТЧ.Свойство("anonymization_mode", Реж);
					РежСсылки = "default"; КолТЧ.Свойство("reference_presentation_mode", РежСсылки);
					Src = ПолучитьМассивСтрокИзСвойства(КолТЧ, "sources");
					PolicyТЧ.Вставить(ИмяКол,
						Новый Структура("mode, ref_mode, sources, АвтоСтрока, АвтоПредставление", Реж, РежСсылки, Src,
						НастройкиАнонимизации.АгрессивныйРежим И КолонкаСтроковаяПоСхеме(КолТЧ),
						НастройкиАнонимизации.АгрессивныйРежим И КолонкаСсылочнаяПоСхеме(КолТЧ)));
				КонецЦикла;
			КонецЕсли;
			СоответствиеPolicyТЧ.Вставить(ИмяТЧ, PolicyТЧ);
		КонецЦикла;
	КонецЕсли;

	// Обходим поля data (Структура)
	Для Каждого КВП Из Данные Цикл
		ИмяПоля = КВП.Ключ;
		Значение = КВП.Значение;

		// Табличная часть?
		Если СоответствиеPolicyТЧ[ИмяПоля] <> Неопределено
			И ТипЗнч(Значение) = Тип("Массив") Тогда
			PolicyМапТЧ = СоответствиеPolicyТЧ[ИмяПоля];
			Для Каждого СтрокаТЧ Из Значение Цикл
				Если ТипЗнч(СтрокаТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				Для Каждого PolicyЭлт Из PolicyМапТЧ Цикл
					ИмяКолонки = PolicyЭлт.Ключ;
					Policy      = PolicyЭлт.Значение;
					ЗначениеКолонки = Неопределено;
					Если НЕ СтрокаТЧ.Свойство(ИмяКолонки, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
					Если ЗначениеКолонки = Неопределено Тогда Продолжить; КонецЕсли;
					ОбработатьЗначениеОбъектаВстроенный(КонтекстРантайма, СтрокаТЧ, ИмяКолонки, ЗначениеКолонки, Policy, ПравилаАнонимизации);
				КонецЦикла;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		// Обычное поле
		Policy = СоответствиеPolicy[ИмяПоля];
		Если Policy = Неопределено Тогда Продолжить; КонецЕсли;
		ОбработатьЗначениеОбъектаВстроенный(КонтекстРантайма, Данные, ИмяПоля, Значение, Policy, ПравилаАнонимизации);
	КонецЦикла;

	// Фаза regex
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexОбъект(КонтекстРантайма, Результат, РегексКонтекст);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьЗначениеОбъектаВстроенный(КонтекстРантайма, Контейнер, ИмяПоля, Значение, Policy, ПравилаАнонимизации)

	Если ТипЗнч(Значение) = Тип("Структура")
		И Значение.Свойство("Представление") Тогда
		// objectRef — анонимизируем Представление по ref_mode
		ТипОбъектаЗначения = "";
		Значение.Свойство("ТипОбъекта", ТипОбъектаЗначения);
		Если Найти(ТипОбъектаЗначения, "ПеречислениеСсылка.") = 1 Тогда Возврат; КонецЕсли;
		Если Найти(ТипОбъектаЗначения, "ПланСчетовСсылка.") = 1
			И Policy.mode <> "force_anonymize" И Policy.ref_mode <> "force_anonymize" Тогда
			Возврат;
		КонецЕсли;
		Если Policy.mode = "force_keep" Тогда Возврат;
		ИначеЕсли Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
			Значение.Вставить("Представление",
				АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Значение.Представление, Policy.sources, ПравилаАнонимизации));
		ИначеЕсли Policy.ref_mode = "force_keep" Тогда Возврат;
		Иначе
			Значение.Вставить("Представление", ОбработатьСтрокуПоPolicy(КонтекстРантайма, Значение.Представление, Policy.mode, Policy.ref_mode, Policy.АвтоПредставление, Policy.sources, ПравилаАнонимизации));
		КонецЕсли;

	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		НовоеЗначение = Неопределено;
		Если Policy.mode = "force_anonymize" Тогда
			НовоеЗначение = АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Значение, Policy.sources, ПравилаАнонимизации);
		ИначеЕсли Policy.mode = "default" Тогда
			НовоеЗначение = ОбработатьСтрокуПоPolicy(КонтекстРантайма, Значение, Policy.mode, "default", Policy.АвтоСтрока, Policy.sources, ПравилаАнонимизации);
		КонецЕсли;
		Если НовоеЗначение <> Неопределено Тогда
			Контейнер.Вставить(ИмяПоля, НовоеЗначение);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		// Реквизит типа ФиксированныйМассив (строки или ссылки) после ПреобразоватьЗначениеДляJSON
		Если Policy.mode = "force_keep" Тогда Возврат; КонецЕсли;
		Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
			Элт = Значение[ЭлтИнд];
			Если ТипЗнч(Элт) = Тип("Структура") И Элт.Свойство("Представление") Тогда
				ТипОбъектаЭлт = "";
				Элт.Свойство("ТипОбъекта", ТипОбъектаЭлт);
				Если Найти(ТипОбъектаЭлт, "ПеречислениеСсылка.") = 1 Тогда Продолжить; КонецЕсли;
				Если Найти(ТипОбъектаЭлт, "ПланСчетовСсылка.") = 1
					И Policy.mode <> "force_anonymize" И Policy.ref_mode <> "force_anonymize" Тогда
					Продолжить;
				КонецЕсли;
				Если Policy.ref_mode = "force_keep" Тогда Продолжить; КонецЕсли;
				Если Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
					Элт.Вставить("Представление",
						АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Элт.Представление, Policy.sources, ПравилаАнонимизации));
				Иначе
					Элт.Вставить("Представление", ОбработатьСтрокуПоPolicy(КонтекстРантайма, Элт.Представление, Policy.mode, Policy.ref_mode, Policy.АвтоПредставление, Policy.sources, ПравилаАнонимизации));
				КонецЕсли;
			ИначеЕсли ТипЗнч(Элт) = Тип("Строка") Тогда
				НовЭлт = Неопределено;
				Если Policy.mode = "force_anonymize" Тогда
					НовЭлт = АнонимизироватьЗначениеВстроенный(КонтекстРантайма, Элт, Policy.sources, ПравилаАнонимизации);
				ИначеЕсли Policy.mode = "default" Тогда
					НовЭлт = ОбработатьСтрокуПоPolicy(КонтекстРантайма, Элт, Policy.mode, "default", Policy.АвтоСтрока, Policy.sources, ПравилаАнонимизации);
				КонецЕсли;
				Если НовЭлт <> Неопределено Тогда
					Значение[ЭлтИнд] = НовЭлт;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ДеТокенизироватьРекурсивно(КонтекстРантайма, Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат АнонимизаторДеТокенизироватьСтроку(КонтекстРантайма, Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Ключи = Новый Массив;
		НовыеЗначения = Новый Массив;
		Для Каждого КвП Из Значение Цикл
			Ключи.Добавить(КвП.Ключ);
			НовыеЗначения.Добавить(ДеТокенизироватьРекурсивно(КонтекстРантайма, КвП.Значение));
		КонецЦикла;
		Для Инд = 0 По Ключи.ВГраница() Цикл
			Значение.Вставить(Ключи[Инд], НовыеЗначения[Инд]);
		КонецЦикла;

	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Ключи = Новый Массив;
		НовыеЗначения = Новый Массив;
		Для Каждого КвП Из Значение Цикл
			Ключи.Добавить(КвП.Ключ);
			НовыеЗначения.Добавить(ДеТокенизироватьРекурсивно(КонтекстРантайма, КвП.Значение));
		КонецЦикла;
		Для Инд = 0 По Ключи.ВГраница() Цикл
			Значение.Вставить(Ключи[Инд], НовыеЗначения[Инд]);
		КонецЦикла;

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Инд = 0 По Значение.ВГраница() Цикл
			Значение[Инд] = ДеТокенизироватьРекурсивно(КонтекстРантайма, Значение[Инд]);
		КонецЦикла;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ДеАнонимизироватьПараметрыКомандыИВытеснить(КонтекстРантайма, Команда) Экспорт

	ДеАнонимизироватьПараметрыКоманды(КонтекстРантайма, Команда);
	АнонимизаторВытеснитьДоЛимита(КонтекстРантайма);

КонецПроцедуры

Процедура ДеАнонимизироватьПараметрыКоманды(КонтекстРантайма, Команда)

	АнонимизаторИнициализировать(КонтекстРантайма);

	Если КонтекстРантайма.МаппингДеанонимизации = Неопределено
		Или КонтекстРантайма.МаппингДеанонимизации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Команда.Свойство("params") Или Команда.params = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Поля с кодом/текстом запроса требуют специального экранирования кавычек
	КодовыеПоля = Новый Соответствие;
	КодовыеПоля.Вставить("execute_code",  "code");
	КодовыеПоля.Вставить("execute_query", "query");

	КодовоеПоле = КодовыеПоля.Получить(Команда.tool);
	Если КодовоеПоле <> Неопределено Тогда
		НовыеПараметры = Новый Структура;
		Для Каждого КвП Из Команда.params Цикл
			Если КвП.Ключ = КодовоеПоле Тогда
				Если Команда.tool = "execute_query" Тогда
					НовыеПараметры.Вставить(КвП.Ключ,
						АнонимизаторДеТокенизироватьСтрокуДляЗапроса(КонтекстРантайма, КвП.Значение));
				Иначе
					НовыеПараметры.Вставить(КвП.Ключ,
						АнонимизаторДеТокенизироватьСтрокуВBSL(КонтекстРантайма, КвП.Значение));
				КонецЕсли;
			Иначе
				НовыеПараметры.Вставить(КвП.Ключ, ДеТокенизироватьРекурсивно(КонтекстРантайма, КвП.Значение));
			КонецЕсли;
		КонецЦикла;
		Команда.Вставить("params", НовыеПараметры);
		Возврат;
	КонецЕсли;

	Команда.Вставить("params", ДеТокенизироватьРекурсивно(КонтекстРантайма, Команда.params));

КонецПроцедуры

Функция ПроверитьФорматСсылкиВнешнегоИсточника(Ссылка)

	Префикс = "e1cib/data/";
	Если Лев(Ссылка, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат "Link must start with 'e1cib/data/'";
	КонецЕсли;

	ПозВопрос = Найти(Ссылка, "?");
	Если ПозВопрос = 0 Тогда
		Возврат "External data source link must contain '?' with key parameters";
	КонецЕсли;

	// Путь должен быть ровно 4 сегмента: ВнешнийИсточникДанных.Источник.Таблица.ИмяТаблицы
	ПутьОбъекта = Сред(Ссылка, СтрДлина(Префикс) + 1, ПозВопрос - СтрДлина(Префикс) - 1);
	Части = Новый Массив;
	Остаток = ПутьОбъекта;
	Пока НЕ ПустаяСтрока(Остаток) Цикл
		Поз = Найти(Остаток, ".");
		Если Поз = 0 Тогда
			Части.Добавить(Остаток);
			Остаток = "";
		Иначе
			Части.Добавить(Лев(Остаток, Поз - 1));
			Остаток = Сред(Остаток, Поз + 1);
		КонецЕсли;
	КонецЦикла;

	Если Части.Количество() <> 4 Тогда
		Возврат "External data source link path must have exactly 4 segments: ВнешнийИсточникДанных.Source.Таблица.TableName";
	КонецЕсли;

	Если НРег(Части[2]) <> "таблица" Тогда
		Возврат "External data source link path segment 3 must be 'Таблица'";
	КонецЕсли;

	СтрокаПараметров = Сред(Ссылка, ПозВопрос + 1);
	Если ПустаяСтрока(СтрокаПараметров) Или Найти(СтрокаПараметров, "=") = 0 Тогда
		Возврат "External data source link must contain key parameters after '?'";
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьТекстЗапросаLineageИзКоманды(Команда) Экспорт
	Если Команда = Неопределено Или ТипЗнч(Команда) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ Команда.Свойство("params") Тогда
		Возврат "";
	КонецЕсли;
	ПараметрыКомандыLineage = Команда.params;
	Если ПараметрыКомандыLineage = Неопределено Или ТипЗнч(ПараметрыКомандыLineage) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если ПараметрыКомандыLineage.Свойство("query") Тогда
		Возврат ПараметрыКомандыLineage.query;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапроса, Результат) Экспорт
	Если КаноническоеИмяИнструментаMCP(ИмяИнструмента) <> "execute_query" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Результат.Свойство("success") Или НЕ Результат.success Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Результат.Свойство("schema") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Результат.schema = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура ПрименитьТунКонвертацию(КонтекстРантайма, Результат) Экспорт
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если КонтекстРантайма.ФорматОтветаВстроенный <> 1 Или КонтекстРантайма.КомпонентаТун = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Результат.Свойство("success") Или НЕ Результат.success Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Результат.Свойство("data") Тогда
		Возврат;
	КонецЕсли;
	ДанныеТун = КонтекстРантайма.КомпонентаТун.JsonToToon(ЗаписатьJSON2(Результат.data));
	Если ЗначениеЗаполнено(ДанныеТун) Тогда
		Результат.data = ДанныеТун;
	КонецЕсли;
КонецПроцедуры

Функция ОбработатьLegacyInitialize(ТелоJSON, Ид) Экспорт
	// Аналог ОбработатьInitialize, но без создания MCP-сессии и без mcp-session-id в ответе.
	// Всегда используем протокол 2024-11-05 (legacy SSE transport)

	Результат = Новый Структура;
	Результат.Вставить("protocolVersion", "2024-11-05");
	Результат.Вставить("capabilities", Новый Структура("tools",
		Новый Структура("listChanged", Ложь)));
	Результат.Вставить("serverInfo", Новый Структура("name, version",
		"1C MCP Toolkit (Native)", "1.0.0"));

	Возврат СформироватьJSONRPCОтвет(Ид, Результат);
КонецФункции

Функция СформироватьТелоJSONRPCОшибка(Сообщение, КодОшибки) Экспорт

	// Формат ошибок как в streamable_http (python mcp):
	// {"jsonrpc":"2.0","id":"server-error","error":{"code":-32600,"message":"..."}}

	Тело = Новый Структура;
	Тело.Вставить("jsonrpc", "2.0");
	Тело.Вставить("id", "server-error");
	Тело.Вставить("error", Новый Структура("code, message", КодОшибки, Сообщение));
	Возврат ЗаписатьJSON2(Тело);

КонецФункции

Функция ЗаголовкиJSONMCP(КонтекстРантайма, ДанныеЗапроса) Экспорт

	// Как в streamable_http: Content-Type: application/json + (если сессия валидна) mcp-session-id.

	Если КонтекстРантайма.МСПСессии = Неопределено Тогда
		Возврат ЗаголовкиJSON();
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");

	ИдСессии = ДанныеЗапроса.headers["mcp-session-id"];
	Если ИдСессии <> Неопределено
		И ВалидныйФорматСессии(ИдСессии)
		И КонтекстРантайма.МСПСессии.Получить(ИдСессии) <> Неопределено Тогда
		Заголовки.Вставить("mcp-session-id", ИдСессии);
	КонецЕсли;

	Возврат ЗаписатьJSON2(Заголовки);

КонецФункции

Функция ВалидныйФорматСессии(ИдСессии)
	// Только ASCII 0x21-0x7E (видимые, без пробелов)
	Если ПустаяСтрока(ИдСессии) Тогда Возврат Ложь КонецЕсли;
	Для Позиция = 1 По СтрДлина(ИдСессии) Цикл
		Код = КодСимвола(ИдСессии, Позиция);
		Если Код < 33 ИЛИ Код > 126 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПолучитьСхемыИнструментов(КонтекстРантайма) Экспорт

	Если КонтекстРантайма.КэшСхемИнструментов <> Неопределено Тогда
		Возврат КонтекстРантайма.КэшСхемИнструментов;
	КонецЕсли;

	Инструменты = Новый Массив;

	// execute_query
	ИмяИнструмента = "execute_query";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("execute_query",
			ОписаниеToolExecuteQuery(КонтекстРантайма.ИспользоватьТочнуюАнонимизацию),
			СхемаExecuteQuery()));
	КонецЕсли;

	// execute_code
	ИмяИнструмента = "execute_code";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("execute_code",
			ОписаниеToolExecuteCode(КонтекстРантайма.ИспользоватьТочнуюАнонимизацию),
			СхемаExecuteCode()));
	КонецЕсли;

	// get_metadata
	ИмяИнструмента = "get_metadata";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_metadata",
			ОписаниеToolGetMetadata(),
			СхемаGetMetadata()));
	КонецЕсли;

	// get_event_log
	ИмяИнструмента = "get_event_log";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_event_log",
			ОписаниеToolGetEventLog(КонтекстРантайма.ИспользоватьТочнуюАнонимизацию),
			СхемаGetEventLog()));
	КонецЕсли;

	// get_object_by_link
	ИмяИнструмента = "get_object_by_link";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_object_by_link",
			ОписаниеToolGetObjectByLink(КонтекстРантайма.ИспользоватьТочнуюАнонимизацию),
			СхемаGetObjectByLink()));
	КонецЕсли;

	// get_link_of_object
	ИмяИнструмента = "get_link_of_object";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_link_of_object",
			ОписаниеToolGetLinkOfObject(),
			СхемаGetLinkOfObject()));
	КонецЕсли;

	// find_references_to_object
	ИмяИнструмента = "find_references_to_object";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("find_references_to_object",
			ОписаниеToolFindReferencesToObject(КонтекстРантайма.ИспользоватьТочнуюАнонимизацию),
			СхемаFindReferencesToObject()));
	КонецЕсли;

	// get_access_rights
	ИмяИнструмента = "get_access_rights";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_access_rights",
			ОписаниеToolGetAccessRights(КонтекстРантайма.ИспользоватьТочнуюАнонимизацию),
			СхемаGetAccessRights()));
	КонецЕсли;

	// get_bsl_syntax_help — только если компонента загружена и инструмент включён
	ИмяИнструмента = "get_bsl_syntax_help";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента(
			"get_bsl_syntax_help",
			ОписаниеToolGetBslSyntaxHelp(),
			СхемаGetBslSyntaxHelp()));
	КонецЕсли;

	// submit_for_deanonymization — только при включённой анонимизации и включённом инструменте
	ИмяИнструмента = "submit_for_deanonymization";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("submit_for_deanonymization",
			ОписаниеToolSubmitForDeanonymization(),
			СхемаSubmitForDeanonymization()));
	КонецЕсли;

	// get_screenshot — только если компонента загружена и инструмент включён
	ИмяИнструмента = "get_screenshot";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента(
			"get_screenshot",
			ОписаниеToolGetScreenshot(),
			СхемаGetScreenshot()));
	КонецЕсли;

	// restart_1c_session — только если инструмент включён
	ИмяИнструмента = "restart_1c_session";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("restart_1c_session",
			ОписаниеToolRestart1cSession(),
			СхемаRestart1cSession()));
	КонецЕсли;

	// close_1c_session — только если инструмент включён
	ИмяИнструмента = "close_1c_session";
	Если ПроверитьДоступностьИнструментаMCP(КонтекстРантайма, ИмяИнструмента) = Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("close_1c_session",
			ОписаниеToolClose1cSession(),
			СхемаClose1cSession()));
	КонецЕсли;

	КонтекстРантайма.КэшСхемИнструментов = Новый Структура("tools", Инструменты);
	Возврат КонтекстРантайма.КэшСхемИнструментов;

КонецФункции

Функция ПримечаниеОбАнонимизации()
	М = Новый Массив;
	М.Добавить("");
	М.Добавить("NOTE: Anonymization is enabled for this tool.");
	М.Добавить("Some returned values (person names, organization names, TINs, and other");
	М.Добавить("personal data) are replaced with anonymous tokens in the format");
	М.Добавить("[CATEGORY-NNNNN] (e.g. [ORG-00001], [PER-00042], [INN-00001]).");
	М.Добавить("Tokens are stable within the current session.");
	М.Добавить("Do not attempt to interpret these tokens as meaningful data.");
	М.Добавить("Tokens can be used in subsequent requests.");
	Возврат СоединитьМассив(М, Символы.ПС);
КонецФункции

Функция ОписаниеToolExecuteQuery(АнонимизацияВключена = Ложь) Экспорт
	М = Новый Массив;
	М.Добавить("Execute a query in 1C query language and return the results.");
	М.Добавить("");
	М.Добавить("This tool executes queries on the 1C:Enterprise database using the 1C query language.");
	М.Добавить("Results are returned as JSON or TOON format.");
	М.Добавить("");
	М.Добавить("Args:");
	М.Добавить("    ctx: MCP Context (injected automatically)");
	М.Добавить("    query: The query text in 1C query language (e.g., ""ВЫБРАТЬ * ИЗ Справочник.Номенклатура"")");
	М.Добавить("    params: Optional dictionary of query parameters (e.g., {""Param1"": ""value1""}).");
	М.Добавить("           Parameter values can be:");
	М.Добавить("           - Simple values (string, number, boolean, date)");
	М.Добавить("           - Object references in format: {""_objectRef"": true, ""УникальныйИдентификатор"": ""uuid-string"", ""ТипОбъекта"": ""СправочникСсылка.Контрагенты""}");
	М.Добавить("             Object references are automatically converted to actual 1C references before query execution.");
	М.Добавить("    limit: Maximum number of rows to return (default: 100, max: 1000)");
	М.Добавить("    include_schema: Include column type schema in response (default: False)");
	М.Добавить("    ");
	М.Добавить("Returns:");
	М.Добавить("    Dictionary with:");
	М.Добавить("    - success: Boolean indicating if the query executed successfully");
	М.Добавить("    - data: Array of result objects in JSON or TOON format (if successful)");
	М.Добавить("    - schema: Column type information (if include_schema=True and successful)");
	М.Добавить("    - error: Error message (if failed)");
	М.Добавить("    ");
	М.Добавить("Examples:");
	М.Добавить("    # Simple parameter");
	М.Добавить("    execute_query(");
	М.Добавить("        query=""ВЫБРАТЬ Код, Наименование ИЗ Справочник.Номенклатура ГДЕ Код = &КодТовара"",");
	М.Добавить("        params={""КодТовара"": ""001""},");
	М.Добавить("        limit=100,");
	М.Добавить("        include_schema=True");
	М.Добавить("    )");
	М.Добавить("    ");
	М.Добавить("    # Object reference parameter (from previous execute_query result)");
	М.Добавить("    execute_query(");
	М.Добавить("        query=""ВЫБРАТЬ * ИЗ Документ.РеализацияТоваровУслуг ГДЕ Контрагент = &МойКонтрагент"",");
	М.Добавить("        params={");
	М.Добавить("            ""МойКонтрагент"": {");
	М.Добавить("                ""_objectRef"": true,");
	М.Добавить("                ""УникальныйИдентификатор"": ""a1b2c3d4-e5f6-7890-1234-567890abcdef"",");
	М.Добавить("                ""ТипОбъекта"": ""СправочникСсылка.Контрагенты""");
	М.Добавить("            }");
	М.Добавить("        },");
	М.Добавить("        limit=50");
	М.Добавить("    )");
	Если АнонимизацияВключена Тогда
		М.Добавить(ПримечаниеОбАнонимизации());
	КонецЕсли;
	Возврат СоединитьМассив(М, Символы.ПС);
КонецФункции

Функция ОписаниеToolSubmitForDeanonymization()
	М = Новый Массив;
	М.Добавить("Submit the final user-facing response for de-anonymization display.");
	М.Добавить("");
	М.Добавить("You MUST call this tool if, and only if, your final response to the user contains");
	М.Добавить("anonymization tokens in the form [CATEGORY-NNNNN], for example [ORG-00001],");
	М.Добавить("[PER-00042], [INN-00001].");
	М.Добавить("");
	М.Добавить("Call this tool exactly once, immediately before sending the final response to the user.");
	М.Добавить("Pass the complete final response text in the ""text"" parameter.");
	М.Добавить("Do NOT call this tool for intermediate reasoning, drafts, or raw tool outputs.");
	М.Добавить("");
	М.Добавить("This tool does NOT return de-anonymized text to you.");
	М.Добавить("It only confirms receipt, for example {""received"": true}.");
	М.Добавить("After calling this tool, send your original final response with tokens unchanged.");
	М.Добавить("The user will see the de-anonymized version in their interface.");
	Возврат СоединитьМассив(М, Символы.ПС);
КонецФункции

Функция ОписаниеToolExecuteCode(АнонимизацияВключена = Ложь) Экспорт
	М = Новый Массив;
	М.Добавить("Execute arbitrary code in 1C language.");
	М.Добавить("");
	М.Добавить("This tool executes code on the 1C:Enterprise server using the Execute() operator.");
	М.Добавить("The result is returned from the 'Результат' (Result) variable as JSON or TOON format.");
	М.Добавить("");
	М.Добавить("Important limitations (code is executed as a statement block, not a full module):");
	М.Добавить("- Do NOT declare procedures/functions (`Процедура/Функция`) inside the snippet.");
	М.Добавить("- Do NOT use `Возврат` (Return). Instead assign a value to `Результат`.");
	М.Добавить("");
	М.Добавить("WARNING: Some dangerous operations are blocked for safety reasons.");
	М.Добавить("");
	М.Добавить("Args:");
	М.Добавить("    ctx: MCP Context (injected automatically)");
	М.Добавить("    code: The 1C code to execute. Use 'Результат = ...' to return a value.");
	М.Добавить("    execution_context: Optional['server'|'client'], default='server'.");
	М.Добавить("        'server' — НаСервереБезКонтекста: DB access, 1C objects, no form context.");
	М.Добавить("        'client' — НаКлиенте: form attributes (ЭтаФорма), UI functions, no DB queries.");
	М.Добавить("    ");
	М.Добавить("Returns:");
	М.Добавить("    Dictionary with:");
	М.Добавить("    - success: Boolean indicating if the code executed successfully");
	М.Добавить("    - data: The value of 'Результат' variable in JSON or TOON format (if successful)");
	М.Добавить("    - error: Error message with line number (if failed)");
	М.Добавить("    ");
	М.Добавить("Example:");
	М.Добавить("    execute_code(code=""Результат = ТекущаяДата();"")");
	Если АнонимизацияВключена Тогда
		М.Добавить(ПримечаниеОбАнонимизации());
	КонецЕсли;
	Возврат СоединитьМассив(М, Символы.ПС);
КонецФункции

Функция ОписаниеToolGetMetadata() Экспорт
	М = Новый Массив;
	М.Добавить("Get metadata information about 1C database objects.");
	М.Добавить("");
	М.Добавить("This tool returns information about the structure of the 1C database in JSON format.");
	М.Добавить("");
	М.Добавить("Usage modes:");
	М.Добавить("1. Summary (root types): No parameters (filter/meta_type/name_mask not provided)");
	М.Добавить("   Returns:");
	М.Добавить("     - data: list of root metadata types with counts (Тип, Количество)");
	М.Добавить("     - configuration: configuration/platform info (when available) as a top-level field");
	М.Добавить("");
	М.Добавить("2. Filtered list: Use 'meta_type' and/or 'name_mask' parameters");
	М.Добавить("   Example: meta_type=""Документ"", name_mask=""реализ""");
	М.Добавить("   Returns: List of objects matching the criteria.");
	М.Добавить("   Each item includes: ПолноеИмя, Синоним.");
	М.Добавить("   List results are sorted by ПолноеИмя and support pagination via offset.");
	М.Добавить("   List mode response always includes pagination metadata:");
	М.Добавить("     - truncated, limit, returned, count, offset, has_more, next_offset");
	М.Добавить("   Fields truncated/has_more indicate whether more results exist.");
	М.Добавить("");
	М.Добавить("3. Detailed structure: Use 'filter' parameter with exact full name");
	М.Добавить("   Example: filter=""Справочник.Номенклатура""");
	М.Добавить("   Returns: Full structure with attributes, dimensions, resources, tabular sections");
	М.Добавить("");
	М.Добавить("3a. Specific collection element: Use 'filter' with full path to element");
	М.Добавить("   Collection names are in singular (platform ПолноеИмя() format):");
	М.Добавить("     filter=""Справочник.Контрагенты.Реквизит.ИНН""");
	М.Добавить("     filter=""РегистрНакопления.Остатки.Измерение.Номенклатура""");
	М.Добавить("     filter=""РегистрНакопления.Остатки.Ресурс.Количество""");
	М.Добавить("     filter=""Задача.Задача.РеквизитАдресации.Исполнитель""");
	М.Добавить("     filter=""Справочник.Контрагенты.СтандартныйРеквизит.Наименование""");
	М.Добавить("     filter=""Документ.Реализация.ТабличнаяЧасть.Товары""");
	М.Добавить("     filter=""Документ.Реализация.ТабличнаяЧасть.Товары.Реквизит.Номенклатура""");
	М.Добавить("   Use with sections=[""properties""] to get extended element properties");
	М.Добавить("   (ПроверкаЗаполнения, ЗначениеЗаполнения, Ведущее, Использование, etc.)");
	М.Добавить("");
	М.Добавить("4. Extensions support: Use 'extension_name' parameter");
	М.Добавить("   - extension_name not provided: work with main configuration (default)");
	М.Добавить("   - extension_name="""": get list of all connected extensions");
	М.Добавить("   - extension_name=""ExtensionName"": work with objects inside the specified extension");
	М.Добавить("");
	М.Добавить("5. Attribute search: Use 'attribute_mask' parameter");
	М.Добавить("   Find all attributes (реквизиты/измерения/ресурсы/реквизиты ТЧ) whose name or synonym");
	М.Добавить("   contains the given substring (case-insensitive).");
	М.Добавить("   Returns same list contract as mode 2: {success, data, truncated, limit, returned,");
	М.Добавить("     count, offset, has_more, next_offset}");
	М.Добавить("   data: array of {ПолноеИмя, Синоним} — same shape as list mode items, e.g.:");
	М.Добавить("     {ПолноеИмя: ""Документ.Реализация.Реквизит.Контрагент"", Синоним: ""Контрагент""}");
	М.Добавить("     {ПолноеИмя: ""Документ.Реализация.ТабличнаяЧасть.Товары.Реквизит.Номенклатура"", Синоним: ""Номенклатура""}");
	М.Добавить("   ПолноеИмя uses singular segment names: Реквизит/Измерение/Ресурс/ТабличнаяЧасть");
	М.Добавить("   Round-trip: get_metadata(filter=data[0][""ПолноеИмя""], sections=[""properties""])");
	М.Добавить("   Compatible with: meta_type, name_mask, filter (root object), extension_name (specific).");
	М.Добавить("   NOTE: extension_name="""" (list extensions) takes priority, attribute_mask is ignored.");
	М.Добавить("   INCOMPATIBLE with sections (returns error). Use round-trip instead.");
	М.Добавить("");
	М.Добавить("6. Paginated types of one typed field: filter + types_limit/types_offset");
	М.Добавить("    types_limit: Page size for the types page of one addressed typed field (default 100, max 200).");
	М.Добавить("    types_offset: Offset in the types list of one addressed typed field (default 0).");

	М.Добавить("   filter=""Справочник.Объект.Реквизит.Имя"" (or .Измерение/.Ресурс/.РеквизитАдресации/.СтандартныйРеквизит/.ТабличнаяЧасть...Реквизит)");
	М.Добавить("   returns: Тип (at most 20 type names, same rule as in structure) and data.types =");
	М.Добавить("   {count, limit, offset, returned, truncated, has_more, next_offset, items[]} with full type");
	М.Добавить("   strings including qualifiers. types.count is the total number of allowed types;");
	М.Добавить("   items are sorted deterministically (case-insensitive presentation order).");
	М.Добавить("   - Continue with types_offset=types.next_offset while types.has_more=true.");
	М.Добавить("   - Starting from types_offset=shown_types_count returns only the remaining types;");
	М.Добавить("     the union of pages plus already shown Тип prefixes is the complete list.");
	М.Добавить("   - Structure responses: if EVERY field of an array has <= 20 types, counter columns");
	М.Добавить("     are absent for all rows; if ANY field has more than 20, both columns are present");
	М.Добавить("     for ALL rows of that array (decision is per array: Реквизиты, each ТЧ, Измерения...).");
	М.Добавить("     Equal total_types_count == shown_types_count means the full list is already shown.");
	М.Добавить("   - types_limit/types_offset are FORBIDDEN for object/tabular-section structure requests");
	М.Добавить("     and incompatible with attribute_mask, meta_type, name_mask, extension_name="""".");
	М.Добавить("   - Existing limit/offset do NOT paginate types.");
	М.Добавить("");


	М.Добавить("Args:");
	М.Добавить("    ctx: MCP Context (injected automatically)");
	М.Добавить("    filter: Full name of object (e.g., ""Справочник.Номенклатура"") or full path to collection element");
	М.Добавить("           (e.g., ""Справочник.Контрагенты.Реквизит.ИНН"",");
	М.Добавить("           ""РегистрНакопления.Остатки.Измерение.Номенклатура"",");
	М.Добавить("           ""Документ.Реализация.ТабличнаяЧасть.Товары.Реквизит.Номенклатура"")");
	М.Добавить("    meta_type: Object type filter for list (string or list). Use ""*"" to list across all root types.");
	М.Добавить("    name_mask: Search mask for name/synonym (case-insensitive substring search)");
	М.Добавить("    limit: Maximum number of objects in list (default: 100, max: 1000)");
	М.Добавить("    sections: Detail sections to include (works only with filter). Supported: properties, forms, commands, layouts, predefined, movements, characteristics (movements is only available for Документ objects)");
	М.Добавить("    offset: Offset for pagination in list mode (default: 0)");
	М.Добавить("    extension_name: Extension name (None=main config, """"=list extensions, ""Name""=extension objects).");
	М.Добавить("                   Whitespace-only values are rejected.");
	М.Добавить("    attribute_mask: Search mask for attribute name/synonym (case-insensitive substring).");
	М.Добавить("                   Returns list of {ПолноеИмя, Синоним} items (same shape as list mode).");
	М.Добавить("                   ПолноеИмя uses singular segment names (Реквизит/Измерение/Ресурс/ТабличнаяЧасть), usable as filter value.");
	М.Добавить("                   Compatible with meta_type, name_mask, filter, extension_name.");
	М.Добавить("                   NOTE: extension_name="""" (list extensions) ignores attribute_mask.");
	М.Добавить("                   INCOMPATIBLE with sections (returns error). Round-trip:");
	М.Добавить("                     data[0][""ПолноеИмя""] → filter + sections=[""properties""].");
	М.Добавить("");
	М.Добавить("Returns:");
	М.Добавить("    Dictionary with:");
	М.Добавить("    - success: Boolean indicating if the request was successful");
	М.Добавить("     - data: Metadata information in JSON format:");
	М.Добавить("         - Summary: array data of {Тип, Количество} plus optional top-level field configuration");
	М.Добавить("         - List: array of {ПолноеИмя, Синоним}");
	М.Добавить("         - Details: object structure; sections like Реквизиты/ТабличныеЧасти/Измерения/Ресурсы may be omitted if not applicable for the metadata object type (if applicable, they are returned as arrays and may be empty)");
	М.Добавить("         - Extensions list: array of extension properties (ConfigurationExtension), e.g. {Имя, Синоним, Активно, БезопасныйРежим, Версия, УникальныйИдентификатор, Назначение, ОбластьДействия, ...}");
	М.Добавить("    - extension: Extension name (when working with extension objects)");
	М.Добавить("    - error: Error message (if failed)");
	М.Добавить("");
	М.Добавить("Examples:");
	М.Добавить("    # Get summary of root metadata types (counts)");
	М.Добавить("    get_metadata()");
	М.Добавить("");
	М.Добавить("    # Get only documents");
	М.Добавить("    get_metadata(meta_type=""Документ"")");
	М.Добавить("");
	М.Добавить("    # Search for objects with ""реализ"" in name (across all types)");
	М.Добавить("    get_metadata(name_mask=""реализ"")");
	М.Добавить("");
	М.Добавить("    # Get mixed list across all root types");
	М.Добавить("    get_metadata(meta_type=""*"", limit=50)");
	М.Добавить("");
	М.Добавить("    # Get details about a specific catalog");
	М.Добавить("    get_metadata(filter=""Справочник.Номенклатура"")");
	М.Добавить("");
	М.Добавить("    # Get extended properties of a specific attribute");
	М.Добавить("    get_metadata(filter=""Справочник.Контрагенты.Реквизит.ИНН"", sections=[""properties""])");
	М.Добавить("");
	М.Добавить("    # Get extended properties of a dimension");
	М.Добавить("    get_metadata(filter=""РегистрНакопления.Остатки.Измерение.Номенклатура"", sections=[""properties""])");
	М.Добавить("");
	М.Добавить("    # Get info about a tabular section with its attributes");
	М.Добавить("    get_metadata(filter=""Документ.Реализация.ТабличнаяЧасть.Товары"")");
	М.Добавить("");
	М.Добавить("    # Get extended properties of a tabular section attribute");
	М.Добавить("    get_metadata(filter=""Документ.Реализация.ТабличнаяЧасть.Товары.Реквизит.Номенклатура"", sections=[""properties""])");
	М.Добавить("");
	М.Добавить("    # Get extended properties of a standard attribute");
	М.Добавить("    get_metadata(filter=""Справочник.Контрагенты.СтандартныйРеквизит.Наименование"", sections=[""properties""])");
	М.Добавить("");
	М.Добавить("    # Get list of all connected extensions");
	М.Добавить("    get_metadata(extension_name="""")");
	М.Добавить("");
	М.Добавить("    # Get objects from a specific extension");
	М.Добавить("    get_metadata(extension_name=""MyExtension"", meta_type=""Справочник"")");
	М.Добавить("");
	М.Добавить("    # Get details about an object in extension");
