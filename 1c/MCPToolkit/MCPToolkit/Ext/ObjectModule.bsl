Функция ПолучитьПутьНаименованияПоТипамКолонки(Колонка)

	ТипыКолонки = ПолучитьМассивСтрокИзСвойства(Колонка, "types");
	Для Каждого ТипКолонки Из ТипыКолонки Цикл
		Если Лев(ТипКолонки, 17) = "СправочникСсылка." Тогда
			Возврат "Справочник." + Сред(ТипКолонки, 18) + ".Наименование";
		ИначеЕсли Лев(ТипКолонки, 15) = "ДокументСсылка." Тогда
			Возврат "Документ." + Сред(ТипКолонки, 16) + ".Наименование";
		ИначеЕсли Лев(ТипКолонки, 28) = "ПланВидовХарактеристикСсылка." Тогда
			Возврат "ПланВидовХарактеристик." + Сред(ТипКолонки, 29) + ".Наименование";
		ИначеЕсли Лев(ТипКолонки, 18) = "ПланСчетовСсылка." Тогда
			Возврат "ПланСчетов." + Сред(ТипКолонки, 19) + ".Наименование";
		ИначеЕсли Лев(ТипКолонки, 22) = "ПланВидовРасчетаСсылка." Тогда
			Возврат "ПланВидовРасчета." + Сред(ТипКолонки, 23) + ".Наименование";
		ИначеЕсли Лев(ТипКолонки, 20) = "БизнесПроцессСсылка." Тогда
			Возврат "БизнесПроцесс." + Сред(ТипКолонки, 21) + ".Наименование";
		ИначеЕсли Лев(ТипКолонки, 13) = "ЗадачаСсылка." Тогда
			Возврат "Задача." + Сред(ТипКолонки, 14) + ".Наименование";
		ИначеЕсли Лев(ТипКолонки, 17) = "ПланОбменаСсылка." Тогда
			Возврат "ПланОбмена." + Сред(ТипКолонки, 18) + ".Наименование";
		КонецЕсли;
	КонецЦикла;

	Возврат "";

