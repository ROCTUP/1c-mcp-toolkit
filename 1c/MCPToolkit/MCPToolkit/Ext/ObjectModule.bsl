Функция СформироватьСодержимоеToolsCall(Результат, ДанныеУжеПодготовлены = Ложь) Экспорт

	Содержимое = Новый Массив;
	Элемент = Новый Структура;
	Элемент.Вставить("type", "text");

	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("success") Тогда
		Если Результат.success Тогда
			// Специальная обработка: результат — изображение
			Если Результат.Свойство("image_base64")
				И ЗначениеЗаполнено(Результат.image_base64) Тогда
				ЭлемИзобр = Новый Структура;
				ЭлемИзобр.Вставить("type", "image");
				ЭлемИзобр.Вставить("data", Результат.image_base64);
				ЭлемИзобр.Вставить("mimeType", "image/png");
				Содержимое.Добавить(ЭлемИзобр);
				Если Результат.Свойство("base") Тогда
					Содержимое.Добавить(Новый Структура("type,text", "text", ЗаписатьJSON2(Новый Структура("base", Результат.base))));
				КонецЕсли;
				Если Результат.Свойство("window_rect") И Результат.window_rect <> Неопределено Тогда
					ЭлемРект = Новый Структура;
					ЭлемРект.Вставить("type", "text");
					ЭлемРект.Вставить("text", ЗаписатьJSON2(Результат.window_rect));
					Содержимое.Добавить(ЭлемРект);
				КонецЕсли;
				Если Результат.Свойство("grid_coords") И Результат.grid_coords <> Неопределено Тогда
					ЭлемГрид = Новый Структура;
					ЭлемГрид.Вставить("type", "text");
					ЭлемГрид.Вставить("text", ЗаписатьJSON2(Результат.grid_coords));
					Содержимое.Добавить(ЭлемГрид);
				КонецЕсли;
				// Слои и полнота кадра едут одним текстовым блоком: полнота без списка отказов
				// бесполезна, а список слоёв без полноты не говорит, весь ли кадр перед агентом.
				Если Результат.Свойство("overlays") И Результат.overlays <> Неопределено Тогда
					БлокСлоёв = Новый Структура;
					БлокСлоёв.Вставить("overlays", Результат.overlays);
					Если Результат.Свойство("capture_complete") И Результат.capture_complete <> Неопределено Тогда
						БлокСлоёв.Вставить("capture_complete", Результат.capture_complete);
					КонецЕсли;
					Если Результат.Свойство("overlay_failures") И Результат.overlay_failures <> Неопределено Тогда
						БлокСлоёв.Вставить("overlay_failures", Результат.overlay_failures);
					КонецЕсли;
					Если Результат.Свойство("foreground_window") И Результат.foreground_window <> Неопределено Тогда
						БлокСлоёв.Вставить("foreground_window", Результат.foreground_window);
					КонецЕсли;
					ЭлемСлои = Новый Структура;
					ЭлемСлои.Вставить("type", "text");
					ЭлемСлои.Вставить("text", ЗаписатьJSON2(БлокСлоёв));
					Содержимое.Добавить(ЭлемСлои);
				КонецЕсли;
				Возврат Новый Структура("content", Содержимое);
			КонецЕсли;
			// Собираем полную структуру через whitelist — аналогично ОтправитьРезультатНаСервер()
			Если ДанныеУжеПодготовлены Тогда
				РезультатДляВывода = Результат;
			Иначе
				РезультатДляВывода = ПодготовитьДанныеУспешногоToolsCall(Результат);
			КонецЕсли;


			Элемент.Вставить("text", ЗаписатьJSON2(РезультатДляВывода));
			Содержимое.Добавить(Элемент);
		Иначе
			// Application-level ошибка: возвращаем JSON-объект без isError (как в прокси)
			РезультатОшибки = Новый Структура("success", Ложь);
			Если Результат.Свойство("base") Тогда РезультатОшибки.Вставить("base", Результат.base); КонецЕсли;
			Если Результат.Свойство("error") Тогда
				РезультатОшибки.Вставить("error", Результат.error);
			КонецЕсли;
			Если Результат.Свойство("dangerous_keywords") Тогда
				РезультатОшибки.Вставить("dangerous_keywords", Результат.dangerous_keywords);
			КонецЕсли;
			Элемент.Вставить("text", ЗаписатьJSON2(РезультатОшибки));
			Содержимое.Добавить(Элемент);
		КонецЕсли;
	Иначе
		Элемент.Вставить("text", ЗаписатьJSON2(Результат));
		Содержимое.Добавить(Элемент);
	КонецЕсли;

	Возврат Новый Структура("content", Содержимое);

КонецФункции

Процедура ПодготовитьЗащищенныйПакетRegex(РегексКонтекст) Экспорт
	Если РегексКонтекст.Свойство("УчасткиRegex") Тогда Возврат; КонецЕсли;
	Тексты = ПрочитатьJSON2(РегексКонтекст.ТекстыJSON);
	Если ТипЗнч(Тексты) <> Тип("Массив") Тогда ВызватьИсключение "Некорректный пакет текстов Regex"; КонецЕсли;
	Участки = Новый Массив;
	Карта = Новый Массив;
	Для ИндексТекста = 0 По Тексты.Количество() - 1 Цикл
		Текст = Тексты[ИндексТекста];
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда ВызватьИсключение "Некорректный текст Regex"; КонецЕсли;
		Диапазоны = ЗащищенныеДиапазоныАнонимизации(Текст);
		Диапазоны.Добавить(Новый Структура("Начало,Конец", СтрДлина(Текст) + 1, СтрДлина(Текст)));
		Начало = 1;
		Для Каждого Диапазон Из Диапазоны Цикл
			Если Диапазон.Начало > Начало Тогда
				Участки.Добавить(Сред(Текст, Начало, Диапазон.Начало - Начало));
				Карта.Добавить(Новый Структура("ИндексТекста,Смещение", ИндексТекста, Начало - 1));
			КонецЕсли;
			Начало = Диапазон.Конец + 1;
		КонецЦикла;
	КонецЦикла;
	РегексКонтекст.Вставить("ИсходныеТекстыRegex", Тексты);
	РегексКонтекст.Вставить("УчасткиRegex", Участки);
	РегексКонтекст.Вставить("КартаУчастковRegex", Карта);
	РегексКонтекст.Вставить("ТекстыКомпонентыJSON", ЗаписатьJSON2(Участки));
КонецПроцедуры

Функция ВосстановитьСовпаденияRegex(СовпаденияJSON, РегексКонтекст)
	Если НЕ РегексКонтекст.Свойство("УчасткиRegex") Тогда Возврат СовпаденияJSON; КонецЕсли;
	Если РегексКонтекст.Свойство("ВосстановленныеСовпаденияRegex") Тогда
		Если СовпаденияJSON <> РегексКонтекст.ОтветКомпонентыRegex Тогда ВызватьИсключение "Повторный ответ Regex отличается"; КонецЕсли;
		Возврат РегексКонтекст.ВосстановленныеСовпаденияRegex;
	КонецЕсли;
	Ответ = ПрочитатьJSON2(СовпаденияJSON);
	Если ТипЗнч(Ответ) <> Тип("Массив") Тогда ВызватьИсключение "Некорректный ответ Regex"; КонецЕсли;
	Если Ответ.Количество() <> РегексКонтекст.УчасткиRegex.Количество() Тогда ВызватьИсключение "Неполный ответ Regex"; КонецЕсли;
	ПоТекстам = Новый Массив;
	Для Каждого Текст Из РегексКонтекст.ИсходныеТекстыRegex Цикл ПоТекстам.Добавить(Новый Массив); КонецЦикла;
	Для ИндексУчастка = 0 По Ответ.Количество() - 1 Цикл
		Совпадения = Ответ[ИндексУчастка];
		Если ТипЗнч(Совпадения) <> Тип("Массив") Тогда ВызватьИсключение "Некорректные совпадения Regex"; КонецЕсли;
		Участок = РегексКонтекст.УчасткиRegex[ИндексУчастка];
		Карта = РегексКонтекст.КартаУчастковRegex[ИндексУчастка];
		Для Каждого Совпадение Из Совпадения Цикл
			Если ТипЗнч(Совпадение) <> Тип("Структура") Тогда ВызватьИсключение "Некорректное совпадение Regex"; КонецЕсли;
			Начало = Неопределено; Длина = Неопределено; ТекстСовпадения = Неопределено; Категория = Неопределено;
			Если НЕ Совпадение.Свойство("start", Начало) Или НЕ Совпадение.Свойство("length", Длина)
				Или НЕ Совпадение.Свойство("match", ТекстСовпадения) Или НЕ Совпадение.Свойство("category", Категория) Тогда ВызватьИсключение "Неполное совпадение Regex"; КонецЕсли;
			Если ТипЗнч(Начало) <> Тип("Число") Или ТипЗнч(Длина) <> Тип("Число")
				Или ТипЗнч(ТекстСовпадения) <> Тип("Строка") Или ТипЗнч(Категория) <> Тип("Строка") Тогда ВызватьИсключение "Неверные типы совпадения Regex"; КонецЕсли;
			Если Начало < 0 Или Длина < 0 Или Начало <> Цел(Начало) Или Длина <> Цел(Длина)
				Или Начало + Длина > СтрДлина(Участок) Тогда ВызватьИсключение "Неверные координаты Regex"; КонецЕсли;
			Если Сред(Участок, Начало + 1, Длина) <> ТекстСовпадения Тогда ВызватьИсключение "Текст Regex не совпадает"; КонецЕсли;
			Если Длина = 0 Тогда Продолжить; КонецЕсли;
			Новое = Новый Структура("start,length,match,category", Начало + Карта.Смещение, Длина, ТекстСовпадения, Категория);
			МассивТекста = ПоТекстам[Карта.ИндексТекста];
			ИндексВставки = 0;
			Пока ИндексВставки < МассивТекста.Количество() И МассивТекста[ИндексВставки].start > Новое.start Цикл ИндексВставки = ИндексВставки + 1; КонецЦикла;
			МассивТекста.Вставить(ИндексВставки, Новое);
		КонецЦикла;
	КонецЦикла;
	РезультатJSON = ЗаписатьJSON2(ПоТекстам);
	РегексКонтекст.Вставить("ОтветКомпонентыRegex", СовпаденияJSON);
	РегексКонтекст.Вставить("ВосстановленныеСовпаденияRegex", РезультатJSON);
	Возврат РезультатJSON;
КонецФункции

Функция НайтиСовпаденияRegexСЗащитой(КомпонентаПоиска, ПравилаJSON, ТекстыJSON) Экспорт
	Пакет = Новый Структура("ТекстыJSON", ТекстыJSON);
	ПодготовитьЗащищенныйПакетRegex(Пакет);
	Если Пакет.УчасткиRegex.Количество() = 0 Тогда
		Ответ = "[]";
	Иначе
		Ответ = КомпонентаПоиска.FindMatchesInTexts(ПравилаJSON, Пакет.ТекстыКомпонентыJSON);
	КонецЕсли;
	Возврат ВосстановитьСовпаденияRegex(Ответ, Пакет);
КонецФункции

Функция ПрименитьРезультатRegex(КонтекстРантайма, СовпаденияJSON, РегексКонтекст) Экспорт
	Попытка
		Если РегексКонтекст.Свойство("ОшибкаПодготовкиRegex") Тогда ВызватьИсключение "Ошибка подготовки пакета Regex"; КонецЕсли;
		СовпаденияJSON = ВосстановитьСовпаденияRegex(СовпаденияJSON, РегексКонтекст);
		ЭтоОбъект = Ложь;
		РегексКонтекст.Свойство("ЭтоОбъект", ЭтоОбъект);
		ЭтоFindReferences = Ложь;
		РегексКонтекст.Свойство("ЭтоFindReferences", ЭтоFindReferences);
		ЭтоGetEventLog = Ложь;
		РегексКонтекст.Свойство("ЭтоGetEventLog", ЭтоGetEventLog);
		ЭтоExecuteCode = Ложь;
		РегексКонтекст.Свойство("ЭтоExecuteCode", ЭтоExecuteCode);
		Если ЭтоGetEventLog = Истина Тогда
			ПрименитьRegexТокеныGetEventLog(КонтекстРантайма, РегексКонтекст, СовпаденияJSON);
		ИначеЕсли ЭтоFindReferences = Истина Тогда
			ПрименитьRegexТокеныFindReferences(КонтекстРантайма, РегексКонтекст, СовпаденияJSON);
		ИначеЕсли ЭтоОбъект = Истина Тогда
			ПрименитьRegexТокеныОбъект(КонтекстРантайма, РегексКонтекст, СовпаденияJSON);
		ИначеЕсли ЭтоExecuteCode = Истина Тогда
			ПрименитьRegexТокеныExecuteCode(КонтекстРантайма, РегексКонтекст, СовпаденияJSON);
		Иначе
			ПрименитьRegexТокены(КонтекстРантайма, РегексКонтекст, СовпаденияJSON);
		КонецЕсли;
	Исключение
		РезультатОшибки = Новый Структура("success, error", Ложь,
			"Ошибка применения Regex-анонимизации. Результат не передан.");
		РегексКонтекст.Вставить("Результат", РезультатОшибки);
		КонтекстLineage = Неопределено;
		Если РегексКонтекст.Свойство("КонтекстLineage", КонтекстLineage)
			И КонтекстLineage <> Неопределено Тогда
			// Продолжение отправляет результат из транспортного контекста.
			КонтекстLineage.Вставить("Результат", РезультатОшибки);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

Функция ПолучитьЗначениеОбъекта(Объект, Ключ) Экспорт
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Зн = Неопределено;
		Объект.Свойство(Ключ, Зн);
		Возврат Зн;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект[Ключ];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ТокенЗапросаРазрешен(ДанныеЗапроса, ОжидаемыйТокен) Экспорт

	Токен = СокрЛП(ОжидаемыйТокен);
	Если ПустаяСтрока(Токен) Тогда
		Возврат Истина; // аутентификация выключена
	КонецЕсли;

	// /health оставляем открытым для liveness-проверок
	Путь = "";
	ДанныеЗапроса.Свойство("path", Путь);
	Если Путь = "/health" Тогда
		Возврат Истина;
	КонецЕсли;

	// headers — объект с ключами в нижнем регистре. ПрочитатьJSON2 может вернуть
	// как Соответствие, так и Структура (если все имена заголовков — валидные
	// идентификаторы), поэтому читаем через ПолучитьЗначениеОбъекта, который
	// безопасно обрабатывает оба типа (иначе headers["authorization"] на Структуре
	// без такого свойства бросает исключение вместо возврата Неопределено).
	Значение = "";
	Если ДанныеЗапроса.Свойство("headers") И ДанныеЗапроса.headers <> Неопределено Тогда
		Вход = ПолучитьЗначениеОбъекта(ДанныеЗапроса.headers, "authorization");
		Если Вход <> Неопределено Тогда
			Значение = СокрЛП(Вход);
		КонецЕсли;
	КонецЕсли;

	// Схема Bearer нечувствительна к регистру, токен сверяем точно
	Если Лев(НРег(Значение), 7) = "bearer " Тогда
		Если СокрЛП(Сред(Значение, 8)) = Токен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;
КонецФункции

Функция РазобратьMCPPost(КонтекстРантайма, ДанныеЗапроса) Экспорт
	Разбор = Новый Структура("Ошибка,ТелоJSON,Метод,Ид,ЭтоЗапрос", Неопределено, Неопределено, Неопределено, Неопределено, Ложь);

	// 1. Content-Type
	КонтентТип = ДанныеЗапроса.headers["content-type"];
	Если КонтентТип = Неопределено
		ИЛИ НЕ (Лев(НРег(КонтентТип), 16) = "application/json") Тогда
		Разбор.Ошибка = Новый Структура("Статус,Сообщение,Код", 415, "Unsupported Media Type: Content-Type must be application/json", -32600);
		Возврат Разбор;
	КонецЕсли;

	// 2. Accept: оба application/json И text/event-stream
	Разбор.Ошибка = ОшибкаAcceptPOST(ДанныеЗапроса);
	Если Разбор.Ошибка <> Неопределено Тогда Возврат Разбор; КонецЕсли;

	// 4. Парсинг JSON body
	Попытка
		ТелоJSON = ПрочитатьJSON2(ДанныеЗапроса.body);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Разбор.Ошибка = Новый Структура("Статус,Сообщение,Код", 400, "Parse error: " + ТекстОшибки, -32700);
		Возврат Разбор;
	КонецПопытки;

	Если ТипЗнч(ТелоJSON) <> Тип("Структура") Тогда
		Разбор.Ошибка = Новый Структура("Статус,Сообщение,Код", 400, "Validation error: JSON body must be an object", -32602);
		Возврат Разбор;
	КонецЕсли;

	Разбор.ТелоJSON = ТелоJSON;
	ЕстьМетод = ТелоJSON.Свойство("method", Разбор.Метод);
	ЕстьИд = ТелоJSON.Свойство("id", Разбор.Ид) И (Разбор.Ид <> Null);
	Разбор.ЭтоЗапрос = ЕстьМетод И ЕстьИд;
	Если НЕ Разбор.ЭтоЗапрос Или Разбор.Метод <> "initialize" Тогда
		Разбор.Ошибка = ОшибкаПротоколВерсию(ДанныеЗапроса);
		Если Разбор.Ошибка = Неопределено Тогда
			Разбор.Ошибка = ОшибкаСессию(КонтекстРантайма, ДанныеЗапроса);
		КонецЕсли;
	КонецЕсли;
	Возврат Разбор;
КонецФункции

Функция ПостроитьИндексПравилТочнойАнонимизации(СтрокиПравил) Экспорт

	СоответствиеПравил = Новый Соответствие;
	ИсходныеПути = Новый Соответствие;
	Для Каждого СтрокаПравила Из СтрокиПравил Цикл
		ПутьИсточника = "";
		Action = "";
		КатегорияТокена = "";
		Попытка ПутьИсточника = СтрокаПравила.source_path; Исключение КонецПопытки;
		Попытка Action = СтрокаПравила.action; Исключение КонецПопытки;
		Попытка КатегорияТокена = СтрокаПравила.token_category; Исключение КонецПопытки;
		Если КатегорияТокена = Неопределено Тогда КатегорияТокена = ""; КонецЕсли;
		Если ПустаяСтрока(ПутьИсточника) Тогда Продолжить; КонецЕсли;
		КлючПути = НормализоватьКлючПутиАнонимизации(ПутьИсточника);
		ИмеющеесяПравило = СоответствиеПравил.Получить(КлючПути);
		Если ИмеющеесяПравило <> Неопределено Тогда
			Если ИмеющеесяПравило.action <> Action Или ИмеющеесяПравило.token_category <> КатегорияТокена Тогда
				ВызватьИсключение "MCP_EXACT_RULE_CONFLICT: конфликт правил точной анонимизации: "
					+ ИсходныеПути.Получить(КлючПути) + " / " + ПутьИсточника;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		СоответствиеПравил.Вставить(КлючПути, Новый Структура("action, token_category", Action, КатегорияТокена));
		ИсходныеПути.Вставить(КлючПути, ПутьИсточника);
	КонецЦикла;
	Возврат СоответствиеПравил;

КонецФункции

Функция ПодготовитьЗапросСправкиBSL(КонтекстРантайма, ЗапросBSL)
	Подготовка = Новый Структура("Ошибка, КлючевыеСловаJSON, РежимВсе, Лимит, Смещение, НомерСтраницыКонтента",
		Неопределено, "", Ложь, 100, 0, 1);

	Если КонтекстРантайма.КомпонентаSyntaxHelp = Неопределено Тогда
		Подготовка.Ошибка = Новый Структура("success,error", Ложь, "SyntaxHelpReader не загружен");
		Возврат Подготовка;
	КонецЕсли;

	Если ЗапросBSL = Неопределено ИЛИ ТипЗнч(ЗапросBSL) <> Тип("Структура") Тогда
		Подготовка.Ошибка = Новый Структура("success,error", Ложь, "params must be an object");
		Возврат Подготовка;
	КонецЕсли;

	// Валидация keywords
	КлючевыеСлова = Неопределено;
	Если ЗапросBSL.Свойство("keywords") Тогда
		КлючевыеСлова = ЗапросBSL.keywords;
	КонецЕсли;
	Если НЕ (ТипЗнч(КлючевыеСлова) = Тип("Массив") ИЛИ ТипЗнч(КлючевыеСлова) = Тип("ФиксированныйМассив")) ИЛИ КлючевыеСлова.Количество() = 0 Тогда
		Подготовка.Ошибка = Новый Структура("success,error", Ложь, "keywords: must be non-empty array");
		Возврат Подготовка;
	КонецЕсли;
	ОчищенныеКлючи = Новый Массив;
	Для Каждого КС Из КлючевыеСлова Цикл
		Если ТипЗнч(КС) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(КС)) Тогда
			ОчищенныеКлючи.Добавить(СокрЛП(КС));
		КонецЕсли;
	КонецЦикла;
	Если ОчищенныеКлючи.Количество() = 0 Тогда
		Подготовка.Ошибка = Новый Структура("success,error", Ложь, "keywords: must contain at least one non-empty string");
		Возврат Подготовка;
	КонецЕсли;
	КлючевыеСлова = ОчищенныеКлючи;

	// Валидация match
	РежимСтрока = "all";
	Если ЗапросBSL.Свойство("match") И ЗначениеЗаполнено(ЗапросBSL.match) Тогда
		Если ЗапросBSL.match = "all" ИЛИ ЗапросBSL.match = "any" Тогда
			РежимСтрока = ЗапросBSL.match;
		Иначе
			Подготовка.Ошибка = Новый Структура("success,error", Ложь, "match: must be 'all' or 'any'");
			Возврат Подготовка;
		КонецЕсли;
	КонецЕсли;
	Подготовка.РежимВсе = (РежимСтрока = "all");

	Подготовка.КлючевыеСловаJSON = ЗаписатьJSON2(КлючевыеСлова);

	// Читаем limit/offset/content_page с дефолтами (нормализатор не всегда вызывается — в proxy-режиме нет)
	Если ЗапросBSL.Свойство("limit") И ТипЗнч(ЗапросBSL.limit) = Тип("Число") И ЗапросBSL.limit >= 1 Тогда
		Подготовка.Лимит = Цел(ЗапросBSL.limit);
	КонецЕсли;
	Если ЗапросBSL.Свойство("offset") И ТипЗнч(ЗапросBSL.offset) = Тип("Число") И ЗапросBSL.offset >= 0 Тогда
		Подготовка.Смещение = Цел(ЗапросBSL.offset);
	КонецЕсли;
	Если ЗапросBSL.Свойство("content_page") И ТипЗнч(ЗапросBSL.content_page) = Тип("Число")
		И ЗапросBSL.content_page >= 1 Тогда
		Подготовка.НомерСтраницыКонтента = Цел(ЗапросBSL.content_page);
	КонецЕсли;

	Возврат Подготовка;
КонецФункции

Функция СформироватьРезультатСправкиBSL(РезультатJSON, Подготовка)
	Если НЕ ЗначениеЗаполнено(РезультатJSON) Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Пустой ответ компоненты SyntaxHelpReader");
	КонецЕсли;

	// ПрочитатьJSON2 принимает строку напрямую и возвращает Структура,
	// т.к. оба ключа JSON ("candidates", "content") — валидные идентификаторы 1C
	Данные = Неопределено;
	Попытка
		Данные = ПрочитатьJSON2(РезультатJSON);
	Исключение
		Возврат Новый Структура("success,error", Ложь,
			"Неожиданный ответ компоненты SyntaxHelpReader: не разобрался JSON");
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Структура") ИЛИ НЕ Данные.Свойство("candidates") Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Неожиданный ответ компоненты SyntaxHelpReader: нет массива candidates");
	КонецЕсли;

	Если ТипЗнч(Данные.candidates) <> Тип("Массив") Или НЕ Данные.Свойство("content") Тогда
		Возврат Новый Структура("success,error", Ложь, "Некорректные поля ответа SyntaxHelpReader");
	КонецЕсли;
	Если ТипЗнч(Данные.content) <> Тип("Строка") И ТипЗнч(Данные.content) <> Тип("Null") Тогда
		Возврат Новый Структура("success,error", Ложь, "Некорректный content SyntaxHelpReader");
	КонецЕсли;
	Для Каждого Кандидат Из Данные.candidates Цикл
		Если ТипЗнч(Кандидат) <> Тип("Строка") Тогда
			Возврат Новый Структура("success,error", Ложь, "Некорректный кандидат SyntaxHelpReader");
		КонецЕсли;
	КонецЦикла;

	// Применяем пагинацию к массиву кандидатов
	ВсеКандидаты = Данные.candidates;
	Лимит = Подготовка.Лимит;
	Смещение = Подготовка.Смещение;

	Итого = ВсеКандидаты.Количество();
	СтраницаКандидатов = Новый Массив;
	ИндексКонца = Мин(Смещение + Лимит, Итого);
	Для Инд = Смещение По ИндексКонца - 1 Цикл
		СтраницаКандидатов.Добавить(ВсеКандидаты[Инд]);
	КонецЦикла;

	ЕстьЕще = (Смещение + Лимит) < Итого;

	// Подавляем content при offset > 0
	Контент = Данные.content;
	Если Смещение > 0 Тогда
		Контент = Null;
	КонецЕсли;

	НомерСтраницыКонтента = Подготовка.НомерСтраницыКонтента;

	// Локальные переменные для полей ответа (заполняются только если Контент не Null)
	КонтентФактНомер = Неопределено;
	КонтентВсегоСтраниц = Неопределено;
	КонтентЕстьЕще = Неопределено;

	Если ЗначениеЗаполнено(Контент) И ТипЗнч(Контент) = Тип("Строка") Тогда
		РазмерСтраницыКонтента = 4000; // фиксирован, агент не управляет
		МассивСтраниц = Новый Массив;
		ТекущаяСтраница = "";

		// Разбиваем на строки вручную (СтрРазделить недоступна в режиме совместимости)
		// Логика эквивалентна РазделитьСтрокуПоРазделителю, но inline на клиенте.
		// Пустые строки сохраняются — важно для Markdown (разрывы абзацев, code blocks).
		МассивСтрок = Новый Массив;
		ОстатокКонтента = Контент;
		ПозПС = Найти(ОстатокКонтента, Символы.ПС);
		Пока ПозПС > 0 Цикл
			МассивСтрок.Добавить(Лев(ОстатокКонтента, ПозПС - 1));
			ОстатокКонтента = Сред(ОстатокКонтента, ПозПС + 1);
			ПозПС = Найти(ОстатокКонтента, Символы.ПС);
		КонецЦикла;
		МассивСтрок.Добавить(ОстатокКонтента);

		Для Каждого Строка Из МассивСтрок Цикл
			// Страница непустая И добавление строки превысит лимит → фиксируем страницу
			// Исключение: страница пустая (строка длиннее лимита) — всё равно добавляем
			Если ЗначениеЗаполнено(ТекущаяСтраница)
				И (СтрДлина(ТекущаяСтраница) + СтрДлина(Строка) + 1) > РазмерСтраницыКонтента Тогда
				// Убираем синтетический завершающий Символы.ПС (не СокрП — она портит Markdown)
				ЗафиксированнаяСтраница = ТекущаяСтраница;
				Если Прав(ЗафиксированнаяСтраница, 1) = Символы.ПС Тогда
					ЗафиксированнаяСтраница = Лев(ЗафиксированнаяСтраница, СтрДлина(ЗафиксированнаяСтраница) - 1);
				КонецЕсли;
				МассивСтраниц.Добавить(ЗафиксированнаяСтраница);
				ТекущаяСтраница = Строка + Символы.ПС;
			Иначе
				ТекущаяСтраница = ТекущаяСтраница + Строка + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		// Последняя страница
		Если ЗначениеЗаполнено(ТекущаяСтраница) Тогда
			ЗафиксированнаяСтраница = ТекущаяСтраница;
			Если Прав(ЗафиксированнаяСтраница, 1) = Символы.ПС Тогда
				ЗафиксированнаяСтраница = Лев(ЗафиксированнаяСтраница, СтрДлина(ЗафиксированнаяСтраница) - 1);
			КонецЕсли;
			МассивСтраниц.Добавить(ЗафиксированнаяСтраница);
		КонецЕсли;

		КонтентВсегоСтраниц = Макс(МассивСтраниц.Количество(), 1);
		КонтентФактНомер = Мин(НомерСтраницыКонтента, КонтентВсегоСтраниц);
		КонтентЕстьЕще = КонтентФактНомер < КонтентВсегоСтраниц;
		Контент = МассивСтраниц[КонтентФактНомер - 1]; // обновляем Контент нужной страницей
	КонецЕсли;

	РезультатДанные = Новый Структура;
	РезультатДанные.Вставить("candidates", СтраницаКандидатов);
	РезультатДанные.Вставить("total", Итого);
	РезультатДанные.Вставить("offset", Смещение);
	РезультатДанные.Вставить("limit", Лимит);
	РезультатДанные.Вставить("has_more", ЕстьЕще);
	РезультатДанные.Вставить("content", Контент);
	Если КонтентФактНомер <> Неопределено Тогда
		РезультатДанные.Вставить("content_page", КонтентФактНомер);
		РезультатДанные.Вставить("content_total_pages", КонтентВсегоСтраниц);
		РезультатДанные.Вставить("content_has_more", КонтентЕстьЕще);
	КонецЕсли;

	Возврат Новый Структура("success,data", Истина, РезультатДанные);
КонецФункции

Функция ПолучитьСправкуПоBSL(КонтекстРантайма, ЗапросBSL) Экспорт
	Подготовка = ПодготовитьЗапросСправкиBSL(КонтекстРантайма, ЗапросBSL);
	Если Подготовка.Ошибка <> Неопределено Тогда
		Возврат Подготовка.Ошибка;
	КонецЕсли;

	РезультатJSON = КонтекстРантайма.КомпонентаSyntaxHelp.Поиск(Подготовка.КлючевыеСловаJSON, Подготовка.РежимВсе);

	Возврат СформироватьРезультатСправкиBSL(РезультатJSON, Подготовка);
КонецФункции

Функция ПостроитьСловарьАнонимизацииПоПравилам(ПравилаСловаря, ПрерыватьПриОшибке = Ложь) Экспорт

	Результат = Новый Массив;
	ЛогСловаря = Новый Массив;
	Для Каждого СтрокаПравила Из ПравилаСловаря Цикл

		ИспользоватьДляСловаря = Ложь;
		Попытка
			ИспользоватьДляСловаря = СтрокаПравила.use_for_dictionary;
		Исключение КонецПопытки;
		Если НЕ ИспользоватьДляСловаря Тогда
			Продолжить;
		КонецЕсли;

		ДействиеПравила = Неопределено;
		Попытка ДействиеПравила = СтрокаПравила.action; Исключение КонецПопытки;
		Если ДействиеПравила <> Неопределено И ДействиеПравила <> "anonymize" Тогда Продолжить; КонецЕсли;

		ПутьИсточника = "";
		КатегорияПравила = "";
		Попытка
			ПутьИсточника = СтрокаПравила.source_path;
		Исключение КонецПопытки;
		Попытка
			КатегорияПравила = СтрокаПравила.token_category;
		Исключение КонецПопытки;
		Если КатегорияПравила = Неопределено Тогда КатегорияПравила = ""; КонецЕсли;

		Если ПустаяСтрока(ПутьИсточника) Тогда
			ЛогСловаря.Добавить("Словарь: правило пропущено — пустой source_path");
			Продолжить;
		КонецЕсли;

		Сегменты = РазложитьПутьНаСегменты(ПутьИсточника);
		Если Сегменты.Количество() <> 3 Тогда
			Если ПрерыватьПриОшибке Тогда ВызватьИсключение "Для словаря требуется путь Объект.Имя.Реквизит: " + ПутьИсточника; КонецЕсли;
			ЛогСловаря.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — ожидается 3 сегмента, найдено " + Сегменты.Количество());
			Продолжить;
		КонецЕсли;

		ИмяОбъекта = Сегменты[0] + "." + Сегменты[1];
		ИмяПоля    = Сегменты[2];

		ОбъектМД = Неопределено;
		Попытка
			ОбъектМД = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		Исключение
			Если ПрерыватьПриОшибке Тогда ВызватьИсключение; КонецЕсли;
		КонецПопытки;
		Если ОбъектМД = Неопределено Тогда
			ЛогСловаря.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — объект метаданных '" + ИмяОбъекта + "' не найден");
			Продолжить;
		КонецЕсли;

		РеквизитМД = НайтиРеквизитВКоллекциях(ОбъектМД, ИмяПоля);
		Если РеквизитМД = Неопределено Тогда
			ЛогСловаря.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — реквизит '" + ИмяПоля + "' не найден в метаданных");
			Продолжить;
		КонецЕсли;

		ЕстьСтрока = Ложь;
		Попытка
			Для Каждого ТипПоля Из РеквизитМД.Тип.Типы() Цикл
				Если ТипПоля = Тип("Строка") Тогда
					ЕстьСтрока = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение КонецПопытки;
		Если НЕ ЕстьСтрока Тогда
			ЛогСловаря.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — поле не является строковым");
			Продолжить;
		КонецЕсли;

		КатегорияТокена = КатегорияПравила;
		Если ПустаяСтрока(КатегорияТокена) Тогда
			КатегорияТокена = ОпределитьКатегориюТокена(ПутьИсточника);
		КонецЕсли;

		КоличествоДоЗапроса = Результат.Количество();
		Попытка
			ЗапросТекст = ТекстЗапросаСловаряАнонимизации(ОбъектМД.ПолноеИмя(), РеквизитМД.Имя);
			ЗапросОбъект = Новый Запрос(ЗапросТекст);
			ВыборкаЗапроса = ЗапросОбъект.Выполнить().Выбрать();
			Пока ВыборкаЗапроса.Следующий() Цикл
				ЗначениеОриг = СокрЛП(ВыборкаЗапроса.Значение);
				Если ТипЗнч(ЗначениеОриг) <> Тип("Строка") Тогда
					Продолжить;
				КонецЕсли;
				Если СтрДлина(ЗначениеОриг) < 3 Тогда
					Продолжить;
				КонецЕсли;
				Запись = Новый Структура;
				Запись.Вставить("ЗначениеОриг",   ЗначениеОриг);
				Запись.Вставить("ЗначениеНижний", НРег(ЗначениеОриг));
				Запись.Вставить("Категория",      КатегорияТокена);
				Запись.Вставить("Длина",          СтрДлина(ЗначениеОриг));
				Результат.Добавить(Запись);
			КонецЦикла;
			ЛогСловаря.Добавить("Словарь [" + ПутьИсточника + "]: добавлено " + (Результат.Количество() - КоличествоДоЗапроса) + " значений");
		Исключение
			Если ПрерыватьПриОшибке Тогда ВызватьИсключение; КонецЕсли;
			ЛогСловаря.Добавить("Словарь [" + ПутьИсточника + "]: ошибка запроса — " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	// Сортировка по убыванию длины (сервер — ТаблицаЗначений доступна)
	ТаблицаВрем = Новый ТаблицаЗначений;
	ТаблицаВрем.Колонки.Добавить("Длина",          Новый ОписаниеТипов("Число"));
	ТаблицаВрем.Колонки.Добавить("ЗначениеОриг",   Новый ОписаниеТипов("Строка"));
	ТаблицаВрем.Колонки.Добавить("ЗначениеНижний", Новый ОписаниеТипов("Строка"));
	ТаблицаВрем.Колонки.Добавить("Категория",      Новый ОписаниеТипов("Строка"));
	Для Каждого Запись Из Результат Цикл
		Стр = ТаблицаВрем.Добавить();
		Стр.Длина          = Запись.Длина;
		Стр.ЗначениеОриг   = Запись.ЗначениеОриг;
		Стр.ЗначениеНижний = Запись.ЗначениеНижний;
		Стр.Категория      = Запись.Категория;
	КонецЦикла;
	ТаблицаВрем.Сортировать("Длина Убыв");
	Результат = Новый Массив;
	Для Каждого Стр Из ТаблицаВрем Цикл
		Запись = Новый Структура;
		Запись.Вставить("ЗначениеОриг",   Стр.ЗначениеОриг);
		Запись.Вставить("ЗначениеНижний", Стр.ЗначениеНижний);
		Запись.Вставить("Категория",      Стр.Категория);
		Запись.Вставить("Длина",          Стр.Длина);
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Новый Структура("Данные, Лог", Результат, ЛогСловаря);

КонецФункции

Функция ТекстЗапросаСловаряАнонимизации(ИмяОбъекта, ИмяПоля)
	// Имена передаются только после разрешения через метаданные.
	// Приведение позволяет выбирать уникальные значения неограниченных строк.
	Возврат "ВЫБРАТЬ ПЕРВЫЕ 200000 РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(" + ИмяПоля + " КАК Строка(1000)) КАК Значение
	|ИЗ
	|	" + ИмяОбъекта + "
	|ГДЕ
	|	ВЫРАЗИТЬ(" + ИмяПоля + " КАК Строка(1000)) <> """"";
КонецФункции

Функция ПолучитьТекстКоманды(Команда) Экспорт

	ТекстКоманды = "";
	Отступ = "    "; // 4 пробела

	Если Не Команда.Свойство("params") Или Команда.params = Неопределено Тогда
		Возврат Отступ + "(без параметров)";
	КонецЕсли;

	ПараметрыКоманды = Команда.params;

	Если Команда.tool = "execute_query" Тогда
		Если ПараметрыКоманды.Свойство("query") Тогда
			ТекстКоманды = ПараметрыКоманды.query;
		КонецЕсли;
	ИначеЕсли Команда.tool = "execute_code" Тогда
		Если ПараметрыКоманды.Свойство("code") Тогда
			ТекстКоманды = ПараметрыКоманды.code;
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_metadata" Тогда
		ЧастиТекста = Новый Массив;
		Если ПараметрыКоманды.Свойство("filter") И Не ПустаяСтрока(ПараметрыКоманды.filter) Тогда
			ЧастиТекста.Добавить("фильтр: " + ПараметрыКоманды.filter);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("meta_type") И Не ПустаяСтрока(ПараметрыКоманды.meta_type) Тогда
			ЧастиТекста.Добавить("тип: " + ПараметрыКоманды.meta_type);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("name_mask") И Не ПустаяСтрока(ПараметрыКоманды.name_mask) Тогда
			ЧастиТекста.Добавить("маска: " + ПараметрыКоманды.name_mask);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("attribute_mask") И Не ПустаяСтрока(ПараметрыКоманды.attribute_mask) Тогда
			ЧастиТекста.Добавить("маска атрибута: " + ПараметрыКоманды.attribute_mask);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("extension_name") И ПараметрыКоманды.extension_name <> Неопределено Тогда
			ЧастиТекста.Добавить("расширение: " + ?(ПустаяСтрока(ПараметрыКоманды.extension_name), "(конфигурация)", ПараметрыКоманды.extension_name));
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("limit") И ЗначениеЗаполнено(ПараметрыКоманды.limit) Тогда
			ЧастиТекста.Добавить("лимит: " + ПараметрыКоманды.limit);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("types_limit") И ЗначениеЗаполнено(ПараметрыКоманды.types_limit) Тогда
			ЧастиТекста.Добавить("типы (лимит): " + ПараметрыКоманды.types_limit);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("types_offset") И ПараметрыКоманды.types_offset <> Неопределено И ПараметрыКоманды.types_offset <> Null Тогда
			ЧастиТекста.Добавить("типы (смещение): " + ПараметрыКоманды.types_offset);
		КонецЕсли;

		Если ЧастиТекста.Количество() = 0 Тогда
			ТекстКоманды = "(все метаданные)";
		Иначе
			ТекстКоманды = СоединитьМассив(ЧастиТекста, ", ");
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_event_log" Тогда
		ЧастиТекста = Новый Массив;
		Если ПараметрыКоманды.Свойство("start_date") И ЗначениеЗаполнено(ПараметрыКоманды.start_date) Тогда
			ЧастиТекста.Добавить("с " + ПараметрыКоманды.start_date);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("end_date") И ЗначениеЗаполнено(ПараметрыКоманды.end_date) Тогда
			ЧастиТекста.Добавить("по " + ПараметрыКоманды.end_date);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("levels") И ПараметрыКоманды.levels <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.levels) И ПараметрыКоманды.levels.Количество() > 0 Тогда
			ЧастиТекста.Добавить("уровни: " + СоединитьМассив(ПараметрыКоманды.levels, ", "));
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("limit") И ЗначениеЗаполнено(ПараметрыКоманды.limit) Тогда
			ЧастиТекста.Добавить("лимит: " + ПараметрыКоманды.limit);
		КонецЕсли;
		// Фильтры по объекту (приоритет: object_description > link > data)
		Если ПараметрыКоманды.Свойство("object_description") И ПараметрыКоманды.object_description <> Неопределено Тогда
			Если ТипЗнч(ПараметрыКоманды.object_description) = Тип("Структура") Тогда
				Если ПараметрыКоманды.object_description.Свойство("Представление") Тогда
					ЧастиТекста.Добавить("объект: " + ПараметрыКоманды.object_description.Представление);
				ИначеЕсли ПараметрыКоманды.object_description.Свойство("ТипОбъекта") Тогда
					ЧастиТекста.Добавить("объект (тип): " + ПараметрыКоманды.object_description.ТипОбъекта);
				Иначе
					ЧастиТекста.Добавить("объект: (описание объекта)");
				КонецЕсли;
			Иначе
				ЧастиТекста.Добавить("объект: (некорректное описание)");
			КонецЕсли;
		ИначеЕсли ПараметрыКоманды.Свойство("link") И ЗначениеЗаполнено(ПараметрыКоманды.link) Тогда
			ЧастиТекста.Добавить("ссылка: " + ПараметрыКоманды.link);
		ИначеЕсли ПараметрыКоманды.Свойство("data") И ЗначениеЗаполнено(ПараметрыКоманды.data) Тогда
			ЧастиТекста.Добавить("данные: " + ПараметрыКоманды.data);
		КонецЕсли;
		// Остальные фильтры
		Если ПараметрыКоманды.Свойство("metadata_type") И ПараметрыКоманды.metadata_type <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.metadata_type) И ПараметрыКоманды.metadata_type.Количество() > 0 Тогда
			ЧастиТекста.Добавить("метаданные: " + СоединитьМассив(ПараметрыКоманды.metadata_type, ", "));
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("user") И ПараметрыКоманды.user <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.user) И ПараметрыКоманды.user.Количество() > 0 Тогда
			ЧастиТекста.Добавить("пользователи: " + СоединитьМассив(ПараметрыКоманды.user, ", "));
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("session") И ПараметрыКоманды.session <> Неопределено Тогда
			Если ЭтоКоллекция(ПараметрыКоманды.session) И ПараметрыКоманды.session.Количество() > 0 Тогда
				МассивСеансов = Новый Массив;
				Для Каждого Сеанс Из ПараметрыКоманды.session Цикл
					МассивСеансов.Добавить(Строка(Сеанс));
				КонецЦикла;
				ЧастиТекста.Добавить("сеансы: " + СоединитьМассив(МассивСеансов, ", "));
			ИначеЕсли Не ЭтоКоллекция(ПараметрыКоманды.session) И ЗначениеЗаполнено(ПараметрыКоманды.session) Тогда
				ЧастиТекста.Добавить("сеанс: " + Строка(ПараметрыКоманды.session));
			КонецЕсли;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("application") И ПараметрыКоманды.application <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.application) И ПараметрыКоманды.application.Количество() > 0 Тогда
			ЧастиТекста.Добавить("приложения: " + СоединитьМассив(ПараметрыКоманды.application, ", "));
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("computer") И ЗначениеЗаполнено(ПараметрыКоманды.computer) Тогда
			ЧастиТекста.Добавить("компьютер: " + ПараметрыКоманды.computer);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("comment_contains") И ЗначениеЗаполнено(ПараметрыКоманды.comment_contains) Тогда
			ЧастиТекста.Добавить("комментарий содержит: " + ПараметрыКоманды.comment_contains);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("transaction_status") И ЗначениеЗаполнено(ПараметрыКоманды.transaction_status) Тогда
			ЧастиТекста.Добавить("статус транзакции: " + ПараметрыКоманды.transaction_status);
		КонецЕсли;
		Если ЧастиТекста.Количество() > 0 Тогда
			// Каждый параметр на новой строке с отступом в 4 пробела
			ТекстКоманды = "    " + СоединитьМассив(ЧастиТекста, Символы.ПС + "    ");
		Иначе
			ТекстКоманды = "(журнал регистрации)";
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_object_by_link" Тогда
		Если ПараметрыКоманды.Свойство("link") И ЗначениеЗаполнено(ПараметрыКоманды.link) Тогда
			ТекстКоманды = "ссылка: " + ПараметрыКоманды.link;
		Иначе
			ТекстКоманды = "(пустая ссылка)";
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_link_of_object" Тогда
		Если ПараметрыКоманды.Свойство("object_description") И ПараметрыКоманды.object_description <> Неопределено Тогда
			Если ТипЗнч(ПараметрыКоманды.object_description) = Тип("Структура") Тогда
				Если ПараметрыКоманды.object_description.Свойство("Представление") Тогда
					ТекстКоманды = "объект: " + ПараметрыКоманды.object_description.Представление;
				ИначеЕсли ПараметрыКоманды.object_description.Свойство("ТипОбъекта") Тогда
					ТекстКоманды = "тип: " + ПараметрыКоманды.object_description.ТипОбъекта;
				Иначе
					ТекстКоманды = "(описание объекта)";
				КонецЕсли;
			Иначе
				ТекстКоманды = "(некорректное описание)";
			КонецЕсли;
		Иначе
			ТекстКоманды = "(пустое описание)";
		КонецЕсли;
	ИначеЕсли Команда.tool = "find_references_to_object" Тогда
		ЧастиТекста = Новый Массив;
		// Целевой объект
		Если ПараметрыКоманды.Свойство("target_object_description") И ПараметрыКоманды.target_object_description <> Неопределено Тогда
			Если ТипЗнч(ПараметрыКоманды.target_object_description) = Тип("Структура") Тогда
				Если ПараметрыКоманды.target_object_description.Свойство("Представление") Тогда
					ЧастиТекста.Добавить("цель: " + ПараметрыКоманды.target_object_description.Представление);
				ИначеЕсли ПараметрыКоманды.target_object_description.Свойство("ТипОбъекта") Тогда
					ЧастиТекста.Добавить("цель (тип): " + ПараметрыКоманды.target_object_description.ТипОбъекта);
				Иначе
					ЧастиТекста.Добавить("цель: (описание объекта)");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Области поиска
		Если ПараметрыКоманды.Свойство("search_scope") И ПараметрыКоманды.search_scope <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.search_scope) И ПараметрыКоманды.search_scope.Количество() > 0 Тогда
			ЧастиТекста.Добавить("области: " + СоединитьМассив(ПараметрыКоманды.search_scope, ", "));
		КонецЕсли;
		// Фильтр метаданных
		Если ПараметрыКоманды.Свойство("meta_filter") И ПараметрыКоманды.meta_filter <> Неопределено Тогда
			Если ТипЗнч(ПараметрыКоманды.meta_filter) = Тип("Структура") Тогда
				Если ПараметрыКоманды.meta_filter.Свойство("names") И ПараметрыКоманды.meta_filter.names <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.meta_filter.names) И ПараметрыКоманды.meta_filter.names.Количество() > 0 Тогда
					ЧастиТекста.Добавить("фильтр имён: " + СоединитьМассив(ПараметрыКоманды.meta_filter.names, ", "));
				ИначеЕсли ПараметрыКоманды.meta_filter.Свойство("name_mask") И ЗначениеЗаполнено(ПараметрыКоманды.meta_filter.name_mask) Тогда
					ЧастиТекста.Добавить("маска: " + ПараметрыКоманды.meta_filter.name_mask);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Лимиты
		Если ПараметрыКоманды.Свойство("limit_hits") И ЗначениеЗаполнено(ПараметрыКоманды.limit_hits) Тогда
			ЧастиТекста.Добавить("лимит: " + ПараметрыКоманды.limit_hits);
		КонецЕсли;
		Если ЧастиТекста.Количество() > 0 Тогда
			ТекстКоманды = "    " + СоединитьМассив(ЧастиТекста, Символы.ПС + "    ");
		Иначе
			ТекстКоманды = "(поиск ссылок на объект)";
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_access_rights" Тогда
		ЧастиТекста = Новый Массив;
		Если ПараметрыКоманды.Свойство("metadata_object") И ЗначениеЗаполнено(ПараметрыКоманды.metadata_object) Тогда
			ЧастиТекста.Добавить("объект: " + ПараметрыКоманды.metadata_object);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("user_name") И ЗначениеЗаполнено(ПараметрыКоманды.user_name) Тогда
			ЧастиТекста.Добавить("пользователь: " + ПараметрыКоманды.user_name);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("rights_filter") И ПараметрыКоманды.rights_filter <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.rights_filter) И ПараметрыКоманды.rights_filter.Количество() > 0 Тогда
			ЧастиТекста.Добавить("права: " + СоединитьМассив(ПараметрыКоманды.rights_filter, ", "));
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("roles_filter") И ПараметрыКоманды.roles_filter <> Неопределено И ЭтоКоллекция(ПараметрыКоманды.roles_filter) И ПараметрыКоманды.roles_filter.Количество() > 0 Тогда
			ЧастиТекста.Добавить("роли: " + СоединитьМассив(ПараметрыКоманды.roles_filter, ", "));
		КонецЕсли;
		Если ЧастиТекста.Количество() > 0 Тогда
			ТекстКоманды = "    " + СоединитьМассив(ЧастиТекста, Символы.ПС + "    ");
		Иначе
			ТекстКоманды = "(права доступа)";
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_bsl_syntax_help" Тогда
		ЧастиТекста = Новый Массив;
		Если ПараметрыКоманды.Свойство("keywords") И ПараметрыКоманды.keywords <> Неопределено Тогда
			Если ТипЗнч(ПараметрыКоманды.keywords) = Тип("Массив") Тогда
				ЧастиТекста.Добавить("поиск: " + СоединитьМассив(ПараметрыКоманды.keywords, ", "));
			Иначе
				ЧастиТекста.Добавить("поиск: " + Строка(ПараметрыКоманды.keywords));
			КонецЕсли;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("limit") Тогда ЧастиТекста.Добавить("лимит: " + Строка(ПараметрыКоманды.limit)); КонецЕсли;
		Если ПараметрыКоманды.Свойство("offset") Тогда ЧастиТекста.Добавить("смещение: " + Строка(ПараметрыКоманды.offset)); КонецЕсли;
		Если ПараметрыКоманды.Свойство("content_page") Тогда ЧастиТекста.Добавить("страница содержимого: " + Строка(ПараметрыКоманды.content_page)); КонецЕсли;
		ТекстКоманды = ?(ЧастиТекста.Количество() > 0, СоединитьМассив(ЧастиТекста, ", "), "(справка BSL)");
	ИначеЕсли Команда.tool = "submit_for_deanonymization" Тогда
		Текст = "";
		Если ПараметрыКоманды.Свойство("text") Тогда Текст = ПараметрыКоманды.text; КонецЕсли;
		Если ЗначениеЗаполнено(Текст) Тогда
			ТекстКоманды = "текст: " + Лев(Текст, 80) + ?(СтрДлина(Текст) > 80, "…", "");
		Иначе
			ТекстКоманды = "(пустой текст)";
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_screenshot" Тогда
		ЧастиТекста = Новый Массив;
		Если ПараметрыКоманды.Свойство("form_name") И ЗначениеЗаполнено(ПараметрыКоманды.form_name) Тогда
			ЧастиТекста.Добавить("форма: " + ПараметрыКоманды.form_name);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("link") И ЗначениеЗаполнено(ПараметрыКоманды.link) Тогда
			ЧастиТекста.Добавить("ссылка: " + ПараметрыКоманды.link);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("page_name") И ЗначениеЗаполнено(ПараметрыКоманды.page_name) Тогда
			ЧастиТекста.Добавить("страница: " + ПараметрыКоманды.page_name);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("region") И ПараметрыКоманды.region <> Неопределено Тогда
			Р = ПараметрыКоманды.region;
			РегионСтр = "";
			Если ТипЗнч(Р) = Тип("Структура") Тогда
				Если Р.Свойство("x") Тогда РегионСтр = РегионСтр + "x=" + Р.x + " "; КонецЕсли;
				Если Р.Свойство("y") Тогда РегионСтр = РегионСтр + "y=" + Р.y + " "; КонецЕсли;
				Если Р.Свойство("width") Тогда РегионСтр = РегионСтр + "w=" + Р.width + " "; КонецЕсли;
				Если Р.Свойство("height") Тогда РегионСтр = РегионСтр + "h=" + Р.height; КонецЕсли;
			КонецЕсли;
			ЧастиТекста.Добавить("регион: " + СокрЛП(РегионСтр));
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("show_grid") И ПараметрыКоманды.show_grid = Истина Тогда
			ЧастиТекста.Добавить("сетка: да");
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("scale_percent") И ЗначениеЗаполнено(ПараметрыКоманды.scale_percent) Тогда
			ЧастиТекста.Добавить("масштаб: " + ПараметрыКоманды.scale_percent + "%");
		КонецЕсли;
		Если ЧастиТекста.Количество() > 0 Тогда
			ТекстКоманды = СоединитьМассив(ЧастиТекста, ", ");
		Иначе
			ТекстКоманды = "(весь экран)";
		КонецЕсли;
	Иначе
		ТекстКоманды = "(неизвестная команда)";
	КонецЕсли;

	// Преобразуем экранированные символы
	ТекстКоманды = СтрЗаменить(ТекстКоманды, "\r", "");
	ТекстКоманды = СтрЗаменить(ТекстКоманды, "\t", "    ");
	ТекстКоманды = СтрЗаменить(ТекстКоманды, "\n", Символы.ПС);

	// Добавляем отступ к каждой строке
	ТекстКоманды = Отступ + СтрЗаменить(ТекстКоманды, Символы.ПС, Символы.ПС + Отступ);

	Возврат ТекстКоманды;

КонецФункции

Функция ПолучитьТекстРезультата(Результат) Экспорт

	Отступ = "    "; // 4 пробела
	ТекстРезультата = "";

	Если (Результат.Свойство("success") И Результат.success = Истина)
		Или (Результат.Свойство("received") И Результат.received = Истина) Тогда
		Если Результат.Свойство("_original_data_json") Тогда
			ТекстРезультата = Результат._original_data_json;
		ИначеЕсли Результат.Свойство("data") Тогда
			ТекстРезультата = ЗаписатьJSON2(Результат.data);
		ИначеЕсли Результат.Свойство("image_base64")
			И ЗначениеЗаполнено(Результат.image_base64) Тогда
			МимТип = "image/png";
			Если Результат.Свойство("mime_type") Тогда МимТип = Результат.mime_type; КонецЕсли;
			ТекстРезультата = "(изображение " + МимТип
				+ ", base64 длина " + СтрДлина(Результат.image_base64) + " символов)";
		Иначе
			ТекстРезультата = "(нет данных)";
		КонецЕсли;
	Иначе
		Если Результат.Свойство("error") Тогда
			ТекстРезультата = "Ошибка: " + Результат.error;
		Иначе
			ТекстРезультата = "(неизвестная ошибка)";
		КонецЕсли;
	КонецЕсли;

	// Преобразуем экранированные символы
	ТекстРезультата = СтрЗаменить(ТекстРезультата, "\r", "");
	ТекстРезультата = СтрЗаменить(ТекстРезультата, "\t", "    ");
	ТекстРезультата = СтрЗаменить(ТекстРезультата, "\n", Символы.ПС);

	// Добавляем отступ к каждой строке
	ТекстРезультата = Отступ + СтрЗаменить(ТекстРезультата, Символы.ПС, Символы.ПС + Отступ);

	Возврат ТекстРезультата;

КонецФункции

Функция НормализоватьСтандартныеRegexПравила(Правила) Экспорт
	Если ТипЗнч(Правила) <> Тип("Массив") Тогда Возврат Правила; КонецЕсли;
	// Копия: эффективные правила не меняют сохранённый профиль и его revision.
	Копия = ПрочитатьJSON2(ЗаписатьJSON2(Правила));
	Для Каждого Правило Из Копия Цикл
		Если ПолучитьЗначениеОбъекта(Правило, "category") <> "ORG" Тогда Продолжить; КонецЕсли;
		Шаблон = ПолучитьЗначениеОбъекта(Правило, "pattern");
		Если Шаблон = "(?i)\b[А-ЯЁA-Za-z0-9][^,\n;]{1,80}?\s+(ООО|ОАО|ЗАО|ПАО|АО|ИП|НАО|ГУП|МУП|НКО|ФГУП)\.?\b(?=\s*(?:\(|$|,|;|\n))" Тогда Правило["pattern"] = "(?i)(?<!\w)[^\W_][^\r\n,;]*?[^\S\r\n]+(?:ООО|ОАО|ЗАО|ПАО|НАО|АО|ФГУП|ГУП|МУП|НКО|ИП)\.?(?!\w)(?=[^\S\r\n]*(?:\(|$|,|;|\r|\n))"; КонецЕсли;
		Если Шаблон = "(?i)(ООО|ОАО|ЗАО|ПАО|АО|ИП|НАО|ГУП|МУП|НКО|ФГУП)\s+(?=[""«A-Za-zА-ЯЁ0-9])[""«]?[^,;\n]{2,}[""»]?" Тогда Правило["pattern"] = "(?i)(?<!\w)(?:ООО|ОАО|ЗАО|ПАО|НАО|АО|ФГУП|ГУП|МУП|НКО|ИП)(?!\w)[^\S\r\n]*(?:""[^""\r\n]+""|«[^»\r\n]+»|[^\W_][^""«»\r\n,;:]*)"; КонецЕсли;
