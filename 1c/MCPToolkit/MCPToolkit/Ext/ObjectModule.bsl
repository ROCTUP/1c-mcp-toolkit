		Возврат "ПланВидовХарактеристик." + Сред(ТипОбъекта, 29) + ".Наименование";
	ИначеЕсли Лев(ТипОбъекта, 22) = "ПланВидовРасчетаСсылка." Тогда
		Возврат "ПланВидовРасчета." + Сред(ТипОбъекта, 23) + ".Наименование";
	ИначеЕсли Лев(ТипОбъекта, 20) = "БизнесПроцессСсылка." Тогда
		Возврат "БизнесПроцесс." + Сред(ТипОбъекта, 21) + ".Наименование";
