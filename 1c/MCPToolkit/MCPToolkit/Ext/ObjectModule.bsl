	ПраваСправочника.Добавить("Просмотр");
	ПраваСправочника.Добавить("ИнтерактивноеДобавление");
	ПраваСправочника.Добавить("Редактирование");
	ПраваСправочника.Добавить("ИнтерактивноеУдаление");
	ПраваСправочника.Добавить("ИнтерактивнаяПометкаУдаления");
	ПраваСправочника.Добавить("ИнтерактивноеСнятиеПометкиУдаления");
	ПраваСправочника.Добавить("ИнтерактивноеУдалениеПомеченных");
	ПраваСправочника.Добавить("ИнтерактивноеУдалениеПредопределенныхДанных");
	ПраваСправочника.Добавить("ИнтерактивнаяПометкаУдаленияПредопределенныхДанных");
	ПраваСправочника.Добавить("ИнтерактивноеСнятиеПометкиУдаленияПредопределенныхДанных");
	ПраваСправочника.Добавить("ИнтерактивноеУдалениеПомеченныхПредопределенныхДанных");
	ПраваПоТипам.Вставить("Справочник", ПраваСправочника);
	ПраваПоТипам.Вставить("ПланВидовХарактеристик", ПраваСправочника);
	ПраваПоТипам.Вставить("ПланСчетов", ПраваСправочника);
	ПраваПоТипам.Вставить("ПланВидовРасчета", ПраваСправочника);
	ПраваПоТипам.Вставить("ПланОбмена", ПраваСправочника);

	// Документы
	ПраваДокумента = Новый Массив;
	Для Каждого Право Из ПраваСправочника Цикл
		ПраваДокумента.Добавить(Право);
	КонецЦикла;
	ПраваДокумента.Добавить("Проведение");
	ПраваДокумента.Добавить("ОтменаПроведения");
	ПраваДокумента.Добавить("ИнтерактивноеПроведение");
	ПраваДокумента.Добавить("ИнтерактивноеПроведениеНеОперативное");
	ПраваДокумента.Добавить("ИнтерактивнаяОтменаПроведения");
	ПраваДокумента.Добавить("ИнтерактивноеИзменениеПроведенных");
	ПраваДокумента.Добавить("ИнтерактивноеУдалениеПомеченных");
	ПраваПоТипам.Вставить("Документ", ПраваДокумента);

	// Бизнес-процессы: документные права + старт
	ПраваБизнесПроцесса = Новый Массив;
	Для Каждого ПравоБП Из ПраваДокумента Цикл
		ПраваБизнесПроцесса.Добавить(ПравоБП);
	КонецЦикла;
	ПраваБизнесПроцесса.Добавить("Старт");
	ПраваБизнесПроцесса.Добавить("ИнтерактивныйСтарт");
	ПраваПоТипам.Вставить("БизнесПроцесс", ПраваБизнесПроцесса);

	// Задачи: документные права + выполнение
	ПраваЗадачи = Новый Массив;
	Для Каждого ПравоЗад Из ПраваДокумента Цикл
		ПраваЗадачи.Добавить(ПравоЗад);
	КонецЦикла;
	ПраваЗадачи.Добавить("Выполнение");
	ПраваЗадачи.Добавить("ИнтерактивноеВыполнение");
	ПраваПоТипам.Вставить("Задача", ПраваЗадачи);

	// Регистры
	ПраваРегистраБазовые = Новый Массив;
	ПраваРегистраБазовые.Добавить("Чтение");
	ПраваРегистраБазовые.Добавить("Изменение");
	ПраваРегистраБазовые.Добавить("Просмотр");
	ПраваРегистраБазовые.Добавить("Редактирование");
	ПраваПоТипам.Вставить("РегистрСведений", ПраваРегистраБазовые);
	ПраваПоТипам.Вставить("РегистрРасчета", ПраваРегистраБазовые);

	// УправлениеИтогами применимо к регистрам накопления и бухгалтерии
	ПраваРегистраСИтогами = Новый Массив;
	Для Каждого ПравоРег Из ПраваРегистраБазовые Цикл
		ПраваРегистраСИтогами.Добавить(ПравоРег);
	КонецЦикла;
	ПраваРегистраСИтогами.Добавить("УправлениеИтогами");
	ПраваПоТипам.Вставить("РегистрНакопления", ПраваРегистраСИтогами);
	ПраваПоТипам.Вставить("РегистрБухгалтерии", ПраваРегистраСИтогами);

	// Обработки и отчёты
	ПраваОбработки = Новый Массив;
	ПраваОбработки.Добавить("Использование");
	ПраваОбработки.Добавить("Просмотр");
	ПраваПоТипам.Вставить("Обработка", ПраваОбработки);
	ПраваПоТипам.Вставить("Отчет", ПраваОбработки);

	Возврат ПраваПоТипам;

КонецФункции

Функция НайтиПользователяИБПоИмени(ИмяПользователя)

	ИмяПользователя = СокрЛП(ИмяПользователя);
	Если Не ЗначениеЗаполнено(ИмяПользователя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// 1. Пытаемся найти через НайтиПоИмени (прямой поиск по имени пользователя ИБ)
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательИБ <> Неопределено Тогда
		Возврат ПользовательИБ;
	КонецЕсли;

	// 2. Поиск через справочник Пользователи (переданное имя может быть наименованием из справочника)
	Если Метаданные.Справочники.Найти("Пользователи") <> Неопределено Тогда
		Попытка
			ЭлементСправочника = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя, Истина);
			Если ЭлементСправочника <> Справочники.Пользователи.ПустаяСсылка() Тогда
				ИдПользователяИБ = ЭлементСправочника.ИдентификаторПользователяИБ;
				Если ТипЗнч(ИдПользователяИБ) = Тип("Строка") Тогда
					ИдПользователяИБ = Новый УникальныйИдентификатор(СокрЛП(ИдПользователяИБ));
				КонецЕсли;
				Если ЗначениеЗаполнено(ИдПользователяИБ) Тогда
					ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ИдПользователяИБ);
					Если ПользовательИБ <> Неопределено Тогда
						Возврат ПользовательИБ;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Справочник Пользователи существует, но реквизит ИдентификаторПользователяИБ
			// может отсутствовать или быть недоступен — пропускаем этот шаг.
		КонецПопытки;
	КонецЕсли;

	// 3. Fallback: ручной перебор с case-insensitive сравнением
	ИмяПользователяВерх = ВРег(ИмяПользователя);
	// В некоторых режимах/версиях платфомы менеджер ПользователиИнформационнойБазы
	// не является итерируемой коллекцией (ошибка "Итератор для значения не определен").
	// Поэтому перебор делаем в Попытка/Исключение, чтобы не падать инструментом целиком.
	Попытка
		Для Каждого Пользователь Из ПользователиИнформационнойБазы Цикл
			Если ВРег(Пользователь.Имя) = ИмяПользователяВерх Тогда
				Возврат Пользователь;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Fallback перебора пользователей недоступен в текущем окружении.
		// Возвращаем Неопределено, чтобы вызывающий код вернул понятную ошибку "Пользователь не найден".
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция СортироватьМассивСтруктурПоПолю(МассивСтруктур, ИмяПоля)

	// Простой алгоритм сортировки пузырьком
	Результат = Новый Массив;
	Для Каждого Элемент Из МассивСтруктур Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Если Результат.Количество() <= 1 Тогда
		Возврат Результат;
	КонецЕсли;

	Для н = 0 По Результат.Количество() - 2 Цикл
		Для м = 0 По Результат.Количество() - 2 - н Цикл
			Элемент1 = Результат[м];
			Элемент2 = Результат[м + 1];

			Значение1 = Неопределено;
			Значение2 = Неопределено;

			Если Элемент1.Свойство(ИмяПоля) Тогда
				Значение1 = Элемент1[ИмяПоля];
			КонецЕсли;
			Если Элемент2.Свойство(ИмяПоля) Тогда
				Значение2 = Элемент2[ИмяПоля];
			КонецЕсли;

			// Сравнение с учётом типа
			Сравнение = 0;
			Если ЗначениеЗаполнено(Значение1) И ЗначениеЗаполнено(Значение2) Тогда
				Строка1 = Строка(Значение1);
				Строка2 = Строка(Значение2);
				Если Строка1 > Строка2 Тогда
					Сравнение = 1;
				ИначеЕсли Строка1 < Строка2 Тогда
					Сравнение = -1;
				Иначе
					Сравнение = 0;
				КонецЕсли;
			ИначеЕсли Не ЗначениеЗаполнено(Значение1) И ЗначениеЗаполнено(Значение2) Тогда
				Сравнение = 1; // Пустые в конце
			ИначеЕсли ЗначениеЗаполнено(Значение1) И Не ЗначениеЗаполнено(Значение2) Тогда
				Сравнение = -1; // Пустые в конце
			КонецЕсли;

			Если Сравнение > 0 Тогда
				Результат.Установить(м, Элемент2);
				Результат.Установить(м + 1, Элемент1);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НормализоватьЗначениеНастройкиТипов(СыроеЗначение, ИмяПоля, МинЗначение, МаксЗначение, НормализованноеЗначение)

	// Presence-aware нормализация одного числового параметра types_*.
	// Возвращает Неопределено при успехе или строку error_detail (стиль прокси).
	// Булево/строки/дробные отклоняются; REST GET парсит строки раньше.

	НормализованноеЗначение = Неопределено;

	Если ТипЗнч(СыроеЗначение) <> Тип("Число") Тогда
		Возврат "Field '" + ИмяПоля + "': Input should be a valid integer";
	КонецЕсли;

	Если СыроеЗначение <> Цел(СыроеЗначение) Тогда
		Возврат "Field '" + ИмяПоля + "': Input should be a valid integer";
	КонецЕсли;

	ЦелоеЗначение = Цел(СыроеЗначение);

	Если ЦелоеЗначение < МинЗначение Тогда
		Возврат "Field '" + ИмяПоля + "': Input should be greater than or equal to " + Строка(МинЗначение);
	КонецЕсли;

	Если ЦелоеЗначение > МаксЗначение Тогда
		Возврат "Field '" + ИмяПоля + "': Input should be less than or equal to " + Строка(МаксЗначение);
	КонецЕсли;

	НормализованноеЗначение = ЦелоеЗначение;
	Возврат Неопределено;

КонецФункции

Функция НормализоватьИПроверитьНастройкиТипов(АргументыЗапроса)

	// Единая полная проверка types_limit/types_offset для всех путей исполнения
	// (транспортный валидатор, общий диспетчер, клиентский ключ кэша).
	// Возвращает {Настройки, ДетальОшибки}. Ничего не вставляет в АргументыЗапроса:
	// отсутствие/Null = "не задано", явный 0 у types_offset допустим и отличим.

	Настройки = Новый Структура;
	Настройки.Вставить("ЗаданЛимит", Ложь);
	Настройки.Вставить("ЗаданоСмещение", Ложь);
	Настройки.Вставить("ЗаданыПараметры", Ложь);
	Настройки.Вставить("Лимит", 100);
	Настройки.Вставить("Смещение", 0);

	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("Настройки", Настройки);
	РезультатПроверки.Вставить("ДетальОшибки", Неопределено);

	Если АргументыЗапроса = Неопределено Или ТипЗнч(АргументыЗапроса) <> Тип("Структура") Тогда
		Возврат РезультатПроверки;
	КонецЕсли;

	Если АргументыЗапроса.Свойство("types_limit")
		И АргументыЗапроса.types_limit <> Null И АргументыЗапроса.types_limit <> Неопределено Тогда
		ЗначениеЛимита = Неопределено;
		ДетальОшибки = НормализоватьЗначениеНастройкиТипов(АргументыЗапроса.types_limit, "types_limit", 1, 200, ЗначениеЛимита);
		Если ДетальОшибки <> Неопределено Тогда
			РезультатПроверки.ДетальОшибки = ДетальОшибки;
			Возврат РезультатПроверки;
		КонецЕсли;
		Настройки.ЗаданЛимит = Истина;
		Настройки.Лимит = ЗначениеЛимита;
	КонецЕсли;

	Если АргументыЗапроса.Свойство("types_offset")
		И АргументыЗапроса.types_offset <> Null И АргументыЗапроса.types_offset <> Неопределено Тогда
		ЗначениеСмещения = Неопределено;
		ДетальОшибки = НормализоватьЗначениеНастройкиТипов(АргументыЗапроса.types_offset, "types_offset", 0, 1000000, ЗначениеСмещения);
		Если ДетальОшибки <> Неопределено Тогда
			РезультатПроверки.ДетальОшибки = ДетальОшибки;
			Возврат РезультатПроверки;
		КонецЕсли;
		Настройки.ЗаданоСмещение = Истина;
		Настройки.Смещение = ЗначениеСмещения;
	КонецЕсли;

	Настройки.ЗаданыПараметры = Настройки.ЗаданЛимит Или Настройки.ЗаданоСмещение;

	Если Настройки.ЗаданыПараметры Тогда

		ФильтрЗадан = АргументыЗапроса.Свойство("filter")
			И АргументыЗапроса.filter <> Null И АргументыЗапроса.filter <> Неопределено
			И НЕ ПустаяСтрока(СокрЛП(Строка(АргументыЗапроса.filter)));
		Если НЕ ФильтрЗадан Тогда
			РезультатПроверки.ДетальОшибки = "types_limit/types_offset require a non-empty filter pointing to a single typed field (e.g. Type.Object.Attribute.Name)";
			Возврат РезультатПроверки;
		КонецЕсли;

		Если АргументыЗапроса.Свойство("attribute_mask")
			И АргументыЗапроса.attribute_mask <> Null И АргументыЗапроса.attribute_mask <> Неопределено
			И НЕ ПустаяСтрока(СокрЛП(Строка(АргументыЗапроса.attribute_mask))) Тогда
			РезультатПроверки.ДетальОшибки = "types_limit/types_offset are incompatible with attribute_mask";
			Возврат РезультатПроверки;
		КонецЕсли;

		МетаТипЗадан = Ложь;
		Если АргументыЗапроса.Свойство("meta_type")
			И АргументыЗапроса.meta_type <> Null И АргументыЗапроса.meta_type <> Неопределено Тогда
			Если ТипЗнч(АргументыЗапроса.meta_type) = Тип("Строка") Тогда
				МетаТипЗадан = НЕ ПустаяСтрока(СокрЛП(АргументыЗапроса.meta_type));
			ИначеЕсли ТипЗнч(АргументыЗапроса.meta_type) = Тип("Массив")
				Или ТипЗнч(АргументыЗапроса.meta_type) = Тип("ФиксированныйМассив") Тогда
				МетаТипЗадан = (АргументыЗапроса.meta_type.Количество() > 0);
			Иначе
				МетаТипЗадан = Истина;
			КонецЕсли;
		КонецЕсли;
		Если МетаТипЗадан Тогда
			РезультатПроверки.ДетальОшибки = "types_limit/types_offset are incompatible with meta_type";
			Возврат РезультатПроверки;
		КонецЕсли;

		Если АргументыЗапроса.Свойство("name_mask")
			И АргументыЗапроса.name_mask <> Null И АргументыЗапроса.name_mask <> Неопределено
			И НЕ ПустаяСтрока(СокрЛП(Строка(АргументыЗапроса.name_mask))) Тогда
			РезультатПроверки.ДетальОшибки = "types_limit/types_offset are incompatible with name_mask";
			Возврат РезультатПроверки;
		КонецЕсли;

		Если АргументыЗапроса.Свойство("extension_name")
			И ТипЗнч(АргументыЗапроса.extension_name) = Тип("Строка")
			И ПустаяСтрока(АргументыЗапроса.extension_name) Тогда
			РезультатПроверки.ДетальОшибки = "types_limit/types_offset are incompatible with extension_name='' (list of extensions)";
			Возврат РезультатПроверки;
		КонецЕсли;

	КонецЕсли;

	Возврат РезультатПроверки;

КонецФункции

Функция СтрокаСоответствуетISO8601ДатаВремя(СтрокаДаты)

	// Проверяем только формат (как в прокси): YYYY-MM-DDTHH:MM:SS
	Если ТипЗнч(СтрокаДаты) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(СтрокаДаты) <> 19 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Сред(СтрокаДаты, 5, 1) <> "-" Или Сред(СтрокаДаты, 8, 1) <> "-"
		Или Сред(СтрокаДаты, 11, 1) <> "T"
		Или Сред(СтрокаДаты, 14, 1) <> ":"
		Или Сред(СтрокаДаты, 17, 1) <> ":" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Проверяем что остальные символы - цифры
	ПозицииНеЦифры = Новый Массив;
	ПозицииНеЦифры.Добавить(1);  // YYYY
	ПозицииНеЦифры.Добавить(2);
	ПозицииНеЦифры.Добавить(3);
	ПозицииНеЦифры.Добавить(4);
	ПозицииНеЦифры.Добавить(6);  // MM
	ПозицииНеЦифры.Добавить(7);
	ПозицииНеЦифры.Добавить(9);  // DD
	ПозицииНеЦифры.Добавить(10);
	ПозицииНеЦифры.Добавить(12); // HH
	ПозицииНеЦифры.Добавить(13);
	ПозицииНеЦифры.Добавить(15); // mm
	ПозицииНеЦифры.Добавить(16);
	ПозицииНеЦифры.Добавить(18); // ss
	ПозицииНеЦифры.Добавить(19);

	Для Каждого Позиция Из ПозицииНеЦифры Цикл
		Символ = Сред(СтрокаДаты, Позиция, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СоздатьПланировщикКоманд(Экземпляр, Поколение)
	Возврат Новый Структура("Экземпляр,Поколение,Режим,Операции,Очередь,ЛимитЗаданий,ЛимитОпераций,ПовторноеВключение",
		Экземпляр, Поколение, "disabled", Новый Соответствие, Новый Массив, 8, 10, Ложь);
КонецФункции

Функция КопироватьПакетПланировщика(ЗначениеПакета)
	ТипПакета = ТипЗнч(ЗначениеПакета);
	Если ТипПакета = Тип("Структура") Или ТипПакета = Тип("ФиксированнаяСтруктура") Тогда
		КопияПакета = Новый Структура;
		Для Каждого ПолеПакета Из ЗначениеПакета Цикл
			КопияПакета.Вставить(ПолеПакета.Ключ, КопироватьПакетПланировщика(ПолеПакета.Значение));
		КонецЦикла;
		Возврат КопияПакета;
	ИначеЕсли ТипПакета = Тип("Массив") Или ТипПакета = Тип("ФиксированныйМассив") Тогда
		КопияПакета = Новый Массив;
		Для Каждого ЭлементПакета Из ЗначениеПакета Цикл
			КопияПакета.Добавить(КопироватьПакетПланировщика(ЭлементПакета));
		КонецЦикла;
		Возврат КопияПакета;
	КонецЕсли;
	Возврат ЗначениеПакета;
КонецФункции

Функция ЭтоСервернаяКомандаПланировщика(Команда)
	ИмяИнструмента = Команда.tool;
	Если ИмяИнструмента = "execute_code" Тогда
		КонтекстКода = "server";
		Если Команда.Свойство("params") И Команда.params <> Неопределено Тогда
			Если Команда.params.Свойство("execution_context") Тогда
				КонтекстКода = Команда.params.execution_context;
			КонецЕсли;
		КонецЕсли;
		Возврат КонтекстКода = "server";
	КонецЕсли;
	Возврат ИмяИнструмента = "execute_query" Или ИмяИнструмента = "get_metadata"
		Или ИмяИнструмента = "get_event_log" Или ИмяИнструмента = "get_object_by_link"
		Или ИмяИнструмента = "get_link_of_object" Или ИмяИнструмента = "find_references_to_object"
		Или ИмяИнструмента = "get_access_rights";
КонецФункции

Функция ПринятьКомандуПланировщика(Планировщик, ИдОперации, Команда, Маршрут, Настройки, Срок, Сейчас, ИсполнительВладельца = "")
	Если ИсполнительВладельца <> "" И ИсполнительВладельца <> "owner_help" И ИсполнительВладельца <> "owner_command" Тогда
		Возврат Новый Структура("accepted,reason", Ложь, "unknown_executor");
	КонецЕсли;
	Если Планировщик.Режим = "disabled" И ИсполнительВладельца = "" Тогда
		Возврат Новый Структура("accepted,reason", Ложь, "disabled");
	КонецЕсли;
	Если НЕ ЭтоСервернаяКомандаПланировщика(Команда) И НЕ (ИсполнительВладельца = "owner_help" И Команда.tool = "get_bsl_syntax_help") Тогда
		Возврат Новый Структура("accepted,reason", Ложь, "client_command");
	КонецЕсли;
	Если Планировщик.Операции.Получить(ИдОперации) <> Неопределено Тогда
		Возврат Новый Структура("accepted,reason", Ложь, "duplicate_operation");
	КонецЕсли;
	Если Планировщик.Операции.Количество() >= Планировщик.ЛимитОпераций Тогда
		Возврат Новый Структура("accepted,reason", Ложь, "busy");
	КонецЕсли;
	Если Срок <= Сейчас Тогда Возврат Новый Структура("accepted,reason", Ложь, "expired"); КонецЕсли;
	Операция = Новый Структура;
	Операция.Вставить("Ид", ИдОперации);
	Операция.Вставить("Экземпляр", Планировщик.Экземпляр);
	Операция.Вставить("Поколение", Планировщик.Поколение);
	Операция.Вставить("Команда", КопироватьПакетПланировщика(Команда));
	Операция.Вставить("Маршрут", КопироватьПакетПланировщика(Маршрут));
	Операция.Вставить("Настройки", КопироватьПакетПланировщика(Настройки));
	Операция.Вставить("Срок", Срок);
	Операция.Вставить("Состояние", ?(ИсполнительВладельца = "", "queued", "owner_queued"));
	Операция.Вставить("ИсполнительВладельца", ИсполнительВладельца);
	Операция.Вставить("СостояниеСтарта", "not_started");
	Операция.Вставить("ЗанимаетСлот", Ложь);
	Операция.Вставить("ИдЗадания", Неопределено);
	Операция.Вставить("АдресРезультата", "");
	Операция.Вставить("КлючЗапуска", Строка(Планировщик.Экземпляр) + ":" + Строка(Планировщик.Поколение) + ":" + Строка(ИдОперации));
	Операция.Вставить("Результат", Неопределено);
	Операция.Вставить("ЗавершениеЗапрошено", Ложь);
	Операция.Вставить("ПричинаЗавершения", "");
	Операция.Вставить("ОтменаОтправлена", Ложь);
	Операция.Вставить("ВыдачаНачата", Ложь);
	Операция.Вставить("ОтветВыдан", Ложь);
	Операция.Вставить("РесурсыОсвобождены", Ложь);
	Операция.Вставить("ПоискЗанят", Ложь);
	Операция.Вставить("ПоискСостояние", "");
	Операция.Вставить("ПоискОтменаОтправлена", Ложь);
	Операция.Вставить("ПоискРезультатJSON", Неопределено);
	Планировщик.Операции.Вставить(ИдОперации, Операция);
	Если ИсполнительВладельца = "" Тогда Планировщик.Очередь.Добавить(ИдОперации); КонецЕсли;
	Возврат Новый Структура("accepted,reason", Истина, "queued");
КонецФункции

Процедура ПрерватьОперациюПланировщика(Операция, Причина)
	Если Операция.ОтветВыдан Или Операция.ЗавершениеЗапрошено Тогда Возврат; КонецЕсли;
	Операция.ЗавершениеЗапрошено = Истина;
	Операция.ПричинаЗавершения = Причина;
	Операция.Результат = Новый Структура("success,error", Ложь, Причина);
	Если НЕ Операция.ВыдачаНачата Тогда Операция.Состояние = "result_ready"; КонецЕсли;
КонецПроцедуры

Функция ПодготовитьПроходПланировщика(Планировщик, Сейчас)
	Действия = Новый Структура("start,poll,cancel,sequential", Новый Массив, Новый Массив, Новый Массив, Новый Массив);
	Занято = 0;
	Для Каждого ПараОперации Из Планировщик.Операции Цикл
		Операция = ПараОперации.Значение;
		Если НЕ Операция.ОтветВыдан И Операция.Срок <= Сейчас Тогда
			ПрерватьОперациюПланировщика(Операция, "Operation timed out; execution is not replayed");
		КонецЕсли;
		Если Операция.ЗанимаетСлот Тогда
			Занято = Занято + 1;
			Действия.poll.Добавить(Операция.Ид);
			Если Операция.ЗавершениеЗапрошено И НЕ Операция.ОтменаОтправлена
				И Операция.ИдЗадания <> Неопределено Тогда
				Действия.cancel.Добавить(Операция.Ид);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// При draining результаты/подтверждения тоже должны завершиться до прямого вызова.
	ЕстьНезавершеннаяВыдача = Ложь;
	Для Каждого ПараОперации Из Планировщик.Операции Цикл
		Операция = ПараОперации.Значение;
		Если Операция.Состояние <> "queued" И НЕ Операция.ОтветВыдан Тогда
			ЕстьНезавершеннаяВыдача = Истина;
		КонецЕсли;
	КонецЦикла;
	МожноПрямо = Планировщик.Режим = "draining" И Занято = 0 И НЕ ЕстьНезавершеннаяВыдача;
	Пока Планировщик.Очередь.Количество() > 0 Цикл
		ИдОперации = Планировщик.Очередь[0];
		Операция = Планировщик.Операции.Получить(ИдОперации);
		Если Операция = Неопределено Тогда Планировщик.Очередь.Удалить(0); Продолжить; КонецЕсли;
		Если Операция.Состояние <> "queued" Тогда Планировщик.Очередь.Удалить(0); Продолжить; КонецЕсли;
		Если МожноПрямо Тогда
			Планировщик.Очередь.Удалить(0);
			Операция.Состояние = "starting";
			Действия.sequential.Добавить(ИдОперации);
			Прервать;
		КонецЕсли;
		Если Планировщик.Режим <> "enabled" Или Занято >= Планировщик.ЛимитЗаданий Тогда Прервать; КонецЕсли;
		Планировщик.Очередь.Удалить(0);
		Операция.Состояние = "starting";
		Операция.СостояниеСтарта = "start_unknown";
		Операция.ЗанимаетСлот = Истина;
		Занято = Занято + 1;
		Действия.start.Добавить(ИдОперации);
	КонецЦикла;
	Возврат Действия;
КонецФункции

Функция ПрименитьСтартПланировщика(Планировщик, ИдОперации, Поколение, ОтветСтарта)
	Операция = Планировщик.Операции.Получить(ИдОперации);
	Если Операция = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Если Операция.Поколение <> Поколение Или Операция.СостояниеСтарта <> "start_unknown" Тогда Возврат Ложь; КонецЕсли;
	Операция.СостояниеСтарта = ОтветСтарта.state;
	Операция.ИдЗадания = ОтветСтарта.job_id;
	Операция.АдресРезультата = ОтветСтарта.result_address;
	Если ОтветСтарта.state = "started" Тогда
		Если НЕ Операция.ЗавершениеЗапрошено Тогда Операция.Состояние = "running"; КонецЕсли;
	ИначеЕсли ОтветСтарта.state = "start_unknown" Тогда
		Если НЕ Операция.ЗавершениеЗапрошено Тогда Операция.Состояние = "start_unknown"; КонецЕсли;
	ИначеЕсли ОтветСтарта.state = "not_started" Тогда
		Операция.ЗанимаетСлот = Ложь;
		Если НЕ Операция.ЗавершениеЗапрошено Тогда
			Операция.Результат = Новый Структура("success,error", Ложь, ОтветСтарта.error);
			Операция.Состояние = "result_ready";
		КонецЕсли;
	ИначеЕсли ОтветСтарта.state = "completed_inline" Тогда
		Операция.ЗанимаетСлот = Ложь;
		Если НЕ Операция.ЗавершениеЗапрошено Тогда
			Операция.Результат = ОтветСтарта.result;
			Операция.Состояние = "result_ready";
		КонецЕсли;
		Планировщик.Режим = "draining";
	Иначе
		Операция.СостояниеСтарта = "start_unknown";
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПрименитьЗавершениеЗадания(Планировщик, ИдОперации, Поколение, Результат)
	Операция = Планировщик.Операции.Получить(ИдОперации);
	Если Операция = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Если Операция.Поколение <> Поколение Или НЕ Операция.ЗанимаетСлот Тогда Возврат Ложь; КонецЕсли;
	Операция.ЗанимаетСлот = Ложь;
	Если НЕ Операция.ЗавершениеЗапрошено И НЕ Операция.ОтветВыдан Тогда
		Операция.Результат = Результат;
		Операция.Состояние = "result_ready";
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ВзятьРезультатПланировщика(Планировщик)
	Для Каждого ПараОперации Из Планировщик.Операции Цикл
		Операция = ПараОперации.Значение;
		Если Операция.Состояние = "result_ready" И НЕ Операция.ВыдачаНачата И НЕ Операция.ОтветВыдан Тогда
			Операция.ВыдачаНачата = Истина;
			Операция.Состояние = "finishing";
			Возврат Операция;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЗавершитьВыдачуПланировщика(Планировщик, ИдОперации, Поколение)
	Операция = Планировщик.Операции.Получить(ИдОперации);
	Если Операция = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Если Операция.Поколение <> Поколение Или НЕ Операция.ВыдачаНачата Или Операция.ОтветВыдан Тогда Возврат Ложь; КонецЕсли;
	Операция.ОтветВыдан = Истина;
	Операция.Состояние = "completed";
	Операция.Результат = Неопределено;
	Возврат Истина;
КонецФункции

Функция УдалитьОперациюПланировщика(Планировщик, ИдОперации)
	Операция = Планировщик.Операции.Получить(ИдОперации);
	Если Операция = Неопределено Тогда Возврат Истина; КонецЕсли;
	Если Операция.ЗанимаетСлот Или Операция.ПоискЗанят Или НЕ Операция.ОтветВыдан Или НЕ Операция.РесурсыОсвобождены Тогда Возврат Ложь; КонецЕсли;
	Планировщик.Операции.Удалить(ИдОперации);
	Возврат Истина;
КонецФункции

Процедура ОстановитьПланировщикКоманд(Планировщик, Причина)
	Планировщик.Режим = "draining";
	Планировщик.ПовторноеВключение = Ложь;
	Для Каждого ПараОперации Из Планировщик.Операции Цикл
		ПрерватьОперациюПланировщика(ПараОперации.Значение, Причина);
	КонецЦикла;
КонецПроцедуры

Функция СоздатьИсполнительСправки()
	Возврат Новый Структура("Доступен,Запущен,Остановка,Вызов,ПоследнийОпрос,Ошибка,ОшибокВызова",
		Неопределено, Ложь, Ложь, Неопределено, 0, "", 0);
КонецФункции

Функция ВызовИсполнителяСправки(Исполнитель, Метод, Ид = "")
	Вызов = Новый Структура("Метод,Ид", Метод, Ид);
	Исполнитель.Вызов = Вызов;
	Возврат Вызов;
КонецФункции

Функция СледующийВызовИсполнителяСправки(Исполнитель, Планировщик, Параллельно, Сейчас)
	Если Исполнитель.Вызов <> Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Если Исполнитель.Остановка Тогда Возврат ВызовИсполнителяСправки(Исполнитель, "GetShutdownState"); КонецЕсли;
	Если Исполнитель.Ошибка <> "" И Исполнитель.Запущен Тогда
		// Аварийная остановка не зависит от работоспособности GetSearchStates/CancelSearch.
		Возврат ВызовИсполнителяСправки(Исполнитель, "BeginShutdown");
	КонецЕсли;
	ЕстьЗапрос = Ложь;
	ЕстьПоиск = Ложь;
	Для Каждого Пара Из Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Если Операция.ИсполнительВладельца <> "owner_help" Тогда Продолжить; КонецЕсли;
		Если Операция.ПоискЗанят И Операция.ПоискСостояние = "legacy" Тогда Возврат Неопределено; КонецЕсли;
		Если Операция.Состояние = "owner_running" И НЕ Операция.ПоискЗанят Тогда Возврат Неопределено; КонецЕсли;
		Если Операция.Состояние = "owner_queued" И НЕ Операция.ЗавершениеЗапрошено Тогда ЕстьЗапрос = Истина; КонецЕсли;
		Если НЕ Операция.ПоискЗанят Тогда Продолжить; КонецЕсли;
		ЕстьПоиск = Истина;
		Если Операция.ПоискСостояние = "read" Или Операция.ПоискСостояние = "cancelled" Тогда
			Возврат ВызовИсполнителяСправки(Исполнитель, "AcknowledgeSearch", Операция.Ид);
		КонецЕсли;
		Если Операция.ЗавершениеЗапрошено И НЕ Операция.ПоискОтменаОтправлена Тогда
			Возврат ВызовИсполнителяСправки(Исполнитель, "CancelSearch", Операция.Ид);
		КонецЕсли;
		Если Операция.ПоискСостояние = "succeeded" Или Операция.ПоискСостояние = "failed" Тогда
			Возврат ВызовИсполнителяСправки(Исполнитель, "ReadSearchResult", Операция.Ид);
		КонецЕсли;
	КонецЦикла;
	Если Исполнитель.Остановка Тогда Возврат ВызовИсполнителяСправки(Исполнитель, "GetShutdownState"); КонецЕсли;
	Если НЕ Параллельно Или Исполнитель.Ошибка <> "" Тогда
		Если Исполнитель.Запущен И НЕ ЕстьПоиск Тогда Возврат ВызовИсполнителяСправки(Исполнитель, "BeginShutdown"); КонецЕсли;
	ИначеЕсли ЕстьЗапрос Тогда
		Если Исполнитель.Доступен = Неопределено Тогда Возврат ВызовИсполнителяСправки(Исполнитель, "GetCapabilities"); КонецЕсли;
		Если Исполнитель.Доступен Тогда
			Если НЕ Исполнитель.Запущен Тогда Возврат ВызовИсполнителяСправки(Исполнитель, "StartSearchExecutor"); КонецЕсли;
			Для Каждого Пара Из Планировщик.Операции Цикл
				Операция = Пара.Значение;
				Если Операция.ИсполнительВладельца <> "owner_help" Или Операция.Состояние <> "owner_queued"
					Или Операция.ЗавершениеЗапрошено Тогда Продолжить; КонецЕсли;
				Операция.ПоискЗанят = Истина;
				Операция.ПоискСостояние = "submitting";
				Операция.Состояние = "owner_running";
				Возврат ВызовИсполнителяСправки(Исполнитель, "SubmitSearch", Операция.Ид);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ЕстьПоиск И Сейчас - Исполнитель.ПоследнийОпрос >= 100 Тогда
		Исполнитель.ПоследнийОпрос = Сейчас;
		Возврат ВызовИсполнителяСправки(Исполнитель, "GetSearchStates");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ПринятьОтветИсполнителяСправки(Исполнитель, Планировщик, Знач Вызов, Ответ)
	Если Исполнитель.Вызов <> Вызов Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда ВызватьИсключение "Invalid syntax help response"; КонецЕсли;
	Если НЕ Ответ.Свойство("version") Или Ответ.version <> 1 Тогда ВызватьИсключение "Invalid syntax help protocol"; КонецЕсли;
	Метод = Вызов.Метод;
	Операция = Планировщик.Операции.Получить(Вызов.Ид);
	Если Метод = "GetCapabilities" Тогда
		Исполнитель.Доступен = Ответ.max_workers >= 8 И Ответ.max_requests >= 10;
	ИначеЕсли Метод = "StartSearchExecutor" Тогда
		Если НЕ Ответ.success Тогда ВызватьИсключение "Cannot start syntax help executor"; КонецЕсли;
		Исполнитель.Запущен = Истина;
	ИначеЕсли Метод = "GetSearchStates" Тогда
		Если ТипЗнч(Ответ.items) <> Тип("Массив") Тогда ВызватьИсключение "Invalid search states"; КонецЕсли;
		Для Каждого Состояние Из Ответ.items Цикл
			Запрос = Планировщик.Операции.Получить(Состояние.id);
			Если Запрос = Неопределено Или НЕ Запрос.ПоискЗанят Тогда Продолжить; КонецЕсли;
			Если Запрос.ПоискСостояние = "read" Тогда Продолжить; КонецЕсли;
			Если Состояние.state <> "queued" И Состояние.state <> "running" И Состояние.state <> "succeeded"
				И Состояние.state <> "failed" И Состояние.state <> "cancelled" Тогда ВызватьИсключение "Invalid search state"; КонецЕсли;
			Запрос.ПоискСостояние = Состояние.state;
		КонецЦикла;
		// A failed submit is queried by its original ID, never replayed.
		Для Каждого Пара Из Планировщик.Операции Цикл
			Если Пара.Значение.ПоискСостояние = "submit_unknown" Тогда
				Пара.Значение.ПоискЗанят = Ложь;
				ПрерватьОперациюПланировщика(Пара.Значение, "Search submission could not be confirmed");
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Метод = "BeginShutdown" Тогда
		Если НЕ Ответ.success Тогда ВызватьИсключение "Cannot stop syntax help executor"; КонецЕсли;
		Исполнитель.Остановка = Истина;
	ИначеЕсли Метод = "GetShutdownState" Тогда
		Если Ответ.complete Тогда
			Исполнитель.Остановка = Ложь;
			Исполнитель.Запущен = Ложь;
			Если Исполнитель.Ошибка <> "" Тогда
				Для Каждого Пара Из Планировщик.Операции Цикл
					Запрос = Пара.Значение;
					Если Запрос.ИсполнительВладельца = "owner_help" И Запрос.ПоискЗанят Тогда
						// Join подтверждён. Запись ещё удерживаем до AcknowledgeSearch.
						Запрос.ПоискСостояние = "cancelled";
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Операция = Неопределено Или Ответ.id <> Вызов.Ид Тогда ВызватьИсключение "Invalid syntax help result ID"; КонецЕсли;
		Если Метод = "SubmitSearch" Тогда
			Если Ответ.accepted Тогда
				Операция.ПоискСостояние = "queued";
			ИначеЕсли Ответ.error = "duplicate_id" Тогда
				Операция.ПоискСостояние = "submit_unknown";
			Иначе
				Операция.ПоискЗанят = Ложь;
				ПрерватьОперациюПланировщика(Операция, "Search not accepted: " + Ответ.error);
			КонецЕсли;
		ИначеЕсли Метод = "CancelSearch" Тогда
			Если НЕ Ответ.success Тогда ВызватьИсключение "Cannot cancel syntax help search"; КонецЕсли;
			Операция.ПоискОтменаОтправлена = Истина;
		ИначеЕсли Метод = "ReadSearchResult" Тогда
			Если Ответ.state = "succeeded" Тогда
				Операция.ПоискРезультатJSON = Ответ.result;
			ИначеЕсли Ответ.state = "failed" Или Ответ.state = "cancelled" Тогда
				ПрерватьОперациюПланировщика(Операция, "Syntax help search failed or cancelled: " + Ответ.error);
			Иначе ВызватьИсключение "Search result is not terminal";
			КонецЕсли;
			Операция.ПоискСостояние = "read";
		ИначеЕсли Метод = "AcknowledgeSearch" Тогда
			Если НЕ Ответ.success Тогда ВызватьИсключение "Search is still running"; КонецЕсли;
			Операция.ПоискЗанят = Ложь;
			Операция.ПоискСостояние = "released";
			Если НЕ Операция.ЗавершениеЗапрошено Тогда Операция.Состояние = "owner_ready"; КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Исполнитель.Вызов = Неопределено;
	Исполнитель.ОшибокВызова = 0;
КонецПроцедуры

Процедура ОшибкаВызоваИсполнителяСправки(Исполнитель, Планировщик, Знач Вызов)
	Если Исполнитель.Вызов <> Вызов Тогда Возврат; КонецЕсли;
	Исполнитель.Вызов = Неопределено;
	Исполнитель.ОшибокВызова = Исполнитель.ОшибокВызова + 1;
	Если (Вызов.Метод = "ReadSearchResult" Или Вызов.Метод = "AcknowledgeSearch"
		Или Вызов.Метод = "GetSearchStates" Или Вызов.Метод = "CancelSearch") И Исполнитель.ОшибокВызова <= 2 Тогда
		// These operations are idempotent. Retain the original search and retry the read/ack, never Submit.
		Возврат;
	КонецЕсли;
	Если Вызов.Метод = "GetCapabilities" Тогда
		Исполнитель.Доступен = Ложь;
		Возврат;
	КонецЕсли;
	Исполнитель.Ошибка = "Syntax help executor call failed: " + Вызов.Метод;
	Если Вызов.Метод = "StartSearchExecutor" Тогда Исполнитель.Запущен = Истина; КонецЕсли;
	Для Каждого Пара Из Планировщик.Операции Цикл
		Операция = Пара.Значение;
		Если Операция.ИсполнительВладельца <> "owner_help" Тогда Продолжить; КонецЕсли;
		ПрерватьОперациюПланировщика(Операция, Исполнитель.Ошибка);
		Если Операция.ПоискЗанят И Операция.ПоискСостояние = "submitting" Тогда Операция.ПоискСостояние = "submit_unknown"; КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СборкаПараллельногоЯдра() Экспорт
	Возврат "dd211b31ff02ec0559d410c54fd6a01b65ebc22380d47fac4eb9c102bd068cd8";
КонецФункции

Функция ВерсияПараллельногоПротокола() Экспорт
	Возврат 1;
КонецФункции

Функция ВыполнитьФоновуюКоманду(ПакетКоманды) Экспорт
	ПроверитьУправляющееЗаданиеКоманды(ПакетКоманды);
	Если ПакетКоманды.protocol <> ВерсияПараллельногоПротокола()
		Или ПакетКоманды.build <> СборкаПараллельногоЯдра() Тогда
		ВызватьИсключение "MCP parallel worker build mismatch; command not executed";
	КонецЕсли;
	Если ПакетКоманды.user <> ИмяПользователя() Тогда
		ВызватьИсключение "MCP parallel worker user mismatch; command not executed";
	КонецЕсли;
	Если ПривилегированныйРежим() <> ПакетКоманды.privileged Тогда
		ВызватьИсключение "MCP parallel worker privilege mismatch; command not executed";
	КонецЕсли;
	Если ПакетКоманды.safe_mode И НЕ БезопасныйРежим() Тогда
		ВызватьИсключение "MCP parallel worker safe mode mismatch; command not executed";
	КонецЕсли;
	Если ПакетКоманды.deadline <= ТекущаяУниверсальнаяДата() Тогда
		ВызватьИсключение "Operation expired before worker execution; command not executed";
	КонецЕсли;
	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Конверт = Новый Структура("protocol,build,instance,generation,id,user,safe_mode,privileged,background,body,cache",
		ВерсияПараллельногоПротокола(), СборкаПараллельногоЯдра(), ПакетКоманды.instance,
		ПакетКоманды.generation, ПакетКоманды.id, ИмяПользователя(), БезопасныйРежим(),
		ПривилегированныйРежим(), ФоновоеЗадание <> Неопределено, Неопределено, Неопределено);
	Если ПакетКоманды.probe Тогда
		Конверт.body = Новый Структура("success,data", Истина, "MCP_PARALLEL_READY");
		ПоместитьВоВременноеХранилище(Конверт, ПакетКоманды.result_address);
		Возврат Конверт;
	КонецЕсли;
	Если НЕ ЭтоСервернаяКомандаПланировщика(ПакетКоманды.command) Тогда
		ВызватьИсключение "Client command cannot run in a background job";
	КонецЕсли;
	ЛокальныеАдреса = Новый Массив;
	Попытка
		КомандаРабочая = КопироватьПакетПланировщика(ПакетКоманды.command);
		КомандаРабочая.Удалить("ВладелецКэшаМетаданных");
		ИмпортироватьКэшВРабочуюКоманду(КомандаРабочая, ПакетКоманды.cache, ЛокальныеАдреса);
		ПроверитьУправляющееЗаданиеКоманды(ПакетКоманды);
		Конверт.body = ВыполнитьКомандуНаСервере(КомандаРабочая);
		Конверт.cache = ЭкспортироватьКэшРабочейКоманды(КомандаРабочая, Конверт.body, ПакетКоманды.cache, ЛокальныеАдреса);
	Исключение
		Конверт.body = Новый Структура("success,error", Ложь, ОписаниеОшибки());
	КонецПопытки;
	// Эта обёртка не меняет привилегированный режим. Включения во вложенных
	// вызовах платформа снимает при выходе из них; здесь нет своего включения для снятия.
	Для Каждого АдресРабочий Из ЛокальныеАдреса Цикл
		Попытка УдалитьИзВременногоХранилища(АдресРабочий); Исключение КонецПопытки;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(Конверт, ПакетКоманды.result_address);
	Возврат Конверт;
КонецФункции

Процедура ПроверитьУправляющееЗаданиеКоманды(ПакетКоманды)
	// В обычном клиентском режиме поля нет: прежний путь остаётся прежним.
	Если НЕ ПакетКоманды.Свойство("controller_job") Тогда Возврат; КонецЕсли;
	Управляющее = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ПакетКоманды.controller_job));
	Если Управляющее = Неопределено Или Управляющее.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
		ВызватьИсключение "Server controller has ended; command not executed";
	КонецЕсли;
	Текущее = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если Текущее = Неопределено Или Строка(Текущее.УникальныйИдентификатор) = ПакетКоманды.controller_job Тогда
		ВызватьИсключение "Worker must run in a separate background job";
	КонецЕсли;
КонецПроцедуры

Процедура ВыполнитьФайловуюКоманду(ПакетКоманды, АдресРезультата) Экспорт
	Если НЕ ЗначениеЗаполнено(АдресРезультата) Тогда ВызватьИсключение "Missing parallel result address"; КонецЕсли;
	Конверт = ВыполнитьФоновуюКоманду(ПакетКоманды);
	ПоместитьВоВременноеХранилище(Конверт, АдресРезультата);
КонецПроцедуры

Функция ПодготовитьКэшДляЗадания(КомандаПодготовленная, КлючДеталей)
	Если КомандаПодготовленная.tool <> "get_metadata" Тогда Возврат Неопределено; КонецЕсли;
	Опции = КомандаПодготовленная.params;
	ИмяРасширения = Неопределено;
	Если НЕ Опции.Свойство("extension_name", ИмяРасширения) Тогда Возврат Неопределено; КонецЕсли;
	Если ТипЗнч(ИмяРасширения) <> Тип("Строка") Или ПустаяСтрока(ИмяРасширения) Тогда Возврат Неопределено; КонецЕсли;
	ПакетКэша = Новый Структура("extension,hash,key,data,index,details", ИмяРасширения, "", КлючДеталей,
		Неопределено, Неопределено, Неопределено);
	Опции.Свойство("mcp_cache_hash", ПакетКэша.hash);
	// Готовая деталь/индекс не требуют пересылки бинарника расширения на каждом попадании.
	ПоляКэша = Новый Массив;
	ПоляКэша.Добавить("details"); ПоляКэша.Добавить("index"); ПоляКэша.Добавить("data");
	Для Каждого ПолеКэша Из ПоляКэша Цикл
		Если ПолеКэша = "details" И ПустаяСтрока(КлючДеталей) Тогда Продолжить; КонецЕсли;
		Если ПолеКэша = "index" И НЕ ПустаяСтрока(КлючДеталей) Тогда Продолжить; КонецЕсли;
		АдресКэша = Неопределено;
		Если Опции.Свойство("mcp_cache_" + ПолеКэша + "_token", АдресКэша) И ЗначениеЗаполнено(АдресКэша) Тогда
			Попытка ДанныеКэша = ПолучитьИзВременногоХранилища(АдресКэша); Исключение ДанныеКэша = Неопределено; КонецПопытки;
			Если ДанныеКэша <> Неопределено Тогда
				ПакетКэша.Вставить(ПолеКэша, ДанныеКэша);
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ПакетКэша;
КонецФункции

Процедура ИмпортироватьКэшВРабочуюКоманду(КомандаРабочая, ПакетКэша, ЛокальныеАдреса)
	Если КомандаРабочая.tool <> "get_metadata" Тогда Возврат; КонецЕсли;
	Опции = КомандаРабочая.params;
	ПоляКэша = Новый Массив;
	ПоляКэша.Добавить("data"); ПоляКэша.Добавить("index"); ПоляКэша.Добавить("details");
	Для Каждого ПолеКэша Из ПоляКэша Цикл Опции.Удалить("mcp_cache_" + ПолеКэша + "_token"); КонецЦикла;
	Опции.Удалить("mcp_cache_hash");
	Если ПакетКэша = Неопределено Тогда Возврат; КонецЕсли;
	// Отдельный владелец локальных данных задания; они удаляются до завершения задания.
	КомандаРабочая.Вставить("ВладелецКэшаМетаданных", Новый УникальныйИдентификатор);
	Опции.Вставить("mcp_cache_hash", ПакетКэша.hash);
	Для Каждого ПолеКэша Из ПоляКэша Цикл
		ДанныеКэша = ПакетКэша[ПолеКэша];
		Если ДанныеКэша <> Неопределено Тогда
			АдресКэша = ПоместитьВоВременноеХранилище(ДанныеКэша, КомандаРабочая.ВладелецКэшаМетаданных);
			ЛокальныеАдреса.Добавить(АдресКэша);
			Опции.Вставить("mcp_cache_" + ПолеКэша + "_token", АдресКэша);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЭкспортироватьКэшРабочейКоманды(КомандаРабочая, ОтветКоманды, ВходнойКэш, ЛокальныеАдреса)
	Если ВходнойКэш = Неопределено Или ОтветКоманды = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	ОбновлениеКэша = Новый Структура("extension,hash,key,data,index,details", ВходнойКэш.extension, "", ВходнойКэш.key,
		Неопределено, Неопределено, Неопределено);
	ОтветКоманды.Свойство("mcp_cache_hash", ОбновлениеКэша.hash);
	ПоляКэша = Новый Массив;
	ПоляКэша.Добавить("data"); ПоляКэша.Добавить("index"); ПоляКэша.Добавить("details");
	Для Каждого ПолеКэша Из ПоляКэша Цикл
		АдресКэша = Неопределено;
		Если ОтветКоманды.Свойство("mcp_cache_" + ПолеКэша + "_token", АдресКэша) И ЗначениеЗаполнено(АдресКэша) Тогда
			Если ЛокальныеАдреса.Найти(АдресКэша) = Неопределено Тогда ЛокальныеАдреса.Добавить(АдресКэша); КонецЕсли;
			ВходнойАдрес = Неопределено;
			КомандаРабочая.params.Свойство("mcp_cache_" + ПолеКэша + "_token", ВходнойАдрес);
			// Не возвращаем назад тот же большой индекс/бинарник, если он не изменился.
			Если АдресКэша <> ВходнойАдрес Или ОбновлениеКэша.hash <> ВходнойКэш.hash Тогда
				ОбновлениеКэша.Вставить(ПолеКэша, ПолучитьИзВременногоХранилища(АдресКэша));
			КонецЕсли;
		КонецЕсли;
		ОтветКоманды.Удалить("mcp_cache_" + ПолеКэша + "_token");
	КонецЦикла;
	ОтветКоманды.Удалить("mcp_cache_hash");
	Возврат ОбновлениеКэша;
КонецФункции

Функция СохранитьКэшИзЗадания(АдресРезультата, ВладелецКэша, ОжидаемыйКэш)
	РезультатКэша = Новый Структура;
	// Читаем серверные значения непосредственно в родительском сеансе: индекс
	// (ТаблицаЗначений) и бинарник расширения не должны проходить через тонкий клиент.
	Конверт = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если Конверт = Неопределено Тогда Возврат РезультатКэша; КонецЕсли;
	Если Конверт.id <> ОжидаемыйКэш.id Или Конверт.instance <> ОжидаемыйКэш.instance
		Или Конверт.generation <> ОжидаемыйКэш.generation
		Или Конверт.build <> СборкаПараллельногоЯдра()
		Или Конверт.protocol <> ВерсияПараллельногоПротокола()
		Или Конверт.user <> ИмяПользователя() Тогда ВызватьИсключение "Invalid worker cache identity"; КонецЕсли;
	ОбновлениеКэша = Конверт.cache;
	Если ОбновлениеКэша = Неопределено Тогда Возврат РезультатКэша; КонецЕсли;
	Если ОбновлениеКэша.extension <> ОжидаемыйКэш.extension Или ОбновлениеКэша.key <> ОжидаемыйКэш.key
		Или ОбновлениеКэша.hash <> ОжидаемыйКэш.hash Тогда ВызватьИсключение "Invalid worker cache route"; КонецЕсли;
	// Проверяется текущая версия расширения, а не порядок окончания заданий.
	Расширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", ОбновлениеКэша.extension));
	Если Расширения.Количество() <> 1 Тогда Возврат РезультатКэша; КонецЕсли;
	Если ПолучитьХешРасширенияСтрокой(Расширения[0]) <> ОбновлениеКэша.hash Тогда Возврат РезультатКэша; КонецЕсли;
	РезультатКэша.Вставить("mcp_cache_hash", ОбновлениеКэша.hash);
	ПоляКэша = Новый Массив;
	ПоляКэша.Добавить("data"); ПоляКэша.Добавить("index"); ПоляКэша.Добавить("details");
	СозданныеАдреса = Новый Массив;
	Попытка
		Для Каждого ПолеКэша Из ПоляКэша Цикл
			Если ОбновлениеКэша[ПолеКэша] <> Неопределено Тогда
				АдресКэша = СохранитьКэшРасширения(ОбновлениеКэша[ПолеКэша], Новый Структура("owner", ВладелецКэша));
				Если АдресКэша <> Неопределено Тогда
					СозданныеАдреса.Добавить(АдресКэша);
					РезультатКэша.Вставить("mcp_cache_" + ПолеКэша + "_token", АдресКэша);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Для Каждого АдресКэша Из СозданныеАдреса Цикл
			Попытка УдалитьИзВременногоХранилища(АдресКэша); Исключение КонецПопытки;
		КонецЦикла;
		Возврат Новый Структура;
	КонецПопытки;
	Возврат РезультатКэша;
КонецФункции

Функция ЭтоФайловаяБазаДляПараллельности()
	Возврат Найти(НРег(СтрокаСоединенияИнформационнойБазы()), "file=") > 0;
КонецФункции

Функция ВозможностиПараллельногоВыполнения(Владелец, КонтекстРегистрации = Неопределено)
	Ответ = Новый Структура("available,adapter,reason,bsp,safe_mode,user,privileged", Ложь, "", "", "",
		БезопасныйРежим(), ИмяПользователя(), ПривилегированныйРежим());
	// До любого обращения к БСП или подготовки файла.
	Если ЭтоФайловаяБазаДляПараллельности() Тогда
		Ответ.reason = "Параллельное выполнение доступно только в клиент-серверной базе";
		Возврат Ответ;
	КонецЕсли;
	Попытка
		МодульВерсии = Вычислить("СтандартныеПодсистемыСервер");
		Ответ.bsp = МодульВерсии.ВерсияБиблиотеки();
		ЧастиВерсии = РазделитьСтрокуПоРазделителю(Ответ.bsp, ".");
		Если ЧастиВерсии.Количество() < 2 Тогда ВызватьИсключение "Неизвестная версия БСП"; КонецЕсли;
		Если Число(ЧастиВерсии[0]) = 2 И Число(ЧастиВерсии[1]) = 1 Тогда
			Если КонтекстРегистрации = Неопределено Тогда
				Ответ.reason = "На БСП 2.1 параллельное выполнение доступно при открытии MCP Toolkit из дополнительных отчётов и обработок";
				Возврат Ответ;
			КонецЕсли;
			Попытка
				ПроверитьРегистрациюДляЗаданияБСП21(КонтекстРегистрации);
				Если Ответ.privileged Тогда ВызватьИсключение "Параллельное выполнение недоступно из привилегированного контекста"; КонецЕсли;
				Ответ.adapter = "bsp21_registered";
				Ответ.available = Истина;
			Исключение Ответ.reason = ОписаниеОшибки(); КонецПопытки;
			Возврат Ответ;
		КонецЕсли;
		Если Число(ЧастиВерсии[0]) < 2 Или (Число(ЧастиВерсии[0]) = 2 И Число(ЧастиВерсии[1]) < 1) Тогда
			Ответ.reason = "Требуется БСП 2.2 или новее";
			Возврат Ответ;
		КонецЕсли;
	Исключение
		Ответ.reason = "Не удалось определить поддерживаемую версию БСП: " + ОписаниеОшибки();
		Возврат Ответ;
	КонецПопытки;
	Если Метаданные.ОбщиеМодули.Найти("ДлительныеОперации") = Неопределено Тогда
		Ответ.reason = "Не найдена подсистема длительных операций БСП";
		Возврат Ответ;
	КонецЕсли;
	МодульБСП = Вычислить("ДлительныеОперации");
	Попытка
		Опции = МодульБСП.ПараметрыВыполненияФункции(Владелец);
		Если Опции.Свойство("ВнешнийОтчетОбработка") И Опции.Свойство("КлючФоновогоЗадания") Тогда
			Ответ.adapter = "binary";
		КонецЕсли;
	Исключение КонецПопытки;
	Если Ответ.adapter = "" Тогда
		Попытка
			Опции = МодульБСП.ПараметрыВыполненияВФоне(Владелец);
			Если Опции.Свойство("КлючФоновогоЗадания") Тогда Ответ.adapter = "bsp_file"; КонецЕсли;
		Исключение КонецПопытки;
	КонецЕсли;
	Если Ответ.adapter = "" Тогда Ответ.adapter = "platform_file"; КонецЕсли;
	Ответ.available = Истина;
	Возврат Ответ;
КонецФункции

Функция ПодготовитьСредуПараллельногоВыполнения(ДвоичныеОбработки, Владелец, Экземпляр, Поколение, Сборка, КонтекстРегистрации = Неопределено)
	Возможности = ВозможностиПараллельногоВыполнения(Владелец, КонтекстРегистрации);
	Если НЕ Возможности.available Тогда ВызватьИсключение Возможности.reason; КонецЕсли;
	Если Сборка <> СборкаПараллельногоЯдра() Тогда ВызватьИсключение "Loaded client/server core build mismatch"; КонецЕсли;
	Среда = Новый Структура("owner,instance,generation,build,adapter,bsp,user,safe_mode,privileged,binary_address,file_path,file_id,ready",
		Владелец, Экземпляр, Поколение, Сборка, Возможности.adapter, Возможности.bsp,
		Возможности.user, Возможности.safe_mode, Возможности.privileged, "", "", Строка(Новый УникальныйИдентификатор), Ложь);
	Если Среда.adapter = "bsp21_registered" Тогда
		Среда.file_id = "";
		Среда.Вставить("registration_context", КопироватьПакетПланировщика(КонтекстРегистрации));
		Возврат Среда;
	КонецЕсли;
	Попытка
		Среда.binary_address = ПоместитьВоВременноеХранилище(ДвоичныеОбработки, Владелец);
		Если Среда.adapter <> "binary" Тогда
			Среда.file_path = КаталогВременныхФайлов() + "mcp-parallel-" + Среда.file_id + ".epf";
			ДвоичныеОбработки.Записать(Среда.file_path);
			ОбъектПроверки = ВнешниеОбработки.Создать(Среда.file_path, Среда.safe_mode);
			Если ОбъектПроверки.СборкаПараллельногоЯдра() <> Сборка Тогда
				ВызватьИсключение "На диске другая сборка обработки; параллельное выполнение не включено";
			КонецЕсли;
			ОбъектПроверки = Неопределено;
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если Среда.binary_address <> "" Тогда
			Попытка УдалитьИзВременногоХранилища(Среда.binary_address); Исключение КонецПопытки;
		КонецЕсли;
		Если Среда.file_path <> "" Тогда
			Попытка УдалитьФайлы(Среда.file_path); Исключение КонецПопытки;
		КонецЕсли;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	Возврат Среда;
КонецФункции

Функция ПодготовитьПакетФоновойКоманды(Среда, ИдОперации, КлючЗапуска, Команда, КлючДеталей, ОстатокСекунд, ЭтоПроба = Ложь)
	Если ЭтоФайловаяБазаДляПараллельности() Тогда ВызватьИсключение "Parallel execution requires a client/server infobase"; КонецЕсли;
	Если Среда.user <> ИмяПользователя() Или Среда.build <> СборкаПараллельногоЯдра() Тогда
		ВызватьИсключение "Parallel environment changed; command not started";
	КонецЕсли;
	Если НЕ ЭтоПроба И НЕ Среда.ready Тогда ВызватьИсключение "Parallel environment not verified"; КонецЕсли;
	Если ОстатокСекунд <= 0 Тогда ВызватьИсключение "Operation expired before preparation"; КонецЕсли;
	ПакетКэша = Неопределено;
	Если НЕ ЭтоПроба Тогда ПакетКэша = ПодготовитьКэшДляЗадания(Команда, КлючДеталей); КонецЕсли;
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Среда.owner);
	ПакетКоманды = Новый Структура("protocol,build,instance,generation,id,key,user,safe_mode,privileged,command,cache,probe,result_address,deadline",
		ВерсияПараллельногоПротокола(), Среда.build, Среда.instance, Среда.generation, ИдОперации, КлючЗапуска,
		Среда.user, Среда.safe_mode, Среда.privileged, Команда, ПакетКэша, ЭтоПроба, АдресРезультата,
		ТекущаяУниверсальнаяДата() + ОстатокСекунд);
	Если Среда.Свойство("controller_job") Тогда ПакетКоманды.Вставить("controller_job", Среда.controller_job); КонецЕсли;
	Попытка
		АдресПакета = ПоместитьВоВременноеХранилище(ПакетКоманды, Среда.owner);
	Исключение
		УдалитьИзВременногоХранилища(АдресРезультата);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("packet_address,result_address", АдресПакета, АдресРезультата);
КонецФункции

Процедура ПроверитьКонтекстРегистрацииБСП21(КонтекстРегистрации)
	Если ТипЗнч(КонтекстРегистрации) <> Тип("Структура") Тогда
		ВызватьИсключение "Не передан контекст регистрации фонового задания БСП 2.1.";
	КонецЕсли;
	ПоляКонтекста = Новый Структура("registration,binary_hash,source", "СправочникСсылка.ДополнительныеОтчетыИОбработки", "Строка", "Строка");
	Для Каждого ПолеКонтекста Из ПоляКонтекста Цикл
		ЗначениеПоля = Неопределено;
		Если НЕ КонтекстРегистрации.Свойство(ПолеКонтекста.Ключ, ЗначениеПоля) Тогда
			ВызватьИсключение "Не заполнен контекст регистрации фонового задания.";
		КонецЕсли;
		Если ПолеКонтекста.Ключ = "binary_hash" И ТипЗнч(ЗначениеПоля) = Тип("Строка") И ПустаяСтрока(ЗначениеПоля) Тогда
			ВызватьИсключение "Не удалось подтвердить сборку открытой обработки. Откройте MCP Toolkit из дополнительных обработок в новом сеансе.";
		КонецЕсли;
		Если ТипЗнч(ЗначениеПоля) <> Тип(ПолеКонтекста.Значение) Или НЕ ЗначениеЗаполнено(ЗначениеПоля) Тогда
			ВызватьИсключение "Неверный контекст регистрации фонового задания.";
		КонецЕсли;
	КонецЦикла;
	Если КонтекстРегистрации.source <> "form" И КонтекстРегистрации.source <> "server" Тогда
		ВызватьИсключение "Неизвестный источник фонового задания.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРегистрациюДляЗаданияБСП21(КонтекстРегистрации)
	ПроверитьКонтекстРегистрацииБСП21(КонтекстРегистрации);
	// Читаем запросом, не создавая объект карточки и не записывая её при запуске заданий.
	Запрос = Новый Запрос("ВЫБРАТЬ Регистрация.ХранилищеОбработки, Регистрация.Публикация, Регистрация.ПометкаУдаления,
	| КомандыРегистрации.ВариантЗапуска
	| ИЗ Справочник.ДополнительныеОтчетыИОбработки КАК Регистрация
	| ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.Команды КАК КомандыРегистрации
	| ПО КомандыРегистрации.Ссылка = Регистрация.Ссылка И КомандыРегистрации.Идентификатор = &Команда
	| ГДЕ Регистрация.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", КонтекстРегистрации.registration);
	Запрос.УстановитьПараметр("Команда", "ВыполнитьФоновуюКомандуMCP");
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда ВызватьИсключение "Регистрация MCP Toolkit недоступна."; КонецЕсли;
	Если Выборка.ПометкаУдаления Или Выборка.Публикация <> Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется Тогда
		ВызватьИсключение "Регистрация MCP Toolkit снята с публикации или помечена на удаление.";
	КонецЕсли;
	Если Выборка.ВариантЗапуска = Null Или Выборка.ВариантЗапуска <> Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода Тогда
		ВызватьИсключение "В регистрации нет служебной команды фонового задания MCP. Обновите зарегистрированную обработку.";
	КонецЕсли;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Выборка.ХранилищеОбработки.Получить());
	Если Base64Строка(Хеширование.ХешСумма) <> КонтекстРегистрации.binary_hash Тогда
		ВызватьИсключение "Зарегистрированная сборка MCP Toolkit изменилась. Откройте обработку заново; для серверного режима пересохраните настройки.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПакетЗаданияБСП21(КонтекстРегистрации, ПакетКоманды)
	ПроверитьКонтекстРегистрацииБСП21(КонтекстРегистрации);
	Если ТипЗнч(ПакетКоманды) <> Тип("Структура") Тогда ВызватьИсключение "Неверный пакет фонового задания БСП 2.1."; КонецЕсли;
	ПоляПакета = Новый Структура("protocol,build,instance,generation,id,key,user,safe_mode,privileged,command,probe,result_address,deadline",
		"Число", "Строка", "Строка", "Число", "Строка", "Строка", "Строка", "Булево", "Булево", "Структура", "Булево", "Строка", "Дата");
	Для Каждого ПолеПакета Из ПоляПакета Цикл
		ЗначениеПоля = Неопределено;
		Если НЕ ПакетКоманды.Свойство(ПолеПакета.Ключ, ЗначениеПоля) Тогда
			ВызватьИсключение "Не заполнен пакет фонового задания.";
		КонецЕсли;
		Если ТипЗнч(ЗначениеПоля) <> Тип(ПолеПакета.Значение) Тогда ВызватьИсключение "Неверный тип поля пакета фонового задания."; КонецЕсли;
	КонецЦикла;
	Если КонтекстРегистрации.source = "form" Тогда
		Если ПакетКоманды.Свойство("controller_job") Тогда ВызватьИсключение "Серверный пакет нельзя выполнять как задание формы."; КонецЕсли;
	ИначеЕсли КонтекстРегистрации.source = "server" Тогда
		Родитель = Неопределено;
		Если НЕ ПакетКоманды.Свойство("controller_job", Родитель) Тогда ВызватьИсключение "Не указан управляющий сервер."; КонецЕсли;
		Если ТипЗнч(Родитель) <> Тип("Строка") Или ПустаяСтрока(Родитель) Тогда ВызватьИсключение "Неверное управляющее задание."; КонецЕсли;
	Иначе
		ВызватьИсключение "Неизвестный источник фонового задания.";
	КонецЕсли;
	Если ПакетКоманды.protocol <> ВерсияПараллельногоПротокола() Или ПакетКоманды.build <> СборкаПараллельногоЯдра()
		Или ПакетКоманды.user <> ИмяПользователя() Тогда ВызватьИсключение "Изменились сборка или пользователь фонового задания."; КонецЕсли;
	Если ПривилегированныйРежим() Или ПакетКоманды.privileged
		Или (ПакетКоманды.safe_mode И НЕ БезопасныйРежим()) Тогда ВызватьИсключение "Не подтверждён безопасный контекст фонового задания."; КонецЕсли;
	Если ПустаяСтрока(ПакетКоманды.instance) Или ПустаяСтрока(ПакетКоманды.id) Или ПустаяСтрока(ПакетКоманды.key)
		Или НЕ ЭтоАдресВременногоХранилища(ПакетКоманды.result_address) Тогда ВызватьИсключение "Неверный адрес результата или ключ фонового задания."; КонецЕсли;
	Если ПакетКоманды.deadline <= ТекущаяУниверсальнаяДата() Тогда ВызватьИсключение "Истёк срок фонового задания."; КонецЕсли;
КонецПроцедуры

Функция НачатьЗарегистрированноеЗаданиеБСП21(КонтекстРегистрации, ДескрипторПакета)
	Ответ = Новый Структура("state,job_id,result_address,bsp_result_address,error,result",
		"not_started", Неопределено, ДескрипторПакета.result_address, "", "", Неопределено);
	Попытка
		ПакетКоманды = ПолучитьИзВременногоХранилища(ДескрипторПакета.packet_address);
		ПроверитьПакетЗаданияБСП21(КонтекстРегистрации, ПакетКоманды);
		Если ЭтоФайловаяБазаДляПараллельности() Тогда ВызватьИсключение "Параллельное выполнение доступно только в клиент-серверной базе."; КонецЕсли;
		Если ДескрипторПакета.result_address <> ПакетКоманды.result_address Тогда ВызватьИсключение "Не совпадает адрес результата фонового задания."; КонецЕсли;
		ПроверитьРегистрациюДляЗаданияБСП21(КонтекстРегистрации);
		ПакетЗапуска = Новый Структура("registration,binary_hash,source,packet",
			КонтекстРегистрации.registration, КонтекстРегистрации.binary_hash, КонтекстРегистрации.source, ПакетКоманды);
		ОпцииЗапуска = Новый Структура("ДополнительнаяОбработкаСсылка,ИдентификаторКоманды,ПакетMCP",
			КонтекстРегистрации.registration, "ВыполнитьФоновуюКомандуMCP", ПакетЗапуска);
		АргументыЗапуска = Новый Массив;
		АргументыЗапуска.Добавить(ОпцииЗапуска);
		// Собственный адрес результата уже находится в пакете. БСП не должна его перезаписывать.
		АргументыЗапуска.Добавить(Неопределено);
	Исключение Ответ.error = ОписаниеОшибки(); Возврат Ответ; КонецПопытки;
	Ответ.state = "start_unknown";
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ДополнительныеОтчетыИОбработки.ВыполнитьКоманду",
			АргументыЗапуска, ПакетКоманды.key, "MCP " + ПакетКоманды.id);
		Ответ.job_id = Задание.УникальныйИдентификатор;
		Ответ.state = "started";
	Исключение Ответ.error = ОписаниеОшибки(); КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция НачатьПараллельноеЗадание(Среда, ДескрипторПакета)
	Ответ = Новый Структура("state,job_id,result_address,bsp_result_address,error,result",
		"not_started", Неопределено, ДескрипторПакета.result_address, "", "", Неопределено);
	Попытка
		ПакетКоманды = ПолучитьИзВременногоХранилища(ДескрипторПакета.packet_address);
		Если ПакетКоманды = Неопределено Тогда ВызватьИсключение "Prepared command packet is no longer available"; КонецЕсли;
	Исключение Ответ.error = ОписаниеОшибки(); Возврат Ответ; КонецПопытки;
	Если ЭтоФайловаяБазаДляПараллельности() Тогда Ответ.error = "Parallel execution requires a client/server infobase"; Возврат Ответ; КонецЕсли;
	Если Среда.build <> СборкаПараллельногоЯдра() Или ПакетКоманды.build <> Среда.build
