Функция СхемаGetBslSyntaxHelp()
	Свойства = Новый Структура;

	СвойствоKeywords = Новый Структура;
	СвойствоKeywords.Вставить("type", "array");
	СвойствоKeywords.Вставить("items", Новый Структура("type", "string"));
	СвойствоKeywords.Вставить("description",
		"Search keywords or single full breadcrumb path to follow a link");
	Свойства.Вставить("keywords", СвойствоKeywords);

	МассивMatch = Новый Массив;
	МассивMatch.Добавить("all");
	МассивMatch.Добавить("any");
	СвойствоMatch = Новый Структура;
	СвойствоMatch.Вставить("type", "string");
	СвойствоMatch.Вставить("enum", МассивMatch);
	СвойствоMatch.Вставить("default", "all");
	СвойствоMatch.Вставить("description", "Keyword matching: all (default) or any");
	Свойства.Вставить("match", СвойствоMatch);

	СвойствоLimit = Новый Структура;
	СвойствоLimit.Вставить("type", "integer");
	СвойствоLimit.Вставить("default", 100);
	СвойствоLimit.Вставить("description", "Maximum number of candidates to return (1–300, default 100).");
	Свойства.Вставить("limit", СвойствоLimit);

	СвойствоOffset = Новый Структура;
	СвойствоOffset.Вставить("type", "integer");
	СвойствоOffset.Вставить("default", 0);
	СвойствоOffset.Вставить("description", "Number of candidates to skip (default 0). For next page use offset += limit.");
	Свойства.Вставить("offset", СвойствоOffset);

	СвойствоContentPage = Новый Структура;
	СвойствоContentPage.Вставить("type", "integer");
	СвойствоContentPage.Вставить("default", 1);
	СвойствоContentPage.Вставить("description", "Page number of content (1-based, default 1). If content_has_more is true, call again with content_page + 1.");
	Свойства.Вставить("content_page", СвойствоContentPage);

	Требуемые = Новый Массив;
	Требуемые.Добавить("keywords");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Требуемые);
	Возврат Схема;
КонецФункции

Функция ОписаниеToolGetBslSyntaxHelp() Экспорт
	М = Новый Массив;
	М.Добавить("Get syntax reference for 1C BSL language.");
	М.Добавить("");
	М.Добавить("Search by keywords to find built-in functions, methods, types and language constructs.");
	М.Добавить("Returns candidates (unique breadcrumb paths) and Markdown content when exactly one breadcrumb matches.");
	М.Добавить("If the single match is a navigation section (no content, has sub-topics), returns its sub-topics as candidates instead.");
	М.Добавить("Candidate paths (e.g. ""Массив/Методы/Найти"") and Markdown link targets from content (format: [Title](topic:Path)) can be used as keywords for exact lookup — pass the full string including the topic: prefix as-is.");
	М.Добавить("When searching for members of a type, include ""Методы"", ""Свойства"", or ""Конструкторы"" in keywords.");
	М.Добавить("Supports pagination: use limit (default 100) and offset (default 0) to page through results.");
	М.Добавить("Response includes total, offset, limit, has_more. If has_more is true, call again with offset += limit.");
	М.Добавить("If multiple candidates are returned — add more specific keywords to narrow down, or use pagination to browse all matches.");
	М.Добавить("When content is returned, it may be paginated. If content_has_more is true, call again with content_page + 1.");
	М.Добавить("");
	М.Добавить("Args:");
	М.Добавить("    keywords: List of search keywords, or a single candidate path / link from content for exact lookup");
	М.Добавить("    match: ""all"" (default) — all keywords must match; ""any"" — any keyword matches");
	М.Добавить("    limit: Maximum number of candidates to return (1–300, default 100)");
	М.Добавить("    offset: Number of candidates to skip for pagination (default 0)");
	М.Добавить("    content_page: Page number of content to return (1-based, default 1)");
	М.Добавить("");
	М.Добавить("Returns:");
	М.Добавить("    Dictionary with:");
	М.Добавить("    - success: Boolean indicating if the request was successful");
	М.Добавить("    - data.candidates: paged slice of matching breadcrumb paths");
	М.Добавить("    - data.total: total number of matching candidates (before pagination)");
	М.Добавить("    - data.offset: the offset used for this response");
	М.Добавить("    - data.limit: the limit used for this response");
	М.Добавить("    - data.has_more: true if more candidates exist beyond this page");
	М.Добавить("    - data.content: Markdown text page (only when total==1 and offset==0), else null");
	М.Добавить("    - data.content_page: current page of content (only when content is not null)");
	М.Добавить("    - data.content_total_pages: total number of content pages (only when content is not null)");
	М.Добавить("    - data.content_has_more: true if more content pages exist (only when content is not null)");
	М.Добавить("");
	М.Добавить("Example:");
	М.Добавить("    # Search by keyword");
	М.Добавить("    keywords=[""Найти""]");
	М.Добавить("");
	М.Добавить("    # Narrow down with multiple keywords");
	М.Добавить("    keywords=[""Найти"", ""Массив""]");
	М.Добавить("");
	М.Добавить("    # Use a candidate path for exact lookup");
