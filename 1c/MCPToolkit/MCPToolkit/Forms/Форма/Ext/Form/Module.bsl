&НаКлиенте
Функция ПолучитьСкриншот(ПараметрыSnap)
	Если КомпонентаScreenCapture = Неопределено Тогда
		Возврат Новый Структура("success,error", Ложь, "ScreenCapture AddIn не загружен");
	КонецЕсли;

	НазваниеФормы = "";
	МасштабПроц = 100;
	ПоказатьСетку = Ложь;
	Если ПараметрыSnap <> Неопределено И ТипЗнч(ПараметрыSnap) = Тип("Структура") Тогда
		Если ПараметрыSnap.Свойство("form_name") Тогда
			НазваниеФормы = СокрЛП(ПараметрыSnap.form_name);
		КонецЕсли;
		Если ПараметрыSnap.Свойство("scale_percent")
			И ТипЗнч(ПараметрыSnap.scale_percent) = Тип("Число") Тогда
			МасштабПроц = Макс(10, Мин(200, Цел(ПараметрыSnap.scale_percent)));
		КонецЕсли;
		Если ПараметрыSnap.Свойство("show_grid") Тогда
			ПоказатьСетку = ПараметрыSnap.show_grid; // уже Булево после нормализации в валидаторе
		КонецЕсли;
	КонецЕсли;

	РегионX = -1;
	РегионY = -1;
	РегионШирина = -1;
	РегионВысота = -1;
	Если ПараметрыSnap <> Неопределено И ТипЗнч(ПараметрыSnap) = Тип("Структура")
		И ПараметрыSnap.Свойство("region") Тогда
		РегЗн = ПараметрыSnap.region;
		Если ТипЗнч(РегЗн) = Тип("Структура") Тогда
			РегионX      = Цел(РегЗн.x);
			РегионY      = Цел(РегЗн.y);
			РегионШирина = Цел(РегЗн.width);
			РегионВысота = Цел(РегЗн.height);
		КонецЕсли;
	КонецЕсли;

	СтрокаРектов = "";
	Если ПараметрыSnap <> Неопределено И ТипЗнч(ПараметрыSnap) = Тип("Структура")
		И ПараметрыSnap.Свойство("highlight_rects")
		И ТипЗнч(ПараметрыSnap.highlight_rects) = Тип("Массив") Тогда
		Для Каждого Рект Из ПараметрыSnap.highlight_rects Цикл
			Если ЗначениеЗаполнено(СтрокаРектов) Тогда
				СтрокаРектов = СтрокаРектов + ";";
			КонецЕсли;
			СтрокаРектов = СтрокаРектов
				+ Формат(Цел(Рект.x), "ЧГ=") + ","
				+ Формат(Цел(Рект.y), "ЧГ=") + ","
				+ Формат(Цел(Рект.width), "ЧГ=") + ","
				+ Формат(Цел(Рект.height), "ЧГ=");
		КонецЦикла;
	КонецЕсли;

	// Если указано имя формы — открываем и ждём рендеринга
	Если ЗначениеЗаполнено(НазваниеФормы) Тогда
		ОткрытаяФорма = Неопределено;
		Попытка
			ОткрытаяФорма = ОткрытьФорму(НазваниеФормы, Новый Структура);
		Исключение
			Возврат Новый Структура("success,error", Ложь,
				"Ошибка открытия формы: " + ОписаниеОшибки());
		КонецПопытки;
		Если ОткрытаяФорма = Неопределено Тогда
			Возврат Новый Структура("success,error", Ложь, "Форма не открылась: " + НазваниеФормы);
		КонецЕсли;

	КонецЕсли;

	// Захват активного окна процесса по PID
	Base64PNG = "";
	ОкноРект = Неопределено;
	ЧастиРект = Неопределено;
	ПоследнееСостояние = "окно не найдено";
	Попытка
		Ответ = КомпонентаScreenCapture.CaptureWindow(МасштабПроц, ПоказатьСетку,
			РегионX, РегионY, РегионШирина, РегионВысота, СтрокаРектов);
	Исключение
		Если ЗначениеЗаполнено(НазваниеФормы) И ОткрытаяФорма <> Неопределено Тогда
			Попытка ОткрытаяФорма.Закрыть(); Исключение КонецПопытки;
		КонецЕсли;
		Возврат Новый Структура("success,error", Ложь,
			"Ошибка захвата: " + ОписаниеОшибки());
	КонецПопытки;

	Если ЗначениеЗаполнено(НазваниеФормы) И ОткрытаяФорма <> Неопределено Тогда
		Попытка ОткрытаяФорма.Закрыть(); Исключение КонецПопытки;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Ответ) Тогда
		ПоследнееСостояние = "главное окно не найдено";
	ИначеЕсли Лев(Ответ, 7) = "RETRY:w" Тогда
		ПоследнееСостояние = "окно найдено, размер 0×0";
	ИначеЕсли Лев(Ответ, 7) = "RETRY:p" Тогда
		ПоследнееСостояние = "PrintWindow вернул 0";
	ИначеЕсли Ответ = "ERROR:region_oob" Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Указанный регион выходит за пределы клиентской области окна");
	ИначеЕсли Ответ = "ERROR:highlight_fmt" Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Внутренняя ошибка: некорректный формат highlight_rects в строке AddIn");
	ИначеЕсли Лев(Ответ, 20) = "ERROR:highlight_oob:" Тогда
		НомерРект = Сред(Ответ, 21);
		Возврат Новый Структура("success,error", Ложь,
			"Rectangle " + НомерРект + " is outside the captured area");
	Иначе
		// Форматы ответа компоненты:
		//   show_grid=false: "left|top|width|height|<base64>"
		//   show_grid=true:  "left|top|width|height|gridX|gridY|<base64>"
		//                    gridX/gridY — координаты нарисованных линий через запятую (могут быть пустыми)
		// Если '|' нет — старый бинарник, обратная совместимость
		Если Найти(Ответ, "|") > 0 Тогда
			Остаток = Ответ;
			ЧастиРект = Новый Массив;
			КорректныйФормат = Истина;
			// Читаем до 6 полей: первые 4 обязательные (left/top/width/height),
			// поля 5 и 6 опциональные (gridX/gridY, только новая DLL с show_grid=true)
			Для Инд = 1 По 6 Цикл
				Поз = Найти(Остаток, "|");
				Если Поз = 0 Тогда
					Если Инд <= 4 Тогда КорректныйФормат = Ложь; КонецЕсли;
					Прервать;
				КонецЕсли;
				ЧастиРект.Добавить(Лев(Остаток, Поз - 1));
				Остаток = Сред(Остаток, Поз + 1);
			КонецЦикла;
			Если КорректныйФормат Тогда
				Попытка
					ОкноРект = Новый Структура("left,top,width,height",
						Число(ЧастиРект[0]),
						Число(ЧастиРект[1]),
						Число(ЧастиРект[2]),
						Число(ЧастиРект[3]));
					Base64PNG = Остаток;
				Исключение
					// Число("") или Число("abc") — нечисловые coordinate fields
					Возврат Новый Структура("success,error", Ложь,
						"Неожиданный формат ответа компоненты ScreenCapture");
				КонецПопытки;
			Иначе
				// Недостаточно разделителей
				Возврат Новый Структура("success,error", Ложь,
					"Неожиданный формат ответа компоненты ScreenCapture");
			КонецЕсли;
		Иначе
			Base64PNG = Ответ;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Base64PNG) Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Не удалось захватить окно (" + ПоследнееСостояние + ")");
	КонецЕсли;

	// Возвращаем image_base64 на верхнем уровне, НЕ под "data"
	// — обходит format_tool_result в Python (TOON-режим заменяет data на строку)
	Рез = Новый Структура("success,image_base64,mime_type",
		Истина, Base64PNG, "image/png");
	Если ОкноРект <> Неопределено Тогда
		Рез.Вставить("window_rect", ОкноРект);
	КонецЕсли;
	// Поля 5 и 6 — координаты сетки от новой DLL (только при show_grid=true)
	Если ЧастиРект <> Неопределено
		И ЧастиРект.Количество() >= 6
		И (ЗначениеЗаполнено(ЧастиРект[4]) ИЛИ ЗначениеЗаполнено(ЧастиРект[5])) Тогда
		КолонкиX = РазобратьСписокКоординат(ЧастиРект[4]);
		СтрокиY   = РазобратьСписокКоординат(ЧастиРект[5]);
		Рез.Вставить("grid_coords", Новый Структура("grid_x,grid_y", КолонкиX, СтрокиY));
	КонецЕсли;
	Возврат Рез;

КонецФункции

&НаКлиенте
// Разбирает строку "100,200,300" в массив чисел [100, 200, 300].
// Пустая строка → пустой массив (явная проверка, т.к. СтрРазделить("") на некоторых
// платформах возвращает массив с одним пустым элементом, что упадёт на Число("")).
Функция РазобратьСписокКоординат(Строка)
	Рез = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Строка) Тогда
		Возврат Рез;
	КонецЕсли;
	Остаток = СокрЛП(Строка);
	Пока ЗначениеЗаполнено(Остаток) Цикл
		Поз = Найти(Остаток, ",");
		Если Поз = 0 Тогда
			Рез.Добавить(Число(СокрЛП(Остаток)));
			Прервать;
		Иначе
			Рез.Добавить(Число(СокрЛП(Лев(Остаток, Поз - 1))));
			Остаток = Сред(Остаток, Поз + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СПРАВКА BSL (get_bsl_syntax_help)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция ПолучитьСправкуПоBSL(ЗапросBSL)
	Если КомпонентаSyntaxHelp = Неопределено Тогда
		Возврат Новый Структура("success,error", Ложь, "SyntaxHelpReader не загружен");
	КонецЕсли;

	Если ЗапросBSL = Неопределено ИЛИ ТипЗнч(ЗапросBSL) <> Тип("Структура") Тогда
		Возврат Новый Структура("success,error", Ложь, "params must be an object");
	КонецЕсли;

	// Валидация keywords
	КлючевыеСлова = Неопределено;
	Если ЗапросBSL.Свойство("keywords") Тогда
		КлючевыеСлова = ЗапросBSL.keywords;
	КонецЕсли;
	Если НЕ (ТипЗнч(КлючевыеСлова) = Тип("Массив") ИЛИ ТипЗнч(КлючевыеСлова) = Тип("ФиксированныйМассив")) ИЛИ КлючевыеСлова.Количество() = 0 Тогда
		Возврат Новый Структура("success,error", Ложь, "keywords: must be non-empty array");
	КонецЕсли;
	ОчищенныеКлючи = Новый Массив;
	Для Каждого КС Из КлючевыеСлова Цикл
		Если ТипЗнч(КС) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(КС)) Тогда
			ОчищенныеКлючи.Добавить(СокрЛП(КС));
		КонецЕсли;
	КонецЦикла;
	Если ОчищенныеКлючи.Количество() = 0 Тогда
		Возврат Новый Структура("success,error", Ложь, "keywords: must contain at least one non-empty string");
	КонецЕсли;
	КлючевыеСлова = ОчищенныеКлючи;

	// Валидация match
	РежимСтрока = "all";
	Если ЗапросBSL.Свойство("match") И ЗначениеЗаполнено(ЗапросBSL.match) Тогда
		Если ЗапросBSL.match = "all" ИЛИ ЗапросBSL.match = "any" Тогда
			РежимСтрока = ЗапросBSL.match;
		Иначе
			Возврат Новый Структура("success,error", Ложь, "match: must be 'all' or 'any'");
		КонецЕсли;
	КонецЕсли;
	РежимВсе = (РежимСтрока = "all");

	КлючевыеСловаJSON = ЗаписатьJSON2(КлючевыеСлова);

	РезультатJSON = КомпонентаSyntaxHelp.Поиск(КлючевыеСловаJSON, РежимВсе);

	// ПрочитатьJSON2 принимает строку напрямую и возвращает Структура,
	// т.к. оба ключа JSON ("candidates", "content") — валидные идентификаторы 1C
	Данные = ПрочитатьJSON2(РезультатJSON);

	// Применяем пагинацию к массиву кандидатов
	// Читаем limit/offset с дефолтами (нормализатор не всегда вызывается — в proxy-режиме нет)
	ВсеКандидаты = Данные.candidates;
	Лимит = 100;
	Если ЗапросBSL.Свойство("limit") И ТипЗнч(ЗапросBSL.limit) = Тип("Число") И ЗапросBSL.limit >= 1 Тогда
		Лимит = Цел(ЗапросBSL.limit);
	КонецЕсли;
	Смещение = 0;
	Если ЗапросBSL.Свойство("offset") И ТипЗнч(ЗапросBSL.offset) = Тип("Число") И ЗапросBSL.offset >= 0 Тогда
		Смещение = Цел(ЗапросBSL.offset);
	КонецЕсли;

	Итого = ВсеКандидаты.Количество();
	СтраницаКандидатов = Новый Массив;
	ИндексКонца = Мин(Смещение + Лимит, Итого);
	Для Инд = Смещение По ИндексКонца - 1 Цикл
		СтраницаКандидатов.Добавить(ВсеКандидаты[Инд]);
	КонецЦикла;

	ЕстьЕще = (Смещение + Лимит) < Итого;

	// Подавляем content при offset > 0
	Контент = Данные.content;
	Если Смещение > 0 Тогда
		Контент = Null;
	КонецЕсли;

	// Читаем content_page (нормализатор не всегда вызывается — в proxy-режиме нет)
	НомерСтраницыКонтента = 1;
	Если ЗапросBSL.Свойство("content_page") И ТипЗнч(ЗапросBSL.content_page) = Тип("Число")
		И ЗапросBSL.content_page >= 1 Тогда
		НомерСтраницыКонтента = Цел(ЗапросBSL.content_page);
	КонецЕсли;

	// Локальные переменные для полей ответа (заполняются только если Контент не Null)
	КонтентФактНомер = Неопределено;
	КонтентВсегоСтраниц = Неопределено;
	КонтентЕстьЕще = Неопределено;

	Если ЗначениеЗаполнено(Контент) И ТипЗнч(Контент) = Тип("Строка") Тогда
		РазмерСтраницыКонтента = 4000; // фиксирован, агент не управляет
		МассивСтраниц = Новый Массив;
		ТекущаяСтраница = "";

		// Разбиваем на строки вручную (СтрРазделить недоступна в режиме совместимости)
		// Логика эквивалентна РазделитьСтрокуПоРазделителю, но inline на клиенте.
		// Пустые строки сохраняются — важно для Markdown (разрывы абзацев, code blocks).
		МассивСтрок = Новый Массив;
		ОстатокКонтента = Контент;
		ПозПС = Найти(ОстатокКонтента, Символы.ПС);
		Пока ПозПС > 0 Цикл
			МассивСтрок.Добавить(Лев(ОстатокКонтента, ПозПС - 1));
			ОстатокКонтента = Сред(ОстатокКонтента, ПозПС + 1);
			ПозПС = Найти(ОстатокКонтента, Символы.ПС);
		КонецЦикла;
		МассивСтрок.Добавить(ОстатокКонтента);

		Для Каждого Строка Из МассивСтрок Цикл
			// Страница непустая И добавление строки превысит лимит → фиксируем страницу
			// Исключение: страница пустая (строка длиннее лимита) — всё равно добавляем
			Если ЗначениеЗаполнено(ТекущаяСтраница)
				И (СтрДлина(ТекущаяСтраница) + СтрДлина(Строка) + 1) > РазмерСтраницыКонтента Тогда
				// Убираем синтетический завершающий Символы.ПС (не СокрП — она портит Markdown)
				ЗафиксированнаяСтраница = ТекущаяСтраница;
				Если Прав(ЗафиксированнаяСтраница, 1) = Символы.ПС Тогда
					ЗафиксированнаяСтраница = Лев(ЗафиксированнаяСтраница, СтрДлина(ЗафиксированнаяСтраница) - 1);
				КонецЕсли;
				МассивСтраниц.Добавить(ЗафиксированнаяСтраница);
				ТекущаяСтраница = Строка + Символы.ПС;
			Иначе
				ТекущаяСтраница = ТекущаяСтраница + Строка + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		// Последняя страница
		Если ЗначениеЗаполнено(ТекущаяСтраница) Тогда
			ЗафиксированнаяСтраница = ТекущаяСтраница;
			Если Прав(ЗафиксированнаяСтраница, 1) = Символы.ПС Тогда
				ЗафиксированнаяСтраница = Лев(ЗафиксированнаяСтраница, СтрДлина(ЗафиксированнаяСтраница) - 1);
			КонецЕсли;
			МассивСтраниц.Добавить(ЗафиксированнаяСтраница);
		КонецЕсли;

		КонтентВсегоСтраниц = Макс(МассивСтраниц.Количество(), 1);
		КонтентФактНомер = Мин(НомерСтраницыКонтента, КонтентВсегоСтраниц);
		КонтентЕстьЕще = КонтентФактНомер < КонтентВсегоСтраниц;
		Контент = МассивСтраниц[КонтентФактНомер - 1]; // обновляем Контент нужной страницей
	КонецЕсли;

	РезультатДанные = Новый Структура;
	РезультатДанные.Вставить("candidates", СтраницаКандидатов);
	РезультатДанные.Вставить("total", Итого);
	РезультатДанные.Вставить("offset", Смещение);
	РезультатДанные.Вставить("limit", Лимит);
	РезультатДанные.Вставить("has_more", ЕстьЕще);
	РезультатДанные.Вставить("content", Контент);
	Если КонтентФактНомер <> Неопределено Тогда
		РезультатДанные.Вставить("content_page", КонтентФактНомер);
		РезультатДанные.Вставить("content_total_pages", КонтентВсегоСтраниц);
		РезультатДанные.Вставить("content_has_more", КонтентЕстьЕще);
	КонецЕсли;

	Возврат Новый Структура("success,data", Истина, РезультатДанные);
КонецФункции

