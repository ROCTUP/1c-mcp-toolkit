// Хвост обработки tools/call: анонимизация, lineage, TOON и отправка.
// Вынесен отдельно, потому что при включенном параллельном режиме результат
// приходит из фонового задания и тот же хвост нужно выполнить позже (задача 000001, шаг 3).
&НаКлиенте
Функция ЗавершитьToolsCall(Результат, ИмяИнструмента, Аргументы, Команда, ДанныеЗапроса, Ид, ИдПотокаSSE)

	СверитьСостояниеПодтвержденногоВызова(ДанныеЗапроса);
	Результат = ЗакрытьОшибкуРезультатаСтрогогоРежима(Результат, ИмяИнструмента);

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Вставить("_cmd_arguments_json", """tool"": """ + ИмяИнструмента + """" + Символы.ПС + ЗаписатьJSON2(Аргументы));
	КонецЕсли;

	ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Команда);
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапросаLineage, Результат) Тогда
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат, ТекстЗапроса",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат, ТекстЗапросаLineage);
		НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "execute_query" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		Результат = ПрименитьТочнуюPolicyКРезультатуExecuteQuery(Результат, Ложь,
			ПолучитьНастройкиТочнойАнонимизации(Результат));
		РегексКонтекст = Новый Структура;
		РегексКонтекст.Вставить("Результат",            Результат);
		РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
		РегексКонтекст.Вставить("ТекстыJSON",            "");
		РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
		РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		АнонимизироватьРезультатВстроенный(Результат, РегексКонтекст);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоОбъект",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоFindReferences",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_event_log" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоGetEventLog",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_access_rights" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		АнонимизироватьРезультатGetAccessRights(Результат);
		ОбновитьТаблицуМаппинговВстроенный();
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "execute_code" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		УжеАнонимизирован = Ложь;
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			ВремАнон = Неопределено;
			УжеАнонимизирован = Результат.Свойство("_original_data_json", ВремАнон) И ЗначениеЗаполнено(ВремАнон);
		КонецЕсли;
		Если НЕ УжеАнонимизирован Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			РегексКонтекст = Новый Структура(
				"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
			КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
				"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
			РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
			ЗапуститьRegexФазу(РегексКонтекст);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	// Точка перехвата A: синхронный путь
	Если ПроверитьПодтверждениеАнонимизации(Результат, ДанныеЗапроса, Ид, ИдПотокаSSE) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СформироватьToolsCallРезультат(Результат, ДанныеЗапроса, Ид, ИдПотокаSSE);

КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатПодтвержденияВстроенный(РезультатВопроса, ДополнительныеПараметры) Экспорт

	RequestId = ДополнительныеПараметры.RequestId;
	Контекст = ОжидающиеПодтверждения.Получить(RequestId);
	ОжидающиеПодтверждения.Удалить(RequestId);

	Если Контекст = Неопределено Тогда Возврат КонецЕсли;

	// Безопасное извлечение режима и идентификаторов:
	// REST-контекст не содержит полей Ид и ИдПотокаSSE — прямой доступ к Контекст.Ид даст crash
	РежимКонтекста = "";
	Контекст.Свойство("Режим", РежимКонтекста);
	Если НЕ ЗначениеЗаполнено(РежимКонтекста) Тогда
		РежимКонтекста = "mcp";
	КонецЕсли;
	ИдКонтекст = "";
	Контекст.Свойство("Ид", ИдКонтекст);

	Разрешено = Ложь;
	Если ТипЗнч(РезультатВопроса) = Тип("Булево") Тогда
		Разрешено = РезультатВопроса;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Разрешено = Истина;
	КонецЕсли;

	ИдПотокаSSEКонтекст = "";
	Контекст.Свойство("ИдПотокаSSE", ИдПотокаSSEКонтекст);

	Если ОтветОтклоненПоЭпохе(РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст) Тогда

		Возврат;

	КонецЕсли;

	Если Разрешено Тогда
		ДобавитьВЛог("Пользователь разрешил выполнение опасной операции");
		КонтекстОтвета = НовыйКонтекстВыполненияКоманды(РежимКонтекста);
		КонтекстОтвета.ДанныеЗапроса = Контекст.ДанныеЗапроса;
		Если РежимКонтекста = "mcp" Тогда
			КонтекстОтвета.Ид = ИдКонтекст;
			КонтекстОтвета.ИдПотока = ИдПотокаSSEКонтекст;
		КонецЕсли;
		Попытка
			Результат = ВыполнитьКомандуСУчетомКонтекста(Контекст.Команда, КонтекстОтвета);
		Исключение
			Результат = Новый Структура("success, error", Ложь, "Error: " + ОписаниеОшибки());
		КонецПопытки;
		Если КонтекстОтвета.Отложено Тогда
			Возврат;
		КонецЕсли;
		Если ТипЗнч(Результат) = Тип("Структура") И ТипЗнч(Контекст.Команда) = Тип("Структура") Тогда
			Результат.Вставить("_cmd_arguments_json", """tool"": """ + Контекст.Команда.tool + """" + Символы.ПС + ЗаписатьJSON2(Контекст.Команда.params));
		КонецЕсли;
		ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
		ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Контекст.Команда);
		Если ИспользоватьАсинхронноеПодключениеКомпонент
			И НуженLineageДляРезультата(Контекст.Команда.tool, ТекстЗапросаLineage, Результат) Тогда
			КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат, ТекстЗапроса",
				РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст, Результат, ТекстЗапросаLineage);
			НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
			Возврат;
		КонецЕсли;
		Если ИспользоватьАсинхронноеПодключениеКомпонент
			И Контекст.Команда.tool = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию
			И РежимПодключения <> 0 Тогда
