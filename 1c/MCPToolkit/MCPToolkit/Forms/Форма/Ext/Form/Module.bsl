	НачатьАсинхронноеПодключениеКомпоненты(
		Новый ОписаниеОповещения("ПослеПодключенияМакетаSyntaxHelp_Запуск", ЭтаФорма, КонтекстПопытки),
		"ВнешняяОбработка.MCPToolkit.Макет.SyntaxHelpReader", "SyntaxH");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияМакетаSyntaxHelp_Запуск(Подключено, КонтекстПопытки) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если НЕ ПопыткаSyntaxHelpАктуальна(КонтекстПопытки) Тогда Возврат; КонецЕсли;
	Если Подключено Тогда
		НачатьИнициализациюSyntaxHelp(КонтекстПопытки); // продолжение цепочки — в callback инициализации
		Возврат;
	КонецЕсли;
	// Fallback через файл
	Попытка
		ДвоичныеДанные = ПолучитьМакетSyntaxHelpНаСервере();
		ВремФайл = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ВремФайл);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияФайлаSyntaxHelp_Запуск", ЭтаФорма, КонтекстПопытки),
			ВремФайл, "SyntaxH");
	Исключение
		// Fallback не готов — попытка завершается отказом: продолжаем цепочку один раз
		Если ЗавершитьПопыткуSyntaxHelp(КонтекстПопытки) Тогда
			ЗапускСервера_ПодключитьScreenCapture(КонтекстПопытки.ТунПодключён); // SyntaxHelp некритична
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаSyntaxHelp_Запуск(Подключено, КонтекстПопытки) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если НЕ ПопыткаSyntaxHelpАктуальна(КонтекстПопытки) Тогда Возврат; КонецЕсли;
	Если НЕ Подключено Тогда
		// Отказ загрузки из макета и из файла — терминальное завершение попытки:
		// справка необязательна, продолжаем цепочку ровно один раз
		Если ЗавершитьПопыткуSyntaxHelp(КонтекстПопытки) Тогда
			ЗапускСервера_ПодключитьScreenCapture(КонтекстПопытки.ТунПодключён);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	НачатьИнициализациюSyntaxHelp(КонтекстПопытки); // продолжение цепочки — в callback инициализации
КонецПроцедуры

