// Получает строковое представление типа для схемы результата запроса
//
// Параметры:
//  Тип - Тип - тип для преобразования
//
// Возвращаемое значение:
//  Строка - строковое представление типа
//
&НаСервереБезКонтекста
Функция ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип)
	
	// Используем существующую функцию ЭтоСсылка для проверки ссылочного типа
	// и существующую СтроковоеПредставлениеТипа для получения полного имени
	
	Если ЭтоСсылка(Тип) Тогда
		// Для ссылочных типов используем СтроковоеПредставлениеТипа
		// Возвращает полное имя: "СправочникСсылка.Контрагенты"
		Возврат СтроковоеПредставлениеТипа(Тип);
	Иначе
		// Для примитивных типов используем Строка(Тип)
		// Возвращает: "Строка", "Число", "Дата", "Булево"
		Возврат Строка(Тип);
	КонецЕсли;
	
КонецФункции

// Формирует схему объекта (get_object_by_link) для анонимизации по метаданным
//
// Параметры:
//  МетаданныеОбъекта  - объект метаданных (МетаданныеОбъекта.НайтиПоПолномуИмени или Таблицы.Найти)
//  ПолноеИмяОбъекта   - Строка - полное имя, напр. "Справочник.Контрагенты"
//  ЭтоВнешняяТаблица  - Булево
//
// Возвращаемое значение:
//  Структура - {columns: Массив, tabular_sections: Соответствие}
//
&НаСервереБезКонтекста
Функция СформироватьСхемуОбъектаДляАнонимизации(МетаданныеОбъекта, ПолноеИмяОбъекта, ЭтоВнешняяТаблица)

	МассивКолонок = Новый Массив;

	// _presentation — только для обычных объектов.
	// Для внешних источников _presentation = "" — в схему не добавляем.
	// source = ПолноеИмяОбъекта + ".Ссылка" — чтобы exact source rules
	// (напр. Справочник.Контрагенты.Ссылка) работали и для _presentation.
	Если НЕ ЭтоВнешняяТаблица Тогда
		ЧастиИмени = РазделитьСтрокуПоРазделителю(ПолноеИмяОбъекта, ".");
		ТипСсылкиStr = "";
		Если ЧастиИмени.Количество() >= 2 Тогда
			ТипСсылкиStr = ЧастиИмени[0] + "Ссылка." + ЧастиИмени[1];
		КонецЕсли;
		МассивИсточников = Новый Массив;
		МассивИсточников.Добавить(ПолноеИмяОбъекта + ".Ссылка");
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипСсылкиStr);
		МассивКолонок.Добавить(Новый Структура("name, types, sources",
			"_presentation", МассивТипов, МассивИсточников));
	КонецЕсли;

	// Стандартные реквизиты (Код, Наименование, Дата, Номер) — только для обычных объектов
	Если НЕ ЭтоВнешняяТаблица Тогда
		Попытка
			Для Каждого СтдРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				МассивТипов = Новый Массив;
				Для Каждого Тип Из СтдРеквизит.Тип.Типы() Цикл
					МассивТипов.Добавить(ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип));
				КонецЦикла;
				МассивИсточников = Новый Массив;
				МассивИсточников.Добавить(ПолноеИмяОбъекта + "." + СтдРеквизит.Имя);
				МассивКолонок.Добавить(Новый Структура("name, types, sources",
					СтдРеквизит.Имя, МассивТипов, МассивИсточников));
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Пользовательские реквизиты / поля внешней таблицы
	Если ЭтоВнешняяТаблица Тогда
		КоллекцияРеквизитов = МетаданныеОбъекта.Поля;
	Иначе
		КоллекцияРеквизитов = МетаданныеОбъекта.Реквизиты;
	КонецЕсли;
	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
		МассивТипов = Новый Массив;
		Попытка
			Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
				МассивТипов.Добавить(ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип));
			КонецЦикла;
		Исключение
		КонецПопытки;
		МассивИсточников = Новый Массив;
		МассивИсточников.Добавить(ПолноеИмяОбъекта + "." + Реквизит.Имя);
		МассивКолонок.Добавить(Новый Структура("name, types, sources",
			Реквизит.Имя, МассивТипов, МассивИсточников));
	КонецЦикла;

	// Табличные части — только для обычных объектов
	СоответствиеТЧ = Новый Соответствие;
	Если НЕ ЭтоВнешняяТаблица Тогда
		Попытка
			Для Каждого ТЧ Из МетаданныеОбъекта.ТабличныеЧасти Цикл
				МассивКолТЧ = Новый Массив;
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					МассивТипов = Новый Массив;
					Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
						МассивТипов.Добавить(ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип));
					КонецЦикла;
					МассивИсточников = Новый Массив;
					МассивИсточников.Добавить(ПолноеИмяОбъекта + "." + ТЧ.Имя + "." + Реквизит.Имя);
					МассивКолТЧ.Добавить(Новый Структура("name, types, sources",
						Реквизит.Имя, МассивТипов, МассивИсточников));
				КонецЦикла;
				СоответствиеТЧ.Вставить(ТЧ.Имя, Новый Структура("columns", МассивКолТЧ));
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("columns, tabular_sections", МассивКолонок, СоответствиеТЧ);

КонецФункции


// ─────────────────────────────────────────────────────────────────────────────────
// ВЫПОЛНЕНИЕ ПРОИЗВОЛЬНОГО КОДА
// ─────────────────────────────────────────────────────────────────────────────────


// Упрощённый клиентский сериализатор результата для execute_code(execution_context="client").
// Не обрабатывает серверные типы метаданных (ОписаниеТипов и т.д.) — они не возникают
// при выполнении пользовательского кода на клиенте; для них используется fallback Строка().
&НаКлиенте
Функция БезопасноеЗначениеДляПередачиКлиент(Значение, Глубина = 0)

	Если Глубина > 5 Тогда
		Возврат "<max_depth>";
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(БезопасноеЗначениеДляПередачиКлиент(Элемент, Глубина + 1));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Попытка
			Для Каждого Элемент Из Значение Цикл
				Результат.Добавить(БезопасноеЗначениеДляПередачиКлиент(Элемент, Глубина + 1));
			КонецЦикла;
		Исключение
		КонецПопытки;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого Пара Из Значение Цикл
			Результат.Вставить(Пара.Ключ, БезопасноеЗначениеДляПередачиКлиент(Пара.Значение, Глубина + 1));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Массив;
		Для Каждого Пара Из Значение Цикл
			Результат.Добавить(Новый Структура(
				"key, value",
				БезопасноеЗначениеДляПередачиКлиент(Пара.Ключ, Глубина + 1),
				БезопасноеЗначениеДляПередачиКлиент(Пара.Значение, Глубина + 1)
			));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
			Результат = Новый Массив;
			Для Каждого СтрокаТаблицы Из Значение Цикл
				СтрокаРезультата = Новый Структура;
				Для Каждого Колонка Из Значение.Колонки Цикл
					СтрокаРезультата.Вставить(Колонка.Имя,
						БезопасноеЗначениеДляПередачиКлиент(СтрокаТаблицы[Колонка.Имя], Глубина + 1));
				КонецЦикла;
				Результат.Добавить(СтрокаРезультата);
			КонецЦикла;
			Возврат Результат;
		КонецЕсли;
	Исключение
		// Тип недоступен в данном клиентском контексте — пропускаем
	КонецПопытки;

	// Всё остальное (ссылки, перечисления и т.д.) — строковое представление
	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат "<" + Строка(ТипЗначения) + ">";
	КонецПопытки;

КонецФункции

// Выполняет код в клиентском контексте.
//
// Параметры:
//  Код - Строка - текст кода
//  ЗначенияТокенов - Массив, Неопределено - значения привязанных токенов строгого режима: код видит их
//   как МСПЗначенияТокенов[<индекс>]; текст токенов в код не подставляется
//
// Возвращаемое значение:
//  Структура - success, data или error
//
&НаКлиенте
Функция ВыполнитьКодНаКлиенте(Код, ЗначенияТокенов = Неопределено)

	// Защита: блокировать код, обращающийся к чувствительным атрибутам деанонимизации.
	// Безусловно — данные могли быть записаны ранее, флаг анонимизации не имеет значения.
	// НРег: идентификаторы в 1С регистронезависимы, проверяем по нижнему регистру.
	КодНРег = НРег(Код);
	Если Найти(КодНРег, "текстдлядеанонимизации") > 0
		Или Найти(КодНРег, "полетекстдлядеанонимизации") > 0 Тогда
		Возврат Новый Структура("success, error", Ложь,
			"Code execution blocked: access to protected attributes 'ТекстДляДеАнонимизации', 'ПолеТекстДляДеАнонимизации' is not allowed");
	КонецЕсли;

	Попытка
		Результат = Неопределено;
		МСПЗначенияТокенов = ЗначенияТокенов;
		Выполнить(Код);
		Возврат Новый Структура("success, data", Истина,
			БезопасноеЗначениеДляПередачиКлиент(Результат));
	Исключение
		Возврат Новый Структура("success, error", Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецФункции

