// BEGIN GENERATED SERVER CORE: СформироватьКлючКэшаДеталейРасширения
&НаКлиентеНаСервереБезКонтекста
Функция СформироватьКлючКэшаДеталейРасширения(Фильтр, Секции, НастройкиТипов = Неопределено)
	Ключ = ?(Фильтр = Неопределено, "", Строка(Фильтр));

	Если Секции <> Неопределено Тогда
		Попытка
			Если ТипЗнч(Секции) = Тип("Массив") Тогда
				СтрСекции = "";
				Для Каждого Секция Из Секции Цикл
					Секция = СокрЛП(Строка(Секция));
					Если ПустаяСтрока(Секция) Тогда
						Продолжить;
					КонецЕсли;
					СтрСекции = СтрСекции + ?(ПустаяСтрока(СтрСекции), "", ",") + Секция;
				КонецЦикла;
				Если НЕ ПустаяСтрока(СтрСекции) Тогда
					Ключ = Ключ + "|" + СтрСекции;
				КонецЕсли;
			Иначе
				Ключ = Ключ + "|" + Строка(Секции);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;


	Ключ = Ключ + "|v2";
	Если НастройкиТипов <> Неопределено И НастройкиТипов.ЗаданыПараметры Тогда
		Ключ = Ключ + "|types:" + XMLСтрока(НастройкиТипов.Лимит) + ":" + XMLСтрока(НастройкиТипов.Смещение);
	КонецЕсли;
	Возврат Ключ;

КонецФункции
// END GENERATED SERVER CORE: СформироватьКлючКэшаДеталейРасширения

// BEGIN GENERATED SERVER CORE: РазвернутьКэшДеталейРасширения
&НаСервереБезКонтекста
Функция РазвернутьКэшДеталейРасширения(КэшДетали, ОжидаемыйКлюч)

	// Разворачивает обёртку {payload, signature} кэша деталей расширений.
	// Возвращает payload при совпадении подписи; иначе (в т.ч. старый формат без
	// обёртки) — Неопределено (cache miss).

	Если КэшДетали = Неопределено Или ТипЗнч(КэшДетали) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ КэшДетали.Свойство("payload") Или НЕ КэшДетали.Свойство("signature") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПодписьЗаписи = КэшДетали.signature;
	Если ТипЗнч(ПодписьЗаписи) <> Тип("Структура")
		Или НЕ ПодписьЗаписи.Свойство("КлючДеталей")
		Или ПодписьЗаписи.КлючДеталей <> ОжидаемыйКлюч Тогда
		Возврат Неопределено;
	КонецЕсли;

	PayloadКэша = КэшДетали.payload;
	Если ТипЗнч(PayloadКэша) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат PayloadКэша;

КонецФункции
// END GENERATED SERVER CORE: РазвернутьКэшДеталейРасширения


