// ═══════════════════════════════════════════════════════════════════════════════
// Модуль формы внешней обработки MCPToolkit
// Клиент для подключения к MCP прокси-серверу
// Совместимость: 1С:Предприятие 8.2.13+ / 8.3.25
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────────
// ПЕРЕМЕННЫЕ МОДУЛЯ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Перем ФлагПодключения;

&НаКлиенте
Перем ИнтервалОпроса;

&НаКлиенте
Перем МаксимальноеКоличествоПопытокПереподключения;

&НаКлиенте
Перем ТекущееКоличествоПопытокПереподключения;

&НаКлиенте
Перем КэшТокеновМетаданныхРасширений;

&НаКлиенте
Перем Компонента; // AddIn.MCPHttp.MCPHttpTransport

// Выбор адреса привязки встроенного сервера
&НаКлиенте
Перем ВыборАдресаВстроенногоСервера; // Структура {version, kind, interfaceId, displayName, lastAddress} — канонический выбор
&НаКлиенте
Перем КэшАдресовВстроенногоСервера; // Соответствие: синтетический_ключ → Структура {kind, interfaceId, address, displayName}
&НаКлиенте
Перем АдресПривязкиВстроенногоСервера; // Строка — фактический bind-адрес последнего запуска (для статуса/лога)

&НаКлиенте
Перем КомпонентаТун; // AddIn.ToonConv.ToonConverter

&НаКлиенте
Перем КомпонентаLineage; // AddIn.Lineage.QueryLineageAnalyzer

&НаКлиенте
Перем МСПСессии; // Соответствие: ИдСессии → АдресВоВременномХранилище

&НаКлиенте
Перем SSEПотоки; // Соответствие: ИдСессии → requestId

&НаКлиенте
Перем ОжидающиеПодтверждения; // Соответствие: requestId → структура {ДанныеЗапроса, ТелоJSON, Ид}

&НаКлиенте
Перем КэшСхемИнструментов; // Структура — кэш для ПолучитьСхемыИнструментов()

&НаКлиенте
Перем ЛегасиССЕПотоки; // Соответствие: transportSessionId → requestId (GET-потока)

&НаКлиенте
Перем ИспользоватьАсинхронноеПодключениеКомпонент; // Булево, инициализируется в ПриОткрытии

&НаКлиенте
Перем ЗапускСервераВПроцессе; // защита от повторного нажатия во время async-цепочки

&НаКлиенте
Перем КэшМаппинговОтвет; // кэш последнего ответа для фильтрации без повторного запроса

&НаКлиенте
Перем МаппингАнонимизации;    // Соответствие: оригинал -> токен

&НаКлиенте
Перем МаппингДеанонимизации;  // Соответствие: ВРег(токен) -> оригинал

&НаКлиенте
Перем СчетчикиТокенов;        // Соответствие: категория -> счётчик

&НаКлиенте
Перем ОчередьВставки;        // Массив значений в порядке вставки (FIFO для вытеснения)

&НаКлиенте
Перем ГоловаОчереди;         // Число — индекс головы очереди (амортизация вытеснения)

&НаКлиенте
Перем СловарьАнонимизации;    // Массив Структур {ЗначениеНижний, ЗначениеОриг, Категория, Длина}

&НаКлиенте
Перем БакетИндексСловаря;     // Соответствие: первые 3 символа (НРег) -> Массив записей словаря

&НаКлиенте
Перем СловарьПостроен;        // Булево

&НаКлиенте
Перем КомпонентаRegex;           // AddIn.RegexH.RegexHelper

&НаКлиенте
Перем КомпонентаRegexНедоступна; // Истина если попытка загрузки уже провалилась — не пробовать снова

&НаКлиенте
Перем КэшRegexПравил;            // Массив структур — сбрасывается после изменения настроек

&НаКлиенте
Перем АктивныеЗадания;           // Соответствие: requestId -> структура фонового задания

&НаКлиенте
Перем ОбработчикДоставкиАктивен; // Булево: обработчик ожидания доставки подключен

&НаКлиенте
Перем БСПДоступна;                // Неопределено — не проверялась, иначе Булево

&НаКлиенте
Перем КэшНастроекТочнойАнонимизации; // Структура — сбрасывается после изменения настроек

&НаКлиенте
Перем КомпонентаSyntaxHelp;      // AddIn.SyntaxH.SyntaxHelpReader

&НаКлиенте
Перем КомпонентаScreenCapture;

&НаКлиенте
Перем КолвоТемBSL;

&НаКлиенте
Перем ПерезапускВОжидании;            // Булево
&НаКлиенте
Перем ИдКомандыПерезапуска;           // Строка — Команда.id для отложенного ответа
&НаКлиенте
Перем ПутьФайлаСигналаПерезапуска;    // Строка
&НаКлиенте
Перем ПутьФайлаПараметровПерезапуска; // Строка — путь к params JSON, удаляется при таймауте
&НаКлиенте
Перем ПутьНонсаПерезапуска;           // Строка — cancellation token, удаляется при таймауте
&НаКлиенте
Перем ПутьФайлаМаппинговПерезапуска;  // Строка — путь к mappings JSON, удаляется при таймауте
&НаКлиенте
Перем ТаймаутПерезапуска;             // Дата
&НаКлиенте
Перем ПутьФайлаСигналаАвтостарта;    // Строка — для новой сессии, используется в колбэках старта
&НаКлиенте
Перем МаппингиДляВосстановления;      // Строка — путь к файлу маппингов, читается после АнонимизаторОчистить()
&НаКлиенте
Перем ПутьКлеймаАвтостарта;           // Строка — claimed_path из params, удаляется в ЗавершитьАвтостартСОшибкой и error-paths
&НаКлиенте
Перем СессийДляВосстановления;        // Массив — inline данные МСПСессии из params JSON, читается после старта сервера
&НаКлиенте
Перем ЗавершениеПослеПерезапускаЗапущено; // Булево — idempotency guard для shutdown callback
&НаКлиенте
Перем ПутьКлеймаПерезапуска;              // Строка — claimed marker, наблюдается на таймауте
&НаКлиенте
Перем КлючШифрованияПерезапуска;          // Строка — hardcoded ключ XOR для пароля в params JSON
&НаКлиенте
Перем ДанныеЗапросаПерезапуска;       // ДанныеЗапроса из ОбработатьToolsCall
&НаКлиенте
Перем ИдЗапросаПерезапуска;           // Ид из ОбработатьToolsCall
&НаКлиенте
Перем ИдПотокаПерезапуска;            // ИдПотокаSSE из ОбработатьToolsCall
&НаКлиенте
Перем ЭтоRESTЗапросПерезапуска;       // Булево — признак REST-вызова, установлен только после duplicate guard
&НаКлиенте
Перем ИдRESTЗапросаПерезапуска;       // Строка — кэш ДанныеЗапроса.id для REST, безопасный повторный доступ
&НаКлиенте
Перем ЗакрытиеСессииВПроцессе;        // guard от параллельных close
&НаКлиенте
Перем ПутьФайлаСигналаХолодногоСтарта; // хранится между ПриОткрытии и местом записи сигнала
&НаКлиенте
Перем ПутьОбработкиНаСервереДляВызова; // Строка — .epf, развернутый на сервере под вызов модуля объекта
&НаКлиенте
Перем АдресБинарникаОбработки;         // Адрес во временном хранилище — источник для развертывания на сервере

// ─────────────────────────────────────────────────────────────────────────────────
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
// ─────────────────────────────────────────────────────────────────────────────────

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Загрузка сохранённого адреса сервера
	ЗагрузитьНастройки();
	
	// Установка начального статуса
	Статус = "Отключено";
	Подключено = Ложь;
	
	// Значение по умолчанию для адреса сервера
	Если ПустаяСтрока(АдресСервера) Тогда
		АдресСервера = "http://localhost:6003";
	КонецЕсли;

	// Значение по умолчанию для порта встроенного сервера
	Если ПортВстроенногоСервера = 0 Тогда
		ПортВстроенногоСервера = 6003;
	КонецЕсли;
	
	// [++]  Пак И.О. 23.08.2026 OS-84818 / Разработать механизм ввода начальных остатков для витрины
	// ЛОКАЛЬНАЯ ПРАВКА (ветка local/request-timeout-900), в оригинале этого блока нет.
	// Собственный таймаут компоненты — 180 с (http_transport.h, request_timeout_sec_{180}).
	// Аналитические запросы к регистрам идут дольше, и клиент получает 504, хотя запрос
	// в 1С продолжает выполняться и досчитывается. Значение вынесено на форму.
	Если ТаймаутЗапросаСек = 0 Тогда
		// Значение, введенное пользователем, переживает закрытие формы; 180 —
		// только значение по умолчанию, столько ждет сама компонента.
		Попытка
			СохраненныйТаймаут = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ТаймаутЗапросаСек");
		Исключение
			СохраненныйТаймаут = Неопределено;
		КонецПопытки;

		Если ТипЗнч(СохраненныйТаймаут) = Тип("Число") И СохраненныйТаймаут > 0 Тогда
			ТаймаутЗапросаСек = СохраненныйТаймаут;
		Иначе
			ТаймаутЗапросаСек = 180;
		КонецЕсли;
	КонецЕсли;
	// [--] Пак И.О. 23.08.2026	

	ОбновитьСводкуПравилТочнойАнонимизацииНаСервере();

	НастройкиАнонИнит = ПолучитьНастройкиТочнойАнонимизацииИзХранилища();
	ПодтверждениеАнонимизации = НастройкиАнонИнит.ПодтверждениеАнонимизации;

	// Установка подсказок инструментов
	Элементы.ПолеИнструментExecuteQuery.Подсказка     = СоединитьМассив(ОписаниеToolExecuteQuery(),               Символы.ПС);
	Элементы.ПолеИнструментExecuteCode.Подсказка      = СоединитьМассив(ОписаниеToolExecuteCode(),                Символы.ПС);
	Элементы.ПолеИнструментGetMetadata.Подсказка      = СоединитьМассив(ОписаниеToolGetMetadata(),                Символы.ПС);
	Элементы.ПолеИнструментGetEventLog.Подсказка      = СоединитьМассив(ОписаниеToolGetEventLog(),                Символы.ПС);
	Элементы.ПолеИнструментGetObjectByLink.Подсказка  = СоединитьМассив(ОписаниеToolGetObjectByLink(),            Символы.ПС);
	Элементы.ПолеИнструментGetLinkOfObject.Подсказка  = СоединитьМассив(ОписаниеToolGetLinkOfObject(),            Символы.ПС);
	Элементы.ПолеИнструментFindReferences.Подсказка   = СоединитьМассив(ОписаниеToolFindReferencesToObject(),     Символы.ПС);
	Элементы.ПолеИнструментGetAccessRights.Подсказка  = СоединитьМассив(ОписаниеToolGetAccessRights(),            Символы.ПС);
	Элементы.ПолеИнструментGetBslSyntaxHelp.Подсказка = СоединитьМассив(ОписаниеToolGetBslSyntaxHelp(),           Символы.ПС);
	Элементы.ПолеИнструментSubmitDeanon.Подсказка     = СоединитьМассив(ОписаниеToolSubmitForDeanonymization(),   Символы.ПС);
	Элементы.ПолеИнструментGetScreenshot.Подсказка = СоединитьМассив(ОписаниеToolGetScreenshot(),         Символы.ПС);
	Элементы.ПолеИнструментRestart1cSession.Подсказка = СоединитьМассив(ОписаниеToolRestart1cSession(),      Символы.ПС);
	Элементы.ПолеИнструментClose1cSession.Подсказка  = СоединитьМассив(ОписаниеToolClose1cSession(),       Символы.ПС);

	// Загрузка шаблона HTML просмотра markdown
	ДД = РеквизитФормыВЗначение("Объект").ПолучитьМакет("MarkdownViewer");
	Поток = ДД.ОткрытьПотокДляЧтения();
	ЧтениеТекста = Новый ЧтениеТекста(Поток, КодировкаТекста.UTF8);
	ШаблонMarkdownПросмотра = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	Поток.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ИспользоватьАсинхронноеПодключениеКомпонент = ПроверитьНужноАсинхронноеПодключениеКомпонент();
	ЗапускСервераВПроцессе = Ложь;

	// Инициализация переменных
	ФлагПодключения = Ложь;
	ИнтервалОпроса = 1; // секунды
	МаксимальноеКоличествоПопытокПереподключения = 5;
	ТекущееКоличествоПопытокПереподключения = 0;
	
	// Клиентский кэш токенов для расширений (адреса ВременногоХранилища)
	КэшТокеновМетаданныхРасширений = Новый Соответствие;

	// Инициализация переменных встроенного сервера
	МСПСессии = Новый Соответствие;
	SSEПотоки = Новый Соответствие;
	ОжидающиеПодтверждения = Новый Соответствие;
	КэшСхемИнструментов = Неопределено;
	АктивныеЗадания = Новый Соответствие;
	ОбработчикДоставкиАктивен = Ложь;
	БСПДоступна = Неопределено;

	// Инициализация состояния выбора адреса привязки встроенного сервера
	КэшАдресовВстроенногоСервера = Новый Соответствие;
	ЗагрузитьВыборАдресаВстроенногоСервера(); // канонический выбор из хранилища, ДО веток autostart/coldstart

	// Кэш маппингов анонимизации
	КэшМаппинговОтвет = Неопределено;

	// Инициализация переменных перезапуска сессии
	ПерезапускВОжидании               = Ложь;
	ИдКомандыПерезапуска              = "";
	ПутьФайлаСигналаПерезапуска       = "";
	ПутьФайлаПараметровПерезапуска    = "";
	ПутьНонсаПерезапуска              = "";
	ПутьФайлаМаппинговПерезапуска     = "";
	ПутьФайлаСигналаАвтостарта        = "";
	МаппингиДляВосстановления         = "";
	ПутьКлеймаАвтостарта              = "";
	СессийДляВосстановления           = Неопределено;
	ПутьКлеймаПерезапуска             = "";
	ДанныеЗапросаПерезапуска          = Неопределено;
	ИдЗапросаПерезапуска              = "";
	ИдПотокаПерезапуска               = "";
	ЗавершениеПослеПерезапускаЗапущено = Ложь;
	КлючШифрованияПерезапуска = "MCPToolkit-RestartKey-v1-x7Kq2mNp";
	ЭтоRESTЗапросПерезапуска            = Ложь;
	ИдRESTЗапросаПерезапуска            = "";
	ЗакрытиеСессииВПроцессе             = Ложь;
	ПутьФайлаСигналаХолодногоСтарта     = "";

	// Инициализация видимости элементов по текущему режиму
	ПриИзмененииРежимаПодключения(Неопределено);

	// Настройка доступности элементов перезапуска (зависит от типа платформы и прав пользователя)
	НастроитьДоступностьАутентификацииПерезапуска();

	// Автозапуск при передаче параметра /C "autostart;<timestamp>;<путь к params JSON>"
	// или coldstart;<timestamp>;<путь к params JSON> — запуск после close_1c_session
	// Если params JSON удалён или повреждён — закрываем новую autostart-сессию;
	// старая сессия дождётся timeout и продолжит работать.
	// coldstart при stale/битом timestamp — пропускается, форма открывается нормально.
	Если ПараметрЗапуска = "startup" ИЛИ Лев(ПараметрЗапуска, СтрДлина("startup;")) = "startup;" Тогда

		СтартапОшибка = "";

		// Фаза 1: разбор и валидация в локальные сентинелы (без сайд-эффектов)
		НовыйРежим         = Неопределено;
		НовыйАдрес         = Неопределено;
		НовыйКанал         = Неопределено;
		НовыйПорт          = Неопределено;
		НовыйРежимАутентиф = Неопределено;
		НовыйПароль        = Неопределено;

		Попытка
			Если ПараметрЗапуска <> "startup" Тогда
				ОстатокПараметра = Сред(ПараметрЗапуска, СтрДлина("startup;") + 1);
				Пока ЗначениеЗаполнено(ОстатокПараметра) И ПустаяСтрока(СтартапОшибка) Цикл
					РазделительПоз = Найти(ОстатокПараметра, ";");
					Если РазделительПоз > 0 Тогда
						ПараЗначение     = Лев(ОстатокПараметра, РазделительПоз - 1);
						ОстатокПараметра = Сред(ОстатокПараметра, РазделительПоз + 1);
					Иначе
						ПараЗначение     = ОстатокПараметра;
						ОстатокПараметра = "";
					КонецЕсли;

					РавноПоз = Найти(ПараЗначение, "=");
					Если РавноПоз > 0 Тогда
						Ключ     = Лев(ПараЗначение, РавноПоз - 1);
						Значение = URLDecode(Сред(ПараЗначение, РавноПоз + 1));
					Иначе
						Ключ     = ПараЗначение;
						Значение = "";
					КонецЕсли;

					Если Ключ = "mode" Тогда
						Если Значение = "proxy" Тогда
							НовыйРежим = 0;
						ИначеЕсли Значение = "embedded" Тогда
							НовыйРежим = 1;
						Иначе
							СтартапОшибка = "startup: unknown mode=" + Значение;
						КонецЕсли;
					ИначеЕсли Ключ = "url" Тогда
						Если ПустаяСтрока(Значение) Тогда
							СтартапОшибка = "startup: url cannot be empty";
						Иначе
							НовыйАдрес = Значение;
						КонецЕсли;
					ИначеЕсли Ключ = "channel" Тогда
						НовыйКанал = Значение;
					ИначеЕсли Ключ = "port" Тогда
						НомПорт = 0;
						Попытка НомПорт = Число(Значение); Исключение КонецПопытки;
						Если НомПорт >= 1 И НомПорт <= 65535 Тогда
							НовыйПорт = НомПорт;
						Иначе
							СтартапОшибка = "startup: invalid port=" + Значение + " (expected 1..65535)";
						КонецЕсли;
					ИначеЕсли Ключ = "auth" Тогда
						Если Значение = "windows" Тогда
							НовыйРежимАутентиф = 0;
							НовыйПароль = "";
						ИначеЕсли Значение = "password" Тогда
							НовыйРежимАутентиф = 1;
						Иначе
							СтартапОшибка = "startup: unknown auth=" + Значение;
						КонецЕсли;
					ИначеЕсли Ключ = "pwd" Тогда
						НовыйПароль = Значение;
					Иначе
						ДобавитьВЛог("startup: unknown key '" + Ключ + "' — ignored");
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Исключение
			СтартапОшибка = ОписаниеОшибки();
		КонецПопытки;

		// Фаза 2: применить и сохранить только при полном успехе
		Если ПустаяСтрока(СтартапОшибка) Тогда
			Если НовыйРежим <> Неопределено Тогда
				РежимПодключения = НовыйРежим;
				СохранитьРежимПодключенияНаСервере(РежимПодключения);
			КонецЕсли;
			Если НовыйАдрес <> Неопределено Тогда
				АдресСервера = НовыйАдрес;
				СохранитьНастройкиНаСервере(АдресСервера);
			КонецЕсли;
			Если НовыйКанал <> Неопределено Тогда
				ИдентификаторКанала = НовыйКанал;
				СохранитьИдентификаторКаналаНаСервере(ИдентификаторКанала);
			КонецЕсли;
			Если НовыйПорт <> Неопределено Тогда
				ПортВстроенногоСервера = НовыйПорт;
				СохранитьПортВстроенногоСервераНаСервере(ПортВстроенногоСервера);
			КонецЕсли;
			Если НовыйРежимАутентиф <> Неопределено Тогда
				РежимАутентификацииПерезапуска = НовыйРежимАутентиф;
				СохранитьРежимАутентификацииПерезапускаНаСервере(РежимАутентификацииПерезапуска);
			КонецЕсли;
			Если НовыйПароль <> Неопределено Тогда
				ПарольПерезапуска = НовыйПароль;
			КонецЕсли;

			ПриИзмененииРежимаПодключения(Неопределено);
			НастроитьДоступностьАутентификацииПерезапуска();
			Подключиться(Неопределено);
		Иначе
			ДобавитьВЛог(СтартапОшибка);
		КонецЕсли;

	ИначеЕсли Лев(ПараметрЗапуска, СтрДлина("autostart;")) = "autostart;" Тогда
		ВладениеПолучено = Ложь;
		Попытка
			ОстатокПараметра = Сред(ПараметрЗапуска, СтрДлина("autostart;") + 1);
			РазделительПоз = Найти(ОстатокПараметра, ";");
			Если РазделительПоз = 0 Тогда
				// Формат без timestamp — игнорируем autostart, открываем форму нормально
				Возврат;
			КонецЕсли;
			МеткаВременниСтрока = Лев(ОстатокПараметра, РазделительПоз - 1);
			ФайлПараметров = Сред(ОстатокПараметра, РазделительПоз + 1);

			РазницаСек = ТекущаяДата() - Дата(МеткаВременниСтрока);
			Если РазницаСек > 300 Тогда
				// Повторное открытие обработки в той же сессии — игнорируем autostart
				Возврат;
			КонецЕсли;

			ЧТ = Новый ЧтениеТекста(ФайлПараметров, КодировкаТекста.UTF8);
			Попытка
				ТекстJSON = ЧТ.Прочитать();
			Исключение
				Попытка ЧТ.Закрыть(); Исключение КонецПопытки;
				ВызватьИсключение;
			КонецПопытки;
			ЧТ.Закрыть();
			ПараметрыАвтостарта = ПрочитатьJSON2(ТекстJSON);
			УдалитьФайлы(ФайлПараметров);

			ПутьФайлаСигналаАвтостарта = ПараметрыАвтостарта.signal_path;
			МаппингиДляВосстановления  = ПараметрыАвтостарта.mappings_path;
			ПутьКлеймаАвтостарта       = ПараметрыАвтостарта.claimed_path;
			СессийДляВосстановления    = ПараметрыАвтостарта.mcp_sessions;

			НонсФайл    = Новый Файл(ПараметрыАвтостарта.nonce_path);
			НонсВалиден = НонсФайл.Существует();

			Если НонсВалиден Тогда
				КлеймЗаписан = Истина;
				Если ПараметрыАвтостарта.claimed_path <> "" Тогда
					Попытка
						ЗТ = Новый ЗаписьТекста(ПараметрыАвтостарта.claimed_path, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("1");
						ЗТ.Закрыть();
					Исключение
						КлеймЗаписан = Ложь;
					КонецПопытки;
				КонецЕсли;

				Если НЕ КлеймЗаписан Тогда
					Попытка
						ЗТ = Новый ЗаписьТекста(ПараметрыАвтостарта.signal_path, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("failed:Cannot write claimed marker — ownership protocol broken");
						ЗТ.Закрыть();
					Исключение
					КонецПопытки;
					Если МаппингиДляВосстановления <> "" Тогда
						Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
					КонецЕсли;
					Попытка УдалитьФайлы(ПараметрыАвтостарта.nonce_path); Исключение КонецПопытки;
					Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
					ПутьФайлаСигналаАвтостарта = "";
					МаппингиДляВосстановления  = "";
					ПутьКлеймаАвтостарта       = "";
					СессийДляВосстановления    = Неопределено;
					ЗавершитьРаботуСистемы(Ложь);
					Возврат;
				Иначе
					НФАвтостарт = Новый Файл(ПараметрыАвтостарта.nonce_path);
					НонсЕщеВалиден = НФАвтостарт.Существует();
					Если НЕ НонсЕщеВалиден Тогда
						Попытка УдалитьФайлы(ПараметрыАвтостарта.claimed_path); Исключение КонецПопытки;
						Попытка УдалитьФайлы(ПараметрыАвтостарта.mappings_path); Исключение КонецПопытки;
						ПутьФайлаСигналаАвтостарта = "";
						МаппингиДляВосстановления  = "";
						ПутьКлеймаАвтостарта       = "";
						СессийДляВосстановления    = Неопределено;
						ЗавершитьРаботуСистемы(Ложь);
						Возврат;
					КонецЕсли;
					Попытка УдалитьФайлы(ПараметрыАвтостарта.nonce_path); Исключение КонецПопытки;
					ВладениеПолучено = Истина;

					// Восстанавливаем пароль ПОСЛЕ double-check nonce
					Если ЗначениеЗаполнено(ПараметрыАвтостарта.restart_password) Тогда
						Попытка
							ПарольПерезапуска = РасшифроватьПарольПерезапуска(ПараметрыАвтостарта.restart_password);
						Исключение
							Попытка
								ОшибкаСтрока = СтрЗаменить(ОписаниеОшибки(), Символы.ВК, " ");
								ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
								ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
								ЗТ = Новый ЗаписьТекста(ПараметрыАвтостарта.signal_path, КодировкаТекста.UTF8);
								ЗТ.ЗаписатьСтроку("failed:Password decrypt error: " + ОшибкаСтрока);
								ЗТ.Закрыть();
							Исключение
							КонецПопытки;
							Если МаппингиДляВосстановления <> Неопределено И МаппингиДляВосстановления <> "" Тогда
								Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
							КонецЕсли;
							Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
							ПутьФайлаСигналаАвтостарта = "";
							МаппингиДляВосстановления  = "";
							ПутьКлеймаАвтостарта       = "";
							СессийДляВосстановления    = Неопределено;
							ЗавершитьРаботуСистемы(Ложь);
							Возврат;
						КонецПопытки;
					КонецЕсли;

					// Восстанавливаем флаги опасных операций ПОСЛЕ double-check nonce
					// (тот же рубеж доверия, что и восстановление пароля выше).
					// Свойство()-гарды — совместимость со старым форматом файла параметров.
					Если ПараметрыАвтостарта.Свойство("danger_auto_write") Тогда
						АвтоРазрешитьЗаписать = ПараметрыАвтостарта.danger_auto_write;
					КонецЕсли;
					Если ПараметрыАвтостарта.Свойство("danger_auto_priv") Тогда
						АвтоРазрешитьПривилегированныйРежим = ПараметрыАвтостарта.danger_auto_priv;
					КонецЕсли;
					Если ПараметрыАвтостарта.Свойство("danger_confirm") Тогда
						РазрешатьОпасныеОперацииСПодтверждением = ПараметрыАвтостарта.danger_confirm;
					КонецЕсли;

					// Запускаем сервер/прокси
					Если РежимПодключения = 1 Тогда
						ЗапуститьВстроенныйСервер();
					Иначе
						Подключиться(Неопределено);
					КонецЕсли;
				КонецЕсли;
			Иначе
				// Nonce недействителен — таймаут старой сессии. Закрываем новую autostart-сессию.
				ПутьФайлаСигналаАвтостарта = "";
				Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
				ПутьКлеймаАвтостарта       = "";
				СессийДляВосстановления    = Неопределено;
				Если МаппингиДляВосстановления <> "" Тогда
					Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
					МаппингиДляВосстановления = "";
				КонецЕсли;
				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			КонецЕсли;
		Исключение
			Если ВладениеПолучено Тогда
				Попытка
					ОшибкаСтрока = СтрЗаменить(ОписаниеОшибки(), Символы.ВК, " ");
					ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
					ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
					Если ПутьФайлаСигналаАвтостарта <> "" Тогда
						ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
						ЗТ.Закрыть();
					КонецЕсли;
				Исключение КонецПопытки;
				Если МаппингиДляВосстановления <> "" Тогда
					Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
				КонецЕсли;
				Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
				ПутьФайлаСигналаАвтостарта = "";
				МаппингиДляВосстановления  = "";
				ПутьКлеймаАвтостарта       = "";
				СессийДляВосстановления    = Неопределено;
				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			Иначе
				ЕстьСигнал = ПутьФайлаСигналаАвтостарта <> "";

				Если ЕстьСигнал Тогда
					Попытка
						ОшибкаСтрока = СтрЗаменить(ОписаниеОшибки(), Символы.ВК, " ");
						ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
						ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
						ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
						ЗТ.Закрыть();
					Исключение КонецПопытки;
				КонецЕсли;

				Если МаппингиДляВосстановления <> "" Тогда
					Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
				КонецЕсли;

				ПутьФайлаСигналаАвтостарта = "";
				МаппингиДляВосстановления  = "";
				ПутьКлеймаАвтостарта       = "";
				СессийДляВосстановления    = Неопределено;

				Если ЕстьСигнал Тогда
					Попытка УдалитьФайлы(ПараметрыАвтостарта.nonce_path); Исключение КонецПопытки;
					Попытка УдалитьФайлы(ПараметрыАвтостарта.claimed_path); Исключение КонецПопытки;
				КонецЕсли;

				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			КонецЕсли;
		КонецПопытки;
	ИначеЕсли Лев(ПараметрЗапуска, СтрДлина("coldstart;")) = "coldstart;" Тогда
		ОстатокПараметра = Сред(ПараметрЗапуска, СтрДлина("coldstart;") + 1);
		РазделительПоз = Найти(ОстатокПараметра, ";");
		Если РазделительПоз > 0 Тогда
			МеткаВремениСтрока = Лев(ОстатокПараметра, РазделительПоз - 1);
			ФайлПараметров = Сред(ОстатокПараметра, РазделительПоз + 1);

			МеткаВалидна = Ложь;
			Попытка
				РазницаСек = ТекущаяДата() - Дата(МеткаВремениСтрока);
				МеткаВалидна = Истина;
			Исключение
			КонецПопытки;

			Если МеткаВалидна И РазницаСек >= 0 И РазницаСек <= 300 Тогда
				Попытка
					ЧТ = Новый ЧтениеТекста(ФайлПараметров, КодировкаТекста.UTF8);
					Попытка
						ТекстJSON = ЧТ.Прочитать();
					Исключение
						Попытка ЧТ.Закрыть(); Исключение КонецПопытки;
						ВызватьИсключение;
					КонецПопытки;
					ЧТ.Закрыть();
					ПараметрыАвтостарта = ПрочитатьJSON2(ТекстJSON);

					// signal_path присваиваем ПЕРВЫМ — catch-блок может записать failed-сигнал
					// только если ПутьФайлаСигналаХолодногоСтарта уже установлен
					Если ПараметрыАвтостарта.Свойство("signal_path") Тогда
						ПутьФайлаСигналаХолодногоСтарта = ПараметрыАвтостарта.signal_path;
					КонецЕсли;

					УдалитьФайлы(ФайлПараметров);

					СессийДляВосстановления = ПараметрыАвтостарта.mcp_sessions;
					Если ПараметрыАвтостарта.Свойство("mappings_path") Тогда
						МаппингиДляВосстановления = ПараметрыАвтостарта.mappings_path;
					КонецЕсли;

					Если ЗначениеЗаполнено(ПараметрыАвтостарта.restart_password) Тогда
						ПарольПерезапуска = РасшифроватьПарольПерезапуска(ПараметрыАвтостарта.restart_password);
					КонецЕсли;

					// Восстанавливаем флаги опасных операций ПОСЛЕ одноразового потребления файла
					// параметров (УдалитьФайлы выше) и в пределах двустороннего окна свежести.
					// Рубеж доверия coldstart — принятое ограничение модели угроз (локальный same-user launcher).
					// Свойство()-гарды — совместимость со старым форматом файла параметров.
					Если ПараметрыАвтостарта.Свойство("danger_auto_write") Тогда
						АвтоРазрешитьЗаписать = ПараметрыАвтостарта.danger_auto_write;
					КонецЕсли;
					Если ПараметрыАвтостарта.Свойство("danger_auto_priv") Тогда
						АвтоРазрешитьПривилегированныйРежим = ПараметрыАвтостарта.danger_auto_priv;
					КонецЕсли;
					Если ПараметрыАвтостарта.Свойство("danger_confirm") Тогда
						РазрешатьОпасныеОперацииСПодтверждением = ПараметрыАвтостарта.danger_confirm;
					КонецЕсли;

					Если РежимПодключения = 1 Тогда
						ЗапуститьВстроенныйСервер();
						// Сигнал пишется позже в ЗавершитьАвтостартПослеЗапускаВстроенногоСервера
					Иначе
						Подключиться(Неопределено);
						// Сигнал пишется в ЦиклОпроса на первом успешном poll
					КонецЕсли;
				Исключение
					ТекстОш = ОписаниеОшибки();
					ДобавитьВЛог("Cold start error: " + ТекстОш);
					Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
						Попытка
							ТекстОшСанит = СтрЗаменить(СтрЗаменить(ТекстОш, Символы.ВК, " "), Символы.ПС, " ");
							ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
							ЗТ.ЗаписатьСтроку("failed:Cold start error: " + ТекстОшСанит);
							ЗТ.Закрыть();
						Исключение КонецПопытки;
						ПутьФайлаСигналаХолодногоСтарта = "";
					КонецЕсли;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(Отказ)

	ЗапускСервераВПроцессе = Ложь; // колбэки async-цепочки получат Ложь и выйдут без ошибок

	// Отключение при закрытии формы
	Если ФлагПодключения Тогда
		ОтключитьсяОтСервера();
	КонецЕсли;

	// Остановка встроенного сервера
	Если ВстроенныйСерверЗапущен Тогда
		ОстановитьВстроенныйСервер();
	КонецЕсли;

КонецПроцедуры


// ─────────────────────────────────────────────────────────────────────────────────
// КОМАНДЫ ФОРМЫ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура Подключиться(Команда)

	Если РежимПодключения = 1 Тогда
		// Режим встроенного сервера — сначала отключиться от прокси
		Если ФлагПодключения Тогда
			ОтключитьсяОтСервера();
		КонецЕсли;
		ЗапуститьВстроенныйСервер();
		Возврат;
	КонецЕсли;

	// Режим прокси — сначала остановить встроенный сервер
	Если ВстроенныйСерверЗапущен Тогда
		ОстановитьВстроенныйСервер();
	КонецЕсли;

	Если ПустаяСтрока(АдресСервера) Тогда
		ПоказатьПредупреждение(, "Укажите адрес сервера");
		Возврат;
	КонецЕсли;

	// Сохранение адреса сервера
	СохранитьНастройкиНаСервере(АдресСервера);

	// Инициализация переменных если не были инициализированы
	Если ИнтервалОпроса = Неопределено Тогда
		ИнтервалОпроса = 1;
	КонецЕсли;

	// Запуск подключения
	ФлагПодключения = Истина;
	ТекущееКоличествоПопытокПереподключения = 0;

	УстановитьСтатус("Подключение...", Ложь);
	ДобавитьВЛог("Подключение к серверу: " + АдресСервера);

	// Подключение SyntaxHelpReader
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияМакетаSyntaxHelpProxy", ЭтаФорма),
			"ВнешняяОбработка.MCPToolkit.Макет.SyntaxHelpReader", "SyntaxH");
	Иначе
		ПодключитьКомпонентуSyntaxHelpСинхронно();
	КонецЕсли;

	// Подключение ScreenCapture
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияМакетаScreenCaptureProxy", ЭтаФорма),
			"ВнешняяОбработка.MCPToolkit.Макет.ScreenCapture", "ScreenCapture");
	Иначе
		ПодключитьКомпонентуScreenCaptureСинхронно();
	КонецЕсли;

	// Запуск цикла опроса
	ПодключитьОбработчикОжидания("ЦиклОпроса", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Отключиться(Команда)

	Если РежимПодключения = 1 Тогда
		ОстановитьВстроенныйСервер();
		Возврат;
	КонецЕсли;

	ОтключитьсяОтСервера();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурнал(Команда)
	
	Лог = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиТочнойАнонимизации(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеЗакрытияНастроекТочнойАнонимизации",
		ЭтаФорма);

	ПарамФормы = Новый Структура(
