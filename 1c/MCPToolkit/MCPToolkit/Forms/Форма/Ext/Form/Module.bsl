// Вызывается из ПослеЗапускаВстроенногоСервера() и ЗапуститьВстроенныйСерверСинхронно()
// сразу после АнонимизаторОчистить(). Вне autostart — немедленный возврат.
&НаКлиенте
Процедура ЗавершитьАвтостартПослеЗапускаВстроенногоСервера()
	Если ПутьФайлаСигналаАвтостарта = Неопределено Или ПутьФайлаСигналаАвтостарта = "" Тогда
		// Ранний выход если это не coldstart — сохраняем прежнее поведение для всех других сценариев
		Если НЕ ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Возврат;
		КонецЕсли;

		ОшибкаВосстановления = Ложь;
		Если ЗначениеЗаполнено(МаппингиДляВосстановления) Тогда
			Попытка
				ВосстановитьМаппингиАнонимизацииИзФайла(МаппингиДляВосстановления);
				ОбновитьТаблицуМаппинговВстроенный();
			Исключение
				ДобавитьВЛог("coldstart: mappings restore error: " + ОписаниеОшибки());
				ОшибкаВосстановления = Истина;
			КонецПопытки;
			Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
			МаппингиДляВосстановления = "";
		КонецЕсли;
		Если СессийДляВосстановления <> Неопределено Тогда
			Попытка
				ВосстановитьМСПСессии(СессийДляВосстановления);
			Исключение
				ДобавитьВЛог("coldstart: sessions restore error: " + ОписаниеОшибки());
				ОшибкаВосстановления = Истина;
			КонецПопытки;
			СессийДляВосстановления = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Попытка
				СигналСтрока = ?(ОшибкаВосстановления,
					"failed:coldstart restore error (see log)", "ready");
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку(СигналСтрока);
				ЗТ.Закрыть();
			Исключение КонецПопытки;
			ПутьФайлаСигналаХолодногоСтарта = "";
			Если ОшибкаВосстановления Тогда
				Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ОбщаяОшибка = "";
	МаппингиПуть = "";

	Если МаппингиДляВосстановления <> Неопределено И МаппингиДляВосстановления <> "" Тогда
		МаппингиПуть = МаппингиДляВосстановления;
		Попытка
			ВосстановитьМаппингиАнонимизацииИзФайла(МаппингиДляВосстановления);
			ОбновитьТаблицуМаппинговВстроенный();
		Исключение
			ОбщаяОшибка = "Mappings restore error: " + ОписаниеОшибки();
		КонецПопытки;
		МаппингиДляВосстановления = "";
	КонецЕсли;

	Если ОбщаяОшибка = "" И СессийДляВосстановления <> Неопределено Тогда
		Попытка
			ВосстановитьМСПСессии(СессийДляВосстановления);
		Исключение
			ОбщаяОшибка = "Sessions restore error: " + ОписаниеОшибки();
		КонецПопытки;
		СессийДляВосстановления = Неопределено;
	КонецЕсли;

	Если ОбщаяОшибка <> "" Тогда
		Попытка УдалитьФайлы(МаппингиПуть); Исключение КонецПопытки;
		ОшибкаСтрока = СтрЗаменить(ОбщаяОшибка, Символы.ВК, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
		Попытка
			ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
			ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
			ЗТ.Закрыть();
		Исключение
		КонецПопытки;
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
		ПутьФайлаСигналаАвтостарта = "";
		ПутьКлеймаАвтостарта       = "";
		Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Попытка
		ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
		ЗТ.ЗаписатьСтроку("ready");
		ЗТ.Закрыть();
		ПутьФайлаСигналаАвтостарта = "";
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
		ПутьКлеймаАвтостарта = "";
	Исключение
		ПутьФайлаСигналаАвтостарта = "";
		МаппингиДляВосстановления  = "";
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
		ПутьКлеймаАвтостарта       = "";
		СессийДляВосстановления    = Неопределено;
		Попытка УдалитьФайлы(МаппингиПуть); Исключение КонецПопытки;
		Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
	КонецПопытки;
КонецПроцедуры

// Пишет failed:-сигнал, удаляет mappings-файл и закрывает сессию.
// Вне autostart (ПутьФайлаСигналаАвтостарта пуст) — ничего не делает.
&НаКлиенте
Процедура ЗавершитьАвтостартСОшибкой(Сообщение)
	// Coldstart: cleanup и failed-сигнал — всегда, до раннего выхода
	Если ЗначениеЗаполнено(МаппингиДляВосстановления) Тогда
		Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
		МаппингиДляВосстановления = "";
	КонецЕсли;
	СессийДляВосстановления = Неопределено;
	Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
		Попытка
			ОшибкаСтрока = СтрЗаменить(СтрЗаменить(Сообщение, Символы.ВК, " "), Символы.ПС, " ");
			ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
			ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
			ЗТ.Закрыть();
		Исключение КонецПопытки;
		ПутьФайлаСигналаХолодногоСтарта = "";
		Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Если ПутьФайлаСигналаАвтостарта = Неопределено Или ПутьФайлаСигналаАвтостарта = "" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОшибкаСтрока = СтрЗаменить(Сообщение, Символы.ВК, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
		ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
		ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
		ЗТ.Закрыть();
	Исключение
	КонецПопытки;
	Если МаппингиДляВосстановления <> Неопределено И МаппингиДляВосстановления <> "" Тогда
		Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
	КонецЕсли;
	Если ПутьКлеймаАвтостарта <> Неопределено И ПутьКлеймаАвтостарта <> "" Тогда
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
	КонецЕсли;
	ПутьФайлаСигналаАвтостарта = "";
	МаппингиДляВосстановления  = "";
	ПутьКлеймаАвтостарта       = "";
	СессийДляВосстановления    = Неопределено;
	ЗавершитьРаботуСистемы(Ложь);
