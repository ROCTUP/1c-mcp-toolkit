&НаКлиенте
Процедура ВыполнитьЗакрытиеСессии(КомандаИД, ДанныеЗапросаEmb = Неопределено, ИдЗапросаEmb = "", ИдПотокаEmb = "", ВызовИзREST = Ложь)

	// Guard: отвечаем через сырые аргументы ДО установки глобалей — точно как restart
	Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
		Если РежимПодключения = 0 Тогда
			ОтправитьРезультатНаСервер(АдресСервера, КомандаИД,
				Новый Структура("success,error", Ложь, "Restart or close already in progress"));
		ИначеЕсли ВызовИзREST Тогда
			ИдRESTЗапр = "";
			Попытка
				Если ДанныеЗапросаEmb <> Неопределено Тогда
					ИдRESTЗапр = Строка(ДанныеЗапросаEmb.id);
				КонецЕсли;
			Исключение КонецПопытки;
			Если ЗначениеЗаполнено(ИдRESTЗапр) Тогда
				РезТело = ЗаписатьJSON2(Новый Структура("success,error", Ложь, "Restart or close already in progress"));
				Попытка
					КомпонентаSendResponse(ИдRESTЗапр, 500, ЗаголовкиJSON(), РезТело);
				Исключение
					ДобавитьВЛог("close REST guard: SendResponse error: " + ОписаниеОшибки());
				КонецПопытки;
			Иначе
				ДобавитьВЛог("close REST guard: request ID lost, cannot send error response");
			КонецЕсли;
		Иначе
			Сод = Новый Массив;
			Сод.Добавить(Новый Структура("type,text", "text", "Error: Restart or close already in progress"));
			ОтвJSON = СформироватьJSONRPCОтвет(ИдЗапросаEmb,
				Новый Структура("content,isError", Сод, Истина));
			Если ПустаяСтрока(ИдПотокаEmb) Тогда
				ОтправитьSSEОтвет(ДанныеЗапросаEmb, ОтвJSON);
			Иначе
				КомпонентаSendSSEEvent(ИдПотокаEmb, ОтвJSON, "{}", "message");
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗакрытиеСессииВПроцессе = Истина;

