		Если НЕ Операция.ЭтоПроба Тогда ВызватьИсключение "Повтор допустим только для пробного задания"; КонецЕсли;
		Пакет = ПолучитьИзВременногоХранилища(Операция.АдресПакета);
		Если ТипЗнч(Пакет) <> Тип("Структура") Тогда ВызватьИсключение "Пакет пробного задания недоступен"; КонецЕсли;
		Если НЕ Пакет.probe Или Пакет.id <> Операция.Ид Или Пакет.generation <> Операция.Поколение
			Или Пакет.instance <> Операция.Экземпляр Или Пакет.key <> Операция.КлючЗапуска
			Или Пакет.user <> ИмяПользователя() Или Пакет.result_address <> Операция.АдресРезультата
			Или Пакет.instance <> Среда.instance Или Пакет.generation <> Среда.generation
			Или Пакет.build <> Среда.build Или Пакет.build <> СборкаПараллельногоЯдра() Тогда
			ВызватьИсключение "Пакет не соответствует текущей проверке параллельности";
		КонецЕсли;
		Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ", Операция.КлючЗапуска));
		Если Задания.Количество() = 1 Тогда
			Ответ.state = "started";
			Ответ.job_id = Задания[0].УникальныйИдентификатор;
			Возврат Ответ;
		ИначеЕсли Задания.Количество() > 1 Тогда
			ВызватьИсключение "Найдено несколько пробных заданий; повтор запуска запрещён";
		КонецЕсли;
