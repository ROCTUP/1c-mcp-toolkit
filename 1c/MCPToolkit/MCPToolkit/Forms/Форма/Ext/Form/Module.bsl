+ "$argsStr = 'ENTERPRISE /IBConnectionString ' + $connQ + ' /Execute ' + $epfQ + ' /C ' + $coldQ + ' ' + $authSuffix" + Символы.ПС
+ "try {" + Символы.ПС
+ "    Start-Process -FilePath '" + ЕPSExe + "' -ArgumentList $argsStr -ErrorAction Stop" + Символы.ПС
+ "} catch {" + Символы.ПС
+ "    Write-Output ""Failed to launch 1C: $_""" + Символы.ПС
+ "    Remove-Item ($MyInvocation.MyCommand.Path) -Force -ErrorAction SilentlyContinue" + Символы.ПС
+ "    exit 1" + Символы.ПС
+ "}" + Символы.ПС
+ "$timeout = 120; $elapsed = 0" + Символы.ПС
+ "while ($elapsed -lt $timeout) {" + Символы.ПС
