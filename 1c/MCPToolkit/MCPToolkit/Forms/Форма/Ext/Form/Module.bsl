	ДанныеЗапросаПерезапуска = ДанныеЗапросаEmb;
	ИдЗапросаПерезапуска     = ИдЗапросаEmb;
	ИдПотокаПерезапуска      = ИдПотокаEmb;
	ИдRESTЗапросаПерезапуска = "";
