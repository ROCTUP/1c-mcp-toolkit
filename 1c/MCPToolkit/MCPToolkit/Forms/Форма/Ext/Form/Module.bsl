+ "try {" + Символы.ПС
+ "    $key = 'MCPColdLaunch-v1-n8Tz5rWj-' + $part2" + Символы.ПС
+ "    $bytes = [Convert]::FromBase64String($params.launch_password)" + Символы.ПС
+ "    $keyBytes = [System.Text.Encoding]::UTF8.GetBytes($key)" + Символы.ПС
+ "    $res = New-Object byte[] $bytes.Length" + Символы.ПС
+ "    for ($i = 0; $i -lt $bytes.Length; $i++) { $res[$i] = $bytes[$i] -bxor $keyBytes[$i % $keyBytes.Length] }" + Символы.ПС
+ "    $launchPassword = [System.Text.Encoding]::UTF8.GetString($res)" + Символы.ПС
+ "} catch {" + Символы.ПС
+ "    Write-Output ""Failed to decrypt password: $_""" + Символы.ПС
+ "    Remove-Item ($MyInvocation.MyCommand.Path) -Force -ErrorAction SilentlyContinue" + Символы.ПС
+ "    exit 1" + Символы.ПС
+ "}" + Символы.ПС
+ "function EscapeArg($s) { return '" + """" + "' + ($s -replace '" + """" + "', '" + """" + """" + "') + '" + """" + "' }" + Символы.ПС
