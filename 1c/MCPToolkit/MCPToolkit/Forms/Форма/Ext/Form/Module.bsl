// ─────────────────────────────────────────────────────────────────────────────────
// Маршрут серверных команд через модуль объекта (задача 000001, шаг 2)
//
// Серверное ядро живет в ObjectModule.bsl — только его видит фоновое задание.
// Чтобы не держать вторую копию кода в модуле формы, синхронный путь тоже идет
// туда: обработка разворачивается во временный файл на сервере и вызывается
// через ВнешниеОбработки.Создать.
//
// Имя файла детерминировано по хешу бинарника, а не случайно. Это дает две вещи:
// файл создается один раз на каждый рабочий сервер кластера и переиспользуется,
// и устаревшая копия невозможна — другое содержимое дает другое имя.
//
// Любая осечка маршрута — откат на прямой вызов, то есть на прежнее поведение.

&НаКлиенте
Процедура ПодготовитьМаршрутЧерезМодульОбъекта()

	ПутьОбработкиНаСервереДляВызова = "";
	АдресБинарникаОбработки = "";

	Попытка
		ПутьКлиента = ПолучитьПутьКОбработкеНаСервере();
		Если НЕ ЗначениеЗаполнено(ПутьКлиента) Тогда
			ДобавитьВЛог("Модуль объекта недоступен: путь к файлу обработки пуст. Работаем как раньше.");
			Возврат;
		КонецЕсли;

		Данные = Новый ДвоичныеДанные(ПутьКлиента);
		АдресБинарникаОбработки = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
		ПутьОбработкиНаСервереДляВызова = РазвернутьОбработкуНаСервере(АдресБинарникаОбработки);

		Если ЗначениеЗаполнено(ПутьОбработкиНаСервереДляВызова) Тогда
			ДобавитьВЛог("Серверные команды идут через модуль объекта.");
		Иначе
			ДобавитьВЛог("Не удалось развернуть обработку на сервере. Работаем как раньше.");
		КонецЕсли;

		// Флажок мог прийти включенным из сохраненных настроек — в том числе из базы,
		// где фон возможен, в базу, где он невозможен. Модальное окно на старте не
		// показываем: снимаем флажок и пишем причину в журнал.
		СнятьПараллельноеВыполнениеЕслиНедоступно();

	Исключение
		ПутьОбработкиНаСервереДляВызова = "";
		ДобавитьВЛог("Модуль объекта недоступен, работаем как раньше: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция РазвернутьОбработкуНаСервере(Адрес)

	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;

	Путь = КаталогВременныхФайлов() + "mcp_toolkit_" + ХешБинарника(Данные) + ".epf";

	Файл = Новый Файл(Путь);
	Если Файл.Существует() И Файл.Размер() = Данные.Размер() Тогда
		Возврат Путь;
	КонецЕсли;

	Данные.Записать(Путь);
	Возврат Путь;

КонецФункции

&НаСервереБезКонтекста
Функция ХешБинарника(Данные)

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьКомандуЧерезМодульОбъекта(Команда, Путь, Адрес)

	ПутьВызова = Путь;

	Файл = Новый Файл(ПутьВызова);
	Если НЕ Файл.Существует() Тогда
		// Другой рабочий сервер кластера: файла здесь еще нет.
		ПутьВызова = РазвернутьОбработкуНаСервере(Адрес);
		Если НЕ ЗначениеЗаполнено(ПутьВызова) Тогда
			ВызватьИсключение "Не удалось развернуть обработку на сервере";
		КонецЕсли;
	КонецЕсли;

	// Ложь обязателен: по умолчанию платформа создает обработку в безопасном режиме,
	// и тогда УстановитьПривилегированныйРежим, файлы, COM и внешние компоненты
	// из execute_code перестали бы работать при снятом флаге параллельности.
	Обработка = ВнешниеОбработки.Создать(ПутьВызова, Ложь);
	Возврат Обработка.ВыполнитьКомандуНаСервере(Команда);

КонецФункции

// Серверное ядро живет только в модуле объекта, отступать некуда: при осечке
// маршрут не отключается, а разворачивается заново — обычная причина промаха
// это второй рабочий сервер кластера или подчистка временного каталога.
// Если и повтор не удался, команда возвращает внятную ошибку, а не молчит.
&НаКлиенте
Функция ВыполнитьКомандуМаршрутизировано(КомандаНаСервер)

	Если НЕ ЗначениеЗаполнено(ПутьОбработкиНаСервереДляВызова) Тогда
		ПодготовитьМаршрутЧерезМодульОбъекта();
	КонецЕсли;

	Если ЗначениеЗаполнено(ПутьОбработкиНаСервереДляВызова) Тогда
		Попытка
			Возврат ВыполнитьКомандуЧерезМодульОбъекта(КомандаНаСервер,
				ПутьОбработкиНаСервереДляВызова, АдресБинарникаОбработки);
		Исключение
			ПричинаПервая = ОписаниеОшибки();
			ДобавитьВЛог("Маршрут через модуль объекта сорвался, разворачиваем обработку заново: " + ПричинаПервая);
		КонецПопытки;

		ПутьОбработкиНаСервереДляВызова = "";
		ПодготовитьМаршрутЧерезМодульОбъекта();

		Если ЗначениеЗаполнено(ПутьОбработкиНаСервереДляВызова) Тогда
			Попытка
				Возврат ВыполнитьКомандуЧерезМодульОбъекта(КомандаНаСервер,
					ПутьОбработкиНаСервереДляВызова, АдресБинарникаОбработки);
			Исключение
				Возврат ОшибкаМаршрутаМодуляОбъекта(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат ОшибкаМаршрутаМодуляОбъекта("обработку не удалось развернуть на сервере");

КонецФункции

&НаКлиенте
Функция ОшибкаМаршрутаМодуляОбъекта(Причина)

	Текст = "Серверные инструменты недоступны: команда выполняется через модуль объекта обработки,"
		+ " и развернуть обработку на сервере не удалось. " + Причина;
	ДобавитьВЛог(Текст);
	Возврат Новый Структура("success, error", Ложь, Текст);

КонецФункции

&НаСервере
Функция ПолучитьПутьКОбработкеНаСервере()
	Возврат РеквизитФормыВЗначение("Объект").ИспользуемоеИмяФайла;
КонецФункции

