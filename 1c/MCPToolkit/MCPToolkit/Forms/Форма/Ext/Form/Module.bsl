		ЧастьКлюча2Esc = "";
		Если НуженЛаунчерСПаролем Тогда
			ЧастьКлюча2Esc = ?(ЭтоWindows,
				СтрЗаменить(ЧастьКлюча2, "'", "''"),
				СтрЗаменить(ЧастьКлюча2, "'", "'\''"));
		КонецЕсли;
		КомандаЗапуска = ?(ЭтоWindows,
			"powershell -ExecutionPolicy Bypass -File '" + ПутьСкриптаEsc + "'"
				+ ?(НуженЛаунчерСПаролем, " '" + ЧастьКлюча2Esc + "'", ""),
			"bash '" + ПутьСкриптаEsc + "'"
				+ ?(НуженЛаунчерСПаролем, " '" + ЧастьКлюча2Esc + "'", ""));

		ТекстОтвета = "Session closed. To start a new session, run:"
			+ Символы.ПС + КомандаЗапуска
			+ Символы.ПС + "Run synchronously. Exit 0 = session ready. Non-zero = startup failed."
			+ " On Windows, run this command in PowerShell (not cmd.exe)."
			+ " On timeout: startup state is unknown — check whether 1C was already started before launching another."
			+ " On non-timeout exit 1: the launcher either did not start 1C, or the failed new instance was closed — safe to retry.";

		Если РежимПодключения = 0 Тогда
			ДобавитьВЛог("close_1c_session launch command: " + КомандаЗапуска);
			ОтправитьОтветПерезапуска(Истина, ТекстОтвета);
			Попытка ОтключитьсяОтСервера(); Исключение КонецПопытки;
			ЗавершитьРаботуСистемы(Ложь);
		Иначе
			ОтправитьОтветПерезапускаИЗавершитьEmbedded(ТекстОтвета);
		КонецЕсли;

	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ДобавитьВЛог("close_1c_session error: " + ТекстОшибки);
		Попытка Если ЗначениеЗаполнено(ПутьСкрипта)    Тогда УдалитьФайлы(ПутьСкрипта);    КонецЕсли; Исключение КонецПопытки;
		Попытка Если ЗначениеЗаполнено(ПутьПараметров) Тогда УдалитьФайлы(ПутьПараметров); КонецЕсли; Исключение КонецПопытки;
		Попытка Если ЗначениеЗаполнено(ПутьМаппингов)  Тогда УдалитьФайлы(ПутьМаппингов);  КонецЕсли; Исключение КонецПопытки;
		Попытка Если ЗначениеЗаполнено(ПутьСигнала)    Тогда УдалитьФайлы(ПутьСигнала);    КонецЕсли; Исключение КонецПопытки;
		ЗакрытиеСессииВПроцессе = Ложь;
		ОтправитьОтветПерезапуска(Ложь, "close_1c_session error: " + ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСтаруюСессиюПослеОтвета()
	Если ЗавершениеПослеПерезапускаЗапущено Тогда
		Возврат;
	КонецЕсли;
	ЗавершениеПослеПерезапускаЗапущено = Истина;
	ПерезапускВОжидании = Ложь;
	Попытка ОтключитьОбработчикОжидания("АварийноЗавершитьСессиюПослеПерезапуска"); Исключение КонецПопытки;
	Попытка УдалитьФайлы(ПутьКлеймаПерезапуска); Исключение КонецПопытки;
	ПутьКлеймаПерезапуска = "";
	Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура АварийноЗавершитьСессиюПослеПерезапуска()
	ЗавершитьСтаруюСессиюПослеОтвета();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОтветПерезапускаИЗавершитьEmbedded(Сообщение)
	Если ЭтоRESTЗапросПерезапуска Тогда
		// Guard: проверяем кэшированный ИдRESTЗапросаПерезапуска
		// (установлен при сохранении контекста в ВыполнитьПерезапускСессии).
		// Прямой доступ к ДанныеЗапроса.id не нужен.
		Если ИдRESTЗапросаПерезапуска = "" Тогда
			ДобавитьВЛог("restart REST: request context lost, direct shutdown");
			ЗавершитьСтаруюСессиюПослеОтвета();
			Возврат;
		КонецЕсли;
		ЗавершениеПослеПерезапускаЗапущено = Ложь;
		АсинхроннаяОтправкаЗапущена = Ложь; // флаг: callback зарегистрирован
		// Все операции до send/shutdown -- внутри Попытка.
		// ЗавершитьСтаруюСессиюПослеОтвета() НЕ внутри этой Попытка --
		// idempotency guard заблокирует retry если shutdown уже начался внутри.
		Попытка
			ПодключитьОбработчикОжидания("АварийноЗавершитьСессиюПослеПерезапуска", 30);
			Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
				РезТело = ЗаписатьJSON2(Новый Структура("success,data", Истина, Сообщение));
				// Флаг ДО вызова: если НачатьВызов бросит синхронно после частичной
				// регистрации callback -- catch увидит Истина и не вызовет shutdown
				// напрямую. Shutdown через watchdog (30с). Это безопаснее чем
				// прямой shutdown при потенциально живом callback.
				АсинхроннаяОтправкаЗапущена = Истина;
				Компонента.НачатьВызовSendResponse(
					Новый ОписаниеОповещения("ПослеОтправкиRESTОтветаПерезапуска", ЭтаФорма),
					ИдRESTЗапросаПерезапуска, 200, "{""Content-Type"":""application/json"",""Connection"":""close""}", РезТело);
				// ИНВАРИАНТ: между НачатьВызовSendResponse и Возврат -- никакого кода.
				Возврат;
			Иначе
				РезТело = ЗаписатьJSON2(Новый Структура("success,data", Истина, Сообщение));
				Компонента.SendResponse(ИдRESTЗапросаПерезапуска, 200, ЗаголовкиJSON(), РезТело);
			КонецЕсли;
		Исключение
			ДобавитьВЛог("restart REST: success path exception: " + ОписаниеОшибки());
			Если АсинхроннаяОтправкаЗапущена Тогда
				// Callback зарегистрирован (НачатьВызов прошёл успешно),
				// но исключение произошло после -- shutdown через callback/watchdog.
				// НЕ вызываем ЗавершитьСтаруюСессиюПослеОтвета здесь --
				// иначе shutdown до доставки ответа.
				Возврат;
			КонецЕсли;
			// Исключение ДО НачатьВызовSendResponse -- callback не зарегистрирован.
			// Падаем на ЗавершитьСтаруюСессиюПослеОтвета после КонецПопытки.
		КонецПопытки;
		// Сюда попадаем на sync success ИЛИ sync exception (без зарегистрированного callback).
		// Ответ либо отправлен (sync success), либо отправка невозможна
		// (исключение до/во время SendResponse). В обоих случаях закрываем
		// старую сессию -- новая уже ready, удержание бессмысленно.
		// Async success path вышел через Возврат выше -- shutdown через callback.
		ЗавершитьСтаруюСессиюПослеОтвета();
		Возврат;
	КонецЕсли;
	// ... существующий SSE-код без изменений ...
	Содержимое = Новый Массив;
	Содержимое.Добавить(Новый Структура("type,text", "text", Сообщение));
	РезультатMCP = Новый Структура("content,isError", Содержимое, Ложь);
	ОтветJSON    = СформироватьJSONRPCОтвет(ИдЗапросаПерезапуска, РезультатMCP);

	ЗавершениеПослеПерезапускаЗапущено = Ложь;
	ПодключитьОбработчикОжидания("АварийноЗавершитьСессиюПослеПерезапуска", 30);

	Если ПустаяСтрока(ИдПотокаПерезапуска) Тогда
		ИдПотока = ДанныеЗапросаПерезапуска.id;
		Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			Компонента.НачатьВызовSendSSEEvent(
				Новый ОписаниеОповещения("ПослеОтправкиSSEОтветаПерезапуска", ЭтаФорма, ИдПотока),
				ИдПотока, ОтветJSON,
				СформироватьSSEЗаголовки(ДанныеЗапросаПерезапуска, Неопределено, Истина), "message");
		Иначе
			Компонента.SendSSEEvent(ИдПотока, ОтветJSON,
				СформироватьSSEЗаголовки(ДанныеЗапросаПерезапуска, Неопределено, Истина), "message");
			Компонента.CloseSSEStream(ИдПотока);
			ЗавершитьСтаруюСессиюПослеОтвета();
		КонецЕсли;
	Иначе
		Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			Компонента.НачатьВызовSendSSEEvent(
				Новый ОписаниеОповещения("ПослеОтправкиОтветаПерезапускаВПоток", ЭтаФорма),
				ИдПотокаПерезапуска, ОтветJSON, "{}", "message");
		Иначе
			Компонента.SendSSEEvent(ИдПотокаПерезапуска, ОтветJSON, "{}", "message");
			ЗавершитьСтаруюСессиюПослеОтвета();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиRESTОтветаПерезапуска(РезВызова, ПарВызова, ДопПар) Экспорт
	Если РезВызова <> Неопределено И ТипЗнч(РезВызова) = Тип("Строка") И РезВызова <> "" Тогда
		ДобавитьВЛог("restart REST: SendResponse callback error: " + РезВызова);
	КонецЕсли;
	ЗавершитьСтаруюСессиюПослеОтвета();
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиSSEОтветаПерезапуска(РезВызова, ПарВызова, ДопПар) Экспорт
	Если РезВызова <> Неопределено И ТипЗнч(РезВызова) = Тип("Строка") И РезВызова <> "" Тогда
		ДобавитьВЛог("restart: SendSSEEvent error: " + РезВызова);
