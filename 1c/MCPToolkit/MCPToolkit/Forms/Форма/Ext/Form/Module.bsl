&НаСервере
Процедура ОбновитьСводкуПравилТочнойАнонимизацииНаСервере()

	ИсточникПравилТочнойАнонимизации = "Настройки по умолчанию";
	КоличествоПравил = ПолучитьКоличествоПравилТочнойАнонимизацииПоУмолчаниюНаСервере();

	Попытка
		НаборПравил = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v2");
		Если ТипЗнч(НаборПравил) <> Тип("Структура") Или НЕ НаборПравил.Свойство("Правила") Тогда
			НаборПравил = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v1");
		КонецЕсли;
		Если ТипЗнч(НаборПравил) = Тип("Структура") И НаборПравил.Свойство("Правила") Тогда
			КоличествоПравил = НаборПравил.Правила.Количество();
			Если КоличествоПравил = 0 Тогда
				ИсточникПравилТочнойАнонимизации = "Пустой набор";
			Иначе
				ИсточникПравилТочнойАнонимизации = "Сохраненные настройки";
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	АгрессивныйРежим = Ложь;
	Попытка АгрессивныйРежим = НаборПравил.aggressive_mode; Исключение КонецПопытки;

	ИсточникПравилТочнойАнонимизации = ИсточникПравилТочнойАнонимизации + " (" + Формат(КоличествоПравил, "ЧГ=0") + " явных правил"
		+ ?(РежимПодключения <> 0 И АгрессивныйРежим, ", агрессивный режим", "") + ")";

КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоПравилТочнойАнонимизацииПоУмолчаниюНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ДвоичныеДанные = Обработка.ПолучитьМакет("НастройкиТочнойАнонимизацииПоУмолчанию");
	ИмяФайла = ПолучитьИмяВременногоФайла("json");
	ДвоичныеДанные.Записать(ИмяФайла);

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяФайла);
	Возврат КоличествоВхожденийПодстроки(ТекстовыйДокумент.ПолучитьТекст(), """source_path""");

КонецФункции

&НаСервереБезКонтекста
Функция КоличествоВхожденийПодстроки(ИсходныйТекст, Подстрока)

	Количество = 0;
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ПозицияВхождения = Найти(Сред(ИсходныйТекст, ПозицияПоиска), Подстрока);
		Если ПозицияВхождения = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияВхождения = ПозицияПоиска + ПозицияВхождения - 1;
		Количество = Количество + 1;
		ПозицияПоиска = ПозицияВхождения + СтрДлина(Подстрока);
	КонецЦикла;

	Возврат Количество;

КонецФункции

