Функция ОтправитьРезультатНаСервер(Адрес, ИдКоманды, Знач Результат, КаналДоставки = Неопределено, ТаймаутДоставки = 30, КонтекстИсточника = Неопределено)
	Результат = РезультатСИсточникомБазы(Результат, КонтекстИсточника);
	
