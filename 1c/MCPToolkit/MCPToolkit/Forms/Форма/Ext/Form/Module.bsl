				СписокДопустимыхПриложений.Добавить("WebClient");
				СписокДопустимыхПриложений.Добавить("ThickClient");
				СписокДопустимыхПриложений.Добавить("BackgroundJob");
				СписокДопустимыхПриложений.Добавить("Designer");
