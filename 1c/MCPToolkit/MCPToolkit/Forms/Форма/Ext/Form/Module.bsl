КонецПроцедуры

&НаКлиенте
Процедура ПараллельноеВыполнениеПриИзменении(Элемент)

	Если НЕ ПараллельноеВыполнение Тогда
		ПараллельноеВыполнениеСохранитьНаСервере(Ложь);
		ДобавитьВЛог("Параллельное выполнение выключено. Незавершенные задания дорабатывают.");
		Возврат;
	КонецЕсли;

	// Включение проверяется здесь, а не при первом запросе: иначе флажок стоял бы
	// включенным в базе, где фон невозможен, и механизм выглядел бы сломанным.
	Проверка = ПроверитьВозможностьПараллельногоВыполнения();

	Если НЕ Проверка.Доступно Тогда
		ПараллельноеВыполнение = Ложь;
		ПараллельноеВыполнениеСохранитьНаСервере(Ложь);
		БСПДоступна = Ложь;
		ДобавитьВЛог("Параллельное выполнение недоступно (" + Проверка.Причина + "): "
			+ СтрЗаменить(Проверка.Текст, Символы.ПС, " "));
		ПоказатьПредупреждение(Неопределено, Проверка.Текст, , "Параллельное выполнение недоступно");
		Возврат;
	КонецЕсли;

	ПараллельноеВыполнениеСохранитьНаСервере(Истина);
	БСПДоступна = Истина;
	ДобавитьВЛог("Параллельное выполнение включено."
		+ ?(ЗначениеЗаполнено(Проверка.ВерсияБСП), " БСП " + Проверка.ВерсияБСП + ".", ""));

	Если ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
		ДобавитьВЛог("Оговорка (" + Проверка.Причина + "): "
			+ СтрЗаменить(Проверка.Предупреждение, Символы.ПС, " "));
		ПоказатьПредупреждение(Неопределено, Проверка.Предупреждение, , "Параллельное выполнение включено с оговоркой");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СнятьПараллельноеВыполнениеЕслиНедоступно()

	Если НЕ ПараллельноеВыполнение Тогда
		Возврат;
	КонецЕсли;

	Проверка = ДиагностикаБСПНаСервере();

	// Флажок могли включить до запуска сервера — тогда пробного запуска не было,
	// проверили только версию БСП. Здесь обработка уже развернута, поэтому
	// сценарий проверяется целиком: право на фоновые задания, запрет регламентных
	// заданий в базе и сам запуск. Иначе такая база молчала бы до первого запроса.
	Если Проверка.Доступно И ЗначениеЗаполнено(АдресБинарникаОбработки) Тогда
		Пробный = ПробныйЗапускФоновогоЗаданияНаСервере(АдресБинарникаОбработки,
			ЭтаФорма.УникальныйИдентификатор);
		Если НЕ Пробный.Успех Тогда
			Проверка.Доступно = Ложь;
			Проверка.Причина  = "ПробныйЗапускНеУдался";
			Проверка.Текст    = "пробное фоновое задание не запустилось: " + Пробный.Текст
				+ ". Проверьте право пользователя на выполнение фоновых заданий и запрет"
				+ " регламентных заданий в базе. Запросы выполняются по одному, как раньше.";
		КонецЕсли;
	КонецЕсли;

	Если Проверка.Доступно Тогда
		Возврат;
	КонецЕсли;

	ПараллельноеВыполнение = Ложь;
	ПараллельноеВыполнениеСохранитьНаСервере(Ложь);
	БСПДоступна = Ложь;
	ДобавитьВЛог("Параллельное выполнение отключено (" + Проверка.Причина + "): "
		+ СтрЗаменить(Проверка.Текст, Символы.ПС, " "));

КонецПроцедуры

