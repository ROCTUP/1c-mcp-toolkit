КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьАутентификацииПерезапуска()
	СисИнфо    = Новый СистемнаяИнформация();
	ЭтоWindows = СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86
		Или СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86_64;

	ДоступнаWA     = ЭтоWindows И ПолучитьДоступностьWAПользователяНаСервере();
	ДоступенПароль = ПолучитьДоступностьПарольПользователяНаСервере();

	Попытка
		Элементы.РежимАутентификацииПерезапуска.СписокВыбора[0].Доступность = ДоступнаWA;
		Элементы.РежимАутентификацииПерезапуска.СписокВыбора[1].Доступность = ДоступенПароль;
	Исключение
	КонецПопытки;

	Если РежимАутентификацииПерезапуска = 0 И НЕ ДоступнаWA Тогда
		РежимАутентификацииПерезапуска = ?(ДоступенПароль, 1, 0);
	ИначеЕсли РежимАутентификацииПерезапуска = 1 И НЕ ДоступенПароль Тогда
		РежимАутентификацииПерезапуска = ?(ДоступнаWA, 0, 1);
	КонецЕсли;

	ОбновитьВидимостьПароляПерезапуска();
КонецПроцедуры

