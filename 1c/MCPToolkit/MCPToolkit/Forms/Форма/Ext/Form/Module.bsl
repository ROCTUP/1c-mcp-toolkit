		Отсортированный = УжеОтсортированный;
		Если Отсортированный = Неопределено Тогда
			Отсортированный = СортироватьВекторТипов(Набор.Вектор);
		КонецЕсли;
		Первые20 = Новый Массив;
		Для ИндексЭлемента = 0 По 19 Цикл
			Первые20.Добавить(Отсортированный[ИндексЭлемента]);
		КонецЦикла;
		Описание.Тип = СоединитьМассив(Первые20, ", ");
