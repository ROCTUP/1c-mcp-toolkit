&НаКлиенте
// Подготовка параметров захвата — общая для синхронного и асинхронного режимов.
// Возвращает Структуру с полем Ошибка (готовая структура результата ошибки) либо
// заполненными НазваниеФормы/МасштабПроц/ПоказатьСетку/Регион*/СтрокаРектов.
Функция ПодготовитьЗахватСкриншота(ПараметрыSnap)
	Подготовка = Новый Структура("Ошибка, НазваниеФормы, МасштабПроц, ПоказатьСетку, РегионX, РегионY, РегионШирина, РегионВысота, СтрокаРектов, СпособВыбораФормы, СсылкаЦели, КлючИдентичностиЦели, ИмяСтраницыЗахвата",
		Неопределено, "", 100, Ложь, -1, -1, -1, -1, "", "", "", "", "");

	НазваниеФормы = "";
	СсылкаЦели = "";
	ИмяСтраницыЗахвата = "";
	МасштабПроц = 100;
	ПоказатьСетку = Ложь;
	Если ПараметрыSnap <> Неопределено И ТипЗнч(ПараметрыSnap) = Тип("Структура") Тогда
		Если ПараметрыSnap.Свойство("form_name") Тогда
			НазваниеФормы = СокрЛП(ПараметрыSnap.form_name);
		КонецЕсли;
		Если ПараметрыSnap.Свойство("link")
			И ТипЗнч(ПараметрыSnap.link) = Тип("Строка") Тогда
			СсылкаЦели = СокрЛП(ПараметрыSnap.link);
		КонецЕсли;
		Если ПараметрыSnap.Свойство("page_name")
			И ТипЗнч(ПараметрыSnap.page_name) = Тип("Строка") Тогда
			ИмяСтраницыЗахвата = СокрЛП(ПараметрыSnap.page_name);
		КонецЕсли;
		Если ПараметрыSnap.Свойство("scale_percent")
			И ТипЗнч(ПараметрыSnap.scale_percent) = Тип("Число") Тогда
			МасштабПроц = Макс(10, Мин(200, Цел(ПараметрыSnap.scale_percent)));
		КонецЕсли;
		Если ПараметрыSnap.Свойство("show_grid") Тогда
			ПоказатьСетку = ПараметрыSnap.show_grid; // уже Булево после нормализации в валидаторе
		КонецЕсли;
	КонецЕсли;

	// Полная валидация селекторов на каждом входе, включая прямой вызов диспетчера:
	// неверный тип или пустая строка link/page_name не должны молча превращаться
	// в снимок текущего окна
	Если ПараметрыSnap <> Неопределено И ТипЗнч(ПараметрыSnap) = Тип("Структура") Тогда
		ДетальОшибкиВалидации = ПроверитьИНормализоватьСелекторыСкриншота(ПараметрыSnap);
		Если ДетальОшибкиВалидации <> Неопределено Тогда
			Подготовка.Ошибка = Новый Структура("success,error", Ложь, ДетальОшибкиВалидации);
			Возврат Подготовка;
		КонецЕсли;
	КонецЕсли;

	// Комбинации селекторов — защита на случай обхода валидаторов входа
	Если ЗначениеЗаполнено(НазваниеФормы) И ЗначениеЗаполнено(СсылкаЦели) Тогда
		Подготовка.Ошибка = Новый Структура("success,error", Ложь,
			"form_name and link are mutually exclusive");
		Возврат Подготовка;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяСтраницыЗахвата)
		И НЕ ЗначениеЗаполнено(НазваниеФормы) И НЕ ЗначениеЗаполнено(СсылкаЦели) Тогда
		Подготовка.Ошибка = Новый Структура("success,error", Ложь,
			"page_name requires form_name or link");
		Возврат Подготовка;
	КонецЕсли;

	РегионX = -1;
	РегионY = -1;
	РегионШирина = -1;
	РегионВысота = -1;
	Если ПараметрыSnap <> Неопределено И ТипЗнч(ПараметрыSnap) = Тип("Структура")
		И ПараметрыSnap.Свойство("region") Тогда
		РегЗн = ПараметрыSnap.region;
		Если ТипЗнч(РегЗн) = Тип("Структура") Тогда
			РегионX      = Цел(РегЗн.x);
			РегионY      = Цел(РегЗн.y);
			РегионШирина = Цел(РегЗн.width);
			РегионВысота = Цел(РегЗн.height);
		КонецЕсли;
	КонецЕсли;

	СтрокаРектов = "";
	Если ПараметрыSnap <> Неопределено И ТипЗнч(ПараметрыSnap) = Тип("Структура")
		И ПараметрыSnap.Свойство("highlight_rects")
		И ТипЗнч(ПараметрыSnap.highlight_rects) = Тип("Массив") Тогда
		Для Каждого Рект Из ПараметрыSnap.highlight_rects Цикл
			Если ЗначениеЗаполнено(СтрокаРектов) Тогда
				СтрокаРектов = СтрокаРектов + ";";
			КонецЕсли;
			СтрокаРектов = СтрокаРектов
				+ Формат(Цел(Рект.x), "ЧГ=") + ","
				+ Формат(Цел(Рект.y), "ЧГ=") + ","
				+ Формат(Цел(Рект.width), "ЧГ=") + ","
				+ Формат(Цел(Рект.height), "ЧГ=");
		КонецЦикла;
	КонецЕсли;

	Подготовка.НазваниеФормы = НазваниеФормы;
	Подготовка.МасштабПроц = МасштабПроц;
	Подготовка.ПоказатьСетку = ПоказатьСетку;
	Подготовка.РегионX = РегионX;
	Подготовка.РегионY = РегионY;
	Подготовка.РегионШирина = РегионШирина;
	Подготовка.РегионВысота = РегионВысота;
	Подготовка.СтрокаРектов = СтрокаРектов;
	Если ЗначениеЗаполнено(СсылкаЦели) Тогда
		Подготовка.СпособВыбораФормы = "link";
		Подготовка.СсылкаЦели = СсылкаЦели;
		// Ключ сравнения идентичности: вся ссылка в нижнем регистре (путь + hex ref)
		Подготовка.КлючИдентичностиЦели = НРег(СсылкаЦели);
	ИначеЕсли ЗначениеЗаполнено(НазваниеФормы) Тогда
		Подготовка.СпособВыбораФормы = "form_name";
	КонецЕсли;
	Подготовка.ИмяСтраницыЗахвата = ИмяСтраницыЗахвата;
	Возврат Подготовка;
КонецФункции

&НаКлиенте
Функция ПолучитьСкриншот(ПараметрыSnap)
	// Синхронный захват без формы: занятость проверена диспетчером
	Если КомпонентаScreenCapture = Неопределено Тогда
		Возврат Новый Структура("success,error", Ложь, "ScreenCapture AddIn не загружен");
	КонецЕсли;

	Подготовка = ПодготовитьЗахватСкриншота(ПараметрыSnap);
	Если Подготовка.Ошибка <> Неопределено Тогда
		Возврат Подготовка.Ошибка;
	КонецЕсли;

	// Захват активного окна процесса по PID
	Попытка
		Ответ = КомпонентаScreenCapture.CaptureWindow(Подготовка.МасштабПроц, Подготовка.ПоказатьСетку,
			Подготовка.РегионX, Подготовка.РегионY, Подготовка.РегионШирина, Подготовка.РегионВысота,
			Подготовка.СтрокаРектов);
	Исключение
		Возврат Новый Структура("success,error", Ложь,
			"Ошибка захвата: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат РазобратьОтветScreenCapture(Ответ);
КонецФункции

&НаКлиенте
// Разбор ответа CaptureWindow: конверт V2, старый позиционный формат, чистый base64,
// ERROR:/RETRY: — общий для синхронного и асинхронного режимов.
Функция РазобратьОтветScreenCapture(Ответ)
	Base64PNG = "";
	ОкноРект = Неопределено;
	ЧастиРект = Неопределено;
	СеткаКоординат = Неопределено;
	СлоиНаКадре = Неопределено;
	ОтказыСлоёв = Неопределено;
	КадрПолный = Неопределено;
	АктивноеОкно = Неопределено;
	ПоследнееСостояние = "окно не найдено";

	Если НЕ ЗначениеЗаполнено(Ответ) Тогда
		ПоследнееСостояние = "главное окно не найдено";
	ИначеЕсли Лев(Ответ, 7) = "RETRY:w" Тогда
		ПоследнееСостояние = "окно найдено, размер 0×0";
	ИначеЕсли Лев(Ответ, 7) = "RETRY:p" Тогда
		ПоследнееСостояние = "PrintWindow вернул 0";
	ИначеЕсли Лев(Ответ, 6) = "RETRY:" Тогда
		ПоследнееСостояние = "Окно временно недоступно для захвата: " + Сред(Ответ, 7);
	ИначеЕсли Лев(Ответ, 10) = "ERROR:x11:" Тогда
		КодОшибкиX11 = Сред(Ответ, 11);
		Если КодОшибкиX11 = "composite_required" Тогда
			ОписаниеОшибкиX11 = "X-сервер должен поддерживать XComposite 0.2 или новее для фонового захвата окон";
		ИначеЕсли КодОшибкиX11 = "window_not_redirected" Тогда
			ОписаниеОшибкиX11 = "Буфер окна XComposite недоступен. Включите композитинг в оконном менеджере и повторите захват";
		ИначеЕсли КодОшибкиX11 = "render_required" Тогда
			ОписаниеОшибкиX11 = "X-сервер должен поддерживать Render для определения формата изображения окна";
		ИначеЕсли КодОшибкиX11 = "display_unavailable" Тогда
			ОписаниеОшибкиX11 = "Нет подключения к X11. Захват требует запуска клиента 1С в доступной X11-сессии";
		ИначеЕсли КодОшибкиX11 = "xres_required" Тогда
			ОписаниеОшибкиX11 = "X-сервер должен поддерживать XRes 1.2 для определения владельцев окон";
		ИначеЕсли КодОшибкиX11 = "unsupported_transparency" Тогда
			ОписаниеОшибкиX11 = "Область снимка главного окна содержит прозрачные пиксели или для главного окна задана неполная непрозрачность";
		Иначе
			ОписаниеОшибкиX11 = "Ошибка захвата X11: " + КодОшибкиX11;
		КонецЕсли;
		Возврат Новый Структура("success,error", Ложь, ОписаниеОшибкиX11);
	ИначеЕсли Ответ = "ERROR:region_oob" Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Указанный регион выходит за пределы клиентской области окна");
	ИначеЕсли Ответ = "ERROR:highlight_fmt" Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Внутренняя ошибка: некорректный формат highlight_rects в строке AddIn");
	ИначеЕсли Лев(Ответ, 20) = "ERROR:highlight_oob:" Тогда
		НомерРект = Сред(Ответ, 21);
		Возврат Новый Структура("success,error", Ложь,
			"Rectangle " + НомерРект + " is outside the captured area");
	ИначеЕсли Лев(Ответ, 13) = "ERROR:overlay:" Тогда
		// Слой поверх формы — раскрытый список, меню, подсказка, диалог — виден на экране, но
		// снять его не удалось. Отдать снимок без него нельзя: агент получил бы обычный успешный
		// кадр, по которому невозможно понять, что он неполный, а это ровно тот дефект, от
		// которого инструмент и лечится.
		НомерОкна = Сред(Ответ, 14);
		Возврат Новый Структура("success,error", Ложь,
			"Не удалось снять слой поверх формы (окно " + НомерОкна
			+ "); снимок не отдан, чтобы не выдать неполный кадр за полный");
	ИначеЕсли Лев(Ответ, 6) = "ERROR:" Тогда
		Возврат Новый Структура("success,error", Ложь, "Ошибка захвата: " + Сред(Ответ, 7));
	ИначеЕсли Лев(Ответ, 3) = "V2|" Тогда
		// Формат: V2|<длина JSON в символах>|<json>|<base64>
		//
		// Длина снимает двусмысленность разделителей: '|' может встретиться внутри JSON —
		// например, в имени класса окна, — а в base64 не встречается никогда. Компонента пишет
		// только ASCII (всё выше 0x7F уезжает как \uXXXX), поэтому длина в символах и в байтах
		// совпадает.
		ОстатокV2 = Сред(Ответ, 4);
		ПозДлины = Найти(ОстатокV2, "|");
		Если ПозДлины = 0 Тогда
			Возврат Новый Структура("success,error", Ложь,
				"Неожиданный формат ответа компоненты ScreenCapture: V2 без длины");
		КонецЕсли;
		ДлинаJSON = 0;
		Попытка
			ДлинаJSON = Число(Лев(ОстатокV2, ПозДлины - 1));
		Исключение
			Возврат Новый Структура("success,error", Ложь,
				"Неожиданный формат ответа компоненты ScreenCapture: нечисловая длина V2");
		КонецПопытки;
		Если ДлинаJSON <= 0 ИЛИ ДлинаJSON <> Цел(ДлинаJSON)
			ИЛИ ДлинаJSON > СтрДлина(ОстатокV2) - ПозДлины - 2 Тогда
			Возврат Новый Структура("success,error", Ложь,
				"Неожиданный формат ответа компоненты ScreenCapture: неверная длина V2");
		КонецЕсли;
		Если Сред(ОстатокV2, ПозДлины + 1 + ДлинаJSON, 1) <> "|" Тогда
			Возврат Новый Структура("success,error", Ложь,
				"Неожиданный формат ответа компоненты ScreenCapture: нет разделителя после JSON");
		КонецЕсли;
		ТекстJSON = Сред(ОстатокV2, ПозДлины + 1, ДлинаJSON);
		// +1 — разделитель между JSON и картинкой
		Base64PNG = Сред(ОстатокV2, ПозДлины + 1 + ДлинаJSON + 1);
		МетаданныеСнимка = Неопределено;
		Попытка
			МетаданныеСнимка = ПрочитатьJSON2(ТекстJSON);
		Исключение
			Возврат Новый Структура("success,error", Ложь,
				"Неожиданный формат ответа компоненты ScreenCapture: не разобрался JSON конверта");
		КонецПопытки;
		// ПолучитьЗначениеОбъекта, а не прямое обращение: парсер отдаёт Структура, когда все ключи
		// — корректные идентификаторы, и Соответствие иначе, а хелпер безопасен для обоих.
		ОкноРект = ПолучитьЗначениеОбъекта(МетаданныеСнимка, "window_rect");
		СеткаКоординат = ПолучитьЗначениеОбъекта(МетаданныеСнимка, "grid_coords");
		СлоиНаКадре = ПолучитьЗначениеОбъекта(МетаданныеСнимка, "overlays");
		ОтказыСлоёв = ПолучитьЗначениеОбъекта(МетаданныеСнимка, "overlay_failures");
		КадрПолный = ПолучитьЗначениеОбъекта(МетаданныеСнимка, "capture_complete");
		АктивноеОкно = ПолучитьЗначениеОбъекта(МетаданныеСнимка, "foreground");
	Иначе
		// Старый формат позиционными полями — остаётся для прежнего бинарника:
		//   show_grid=false: "left|top|width|height|<base64>"
		//   show_grid=true:  "left|top|width|height|gridX|gridY|<base64>"
		//                    gridX/gridY — координаты нарисованных линий через запятую (могут быть пустыми)
		// Если '|' нет — совсем старый бинарник, обратная совместимость
		Если Найти(Ответ, "|") > 0 Тогда
			Остаток = Ответ;
			ЧастиРект = Новый Массив;
			КорректныйФормат = Истина;
			// Читаем до 6 полей: первые 4 обязательные (left/top/width/height),
			// поля 5 и 6 опциональные (gridX/gridY, только новая DLL с show_grid=true)
			Для Инд = 1 По 6 Цикл
				Поз = Найти(Остаток, "|");
				Если Поз = 0 Тогда
					Если Инд <= 4 Тогда КорректныйФормат = Ложь; КонецЕсли;
					Прервать;
				КонецЕсли;
				ЧастиРект.Добавить(Лев(Остаток, Поз - 1));
				Остаток = Сред(Остаток, Поз + 1);
			КонецЦикла;
			Если КорректныйФормат Тогда
				Попытка
					ОкноРект = Новый Структура("left,top,width,height",
						Число(ЧастиРект[0]),
						Число(ЧастиРект[1]),
						Число(ЧастиРект[2]),
						Число(ЧастиРект[3]));
					Base64PNG = Остаток;
				Исключение
					// Число("") или Число("abc") — нечисловые coordinate fields
					Возврат Новый Структура("success,error", Ложь,
						"Неожиданный формат ответа компоненты ScreenCapture");
				КонецПопытки;
			Иначе
				// Недостаточно разделителей
				Возврат Новый Структура("success,error", Ложь,
					"Неожиданный формат ответа компоненты ScreenCapture");
			КонецЕсли;
		Иначе
			Base64PNG = Ответ;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Base64PNG) Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Не удалось захватить окно (" + ПоследнееСостояние + ")");
	КонецЕсли;

	// Возвращаем image_base64 на верхнем уровне, НЕ под "data"
	// — обходит format_tool_result в Python (TOON-режим заменяет data на строку)
	Рез = Новый Структура("success,image_base64,mime_type",
		Истина, Base64PNG, "image/png");
	Если ОкноРект <> Неопределено Тогда
		Рез.Вставить("window_rect", ОкноРект);
	КонецЕсли;
	Если СеткаКоординат <> Неопределено Тогда
		// Конверт V2: сетка приходит уже разобранной
		Рез.Вставить("grid_coords", СеткаКоординат);
	ИначеЕсли ЧастиРект <> Неопределено
		И ЧастиРект.Количество() >= 6
		И (ЗначениеЗаполнено(ЧастиРект[4]) ИЛИ ЗначениеЗаполнено(ЧастиРект[5])) Тогда
		// Старый позиционный формат: поля 5 и 6 — координаты сетки
		КолонкиX = РазобратьСписокКоординат(ЧастиРект[4]);
		СтрокиY   = РазобратьСписокКоординат(ЧастиРект[5]);
		Рез.Вставить("grid_coords", Новый Структура("grid_x,grid_y", КолонкиX, СтрокиY));
	КонецЕсли;
	// Слои поверх формы и полнота кадра — только из конверта V2. Старый бинарник о слоях ничего
	// не знает, и молчание тут честнее, чем выдуманное capture_complete = Истина.
	Если СлоиНаКадре <> Неопределено Тогда
		Рез.Вставить("overlays", СлоиНаКадре);
	КонецЕсли;
	Если ОтказыСлоёв <> Неопределено Тогда
		Рез.Вставить("overlay_failures", ОтказыСлоёв);
	КонецЕсли;
	Если КадрПолный <> Неопределено Тогда
		Рез.Вставить("capture_complete", КадрПолный);
	КонецЕсли;
	// Окно в фокусе и лежит ли оно в этом кадре. Якорь выбирается детерминированно, поэтому
	// активное окно может в кадр не попасть — молчать об этом нельзя.
	Если АктивноеОкно <> Неопределено Тогда
		Рез.Вставить("foreground_window", АктивноеОкно);
	КонецЕсли;
	Возврат Рез;

КонецФункции

&НаКлиенте
// Повторно-безопасное закрытие формы, открытой для захвата. Ошибка закрытия логируется
// и не маскирует исходную ошибку операции.
Процедура ЗакрытьФормуЗахвата(КонтекстОперации)
	ФормаЗахвата = Неопределено;
	Если НЕ КонтекстОперации.Свойство("ФормаДляЗакрытия", ФормаЗахвата) ИЛИ ФормаЗахвата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КонтекстОперации.Вставить("ФормаДляЗакрытия", Неопределено);
	Попытка
		ФормаЗахвата.Закрыть();
	Исключение
		ДобавитьВЛог("Скриншот: не удалось закрыть форму захвата: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
// Асинхронный запуск захвата скриншота (запрещённые синхронные вызовы). Один активный
// захват на клиент: второй запрос получает ошибку занятости до открытия формы.
Функция ТекущиеМиллисекундыКлиента()
	// Проба ms-функции через Выполнить: прямое упоминание не компилируется на 8.2.x
	Если МиллисекундыЧасовПроверены <> Истина Тогда
		МиллисекундыЧасовПроверены = Истина;
		МиллисекундыЧасовДоступны = Ложь;
		Попытка
			Выполнить("ЗначениеЧасовКлиента = ТекущаяУниверсальнаяДатаВМиллисекундах()");
			Если ЗначениеЧасовКлиента > 0 Тогда
				МиллисекундыЧасовДоступны = Истина;
			КонецЕсли;
		Исключение
			МиллисекундыЧасовДоступны = Ложь;
		КонецПопытки;
	КонецЕсли;

	Если МиллисекундыЧасовДоступны = Истина Тогда
		Попытка
			Выполнить("ЗначениеЧасовКлиента = ТекущаяУниверсальнаяДатаВМиллисекундах()");
			Возврат ЗначениеЧасовКлиента;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Резервная ветка: разность дат — число секунд; умножать дату на число нельзя
	Возврат (ТекущаяДата() - '00010101000000') * 1000;
КонецФункции

&НаКлиенте
Функция ВыполнитьПолучениеСкриншота(ПараметрыSnap, КонтекстВыполненияКоманды)
	Если КомпонентаScreenCapture = Неопределено Тогда
		Возврат Новый Структура("success,error", Ложь, "ScreenCapture AddIn не загружен");
	КонецЕсли;

	// Занятость проверяется во всех ветках: запрос без формы не должен врываться
	// в середину подготовки другой операции, и наоборот
	Если АктивныйЗахватСкриншота <> Неопределено Тогда
		Возврат Новый Структура("success,error", Ложь, "Захват скриншота уже выполняется");
	КонецЕсли;

	Подготовка = ПодготовитьЗахватСкриншота(ПараметрыSnap);
	Если Подготовка.Ошибка <> Неопределено Тогда
		Возврат Подготовка.Ошибка;
	КонецЕсли;

	Если ЗначениеЗаполнено(Подготовка.СпособВыбораФормы) Тогда
		Возврат НачатьПолучениеСкриншотаСФормой(КонтекстВыполненияКоманды, Подготовка);
	КонецЕсли;

	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		Если КонтекстВыполненияКоманды = Неопределено Тогда
			Возврат Новый Структура("success,error", Ложь,
				"Внутренняя ошибка: асинхронный захват скриншота требует контекст выполнения");
		КонецЕсли;
		КонтекстВыполненияКоманды.Вставить("Подготовка", Подготовка);
		КонтекстВыполненияКоманды.Вставить("ФормаЗахвата", Неопределено);
		КонтекстВыполненияКоманды.Вставить("ФормаДляЗакрытия", Неопределено);
		КонтекстВыполненияКоманды.Вставить("РезультатПринят", Ложь);
		КонтекстВыполненияКоманды.Вставить("Отменена", Ложь);
		КонтекстВыполненияКоманды.Вставить("ВызовКомпонентыВыполняется", Ложь);
		КонтекстВыполненияКоманды.Вставить("СтадияЗахвата", "Захват");
		АктивныйЗахватСкриншота = КонтекстВыполненияКоманды;
		КонтекстВыполненияКоманды.ВызовКомпонентыВыполняется = Истина;
		РезультатЗапуска = ЗапуститьАсинхронныйЗахватКомпоненты(КонтекстВыполненияКоманды);
		Если РезультатЗапуска <> Неопределено Тогда
			КонтекстВыполненияКоманды.ВызовКомпонентыВыполняется = Ложь;
			АктивныйЗахватСкриншота = Неопределено;
			Возврат РезультатЗапуска;
		КонецЕсли;
		КонтекстВыполненияКоманды.Отложено = Истина;
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьСкриншот(ПараметрыSnap);
КонецФункции

&НаКлиенте
Функция НачатьПолучениеСкриншотаСФормой(КонтекстВыполненияКоманды, Подготовка)
	Если КонтекстВыполненияКоманды = Неопределено Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Внутренняя ошибка: захват скриншота с формой требует контекст выполнения");
	КонецЕсли;

	КонтекстВыполненияКоманды.Вставить("Подготовка", Подготовка);
	КонтекстВыполненияКоманды.Вставить("ФормаЗахвата", Неопределено);
	КонтекстВыполненияКоманды.Вставить("ФормаДляЗакрытия", Неопределено);
	КонтекстВыполненияКоманды.Вставить("РезультатПринят", Ложь);
	КонтекстВыполненияКоманды.Вставить("Отменена", Ложь);
	КонтекстВыполненияКоманды.Вставить("ВызовКомпонентыВыполняется", Ложь);
	КонтекстВыполненияКоманды.Вставить("СтадияЗахвата", "Подготовка");
	КонтекстВыполненияКоманды.Вставить("СрокСтадии", 0);
	КонтекстВыполненияКоманды.Вставить("ОкноЗахвата", Неопределено);
	КонтекстВыполненияКоманды.Вставить("ИмяСтраницыЗахвата", Подготовка.ИмяСтраницыЗахвата);
	КонтекстВыполненияКоманды.Вставить("ЦепочкаСтраницЗахвата", Неопределено);
	КонтекстВыполненияКоманды.Вставить("ИзмененныеСтраницыЗахвата", Новый Массив);

	// Слот занимается до открытия формы: вложенные события открытия и запросы
	// из ЦиклОпроса не должны войти в подготовку этой операции
	АктивныйЗахватСкриншота = КонтекстВыполненияКоманды;

	Если Подготовка.СпособВыбораФормы = "link" Тогда
		РезультатПодготовки = ПодготовитьФормуЗахватаПоСсылке(КонтекстВыполненияКоманды, Подготовка);
	Иначе
		РезультатПодготовки = ПодготовитьФормуЗахватаПоИмени(КонтекстВыполненияКоманды, Подготовка);
	КонецЕсли;
	Если РезультатПодготовки <> Неопределено Тогда
		АктивныйЗахватСкриншота = Неопределено;
		ЗакрытьФормуЗахвата(КонтекстВыполненияКоманды);
		Возврат РезультатПодготовки;
	КонецЕсли;

	// Стадия, срок и регистрация ожидания — единый блок очистки: исключение
	// на любом шаге освобождает слот и закрывает свою форму
	Попытка
		КонтекстВыполненияКоманды.СтадияЗахвата = "ОжиданиеОткрытия";
		КонтекстВыполненияКоманды.СрокСтадии = ТекущиеМиллисекундыКлиента() + 1500;
		ПодключитьОбработчикОжидания("АктивироватьФормуЗахвата", 1.5, Истина);
	Исключение
		АктивныйЗахватСкриншота = Неопределено;
		ЗакрытьФормуЗахвата(КонтекстВыполненияКоманды);
		Возврат Новый Структура("success,error", Ложь,
			"Ошибка подключения обработчика ожидания: " + ОписаниеОшибки());
	КонецПопытки;

	// Регистрация успешна: право ответа переходит машине состояний
	КонтекстВыполненияКоманды.Отложено = Истина;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
// Открытие/переиспользование формы по имени. Возвращает Неопределено при успехе
// (форма в КонтекстВыполненияКоманды.ФормаЗахвата) или структуру ошибки.
// Слот уже занят вызывающим кодом; очистка при ошибке — тоже на нём.
Функция ПодготовитьФормуЗахватаПоИмени(КонтекстВыполненияКоманды, Подготовка)
	Попытка
		ФормаЗахвата = ПолучитьФорму(Подготовка.НазваниеФормы, Новый Структура);
		ФормаБылаОткрыта = ФормаЗахвата.Открыта();
		Если НЕ ФормаБылаОткрыта Тогда
			// Своя форма фиксируется до Открыть(): исключение при частичном открытии
			// не теряет ссылку для очистки
			КонтекстВыполненияКоманды.ФормаДляЗакрытия = ФормаЗахвата;
		КонецЕсли;
		ФормаЗахвата.Открыть();
	Исключение
		Возврат Новый Структура("success,error", Ложь,
			"Ошибка открытия формы: " + ОписаниеОшибки());
	КонецПопытки;

	Если НЕ ФормаЗахвата.Открыта() Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Форма не открылась: " + Подготовка.НазваниеФормы);
	КонецЕсли;

	КонтекстВыполненияКоманды.ФормаЗахвата = ФормаЗахвата;
	Возврат Неопределено;
КонецФункции

