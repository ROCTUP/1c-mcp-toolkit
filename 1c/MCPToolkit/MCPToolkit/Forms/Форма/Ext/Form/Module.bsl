// REST-ответ 200 с результатом инструмента: JSON, а при формате TOON - конвертация данных. С асинхронным
// подключением компонент конвертация идет асинхронно, и ответ отправляет ПослеJsonToToonREST.
//
// Параметры:
//  Результат - Произвольный - результат инструмента, готовый к отправке
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  КонтекстДоставки - Структура, Неопределено - контекст отложенной команды (маршрут операции планировщика):
//                     асинхронная конвертация TOON продолжится с проверкой поколения и освободит операцию
//
// Возвращаемое значение:
//  Структура, Неопределено - КодОтвета и Тело или Неопределено, если ответ отправит асинхронная конвертация
//
&НаКлиенте
Функция СформироватьRESTРезультат(Результат, ДанныеЗапроса, КонтекстДоставки = Неопределено)

	// Async-ветка для JsonToToon:
	Если ИспользоватьАсинхронноеПодключениеКомпонент И КомпонентаТун <> Неопределено
		И ФорматОтветаВстроенный = 1 И ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("success") И Результат.success И Результат.Свойство("data") Тогда

		Если КонтекстДоставки <> Неопределено Тогда

			КонтекстДоставки.Вставить("Результат", Результат);
			КомпонентаТун.НачатьВызовJsonToToon(
				Новый ОписаниеОповещения("ПослеJsonToToonREST_Команды", ЭтаФорма, КонтекстДоставки),
				ЗаписатьJSON2(Результат.data));

			Возврат Неопределено;

		КонецЕсли;

		КомпонентаТун.НачатьВызовJsonToToon(
			Новый ОписаниеОповещения("ПослеJsonToToonREST", ЭтаФорма,
				Новый Структура("ДанныеЗапроса, Результат", ДанныеЗапроса, Результат)),
			ЗаписатьJSON2(Результат.data));

		Возврат Неопределено;

	КонецЕсли;

	// sync path: оригинальный вызов ПрименитьТунКонвертацию и Возврат
	Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(Результат);
	ПрименитьТунКонвертацию(Результат);

	Возврат Новый Структура("КодОтвета, Тело", 200, ЗаписатьJSON2(Результат));

КонецФункции

