		Возврат Новый Структура("success, error", Ложь, "Неверный формат имени объекта. Ожидается: Тип.Имя");
	КонецЕсли;

	ТипОбъекта = Лев(ПолноеИмя, ПозицияТочки - 1);
	ИмяОбъекта = Сред(ПолноеИмя, ПозицияТочки + 1);

