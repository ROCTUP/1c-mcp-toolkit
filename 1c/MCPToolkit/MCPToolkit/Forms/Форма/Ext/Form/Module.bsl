&НаКлиенте
Функция ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим)

	Если Найти(ТипОбъекта, "ПеречислениеСсылка.") = 1 Тогда Возврат "force_keep"; КонецЕсли;
	ПутьНаименования = ПолучитьПутьНаименованияПоТипуОбъекта(ТипОбъекта);
	Режим = "default";
	Если НЕ ПустаяСтрока(ПутьНаименования) Тогда
		Правило = ПравилаАнонимизации.Получить(ПутьНаименования);
		Если Правило <> Неопределено Тогда
			Режим = ?(Правило.action = "keep", "force_keep", "force_anonymize");
		КонецЕсли;
	КонецЕсли;
	// Планы счетов — force_keep если нет явного правила force_anonymize.
	// Проверка ДО агрессивного режима: aggressive mode не затрагивает планы счетов.
	Если Найти(ТипОбъекта, "ПланСчетовСсылка.") = 1 И Режим <> "force_anonymize" Тогда
		Возврат "force_keep";
	КонецЕсли;
	// Агрессивный режим: elevate default→force_anonymize для всех остальных типов
	Если Режим = "default" И АгрессивныйРежим Тогда
		Режим = "force_anonymize";
	КонецЕсли;
	Возврат Режим;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НайтиПозициюПоследнейТочки(СтрокаПути)

	ПозицияТочки = 0;
	ПозицияПоиска = 1;
	Пока Истина Цикл
		СледующаяПозиция = Найти(Сред(СтрокаПути, ПозицияПоиска), ".");
		Если СледующаяПозиция = 0 Тогда
			Прервать;
		КонецЕсли;
		СледующаяПозиция = ПозицияПоиска + СледующаяПозиция - 1;
		ПозицияТочки = СледующаяПозиция;
		ПозицияПоиска = СледующаяПозиция + 1;
	КонецЦикла;

	Возврат ПозицияТочки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(Результат)

	Попытка Результат.Удалить("_original_data_json");        Исключение КонецПопытки;
	Попытка Результат.Удалить("_original_data_anon_marker"); Исключение КонецПопытки;
	Попытка Результат.Удалить("_cmd_arguments_json");        Исключение КонецПопытки;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ Результат.Свойство("schema") Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат.schema = Неопределено Или ТипЗнч(Результат.schema) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Колонки = Неопределено;
	Если НЕ Результат.schema.Свойство("columns", Колонки) Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Колонка.Удалить("anonymization_mode");
		Исключение
		КонецПопытки;
		Попытка
			Колонка.Удалить("reference_presentation_mode");
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

