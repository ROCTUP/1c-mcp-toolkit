// Навигационная ссылка окна или Неопределено (окно без ссылки, ошибка доступа).
Функция НавигационнаяСсылкаОкна(ОкноКлиента)
	СсылкаОкна = Неопределено;
	Попытка
		СсылкаОкна = ОкноКлиента.ПолучитьНавигационнуюСсылку();
	Исключение
		СсылкаОкна = Неопределено;
	КонецПопытки;
