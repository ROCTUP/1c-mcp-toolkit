Функция МКПОтпечатокОткрытойОбработки()
	ИмяИсточника = РеквизитФормыВЗначение("Объект").ИспользуемоеИмяФайла;
	АдресИсточника = СтрЗаменить(ИмяИсточника, "\", "/");
