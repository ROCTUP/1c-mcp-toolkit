&НаКлиенте
Процедура ИспользоватьТочнуюАнонимизациюПриИзменении(Элемент)

	Если НЕ ИспользоватьТочнуюАнонимизацию Тогда

		// Строгий режим работает только с маскированием: сохраненный выбор строгого режима снимается.
		СохранитьВыборСтрогогоРежимаНаСервере(Ложь);

		Если СостояниеЗащиты.Строгий Тогда

			СтрогийРежимАнонимизации = Ложь;
			ВыключитьСтрогийРежимАтомарно();

		КонецЕсли;

	КонецЕсли;

	ИспользоватьТочнуюАнонимизациюСохранитьНаСервере(ИспользоватьТочнуюАнонимизацию);
	КэшСхемИнструментов = Неопределено;

	Если ВстроенныйСерверЗапущен Тогда
		Если ИспользоватьТочнуюАнонимизацию Тогда
			ПостроитьИЗаполнитьСловарьАнонимизации();
		Иначе
			АнонимизаторОчистить();
			ОбновитьТаблицуМаппинговВстроенный();
		КонецЕсли;
	КонецЕсли;

	ОбновитьОтображениеСостоянияЗащиты();

КонецПроцедуры

// Показывает состояние защиты: текст состояния, предупреждения, команду восстановления доверия
// и доступность флажка строгого режима. Данные берет из СостояниеЗащиты, ничего не меняет.
//
// Параметры:
//  Нет
//
&НаКлиенте
Процедура ОбновитьОтображениеСостоянияЗащиты()

	Если СостояниеЗащиты.ГарантияПриостановлена Тогда
		ТекстСостояния = "Гарантия приостановлена";
	ИначеЕсли НЕ СостояниеЗащиты.Строгий Тогда
		ТекстСостояния = "Выключен";
	ИначеЕсли СостояниеЗащиты.Активен Тогда
		ТекстСостояния = "Активен";
	ИначеЕсли НЕ ПустаяСтрока(СостояниеЗащиты.ПричинаНеактивности) Тогда
		ТекстСостояния = "Не активен: " + СостояниеЗащиты.ПричинаНеактивности;
	ИначеЕсли СостояниеЗащиты.Переключение Тогда
		ТекстСостояния = "Переключается";
	Иначе
		ТекстСостояния = "Не активен - нужен перезапуск";
	КонецЕсли;

	Элементы.ДекорацияСостояниеЗащиты.Заголовок = ТекстСостояния;
	Элементы.КнопкаВосстановитьДоверие.Видимость = СостояниеЗащиты.ГарантияПриостановлена;
	Элементы.ДекорацияПредупреждениеМаскирования.Видимость = ИспользоватьТочнуюАнонимизацию
		И НЕ СостояниеЗащиты.Строгий;
	Элементы.ДекорацияПримечаниеМаскирования.Видимость = ИспользоватьТочнуюАнонимизацию;
	Элементы.ФлагСтрогийРежимАнонимизации.Доступность = ИспользоватьТочнуюАнонимизацию
		И РежимПодключения = 1;

	// В строгом режиме решение принимает только шлюз подтверждения: флажки опасных операций не действуют.
	ПримечаниеСтрогого = ?(СостояниеЗащиты.Строгий, " (в строгом режиме не действует)", "");
	Элементы.ГруппаАвтоРазрешение.Доступность = НЕ СостояниеЗащиты.Строгий;
	Элементы.ФлагРазрешатьОпасныеОперацииСПодтверждением.Доступность = НЕ СостояниеЗащиты.Строгий;
	Элементы.ФлагРазрешатьОпасныеОперацииСПодтверждением.Заголовок = "Разрешать опасные операции с подтверждением"
		+ ПримечаниеСтрогого;
	Элементы.ФлагАвтоЗаписать.Заголовок = "Записать" + ПримечаниеСтрогого;
	Элементы.ФлагАвтоПривилегированныйРежим.Заголовок = "УстановитьПривилегированныйРежим" + ПримечаниеСтрогого;

КонецПроцедуры

