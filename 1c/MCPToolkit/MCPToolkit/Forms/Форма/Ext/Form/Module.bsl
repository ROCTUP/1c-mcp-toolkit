			Если Уровни = Null Или Уровни = Неопределено Тогда
				УдалитьПолеЕслиЕсть(АргументыЗапроса, "levels");
			ИначеЕсли ТипЗнч(Уровни) <> Тип("Массив") И ТипЗнч(Уровни) <> Тип("ФиксированныйМассив") Тогда
