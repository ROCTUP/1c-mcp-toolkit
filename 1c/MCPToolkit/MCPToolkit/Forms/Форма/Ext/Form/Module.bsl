				КонецЦикла;

				// Период
				Если ЕстьПериод Тогда
					ЗначениеПериода = Выборка.Период;
					КлючЗаписи.Вставить("Период", БезопасноеЗначениеДляПередачи(ЗначениеПериода));
					ЧастиПримечания.Добавить("Период=" + Строка(ЗначениеПериода));
