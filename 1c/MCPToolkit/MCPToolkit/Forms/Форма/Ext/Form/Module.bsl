		ИначеЕсли Результат.Свойство("data") Тогда
			ТекстСводки = "(данные скрыты строгим режимом, "
				+ Формат(СтрДлина(ЗаписатьJSON2(Результат.data)), "ЧГ=0") + " символов)";
		ИначеЕсли Результат.Свойство("image_base64")
			И ЗначениеЗаполнено(Результат.image_base64) Тогда
			МимТип = "image/png";
			Если Результат.Свойство("mime_type") Тогда МимТип = Результат.mime_type; КонецЕсли;
			ТекстСводки = "(изображение " + МимТип
				+ ", base64 длина " + Формат(СтрДлина(Результат.image_base64), "ЧГ=0") + " символов)";
		Иначе
			ТекстСводки = "(нет данных)";
