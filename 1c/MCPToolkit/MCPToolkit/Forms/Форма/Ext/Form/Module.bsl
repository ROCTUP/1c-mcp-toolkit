	М.Добавить("");
	М.Добавить("    # Get extended properties of a specific attribute");
	М.Добавить("    get_metadata(filter=""Справочник.Контрагенты.Реквизит.ИНН"", sections=[""properties""])");
	М.Добавить("");
	М.Добавить("    # Get extended properties of a dimension");
