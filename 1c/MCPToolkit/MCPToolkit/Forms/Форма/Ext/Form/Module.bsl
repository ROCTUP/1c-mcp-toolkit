// ВЫБОР АДРЕСА ПРИВЯЗКИ ВСТРОЕННОГО СЕРВЕРА
// ═══════════════════════════════════════════════════════════════════════════════

// ── Персистентность: одна версионированная запись в хранилище настроек ──

&НаСервереБезКонтекста
Функция ПрочитатьВыборАдресаВстроенногоСервераССервера()
	// Возвращает Структуру {Присутствует, Значение}, чтобы клиент мог отличить
	// «ключа нет вообще» (первый запуск → 0.0.0.0) от «запись есть, но невалидна/нечитаема»
	// (fail-closed → 127.0.0.1). Нельзя сводить оба случая к Неопределено.
	Результат = Новый Структура("Присутствует, Значение", Ложь, Неопределено);
	Попытка
		Значение = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ВыборАдресаВстроенногоСервера");
		Если Значение <> Неопределено Тогда
			Результат.Присутствует = Истина;
			Результат.Значение = Значение;
		КонецЕсли;
	Исключение
		// Ошибка чтения — считаем «присутствует, но нечитаемо» (fail-closed, не первый запуск)
		Результат.Присутствует = Истина;
		Результат.Значение = Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьВыборАдресаВстроенногоСервераНаСервере(ЗначениеJSON)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ВыборАдресаВстроенногоСервера", ЗначениеJSON);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция СериализоватьВыборАдреса(Выбор)
	// Проектный сериализатор (совместим с 8.2.13, в отличие от платформенного ЗаписьJSON/ЗаписатьJSON)
	Возврат ЗаписатьJSON2(Выбор);
КонецФункции

&НаКлиенте
Функция ДефолтВыбораАдреса()
	Выбор = Новый Структура;
	Выбор.Вставить("version", 1);
	Выбор.Вставить("kind", "all");
	Выбор.Вставить("interfaceId", "");
	Выбор.Вставить("displayName", "");
	Выбор.Вставить("lastAddress", "0.0.0.0");
	Возврат Выбор;
КонецФункции

&НаКлиенте
Функция ВыборАдресаНевалиден()
	Выбор = Новый Структура;
	Выбор.Вставить("version", 1);
	Выбор.Вставить("kind", "invalid");
	Выбор.Вставить("interfaceId", "");
	Выбор.Вставить("displayName", "");
	Выбор.Вставить("lastAddress", "127.0.0.1");
	Возврат Выбор;
КонецФункции

&НаКлиенте
Функция ВыборАдресаВалиден(Выбор)
	Если ТипЗнч(Выбор) <> Тип("Структура") Тогда Возврат Ложь; КонецЕсли;
	Если НЕ Выбор.Свойство("version") ИЛИ Выбор.version <> 1 Тогда Возврат Ложь; КонецЕсли;
	Если НЕ Выбор.Свойство("kind") ИЛИ ТипЗнч(Выбор.kind) <> Тип("Строка") Тогда Возврат Ложь; КонецЕсли;
	Если Выбор.kind <> "all" И Выбор.kind <> "loopback" И Выбор.kind <> "interface" Тогда
		Возврат Ложь;
	КонецЕсли;
	// Обязательные поля должны быть строками (недоверенный JSON из хранилища мог прийти с массивами и т.п.)
	Если НЕ Выбор.Свойство("interfaceId") ИЛИ ТипЗнч(Выбор.interfaceId) <> Тип("Строка")
		ИЛИ НЕ Выбор.Свойство("displayName") ИЛИ ТипЗнч(Выбор.displayName) <> Тип("Строка")
		ИЛИ НЕ Выбор.Свойство("lastAddress") ИЛИ ТипЗнч(Выбор.lastAddress) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Загрузка канонического выбора в клиентском ПриОткрытии (различаем отсутствие и невалидность)
&НаКлиенте
Процедура ЗагрузитьВыборАдресаВстроенногоСервера()
	Инфо = ПрочитатьВыборАдресаВстроенногоСервераССервера();
	Если НЕ Инфо.Присутствует Тогда
		// Ключа нет — доказанный первый запуск, дефолт 0.0.0.0 (совместимость)
		ВыборАдресаВстроенногоСервера = ДефолтВыбораАдреса();
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Инфо.Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Инфо.Значение) Тогда
		// Запись есть, но не строка / нечитаема — fail-closed, исходную запись НЕ перезаписываем
		ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
		Возврат;
	КонецЕсли;
	Попытка
		Разобранный = ПрочитатьJSON2(Инфо.Значение);
		Если ВыборАдресаВалиден(Разобранный) Тогда
			ВыборАдресаВстроенногоСервера = Разобранный;
		Иначе
			// Запись есть, но невалидна — fail-closed, исходную запись НЕ перезаписываем
			ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
		КонецЕсли;
	Исключение
		ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
	КонецПопытки;
КонецПроцедуры

// ── Список адресов выпадающего поля ──
// GetLocalAddresses — метод уже существующей компоненты MCPHttp. Список наполняется при показе
// группы и по кнопке ⟳: базовый список (искусственные пункты + сохранённый) показывается сразу без
// компоненты, затем реальные интерфейсы подтягиваются веткой async/sync (как GetRequestBody).

&НаКлиенте
Процедура КомандаОбновитьАдреса(Команда)
	ОбновитьСписокАдресов();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокАдресов()
	ПостроитьБазовыйСписокАдресов(); // мгновенно, без компоненты — выпадающий список не пуст
	// Реальные интерфейсы: компонента переиспользуется, если уже загружена, иначе грузим как везде
	Если Компонента <> Неопределено Тогда
		ПолучитьАдресаИПостроить();
	ИначеЕсли ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПодключенияМСП", ЭтаФорма),
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport", "MCPHttp");
	ИначеЕсли ПодключитьMCPHttpСинхронно() Тогда
		ПолучитьАдресаИПостроить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПодключенияМСП(Подключено, ДопПар) Экспорт
	Если Компонента <> Неопределено Тогда // уже загружена (напр. запуском сервера) — не пересоздаём
		ПолучитьАдресаИПостроить();
		Возврат;
	КонецЕсли;
	Если Подключено Тогда
		Попытка
			Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
			ПолучитьАдресаИПостроить();
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Fallback: .dll из макета через файл
	Попытка
		ДвоичныеДанные = ПолучитьМакетНаСервере();
		ИмяФайла = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ИмяФайла);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПодключенияФайлаМСП", ЭтаФорма),
			ИмяФайла, "MCPHttp");
	Исключение
		ДобавитьВЛог("Не удалось подключить MCPHttp для списка адресов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПодключенияФайлаМСП(Подключено, ДопПар) Экспорт
	Если Компонента <> Неопределено Тогда // уже загружена — не пересоздаём
		ПолучитьАдресаИПостроить();
		Возврат;
	КонецЕсли;
	Если Подключено Тогда
		Попытка
			Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
			ПолучитьАдресаИПостроить();
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	ДобавитьВЛог("Не удалось подключить внешнюю компоненту MCPHttp для списка адресов");
КонецПроцедуры

&НаКлиенте
Функция ПодключитьMCPHttpСинхронно()
	Попытка
		Рез = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport", "MCPHttp", ТипВнешнейКомпоненты.Native);
		Если НЕ Рез Тогда
			ДвоичныеДанные = ПолучитьМакетНаСервере();
			ИмяФайла = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ИмяФайла);
			ПодключитьВнешнююКомпоненту(ИмяФайла, "MCPHttp", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
	Исключение
		ДобавитьВЛог("Ошибка загрузки компоненты MCPHttp: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

// GetLocalAddresses — метод существующей компоненты. Ветка async/sync (как GetRequestBody).
&НаКлиенте
Процедура ПолучитьАдресаИПостроить()
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		Компонента.НачатьВызовПолучитьЛокальныеАдреса(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПолученияАдресов", ЭтаФорма));
		Возврат;
	КонецЕсли;
	Джсон = "";
	Попытка
		Джсон = Компонента.ПолучитьЛокальныеАдреса();
	Исключение
		ДобавитьВЛог("Ошибка получения списка адресов: " + ОписаниеОшибки());
	КонецПопытки;
	ЗаполнитьСписокАдресов_Построить(Джсон);
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПолученияАдресов(РезВызова, ПарВызова, ДопПар) Экспорт
	ЗаполнитьСписокАдресов_Построить(?(РезВызова = Неопределено, "", РезВызова));
КонецПроцедуры

// Синхронный базовый список без загрузки компоненты: искусственные пункты + сохранённый интерфейс.
// Гарантирует непустой выпадающий список при показе группы; реальные интерфейсы — по кнопке ⟳.
&НаКлиенте
Процедура ПостроитьБазовыйСписокАдресов()
	СписокВыбора = Элементы.ПолеАдресВстроенногоСервера.СписокВыбора;
	СписокВыбора.Очистить();
	КэшАдресовВстроенногоСервера = Новый Соответствие;

	КэшАдресовВстроенногоСервера.Вставить("all",
		Новый Структура("kind,interfaceId,address,displayName", "all", "", "0.0.0.0", "Все интерфейсы"));
	СписокВыбора.Добавить("all", "0.0.0.0 — все интерфейсы");
	КэшАдресовВстроенногоСервера.Вставить("loopback",
		Новый Структура("kind,interfaceId,address,displayName", "loopback", "", "127.0.0.1", "Только локально"));
	СписокВыбора.Добавить("loopback", "127.0.0.1 — только локально");

	Выбор = ВыборАдресаВстроенногоСервера;
	Если Выбор <> Неопределено И Выбор.kind = "interface" Тогда
		КэшАдресовВстроенногоСервера.Вставить("saved",
			Новый Структура("kind,interfaceId,address,displayName",
				"interface", Выбор.interfaceId, Выбор.lastAddress, Выбор.displayName));
		СписокВыбора.Добавить("saved", Выбор.lastAddress + " (" + Выбор.displayName + ")");
	КонецЕсли;

	УстановитьОтображениеВыбораАдреса();
КонецПроцедуры

// Строит СписокВыбора из JSON адресов (all/loopback + реальные интерфейсы) и обновляет отображение.
&НаКлиенте
Процедура ЗаполнитьСписокАдресов_Построить(ДжейсонАдресов)
	СписокВыбора = Элементы.ПолеАдресВстроенногоСервера.СписокВыбора;
	СписокВыбора.Очистить();
	КэшАдресовВстроенногоСервера = Новый Соответствие;

	// Искусственные пункты (компонента их не отдаёт)
	КэшАдресовВстроенногоСервера.Вставить("all",
		Новый Структура("kind,interfaceId,address,displayName", "all", "", "0.0.0.0", "Все интерфейсы"));
	СписокВыбора.Добавить("all", "0.0.0.0 — все интерфейсы");
	КэшАдресовВстроенногоСервера.Вставить("loopback",
		Новый Структура("kind,interfaceId,address,displayName", "loopback", "", "127.0.0.1", "Только локально"));
	СписокВыбора.Добавить("loopback", "127.0.0.1 — только локально");

	// Реальные IPv4-адреса от компоненты
	Адреса = Новый Массив;
	Если НЕ ПустаяСтрока(ДжейсонАдресов) Тогда
		Попытка
			Адреса = ПрочитатьJSON2(ДжейсонАдресов);
		Исключение
			ДобавитьВЛог("Ошибка разбора списка адресов: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Индекс = 0;
	Для Каждого А Из Адреса Цикл
		Ключ = "iface_" + Формат(Индекс, "ЧГ=");
		Индекс = Индекс + 1;
		КэшАдресовВстроенногоСервера.Вставить(Ключ,
			Новый Структура("kind,interfaceId,address,displayName", "interface", А.id, А.address, А.displayName));
		СписокВыбора.Добавить(Ключ, А.address + " (" + А.displayName + ")");
	КонецЦикла;

	УстановитьОтображениеВыбораАдреса();
КонецПроцедуры

// Установить отображаемый ключ в поле по каноническому выбору (отображение отделено от канонического значения)
&НаКлиенте
Процедура УстановитьОтображениеВыбораАдреса()
	Выбор = ВыборАдресаВстроенногоСервера;
	Если Выбор = Неопределено Тогда
		АдресВстроенногоСервераОтображение = "all";
		Возврат;
	КонецЕсли;
	Если Выбор.kind = "all" Тогда
		АдресВстроенногоСервераОтображение = "all";
	ИначеЕсли Выбор.kind = "loopback" Тогда
		АдресВстроенногоСервераОтображение = "loopback";
	ИначеЕсли Выбор.kind = "interface" Тогда
		НайденныйКлюч = НайтиКлючИнтерфейса(Выбор.interfaceId, Выбор.lastAddress);
		Если НайденныйКлюч <> Неопределено Тогда
			АдресВстроенногоСервераОтображение = НайденныйКлюч;
		Иначе
			// Интерфейс недоступен — нередактируемый пункт только для отображения (не для выбора)
			Элементы.ПолеАдресВстроенногоСервера.СписокВыбора.Добавить("unavailable",
				?(ПустаяСтрока(Выбор.displayName), Выбор.interfaceId, Выбор.displayName) + " — интерфейс недоступен");
			АдресВстроенногоСервераОтображение = "unavailable";
		КонецЕсли;
	Иначе
		// invalid — визуальный дефолт, канонический выбор НЕ трогаем (резолвер уйдёт на 127.0.0.1)
		АдресВстроенногоСервераОтображение = "all";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция НайтиКлючИнтерфейса(ИдИнтерфейса, ПредпочтительныйАдрес)
	КлючПоАдресу = Неопределено;
	КлючПоИнтерфейсу = Неопределено;
	Для Каждого КлючЗначение Из КэшАдресовВстроенногоСервера Цикл
		Зап = КлючЗначение.Значение;
		Если Зап.kind = "interface" И Зап.interfaceId = ИдИнтерфейса Тогда
			Если КлючПоИнтерфейсу = Неопределено Тогда
				КлючПоИнтерфейсу = КлючЗначение.Ключ;
			КонецЕсли;
			Если Зап.address = ПредпочтительныйАдрес Тогда
				КлючПоАдресу = КлючЗначение.Ключ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(КлючПоАдресу <> Неопределено, КлючПоАдресу, КлючПоИнтерфейсу);
КонецФункции

// Обработчик изменения поля (выбор из выпадающего списка): восстановить выбор из кэша по ключу
&НаКлиенте
Процедура АдресВстроенногоСервераПриИзменении(Элемент)
	ПрименитьВыборАдреса(АдресВстроенногоСервераОтображение, Истина);
КонецПроцедуры

// ЛОКАЛЬНАЯ ПРАВКА (ветка local/request-timeout-900), в оригинале этих двух процедур нет.
// Таймаут ожидания ответа компоненты. В поставке он равен 180 с и нигде не выставляется,
// из-за чего долгий запрос отдает клиенту 504, хотя в 1С продолжает считаться и досчитывается.
&НаКлиенте
Процедура ПолеТаймаутЗапросаПриИзменении(Элемент)
	Если ТаймаутЗапросаСек <= 0 Тогда
		ТаймаутЗапросаСек = 180;
	КонецЕсли;

	СохранитьТаймаутЗапросаНаСервере(ТаймаутЗапросаСек);
	ПрименитьТаймаутЗапроса();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьТаймаутЗапросаНаСервере(Знач Значение)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ТаймаутЗапросаСек", Значение);
	Исключение
		// Ошибка сохранения настроек: на работу текущего сеанса не влияет
	КонецПопытки;
КонецПроцедуры

// Свойство компоненты атомарное и читается на каждом запросе, поэтому применяется
// и к уже запущенному серверу — перезапускать его не нужно.
&НаКлиенте
Процедура ПрименитьТаймаутЗапроса()
	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Компонента.RequestTimeout = ТаймаутЗапросаСек;
	ДобавитьВЛог("Таймаут ожидания ответа: " + Формат(Компонента.RequestTimeout, "ЧГ=") + " с");
КонецПроцедуры

// Применить выбранный ключ: собрать каноническую запись из кэша и сохранить.
// ВосстановитьПриНеизвестном=Истина — откатить отображение на канонический выбор (защита от ручного ввода мусора).
&НаКлиенте
Процедура ПрименитьВыборАдреса(Ключ, ВосстановитьПриНеизвестном)
	Зап = КэшАдресовВстроенногоСервера.Получить(Ключ);
	Если Зап = Неопределено Тогда
		Если ВосстановитьПриНеизвестном Тогда
			УстановитьОтображениеВыбораАдреса();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	НовыйВыбор = Новый Структура;
	НовыйВыбор.Вставить("version", 1);
	НовыйВыбор.Вставить("kind", Зап.kind);
	НовыйВыбор.Вставить("interfaceId", Зап.interfaceId);
	НовыйВыбор.Вставить("displayName", Зап.displayName);
	НовыйВыбор.Вставить("lastAddress", Зап.address);
	ВыборАдресаВстроенногоСервера = НовыйВыбор;
	СохранитьВыборАдресаВстроенногоСервераНаСервере(СериализоватьВыборАдреса(НовыйВыбор));
КонецПроцедуры

// ── Резолв bind-адреса: читает ТОЛЬКО канонический выбор ──

// Чистый расчёт bind-адреса по каноническому выбору и JSON списка адресов (без вызова компоненты)
&НаКлиенте
Функция ВычислитьАдресПривязки(Выбор, ДжейсонАдресов)
	Если Выбор = Неопределено Тогда
		Возврат "0.0.0.0";
	КонецЕсли;
	Если Выбор.kind = "all" Тогда
		Возврат "0.0.0.0";
	ИначеЕсли Выбор.kind = "loopback" Тогда
		Возврат "127.0.0.1";
	ИначеЕсли Выбор.kind = "invalid" Тогда
		ДобавитьВЛог("Сохранённый выбор адреса невалиден, bind на 127.0.0.1");
		Возврат "127.0.0.1";
	КонецЕсли;
	// kind = interface — резолв: сохранённый адрес → единственный текущий → откат на loopback
	АдресаИнтерфейса = Новый Массив;
	Если НЕ ПустаяСтрока(ДжейсонАдресов) Тогда
		Попытка
			Адреса = ПрочитатьJSON2(ДжейсонАдресов);
			Для Каждого А Из Адреса Цикл
				Если А.id = Выбор.interfaceId Тогда
					АдресаИнтерфейса.Добавить(А.address);
				КонецЕсли;
			КонецЦикла;
		Исключение
			ДобавитьВЛог("Ошибка разбора адресов, bind на 127.0.0.1: " + ОписаниеОшибки());
			Возврат "127.0.0.1";
		КонецПопытки;
	КонецЕсли;
	Если АдресаИнтерфейса.Найти(Выбор.lastAddress) <> Неопределено Тогда
		Возврат Выбор.lastAddress; // точный осознанный выбор (в т.ч. интерфейс с несколькими IPv4)
	ИначеЕсли АдресаИнтерфейса.Количество() = 1 Тогда
		Возврат АдресаИнтерфейса[0]; // DHCP-переезд на том же интерфейсе
	Иначе
		ДобавитьВЛог("Сохранённый интерфейс " + Выбор.displayName + " недоступен/неоднозначен, bind на 127.0.0.1");
		Возврат "127.0.0.1";
	КонецЕсли;
КонецФункции

// Синхронный резолв (для sync-платформ и для не-interface выбора — без вызова компоненты)
&НаКлиенте
Функция ОпределитьАдресПривязкиСинхронно()
	Выбор = ВыборАдресаВстроенногоСервера;
	ДжейсонАдресов = "";
	Если Выбор <> Неопределено И Выбор.kind = "interface" И Компонента <> Неопределено Тогда
		Попытка
			ДжейсонАдресов = Компонента.ПолучитьЛокальныеАдреса();
		Исключение
			ДобавитьВЛог("Ошибка получения списка адресов: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Возврат ВычислитьАдресПривязки(Выбор, ДжейсонАдресов);
КонецФункции

// Обёртка SendResponse
&НаКлиенте
Процедура КомпонентаSendResponse(РзId, КодОтвета, Заголовки, Тело)
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		Компонента.НачатьВызовSendResponse(
			Новый ОписаниеОповещения("ИгнорироватьРезультатКомпоненты", ЭтаФорма),
			РзId, КодОтвета, Заголовки, Тело);
	Иначе
		Компонента.SendResponse(РзId, КодОтвета, Заголовки, Тело);
	КонецЕсли;
КонецПроцедуры

// Обёртка SendSSEEvent
&НаКлиенте
Процедура КомпонентаSendSSEEvent(РзId, Данные, Заголовки, ТипСобытия = "message")
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		Компонента.НачатьВызовSendSSEEvent(
			Новый ОписаниеОповещения("ИгнорироватьРезультатКомпоненты", ЭтаФорма),
			РзId, Данные, Заголовки, ТипСобытия);
	Иначе
		Компонента.SendSSEEvent(РзId, Данные, Заголовки, ТипСобытия);
	КонецЕсли;
КонецПроцедуры

// Обёртка CloseSSEStream
&НаКлиенте
Процедура КомпонентаCloseSSEStream(РзId)
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		Компонента.НачатьВызовCloseSSEStream(
			Новый ОписаниеОповещения("ИгнорироватьРезультатКомпоненты", ЭтаФорма),
			РзId);
	Иначе
		Компонента.CloseSSEStream(РзId);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьТунКонвертацию(Результат)
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ФорматОтветаВстроенный <> 1 Или КомпонентаТун = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Результат.Свойство("success") Или НЕ Результат.success Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Результат.Свойство("data") Тогда
		Возврат;
	КонецЕсли;
	ДанныеТун = КомпонентаТун.JsonToToon(ЗаписатьJSON2(Результат.data));
	Если ЗначениеЗаполнено(ДанныеТун) Тогда
		Результат.data = ДанныеТун;
	КонецЕсли;
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ОБРАБОТКА ВНЕШНИХ СОБЫТИЙ (диспетчер)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ОбработкаВнешнегоСобытия(Источник, Событие, Данные)

	Если Источник <> "MCPHttpTransport" Тогда Возврат КонецЕсли;

	ДанныеЗапроса = ПрочитатьJSON2(Данные);

	// SSE_CLOSED обрабатываем ДО bodyTruncated — у SSE_CLOSED нет этого поля
	Если Событие = "SSE_CLOSED" Тогда
		// Удаляем из SSEПотоки по requestId (идемпотентно)
		Для Каждого КлючЗначение Из SSEПотоки Цикл
			Если КлючЗначение.Значение = ДанныеЗапроса.id Тогда
				SSEПотоки.Удалить(КлючЗначение.Ключ);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		// Удаляем из ЛегасиССЕПотоки по requestId GET-потока
		Для Каждого КлючЗначение Из ЛегасиССЕПотоки Цикл
			Если КлючЗначение.Значение = ДанныеЗапроса.id Тогда
				ЛегасиССЕПотоки.Удалить(КлючЗначение.Ключ);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	// bodyTruncated — только для HTTP-запросов (REQUEST, MCP_POST, SSE_CONNECT)
	// Сохраняем Событие в ДанныеЗапроса для передачи в async-колбэк
	ДанныеЗапроса.Вставить("_событие", Событие);

	// Аутентификация встроенного сервера (только если задан токен).
	// Проверяем до дочитывания большого тела, чтобы неавторизованный запрос
	// не тянул body через GetRequestBody.
	Если НЕ ПроверитьТокенВстроенногоСервера(ДанныеЗапроса) Тогда
		Возврат;
	КонецЕсли;

	БольшоеТело = Ложь;
	Если ДанныеЗапроса.Свойство("bodyTruncated", БольшоеТело) И БольшоеТело = Истина Тогда
		Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			// async-ветка: получаем тело через колбэк, маршрутизация в колбэке
			Компонента.НачатьВызовGetRequestBody(
				Новый ОписаниеОповещения("ПослеПолученияТелаЗапроса", ЭтаФорма, ДанныеЗапроса),
				ДанныеЗапроса.id);
			Возврат;
		Иначе
			ДанныеЗапроса.body = Компонента.GetRequestBody(ДанныеЗапроса.id);
		КонецЕсли;
	КонецЕсли;

	ПродолжитьОбработкуЗапроса(ДанныеЗапроса);

КонецПроцедуры

// Аутентификация встроенного сервера по заголовку Authorization: Bearer <token>.
// Работает только во встроенном сервере (сюда попадают только события MCPHttpTransport).
// Пустой токен = аутентификация выключена (обратная совместимость).
// Возвращает Истина, если запрос авторизован (или проверка не требуется);
// иначе отправляет 401 и возвращает Ложь.
&НаКлиенте
Функция ПроверитьТокенВстроенногоСервера(ДанныеЗапроса)

	Токен = СокрЛП(ТокенВстроенногоСервера);
	Если ПустаяСтрока(Токен) Тогда
		Возврат Истина; // аутентификация выключена
	КонецЕсли;

	// /health оставляем открытым для liveness-проверок
	Путь = "";
	ДанныеЗапроса.Свойство("path", Путь);
	Если Путь = "/health" Тогда
		Возврат Истина;
	КонецЕсли;

	// headers — объект с ключами в нижнем регистре. ПрочитатьJSON2 может вернуть
	// как Соответствие, так и Структура (если все имена заголовков — валидные
	// идентификаторы), поэтому читаем через ПолучитьЗначениеОбъекта, который
	// безопасно обрабатывает оба типа (иначе headers["authorization"] на Структуре
	// без такого свойства бросает исключение вместо возврата Неопределено).
	Значение = "";
	Если ДанныеЗапроса.Свойство("headers") И ДанныеЗапроса.headers <> Неопределено Тогда
		Вход = ПолучитьЗначениеОбъекта(ДанныеЗапроса.headers, "authorization");
		Если Вход <> Неопределено Тогда
			Значение = СокрЛП(Вход);
		КонецЕсли;
	КонецЕсли;

	// Схема Bearer нечувствительна к регистру, токен сверяем точно
	Если Лев(НРег(Значение), 7) = "bearer " Тогда
		Если СокрЛП(Сред(Значение, 8)) = Токен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	// 401 с WWW-Authenticate.
	// Для fire-and-forget legacy message (SSE_LEGACY_MESSAGE) такого id нет в store_
	// компоненты, поэтому вызов безвреден (no-op), а сам возврат Ложь предотвращает
	// диспетчеризацию неавторизованного сообщения.
	ЗаголовкиОтвета = "{""Content-Type"":""application/json"",""WWW-Authenticate"":""Bearer""}";
	КомпонентаSendResponse(ДанныеЗапроса.id, 401, ЗаголовкиОтвета, "{""error"":""Unauthorized""}");
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура ПослеПолученияТелаЗапроса(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = ДанныеЗапроса (Структура/Соответствие)
	// НЕ использовать ЗапускСервераВПроцессе — это не startup chain!
	ДопПар.body = РезВызова;
	ПродолжитьОбработкуЗапроса(ДопПар);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбработкуЗапроса(ДанныеЗапроса)
	// Эпоха защиты на момент приема: отложенный ответ запроса прошлой эпохи заменяется ошибкой (ЗапросУстарелПоЭпохе)
	ДанныеЗапроса.Вставить("_epoch", ЭпохаЗащиты);
	Событие = "";
	ДанныеЗапроса.Свойство("_событие", Событие);
	Если Событие = "SSE_CONNECT" Тогда
		ОбработатьSSEConnect(ДанныеЗапроса);
	ИначеЕсли Событие = "SSE_LEGACY_CONNECT" Тогда
		ОбработатьSSELegacyConnect(ДанныеЗапроса);
	ИначеЕсли Событие = "SSE_LEGACY_MESSAGE" Тогда
		ОбработатьSSELegacyMessage(ДанныеЗапроса);
	ИначеЕсли Событие = "MCP_POST" Тогда
		ОбработатьMCPPost(ДанныеЗапроса);
	Иначе // "REQUEST"
		ОбработатьОбычныйЗапрос(ДанныеЗапроса);
	КонецЕсли;
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ОБРАБОТКА ОБЫЧНЫХ ЗАПРОСОВ (REST, health, DELETE /mcp)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ОбработатьОбычныйЗапрос(ДанныеЗапроса)

	Путь = ДанныеЗапроса.path;

	Если Путь = "/health" Тогда
		КомпонентаSendResponse(ДанныеЗапроса.id, 200,
			ЗаголовкиJSON(), СформироватьОтветHealth());

	ИначеЕсли Лев(Путь, 5) = "/api/" Тогда
		Ответ = ОбработатьRESTЗапрос(ДанныеЗапроса);
		Если Ответ <> Неопределено Тогда
			КомпонентаSendResponse(ДанныеЗапроса.id,
				Ответ.КодОтвета, ЗаголовкиJSON(), Ответ.Тело);
		КонецЕсли;

	ИначеЕсли Путь = "/mcp" И ДанныеЗапроса.method = "DELETE" Тогда
		ОбработатьDeleteСессии(ДанныеЗапроса);

	Иначе
		КомпонентаSendResponse(ДанныеЗапроса.id, 404,
			ЗаголовкиJSON(), "{""error"":""Not Found""}");
	КонецЕсли;

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// MCP POST /mcp (Streamable HTTP)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ОбработатьMCPPost(ДанныеЗапроса)

	// 1. Content-Type
	КонтентТип = ДанныеЗапроса.headers["content-type"];
	Если КонтентТип = Неопределено
		ИЛИ НЕ (Лев(НРег(КонтентТип), 16) = "application/json") Тогда
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 415,
			"Unsupported Media Type: Content-Type must be application/json",
			-32600);
		Возврат;
	КонецЕсли;

	// 2. Accept: оба application/json И text/event-stream
	Если НЕ ПроверитьAcceptPOST(ДанныеЗапроса) Тогда Возврат КонецЕсли;

	// 4. Парсинг JSON body
	Попытка
		ТелоJSON = ПрочитатьJSON2(ДанныеЗапроса.body);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 400,
			"Parse error: " + ТекстОшибки,
			-32700);
		Возврат;
	КонецПопытки;

	Если ТипЗнч(ТелоJSON) <> Тип("Структура") Тогда
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 400,
			"Validation error: JSON body must be an object",
			-32602);
		Возврат;
	КонецЕсли;

	// 5. Определяем тип JSON-RPC: Request / Notification / Response
	Метод = Неопределено;
	Ид = Неопределено;
	ЕстьМетод = ТелоJSON.Свойство("method", Метод);
	ЕстьИд = ТелоJSON.Свойство("id", Ид) И (Ид <> Null);

	// 6. Notification или Response → 202
	Если НЕ ЕстьМетод ИЛИ НЕ ЕстьИд Тогда
		// Для non-request сообщений требуется валидная сессия/версия протокола
		// (initialize сюда не попадает, т.к. initialize всегда request).
		Если НЕ ПроверитьПротоколВерсию(ДанныеЗапроса) Тогда Возврат КонецЕсли;
		Если НЕ ПроверитьСессию(ДанныеЗапроса) Тогда Возврат КонецЕсли;
		КомпонентаSendResponse(ДанныеЗапроса.id, 202, ЗаголовкиJSON(), "");
		Возврат;
	КонецЕсли;

	// === 7. JSON-RPC Request (method + id) → SSE-ответ ===

	// 8. mcp-session-id / mcp-protocol-version:
	// В streamable_http initialize договаривается по protocolVersion в params,
	// поэтому версию из заголовка для initialize НЕ валидируем.
	Если Метод <> "initialize" Тогда
		Если НЕ ПроверитьПротоколВерсию(ДанныеЗапроса) Тогда Возврат КонецЕсли;
		Если НЕ ПроверитьСессию(ДанныеЗапроса) Тогда Возврат КонецЕсли;
	КонецЕсли;

	Если Метод = "initialize" Тогда
		РезультатInit = ОбработатьInitialize(ТелоJSON, ДанныеЗапроса);
		ОтправитьSSEОтвет(ДанныеЗапроса,
			СформироватьJSONRPCОтвет(Ид, РезультатInit.Результат),
			РезультатInit.ИдСессии);
		Возврат;

	ИначеЕсли Метод = "tools/list" Тогда
		Результат = ПолучитьСхемыИнструментов();

	ИначеЕсли Метод = "tools/call" Тогда
		Результат = ОбработатьToolsCall(ДанныеЗапроса, ТелоJSON, Ид);
		Если Результат = Неопределено Тогда Возврат КонецЕсли; // async approval

	ИначеЕсли Метод = "ping" Тогда
		Результат = Новый Структура;

	Иначе
		ОтправитьSSEОтвет(ДанныеЗапроса,
			СформироватьJSONRPCОшибку(Ид, -32601, "Method not found"));
		Возврат;
	КонецЕсли;

	ОтправитьSSEОтвет(ДанныеЗапроса,
		СформироватьJSONRPCОтвет(Ид, Результат));

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// GET /mcp (SSE notification stream)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ОбработатьSSEConnect(ДанныеЗапроса)

	Если НЕ ПроверитьAcceptSSE(ДанныеЗапроса) Тогда Возврат КонецЕсли;
	Если НЕ ПроверитьПротоколВерсию(ДанныеЗапроса) Тогда Возврат КонецЕсли;

	// mcp-session-id опционален: клиент открывает SSE до initialize (до получения session ID)
	ИдСессии = ДанныеЗапроса.headers["mcp-session-id"];

	Если ИдСессии <> Неопределено Тогда
		// Session ID предоставлен — проверяем валидность
		Если НЕ ВалидныйФорматСессии(ИдСессии) ИЛИ МСПСессии.Получить(ИдСессии) = Неопределено Тогда
			ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 404,
				"Not Found: Invalid or expired session ID",
				-32600);
			Возврат;
		КонецЕсли;
		// Проверка: один GET stream на сессию
		Если SSEПотоки.Получить(ИдСессии) <> Неопределено Тогда
			ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 409,
				"Conflict: Only one SSE stream is allowed per session",
				-32600);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Стартуем SSE-поток (пустой eventData = только заголовки)
	КомпонентаSendSSEEvent(ДанныеЗапроса.id, "",
		СформироватьSSEЗаголовки(ДанныеЗапроса));

	// Ключ: session ID если есть, иначе request ID (очистка по SSE_CLOSED работает по значению)
	КлючПотока = ?(ИдСессии <> Неопределено, ИдСессии, ДанныеЗапроса.id);
	SSEПотоки.Вставить(КлючПотока, ДанныеЗапроса.id);

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ОБРАБОТКА LEGACY SSE (MCP 2024-11-05 transport type = "sse")
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ОбработатьSSELegacyConnect(ДанныеЗапроса)
	Если НЕ ПроверитьAcceptSSE(ДанныеЗапроса) Тогда Возврат КонецЕсли;

	// Открываем SSE-поток (Content-Type выставит C++ через set_chunked_content_provider)
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		// async-ветка: первый SendSSEEvent с колбэком, логика маппинга и второй SendSSEEvent — в колбэке
		Компонента.НачатьВызовSendSSEEvent(
			Новый ОписаниеОповещения("ПослеОткрытияSSELegacyПотока", ЭтаФорма, ДанныеЗапроса),
			ДанныеЗапроса.id, "", СформироватьSSEЗаголовки(ДанныеЗапроса), "message");
		Возврат;
	КонецЕсли;

	// sync-ветка: оригинальный код
	КомпонентаSendSSEEvent(ДанныеЗапроса.id, "", СформироватьSSEЗаголовки(ДанныеЗапроса));

	// Генерируем transport session_id (hex без дефисов)
	ТрИдСессии = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	// Маппинг: transport session → request ID GET-потока
	ЛегасиССЕПотоки.Вставить(ТрИдСессии, ДанныеЗапроса.id);

	// Шлём event: endpoint — клиент будет постить на этот URL
	УРЛ = "/mcp/message?session_id=" + ТрИдСессии;
	КомпонентаSendSSEEvent(ДанныеЗапроса.id, УРЛ, "{}", "endpoint");
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытияSSELegacyПотока(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = ДанныеЗапроса
	// Генерируем transport session_id (hex без дефисов)
	ТрИдСессии = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	// Маппинг: transport session → request ID GET-потока
	ЛегасиССЕПотоки.Вставить(ТрИдСессии, ДопПар.id);

	// Шлём event: endpoint — клиент будет постить на этот URL
	УРЛ = "/mcp/message?session_id=" + ТрИдСессии;
	КомпонентаSendSSEEvent(ДопПар.id, УРЛ, "{}", "endpoint");
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьSSELegacyMessage(ДанныеЗапроса)
	// Найти GET-поток по session_id из query
	МассивSessionId = ДанныеЗапроса.query["session_id"];
	Если МассивSessionId = Неопределено ИЛИ МассивSessionId.Количество() = 0 Тогда Возврат КонецЕсли;
	ТрИдСессии = МассивSessionId[0];

	ИдПотока = ЛегасиССЕПотоки.Получить(ТрИдСессии);
	Если ИдПотока = Неопределено Тогда Возврат КонецЕсли; // 202 уже отправлен C++

	// Разобрать JSON тело
	ТелоJSON = ПрочитатьJSON2(ДанныеЗапроса.body);
	Если ТелоJSON = Неопределено Тогда Возврат КонецЕсли;

	Метод = "";
	ТелоJSON.Свойство("method", Метод);
	Ид = Неопределено;
	ТелоJSON.Свойство("id", Ид);

	// Нотификации (нет id или id = null) — ничего не отвечаем
	Если Ид = Неопределено ИЛИ Ид = Null Тогда Возврат КонецЕсли;

	ОтветJSON = Неопределено;
	Если Метод = "initialize" Тогда
		ОтветJSON = ОбработатьLegacyInitialize(ТелоJSON, Ид);
	ИначеЕсли Метод = "tools/list" Тогда
		ОтветJSON = СформироватьJSONRPCОтвет(Ид, ПолучитьСхемыИнструментов());
	ИначеЕсли Метод = "tools/call" Тогда
		РезультатВызова = ОбработатьToolsCall(ДанныеЗапроса, ТелоJSON, Ид, ИдПотока);
		Если РезультатВызова <> Неопределено Тогда
			ОтветJSON = СформироватьJSONRPCОтвет(Ид, РезультатВызова);
		КонецЕсли; // Неопределено = async, диалог пришлёт сам через ИдПотокаSSE
	ИначеЕсли Метод = "ping" Тогда
		ОтветJSON = СформироватьJSONRPCОтвет(Ид, Новый Структура);
	Иначе
		ОтветJSON = СформироватьJSONRPCОшибку(Ид, -32601, "Method not found");
	КонецЕсли;

	Если ОтветJSON <> Неопределено Тогда
		КомпонентаSendSSEEvent(ИдПотока, ОтветJSON, "{}", "message");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ОбработатьLegacyInitialize(ТелоJSON, Ид)
	// Аналог ОбработатьInitialize, но без создания MCP-сессии и без mcp-session-id в ответе.
	// Всегда используем протокол 2024-11-05 (legacy SSE transport)

	Результат = Новый Структура;
	Результат.Вставить("protocolVersion", "2024-11-05");
	Результат.Вставить("capabilities", Новый Структура("tools",
		Новый Структура("listChanged", Ложь)));
	Результат.Вставить("serverInfo", Новый Структура("name, version",
		"1C MCP Toolkit (Native)", "1.0.0"));
	ДобавитьПравилаСтрогогоРежима(Результат);

	Возврат СформироватьJSONRPCОтвет(Ид, Результат);
КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// ВАЛИДАЦИЯ ЗАГОЛОВКОВ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьТелоJSONRPCОшибка(Сообщение, КодОшибки)
	
	// Формат ошибок как в streamable_http (python mcp):
	// {"jsonrpc":"2.0","id":"server-error","error":{"code":-32600,"message":"..."}}
	
	Тело = Новый Структура;
	Тело.Вставить("jsonrpc", "2.0");
	Тело.Вставить("id", "server-error");
	Тело.Вставить("error", Новый Структура("code, message", КодОшибки, Сообщение));
	Возврат ЗаписатьJSON2(Тело);
	
КонецФункции

&НаКлиенте
Функция ЗаголовкиJSONMCP(ДанныеЗапроса)
	
	// Как в streamable_http: Content-Type: application/json + (если сессия валидна) mcp-session-id.
	
	Если МСПСессии = Неопределено Тогда
		Возврат ЗаголовкиJSON();
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	ИдСессии = ДанныеЗапроса.headers["mcp-session-id"];
	Если ИдСессии <> Неопределено
		И ВалидныйФорматСессии(ИдСессии)
		И МСПСессии.Получить(ИдСессии) <> Неопределено Тогда
		Заголовки.Вставить("mcp-session-id", ИдСессии);
	КонецЕсли;
	
	Возврат ЗаписатьJSON2(Заголовки);
	
КонецФункции

&НаКлиенте
Процедура ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, КодОтветаHTTP, Сообщение, КодОшибки = -32600)

	КомпонентаSendResponse(ДанныеЗапроса.id, КодОтветаHTTP,
		ЗаголовкиJSONMCP(ДанныеЗапроса),
		СформироватьТелоJSONRPCОшибка(Сообщение, КодОшибки));

КонецПроцедуры

&НаКлиенте
Функция ПроверитьAcceptPOST(ДанныеЗапроса)
	Акцепт = ДанныеЗапроса.headers["accept"];
	Если Акцепт = Неопределено Тогда
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 406,
			"Not Acceptable: Client must accept both application/json and text/event-stream",
			-32600);
		Возврат Ложь;
	КонецЕсли;
	АкцептНР = НРег(СокрЛП(Акцепт));
	Если Найти(АкцептНР, "application/json") = 0
		ИЛИ Найти(АкцептНР, "text/event-stream") = 0 Тогда
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 406,
			"Not Acceptable: Client must accept both application/json and text/event-stream",
			-32600);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПроверитьAcceptSSE(ДанныеЗапроса)
	Акцепт = ДанныеЗапроса.headers["accept"];
	Если Акцепт = Неопределено
		ИЛИ Найти(НРег(СокрЛП(Акцепт)), "text/event-stream") = 0 Тогда
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 406,
			"Not Acceptable: Client must accept text/event-stream",
			-32600);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПроверитьПротоколВерсию(ДанныеЗапроса)
	Версия = ДанныеЗапроса.headers["mcp-protocol-version"];
	Если Версия = Неопределено Тогда Возврат Истина КонецЕсли;
	Если Версия <> "2024-11-05" И Версия <> "2025-03-26"
		И Версия <> "2025-06-18" И Версия <> "2025-11-25" Тогда
		ПоддерживаемыеВерсии = "2024-11-05, 2025-03-26, 2025-06-18, 2025-11-25";
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 400,
			"Bad Request: Unsupported protocol version: " + Версия + ". Supported versions: " + ПоддерживаемыеВерсии,
			-32600);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПроверитьСессию(ДанныеЗапроса)
	ИдСессии = ДанныеЗапроса.headers["mcp-session-id"];
	Если ИдСессии = Неопределено Тогда
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 400,
			"Bad Request: Missing session ID",
			-32600);
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ВалидныйФорматСессии(ИдСессии) ИЛИ МСПСессии.Получить(ИдСессии) = Неопределено Тогда
		ОтправитьMCPОшибкаJSONRPC(ДанныеЗапроса, 404,
			"Not Found: Invalid or expired session ID",
			-32600);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВалидныйФорматСессии(ИдСессии)
	// Только ASCII 0x21-0x7E (видимые, без пробелов)
	Если ПустаяСтрока(ИдСессии) Тогда Возврат Ложь КонецЕсли;
	Для Позиция = 1 По СтрДлина(ИдСессии) Цикл
		Код = КодСимвола(ИдСессии, Позиция);
		Если Код < 33 ИЛИ Код > 126 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// УПРАВЛЕНИЕ СЕССИЯМИ MCP
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция СоздатьМСПСессию()
	// Лимит: 5 сессий, удаляем самую старую
	Если МСПСессии.Количество() >= 5 Тогда
		УдалитьСамуюСтаруюСессию();
	КонецЕсли;

	ИдСессии = Строка(Новый УникальныйИдентификатор);
	МСПСессии.Вставить(ИдСессии, ТекущаяДата());

	Возврат ИдСессии;
КонецФункции

&НаКлиенте
Процедура УдалитьСамуюСтаруюСессию()
	СтарыйКлюч = Неопределено;
	СтараяДата = Неопределено;
	Для Каждого КлючЗначение Из МСПСессии Цикл
		ДатаСоздания = КлючЗначение.Значение;
		Если СтараяДата = Неопределено ИЛИ ДатаСоздания < СтараяДата Тогда
			СтараяДата = ДатаСоздания;
			СтарыйКлюч = КлючЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;

	Если СтарыйКлюч <> Неопределено Тогда
		УдалитьМСПСессию(СтарыйКлюч);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьМСПСессию(ИдСессии)
	// Удалить SSE поток синхронно ДО CloseSSEStream
	ИдПотока = SSEПотоки.Получить(ИдСессии);
	SSEПотоки.Удалить(ИдСессии);
	Если ИдПотока <> Неопределено Тогда
		КомпонентаCloseSSEStream(ИдПотока);
	КонецЕсли;
	МСПСессии.Удалить(ИдСессии);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеМСПСессии()
	SSEПотоки = Новый Соответствие;
	МСПСессии = Новый Соответствие;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьDeleteСессии(ДанныеЗапроса)
	Если НЕ ПроверитьПротоколВерсию(ДанныеЗапроса) Тогда Возврат КонецЕсли;
	Если НЕ ПроверитьСессию(ДанныеЗапроса) Тогда Возврат КонецЕсли;

	ИдСессии = ДанныеЗапроса.headers["mcp-session-id"];
	УдалитьМСПСессию(ИдСессии);

	// В proxy streamable_http DELETE /mcp возвращает 200 OK с пустым телом.
	КомпонентаSendResponse(ДанныеЗапроса.id, 200, ЗаголовкиJSON(), "");
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// MCP INITIALIZE / TOOLS/LIST
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция ОбработатьInitialize(ТелоJSON, ДанныеЗапроса)

	ИдСессии = СоздатьМСПСессию();

	// protocolVersion: как в MCP SDK — возвращаем запрошенную версию, если поддерживается,
	// иначе отдаём latest.
	ЗапрошеннаяВерсия = Неопределено;
	ПарамИнициализации = Неопределено;
	Если ТелоJSON <> Неопределено
		И ТипЗнч(ТелоJSON) = Тип("Структура")
		И ТелоJSON.Свойство("params", ПарамИнициализации)
		И ТипЗнч(ПарамИнициализации) = Тип("Структура") Тогда
		ПарамИнициализации.Свойство("protocolVersion", ЗапрошеннаяВерсия);
	КонецЕсли;
	
	ЗапрошеннаяВерсия = СокрЛП(Строка(ЗапрошеннаяВерсия));
	Если ПустаяСтрока(ЗапрошеннаяВерсия) Тогда
		ЗапрошеннаяВерсия = Неопределено;
	КонецЕсли;
	
	ВерсияОтвета = "2025-11-25";
	Если ЗапрошеннаяВерсия = "2024-11-05"
		Или ЗапрошеннаяВерсия = "2025-03-26"
		Или ЗапрошеннаяВерсия = "2025-06-18"
		Или ЗапрошеннаяВерсия = "2025-11-25" Тогда
		ВерсияОтвета = ЗапрошеннаяВерсия;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("protocolVersion", ВерсияОтвета);
	Результат.Вставить("capabilities", Новый Структура("tools",
		Новый Структура("listChanged", Ложь)));
	Результат.Вставить("serverInfo", Новый Структура("name, version",
		"1C MCP Toolkit (Native)", "1.0.0"));
	ДобавитьПравилаСтрогогоРежима(Результат);

	Возврат Новый Структура("Результат, ИдСессии", Результат, ИдСессии);

КонецФункции

&НаКлиенте
Функция ПолучитьСхемыИнструментов()

	Если СостояниеЗащиты.Строгий Тогда
		Возврат ПолучитьСхемыИнструментовСтрогий();
	КонецЕсли;

	Если КэшСхемИнструментов <> Неопределено Тогда
		Возврат КэшСхемИнструментов;
	КонецЕсли;

	Инструменты = Новый Массив;

	// execute_query
	Если ИнструментВключен_ExecuteQuery Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("execute_query",
			ОписаниеToolExecuteQuery(ИспользоватьТочнуюАнонимизацию),
			СхемаExecuteQuery()));
	КонецЕсли;

	// execute_code
	Если ИнструментВключен_ExecuteCode Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("execute_code",
			ОписаниеToolExecuteCode(ИспользоватьТочнуюАнонимизацию),
			СхемаExecuteCode()));
	КонецЕсли;

	// get_metadata
	Если ИнструментВключен_GetMetadata Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_metadata",
			ОписаниеToolGetMetadata(),
			СхемаGetMetadata()));
	КонецЕсли;

	// get_event_log
	Если ИнструментВключен_GetEventLog Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_event_log",
			ОписаниеToolGetEventLog(ИспользоватьТочнуюАнонимизацию),
			СхемаGetEventLog()));
	КонецЕсли;

	// get_object_by_link
	Если ИнструментВключен_GetObjectByLink Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_object_by_link",
			ОписаниеToolGetObjectByLink(ИспользоватьТочнуюАнонимизацию),
			СхемаGetObjectByLink()));
	КонецЕсли;

	// get_link_of_object
	Если ИнструментВключен_GetLinkOfObject Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_link_of_object",
			ОписаниеToolGetLinkOfObject(),
			СхемаGetLinkOfObject()));
	КонецЕсли;

	// find_references_to_object
	Если ИнструментВключен_FindReferences Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("find_references_to_object",
			ОписаниеToolFindReferencesToObject(ИспользоватьТочнуюАнонимизацию),
			СхемаFindReferencesToObject()));
	КонецЕсли;

	// get_access_rights
	Если ИнструментВключен_GetAccessRights Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("get_access_rights",
			ОписаниеToolGetAccessRights(ИспользоватьТочнуюАнонимизацию),
			СхемаGetAccessRights()));
	КонецЕсли;

	// get_bsl_syntax_help — только если компонента загружена и инструмент включён
	Если ИнструментВключен_GetBslSyntaxHelp И КомпонентаSyntaxHelp <> Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента(
			"get_bsl_syntax_help",
			ОписаниеToolGetBslSyntaxHelp(),
			СхемаGetBslSyntaxHelp()));
	КонецЕсли;

	// submit_for_deanonymization — только при включённой анонимизации и включённом инструменте
	Если ИнструментВключен_SubmitDeanon И ИспользоватьТочнуюАнонимизацию Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("submit_for_deanonymization",
			ОписаниеToolSubmitForDeanonymization(),
			СхемаSubmitForDeanonymization()));
	КонецЕсли;

	// get_screenshot — только если компонента загружена и инструмент включён
	Если ИнструментВключен_GetScreenshot И КомпонентаScreenCapture <> Неопределено Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента(
			"get_screenshot",
			ОписаниеToolGetScreenshot(),
			СхемаGetScreenshot()));
	КонецЕсли;

	// restart_1c_session — только если инструмент включён
	Если ИнструментВключен_Restart1cSession Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("restart_1c_session",
			ОписаниеToolRestart1cSession(),
			СхемаRestart1cSession()));
	КонецЕсли;

	// close_1c_session — только если инструмент включён
	Если ИнструментВключен_Close1cSession Тогда
		Инструменты.Добавить(СоздатьСхемуИнструмента("close_1c_session",
			ОписаниеToolClose1cSession(),
			СхемаClose1cSession()));
	КонецЕсли;

	КэшСхемИнструментов = Новый Структура("tools", Инструменты);
	Возврат КэшСхемИнструментов;

КонецФункции

// Список инструментов для tools/list в строгом режиме: только включенные записи закрытого реестра,
// в порядке реестра. Кэш КэшСхемИнструментов не читается и не заполняется.
//
// Возвращаемое значение:
//  Структура - ключ tools: Массив схем инструментов (как в ПолучитьСхемыИнструментов)
//
&НаКлиенте
Функция ПолучитьСхемыИнструментовСтрогий()

	Реестр = РеестрИнструментов();
	Инструменты = Новый Массив;

	Для Каждого ИмяИнструмента Из ИменаИнструментовСтрогийПорядок() Цикл

		Если Реестр.Получить(ИмяИнструмента) <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Схема = СхемаИнструментаСтрогийПервая(ИмяИнструмента);

		Если Схема = Неопределено Тогда

			Схема = СхемаИнструментаСтрогийВторая(ИмяИнструмента);

		КонецЕсли;

		Если Схема <> Неопределено Тогда

			ДобавитьПравилаСтрогогоРежимаВОписание(Схема);
			Инструменты.Добавить(Схема);

		КонецЕсли;

	КонецЦикла;

	Возврат Новый Структура("tools", Инструменты);

КонецФункции

// Правила строгого режима для клиента: одна короткая строка (английский и русский).
// Клиент, который не видел initialize (восстановленная сессия), получает ее в описании каждого инструмента.
//
// Возвращаемое значение:
//  Строка - текст правил
//
&НаКлиенте
Функция ПравилаСтрогогоРежимаДляКлиента()

	Возврат "Strict anonymization mode is on. Do not try to recover masked values. If a real value is needed, "
		+ "explain why in the 'justification' parameter and wait for the user's confirmation. / "
		+ "Включен строгий режим анонимизации: не пытайтесь восстановить скрытые значения; если нужно реальное "
		+ "значение, объясните зачем в параметре 'justification' и дождитесь подтверждения пользователя.";

КонецФункции

// Добавляет поле instructions с правилами в результат initialize, только в строгом режиме.
// Общий для streamable HTTP и legacy SSE initialize.
//
// Параметры:
//  Результат - Структура - результат initialize (protocolVersion, capabilities, serverInfo)
//
&НаКлиенте
Процедура ДобавитьПравилаСтрогогоРежима(Результат)

	Если СостояниеЗащиты.Строгий Тогда

		Результат.Вставить("instructions", ПравилаСтрогогоРежимаДляКлиента());

	КонецЕсли;

КонецПроцедуры

// Ставит строку правил в начало описания инструмента (строгий режим).
//
// Параметры:
//  Схема - Структура - схема инструмента (name, description, inputSchema)
//
&НаКлиенте
Процедура ДобавитьПравилаСтрогогоРежимаВОписание(Схема)

	Схема.description = ПравилаСтрогогоРежимаДляКлиента() + Символы.ПС + Схема.description;

КонецПроцедуры

// Имена инструментов в порядке, в котором их отдает ПолучитьСхемыИнструментов.
//
// Возвращаемое значение:
//  Массив - имена инструментов (Строка)
//
&НаКлиенте
Функция ИменаИнструментовСтрогийПорядок()

	Имена = Новый Массив;
	Имена.Добавить("execute_query");
	Имена.Добавить("execute_code");
	Имена.Добавить("get_metadata");
	Имена.Добавить("get_event_log");
	Имена.Добавить("get_object_by_link");
	Имена.Добавить("get_link_of_object");
	Имена.Добавить("find_references_to_object");
	Имена.Добавить("get_access_rights");
	Имена.Добавить("get_bsl_syntax_help");
	Имена.Добавить("submit_for_deanonymization");
	Имена.Добавить("get_screenshot");
	Имена.Добавить("restart_1c_session");
	Имена.Добавить("close_1c_session");

	Возврат Имена;

КонецФункции

// Схема инструмента по имени (первые инструменты порядка). Те же описания и схемы, что в ПолучитьСхемыИнструментов.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
// Возвращаемое значение:
//  Структура, Неопределено - схема инструмента; Неопределено, если имя относится к другой группе
//
&НаКлиенте
Функция СхемаИнструментаСтрогийПервая(ИмяИнструмента)

	Если ИмяИнструмента = "execute_query" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolExecuteQuery(ИспользоватьТочнуюАнонимизацию), СхемаСОбоснованием(СхемаExecuteQuery()));
	КонецЕсли;

	Если ИмяИнструмента = "execute_code" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolExecuteCode(ИспользоватьТочнуюАнонимизацию), СхемаСОбоснованием(СхемаExecuteCode()));
	КонецЕсли;

	Если ИмяИнструмента = "get_metadata" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента, ОписаниеToolGetMetadata(), СхемаGetMetadata());
	КонецЕсли;

	Если ИмяИнструмента = "get_event_log" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolGetEventLog(ИспользоватьТочнуюАнонимизацию), СхемаGetEventLog());
	КонецЕсли;

	Если ИмяИнструмента = "get_object_by_link" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolGetObjectByLink(ИспользоватьТочнуюАнонимизацию), СхемаGetObjectByLink());
	КонецЕсли;

	Если ИмяИнструмента = "get_link_of_object" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента, ОписаниеToolGetLinkOfObject(), СхемаGetLinkOfObject());
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Добавляет в схему execute_query / execute_code необязательный параметр justification (только строгий режим).
// Обоснование клиента показывается человеку в шлюзе как непроверенный текст и никогда не деанонимизируется.
//
// Параметры:
//  ВходнаяСхема - Структура - новая входная схема инструмента (СхемаExecuteQuery / СхемаExecuteCode); дополняется
//
// Возвращаемое значение:
//  Структура - та же входная схема
//
&НаКлиенте
Функция СхемаСОбоснованием(ВходнаяСхема)

	ВходнаяСхема.properties.Вставить("justification", Новый Структура("type, description", "string",
		"Optional: why real values are needed. Shown to the user in the confirmation dialog as unverified text; "
		+ "never de-anonymized."));

	Возврат ВходнаяСхема;

КонецФункции

// Схема инструмента по имени (остальные инструменты порядка). Те же описания и схемы, что в ПолучитьСхемыИнструментов.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
// Возвращаемое значение:
//  Структура, Неопределено - схема инструмента; Неопределено, если имя неизвестно
//
&НаКлиенте
Функция СхемаИнструментаСтрогийВторая(ИмяИнструмента)

	Если ИмяИнструмента = "find_references_to_object" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolFindReferencesToObject(ИспользоватьТочнуюАнонимизацию), СхемаFindReferencesToObject());
	КонецЕсли;

	Если ИмяИнструмента = "get_access_rights" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolGetAccessRights(ИспользоватьТочнуюАнонимизацию), СхемаGetAccessRights());
	КонецЕсли;

	Если ИмяИнструмента = "get_bsl_syntax_help" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента, ОписаниеToolGetBslSyntaxHelp(), СхемаGetBslSyntaxHelp());
	КонецЕсли;

	Если ИмяИнструмента = "submit_for_deanonymization" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolSubmitForDeanonymization(), СхемаSubmitForDeanonymization());
	КонецЕсли;

	Если ИмяИнструмента = "get_screenshot" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента, ОписаниеToolGetScreenshot(), СхемаGetScreenshot());
	КонецЕсли;

	Если ИмяИнструмента = "restart_1c_session" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента,
			ОписаниеToolRestart1cSession(), СхемаRestart1cSession());
	КонецЕсли;

	Если ИмяИнструмента = "close_1c_session" Тогда
		Возврат СоздатьСхемуИнструмента(ИмяИнструмента, ОписаниеToolClose1cSession(), СхемаClose1cSession());
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: РЕЕСТР И КАНОНИЧЕСКИЙ ВЫЗОВ
// ─────────────────────────────────────────────────────────────────────────────────

// Закрытый реестр инструментов встроенного сервера: имя -> инструмент включен.
// Один источник и для tools/list, и для вызова (MCP и REST) в строгом режиме.
//
// Возвращаемое значение:
//  Соответствие - ключ: имя инструмента (Строка); значение: инструмент включен (Булево)
//
&НаКлиенте
Функция РеестрИнструментов()

	Реестр = Новый Соответствие;
	Реестр.Вставить("execute_query", ИнструментВключен_ExecuteQuery);
	Реестр.Вставить("execute_code", ИнструментВключен_ExecuteCode);
	Реестр.Вставить("get_metadata", ИнструментВключен_GetMetadata);
	Реестр.Вставить("get_event_log", ИнструментВключен_GetEventLog);
	Реестр.Вставить("get_object_by_link", ИнструментВключен_GetObjectByLink);
	Реестр.Вставить("get_link_of_object", ИнструментВключен_GetLinkOfObject);
	Реестр.Вставить("find_references_to_object", ИнструментВключен_FindReferences);
	Реестр.Вставить("get_access_rights", ИнструментВключен_GetAccessRights);
	Реестр.Вставить("get_bsl_syntax_help", ИнструментВключен_GetBslSyntaxHelp И КомпонентаSyntaxHelp <> Неопределено);
	Реестр.Вставить("submit_for_deanonymization", ИнструментВключен_SubmitDeanon И ИспользоватьТочнуюАнонимизацию);
	Реестр.Вставить("get_screenshot", ИнструментВключен_GetScreenshot И КомпонентаScreenCapture <> Неопределено);
	Реестр.Вставить("restart_1c_session", ИнструментВключен_Restart1cSession);
	Реестр.Вставить("close_1c_session", ИнструментВключен_Close1cSession);

	Возврат Реестр;

КонецФункции

// Состояние инструмента по дословному имени: Неопределено, если имени нет в реестре.
// Сравнение точное (с учетом регистра и длины), без СокрЛП и без смены регистра.
//
// Параметры:
//  СыроеИмя - Произвольный - имя инструмента, как оно пришло от клиента
//
// Возвращаемое значение:
//  Булево, Неопределено - включен ли инструмент; Неопределено, если имени нет в реестре
//
&НаКлиенте
Функция СостояниеИнструментаПоТочномуИмени(СыроеИмя)

	Если ТипЗнч(СыроеИмя) <> Тип("Строка") Тогда

		Возврат Неопределено;

	КонецЕсли;

	Для Каждого Элемент Из РеестрИнструментов() Цикл

		Если СтрДлина(Элемент.Ключ) = СтрДлина(СыроеИмя) И Элемент.Ключ = СыроеИмя Тогда

			Возврат Элемент.Значение;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Канонический вызов строгого режима. Имя сверяется с реестром дословно: без СокрЛП и без смены регистра.
// Возвращает структуру: Ошибка (код или пустая строка), Имя, Аргументы, Транспорт, Эпоха.
// Все нижележащие слои (проверка, шлюз, выполнение, маскирование) работают только с полем Имя.
//
// Параметры:
//  СыроеИмя - Произвольный - имя инструмента, как оно пришло от клиента
//  Аргументы - Произвольный - аргументы вызова, переносятся в результат без изменений
//  Транспорт - Строка - транспорт вызова (MCP или REST)
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка), Имя (Строка), Аргументы, Транспорт (Строка), Эпоха (Число)
//
&НаКлиенте
Функция РазрешитьКаноническийВызов(СыроеИмя, Аргументы, Транспорт)

	Вызов = Новый Структура("Ошибка, Имя, Аргументы, Транспорт, Эпоха", "", "", Аргументы, Транспорт, ЭпохаЗащиты);
	Включен = СостояниеИнструментаПоТочномуИмени(СыроеИмя);

	Если Включен = Неопределено Тогда

		Вызов.Ошибка = "E_TOOL_UNKNOWN";

	ИначеЕсли Включен <> Истина Тогда

		Вызов.Ошибка = "E_TOOL_DISABLED";

	Иначе

		Вызов.Имя = СыроеИмя;

	КонецЕсли;

	Возврат Вызов;

КонецФункции

// Ошибка строгого режима: фиксированный публичный код и, при необходимости, имя параметра. Значения не подставляются.
//
// Параметры:
//  Код - Строка - публичный код ошибки (E_...)
//  ИмяПараметра - Строка - имя параметра, к которому относится ошибка; пусто, если ошибка не про параметр
//
// Возвращаемое значение:
//  Структура - success (Булево), error (Строка), error_code (Строка) и, если задано, parameter (Строка)
//
&НаКлиенте
Функция ОшибкаСтрогогоРежима(Код, ИмяПараметра = "")

	Ошибка = Новый Структура("success, error, error_code", Ложь, ТекстОшибкиСтрогогоРежима(Код), Код);

	Если ЗначениеЗаполнено(ИмяПараметра) Тогда

		Ошибка.Вставить("parameter", ИмяПараметра);

	КонецЕсли;

	Возврат Ошибка;

КонецФункции

// Фиксированный двуязычный текст ошибки по коду. Значения запроса в текст не попадают.
//
// Параметры:
//  Код - Строка - публичный код ошибки (E_...)
//
// Возвращаемое значение:
//  Строка - фиксированный текст ошибки; для неизвестного кода - общий текст
//
&НаКлиенте
Функция ТекстОшибкиСтрогогоРежима(Код)

	Текст = ТаблицаОшибокСтрогогоРежима().Получить(Код);

	Если Текст = Неопределено Тогда

		Возврат "Ошибка / Error";

	КонецЕсли;

	Возврат Текст;

КонецФункции

// Таблица публичных кодов ошибок строгого режима: код -> фиксированный двуязычный текст.
// Единственное место, где объявляются коды: все остальные слои берут текст и проверку кода отсюда.
//
// Возвращаемое значение:
//  Соответствие - ключ: код ошибки (Строка); значение: фиксированный текст (Строка)
//
&НаКлиенте
Функция ТаблицаОшибокСтрогогоРежима()

	Тексты = Новый Соответствие;
	Тексты.Вставить("E_TOOL_UNKNOWN", "Неизвестный инструмент / Unknown tool");
	Тексты.Вставить("E_TOOL_DISABLED", "Инструмент отключен / Tool is disabled");
	Тексты.Вставить("E_PARAM_UNKNOWN", "Неизвестный параметр / Unknown parameter");
	Тексты.Вставить("E_PARAM_INTERNAL", "Внутренний параметр запрещен / Internal parameter is not allowed");
	Тексты.Вставить("E_PARAM_TOKEN_STRUCTURAL", "Токен в структурной позиции запрещен / Token in a structural position");
	Тексты.Вставить("E_PARAM_FORMAT", "Неверный формат параметра / Invalid parameter format");
	Тексты.Вставить("E_STRICT_INACTIVE", "Строгий режим не активен / Strict mode is not active");
	Тексты.Вставить("E_EPOCH_CHANGED", "Состояние защиты изменилось / Protection state has changed");
	Тексты.Вставить("E_GATE_REJECTED", "Вызов отклонен пользователем / Call rejected by the user");
	Тексты.Вставить("E_GATE_TIMEOUT", "Время подтверждения истекло / Confirmation timed out");
	Тексты.Вставить("E_EXECUTION", "Ошибка выполнения / Execution error");
	Тексты.Вставить("E_NOT_FOUND", "Не найдено / Not found");
	Тексты.Вставить("E_TOKEN_UNKNOWN", "Неизвестный токен / Unknown token");

	Возврат Тексты;

КонецФункции

// Приводит результат инструмента в строгом режиме к фиксированной ошибке. Неуспешный результат (success не Истина
// или поле error без success) заменяется на {success, error, error_code[, parameter]}: код берется из результата,
// только если он есть в таблице кодов, иначе E_EXECUTION; имя параметра - только если оно есть в контракте
// инструмента. Тексты платформы, значения клиента и отладочное поле debug наружу не уходят. Вне строгого режима
// результат возвращается без изменений.
//
// Параметры:
//  Результат - Произвольный - результат выполнения инструмента
//  ИмяИнструмента - Строка - имя инструмента; пусто, если неизвестно (имя параметра тогда не возвращается)
//
// Возвращаемое значение:
//  Произвольный - результат без текстов ошибок и отладочных полей
//
&НаКлиенте
Функция ЗакрытьОшибкуРезультатаСтрогогоРежима(Результат, ИмяИнструмента)

	Если НЕ СостояниеЗащиты.Строгий Или ТипЗнч(Результат) <> Тип("Структура") Тогда

		Возврат Результат;

	КонецЕсли;

	Успех = Неопределено;
	ЕстьУспех = Результат.Свойство("success", Успех);

	Если ЕстьУспех И Успех = Истина Тогда

		Результат.Удалить("debug");

		Возврат Результат;

	КонецЕсли;

	Если НЕ ЕстьУспех И НЕ Результат.Свойство("error") Тогда

		Возврат Результат;

	КонецЕсли;

	Код = Неопределено;
	Результат.Свойство("error_code", Код);

	Если ТипЗнч(Код) <> Тип("Строка") Или ТаблицаОшибокСтрогогоРежима().Получить(Код) = Неопределено Тогда

		Код = "E_EXECUTION";

	КонецЕсли;

	Возврат ОшибкаСтрогогоРежима(Код, ИмяПараметраИзКонтракта(Результат, ИмяИнструмента));

КонецФункции

// Имя параметра из результата ошибки, если оно есть в контракте инструмента; иначе пустая строка.
//
// Параметры:
//  Результат - Структура - результат ошибки (поле parameter)
//  ИмяИнструмента - Строка - имя инструмента; пусто, если неизвестно
//
// Возвращаемое значение:
//  Строка - имя параметра из контракта или пустая строка
//
&НаКлиенте
Функция ИмяПараметраИзКонтракта(Результат, ИмяИнструмента)

	ИмяПараметра = Неопределено;
	Результат.Свойство("parameter", ИмяПараметра);

	Если ТипЗнч(ИмяПараметра) <> Тип("Строка") Или ТипЗнч(ИмяИнструмента) <> Тип("Строка")
		Или ПустаяСтрока(ИмяИнструмента) Тогда

		Возврат "";

	КонецЕсли;

	Если КонтрактПараметровИнструмента(ИмяИнструмента).Получить(ИмяПараметра) = Неопределено Тогда

		Возврат "";

	КонецЕсли;

	Возврат ИмяПараметра;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ВХОД ВЫЗОВА (MCP И REST)
// ─────────────────────────────────────────────────────────────────────────────────

// Вход tools/call в строгом режиме. Вызывается первым оператором ОбработатьToolsCall:
// до перехвата restart/close, деанонимизации и проверки опасных слов.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  ТелоJSON - Структура - разобранное тело JSON-RPC запроса
//  Ид - Произвольный - идентификатор JSON-RPC запроса
//  ИдПотокаSSE - Строка - идентификатор SSE-потока для отложенного ответа
//
// Возвращаемое значение:
//  Структура, Неопределено - результат tools/call или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ОбработатьToolsCallСтрогий(ДанныеЗапроса, ТелоJSON, Ид, ИдПотокаSSE)

	Если СостояниеЗащиты.Переключение Или НЕ СостояниеЗащиты.Активен Тогда

		Возврат ОтветОшибкиСтрогогоMCP(ОшибкаСтрогогоРежима("E_STRICT_INACTIVE"));

	КонецЕсли;

	ПараметрыЗапроса = Неопределено;
	ТелоJSON.Свойство("params", ПараметрыЗапроса);

	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда

		Возврат СформироватьToolsCallОшибку("Missing params");

	КонецЕсли;

	СыроеИмя = Неопределено;
	ПараметрыЗапроса.Свойство("name", СыроеИмя);
	Аргументы = Неопределено;
	ПараметрыЗапроса.Свойство("arguments", Аргументы);

	Если Аргументы = Неопределено Тогда

		Аргументы = Новый Структура;

	КонецЕсли;

	Вызов = РазрешитьКаноническийВызов(СыроеИмя, Аргументы, "mcp");

	Если НЕ ПустаяСтрока(КодОшибкиВызова(Вызов)) Тогда

		Возврат ОтветОшибкиСтрогогоMCP(ОшибкаСтрогогоРежима(Вызов.Ошибка));

	КонецЕсли;

	КодОшибкиJSON = КодОшибкиСырогоТелаСтрогий(ДанныеЗапроса.body, ПутьПараметровЗапросаВJSON(Вызов.Имя, "mcp"));

	Если НЕ ПустаяСтрока(КодОшибкиJSON) Тогда

		Возврат ОтветОшибкиСтрогогоMCP(ОшибкаСтрогогоРежима(КодОшибкиJSON));

	КонецЕсли;

	Доставка = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE", "mcp", ДанныеЗапроса, Ид, ИдПотокаSSE);

	Возврат ПровестиВызовСтрогогоРежима(Вызов, Доставка);

КонецФункции

// Вход REST-запроса в строгом режиме. Вызывается первым оператором ОбработатьRESTЗапрос.
// Имя инструмента - хвост пути после "/api/" дословно; ключ channel не входит в контракт и отклоняется при чтении параметров.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса (id, method, path, query, body)
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ (КодОтвета, Тело) или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ОбработатьRESTЗапросСтрогий(ДанныеЗапроса)

	Если СостояниеЗащиты.Переключение Или НЕ СостояниеЗащиты.Активен Тогда

		Возврат ОтветОшибкиСтрогогоREST(ОшибкаСтрогогоРежима("E_STRICT_INACTIVE"));

	КонецЕсли;

	Вызов = РазрешитьКаноническийВызов(ИмяИнструментаИзПутиREST(ДанныеЗапроса.path), Новый Структура, "rest");

	Если НЕ ПустаяСтрока(Вызов.Ошибка) Тогда

		Возврат ОтветОшибкиСтрогогоREST(ОшибкаСтрогогоРежима(Вызов.Ошибка));

	КонецЕсли;

	Команда = Новый Структура("id, tool", ДанныеЗапроса.id, Вызов.Имя);
	RESTОшибка = ПрочитатьПараметрыRESTСтрогий(ДанныеЗапроса, Команда);

	Если RESTОшибка <> Неопределено Тогда

		Возврат RESTОшибка;

	КонецЕсли;

	Вызов.Аргументы = Команда.params;

	Если НЕ ПустаяСтрока(КодОшибкиВызова(Вызов)) Тогда

		Возврат ОтветОшибкиСтрогогоREST(ОшибкаСтрогогоРежима(Вызов.Ошибка));

	КонецЕсли;

	Доставка = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE", "rest", ДанныеЗапроса, ДанныеЗапроса.id, "");

	Возврат ПровестиВызовСтрогогоРежима(Вызов, Доставка);

КонецФункции

// Чтение параметров REST-запроса в строгом режиме. Фиксированные коды вместо текстов разбора и проверки:
// внутренние ключи query проверяются до числовых проверок, ошибки формата не возвращают значений клиента.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса (method, query, body)
//  Команда - Структура - команда выполнения; в нее записывается params
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено, если параметры прочитаны
//
&НаКлиенте
Функция ПрочитатьПараметрыRESTСтрогий(ДанныеЗапроса, Команда)

	ОшибкаМетода = ОшибкаМетодаRESTСтрогий(Команда.tool, ДанныеЗапроса);

	Если ОшибкаМетода <> Неопределено Тогда

		Возврат ОшибкаМетода;

	КонецЕсли;

	Если Команда.tool = "restart_1c_session" Или Команда.tool = "close_1c_session" Тогда

		Возврат ПрочитатьПараметрыRESTСессионногоИнструмента(ДанныеЗапроса, Команда);

	КонецЕсли;

	Если ДанныеЗапроса.method = "GET" Тогда

		КодОшибки = ПрочитатьQueryRESTСтрогий(ДанныеЗапроса, Команда);

	Иначе

		КодОшибки = ПрочитатьТелоRESTСтрогий(ДанныеЗапроса, Команда);

	КонецЕсли;

	Если ПустаяСтрока(КодОшибки) Тогда

		Возврат Неопределено;

	КонецЕсли;

	Возврат ОтветОшибкиСтрогогоREST(ОшибкаСтрогогоРежима(КодОшибки));

КонецФункции

// Ответ 405 для инструмента, который принимает только POST (submit_for_deanonymization).
//
// Параметры:
//  ИмяИнструмента - Строка - каноническое имя инструмента
//  ДанныеЗапроса - Структура - данные HTTP-запроса (method)
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено, если метод допустим
//
&НаКлиенте
Функция ОшибкаМетодаRESTСтрогий(ИмяИнструмента, ДанныеЗапроса)

	Если ИмяИнструмента = "submit_for_deanonymization" И ДанныеЗапроса.method <> "POST" Тогда

		Возврат СформироватьRESTОшибка(405, "Method not allowed: " + ИмяИнструмента + " requires POST");

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Чтение query GET-запроса в Команда.params со строгими проверками: внутренние ключи, channel, повторные ключи,
// числовые параметры.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  Команда - Структура - команда выполнения; в нее записывается params
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция ПрочитатьQueryRESTСтрогий(ДанныеЗапроса, Команда)

	RESTПараметры = ПрочитатьQueryREST(ДанныеЗапроса);
	КодОшибки = ПроверитьВнутренниеПоляКлиента(RESTПараметры);

	Если ПустаяСтрока(КодОшибки) И ЕстьКлючВQueryREST(ДанныеЗапроса, "channel") Тогда

		КодОшибки = "E_PARAM_UNKNOWN";

	КонецЕсли;

	Если ПустаяСтрока(КодОшибки) Тогда

		КодОшибки = КодОшибкиПовторныхКлючейREST(Команда.tool, RESTПараметры);

	КонецЕсли;

	Если ПустаяСтрока(КодОшибки) И ПроверитьЧисловыеПараметрыRESTGET(RESTПараметры) <> Неопределено Тогда

		КодОшибки = "E_PARAM_FORMAT";

	КонецЕсли;

	Команда.Вставить("params", RESTПараметры);

	Возврат КодОшибки;

КонецФункции

// Параметры REST-вызова restart_1c_session и close_1c_session. Только POST: остальные методы получают 405 до чтения
// параметров (запрос на перезапуск или закрытие не должен выполняться по GET). У инструментов нет параметров, поэтому
// пустое тело допустимо; непустое тело читается как у остальных инструментов и проходит контракт (параметров нет).
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  Команда - Структура - команда выполнения; в нее записывается params
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено, если параметры прочитаны
//
&НаКлиенте
Функция ПрочитатьПараметрыRESTСессионногоИнструмента(ДанныеЗапроса, Команда)

	Если ДанныеЗапроса.method <> "POST" Тогда

		Возврат СформироватьRESTОшибка(405, "Method not allowed: " + Команда.tool + " requires POST");

	КонецЕсли;

	Если ПустаяСтрока(ДанныеЗапроса.body) Тогда

		Команда.Вставить("params", Новый Структура);

		Возврат Неопределено;

	КонецЕсли;

	КодОшибки = ПрочитатьТелоRESTСтрогий(ДанныеЗапроса, Команда);

	Если ПустаяСтрока(КодОшибки) Тогда

		Возврат Неопределено;

	КонецЕсли;

	Возврат ОтветОшибкиСтрогогоREST(ОшибкаСтрогогоРежима(КодОшибки));

КонецФункции

// Читает JSON-тело POST в Команда.params; ключ channel отклоняется (E_PARAM_UNKNOWN), текст ошибки разбора не возвращается.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  Команда - Структура - команда выполнения; в нее записывается params
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция ПрочитатьТелоRESTСтрогий(ДанныеЗапроса, Команда)

	КодОшибки = КодОшибкиСырогоТелаСтрогий(ДанныеЗапроса.body, ПутьПараметровЗапросаВJSON(Команда.tool, "rest"));

	Если НЕ ПустаяСтрока(КодОшибки) Тогда

		Возврат КодОшибки;

	КонецЕсли;

	Попытка

		ТелоREST = ПрочитатьJSON2(ДанныеЗапроса.body);

	Исключение

		Возврат "E_PARAM_FORMAT";

	КонецПопытки;

	Если ТипЗнч(ТелоREST) <> Тип("Структура") Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Команда.Вставить("params", ТелоREST);
	КодОшибки = ПроверитьВнутренниеПоляКлиента(ТелоREST);

	Если ПустаяСтрока(КодОшибки) И ТелоREST.Свойство("channel") Тогда

		КодОшибки = "E_PARAM_UNKNOWN";

	КонецЕсли;

	Возврат КодОшибки;

КонецФункции

// Путь к объекту параметров запроса (execute_query.params) в тексте JSON-запроса: имена его свойств проверяются
// по сырому тексту, потому что Структура при чтении сливает и усекает ключи.
//
// Параметры:
//  ИмяИнструмента - Строка - каноническое имя инструмента
//  Транспорт - Строка - mcp (params.arguments.params) или rest (params)
//
// Возвращаемое значение:
//  Массив, Неопределено - имена свойств от корня; Неопределено, если у инструмента нет такого объекта
//
&НаКлиенте
Функция ПутьПараметровЗапросаВJSON(ИмяИнструмента, Транспорт)

	Если ИмяИнструмента <> "execute_query" Тогда

		Возврат Неопределено;

	КонецЕсли;

	Путь = Новый Массив;

	Если Транспорт = "mcp" Тогда

		Путь.Добавить("params");
		Путь.Добавить("arguments");

	КонецЕсли;

	Путь.Добавить("params");

	Возврат Путь;

КонецФункции

// Строгая проверка сырого текста JSON до снисходительного разбора ПрочитатьJSON2: текст читается потоком
// платформенного ЧтениеJSON, неверный JSON дает E_PARAM_FORMAT. Сырые имена свойств объекта по пути ЦельJSON
// проходят то же правило, что и разобранные параметры запроса (ЕстьЗапрещенноеИмяПараметраЗапроса), плюс повтор
// имени без изменения регистра. Ключи объектов на пути к цели обязаны быть идентификаторами: усеченный ключ
// ("params ") иначе подменил бы настоящий. Любое неожиданное состояние - ошибка.
//
// Параметры:
//  ТекстJSON - Строка - сырой текст JSON
//  ЦельJSON - Массив, Неопределено - путь к объекту параметров запроса (см. ПутьПараметровЗапросаВJSON)
//
// Возвращаемое значение:
//  Строка - E_PARAM_FORMAT, E_PARAM_INTERNAL или пустая строка
//
&НаКлиенте
Функция КодОшибкиСырогоТелаСтрогий(ТекстJSON, ЦельJSON)

	Если ТипЗнч(ТекстJSON) <> Тип("Строка") Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Обход = ОбойтиСыроеТелоСтрогий(ТекстJSON, ЦельJSON);

	Если Обход = Неопределено Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Если Обход.Отклонен Тогда

		Возврат "E_PARAM_INTERNAL";

	КонецЕсли;

	Для Каждого ИмяСвойств Из Обход.Наборы Цикл

		Если ЕстьЗапрещенныйНаборСырыхИмен(ИмяСвойств) Тогда

			Возврат "E_PARAM_INTERNAL";

		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Потоковый обход текста JSON. Платформенный ЧтениеJSON берется через Вычислить: прямое упоминание типа не
// компилируется на хостах с режимом совместимости до 8.3.6.
//
// Параметры:
//  ТекстJSON - Строка - сырой текст JSON
//  ЦельJSON - Массив, Неопределено - путь к объекту, чьи имена свойств собираются
//
// Возвращаемое значение:
//  Структура, Неопределено - Наборы (Массив массивов имен), Отклонен; Неопределено при неверном JSON
//
&НаКлиенте
Функция ОбойтиСыроеТелоСтрогий(ТекстJSON, ЦельJSON)

	Обход = Новый Структура;
	Обход.Вставить("Путь", Новый Массив);
	Обход.Вставить("Виды", Новый Массив);
	Обход.Вставить("Ключ", Неопределено);
	Обход.Вставить("Сбор", Неопределено);
	Обход.Вставить("Цель", ЦельJSON);
	Обход.Вставить("ГлубинаСбора", 0);
	Обход.Вставить("Завершен", Ложь);
	Обход.Вставить("Отклонен", Ложь);
	Обход.Вставить("Наборы", Новый Массив);

	Попытка

		Чтение = Вычислить("Новый ЧтениеJSON");
		ТипыJSON = Новый Структура;
		ТипыJSON.Вставить("ИмяСвойства", Вычислить("ТипЗначенияJSON.ИмяСвойства"));
		ТипыJSON.Вставить("НачалоОбъекта", Вычислить("ТипЗначенияJSON.НачалоОбъекта"));
		ТипыJSON.Вставить("КонецОбъекта", Вычислить("ТипЗначенияJSON.КонецОбъекта"));
		ТипыJSON.Вставить("НачалоМассива", Вычислить("ТипЗначенияJSON.НачалоМассива"));
		ТипыJSON.Вставить("КонецМассива", Вычислить("ТипЗначенияJSON.КонецМассива"));
		ТипыJSON.Вставить("Комментарий", Вычислить("ТипЗначенияJSON.Комментарий"));
		Чтение.УстановитьСтроку(ТекстJSON);

		Пока Чтение.Прочитать() Цикл

			Если Обход.Завершен Тогда

				Возврат Неопределено;

			КонецЕсли;

			ОбработатьТокенСыройJSON(Обход, ТипыJSON, Чтение.ТипТекущегоЗначения, Чтение);

		КонецЦикла;

		Чтение.Закрыть();

	Исключение

		Возврат Неопределено;

	КонецПопытки;

	Возврат ?(Обход.Завершен, Обход, Неопределено);

КонецФункции

// Один токен потока JSON: имя свойства, начало и конец контейнера или значение.
//
// Параметры:
//  Обход - Структура - состояние обхода; изменяется
//  ТипыJSON - Структура - значения ТипЗначенияJSON
//  ТипТокена - Произвольный - ТипЗначенияJSON текущего токена
//  Чтение - Произвольный - ЧтениеJSON, установленный на токен
//
&НаКлиенте
Процедура ОбработатьТокенСыройJSON(Обход, ТипыJSON, ТипТокена, Чтение)

	Если ТипТокена = ТипыJSON.ИмяСвойства Тогда

		Обход.Ключ = Чтение.ТекущееЗначение;
		УчестьИмяСвойстваСыройJSON(Обход);

	ИначеЕсли ТипТокена = ТипыJSON.НачалоОбъекта Или ТипТокена = ТипыJSON.НачалоМассива Тогда

		НачатьКонтейнерСыройJSON(Обход, ТипТокена = ТипыJSON.НачалоОбъекта);

	ИначеЕсли ТипТокена = ТипыJSON.КонецОбъекта Или ТипТокена = ТипыJSON.КонецМассива Тогда

		ЗакончитьКонтейнерСыройJSON(Обход);

	Иначе

		Обход.Завершен = Обход.Путь.Количество() = 0 И ТипТокена <> ТипыJSON.Комментарий;

	КонецЕсли;

КонецПроцедуры

// Конец объекта или массива: ключ контейнера снимается с пути; закрытый собираемый объект завершает сбор.
//
// Параметры:
//  Обход - Структура - состояние обхода; изменяется
//
&НаКлиенте
Процедура ЗакончитьКонтейнерСыройJSON(Обход)

	Обход.Путь.Удалить(Обход.Путь.ВГраница());
	Обход.Виды.Удалить(Обход.Виды.ВГраница());
	Обход.Ключ = Неопределено;
	Обход.Завершен = Обход.Путь.Количество() = 0;

	Если Обход.Сбор <> Неопределено И Обход.Путь.Количество() < Обход.ГлубинаСбора Тогда

		Обход.Сбор = Неопределено;

	КонецЕсли;

КонецПроцедуры

// Имя свойства: попадает в набор собираемого объекта; ключ объекта на пути к цели, не являющийся
// идентификатором, отклоняется.
//
// Параметры:
//  Обход - Структура - состояние обхода; изменяется
//
&НаКлиенте
Процедура УчестьИмяСвойстваСыройJSON(Обход)

	Глубина = Обход.Путь.Количество();

	Если Обход.Сбор <> Неопределено И Глубина = Обход.ГлубинаСбора Тогда

		Обход.Сбор.Добавить(Обход.Ключ);

		Возврат;

	КонецЕсли;

	Если ЭтоОбъектНаПутиКЦели(Обход, Глубина) И НЕ ЭтоИдентификаторЗапроса(Обход.Ключ) Тогда

		Обход.Отклонен = Истина;

	КонецЕсли;

КонецПроцедуры

// Объект глубины Глубина лежит на пути к объекту цели (строго выше него).
//
// Параметры:
//  Обход - Структура - состояние обхода
//  Глубина - Число - число открытых контейнеров, включая сам объект
//
// Возвращаемое значение:
//  Булево - Истина, если все ключи пути к объекту совпали с началом пути цели
//
&НаКлиенте
Функция ЭтоОбъектНаПутиКЦели(Обход, Глубина)

	Если Обход.Цель = Неопределено Или Глубина > Обход.Цель.Количество() Тогда

		Возврат Ложь;

	КонецЕсли;

	Возврат ПрефиксПутиСовпадает(Обход, Глубина - 1);

КонецФункции

// Начало объекта или массива: ключ контейнера записывается в путь; объект по пути цели начинает сбор имен.
//
// Параметры:
//  Обход - Структура - состояние обхода; изменяется
//  ЭтоОбъект - Булево - Истина для объекта, Ложь для массива
//
&НаКлиенте
Процедура НачатьКонтейнерСыройJSON(Обход, ЭтоОбъект)

	КлючКонтейнера = Неопределено;

	Если Обход.Виды.Количество() > 0 Тогда

		Если Обход.Виды[Обход.Виды.ВГраница()] Тогда

			КлючКонтейнера = Обход.Ключ;

		КонецЕсли;

	КонецЕсли;

	Обход.Путь.Добавить(КлючКонтейнера);
	Обход.Виды.Добавить(ЭтоОбъект);
	Обход.Ключ = Неопределено;
	Глубина = Обход.Путь.Количество();

	Если ЭтоОбъект И Обход.Сбор = Неопределено И ЭтоОбъектЦели(Обход, Глубина) Тогда

		Обход.Сбор = Новый Массив;
		Обход.ГлубинаСбора = Глубина;
		Обход.Наборы.Добавить(Обход.Сбор);

	КонецЕсли;

КонецПроцедуры

// Объект глубины Глубина - объект цели, чьи имена свойств собираются.
//
// Параметры:
//  Обход - Структура - состояние обхода
//  Глубина - Число - число открытых контейнеров, включая сам объект
//
// Возвращаемое значение:
//  Булево - Истина, если путь объекта совпал с путем цели
//
&НаКлиенте
Функция ЭтоОбъектЦели(Обход, Глубина)

	Если Обход.Цель = Неопределено Или Глубина <> Обход.Цель.Количество() + 1 Тогда

		Возврат Ложь;

	КонецЕсли;

	Возврат ПрефиксПутиСовпадает(Обход, Глубина - 1);

КонецФункции

// Совпадение первых ключей пути обхода с путем цели без учета регистра (Структура ищет свойства без учета
// регистра). Первый элемент пути - корень, у него нет ключа.
//
// Параметры:
//  Обход - Структура - состояние обхода
//  Длина - Число - сколько ключей сравнивать
//
// Возвращаемое значение:
//  Булево - Истина, если все ключи совпали
//
&НаКлиенте
Функция ПрефиксПутиСовпадает(Обход, Длина)

	Для Индекс = 0 По Длина - 1 Цикл

		КлючПути = Обход.Путь[Индекс + 1];

		Если ТипЗнч(КлючПути) <> Тип("Строка") Или ВРег(КлючПути) <> ВРег(Обход.Цель[Индекс]) Тогда

			Возврат Ложь;

		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Сырые имена свойств одного объекта параметров запроса. Повтор точно такого же имени тоже запрещен:
// какое из значений победит, решал бы порядок чтения. Остальные правила - общие (ЕстьЗапрещенноеИмяПараметраЗапроса).
//
// Параметры:
//  Имена - Массив - имена свойств в порядке чтения
//
// Возвращаемое значение:
//  Булево - Истина, если набор имен недопустим
//
&НаКлиенте
Функция ЕстьЗапрещенныйНаборСырыхИмен(Имена)

	Набор = Новый Соответствие;

	Для Каждого Имя Из Имена Цикл

		Если Набор.Получить(Имя) <> Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

		Набор.Вставить(Имя, Истина);

	КонецЦикла;

	Возврат ЕстьЗапрещенноеИмяПараметраЗапроса(Набор);

КонецФункции

// Код ошибки канонического вызова: ошибка разрешения имени или, если ее нет, внутренний ключ в аргументах.
// Найденный код сохраняется в Вызов.Ошибка.
//
// Параметры:
//  Вызов - Структура - результат РазрешитьКаноническийВызов
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция КодОшибкиВызова(Вызов)

	Если ПустаяСтрока(Вызов.Ошибка) Тогда

		Вызов.Ошибка = ПроверитьВнутренниеПоляКлиента(Вызов.Аргументы);

	КонецЕсли;

	Возврат Вызов.Ошибка;

КонецФункции

// Имя инструмента из пути REST: хвост после "/api/" дословно, без обрезки пробелов и смены регистра.
//
// Параметры:
//  Путь - Строка - путь HTTP-запроса
//
// Возвращаемое значение:
//  Строка, Неопределено - хвост пути; Неопределено, если путь не начинается с "/api/"
//
&НаКлиенте
Функция ИмяИнструментаИзПутиREST(Путь)

	Если Лев(Путь, 5) <> "/api/" Тогда

		Возврат Неопределено;

	КонецЕсли;

	Возврат Сред(Путь, 6);

КонецФункции

// Внутренние поля формы (mcp_cache_*, _cmd_*, _original_*, mcp_bound_values) от клиента не принимаются.
// Проверяются ключи верхнего уровня аргументов: форма сама добавляет эти поля после границы.
// Зарезервированные имена привязанных токенов (МСПТокен...) проверяются в параметрах запроса (execute_query.params).
//
// Параметры:
//  Аргументы - Структура - аргументы вызова, как их прислал клиент
//
// Возвращаемое значение:
//  Строка - E_PARAM_INTERNAL, если найден внутренний ключ; пустая строка в противном случае
//
&НаКлиенте
Функция ПроверитьВнутренниеПоляКлиента(Аргументы)

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Для Каждого Элемент Из Аргументы Цикл

		ИмяВРег = ВРег(Элемент.Ключ);

		Если Лев(ИмяВРег, 4) = "MCP_" Или Лев(ИмяВРег, 1) = "_" Тогда

			Возврат "E_PARAM_INTERNAL";

		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Каркас прохода вызова строгого режима. Применяет контракт параметров (ПрименитьКонтрактПараметров), проверку
// аргументов инструмента и статический вердикт встроенных поисков. execute_query и execute_code до выполнения
// проходят проверку компонентой (ПроверитьВызовСтрогогоРежима), остальные инструменты уходят на выполнение сразу.
// Встроенный поиск, требующий подтверждения, уходит в шлюз (ОткрытьШлюзСтрогогоРежима); снимок экрана
// идет в шлюз при каждом вызове (ПровестиВызовСнимкаЭкранаСтрогогоРежима). Аргументы клиента до контракта
// сохраняются в Вызов.ИсходныеАргументы: шлюз показывает их с токенами, а не с реальными значениями.
// Унаследованная деанонимизация параметров здесь не используется.
//
// Параметры:
//  Вызов - Структура - результат РазрешитьКаноническийВызов без ошибки (Имя, Аргументы, Транспорт, Эпоха)
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ПровестиВызовСтрогогоРежима(Вызов, Доставка)

	Вызов.Вставить("ИсходныеАргументы", Вызов.Аргументы);
	Вызов.Вставить("Поступил", ТекущаяДата());
	КодОшибки = ПрименитьКонтрактПараметров(Вызов);

	Если НЕ ПустаяСтрока(КодОшибки) Тогда

		Возврат ОтветОшибкиСтрогогоДоставки(КодОшибки, Вызов.ПараметрОшибки, Доставка);

	КонецЕсли;

	ИмяИнструмента = Вызов.Имя;
	Аргументы = Вызов.Аргументы;

	Если ПроверитьИНормализоватьАргументыИнструмента(ИмяИнструмента, Аргументы) <> Неопределено Тогда

		Возврат ОтветОшибкиСтрогогоДоставки("E_PARAM_FORMAT", "", Доставка);

	КонецЕсли;

	Вердикт = ВердиктВстроенныхПоисковСтрогогоРежима(Вызов);

	Если Вердикт.Решение <> "auto" Тогда

		ОткрытьШлюзСтрогогоРежима(Вызов, ПроверкаПоискаДляШлюза(Вердикт), Доставка);

		Возврат Неопределено;

	КонецЕсли;

	Возврат НаправитьВызовСтрогогоРежима(Вызов, Доставка);

КонецФункции

// Направление вызова, прошедшего контракт параметров и статический вердикт поисков: снимок экрана - в шлюз при
// каждом вызове (изображение не маскируется), execute_query и execute_code - на проверку компонентой, остальные
// инструменты - на выполнение.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция НаправитьВызовСтрогогоРежима(Вызов, Доставка)

	Если Вызов.Имя = "get_screenshot" Тогда

		Возврат ПровестиВызовСнимкаЭкранаСтрогогоРежима(Вызов, Доставка);

	КонецЕсли;

	Если Вызов.Имя = "execute_query" Или Вызов.Имя = "execute_code" Тогда

		Возврат ПроверитьВызовСтрогогоРежима(Вызов, Доставка);

	КонецЕсли;

	Возврат ВыполнитьВызовСтрогогоРежима(Вызов, Доставка, Неопределено);

КонецФункции

// Ответ строгого режима по результату инструмента: подтвержденный снимок экрана - ОтветСнимкаЭкранаСтрогий
// (изображение не маскируется, вызов прошел шлюз), остальное - маскирование ЗамаскироватьРезультатСтрогий.
//
// Параметры:
//  Результат - Произвольный - результат выполнения инструмента
//  Вызов - Структура - вызов строгого режима
//  Проверка - Структура, Неопределено - результат проверки компонентой
//
// Возвращаемое значение:
//  Структура - ответ строгого режима
//
&НаКлиенте
Функция ОтветСтрогийПоРезультату(Результат, Вызов, Проверка)

	Если ЭтоУспешныйСнимокЭкрана(Результат, Вызов.Имя) Тогда

		Возврат ОтветСнимкаЭкранаСтрогий(Результат);

	КонецЕсли;

	Возврат ЗамаскироватьРезультатСтрогий(Результат, Вызов.Имя, Проверка, ПолеРезультатаПроверки(Вызов, "Происхождение"));

КонецФункции

// Признак успешного результата get_screenshot с изображением.
//
// Параметры:
//  Результат - Произвольный - результат выполнения инструмента
//  ИмяИнструмента - Строка - имя инструмента вызова
//
// Возвращаемое значение:
//  Булево - Истина, если это успешный снимок экрана с непустым изображением
//
&НаКлиенте
Функция ЭтоУспешныйСнимокЭкрана(Результат, ИмяИнструмента)

	Возврат ИмяИнструмента = "get_screenshot" И ПолеРезультатаПроверки(Результат, "success") = Истина
		И ТипЗнч(ПолеРезультатаПроверки(Результат, "image_base64")) = Тип("Строка")
		И НЕ ПустаяСтрока(ПолеРезультатаПроверки(Результат, "image_base64"));

КонецФункции

// Ответ строгого режима для подтвержденного снимка экрана: изображение и числовые поля геометрии. Текстовые поля
// компоненты захвата (слои поверх формы, отказы слоев, окно в фокусе) не передаются: в них могут быть названия окон
// и элементов, а передается только то, что человек видел в шлюзе, - изображение.
//
// Параметры:
//  Результат - Структура - успешный результат get_screenshot с image_base64
//
// Возвращаемое значение:
//  Структура - success, image_base64, mime_type и, если есть, window_rect, grid_coords, capture_complete
//
&НаКлиенте
Функция ОтветСнимкаЭкранаСтрогий(Результат)

	Ответ = Новый Структура("success, image_base64, mime_type", Истина, Результат.image_base64, "image/png");

	Поля = Новый Массив;
	Поля.Добавить("window_rect");
	Поля.Добавить("grid_coords");
	Поля.Добавить("capture_complete");

	Для Каждого Имя Из Поля Цикл

		Значение = ПолеРезультатаПроверки(Результат, Имя);

		Если Значение <> Неопределено Тогда

			Ответ.Вставить(Имя, Значение);

		КонецЕсли;

	КонецЦикла;

	Возврат Ответ;

КонецФункции

// Ответ транспорта с ошибкой строгого режима в формате режима доставки.
//
// Параметры:
//  Код - Строка - публичный код ошибки (E_...)
//  ИмяПараметра - Строка - имя параметра, к которому относится ошибка; пусто, если ошибка не про параметр
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
// Возвращаемое значение:
//  Структура - ответ транспорта: для rest КодОтвета и Тело, для mcp результат tools/call
//
&НаКлиенте
Функция ОтветОшибкиСтрогогоДоставки(Код, ИмяПараметра, Доставка)

	Ошибка = ОшибкаСтрогогоРежима(Код, ИмяПараметра);

	Возврат ?(Доставка.Режим = "rest", ОтветОшибкиСтрогогоREST(Ошибка), ОтветОшибкиСтрогогоMCP(Ошибка));

КонецФункции

// Вызов get_screenshot в строгом режиме: изображение нельзя замаскировать, поэтому каждый вызов ждет решения
// человека в шлюзе. Селекторы цели до шлюза проверяются (ПараметрСнимкаЭкранаСОшибкой): ошибка - E_PARAM_FORMAT
// с именем параметра, захват и форма шлюза не запускаются. До подтверждения форма захвата не открывается
// и навигации по ссылке нет.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта при отказе до шлюза; Неопределено, если вызов ушел в шлюз
//
&НаКлиенте
Функция ПровестиВызовСнимкаЭкранаСтрогогоРежима(Вызов, Доставка)

	ПараметрОшибки = ПараметрСнимкаЭкранаСОшибкой(Вызов.Аргументы);

	Если НЕ ПустаяСтрока(ПараметрОшибки) Тогда

		Возврат ОтветОшибкиСтрогогоДоставки("E_PARAM_FORMAT", ПараметрОшибки, Доставка);

	КонецЕсли;

	Проверка = Новый Структура("verdict, reasons, columns, missing_tables, canonical, Риски",
		"confirm", Новый Массив, Новый Массив, Новый Массив, "", Новый Массив);
	Проверка.Риски.Добавить("R_IMAGE");

	Если ЗначениеЗаполнено(ПолеРезультатаПроверки(Вызов.Аргументы, "link")) Тогда

		Проверка.Риски.Добавить("R_OPEN_BY_LINK");

	КонецЕсли;

	ОткрытьШлюзСтрогогоРежима(Вызов, Проверка, Доставка);

	Возврат Неопределено;

КонецФункции

// Проверка селекторов цели get_screenshot по метаданным и по виду имени. form_name - полное имя формы, которое
// находится в метаданных; page_name - простой идентификатор; link - ссылка на объект ссылочного вида, существующий
// в метаданных. Формат ссылки (e1cib/data/, ?ref=, 32 hex) уже проверен ПроверитьИНормализоватьАргументыИнструмента.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова get_screenshot
//
// Возвращаемое значение:
//  Строка - имя параметра с ошибкой (form_name, page_name, link) или пустая строка, если все в порядке
//
&НаКлиенте
Функция ПараметрСнимкаЭкранаСОшибкой(Аргументы)

	ИмяФормыСнимка = Неопределено;
	ИмяСтраницы = Неопределено;

	Если Аргументы.Свойство("form_name", ИмяФормыСнимка) И ЗначениеЗаполнено(ИмяФормыСнимка)
		И НЕ (ЭтоИмяФормыМетаданных(ИмяФормыСнимка) И ЭтоОбъектМетаданныхСПолнымИменем(ИмяФормыСнимка)) Тогда

		Возврат "form_name";

	КонецЕсли;

	Если Аргументы.Свойство("page_name", ИмяСтраницы) И ЗначениеЗаполнено(ИмяСтраницы)
		И НЕ ЭтоПростойИдентификатор(ИмяСтраницы) Тогда

		Возврат "page_name";

	КонецЕсли;

	Возврат ?(ТипСсылкиСнимкаЭкранаДопустим(Аргументы), "", "link");

КонецФункции

// Проверка, что значение - полное имя формы: <Вид>.<Имя>.Форма.<Имя формы> (Form для английского синтаксиса)
// или общая форма ОбщаяФорма.<Имя> (CommonForm).
//
// Параметры:
//  Значение - Произвольный - проверяемое значение
//
// Возвращаемое значение:
//  Булево - Истина, если имя имеет вид пути формы
//
&НаКлиенте
Функция ЭтоИмяФормыМетаданных(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда

		Возврат Ложь;

	КонецЕсли;

	Имя = НРег(Значение);

	Возврат Лев(Имя, 11) = "общаяформа." Или Лев(Имя, 11) = "commonform."
		Или Найти(Имя, ".форма.") > 0 Или Найти(Имя, ".form.") > 0;

КонецФункции

// Проверка, что значение - простой идентификатор: буквы (латиница и кириллица), цифры и подчеркивание,
// первый символ не цифра.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение
//
// Возвращаемое значение:
//  Булево - Истина, если это строка-идентификатор
//
&НаКлиенте
Функция ЭтоПростойИдентификатор(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Или Значение = "" Тогда

		Возврат Ложь;

	КонецЕсли;

	Для Номер = 1 По СтрДлина(Значение) Цикл

		Символ = Сред(Значение, Номер, 1);
		ЭтоЦифра = Найти("0123456789", Символ) > 0;
		ЭтоБуква = ВРег(Символ) <> НРег(Символ);

		Если НЕ (ЭтоБуква Или Символ = "_" Или (ЭтоЦифра И Номер > 1)) Тогда

			Возврат Ложь;

		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверка типа объекта в ссылке get_screenshot по метаданным: <Вид>.<Имя> из двух частей, вид ссылочный, объект
// найден в конфигурации. Без link проверка пройдена.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова get_screenshot
//
// Возвращаемое значение:
//  Булево - Ложь, если link задана и ее тип не ссылочный, не найден в метаданных или ссылка нечитаема
//
&НаКлиенте
Функция ТипСсылкиСнимкаЭкранаДопустим(Аргументы)

	Ссылка = Неопределено;

	Если НЕ Аргументы.Свойство("link", Ссылка) Или ТипЗнч(Ссылка) <> Тип("Строка") Или ПустаяСтрока(Ссылка) Тогда

		Возврат Истина;

	КонецЕсли;

	НачалоТипа = СтрДлина("e1cib/data/") + 1;
	ПозицияRef = Найти(Ссылка, "?ref=");

	Если ПозицияRef <= НачалоТипа Тогда

		Возврат Ложь;

	КонецЕсли;

	ТипОбъекта = Сред(Ссылка, НачалоТипа, ПозицияRef - НачалоТипа);
	ПозицияТочки = Найти(ТипОбъекта, ".");
	ВидыСсылочные = "|Справочник|Документ|ПланВидовХарактеристик|ПланСчетов|ПланВидовРасчета|ПланОбмена|БизнесПроцесс"
		+ "|Задача|Перечисление|Catalog|Document|ChartOfCharacteristicTypes|ChartOfAccounts|ChartOfCalculationTypes"
		+ "|ExchangePlan|BusinessProcess|Task|Enum|";

	Если ПозицияТочки <= 1 Или Найти(Сред(ТипОбъекта, ПозицияТочки + 1), ".") > 0
		Или Найти(ВидыСсылочные, "|" + Лев(ТипОбъекта, ПозицияТочки - 1) + "|") = 0 Тогда

		Возврат Ложь;

	КонецЕсли;

	Возврат ЭтоОбъектМетаданныхСПолнымИменем(ТипОбъекта);

КонецФункции

// Есть ли в конфигурации объект метаданных с таким полным именем.
//
// Параметры:
//  ПолноеИмя - Произвольный - полное имя, например Справочник.Контрагенты.Форма.ФормаЭлемента
//
// Возвращаемое значение:
//  Булево - Истина, если значение - строка и объект найден
//
&НаСервереБезКонтекста
Функция ЭтоОбъектМетаданныхСПолнымИменем(ПолноеИмя)

	Возврат ТипЗнч(ПолноеИмя) = Тип("Строка") И Метаданные.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено;

КонецФункции

// Выполнение вызова строгого режима: единственное место, откуда вызов уходит на выполнение (синхронно, в фоне
// или через БСП без фонового задания). После проверки компонентой выполняется только канонический текст
// (Проверка.canonical) с привязанными токенами. Исходный текст выполняется, только если человек в шлюзе подтвердил
// вызов, текст которого компонента не разобрала (Подтверждено). Обоснование клиента (justification) на выполнение
// не передается. Перед подтвержденным выполнением берется снимок состояния защиты (ЗапомнитьСнимокПодтвержденногоВызова);
// сверка идет в хвосте ответа до маскирования, а для синхронного ответа еще раз здесь, по локальному снимку.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//  Проверка - Структура, Неопределено - результат проверки (РазобратьРезультатПроверки); Неопределено для
//             инструментов, которые компонентой не проверяются
//  Подтверждено - Булево - вызов подтвержден человеком в шлюзе подтверждения
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ВыполнитьВызовСтрогогоРежима(Вызов, Доставка, Проверка, Подтверждено = Ложь)

	Если Проверка <> Неопределено Тогда

		КодОшибки = ПодставитьКаноническийТекстВызова(Вызов, Проверка, Подтверждено);

		Если НЕ ПустаяСтрока(КодОшибки) Тогда

			Возврат ОтветОшибкиСтрогогоДоставки(КодОшибки, "", Доставка);

		КонецЕсли;

	КонецЕсли;

	Если Вызов.Аргументы.Свойство("justification") Тогда

		Вызов.Аргументы.Удалить("justification");

	КонецЕсли;

	Вызов.Аргументы.Вставить("mcp_strict", Истина);
	Команда = Новый Структура("id, tool, params", Доставка.ДанныеЗапроса.id, Вызов.Имя, Вызов.Аргументы);
	Снимок = ?(Подтверждено, ЗапомнитьСнимокПодтвержденногоВызова(Доставка.ДанныеЗапроса, Вызов.Имя), Неопределено);

	Если Доставка.Режим <> "rest" Тогда

		Команда.Вставить("id", Строка(Доставка.Ид));

	КонецЕсли;

	КонтекстСтрогий = Новый Структура("Вызов, Проверка, Доставка", Вызов, Проверка, Доставка);
	Результат = ВыполнитьКомандуСтрогогоРежима(Команда, КонтекстСтрогий);

	Если Снимок <> Неопределено И Результат <> Неопределено Тогда

		СверитьСостояниеПодтвержденногоВызова(Доставка.ДанныеЗапроса, Снимок);

	КонецЕсли;

	Возврат Результат;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ХВОСТ ОТВЕТА
// ─────────────────────────────────────────────────────────────────────────────────

// Выполнение команды строгого режима: в фоне (ЗапуститьВФонеИЗарегистрировать с контекстом строгого режима) или
// синхронно с ответом через строгий хвост ЗавершитьВызовСтрогий. Унаследованные хвосты ЗавершитьToolsCall
// и ЗавершитьRESTЗапрос (lineage, точная политика, словарь, regex, подтверждение анонимизации) не используются.
// Отложенный ответ (снимок экрана, справка синтаксиса) доставляет ДоставитьРезультатКоманды по контексту Строгий.
//
// Параметры:
//  Команда - Структура - id, tool, params
//  КонтекстСтрогий - Структура - Вызов (вызов строгого режима), Проверка (результат проверки компоненты
//                    или Неопределено), Доставка (Режим, ДанныеЗапроса, Ид, ИдПотокаSSE)
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ВыполнитьКомандуСтрогогоРежима(Команда, КонтекстСтрогий)

	Вызов = КонтекстСтрогий.Вызов;
	Доставка = КонтекстСтрогий.Доставка;

	Если Вызов.Имя = "restart_1c_session" Или Вызов.Имя = "close_1c_session" Тогда

		Возврат ВыполнитьСессионныйВызовСтрогогоРежима(Вызов, Доставка);

	КонецЕсли;

	Если ВыполнятьВФоне(Вызов.Имя, Команда) Тогда

		Если ЗапуститьВФонеИЗарегистрировать(Команда, Вызов.Имя, Вызов.Аргументы, Доставка.ДанныеЗапроса,
				Доставка.Режим, Доставка.Ид, Доставка.ИдПотокаSSE, КонтекстСтрогий) Тогда

			Возврат Неопределено;

		КонецЕсли;

	КонецЕсли;

	КонтекстОтвета = НовыйКонтекстВыполненияКоманды(Доставка.Режим);
	КонтекстОтвета.ДанныеЗапроса = Доставка.ДанныеЗапроса;
	КонтекстОтвета.Ид = Доставка.Ид;
	КонтекстОтвета.ИдПотока = Доставка.ИдПотокаSSE;
	КонтекстОтвета.Вставить("Строгий", КонтекстСтрогий);

	Попытка

		Результат = ВыполнитьКомандуСУчетомКонтекста(Команда, КонтекстОтвета);

	Исключение

		СверитьСостояниеПодтвержденногоВызова(Доставка.ДанныеЗапроса);
		ДобавитьВЛог("Ошибка выполнения команды строгого режима: " + ОписаниеОшибки());

		Возврат ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Доставка);

	КонецПопытки;

	Если КонтекстОтвета.Отложено Тогда

		Возврат Неопределено;

	КонецЕсли;

	Возврат ЗавершитьВызовСтрогий(Результат, Вызов, КонтекстСтрогий.Проверка, Доставка);

КонецФункции

// Выполнение restart_1c_session и close_1c_session в строгом режиме. Ответ отправляют сами процедуры сеанса
// (отложенно, после запуска новой сессии), поэтому строгий хвост не применяется: текст ответа фиксирован и значений
// защищенных источников не содержит, текст ошибки заменяется в ОтправитьОтветПерезапуска. Карта токенов и флаги защиты
// в файлы перезапуска не пишутся. close_1c_session сюда попадает только после подтверждения в шлюзе.
//
// Параметры:
//  Вызов - Структура - вызов строгого режима (Имя - restart_1c_session или close_1c_session)
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта с ошибкой, если сеанс уже перезапускается или закрывается;
//                            иначе Неопределено: ответ уйдет отдельно
//
&НаКлиенте
Функция ВыполнитьСессионныйВызовСтрогогоРежима(Вызов, Доставка)

	Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда

		Возврат ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Доставка);

	КонецЕсли;

	ЭтоREST = Доставка.Режим = "rest";
	Ид = ?(ЭтоREST, Доставка.ДанныеЗапроса.id, Доставка.Ид);
	ИдПотока = ?(ЭтоREST, "", Доставка.ИдПотокаSSE);

	Если Вызов.Имя = "restart_1c_session" Тогда

		ВыполнитьПерезапускСессии("", Доставка.ДанныеЗапроса, Ид, ИдПотока, ЭтоREST, Ложь, Истина);

	Иначе

		ВыполнитьЗакрытиеСессии("", Доставка.ДанныеЗапроса, Ид, ИдПотока, ЭтоREST, Истина);

	КонецЕсли;

	// Процедура сеанса вернулась без исключения: ответ за ней, второй ответ по доставке не отправляется.
	// Исключение до этой строки признак не ставит, и шлюз ответит клиенту ошибкой.
	Доставка.Вставить("Отвечено", Истина);

	Возврат Неопределено;

КонецФункции

// Строгий хвост ответа. Порядок: сверка состояния защиты после подтвержденного вызова, сеть ошибок строгого
// режима (ЗакрытьОшибкуРезультатаСтрогогоРежима), маскирование по происхождению (ЗамаскироватьРезультатСтрогий),
// затем формат ответа (поля и TOON - СформироватьToolsCallРезультат, СформироватьRESTРезультат). Неуспешный ответ
// уходит целиком, с кодом и параметром ошибки. Схема, которую клиент не запрашивал (_anon_schema_forced), нужна
// маскированию для ссылочных колонок и после него из ответа удаляется. Строгий режим, выключенный до ответа,
// закрывает ответ ошибкой: результат без маскирования не отправляется.
//
// Параметры:
//  Результат - Произвольный - результат выполнения инструмента
//  Вызов - Структура - вызов строгого режима (Имя - каноническое имя инструмента)
//  Проверка - Структура, Неопределено - результат проверки компоненты (РазобратьРезультатПроверки)
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE; при запуске асинхронной
//             конвертации TOON сюда добавляется Отвечено
//  КонтекстДоставки - Структура, Неопределено - контекст отложенной команды с поколением подключения
//                     (НовыйКонтекстВыполненияКоманды): асинхронная конвертация TOON для MCP отправит ответ
//                     с проверкой поколения (ПослеJsonToToonMCP_Команды); Неопределено - без нее
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта или Неопределено, если ответ отправит асинхронная конвертация TOON
//                            (тогда в Доставка поставлен признак Отвечено)
//
&НаКлиенте
Функция ЗавершитьВызовСтрогий(Результат, Вызов, Проверка, Доставка, КонтекстДоставки = Неопределено)

	СверитьСостояниеПодтвержденногоВызова(Доставка.ДанныеЗапроса);

	Если НЕ СостояниеЗащиты.Строгий Тогда

		ДобавитьВЛог("Строгий режим выключен до ответа: результат вызова не отправлен");

		Возврат ОтветОшибкиСтрогогоДоставки("E_STRICT_INACTIVE", "", Доставка);

	КонецЕсли;

	Результат = ЗакрытьОшибкуРезультатаСтрогогоРежима(Результат, Вызов.Имя);
	ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	СхемаПринудительно = (ПолеРезультатаПроверки(Результат, "_anon_schema_forced") = Истина);
	Ответ = ОтветСтрогийПоРезультату(Результат, Вызов, Проверка);

	Если Ответ.success <> Истина Тогда

		Возврат ?(Доставка.Режим = "rest", ОтветОшибкиСтрогогоREST(Ответ), ОтветОшибкиСтрогогоMCP(Ответ));

	КонецЕсли;

	Если СхемаПринудительно И Ответ.Свойство("schema") Тогда

		Ответ.Удалить("schema");

	КонецЕсли;

	Если Доставка.Режим = "rest" Тогда

		ОтветТранспорта = СформироватьRESTРезультат(Ответ, Доставка.ДанныеЗапроса);

	Иначе

		ОтветТранспорта = СформироватьToolsCallРезультат(Ответ, Доставка.ДанныеЗапроса, Доставка.Ид,
			Доставка.ИдПотокаSSE, КонтекстДоставки);

	КонецЕсли;

	Если ОтветТранспорта = Неопределено Тогда

		// Конвертация TOON запущена и отправит ответ сама: второй ответ по доставке не отправляется.
		Доставка.Вставить("Отвечено", Истина);

	КонецЕсли;

	Возврат ОтветТранспорта;

КонецФункции

// Строгий хвост и отправка ответа для результатов, готовых не сразу: фоновое задание (ДоставитьРезультатЗадания)
// и отложенная команда (ДоставитьРезультатКоманды). Неопределено от хвоста - ответ отправит конвертация TOON.
// Ответ MCP отложенной команды по streamable HTTP уходит с проверкой поколения подключения (ОтправитьSSEОтветКоманды),
// как в унаследованном отложенном пути: после переподключения ответ в новый поток не попадает.
//
// Параметры:
//  Результат - Произвольный - результат выполнения инструмента
//  КонтекстСтрогий - Структура - Вызов, Проверка, Доставка (см. ВыполнитьКомандуСтрогогоРежима)
//  КонтекстДоставки - Структура, Неопределено - контекст отложенной команды с поколением подключения;
//                     Неопределено для фонового задания
//
&НаКлиенте
Процедура ДоставитьРезультатСтрогий(Результат, КонтекстСтрогий, КонтекстДоставки = Неопределено)

	Доставка = КонтекстСтрогий.Доставка;
	Ответ = ЗавершитьВызовСтрогий(Результат, КонтекстСтрогий.Вызов, КонтекстСтрогий.Проверка, Доставка, КонтекстДоставки);

	Если Ответ = Неопределено Тогда

		Возврат;

	КонецЕсли;

	Если КонтекстДоставки <> Неопределено И Доставка.Режим <> "rest" И НЕ ЗначениеЗаполнено(Доставка.ИдПотокаSSE) Тогда

		Доставка.Вставить("Отвечено", Истина);
		ОтправитьSSEОтветКоманды(Доставка.ДанныеЗапроса, СформироватьJSONRPCОтвет(Доставка.Ид, Ответ), КонтекстДоставки);

	Иначе

		ОтправитьОтветСтрогогоРежима(Ответ, Доставка);

	КонецЕсли;

КонецПроцедуры

// Старое (эвристическое) маскирование: режим «Маскирование». В строгом режиме вывод маскирует
// ЗамаскироватьРезультатСтрогий, а старые ветки маскирования не выполняются.
//
// Возвращаемое значение:
//  Булево - Истина, если выполняется старое маскирование вывода
//
&НаКлиенте
Функция ЛегасиМаскированиеАктивно()

	Возврат ИспользоватьТочнуюАнонимизацию И РежимПодключения <> 0 И НЕ СостояниеЗащиты.Строгий;

КонецФункции

// Подставляет в аргументы вызова канонический текст проверки и привязывает токены текста (ПривязатьТокеныЗапроса).
// Без канонического текста вызов выполняется, только если его подтвердил человек: тогда выполняется исходный текст,
// токены в нем остаются обычным текстом и значения не привязываются (так их и показывает шлюз).
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров; Аргументы изменяются
//  Проверка - Структура - результат проверки (РазобратьРезультатПроверки)
//  Подтверждено - Булево - вызов подтвержден человеком в шлюзе подтверждения
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция ПодставитьКаноническийТекстВызова(Вызов, Проверка, Подтверждено)

	Если ПустаяСтрока(Проверка.canonical) Тогда

		Возврат ?(Подтверждено, "", "E_GATE_REJECTED");

	КонецЕсли;

	Вызов.Аргументы.Вставить(?(Вызов.Имя = "execute_code", "code", "query"), Проверка.canonical);

	Возврат ПривязатьТокеныЗапроса(Вызов, Вызов.Токены);

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ШЛЮЗ ПОДТВЕРЖДЕНИЯ
// ─────────────────────────────────────────────────────────────────────────────────

// Ставит вызов, требующий подтверждения, в очередь шлюза и показывает форму, если другая форма шлюза не открыта.
// До решения человека ничего не выполняется; ответ клиенту уходит позже через ОтправитьОтветСтрогогоРежима.
// Пока очередь не пуста, ИстечьОжиданияОчередиШлюза отвечает E_GATE_TIMEOUT вызовам, чье время вышло в очереди.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров (Имя, Аргументы, ИсходныеАргументы, Токены, Эпоха)
//  Проверка - Структура - проверка (РазобратьРезультатПроверки или ПроверкаПоискаДляШлюза)
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
&НаКлиенте
Процедура ОткрытьШлюзСтрогогоРежима(Вызов, Проверка, Доставка)

	СчетчикШлюза = СчетчикШлюза + 1;
	ОжидающиеШлюза.Вставить(СчетчикШлюза, Новый Структура("Вызов, Проверка, Доставка", Вызов, Проверка, Доставка));
	ОчередьШлюза.Добавить(СчетчикШлюза);

	Если ОчередьШлюза.Количество() = 1 Тогда

		ПодключитьОбработчикОжидания("ИстечьОжиданияОчередиШлюза", 1, Ложь);

	КонецЕсли;

	ДобавитьВЛог("Строгий режим: вызов " + Вызов.Имя + " ждет подтверждения: " + КодыПричинПроверки(Проверка));
	ПоказатьСледующийШлюз();

КонецПроцедуры

// Показывает форму шлюза для первого вызова очереди, если форма шлюза не открыта (одна форма за раз).
// Время ожидания отсчитывается от поступления запроса: вызов, чье время истекло в очереди, получает
// E_GATE_TIMEOUT без формы. Ключ, которого уже нет в ОжидающиеШлюза (сменилась эпоха защиты), пропускается.
//
&НаКлиенте
Процедура ПоказатьСледующийШлюз()

	Пока КлючОткрытогоШлюза = 0 И ОчередьШлюза.Количество() > 0 Цикл

		КлючШлюза = ОчередьШлюза[0];
		ОчередьШлюза.Удалить(0);
		Ожидание = ОжидающиеШлюза.Получить(КлючШлюза);

		Если Ожидание = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		Осталось = ОсталосьСекундШлюза(Ожидание);

		Если Осталось <= 0 Тогда

			ПрименитьРешениеШлюза(КлючШлюза, "timeout");

		Иначе

			ОткрытьФормуШлюза(КлючШлюза, Ожидание, Осталось);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Обработчик ожидания очереди шлюза: вызовам очереди, чье время ожидания истекло, отвечает E_GATE_TIMEOUT
// сразу, не дожидаясь закрытия открытой формы шлюза. Отключается, когда очередь пуста.
//
&НаКлиенте
Процедура ИстечьОжиданияОчередиШлюза() Экспорт

	Индекс = ОчередьШлюза.ВГраница();

	Пока Индекс >= 0 Цикл

		КлючШлюза = ОчередьШлюза[Индекс];
		Ожидание = ОжидающиеШлюза.Получить(КлючШлюза);

		Если Ожидание = Неопределено Тогда

			ОчередьШлюза.Удалить(Индекс);

		ИначеЕсли ОсталосьСекундШлюза(Ожидание) <= 0 Тогда

			ОчередьШлюза.Удалить(Индекс);
			ПрименитьРешениеШлюза(КлючШлюза, "timeout");

		Иначе

			// Время вызова еще не вышло: он ждет своей формы.

		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

	Если ОчередьШлюза.Количество() = 0 Тогда

		ОтключитьОбработчикОжидания("ИстечьОжиданияОчередиШлюза");

	КонецЕсли;

КонецПроцедуры

// Обработчик изменения настройки "Время ожидания подтверждения": неположительное значение - 300 секунд.
// Значение задает человек в форме и сохраняется в хранилище настроек, как таймаут запроса.
//
// Параметры:
//  Элемент - ПолеФормы - поле ТаймаутШлюзаСек
//
&НаКлиенте
Процедура ПолеТаймаутШлюзаПриИзменении(Элемент)

	Если ТаймаутШлюзаСек <= 0 Тогда

		ТаймаутШлюзаСек = 300;

	КонецЕсли;

	СохранитьТаймаутШлюзаНаСервере(ТаймаутШлюзаСек);

КонецПроцедуры

// Сохраняет время ожидания подтверждения в шлюзе.
//
// Параметры:
//  Значение - Число - секунд
//
&НаСервереБезКонтекста
Процедура СохранитьТаймаутШлюзаНаСервере(Знач Значение)

	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ТаймаутШлюзаСек", Значение);

КонецПроцедуры

// Сохраненное время ожидания подтверждения в шлюзе; без сохраненного положительного значения - 300 секунд.
//
// Возвращаемое значение:
//  Число - секунд
//
&НаСервереБезКонтекста
Функция СохраненныйТаймаутШлюзаНаСервере()

	Значение = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ТаймаутШлюзаСек");

	Возврат ?(ТипЗнч(Значение) = Тип("Число") И Значение > 0, Значение, 300);

КонецФункции

// Оставшееся время ожидания решения по вызову шлюза, от поступления запроса.
//
// Параметры:
//  Ожидание - Структура - Вызов, Проверка, Доставка
//
// Возвращаемое значение:
//  Число - секунд; ноль или меньше - время вышло
//
&НаКлиенте
Функция ОсталосьСекундШлюза(Ожидание)

	Возврат ТаймаутШлюзаСекунд() - (ТекущаяДата() - Ожидание.Вызов.Поступил);

КонецФункции

// Открывает форму строгого подтверждения для вызова очереди. Если форма не открылась, вызов отклоняется
// (E_GATE_REJECTED) и очередь идет дальше.
//
// Параметры:
//  КлючШлюза - Число - ключ ОжидающиеШлюза
//  Ожидание - Структура - Вызов, Проверка, Доставка
//  ТаймаутСек - Число - оставшееся время ожидания решения, секунд
//
&НаКлиенте
Процедура ОткрытьФормуШлюза(КлючШлюза, Ожидание, ТаймаутСек)

	ПараметрыФормы = ПредставлениеПроверкиДляШлюза(Ожидание.Вызов, Ожидание.Проверка);
	ПараметрыФормы.Вставить("ТаймаутСек", ТаймаутСек);
	ПараметрыФормы.Вставить("Режим", "gate");
	Оповещение = Новый ОписаниеОповещения("ПослеРешенияШлюза", ЭтаФорма, КлючШлюза);
	КлючОткрытогоШлюза = КлючШлюза;

	Попытка

		ОткрытьФорму("ВнешняяОбработка.MCPToolkit.Форма.ФормаСтрогогоПодтверждения", ПараметрыФормы, ЭтаФорма,
			Строка(КлючШлюза), , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

	Исключение

		ДобавитьВЛог("Строгий режим: форма шлюза не открыта: " + ОписаниеОшибки());
		КлючОткрытогоШлюза = 0;
		ПрименитьРешениеШлюза(КлючШлюза, "rejected");

	КонецПопытки;

КонецПроцедуры

// Обработчик закрытия формы шлюза. Закрытие формы любым другим способом (Неопределено) - отклонение.
// Сбой обработки решения отвечает клиенту ошибкой (ОтветСбояРешенияШлюза). После решения показывается следующий
// вызов очереди, даже если решение отброшено.
//
// Параметры:
//  Решение - Строка, Неопределено - approved, rejected, timeout или Неопределено
//  КлючШлюза - Число - ключ ОжидающиеШлюза
//
&НаКлиенте
Процедура ПослеРешенияШлюза(Решение, КлючШлюза) Экспорт

	Если КлючОткрытогоШлюза = КлючШлюза Тогда

		КлючОткрытогоШлюза = 0;

	КонецЕсли;

	КодРешения = ?(Решение = "approved" Или Решение = "timeout", Решение, "rejected");
	Ожидание = ОжидающиеШлюза.Получить(КлючШлюза);

	Попытка

		ПрименитьРешениеШлюза(КлючШлюза, КодРешения);

	Исключение

		ДобавитьВЛог("Строгий режим: сбой обработки решения шлюза: " + ОписаниеОшибки());

		Если Ожидание <> Неопределено Тогда

			ОтправитьОтветШлюза(ОтветСбояРешенияШлюза(Ожидание), Ожидание.Доставка);

		КонецЕсли;

	КонецПопытки;

	ПоказатьСледующийШлюз();

КонецПроцедуры

// Ответ клиенту после сбоя обработки решения шлюза, с проверками ПрименитьРешениеШлюза: запрос прошлой эпохи
// защиты получает E_EPOCH_CHANGED, остальные - E_EXECUTION. Запрос, на который ответ уже дан (ОтветДоставкиДан),
// который транспорт уже закрыл по таймауту или ответ на который даст фоновое задание, ответа здесь не получает.
//
// Параметры:
//  Ожидание - Структура - Вызов, Проверка, Доставка
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта; Неопределено, если отвечать здесь не нужно
//
&НаКлиенте
Функция ОтветСбояРешенияШлюза(Ожидание)

	Если ОтветДоставкиДан(Ожидание.Доставка) Или ЗапросЗакрытТранспортом(Ожидание)
		Или ОтветВызоваДастФоновоеЗадание(Ожидание.Доставка) Тогда

		Возврат Неопределено;

	ИначеЕсли Ожидание.Вызов.Эпоха <> ЭпохаЗащиты Или ЗапросУстарелПоЭпохе(Ожидание.Доставка.ДанныеЗапроса) Тогда

		Возврат ОтветОшибкиСтрогогоДоставки("E_EPOCH_CHANGED", "", Ожидание.Доставка);

	Иначе

		Возврат ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Ожидание.Доставка);

	КонецЕсли;

КонецФункции

// Признак того, что вызов строгого режима уже передан фоновому заданию (ЗапуститьВФонеИЗарегистрировать):
// ответ клиенту даст доставка результата задания.
//
// Параметры:
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
// Возвращаемое значение:
//  Булево - Истина, если задание по запросу зарегистрировано в АктивныеЗадания
//
&НаКлиенте
Функция ОтветВызоваДастФоновоеЗадание(Доставка)

	Возврат АктивныеЗадания <> Неопределено И АктивныеЗадания.Получить(Доставка.ДанныеЗапроса.id) <> Неопределено;

КонецФункции

// Признак того, что ответ по доставке уже отправлен или передан на отправку: признак Отвечено ставят
// ОтправитьОтветСтрогогоРежима и ДоставитьРезультатСтрогий до отправки, ЗавершитьВызовСтрогий после запуска
// асинхронной конвертации TOON, ВыполнитьСессионныйВызовСтрогогоРежима после передачи ответа процедуре сеанса.
// Второй ответ на тот же запрос не отправляется.
//
// Параметры:
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE и, после ответа, Отвечено
//
// Возвращаемое значение:
//  Булево - Истина, если ответ по доставке уже дан
//
&НаКлиенте
Функция ОтветДоставкиДан(Доставка)

	Возврат Доставка.Свойство("Отвечено");

КонецФункции

// Применяет решение по вызову шлюза ровно один раз: запись в журнал шлюза, затем выполнение или ответ-ошибка.
// Решение по вызову, которого уже нет в ожидании, отбрасывается: ничего не выполняется. Вызов прошлой эпохи
// защиты получает E_EPOCH_CHANGED. Подтверждение запроса, который транспорт уже закрыл по таймауту, отбрасывается.
//
// Параметры:
//  КлючШлюза - Число - ключ ОжидающиеШлюза
//  КодРешения - Строка - approved, rejected или timeout
//
&НаКлиенте
Процедура ПрименитьРешениеШлюза(КлючШлюза, КодРешения)

	Ожидание = ОжидающиеШлюза.Получить(КлючШлюза);

	Если Ожидание = Неопределено Тогда

		ДобавитьВЛог("Строгий режим: решение шлюза по закрытому вызову отброшено, ничего не выполнено");
		Возврат;

	КонецЕсли;

	ОжидающиеШлюза.Удалить(КлючШлюза);
	Итог = КодРешения;

	Если Ожидание.Вызов.Эпоха <> ЭпохаЗащиты Или ЗапросУстарелПоЭпохе(Ожидание.Доставка.ДанныеЗапроса) Тогда

		Итог = "epoch";

	ИначеЕсли Итог = "approved" И ЗапросЗакрытТранспортом(Ожидание) Тогда

		Итог = "expired";

	Иначе

		// Решение человека применяется как есть.

	КонецЕсли;

	ЗаписатьВЖурналШлюза(Ожидание, Итог);

	Если Итог = "approved" Тогда

		ОтправитьОтветШлюза(ВыполнитьПодтвержденныйВызов(Ожидание), Ожидание.Доставка);

	ИначеЕсли Итог <> "expired" Тогда

		ОтправитьОтветШлюза(ОтветОтказаШлюза(Ожидание, Итог), Ожидание.Доставка);

	Иначе

		ДобавитьВЛог("Строгий режим: запрос закрыт транспортом до решения, подтверждение отброшено");

	КонецЕсли;

КонецПроцедуры

// Подтвержденное выполнение: отметка действия класса защиты по РискиПодтвержденияШлюза (до снимка состояния
// защиты), затем выполнение
// с признаком Подтверждено. Проверка компонентой передается только инструментам, которые она проверяет.
//
// Параметры:
//  Ожидание - Структура - Вызов, Проверка, Доставка
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ВыполнитьПодтвержденныйВызов(Ожидание)

	Вызов = Ожидание.Вызов;
	ОтметитьПодтверждениеКлассаЗащиты(Новый Структура("Риски", РискиПодтвержденияШлюза(Вызов, Ожидание.Проверка)));
	ЭтоКод = Вызов.Имя = "execute_query" Или Вызов.Имя = "execute_code";

	Возврат ВыполнитьВызовСтрогогоРежима(Вызов, Ожидание.Доставка, ?(ЭтоКод, Ожидание.Проверка, Неопределено), Истина);

КонецФункции

// Отправляет ответ шлюза через транспорт доставки. Неопределено - ответ уйдет другим путем.
//
// Параметры:
//  Ответ - Структура, Неопределено - ответ транспорта
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
&НаКлиенте
Процедура ОтправитьОтветШлюза(Ответ, Доставка)

	Если Ответ = Неопределено Тогда

		Возврат;

	ИначеЕсли Компонента = Неопределено Тогда

		ДобавитьВЛог("Строгий режим: ответ шлюза не отправлен: встроенный сервер остановлен");

	Иначе

		ОтправитьОтветСтрогогоРежима(Ответ, Доставка);

	КонецЕсли;

КонецПроцедуры

// Ответ-ошибка шлюза: код по итогу и имя параметра встроенного поиска, если вызов ушел в шлюз из-за него.
//
// Параметры:
//  Ожидание - Структура - Вызов, Проверка, Доставка
//  Итог - Строка - rejected, timeout или epoch
//
// Возвращаемое значение:
//  Структура - ответ транспорта
//
&НаКлиенте
Функция ОтветОтказаШлюза(Ожидание, Итог)

	ИмяПараметра = ?(Ожидание.Проверка.Свойство("Параметр"), Ожидание.Проверка.Параметр, "");

	Возврат ОтветОшибкиСтрогогоДоставки(КодОшибкиРешенияШлюза(Итог), ИмяПараметра, Ожидание.Доставка);

КонецФункции

// Код ошибки для клиента по итогу шлюза.
//
// Параметры:
//  Итог - Строка - rejected, timeout или epoch
//
// Возвращаемое значение:
//  Строка - E_GATE_REJECTED, E_GATE_TIMEOUT или E_EPOCH_CHANGED
//
&НаКлиенте
Функция КодОшибкиРешенияШлюза(Итог)

	Если Итог = "timeout" Тогда

		Возврат "E_GATE_TIMEOUT";

	ИначеЕсли Итог = "epoch" Тогда

		Возврат "E_EPOCH_CHANGED";

	Иначе

		Возврат "E_GATE_REJECTED";

	КонецЕсли;

КонецФункции

// Признак того, что транспорт уже закрыл запрос по таймауту (ТаймаутЗапросаСек от поступления): ответ на него
// не дойдет до клиента. Ответ в SSE-поток не ограничен таймаутом запроса.
//
// Параметры:
//  Ожидание - Структура - Вызов, Проверка, Доставка
//
// Возвращаемое значение:
//  Булево - Истина, если запрос закрыт
//
&НаКлиенте
Функция ЗапросЗакрытТранспортом(Ожидание)

	Возврат НЕ ЗначениеЗаполнено(Ожидание.Доставка.ИдПотокаSSE) И ТаймаутЗапросаСек > 0
		И ТекущаяДата() - Ожидание.Вызов.Поступил >= ТаймаутЗапросаСек;

КонецФункции

// Время ожидания решения в шлюзе: настройка ТаймаутШлюзаСек (пустое или неположительное значение - 300 секунд),
// но не дольше таймаута запроса транспорта без 10 секунд: решение по закрытому запросу клиенту уже не дойдет.
//
// Возвращаемое значение:
//  Число - секунд, не меньше 1
//
&НаКлиенте
Функция ТаймаутШлюзаСекунд()

	Таймаут = ?(ТаймаутШлюзаСек > 0, ТаймаутШлюзаСек, 300);

	Если ТаймаутЗапросаСек > 0 Тогда

		Таймаут = Макс(Мин(Таймаут, ТаймаутЗапросаСек - 10), 1);

	КонецЕсли;

	Возврат Таймаут;

КонецФункции

// Проверка для шлюза встроенного поиска (ВердиктВстроенныхПоисковСтрогогоРежима): текста для компоненты нет,
// риски - коды L_LOOKUP, Параметр - имя первого параметра поиска (возвращается клиенту при отказе).
//
// Параметры:
//  Вердикт - Структура - Решение, Риски, ПараметрОшибки
//
// Возвращаемое значение:
//  Структура - verdict, reasons, columns, missing_tables, canonical, Риски (см. РазобратьРезультатПроверки), Параметр
//
&НаКлиенте
Функция ПроверкаПоискаДляШлюза(Вердикт)

	Проверка = Новый Структура("verdict, reasons, columns, missing_tables, canonical, Риски",
		"confirm", Новый Массив, Новый Массив, Новый Массив, "", Вердикт.Риски);
	Проверка.Вставить("Параметр", Вердикт.ПараметрОшибки);

	Возврат Проверка;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ПРЕДСТАВЛЕНИЕ ВЫЗОВА В ШЛЮЗЕ
// ─────────────────────────────────────────────────────────────────────────────────

// Параметры формы шлюза. Показывается ровно то, что выполнится: канонический текст, если компонента его построила,
// иначе исходный текст (ТекстРаспознан = Ложь). Привязанные значения и параметры вызова показаны токенами, как их
// прислал клиент, а не реальными значениями. Обоснование - текст клиента, не проверяется и не деанонимизируется.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров (Имя, ИсходныеАргументы, Токены, Происхождение)
//  Проверка - Структура - проверка (РазобратьРезультатПроверки или ПроверкаПоискаДляШлюза)
//
// Возвращаемое значение:
//  Структура - Инструмент, ТекстКПодтверждению, ТекстРаспознан, Причины, Риски, КлассЗащиты, Обоснование
//
&НаКлиенте
Функция ПредставлениеПроверкиДляШлюза(Вызов, Проверка)

	ЭтоКод = Вызов.Имя = "execute_query" Или Вызов.Имя = "execute_code";
	ТекстРаспознан = НЕ ЭтоКод Или НЕ ПустаяСтрока(Проверка.canonical);
	Текст = "";
	ИсходныйТекст = "";

	Если ЭтоКод Тогда

		ИмяТекста = ?(Вызов.Имя = "execute_code", "code", "query");
		ИсходноеЗначение = ЗначениеИсходногоАргумента(Вызов, ИмяТекста);
		ИсходныйТекст = ?(ТипЗнч(ИсходноеЗначение) = Тип("Строка"), ИсходноеЗначение, "");

	КонецЕсли;

	Если ЭтоКод И ТекстРаспознан Тогда

		Текст = Проверка.canonical + Символы.ПС;

	ИначеЕсли ЭтоКод Тогда

		Текст = Строка(ИсходноеЗначение) + Символы.ПС;

	Иначе

		// Инструмент без текста запроса или кода: показываются только параметры вызова.

	КонецЕсли;

	Текст = Текст + ПривязанныеТокеныДляШлюза(Вызов, ТекстРаспознан)
		+ ?(Вызов.Имя = "get_screenshot", ПредставлениеСнимкаЭкранаДляШлюза(Вызов), ПараметрыВызоваДляШлюза(Вызов));
	Обоснование = ЗначениеИсходногоАргумента(Вызов, "justification");
	Риски = СписокКодовДляШлюза(Проверка.Риски, Вызов.Имя, ИсходныйТекст);

	Если НЕ ТекстРаспознан Тогда

		Риски = Риски + ?(ПустаяСтрока(Риски), "", Символы.ПС)
			+ "текст не проверен: подтверждение приравнено к действию класса защиты";

	ИначеЕсли ЭтоКод И ЕстьПричинаКлассаЗащиты(Проверка.reasons) Тогда

		Риски = Риски + ?(ПустаяСтрока(Риски), "", Символы.ПС)
			+ "причины проверки: подтверждение приравнено к действию класса защиты";

	Иначе

		// Текст проверен, причин класса защиты нет: к рискам проверки добавить нечего.

	КонецЕсли;

	КлассЗащиты = ЕстьРискКлассаЗащиты(РискиПодтвержденияШлюза(Вызов, Проверка));

	Возврат Новый Структура("Инструмент, ТекстКПодтверждению, ТекстРаспознан, Причины, Риски, КлассЗащиты, Обоснование",
		Вызов.Имя, Текст, ТекстРаспознан, СписокКодовДляШлюза(Проверка.reasons, "", ИсходныйТекст), Риски,
		КлассЗащиты, ?(ТипЗнч(Обоснование) = Тип("Строка"), Обоснование, ""));

КонецФункции

// Риски подтверждения вызова шлюза: риски проверки, а для execute_query / execute_code без канонического текста
// (не разобран или не проверен) еще нечитаемый элемент - отказ в сторону класса защиты: КодРискаПроверки дает
// для него пустой код, и ОтметитьПодтверждениеКлассаЗащиты считает его классом защиты. Для execute_query /
// execute_code с причиной проверки вне списка ПричинаНеПриостанавливаетГарантию добавляется R_CONFIRMED_REASONS:
// вычисление над защищенным значением и неявный поток от него имеют открытый набор каналов утечки.
// Флаг КлассЗащиты формы подтверждения считается по этому же массиву (ПредставлениеПроверкиДляШлюза).
//
// Параметры:
//  Вызов - Структура - вызов шлюза
//  Проверка - Структура - проверка (РазобратьРезультатПроверки или ПроверкаПоискаДляШлюза)
//
// Возвращаемое значение:
//  Массив - риски
//
&НаКлиенте
Функция РискиПодтвержденияШлюза(Вызов, Проверка)

	Риски = Новый Массив;

	Для Каждого Риск Из Проверка.Риски Цикл

		Риски.Добавить(Риск);

	КонецЦикла;

	Если (Вызов.Имя = "execute_query" Или Вызов.Имя = "execute_code") И ПустаяСтрока(Проверка.canonical) Тогда

		Риски.Добавить(Неопределено);

	КонецЕсли;

	Если (Вызов.Имя = "execute_query" Или Вызов.Имя = "execute_code") И ЕстьПричинаКлассаЗащиты(Проверка.reasons) Тогда

		Риски.Добавить("R_CONFIRMED_REASONS");

	КонецЕсли;

	Возврат Риски;

КонецФункции

// Значение аргумента вызова, как его прислал клиент (до контракта параметров: токены не заменены).
//
// Параметры:
//  Вызов - Структура - вызов с полем ИсходныеАргументы
//  Имя - Строка - имя аргумента
//
// Возвращаемое значение:
//  Произвольный - значение аргумента или Неопределено
//
&НаКлиенте
Функция ЗначениеИсходногоАргумента(Вызов, Имя)

	Значение = Неопределено;
	Исходные = Неопределено;

	Если Вызов.Свойство("ИсходныеАргументы", Исходные) И ТипЗнч(Исходные) = Тип("Структура") Тогда

		Исходные.Свойство(Имя, Значение);

	КонецЕсли;

	Возврат Значение;

КонецФункции

// Список привязанных токенов текста для шлюза: имя, под которым значение передается на выполнение, и сам токен.
// execute_query - параметр &МСПТокен<index+1>, execute_code - МСПЗначенияТокенов[<index>]. Исходный текст
// (не распознан) на привязанные значения не ссылается: токены в нем выполняются как обычный текст.
//
// Параметры:
//  Вызов - Структура - вызов с полями Имя и Токены (токен -> Структура(index, origin))
//  ТекстРаспознан - Булево - выполняется канонический текст
//
// Возвращаемое значение:
//  Строка - блок текста или пустая строка, если токенов нет
//
&НаКлиенте
Функция ПривязанныеТокеныДляШлюза(Вызов, ТекстРаспознан)

	Если Вызов.Токены.Количество() = 0 Тогда

		Возврат "";

	ИначеЕсли НЕ ТекстРаспознан Тогда

		Возврат Символы.ПС + "Токены в исходном тексте выполняются как обычный текст, без подстановки значений."
			+ Символы.ПС;

	КонецЕсли;

	Строки = Новый Массив(Вызов.Токены.Количество());

	Для Каждого Элемент Из Вызов.Токены Цикл

		Индекс = Элемент.Значение.index;
		Имя = ?(Вызов.Имя = "execute_code", "МСПЗначенияТокенов[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]",
			"&" + ИмяПараметраТокена(Индекс));
		Источник = ?(Элемент.Значение.origin = "protected", "защищенный источник", "происхождение неизвестно");
		Строки[Индекс] = "  " + Имя + " = " + Элемент.Ключ + " (" + Источник + ")";

	КонецЦикла;

	Возврат Символы.ПС + "Привязанные значения (показаны токены, не значения):" + Символы.ПС
		+ СоединитьМассив(Строки, Символы.ПС) + Символы.ПС;

КонецФункции

// Параметры вызова для шлюза, кроме текста запроса или кода и обоснования: значения в том виде, в каком их
// прислал клиент (с токенами), и происхождение параметра, если контракт его определил.
//
// Параметры:
//  Вызов - Структура - вызов с полями ИсходныеАргументы и Происхождение
//
// Возвращаемое значение:
//  Строка - блок текста или пустая строка, если таких параметров нет
//
&НаКлиенте
Функция ПараметрыВызоваДляШлюза(Вызов)

	Исходные = Неопределено;
	Текст = "";

	Если НЕ Вызов.Свойство("ИсходныеАргументы", Исходные) Или ТипЗнч(Исходные) <> Тип("Структура") Тогда

		Возврат Текст;

	КонецЕсли;

	Для Каждого Элемент Из Исходные Цикл

		Если Элемент.Ключ = "query" Или Элемент.Ключ = "code" Или Элемент.Ключ = "justification" Тогда

			Продолжить;

		КонецЕсли;

		Значение = ?(ТипЗнч(Элемент.Значение) = Тип("Строка"), Элемент.Значение, ЗаписатьJSON2(Элемент.Значение));
		Текст = Текст + "  " + Элемент.Ключ + " = " + Значение
			+ ПредставлениеПроисхожденияДляШлюза(Вызов.Происхождение.Получить(Элемент.Ключ)) + Символы.ПС;

	КонецЦикла;

	Возврат ?(ПустаяСтрока(Текст), "", Символы.ПС + "Параметры вызова:" + Символы.ПС + Текст);

КонецФункции

// Параметры get_screenshot для шлюза открытым текстом: цель (текущее окно, форма или ссылка на объект), страница,
// область, масштаб, сетка, число выделений. Показываются нормализованные значения Вызов.Аргументы, которые будут
// использованы при захвате, а не исходные. Значения клиента показываются одной строкой, не длиннее 200 символов.
// Предупреждение об изображении и метка открытия формы по ссылке выводятся списком рисков (R_IMAGE, R_OPEN_BY_LINK).
//
// Параметры:
//  Вызов - Структура - вызов с полем Аргументы (после нормализации)
//
// Возвращаемое значение:
//  Строка - блок текста
//
&НаКлиенте
Функция ПредставлениеСнимкаЭкранаДляШлюза(Вызов)

	Форма = ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Вызов.Аргументы, "form_name"));
	Ссылка = ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Вызов.Аргументы, "link"));
	Страница = ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Вызов.Аргументы, "page_name"));
	Область = ПолеРезультатаПроверки(Вызов.Аргументы, "region");
	Выделения = ПолеРезультатаПроверки(Вызов.Аргументы, "highlight_rects");
	МасштабСнимка = ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Вызов.Аргументы, "scale_percent"));

	Цель = ?(Ссылка <> "", "ссылка на объект: " + Ссылка, ?(Форма <> "", "форма: " + Форма, "текущее окно"));
	Регион = "все окно";

	Если ТипЗнч(Область) = Тип("Структура") Или ТипЗнч(Область) = Тип("Соответствие") Тогда

		Регион = "x=" + ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Область, "x"))
			+ " y=" + ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Область, "y"))
			+ " ширина=" + ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Область, "width"))
			+ " высота=" + ТекстЗначенияСнимкаДляШлюза(ПолеРезультатаПроверки(Область, "height"));

	КонецЕсли;

	Возврат Символы.ПС + "Снимок экрана:" + Символы.ПС + "  цель: " + Цель + Символы.ПС
		+ ?(Страница = "", "", "  страница: " + Страница + Символы.ПС)
		+ "  область: " + Регион + Символы.ПС
		+ "  масштаб: " + ?(МасштабСнимка = "", "100", МасштабСнимка) + "%" + Символы.ПС
		+ "  сетка: " + ?(ПолеРезультатаПроверки(Вызов.Аргументы, "show_grid") = Истина, "да", "нет") + Символы.ПС
		+ "  выделений: " + ?(ТипЗнч(Выделения) = Тип("Массив"), Формат(Выделения.Количество(), "ЧН=0; ЧГ="), "0")
		+ Символы.ПС;

КонецФункции

// Значение параметра get_screenshot для показа в шлюзе: одна строка, не длиннее 200 символов. Управляющие и
// форматирующие символы (переводы строк и страницы, табуляция, U+2028/2029, управление направлением текста)
// заменяются пробелом: значение прислал клиент, оно не должно подменять строки шлюза.
//
// Параметры:
//  Значение - Произвольный - значение параметра или Неопределено
//
// Возвращаемое значение:
//  Строка - текст для показа; пустая строка для Неопределено
//
&НаКлиенте
Функция ТекстЗначенияСнимкаДляШлюза(Значение)

	Если Значение = Неопределено Тогда

		Возврат "";

	КонецЕсли;

	Текст = Лев(Строка(Значение), 200);
	Результат = Новый Массив;

	Для Номер = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Номер, 1);
		Код = КодСимвола(Символ);
		Служебный = Код < 32 Или (Код >= 127 И Код <= 159) Или Код = 173 Или (Код >= 8232 И Код <= 8238)
			Или (Код >= 8294 И Код <= 8297);
		Результат.Добавить(?(Служебный, " ", Символ));

	КонецЦикла;

	Возврат СоединитьМассив(Результат, "");

КонецФункции

// Пояснение к происхождению параметра для шлюза.
//
// Параметры:
//  Происхождение - Строка, Неопределено - client, token_protected, token_unknown
//
// Возвращаемое значение:
//  Строка - пояснение в скобках или пустая строка
//
&НаКлиенте
Функция ПредставлениеПроисхожденияДляШлюза(Происхождение)

	Если Происхождение = "client" Тогда

		Возврат " (значение клиента)";

	ИначеЕсли Происхождение = "token_protected" Тогда

		Возврат " (токен защищенного источника)";

	ИначеЕсли Происхождение = "token_unknown" Тогда

		Возврат " (токен неизвестного происхождения)";

	Иначе

		Возврат "";

	КонецЕсли;

КонецФункции

// Список причин или рисков для шлюза: по строке на код, "<код> (строка N): <пояснение> - «фрагмент» ×K".
// Одинаковые коды сводятся в одну строку со счетчиком; позиция и фрагмент берутся у первого элемента.
//
// Параметры:
//  Элементы - Массив - причины или риски: Структура или Соответствие с полями code, line, col либо строка кода
//  ИмяИнструмента - Строка - имя инструмента вызова; уточняет пояснения (необязательный)
//  ИсходныйТекст - Строка - текст, присланный клиентом: позиции причин относятся к нему; пустой - без фрагментов
//                  (необязательный)
//
// Возвращаемое значение:
//  Строка - список
//
&НаКлиенте
Функция СписокКодовДляШлюза(Элементы, ИмяИнструмента = "", ИсходныйТекст = "")

	Порядок = Новый Массив;
	Группы = Новый Соответствие;

	Для Каждого Элемент Из Элементы Цикл

		Код = КодРискаПроверки(Элемент);
		Группа = Группы.Получить(Код);

		Если Группа = Неопределено Тогда

			Группы.Вставить(Код, Новый Структура("Строка, Количество",
				СтрокаКодаДляШлюза(Элемент, Код, ИмяИнструмента, ИсходныйТекст), 1));
			Порядок.Добавить(Код);

		Иначе

			Группа.Количество = Группа.Количество + 1;

		КонецЕсли;

	КонецЦикла;

	Строки = Новый Массив;

	Для Каждого Код Из Порядок Цикл

		Группа = Группы.Получить(Код);
		Строки.Добавить(Группа.Строка + ?(Группа.Количество > 1, " ×" + Формат(Группа.Количество, "ЧН=0; ЧГ="), ""));

	КонецЦикла;

	Возврат СоединитьМассив(Строки, Символы.ПС);

КонецФункции

// Строка списка шлюза для одного элемента: код, позиция, пояснение и фрагмент исходного текста у позиции.
//
// Параметры:
//  Элемент - Произвольный - причина или риск проверки
//  Код - Строка - код элемента (КодРискаПроверки)
//  ИмяИнструмента - Строка - имя инструмента вызова
//  ИсходныйТекст - Строка - текст, присланный клиентом
//
// Возвращаемое значение:
//  Строка - строка списка
//
&НаКлиенте
Функция СтрокаКодаДляШлюза(Элемент, Код, ИмяИнструмента, ИсходныйТекст)

	НомерСтроки = ПолеРезультатаПроверки(Элемент, "line");
	ЕстьПозиция = ТипЗнч(НомерСтроки) = Тип("Число") И НомерСтроки > 0;
	Позиция = ?(ЕстьПозиция, " (строка " + Формат(НомерСтроки, "ЧН=0; ЧГ=") + ")", "");
	Фрагмент = "";

	Если ЕстьПозиция Тогда

		Фрагмент = ФрагментИсходногоТекста(ИсходныйТекст, НомерСтроки, ПолеРезультатаПроверки(Элемент, "col"));

	КонецЕсли;

	Возврат ?(Код = "", "нечитаемый элемент", Код) + Позиция + ": " + ОписаниеКодаПроверки(Код, ИмяИнструмента) + Фрагмент;

КонецФункции

// Короткий фрагмент исходного текста вокруг позиции причины: до 30 знаков до позиции и до 30 после нее, в пределах
// строки. Позиция (строка и колонка, с единицы, колонка считает знаки) относится к тексту, присланному клиентом.
//
// Параметры:
//  Текст - Строка - исходный текст
//  НомерСтроки - Число - номер строки с единицы
//  Колонка - Число, Неопределено - номер знака в строке с единицы
//
// Возвращаемое значение:
//  Строка - " - «фрагмент»" (многоточие там, где текст обрезан); пустая строка, если фрагмента нет
//
&НаКлиенте
Функция ФрагментИсходногоТекста(Текст, НомерСтроки, Колонка)

	Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ ПустаяСтрока(Текст) ИЛИ НомерСтроки > СтрЧислоСтрок(Текст) Тогда

		Возврат "";

	КонецЕсли;

	СтрокаТекста = СтрПолучитьСтроку(Текст, НомерСтроки);
	Позиция = ?(ТипЗнч(Колонка) = Тип("Число") И Колонка >= 1, Колонка, 1);
	Начало = Макс(1, Позиция - 30);
	Фрагмент = СокрЛП(Сред(СтрокаТекста, Начало, Позиция - Начало + 31));

	Если ПустаяСтрока(Фрагмент) Тогда

		Возврат "";

	КонецЕсли;

	Возврат " - «" + ?(Начало > 1, "…", "") + Фрагмент + ?(Позиция + 30 < СтрДлина(СтрокаТекста), "…", "") + "»";

КонецФункции

// Признак риска класса защиты среди рисков проверки (нечитаемый элемент считается классом защиты).
//
// Параметры:
//  Риски - Массив - риски проверки
//
// Возвращаемое значение:
//  Булево - Истина, если подтверждение приостановит гарантию строгого режима
//
&НаКлиенте
Функция ЕстьРискКлассаЗащиты(Риски)

	Для Каждого Риск Из Риски Цикл

		Код = КодРискаПроверки(Риск);

		Если Код = "" Или КлассЗащитыПоКодуРиска(Код) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Признак причины проверки, подтверждение которой приостанавливает гарантию строгого режима: любая причина вне
// списка ПричинаНеПриостанавливаетГарантию, в том числе нечитаемая (пустой код) и новая (fail closed).
//
// Параметры:
//  Причины - Массив - причины проверки: Структура или Соответствие с полем code либо строка кода
//
// Возвращаемое значение:
//  Булево - Истина, если подтверждение приостановит гарантию по причинам проверки
//
&НаКлиенте
Функция ЕстьПричинаКлассаЗащиты(Причины)

	Для Каждого Причина Из Причины Цикл

		Если НЕ ПричинаНеПриостанавливаетГарантию(КодРискаПроверки(Причина)) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Закрытый список причин проверки execute_query / execute_code, подтверждение которых не приостанавливает
// гарантию: ни одно защищенное значение не влияет ни на результат, ни на ход выполнения. Остальные причины
// приостанавливают ее: каналы утечки через вычисление над защищенным значением и неявный поток открыты, а после
// отказа анализа (разбор, печать, предел, политика, неизвестная конструкция) отсутствие такой причины ничего не
// доказывает. Не приостанавливают:
//  Q_FOR_UPDATE - ДЛЯ ИЗМЕНЕНИЯ только блокирует прочитанные строки; метки колонок и состав строк те же, что без него.
// Не входят в список, хотя метка результата "unknown": C_UNLABELED_RESULT, C_MIXED_RESULT, C_DERIVED_RESULT -
// число, дата и булево с такой меткой возвращаются без маскирования (ЗамаскироватьЗначениеПоМетке).
//
// Параметры:
//  Код - Строка - код причины; пустая строка - нечитаемый элемент
//
// Возвращаемое значение:
//  Булево - Истина, если подтверждение причины не приостанавливает гарантию
//
&НаКлиенте
Функция ПричинаНеПриостанавливаетГарантию(Код)

	Возврат Код = "Q_FOR_UPDATE";

КонецФункции

// Фиксированное пояснение к коду причины или риска. Значения из текста в пояснение не попадают.
//
// Параметры:
//  Код - Строка - код причины или риска
//  ИмяИнструмента - Строка - имя инструмента вызова; для close_1c_session R_CREDENTIALS поясняется отдельно
//
// Возвращаемое значение:
//  Строка - пояснение
//
&НаКлиенте
Функция ОписаниеКодаПроверки(Код, ИмяИнструмента = "")

	Пояснения = Новый Соответствие;
	Пояснения.Вставить("Q_INCOMPLETE", "не все таблицы запроса известны политике полей");
	Пояснения.Вставить("Q_INTERNAL", "ответ проверки не прочитан");
	Пояснения.Вставить("Q_COMPONENT_UNAVAILABLE", "компонента проверки недоступна");
	Пояснения.Вставить("Q_FUNC_OVER_PROTECTED", "функция над защищенным значением");
	Пояснения.Вставить("Q_COMPARE_PROTECTED", "сравнение защищенного значения с литералом или значением клиента");
	Пояснения.Вставить("Q_ORDER_PROTECTED", "упорядочивание по защищенному значению");
	Пояснения.Вставить("Q_PRESENTATION", "представление защищенных данных");
	Пояснения.Вставить("Q_TOTALS", "итоги по защищенным данным");
	Пояснения.Вставить("C_EVAL", "Выполнить или Вычислить");
	Пояснения.Вставить("C_DYNAMIC_KEY", "обращение к свойству по имени-строке");
	Пояснения.Вставить("C_IMPLICIT_FLOW", "ветвление по защищенному значению");
	Пояснения.Вставить("C_UNLABELED_RESULT", "происхождение части результата не определено");
	Пояснения.Вставить("C_MIXED_RESULT", "результат смешивает защищенные значения и значения клиента");
	Пояснения.Вставить("R_WRITE", "запись данных");
	Пояснения.Вставить("R_PROTECTION", "код может отключить защиту до конца сеанса");
	Пояснения.Вставить("R_CONFIRMED_REASONS", "подтверждено вычисление над защищенными значениями по причинам проверки");
	Пояснения.Вставить("R_DEFERRED", "код запускает отложенную работу (фоновые или регламентные задания)");
	Пояснения.Вставить("R_CREDENTIALS", ?(ИмяИнструмента = "close_1c_session",
		"передает пароль базы на машину клиента", "код передает учетные данные"));
	Пояснения.Вставить("R_CLIENT_CONTEXT", "выполнение в контексте клиента рядом с картой токенов");
	Пояснения.Вставить("R_RELAUNCH",
		"1С будет запущена под пользователем ИИ-клиента - гарантия для этого сеанса заканчивается");
	Пояснения.Вставить("R_IMAGE", "изображение не маскируется и показывает все, что видно в окне 1С");
	Пояснения.Вставить("R_OPEN_BY_LINK", "открывает форму по навигационной ссылке");
	Пояснения.Вставить("L_LOOKUP", "поиск по значению клиента: найдено или не найдено - уже ответ");
	Пояснение = Пояснения.Получить(Код);

	Возврат ?(Пояснение = Неопределено, ОписаниеГруппыКодаПроверки(Код), Пояснение);

КонецФункции

// Пояснение по группе кода (префиксу), если для самого кода пояснения нет.
//
// Параметры:
//  Код - Строка - код причины или риска
//
// Возвращаемое значение:
//  Строка - пояснение
//
&НаКлиенте
Функция ОписаниеГруппыКодаПроверки(Код)

	Если Лев(Код, 8) = "Q_PARSE_" Или Лев(Код, 7) = "C_PARSE" Тогда

		Возврат "текст не разобран";

	ИначеЕсли Лев(Код, 8) = "Q_PRINT_" Или Лев(Код, 8) = "C_PRINT_" Тогда

		Возврат "канонический текст не построен";

	ИначеЕсли Лев(Код, 2) = "Q_" Или Лев(Код, 2) = "C_" Тогда

		Возврат "конструкция требует подтверждения";

	Иначе

		Возврат "требует подтверждения";

	КонецЕсли;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ЖУРНАЛ ШЛЮЗА И СВЕРКА СОСТОЯНИЯ ЗАЩИТЫ ПОСЛЕ ПОДТВЕРЖДЕННОГО ВЫЗОВА
// ─────────────────────────────────────────────────────────────────────────────────

// Строка журнала шлюза по итогу вызова. Журнал живет только в форме (сеанс), в базу ничего не пишется.
//
// Параметры:
//  Ожидание - Структура - Вызов, Проверка, Доставка
//  Итог - Строка - approved, rejected, timeout, epoch или expired
//
&НаКлиенте
Процедура ЗаписатьВЖурналШлюза(Ожидание, Итог)

	ДобавитьСтрокуЖурналаШлюза(Ожидание.Вызов.Имя, Ожидание.Проверка.verdict, ПредставлениеИтогаШлюза(Итог),
		КодыПричинПроверки(Ожидание.Проверка));

КонецПроцедуры

// Добавляет строку в журнал шлюза; самые старые строки сверх 200 удаляются: реквизит формы передается
// с каждым контекстным серверным вызовом, большой журнал замедлил бы их.
//
// Параметры:
//  Инструмент - Строка - имя инструмента
//  Вердикт - Строка - вердикт проверки
//  Решение - Строка - решение или событие
//  Риски - Строка - коды причин и рисков
//
&НаКлиенте
Процедура ДобавитьСтрокуЖурналаШлюза(Инструмент, Вердикт, Решение, Риски)

	ЗаписьЖурнала = ЖурналШлюза.Добавить();
	ЗаписьЖурнала.Время = ТекущаяДата();
	ЗаписьЖурнала.Инструмент = Инструмент;
	ЗаписьЖурнала.Вердикт = Вердикт;
	ЗаписьЖурнала.Решение = Решение;
	ЗаписьЖурнала.Риски = Риски;

	Пока ЖурналШлюза.Количество() > 200 Цикл

		ЖурналШлюза.Удалить(0);

	КонецЦикла;

КонецПроцедуры

// Представление итога шлюза для журнала.
//
// Параметры:
//  Итог - Строка - approved, rejected, timeout, epoch или expired
//
// Возвращаемое значение:
//  Строка - представление
//
&НаКлиенте
Функция ПредставлениеИтогаШлюза(Итог)

	Если Итог = "approved" Тогда

		Возврат "подтверждено";

	ИначеЕсли Итог = "timeout" Тогда

		Возврат "время истекло";

	ИначеЕсли Итог = "epoch" Тогда

		Возврат "отменено: режим защиты переключен";

	ИначеЕсли Итог = "expired" Тогда

		Возврат "отброшено: запрос закрыт транспортом";

	Иначе

		Возврат "отклонено";

	КонецЕсли;

КонецФункции

// Снимок состояния защиты перед подтвержденным выполнением (СнимокСостоянияЗащиты). Снимок запоминается
// по id HTTP-запроса до сверки в хвосте ответа (СверитьСостояниеПодтвержденногоВызова).
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  ИмяИнструмента - Строка - имя инструмента для журнала шлюза
//
// Возвращаемое значение:
//  Структура - снимок состояния защиты
//
&НаКлиенте
Функция ЗапомнитьСнимокПодтвержденногоВызова(ДанныеЗапроса, ИмяИнструмента)

	Снимок = СнимокСостоянияЗащиты();
	СнимкиПодтвержденныхВызовов.Вставить(ДанныеЗапроса.id,
		Новый Структура("Снимок, Эпоха, Инструмент", Снимок, ЭпохаЗащиты, ИмяИнструмента));

	Возврат Снимок;

КонецФункции

// Сверка состояния защиты после подтвержденного выполнения. Вызывается в начале каждого хвоста ответа (до
// маскирования и до проверки СостояниеЗащиты.Строгий: подтвержденный код мог его снять) и после синхронного ответа.
// Без ожидающего снимка ничего не делает: в режимах Выкл и Маскирование снимков нет. Снимок, запомненный в прошлой
// эпохе защиты, не сверяется: состояние сменил человек. Восстановление записывается в журнал шлюза.
//
// Параметры:
//  ДанныеЗапроса - Структура, Произвольный - данные HTTP-запроса
//  Снимок - Структура, Неопределено - снимок, взятый перед выполнением в этом же стеке вызовов; сверяется всегда
//
&НаКлиенте
Процедура СверитьСостояниеПодтвержденногоВызова(ДанныеЗапроса, Снимок = Неопределено)

	Ожидающий = Неопределено;

	Если СнимкиПодтвержденныхВызовов <> Неопределено И СнимкиПодтвержденныхВызовов.Количество() > 0
		И ТипЗнч(ДанныеЗапроса) = Тип("Структура") И ДанныеЗапроса.Свойство("id") Тогда

		Ожидающий = СнимкиПодтвержденныхВызовов.Получить(ДанныеЗапроса.id);
		СнимкиПодтвержденныхВызовов.Удалить(ДанныеЗапроса.id);

	КонецЕсли;

	Если Снимок = Неопределено И Ожидающий <> Неопределено И Ожидающий.Эпоха = ЭпохаЗащиты Тогда

		Снимок = Ожидающий.Снимок;

	КонецЕсли;

	Если Снимок <> Неопределено И СверитьИВосстановитьСостояниеЗащиты(Снимок) Тогда

		ДобавитьСтрокуЖурналаШлюза(?(Ожидающий = Неопределено, "", Ожидающий.Инструмент), "",
			"состояние защиты изменено кодом и восстановлено", "R_PROTECTION");

	КонецЕсли;

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ПРОВЕРКА ЗАПРОСА И КОДА ПЕРЕД ВЫПОЛНЕНИЕМ
// ─────────────────────────────────────────────────────────────────────────────────

// Проверка текста execute_query / execute_code компонентой до выполнения: пока проверка не завершена, ничего
// не выполняется. Если проверка завершилась в этом вызове (синхронные вызовы компонент), ответ возвращается сразу;
// иначе (асинхронная цепочка компоненты) ответ уходит позже через ОтправитьОтветСтрогогоРежима. Незавершенная
// проверка ждет в ОжидающиеПроверкиСтрогогоРежима; по истечении срока ей отвечает ПроверитьСрокиПроверокСтрогогоРежима.
// Вызов, требующий подтверждения, уходит в шлюз: тогда ответ всегда Неопределено, и его дает шлюз.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров (Имя, Аргументы, Происхождение, Токены, Эпоха)
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ транспорта или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ПроверитьВызовСтрогогоРежима(Вызов, Доставка)

	Контекст = Новый Структура("Вызов, Доставка, Таблицы, Раунд, ПолитикаJSON, Завершено, Отложено, Ответ",
		Вызов, Доставка, Новый Массив, 0, "", Ложь, Ложь, Неопределено);
	Контекст.Вставить("ВыполнениеНачато", Ложь);
	Контекст.Вставить("ПродолжениеПодключения", "");
	Контекст.Вставить("ОстатокСрока", СрокАсинхроннойПроверкиСтрогогоРежима());

	ВызватьПроверкуКомпонентой(Контекст);

	Если Контекст.Завершено Тогда

		Возврат Контекст.Ответ;

	КонецЕсли;

	Контекст.Отложено = Истина;

	Если ОжидающиеПроверкиСтрогогоРежима.Количество() = 0 Тогда

		ПодключитьОбработчикОжидания("ПроверитьСрокиПроверокСтрогогоРежима", ИнтервалСроковПроверокСтрогогоРежима(), Ложь);

	КонецЕсли;

	ОжидающиеПроверкиСтрогогоРежима.Добавить(Контекст);

	Возврат Неопределено;

КонецФункции

// Один раунд проверки компонентой: политика полей по таблицам, известным к этому раунду, затем CheckQuery или
// CheckCode. Синхронный вызов, если синхронные вызовы внешних компонент разрешены; иначе асинхронная цепочка
// подключения и вызова. Политика не построена -> confirm с Q_INTERNAL.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//
&НаКлиенте
Процедура ВызватьПроверкуКомпонентой(Контекст)

	Если ПроверкаОтклоненаПоЭпохе(Контекст) Тогда

		Возврат;

	КонецЕсли;

	Попытка

		Контекст.ПолитикаJSON = ПолитикаПроверкиСтрогогоРежима(Контекст);

	Исключение

		ДобавитьВЛог("Строгий режим: политика полей для проверки не построена: " + ОписаниеОшибки());
		ЗавершитьПроверкуСтрогогоРежима(Контекст, ОтказПроверкиСтрогогоРежима("Q_INTERNAL"));

		Возврат;

	КонецПопытки;

	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда

		НачатьПроверкуКомпонентойАсинхронно(Контекст);

	Иначе

		ПроверитьКомпонентойСинхронно(Контекст);

	КонецЕсли;

КонецПроцедуры

// Синхронная проверка: подключение компоненты (ПодключитьКомпонентуLineageСинхронно) и вызов метода проверки.
// Компонента не загружена или в ней нет метода проверки -> confirm с Q_COMPONENT_UNAVAILABLE.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//
&НаКлиенте
Процедура ПроверитьКомпонентойСинхронно(Контекст)

	Если НЕ ПодключитьКомпонентуLineageСинхронно() Тогда

		ЗавершитьПроверкуСтрогогоРежима(Контекст, ОтказПроверкиСтрогогоРежима("Q_COMPONENT_UNAVAILABLE"));

		Возврат;

	КонецЕсли;

	Попытка

		Если Контекст.Вызов.Имя = "execute_code" Тогда

			РезультатJSON = КомпонентаLineage.CheckCode(Контекст.Вызов.Аргументы.code, Контекст.ПолитикаJSON);

		Иначе

			РезультатJSON = КомпонентаLineage.CheckQuery(Контекст.Вызов.Аргументы.query, Контекст.ПолитикаJSON);

		КонецЕсли;

	Исключение

		ДобавитьВЛог("Строгий режим: метод проверки компоненты недоступен: " + ОписаниеОшибки());
		ЗавершитьПроверкуСтрогогоРежима(Контекст, ОтказПроверкиСтрогогоРежима("Q_COMPONENT_UNAVAILABLE"));

		Возврат;

	КонецПопытки;

	ШагПроверкиСтрогогоРежима(Контекст, РезультатJSON);

КонецПроцедуры

// Асинхронная проверка: если компонента еще не создана, она подключается общей цепочкой
// НачатьПодключениеКомпонентыLineage (макет, при неудаче - временный файл); продолжение - ПослеПодключенияLineageСтрогий
// по полю контекста ПродолжениеПодключения.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//
&НаКлиенте
Процедура НачатьПроверкуКомпонентойАсинхронно(Контекст)

	Если КомпонентаLineage <> Неопределено Тогда

		ЗапуститьAsyncПроверкуСтрогий(Контекст);

		Возврат;

	КонецЕсли;

	Контекст.ПродолжениеПодключения = "ПослеПодключенияLineageСтрогий";

	Попытка

		НачатьПодключениеКомпонентыLineage(Контекст);

	Исключение

		ДобавитьВЛог("Строгий режим: компонента проверки не подключена: " + ОписаниеОшибки());
		ЗавершитьПроверкуСтрогогоРежима(Контекст, ОтказПроверкиСтрогогоРежима("Q_COMPONENT_UNAVAILABLE"));

	КонецПопытки;

КонецПроцедуры

// Продолжение проверки после асинхронного подключения компоненты (ПродолжитьПослеПодключенияLineage).
// Компонента не подключена -> confirm с Q_COMPONENT_UNAVAILABLE. Сбой продолжения обрабатывается как
// в ПослеCheckСтрогий: E_EXECUTION, если ответ еще не дан и его не даст другой путь.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//  Подключена - Булево - объект компоненты создан
//
&НаКлиенте
Процедура ПослеПодключенияLineageСтрогий(Контекст, Подключена)

	Если Контекст.Завершено Тогда

		Возврат;

	КонецЕсли;

	Попытка

		Если Подключена Тогда

			ЗапуститьAsyncПроверкуСтрогий(Контекст);

		Иначе

			ЗавершитьПроверкуСтрогогоРежима(Контекст, ОтказПроверкиСтрогогоРежима("Q_COMPONENT_UNAVAILABLE"));

		КонецЕсли;

	Исключение

		ДобавитьВЛог("Строгий режим: сбой продолжения проверки: " + ОписаниеОшибки());

		Если ОтветДоставкиДан(Контекст.Доставка)
			Или (Контекст.ВыполнениеНачато И ОтветВызоваДастФоновоеЗадание(Контекст.Доставка)) Тогда

			Контекст.Завершено = Истина;

		Иначе

			ОтветитьНаПроверкуСтрогогоРежима(Контекст, ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Контекст.Доставка));

		КонецЕсли;

	КонецПопытки;

КонецПроцедуры

// Асинхронный вызов метода проверки (НачатьВызовCheckQuery / НачатьВызовCheckCode); результат приходит
// в ПослеCheckСтрогий. Метода нет в компоненте -> confirm с Q_COMPONENT_UNAVAILABLE.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//
&НаКлиенте
Процедура ЗапуститьAsyncПроверкуСтрогий(Контекст)

	Оповещение = Новый ОписаниеОповещения("ПослеCheckСтрогий", ЭтаФорма, Контекст);

	Попытка

		Если Контекст.Вызов.Имя = "execute_code" Тогда

			КомпонентаLineage.НачатьВызовCheckCode(Оповещение, Контекст.Вызов.Аргументы.code, Контекст.ПолитикаJSON);

		Иначе

			КомпонентаLineage.НачатьВызовCheckQuery(Оповещение, Контекст.Вызов.Аргументы.query, Контекст.ПолитикаJSON);

		КонецЕсли;

	Исключение

		ДобавитьВЛог("Строгий режим: метод проверки компоненты недоступен: " + ОписаниеОшибки());
		ЗавершитьПроверкуСтрогогоРежима(Контекст, ОтказПроверкиСтрогогоРежима("Q_COMPONENT_UNAVAILABLE"));

	КонецПопытки;

КонецПроцедуры

// Результат асинхронного вызова метода проверки. Сбой продолжения не оставляет запрос без ответа: клиенту
// уходит E_EXECUTION, если ответ еще не дан (ОтветДоставкиДан) и его не даст другой путь (шлюз или фоновое
// задание). Если ответ уже дан или его даст другой путь, проверка только закрывается, чтобы ответ не ушел дважды.
//
// Параметры:
//  РезВызова - Строка - JSON результата проверки
//  ПарВызова - Массив - параметры вызова метода
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//
&НаКлиенте
Процедура ПослеCheckСтрогий(РезВызова, ПарВызова, Контекст) Экспорт

	Попытка

		ШагПроверкиСтрогогоРежима(Контекст, РезВызова);

	Исключение

		ДобавитьВЛог("Строгий режим: сбой продолжения проверки: " + ОписаниеОшибки());

		Если ОтветДоставкиДан(Контекст.Доставка)
			Или (Контекст.ВыполнениеНачато И ОтветВызоваДастФоновоеЗадание(Контекст.Доставка)) Тогда

			Контекст.Завершено = Истина;

		Иначе

			ОтветитьНаПроверкуСтрогогоРежима(Контекст, ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Контекст.Доставка));

		КонецЕсли;

	КонецПопытки;

КонецПроцедуры

// Шаг проверки компонентой: повторяет вызов с дополненной политикой, пока компонента сообщает incomplete и
// добавляет новые таблицы. Любая неопределенность (компонента не загружена, пустой или нечитаемый ответ,
// превышено число раундов, нет новых таблиц) -> confirm.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//  РезультатJSON - Строка - результат CheckQuery / CheckCode
//
&НаКлиенте
Процедура ШагПроверкиСтрогогоРежима(Контекст, РезультатJSON)

	Если Контекст.Завершено Тогда

		Возврат;

	КонецЕсли;

	Ответ = РазобратьРезультатПроверки(РезультатJSON);

	Если Ответ.verdict = "incomplete" И Контекст.Раунд < 5
		И ДобавитьНедостающиеТаблицыПроверки(Контекст.Таблицы, Ответ.missing_tables) Тогда

		Контекст.Раунд = Контекст.Раунд + 1;
		ВызватьПроверкуКомпонентой(Контекст);

		Возврат;

	КонецЕсли;

	Если Ответ.verdict = "incomplete" Тогда

		Ответ.verdict = "confirm";
		Ответ.reasons.Добавить(ПричинаПроверкиСтрогогоРежима("Q_INCOMPLETE"));

	КонецЕсли;

	ЗавершитьПроверкуСтрогогоРежима(Контекст, Ответ);

КонецПроцедуры

// Добавляет в список таблиц политики недостающие таблицы из ответа компоненты, без повторов.
//
// Параметры:
//  Таблицы - Массив - имена таблиц политики; дополняется
//  Недостающие - Массив - missing_tables из ответа компоненты
//
// Возвращаемое значение:
//  Булево - Истина, если добавлена хотя бы одна новая таблица
//
&НаКлиенте
Функция ДобавитьНедостающиеТаблицыПроверки(Таблицы, Недостающие)

	Известные = Новый Соответствие;

	Для Каждого ИмяТаблицы Из Таблицы Цикл

		Известные.Вставить(ВРег(ИмяТаблицы), Истина);

	КонецЦикла;

	Добавлено = Ложь;

	Для Каждого ИмяТаблицы Из Недостающие Цикл

		Если ТипЗнч(ИмяТаблицы) = Тип("Строка") И НЕ ПустаяСтрока(ИмяТаблицы)
			И Известные.Получить(ВРег(ИмяТаблицы)) = Неопределено Тогда

			Известные.Вставить(ВРег(ИмяТаблицы), Истина);
			Таблицы.Добавить(ИмяТаблицы);
			Добавлено = Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Добавлено;

КонецФункции

// Разбор результата CheckQuery / CheckCode в проверку фиксированной формы. Пустой или нечитаемый ответ,
// api <> 1, неизвестный вердикт -> confirm с Q_INTERNAL. safe засчитывается только без причин, без недостающих
// таблиц и с непустым каноническим текстом. Риски компоненты (risks) переходят в Риски: safe с рисками идет в шлюз.
//
// Параметры:
//  ТекстJSON - Строка - результат метода проверки компоненты
//
// Возвращаемое значение:
//  Структура - verdict (Строка), reasons, columns, missing_tables (Массив), canonical (Строка), Риски (Массив),
//              result_labels (Соответствие: путь -> метка; только для CheckCode)
//
&НаКлиенте
Функция РазобратьРезультатПроверки(ТекстJSON)

	Ответ = ОтказПроверкиСтрогогоРежима("Q_INTERNAL");
	Данные = ПрочитатьРезультатПроверкиJSON(ТекстJSON);
	Вердикт = ПолеРезультатаПроверки(Данные, "verdict");

	Если ПолеРезультатаПроверки(Данные, "api") <> 1
		Или (Вердикт <> "safe" И Вердикт <> "confirm" И Вердикт <> "incomplete") Тогда

		Возврат Ответ;

	КонецЕсли;

	Ответ.verdict = Вердикт;
	Ответ.reasons = МассивРезультатаПроверки(Данные, "reasons");
	Ответ.columns = МассивРезультатаПроверки(Данные, "columns");
	Ответ.missing_tables = МассивРезультатаПроверки(Данные, "missing_tables");
	Ответ.Риски = РискиКомпонентыПроверки(МассивРезультатаПроверки(Данные, "risks"));
	Ответ.result_labels = МеткиРезультатаКомпоненты(ПолеРезультатаПроверки(Данные, "result_labels"));
	Канонический = ПолеРезультатаПроверки(Данные, "canonical");
	Ответ.canonical = ?(ТипЗнч(Канонический) = Тип("Строка"), Канонический, "");

	Если Вердикт = "safe" И (Ответ.reasons.Количество() > 0 Или Ответ.missing_tables.Количество() > 0
		Или ПустаяСтрока(Ответ.canonical)) Тогда

		Ответ.verdict = "confirm";
		Ответ.reasons.Добавить(ПричинаПроверкиСтрогогоРежима("Q_INTERNAL"));

	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Риски проверки от компоненты. Код L_LOOKUP зарезервирован за меткой встроенного поиска формы
// (ВердиктВстроенныхПоисковСтрогогоРежима) и не приостанавливает гарантию (КлассЗащитыПоКодуРиска): пришедший от
// компоненты, он заменяется на R_UNKNOWN_EFFECT. Остальные элементы остаются как есть.
//
// Параметры:
//  РискиКомпоненты - Массив - элементы risks результата проверки
//
// Возвращаемое значение:
//  Массив - риски проверки
//
&НаКлиенте
Функция РискиКомпонентыПроверки(РискиКомпоненты)

	Риски = Новый Массив;

	Для Каждого Риск Из РискиКомпоненты Цикл

		Риски.Добавить(?(КодРискаПроверки(Риск) = "L_LOOKUP", "R_UNKNOWN_EFFECT", Риск));

	КонецЦикла;

	Возврат Риски;

КонецФункции

// Чтение JSON результата проверки. Не строка, пустая строка или нечитаемый JSON дают Неопределено.
//
// Параметры:
//  ТекстJSON - Произвольный - результат метода проверки компоненты
//
// Возвращаемое значение:
//  Произвольный - разобранный JSON или Неопределено
//
&НаКлиенте
Функция ПрочитатьРезультатПроверкиJSON(ТекстJSON)

	Если ТипЗнч(ТекстJSON) <> Тип("Строка") Или ПустаяСтрока(ТекстJSON) Тогда

		Возврат Неопределено;

	КонецЕсли;

	Попытка

		Данные = ПрочитатьJSON2(ТекстJSON);

	Исключение

		Данные = Неопределено;

	КонецПопытки;

	Возврат Данные;

КонецФункции

// Поле объекта JSON результата проверки (Структура или Соответствие).
//
// Параметры:
//  Данные - Произвольный - разобранный JSON результата проверки
//  Имя - Строка - имя поля
//
// Возвращаемое значение:
//  Произвольный - значение поля; Неопределено, если поля нет или Данные не объект
//
&НаКлиенте
Функция ПолеРезультатаПроверки(Данные, Имя)

	Значение = Неопределено;

	Если ТипЗнч(Данные) = Тип("Структура") Тогда

		Данные.Свойство(Имя, Значение);

	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда

		Значение = Данные.Получить(Имя);

	Иначе

		// Не объект JSON: поля нет.

	КонецЕсли;

	Возврат Значение;

КонецФункции

// Поле-массив результата проверки; поле другого типа или его отсутствие дает пустой массив.
//
// Параметры:
//  Данные - Произвольный - разобранный JSON результата проверки
//  Имя - Строка - имя поля
//
// Возвращаемое значение:
//  Массив - значение поля или пустой массив
//
&НаКлиенте
Функция МассивРезультатаПроверки(Данные, Имя)

	Значение = ПолеРезультатаПроверки(Данные, Имя);

	Если ТипЗнч(Значение) = Тип("Массив") Тогда

		Возврат Значение;

	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Метки результата кода из result_labels ответа CheckCode: путь ($, .Ключ, [*], [*].key, [*].value, [*].Колонка) ->
// метка. Пути переносятся как есть (маскирование сравняет их в верхнем регистре, ДобавитьМеткиРезультатаКода
// добавит префикс $.data). Метка вне известного набора (не строка, неизвестная строка) заменяется на unknown:
// такое значение маскируется.
//
// Параметры:
//  МеткиКомпоненты - Соответствие, Структура, Неопределено - result_labels результата проверки
//
// Возвращаемое значение:
//  Соответствие - путь -> метка
//
&НаКлиенте
Функция МеткиРезультатаКомпоненты(МеткиКомпоненты)

	Метки = Новый Соответствие;

	Если ТипЗнч(МеткиКомпоненты) <> Тип("Соответствие") И ТипЗнч(МеткиКомпоненты) <> Тип("Структура") Тогда

		Возврат Метки;

	КонецЕсли;

	Известные = "|open|client|protected|protected_derived|mixed|unknown|container|ref|";

	Для Каждого Элемент Из МеткиКомпоненты Цикл

		Метка = Элемент.Значение;
		Известна = ТипЗнч(Метка) = Тип("Строка") И Найти(Метка, "|") = 0 И Найти(Известные, "|" + Метка + "|") > 0;
		Метки.Вставить(Строка(Элемент.Ключ), ?(Известна, Метка, "unknown"));

	КонецЦикла;

	Возврат Метки;

КонецФункции

// Проверка с вердиктом confirm и одной причиной: отказ в сторону подтверждения.
//
// Параметры:
//  Код - Строка - код причины (Q_...)
//
// Возвращаемое значение:
//  Структура - verdict, reasons, columns, missing_tables, canonical, Риски, result_labels
//              (см. РазобратьРезультатПроверки)
//
&НаКлиенте
Функция ОтказПроверкиСтрогогоРежима(Код)

	Причины = Новый Массив;
	Причины.Добавить(ПричинаПроверкиСтрогогоРежима(Код));

	Возврат Новый Структура("verdict, reasons, columns, missing_tables, canonical, Риски, result_labels",
		"confirm", Причины, Новый Массив, Новый Массив, "", Новый Массив, Новый Соответствие);

КонецФункции

// Причина проверки без позиции в тексте.
//
// Параметры:
//  Код - Строка - код причины (Q_..., C_...)
//
// Возвращаемое значение:
//  Структура - code, line, col
//
&НаКлиенте
Функция ПричинаПроверкиСтрогогоРежима(Код)

	Возврат Новый Структура("code, line, col", Код, 0, 0);

КонецФункции

// Завершение проверки: safe без рисков -> выполнение канонического текста (ВыполнитьВызовСтрогогоРежима);
// иначе -> шлюз подтверждения (ОткрытьШлюзСтрогогоРежима): проверка закрывается без ответа, и ответ дает шлюз;
// до решения человека ничего не выполняется. execute_code в контексте клиента всегда требует подтверждения
// (R_CLIENT_CONTEXT).
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//  Ответ - Структура - проверка (РазобратьРезультатПроверки)
//
&НаКлиенте
Процедура ЗавершитьПроверкуСтрогогоРежима(Контекст, Ответ)

	Если Контекст.Завершено Тогда

		Возврат;

	КонецЕсли;

	Если ПроверкаОтклоненаПоЭпохе(Контекст) Тогда

		Возврат;

	КонецЕсли;

	Вызов = Контекст.Вызов;
	КонтекстВыполнения = Неопределено;

	Если Вызов.Имя = "execute_code" И Вызов.Аргументы.Свойство("execution_context", КонтекстВыполнения)
		И КонтекстВыполнения = "client" Тогда

		Ответ.Риски.Добавить("R_CLIENT_CONTEXT");

	КонецЕсли;

	Если Ответ.verdict = "safe" И Ответ.Риски.Количество() = 0 Тогда

		Контекст.ВыполнениеНачато = Истина;
		Результат = ВыполнитьВызовСтрогогоРежима(Вызов, Контекст.Доставка, Ответ);

	Иначе

		Контекст.ВыполнениеНачато = Истина;
		ОтветитьНаПроверкуСтрогогоРежима(Контекст, Неопределено);
		ОткрытьШлюзСтрогогоРежима(Вызов, Ответ, Контекст.Доставка);

		Возврат;

	КонецЕсли;

	ОтветитьНаПроверкуСтрогогоРежима(Контекст, Результат);

КонецПроцедуры

// Коды причин и рисков проверки через запятую, для журнала формы. Значения текста в коды не попадают.
//
// Параметры:
//  Ответ - Структура - проверка (РазобратьРезультатПроверки)
//
// Возвращаемое значение:
//  Строка - коды через запятую
//
&НаКлиенте
Функция КодыПричинПроверки(Ответ)

	Коды = "";

	Для Каждого Причина Из Ответ.reasons Цикл

		Коды = Коды + ?(ПустаяСтрока(Коды), "", ", ") + КодРискаПроверки(Причина);

	КонецЦикла;

	Для Каждого Риск Из Ответ.Риски Цикл

		Коды = Коды + ?(ПустаяСтрока(Коды), "", ", ") + КодРискаПроверки(Риск);

	КонецЦикла;

	Возврат Коды;

КонецФункции

// Ответ на проверенный вызов, ровно один раз. В синхронном проходе ответ сохраняется в контексте и возвращается
// из ПроверитьВызовСтрогогоРежима; после асинхронного продолжения отправляется через транспорт доставки.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//  Ответ - Структура, Неопределено - ответ транспорта; Неопределено, если ответ уйдет другим путем
//
&НаКлиенте
Процедура ОтветитьНаПроверкуСтрогогоРежима(Контекст, Ответ)

	Если Контекст.Завершено Тогда

		Возврат;

	КонецЕсли;

	Контекст.Завершено = Истина;
	Контекст.Ответ = Ответ;

	Если НЕ Контекст.Отложено Или Ответ = Неопределено Тогда

		Возврат;

	КонецЕсли;

	Если Компонента = Неопределено Тогда

		ДобавитьВЛог("Строгий режим: ответ на проверенный вызов не отправлен: встроенный сервер остановлен");

	Иначе

		ОтправитьОтветСтрогогоРежима(Ответ, Контекст.Доставка);

	КонецЕсли;

КонецПроцедуры

// Проверка, начатая в прошлой эпохе защиты, не продолжается: ни новый раунд, ни выполнение, ни шлюз.
// Клиенту уходит E_EPOCH_CHANGED.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//
// Возвращаемое значение:
//  Булево - Истина, если проверка прекращена и ответ уже дан
//
&НаКлиенте
Функция ПроверкаОтклоненаПоЭпохе(Контекст)

	Если Контекст.Вызов.Эпоха = ЭпохаЗащиты И НЕ ЗапросУстарелПоЭпохе(Контекст.Доставка.ДанныеЗапроса) Тогда

		Возврат Ложь;

	КонецЕсли;

	ДобавитьВЛог("Строгий режим: проверка вызова прошлой эпохи защиты прекращена");
	ОтветитьНаПроверкуСтрогогоРежима(Контекст, ОтветОшибкиСтрогогоДоставки("E_EPOCH_CHANGED", "", Контекст.Доставка));

	Возврат Истина;

КонецФункции

// Срок ответа асинхронной проверки строгого режима: компонента не вернула результат за это время -> E_EXECUTION.
// Срок отсчитывается тактами обработчика ожидания (ИнтервалСроковПроверокСтрогогоРежима), без чтения даты.
//
// Возвращаемое значение:
//  Число - срок в секундах
//
&НаКлиенте
Функция СрокАсинхроннойПроверкиСтрогогоРежима()

	Возврат 60;

КонецФункции

// Интервал обработчика ожидания ПроверитьСрокиПроверокСтрогогоРежима.
//
// Возвращаемое значение:
//  Число - интервал в секундах
//
&НаКлиенте
Функция ИнтервалСроковПроверокСтрогогоРежима()

	Возврат 5;

КонецФункции

// Обработчик ожидания: уменьшает остаток срока ждущих проверок на интервал обработчика; проверке, срок которой
// истек, отвечает E_EXECUTION; завершенные проверки убирает из ОжидающиеПроверкиСтрогогоРежима. Подключается,
// когда список был пуст (повторное подключение сбросило бы отсчет), отключается, когда ждущих проверок нет.
//
&НаКлиенте
Процедура ПроверитьСрокиПроверокСтрогогоРежима() Экспорт

	Интервал = ИнтервалСроковПроверокСтрогогоРежима();
	Индекс = ОжидающиеПроверкиСтрогогоРежима.ВГраница();

	Пока Индекс >= 0 Цикл

		Контекст = ОжидающиеПроверкиСтрогогоРежима[Индекс];
		Контекст.ОстатокСрока = Контекст.ОстатокСрока - Интервал;

		Если Контекст.Завершено Или Контекст.ВыполнениеНачато Тогда

			ОжидающиеПроверкиСтрогогоРежима.Удалить(Индекс);

		ИначеЕсли Контекст.ОстатокСрока <= 0 Тогда

			ОжидающиеПроверкиСтрогогоРежима.Удалить(Индекс);
			ДобавитьВЛог("Строгий режим: проверка вызова " + Контекст.Вызов.Имя + " не завершилась в срок");
			ОтветитьНаПроверкуСтрогогоРежима(Контекст, ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Контекст.Доставка));

		Иначе

			// Срок не истек: проверка ждет ответа компоненты.

		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

	Если ОжидающиеПроверкиСтрогогоРежима.Количество() = 0 Тогда

		ОтключитьОбработчикОжидания("ПроверитьСрокиПроверокСтрогогоРежима");

	КонецЕсли;

КонецПроцедуры

// Отвечает E_EPOCH_CHANGED незавершенным асинхронным проверкам прошлой эпохи и очищает их список.
// Поздний результат компоненты для такой проверки ответа уже не дает (Контекст.Завершено).
//
// Возвращаемое значение:
//  Число - количество проверок, которым отправлен ответ
//
&НаКлиенте
Функция ОтклонитьПроверкиПрошлойЭпохи()

	Количество = 0;

	Для Каждого Контекст Из ОжидающиеПроверкиСтрогогоРежима Цикл

		Если НЕ Контекст.Завершено И НЕ Контекст.ВыполнениеНачато Тогда

			ОтветитьНаПроверкуСтрогогоРежима(Контекст, ОтветОшибкиСтрогогоДоставки("E_EPOCH_CHANGED", "", Контекст.Доставка));
			Количество = Количество + 1;

		КонецЕсли;

	КонецЦикла;

	ОжидающиеПроверкиСтрогогоРежима = Новый Массив;
	ОтключитьОбработчикОжидания("ПроверитьСрокиПроверокСтрогогоРежима");

	Возврат Количество;

КонецФункции

// JSON политики полей для раунда проверки: таблицы, известные к этому раунду, происхождение каждого параметра
// запроса и таблица токенов текста (токен -> index, origin). Реальные значения токенов в политику не попадают.
//
// Параметры:
//  Контекст - Структура - контекст проверки (ПроверитьВызовСтрогогоРежима)
//
// Возвращаемое значение:
//  Строка - JSON политики полей (версия 1)
//
&НаКлиенте
Функция ПолитикаПроверкиСтрогогоРежима(Контекст)

	Дополнение = Новый Соответствие;
	Дополнение.Вставить("params", ПараметрыПолитикиПроверки(Контекст.Вызов));
	Дополнение.Вставить("tokens", Контекст.Вызов.Токены);
	Срез = СрезПравилДляПолитики(СнимокПравилСтрогогоРежима, Контекст.Таблицы);

	Возврат ПолитикаПолейНаСервере(Контекст.Таблицы, Срез, Дополнение);

КонецФункции

// Происхождение каждого параметра для политики: параметры запроса клиента (Вызов.Происхождение: client,
// token_protected, token_unknown) и параметры привязанных токенов текста (ИмяПараметраТокена). Параметр, которого
// здесь нет, компонента считает неизвестным и требует подтверждения.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров (Происхождение, Токены)
//
// Возвращаемое значение:
//  Соответствие - имя параметра -> происхождение (Строка)
//
&НаКлиенте
Функция ПараметрыПолитикиПроверки(Вызов)

	ПараметрыПолитики = Новый Соответствие;

	Для Каждого Элемент Из Вызов.Происхождение Цикл

		ПараметрыПолитики.Вставить(Элемент.Ключ, Элемент.Значение);

	КонецЦикла;

	Для Каждого Элемент Из Вызов.Токены Цикл

		Происхождение = ?(Элемент.Значение.origin = "protected", "token_protected", "token_unknown");
		ПараметрыПолитики.Вставить(ИмяПараметраТокена(Элемент.Значение.index), Происхождение);

	КонецЦикла;

	Возврат ПараметрыПолитики;

КонецФункции

// Имя параметра запроса, к которому привязывается значение токена текста (ПривязатьТокеныКПараметрамЗапроса).
// Соглашение: номер в имени на единицу больше index токена (index 0 -> МСПТокен1). Канонический текст компоненты
// проверки ссылается на токен тем же именем (&МСПТокен<index+1>). Массив значений для execute_code
// (МСПЗначенияТокенов[<index>]) остается нумерованным с нуля.
//
// Параметры:
//  Индекс - Число - index токена в Вызов.ЗначенияТокенов (с нуля)
//
// Возвращаемое значение:
//  Строка - имя параметра МСПТокен<index+1>
//
&НаКлиенте
Функция ИмяПараметраТокена(Индекс)

	Возврат "МСПТокен" + Формат(Индекс + 1, "ЧН=0; ЧГ=");

КонецФункции

// Отправляет ответ строгого режима через транспорт, записанный в Доставка. Для ответов, готовых не сразу.
// До отправки ставит в Доставка признак Отвечено (ОтветДоставкиДан): сбой после этого второй ответ не отправляет.
//
// Параметры:
//  Результат - Структура - ответ транспорта: для rest КодОтвета и Тело, для mcp результат tools/call
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE; сюда добавляется Отвечено
//
&НаКлиенте
Процедура ОтправитьОтветСтрогогоРежима(Результат, Доставка)

	Доставка.Вставить("Отвечено", Истина);

	Если Доставка.Режим = "rest" Тогда

		КомпонентаSendResponse(Доставка.ДанныеЗапроса.id, Результат.КодОтвета, ЗаголовкиJSON(), Результат.Тело);

		Возврат;

	КонецЕсли;

	ОтветJSON = СформироватьJSONRPCОтвет(Доставка.Ид, Результат);

	Если ЗначениеЗаполнено(Доставка.ИдПотокаSSE) Тогда

		КомпонентаSendSSEEvent(Доставка.ИдПотокаSSE, ОтветJSON, "{}", "message");

	Иначе

		ОтправитьSSEОтвет(Доставка.ДанныеЗапроса, ОтветJSON);

	КонецЕсли;

КонецПроцедуры

// Результат tools/call с ошибкой строгого режима: JSON с кодом ошибки, как application-level ошибка (без isError).
//
// Параметры:
//  Ошибка - Структура - результат ОшибкаСтрогогоРежима
//
// Возвращаемое значение:
//  Структура - результат tools/call (content)
//
&НаКлиенте
Функция ОтветОшибкиСтрогогоMCP(Ошибка)

	Элемент = Новый Структура("type, text", "text", ЗаписатьJSON2(Ошибка));
	Содержимое = Новый Массив;
	Содержимое.Добавить(Элемент);

	Возврат Новый Структура("content", Содержимое);

КонецФункции

// REST-ответ с ошибкой строгого режима: 400 для E_TOOL_* и E_PARAM_*, 403 для E_GATE_*, 503 для неактивного режима,
// 500 для необработанного исключения выполнения (E_EXECUTION).
//
// Параметры:
//  Ошибка - Структура - результат ОшибкаСтрогогоРежима
//
// Возвращаемое значение:
//  Структура - КодОтвета (Число), Тело (Строка)
//
&НаКлиенте
Функция ОтветОшибкиСтрогогоREST(Ошибка)

	КодОтвета = 400;

	Если Лев(Ошибка.error_code, 7) = "E_GATE_" Тогда

		КодОтвета = 403;

	ИначеЕсли Ошибка.error_code = "E_STRICT_INACTIVE" Или Ошибка.error_code = "E_EPOCH_CHANGED" Тогда

		КодОтвета = 503;

	ИначеЕсли Ошибка.error_code = "E_EXECUTION" Тогда

		КодОтвета = 500;

	КонецЕсли;

	Возврат Новый Структура("КодОтвета, Тело", КодОтвета, ЗаписатьJSON2(Ошибка));

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: КОНТРАКТ ПАРАМЕТРОВ ИНСТРУМЕНТОВ
// ─────────────────────────────────────────────────────────────────────────────────

// Контракт параметров инструмента для строгого режима: имя параметра -> класс.
// Классы: data, structural, control, openid, opaque, code, lookup. Ключ, которого нет в контракте, отклоняется
// (E_PARAM_UNKNOWN). Ключ channel в контракт не входит: встроенный сервер не имеет транспортных ключей.
// Имена сверяются дословно, с учетом регистра. Инструмент без параметров дает пустой контракт.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
// Возвращаемое значение:
//  Соответствие - ключ: имя параметра (Строка); значение: класс параметра (Строка)
//
&НаКлиенте
Функция КонтрактПараметровИнструмента(ИмяИнструмента)

	Контракт = Новый Соответствие;
	ДобавитьКонтрактЗапросовИКода(Контракт, ИмяИнструмента);
	ДобавитьКонтрактМетаданныхИЖурнала(Контракт, ИмяИнструмента);
	ДобавитьКонтрактСсылочныхИнструментов(Контракт, ИмяИнструмента);
	ДобавитьКонтрактСлужебныхИнструментов(Контракт, ИмяИнструмента);

	Возврат Контракт;

КонецФункции

// Добавляет в контракт параметры execute_query и execute_code. justification - необязательный текст клиента
// для шлюза подтверждения: он никогда не деанонимизируется.
//
// Параметры:
//  Контракт - Соответствие - заполняемый контракт (имя параметра -> класс)
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
&НаКлиенте
Процедура ДобавитьКонтрактЗапросовИКода(Контракт, ИмяИнструмента)

	Если ИмяИнструмента = "execute_query" Тогда

		ДобавитьКлассПараметров(Контракт, "query", "code");
		ДобавитьКлассПараметров(Контракт, "params", "data");
		ДобавитьКлассПараметров(Контракт, "limit,include_schema", "control");
		ДобавитьКлассПараметров(Контракт, "justification", "opaque");

	ИначеЕсли ИмяИнструмента = "execute_code" Тогда

		ДобавитьКлассПараметров(Контракт, "code", "code");
		ДобавитьКлассПараметров(Контракт, "execution_context", "control");
		ДобавитьКлассПараметров(Контракт, "justification", "opaque");

	Иначе

		// Остальные инструменты обрабатываются другими процедурами контракта.

	КонецЕсли;

КонецПроцедуры

// Добавляет в контракт параметры get_metadata и get_event_log (по схемам СхемаGetMetadata и СхемаGetEventLog).
//
// Параметры:
//  Контракт - Соответствие - заполняемый контракт (имя параметра -> класс)
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
&НаКлиенте
Процедура ДобавитьКонтрактМетаданныхИЖурнала(Контракт, ИмяИнструмента)

	Если ИмяИнструмента = "get_metadata" Тогда

		ДобавитьКлассПараметров(Контракт, "filter,meta_type,name_mask,attribute_mask,sections,extension_name",
			"structural");
		ДобавитьКлассПараметров(Контракт, "limit,offset,types_limit,types_offset", "control");

	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда

		ДобавитьКлассПараметров(Контракт, "start_date,end_date,same_second_offset,limit,session,application",
			"control");
		ДобавитьКлассПараметров(Контракт, "levels,transaction_status,metadata_type", "structural");
		ДобавитьКлассПараметров(Контракт, "events,user,computer,comment_contains", "lookup");
		ДобавитьКлассПараметров(Контракт, "object_description,link,data", "openid");

	Иначе

		// Остальные инструменты обрабатываются другими процедурами контракта.

	КонецЕсли;

КонецПроцедуры

// Добавляет в контракт параметры инструментов, работающих со ссылками и правами.
//
// Параметры:
//  Контракт - Соответствие - заполняемый контракт (имя параметра -> класс)
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
&НаКлиенте
Процедура ДобавитьКонтрактСсылочныхИнструментов(Контракт, ИмяИнструмента)

	Если ИмяИнструмента = "get_object_by_link" Тогда

		ДобавитьКлассПараметров(Контракт, "link", "openid");

	ИначеЕсли ИмяИнструмента = "get_link_of_object" Тогда

		ДобавитьКлассПараметров(Контракт, "object_description", "openid");

	ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда

		ДобавитьКлассПараметров(Контракт, "target_object_description", "openid");
		ДобавитьКлассПараметров(Контракт, "search_scope,meta_filter", "structural");
		ДобавитьКлассПараметров(Контракт, "limit_hits,limit_per_meta,timeout_budget_sec", "control");

	ИначеЕсли ИмяИнструмента = "get_access_rights" Тогда

		ДобавитьКлассПараметров(Контракт, "metadata_object,rights_filter,roles_filter", "structural");
		ДобавитьКлассПараметров(Контракт, "user_name", "lookup");

	Иначе

		// Остальные инструменты обрабатываются другими процедурами контракта.

	КонецЕсли;

КонецПроцедуры

// Добавляет в контракт параметры служебных инструментов. restart_1c_session и close_1c_session параметров не имеют.
// get_screenshot: form_name и page_name - имена элементов метаданных, link - ссылка (формат и тип проверяются
// по метаданным), остальное - числа, булево и прямоугольники. Токены во всех трех селекторах отклоняются.
//
// Параметры:
//  Контракт - Соответствие - заполняемый контракт (имя параметра -> класс)
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
&НаКлиенте
Процедура ДобавитьКонтрактСлужебныхИнструментов(Контракт, ИмяИнструмента)

	Если ИмяИнструмента = "get_bsl_syntax_help" Тогда

		ДобавитьКлассПараметров(Контракт, "keywords", "opaque");
		ДобавитьКлассПараметров(Контракт, "match,limit,offset,content_page", "control");

	ИначеЕсли ИмяИнструмента = "submit_for_deanonymization" Тогда

		ДобавитьКлассПараметров(Контракт, "text", "data");

	ИначеЕсли ИмяИнструмента = "get_screenshot" Тогда

		ДобавитьКлассПараметров(Контракт, "form_name,page_name", "structural");
		ДобавитьКлассПараметров(Контракт, "link", "openid");
		ДобавитьКлассПараметров(Контракт, "scale_percent,show_grid,region,highlight_rects", "control");

	Иначе

		// Остальные инструменты обрабатываются другими процедурами контракта.

	КонецЕсли;

КонецПроцедуры

// Записывает в контракт класс для перечисленных имен параметров.
//
// Параметры:
//  Контракт - Соответствие - заполняемый контракт (имя параметра -> класс)
//  Имена - Строка - имена параметров через запятую, без пробелов
//  Класс - Строка - класс параметров (data, structural, control, openid, opaque, code, lookup)
//
&НаКлиенте
Процедура ДобавитьКлассПараметров(Контракт, Имена, Класс)

	Для Каждого Имя Из РазбитьИменаКонтракта(Имена) Цикл

		Контракт.Вставить(Имя, Класс);

	КонецЦикла;

КонецПроцедуры

// Разбивает строку имен через запятую на массив. Клиентская замена РазделитьСтрокуПоРазделителю:
// та процедура серверная, а контракт читается на каждом вызове и не должен давать серверный вызов.
//
// Параметры:
//  Имена - Строка - имена через запятую
//
// Возвращаемое значение:
//  Массив - имена (Строка)
//
&НаКлиенте
Функция РазбитьИменаКонтракта(Имена)

	Результат = Новый Массив;
	Остаток = Имена;
	Позиция = Найти(Остаток, ",");

	Пока Позиция > 0 Цикл

		Результат.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + 1);
		Позиция = Найти(Остаток, ",");

	КонецЦикла;

	Результат.Добавить(Остаток);

	Возврат Результат;

КонецФункции

// Имена параметров инструмента, значение которых по схеме - массив. Только они могут повторяться в query REST GET.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента из реестра
//
// Возвращаемое значение:
//  Строка - имена через запятую; пустая строка, если у инструмента нет списочных параметров
//
&НаКлиенте
Функция ИменаСписочныхПараметров(ИмяИнструмента)

	Если ИмяИнструмента = "get_metadata" Тогда

		Возврат "meta_type,sections";

	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда

		Возврат "levels,events,metadata_type,user,session,application";

	ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда

		Возврат "search_scope";

	ИначеЕсли ИмяИнструмента = "get_access_rights" Тогда

		Возврат "rights_filter,roles_filter";

	ИначеЕсли ИмяИнструмента = "get_bsl_syntax_help" Тогда

		Возврат "keywords";

	Иначе

		Возврат "";

	КонецЕсли;

КонецФункции

// Признак списочного параметра инструмента (значение по схеме - массив).
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента из реестра
//  ИмяПараметра - Строка - имя параметра
//
// Возвращаемое значение:
//  Булево - Истина, если параметр списочный
//
&НаКлиенте
Функция ЭтоСписочныйПараметрКонтракта(ИмяИнструмента, ИмяПараметра)

	Для Каждого Имя Из РазбитьИменаКонтракта(ИменаСписочныхПараметров(ИмяИнструмента)) Цикл

		Если Имя = ИмяПараметра Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Повторяющийся ключ query REST GET допустим только для списочных параметров контракта. Ключи вне контракта
// здесь не рассматриваются: их отклоняет проверка ключей по контракту.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента из реестра
//  RESTПараметры - Структура - параметры, прочитанные из query
//
// Возвращаемое значение:
//  Строка - E_PARAM_FORMAT, если повторен ключ неспискового параметра; пустая строка в противном случае
//
&НаКлиенте
Функция КодОшибкиПовторныхКлючейREST(ИмяИнструмента, RESTПараметры)

	Контракт = КонтрактПараметровИнструмента(ИмяИнструмента);

	Для Каждого Элемент Из RESTПараметры Цикл

		Если Контракт.Получить(Элемент.Ключ) <> Неопределено И ТипЗнч(Элемент.Значение) = Тип("Массив")
			И НЕ ЭтоСписочныйПараметрКонтракта(ИмяИнструмента, Элемент.Ключ) Тогда

			Возврат "E_PARAM_FORMAT";

		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Признак ключа в query REST-запроса (точное совпадение с учетом регистра).
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  Ключ - Строка - искомый ключ
//
// Возвращаемое значение:
//  Булево - Истина, если ключ есть в query
//
&НаКлиенте
Функция ЕстьКлючВQueryREST(ДанныеЗапроса, Ключ)

	Запрос = Неопределено;
	ДанныеЗапроса.Свойство("query", Запрос);

	Если ТипЗнч(Запрос) <> Тип("Соответствие") И ТипЗнч(Запрос) <> Тип("Структура") Тогда

		Возврат Ложь;

	КонецЕсли;

	Для Каждого Элемент Из Запрос Цикл

		Если Элемент.Ключ = Ключ Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ТОКЕНЫ В ПАРАМЕТРАХ
// ─────────────────────────────────────────────────────────────────────────────────

// Применяет контракт параметров к вызову строгого режима. Заменяет унаследованную деанонимизацию: тип каждого
// параметра решает, что можно сделать с токеном. Неизвестный ключ - E_PARAM_UNKNOWN; токен в структурной,
// управляющей или открытой (openid) позиции - E_PARAM_TOKEN_STRUCTURAL; значение data / lookup из одного токена
// заменяется реальным значением, токен внутри длинной строки остается текстом. Токены текста кода и запроса
// не подставляются в текст: они собираются в Вызов.Токены и Вызов.ЗначенияТокенов и дальше привязываются
// как параметры запроса или значения кода (ПривязатьТокеныЗапроса).
// Дополняет Вызов полями: ПараметрОшибки (Строка), Происхождение (Соответствие: имя параметра -> client,
// token_protected, token_unknown), Токены (Соответствие: токен -> Структура(index, origin)),
// ЗначенияТокенов (Массив реальных значений по index). Вызов.Аргументы заменяется новой структурой.
//
// Параметры:
//  Вызов - Структура - результат РазрешитьКаноническийВызов без ошибки (Имя, Аргументы, Транспорт, Эпоха)
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция ПрименитьКонтрактПараметров(Вызов)

	Вызов.Вставить("ПараметрОшибки", "");
	Вызов.Вставить("Происхождение", Новый Соответствие);
	Вызов.Вставить("Токены", Новый Соответствие);
	Вызов.Вставить("ЗначенияТокенов", Новый Массив);

	Если ТипЗнч(Вызов.Аргументы) <> Тип("Структура") Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Контракт = КонтрактПараметровИнструмента(Вызов.Имя);

	Если ЕстьПараметрВнеКонтракта(Вызов.Аргументы, Контракт) Тогда

		Возврат "E_PARAM_UNKNOWN";

	КонецЕсли;

	НовыеАргументы = Новый Структура;

	Для Каждого Элемент Из Вызов.Аргументы Цикл

		Разбор = РазобратьПараметрПоКлассу(Вызов, Элемент.Ключ, Элемент.Значение, Контракт.Получить(Элемент.Ключ));

		Если НЕ ПустаяСтрока(Разбор.Код) Тогда

			Вызов.ПараметрОшибки = Элемент.Ключ;

			Возврат Разбор.Код;

		КонецЕсли;

		НовыеАргументы.Вставить(Элемент.Ключ, Разбор.Значение);

	КонецЦикла;

	Вызов.Аргументы = НовыеАргументы;

	Возврат "";

КонецФункции

// Признак ключа аргументов, которого нет в контракте. Ключи сверяются дословно, с учетом регистра.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова
//  Контракт - Соответствие - контракт инструмента (имя параметра -> класс)
//
// Возвращаемое значение:
//  Булево - Истина, если есть ключ вне контракта
//
&НаКлиенте
Функция ЕстьПараметрВнеКонтракта(Аргументы, Контракт)

	Для Каждого Элемент Из Аргументы Цикл

		Если Контракт.Получить(Элемент.Ключ) = Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Разбор одного параметра по его классу контракта.
//
// Параметры:
//  Вызов - Структура - вызов; в него собираются токены кода и происхождение данных
//  Ключ - Строка - имя параметра
//  Значение - Произвольный - значение параметра, как его прислал клиент
//  Класс - Строка - класс параметра (data, structural, control, openid, opaque, code, lookup)
//
// Возвращаемое значение:
//  Структура - Код (Строка, код ошибки или пустая строка), Значение (значение для выполнения)
//
&НаКлиенте
Функция РазобратьПараметрПоКлассу(Вызов, Ключ, Значение, Класс)

	Результат = Новый Структура("Код, Значение", "", Значение);

	Если Класс = "opaque" Тогда

		Возврат Результат;

	ИначеЕсли Класс = "structural" Или Класс = "control" Тогда

		Результат.Код = КодОшибкиТокеновВЗначении(Значение, 0);

	ИначеЕсли Класс = "openid" Тогда

		Результат.Код = КодОшибкиОткрытогоИдентификатора(Ключ, Значение);

	ИначеЕсли Класс = "code" Тогда

		Результат.Код = СобратьТокеныКода(Вызов, Значение);

	ИначеЕсли Класс = "data" Или Класс = "lookup" Тогда

		РазобратьДанныйПараметр(Вызов, Ключ, Значение, Результат);

	Иначе

		Результат.Код = "E_PARAM_UNKNOWN";

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверка значения на токены в любой строке, включая элементы массивов и ключи и значения вложенных структур.
// Токеном считается любая подстрока формата [КАТЕГОРИЯ-NNNNN], независимо от того, выдан ли он.
//
// Параметры:
//  Значение - Произвольный - значение параметра
//  Глубина - Число - текущая глубина вложенности
//
// Возвращаемое значение:
//  Строка - E_PARAM_TOKEN_STRUCTURAL при найденном токене, E_PARAM_FORMAT при слишком глубокой вложенности,
//   иначе пустая строка
//
&НаКлиенте
Функция КодОшибкиТокеновВЗначении(Значение, Глубина)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда

		Возврат ?(НайтиТокеныВТексте(Значение, Истина).Количество() > 0, "E_PARAM_TOKEN_STRUCTURAL", "");

	ИначеЕсли ТипЗначения <> Тип("Массив") И ТипЗначения <> Тип("Структура") И ТипЗначения <> Тип("Соответствие") Тогда

		Возврат "";

	ИначеЕсли Глубина > 16 Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Для Каждого Элемент Из Значение Цикл

		Код = КодОшибкиТокеновВЭлементе(Элемент, ТипЗначения = Тип("Массив"), Глубина);

		Если НЕ ПустаяСтрока(Код) Тогда

			Возврат Код;

		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Проверка одного элемента коллекции на токены: для массива - сам элемент, для структуры и соответствия -
// ключ и значение.
//
// Параметры:
//  Элемент - Произвольный - элемент массива или КлючИЗначение
//  ЭтоМассив - Булево - Истина, если коллекция - массив
//  Глубина - Число - глубина вложенности коллекции
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция КодОшибкиТокеновВЭлементе(Элемент, ЭтоМассив, Глубина)

	Если ЭтоМассив Тогда

		Возврат КодОшибкиТокеновВЗначении(Элемент, Глубина + 1);

	КонецЕсли;

	Код = КодОшибкиТокеновВЗначении(Элемент.Ключ, Глубина + 1);

	Если НЕ ПустаяСтрока(Код) Тогда

		Возврат Код;

	КонецЕсли;

	Возврат КодОшибкиТокеновВЗначении(Элемент.Значение, Глубина + 1);

КонецФункции

// Параметр открытого идентификатора (ссылка, описание объекта): токен отклоняется до любого разбора,
// затем проверяется тип. link и data - строка; описание объекта - структура.
//
// Параметры:
//  Ключ - Строка - имя параметра
//  Значение - Произвольный - значение параметра
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция КодОшибкиОткрытогоИдентификатора(Ключ, Значение)

	Код = КодОшибкиТокеновВЗначении(Значение, 0);

	Если НЕ ПустаяСтрока(Код) Или Значение = Неопределено Тогда

		Возврат Код;

	КонецЕсли;

	Если (Ключ = "link" Или Ключ = "data") И ТипЗнч(Значение) <> Тип("Строка") Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Если Найти(Ключ, "object_description") > 0 И ТипЗнч(Значение) <> Тип("Структура")
		И ТипЗнч(Значение) <> Тип("Соответствие") Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	Возврат "";

КонецФункции

// Токены в тексте запроса или кода. Выданные токены попадают в Вызов.Токены (токен -> index, origin) и
// Вызов.ЗначенияТокенов (реальное значение по index). origin - protected, если токен выдан из защищенного источника
// (ПроисхождениеТокенов), иначе unknown. Токен, которого нет в карте, остается обычным текстом.
// Ключ таблицы - ВРег токена: написания одного токена в разном регистре дают одну запись и один index.
// Реальные значения в компоненту проверки не передаются и в текст не подставляются.
//
// Параметры:
//  Вызов - Структура - вызов с полями Токены и ЗначенияТокенов
//  Текст - Произвольный - текст запроса или кода
//
// Возвращаемое значение:
//  Строка - E_PARAM_FORMAT, если текст не строка; иначе пустая строка
//
&НаКлиенте
Функция СобратьТокеныКода(Вызов, Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда

		Возврат "E_PARAM_FORMAT";

	КонецЕсли;

	АнонимизаторИнициализировать();

	Для Каждого Токен Из ТокеныВТексте(Текст) Цикл

		КлючТокена = ВРег(Токен);
		ЗначениеТокена = МаппингДеанонимизации.Получить(КлючТокена);

		Если ЗначениеТокена = Неопределено Или Вызов.Токены.Получить(КлючТокена) <> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		Происхождение = ?(ПроисхождениеТокена(Токен) = "protected", "protected", "unknown");
		Индекс = Вызов.ЗначенияТокенов.Количество();
		Вызов.Токены.Вставить(КлючТокена, Новый Структура("index, origin", Индекс, Происхождение));
		Вызов.ЗначенияТокенов.Добавить(ЗначениеТокена);

	КонецЦикла;

	Возврат "";

КонецФункции

// Различные токены формата [КАТЕГОРИЯ-NNNNN] в тексте, в порядке появления. Токен рядом со скобкой
// ("[[STR-00001]") находится, как и токен внутри длинной строки.
//
// Параметры:
//  Текст - Строка - текст запроса или кода
//
// Возвращаемое значение:
//  Массив - токены (Строка) без повторов
//
&НаКлиенте
Функция ТокеныВТексте(Текст)

	Возврат НайтиТокеныВТексте(Текст, Ложь);

КонецФункции

// Поиск токенов формата [КАТЕГОРИЯ-NNNNN] в тексте. Для каждой открывающей скобки ищется ближайшая
// закрывающая в пределах 256 символов. Кандидат - токен, если он в формате токена или (отказ в сторону защиты)
// его ВРег является ключом карты МаппингДеанонимизации. Потребители сверяют токены без учета регистра (ВРег).
//
// Параметры:
//  Текст - Произвольный - текст; не строка дает пустой результат
//  ТолькоПервый - Булево - остановиться на первом найденном токене
//
// Возвращаемое значение:
//  Массив - различные токены (Строка) в порядке появления
//
&НаКлиенте
Функция НайтиТокеныВТексте(Текст, ТолькоПервый)

	Результат = Новый Массив;

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда

		Возврат Результат;

	КонецЕсли;

	АнонимизаторИнициализировать();
	Найденные = Новый Соответствие;
	Остаток = Текст;
	Позиция = Найти(Остаток, "[");

	Пока Позиция > 0 Цикл

		Остаток = Сред(Остаток, Позиция);
		Фрагмент = Лев(Остаток, 256);
		Закрывающая = Найти(Фрагмент, "]");
		Кандидат = ?(Закрывающая > 0, Лев(Фрагмент, Закрывающая), "");

		Если Закрывающая > 0 И Найденные.Получить(Кандидат) = Неопределено
			И (ЭтоВалидныйТокенФормат(Кандидат) Или МаппингДеанонимизации.Получить(ВРег(Кандидат)) <> Неопределено) Тогда

			Найденные.Вставить(Кандидат, Истина);
			Результат.Добавить(Кандидат);

			Если ТолькоПервый Тогда

				Возврат Результат;

			КонецЕсли;

		КонецЕсли;

		Остаток = Сред(Остаток, 2);
		Позиция = Найти(Остаток, "[");

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметр класса data или lookup. Для execute_query.params разбирается каждое значение отдельно.
//
// Параметры:
//  Вызов - Структура - вызов; в Происхождение записывается происхождение параметра
//  Ключ - Строка - имя параметра
//  Значение - Произвольный - значение параметра
//  Результат - Структура - Код и Значение разбора параметра; изменяется
//
&НаКлиенте
Процедура РазобратьДанныйПараметр(Вызов, Ключ, Значение, Результат)

	Если Вызов.Имя = "execute_query" И Ключ = "params" Тогда

		РазобратьПараметрыЗапроса(Вызов, Значение, Результат);

		Возврат;

	КонецЕсли;

	Разбор = РазобратьЗначениеДанных(Значение);
	Результат.Код = Разбор.Код;
	Результат.Значение = Разбор.Значение;
	Вызов.Происхождение.Вставить(Ключ, Разбор.Происхождение);

КонецПроцедуры

// Параметры запроса (execute_query.params): имя, зарезервированное для привязанных токенов (МСПТокен...),
// отклоняется без учета регистра - иначе значение клиента встало бы на место проверенного токена.
// Два имени, совпадающих после ВРег, тоже отклоняются: имена параметров запроса регистронезависимы, и какое
// из значений попадет в запрос, решал бы порядок обхода.
// Имя вне алфавита идентификатора запроса (пробел, невидимый символ, похожая буква другого алфавита) тоже
// отклоняется: после усечения или приведения платформой оно могло бы совпасть с другим именем.
// Значение из одного токена заменяется реальным, его происхождение записывается под именем параметра.
//
// Параметры:
//  Вызов - Структура - вызов; в Происхождение записывается происхождение каждого параметра запроса
//  Параметры - Структура, Соответствие, Неопределено - параметры запроса
//  Результат - Структура - Код и Значение разбора параметра; изменяется
//
&НаКлиенте
Процедура РазобратьПараметрыЗапроса(Вызов, Параметры, Результат)

	Если Параметры = Неопределено Тогда

		Возврат;

	ИначеЕсли ТипЗнч(Параметры) <> Тип("Структура") И ТипЗнч(Параметры) <> Тип("Соответствие") Тогда

		Результат.Код = "E_PARAM_FORMAT";

		Возврат;

	ИначеЕсли ЕстьЗапрещенноеИмяПараметраЗапроса(Параметры) Тогда

		Результат.Код = "E_PARAM_INTERNAL";

		Возврат;

	КонецЕсли;

	НовыеПараметры = ?(ТипЗнч(Параметры) = Тип("Структура"), Новый Структура, Новый Соответствие);

	Для Каждого Элемент Из Параметры Цикл

		Разбор = РазобратьЗначениеДанных(Элемент.Значение);

		Если НЕ ПустаяСтрока(Разбор.Код) Тогда

			Результат.Код = Разбор.Код;

			Возврат;

		КонецЕсли;

		НовыеПараметры.Вставить(Элемент.Ключ, Разбор.Значение);
		Вызов.Происхождение.Вставить(Строка(Элемент.Ключ), Разбор.Происхождение);

	КонецЦикла;

	Результат.Значение = НовыеПараметры;

КонецПроцедуры

// Признак зарезервированного имени привязанного токена (МСПТокен...) среди ключей параметров запроса.
// Имена параметров запроса регистронезависимы, поэтому ВРег.
//
// Параметры:
//  Параметры - Структура, Соответствие - параметры запроса
//
// Возвращаемое значение:
//  Булево - Истина, если есть ключ, начинающийся с МСПТокен
//
&НаКлиенте
Функция ЕстьЗарезервированноеИмяПараметра(Параметры)

	Для Каждого Элемент Из Параметры Цикл

		Если ВРег(Лев(Строка(Элемент.Ключ), 8)) = "МСПТОКЕН" Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Признак двух ключей параметров запроса, совпадающих после ВРег (например "пар" и "Пар"). Такие ключи
// сохраняет только Соответствие. Ключи, различающиеся только буквой Е и ее вариантом с двумя точками (код 1025),
// тоже считаются совпадающими независимо от того, различает ли их платформа, - это защита в глубину.
//
// Параметры:
//  Параметры - Структура, Соответствие - параметры запроса
//
// Возвращаемое значение:
//  Булево - Истина, если есть ключи, различающиеся только регистром
//
&НаКлиенте
Функция ЕстьИменаПараметровРазличающиесяРегистром(Параметры)

	Имена = Новый Соответствие;
	БукваЕСТочками = Символ(1025);
	БукваЕ = Символ(1045);

	Для Каждого Элемент Из Параметры Цикл

		Имя = СтрЗаменить(ВРег(Строка(Элемент.Ключ)), БукваЕСТочками, БукваЕ);

		Если Имена.Получить(Имя) <> Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

		Имена.Вставить(Имя, Истина);

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Признак ключа параметров запроса, который не является идентификатором запроса (см. ЭтоИдентификаторЗапроса).
//
// Параметры:
//  Параметры - Структура, Соответствие - параметры запроса
//
// Возвращаемое значение:
//  Булево - Истина, если есть пустой ключ или ключ с символом вне алфавита идентификатора
//
&НаКлиенте
Функция ЕстьНедопустимоеИмяПараметра(Параметры)

	Для Каждого Элемент Из Параметры Цикл

		Если НЕ ЭтоИдентификаторЗапроса(Строка(Элемент.Ключ)) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Признак запрещенного набора имен параметров запроса: зарезервированное имя токена, имена, различающиеся
// только регистром, или имя вне алфавита идентификатора. Общее правило для разобранных параметров и для
// сырых имен из текста JSON (см. КодОшибкиСырогоТелаСтрогий).
//
// Параметры:
//  Параметры - Структура, Соответствие - параметры запроса
//
// Возвращаемое значение:
//  Булево - Истина, если набор имен недопустим
//
&НаКлиенте
Функция ЕстьЗапрещенноеИмяПараметраЗапроса(Параметры)

	Возврат ЕстьЗарезервированноеИмяПараметра(Параметры) Или ЕстьИменаПараметровРазличающиесяРегистром(Параметры)
		Или ЕстьНедопустимоеИмяПараметра(Параметры);

КонецФункции

// Признак имени, которое лексер запроса принимает после &: первый символ - латинская буква A-Z, a-z,
// русская буква (коды 1040-1103, 1025, 1105) или подчеркивание; следующие - те же символы или цифры 0-9.
// Пробелы, невидимые и прочие символы Unicode не допускаются.
//
// Параметры:
//  Имя - Строка - проверяемое имя
//
// Возвращаемое значение:
//  Булево - Истина, если имя непустое и состоит только из символов алфавита идентификатора
//
&НаКлиенте
Функция ЭтоИдентификаторЗапроса(Имя)

	Длина = СтрДлина(Имя);

	Если Длина = 0 Тогда

		Возврат Ложь;

	КонецЕсли;

	Для Позиция = 1 По Длина Цикл

		Код = КодСимвола(Имя, Позиция);
		ЭтоБуква = (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122) Или Код = 95 // A-Z, a-z, _
			Или (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105; // А-я и две буквы с двумя точками
		ЭтоЦифра = Позиция > 1 И Код >= 48 И Код <= 57; // 0-9

		Если НЕ ЭтоБуква И НЕ ЭтоЦифра Тогда

			Возврат Ложь;

		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Значение параметра data / lookup: скаляр или массив скаляров. Происхождение массива - худшее из происхождений
// элементов: client, если есть обычное значение клиента; иначе token_unknown, если есть токен без защищенного
// происхождения; иначе token_protected.
//
// Параметры:
//  Значение - Произвольный - значение параметра
//
// Возвращаемое значение:
//  Структура - Код (код ошибки или пустая строка), Значение (реальное значение), Происхождение (Строка)
//
&НаКлиенте
Функция РазобратьЗначениеДанных(Значение)

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда

		Возврат РазобратьСкалярДанных(Значение);

	КонецЕсли;

	Итог = Новый Структура("Код, Значение, Происхождение", "", Новый Массив, "client");
	Происхождения = Новый Соответствие;

	Для Каждого Элемент Из Значение Цикл

		Часть = РазобратьСкалярДанных(Элемент);

		Если НЕ ПустаяСтрока(Часть.Код) Тогда

			Возврат Часть;

		КонецЕсли;

		Итог.Значение.Добавить(Часть.Значение);
		Происхождения.Вставить(Часть.Происхождение, Истина);

	КонецЦикла;

	Если Происхождения.Получить("client") = Неопределено И Происхождения.Получить("token_unknown") <> Неопределено Тогда

		Итог.Происхождение = "token_unknown";

	ИначеЕсли Происхождения.Получить("client") = Неопределено И Происхождения.Получить("token_protected") <> Неопределено Тогда

		Итог.Происхождение = "token_protected";

	КонецЕсли;

	Возврат Итог;

КонецФункции

// Скалярное значение data / lookup. Значение из одного токена заменяется реальным значением из карты;
// токен внутри длинной строки и любое другое значение остаются как есть с происхождением client.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Структура - Код (E_TOKEN_UNKNOWN для токена, которого нет в карте), Значение, Происхождение
//   (client, token_protected или token_unknown)
//
&НаКлиенте
Функция РазобратьСкалярДанных(Значение)

	Результат = Новый Структура("Код, Значение, Происхождение", "", Значение, "client");

	Если ТипЗнч(Значение) <> Тип("Строка") Или НЕ ЭтоВалидныйТокенФормат(Значение) Тогда

		Возврат Результат;

	КонецЕсли;

	АнонимизаторИнициализировать();
	РеальноеЗначение = МаппингДеанонимизации.Получить(ВРег(Значение));

	Если РеальноеЗначение = Неопределено Тогда

		Результат.Код = "E_TOKEN_UNKNOWN";

		Возврат Результат;

	КонецЕсли;

	Результат.Значение = РеальноеЗначение;
	Результат.Происхождение = ?(ПроисхождениеТокена(Значение) = "protected", "token_protected",
		"token_unknown");

	Возврат Результат;

КонецФункции

// Привязка токенов кода к серверной команде после безопасного вердикта или подтверждения шлюза.
// execute_query: значение каждого токена из таблицы проверки передается параметром запроса МСПТокен<index+1>
// (ИмяПараметраТокена);
// execute_code: все значения передаются массивом mcp_bound_values (в коде - МСПЗначенияТокенов[<index>]).
// Текст с этими ссылками формирует компонента проверки. Ключ назначения, уже занятый клиентом, - E_PARAM_INTERNAL.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров; Аргументы дополняются
//  ТокеныПроверки - Соответствие - токены, переданные в проверку (токен -> Структура(index, origin))
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция ПривязатьТокеныЗапроса(Вызов, ТокеныПроверки)

	Если Вызов.ЗначенияТокенов.Количество() = 0 Тогда

		Возврат "";

	ИначеЕсли Вызов.Имя = "execute_code" Тогда

		Если Вызов.Аргументы.Свойство("mcp_bound_values") Тогда

			Возврат "E_PARAM_INTERNAL";

		КонецЕсли;

		Вызов.Аргументы.Вставить("mcp_bound_values", Вызов.ЗначенияТокенов);

		Возврат "";

	ИначеЕсли Вызов.Имя = "execute_query" Тогда

		Возврат ПривязатьТокеныКПараметрамЗапроса(Вызов, ТокеныПроверки);

	КонецЕсли;

	Возврат "";

КонецФункции

// Привязка токенов к параметрам execute_query: добавляет МСПТокен<index+1> (ИмяПараметраТокена) в params.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров; Аргументы дополняются
//  ТокеныПроверки - Соответствие - токены, переданные в проверку (токен -> Структура(index, origin))
//
// Возвращаемое значение:
//  Строка - код ошибки (E_...) или пустая строка
//
&НаКлиенте
Функция ПривязатьТокеныКПараметрамЗапроса(Вызов, ТокеныПроверки)

	ПараметрыЗапроса = Неопределено;
	Вызов.Аргументы.Свойство("params", ПараметрыЗапроса);

	Если ПараметрыЗапроса = Неопределено Тогда

		ПараметрыЗапроса = Новый Структура;
		Вызов.Аргументы.Вставить("params", ПараметрыЗапроса);

	КонецЕсли;

	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") И ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие") Тогда

		Возврат "E_PARAM_FORMAT";

	ИначеЕсли ЕстьЗарезервированноеИмяПараметра(ПараметрыЗапроса) Тогда

		Возврат "E_PARAM_INTERNAL";

	КонецЕсли;

	Для Каждого Элемент Из ТокеныПроверки Цикл

		Индекс = Элемент.Значение.index;
		ПараметрыЗапроса.Вставить(ИмяПараметраТокена(Индекс), Вызов.ЗначенияТокенов[Индекс]);

	КонецЦикла;

	Возврат "";

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ВСТРОЕННЫЕ ПОИСКИ
// ─────────────────────────────────────────────────────────────────────────────────

// Статический вердикт встроенных поисков инструмента. Поиск по защищенным данным, ключ которого пришел от клиента,
// сам является ответом ("найдено / не найдено"), поэтому автоматически проходит только поиск по выданному токену
// защищенного источника с простым сравнением. Остальное - подтверждение с риском L_LOOKUP.
// Правила: comment_contains (подстрока) - всегда подтверждение; user, computer, user_name - только
// token_protected; user, похожий на УИД, - подтверждение (преобразование значения); events - токен или
// идентификаторы из СтандартныеСобытияЖурнала; get_object_by_link с ключом внешнего источника - подтверждение
// (токен в ссылке отклоняется контрактом раньше, ключ приходит только открытым текстом).
// close_1c_session - всегда подтверждение (ВердиктЗакрытияСессииСтрогогоРежима).
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров (Имя, Аргументы, Происхождение)
//
// Возвращаемое значение:
//  Структура - Решение (auto или gate), Риски (Массив кодов), ПараметрОшибки (имя первого параметра с подтверждением)
//
&НаКлиенте
Функция ВердиктВстроенныхПоисковСтрогогоРежима(Вызов)

	Вердикт = Новый Структура("Решение, Риски, ПараметрОшибки", "auto", Новый Массив, "");

	Если Вызов.Имя = "close_1c_session" Тогда

		Возврат ВердиктЗакрытияСессииСтрогогоРежима(Вердикт);

	КонецЕсли;

	Контракт = КонтрактПараметровИнструмента(Вызов.Имя);

	Для Каждого Элемент Из Вызов.Аргументы Цикл

		Если ПараметрТребуетПодтвержденияПоиска(Вызов, Контракт.Получить(Элемент.Ключ), Элемент.Ключ, Элемент.Значение) Тогда

			Вердикт.Решение = "gate";
			Вердикт.Риски.Добавить("L_LOOKUP");
			Вердикт.ПараметрОшибки = ?(ПустаяСтрока(Вердикт.ПараметрОшибки), Элемент.Ключ, Вердикт.ПараметрОшибки);

		КонецЕсли;

	КонецЦикла;

	Возврат Вердикт;

КонецФункции

// Вердикт close_1c_session: всегда подтверждение. Закрытие возвращает команду запуска, которую выполняет ИИ-клиент:
// 1С запускается под пользователем ОС ИИ-клиента, и гарантия строгого режима для сеанса заканчивается (R_RELAUNCH).
// При аутентификации паролем пароль базы (в зашифрованном виде) и часть ключа уходят на машину клиента (R_CREDENTIALS).
// Ни один файл не создается до подтверждения: все файлы пишет ВыполнитьЗакрытиеСессии после него.
//
// Параметры:
//  Вердикт - Структура - заготовка вердикта (Решение, Риски, ПараметрОшибки); дополняется
//
// Возвращаемое значение:
//  Структура - та же структура: Решение = gate, Риски - R_RELAUNCH и, при пароле, R_CREDENTIALS
//
&НаКлиенте
Функция ВердиктЗакрытияСессииСтрогогоРежима(Вердикт)

	Вердикт.Решение = "gate";
	Вердикт.Риски.Добавить("R_RELAUNCH");

	Если РежимАутентификацииПерезапуска = 1 И ЗначениеЗаполнено(ПарольПерезапуска) Тогда

		Вердикт.Риски.Добавить("R_CREDENTIALS");

	КонецЕсли;

	Возврат Вердикт;

КонецФункции

// Признак параметра, поиск по которому требует подтверждения: параметр класса lookup, не прошедший
// ПоискДопустимБезПодтверждения, или ссылка get_object_by_link на внешний источник данных.
//
// Параметры:
//  Вызов - Структура - вызов после ПрименитьКонтрактПараметров
//  Класс - Строка - класс параметра в контракте
//  Ключ - Строка - имя параметра
//  Значение - Произвольный - значение параметра
//
// Возвращаемое значение:
//  Булево - Истина, если нужно подтверждение
//
&НаКлиенте
Функция ПараметрТребуетПодтвержденияПоиска(Вызов, Класс, Ключ, Значение)

	Если Класс = "lookup" Тогда

		Возврат НЕ ПоискДопустимБезПодтверждения(Вызов, Ключ, Значение);

	КонецЕсли;

	Возврат Вызов.Имя = "get_object_by_link" И Ключ = "link" И ЭтоСсылкаВнешнегоИсточника(Значение);

КонецФункции

// Признак того, что встроенный поиск по параметру класса lookup проходит без подтверждения.
//
// Параметры:
//  Вызов - Структура - вызов; из Происхождение берется происхождение параметра
//  Ключ - Строка - имя параметра
//  Значение - Произвольный - значение параметра после ПрименитьКонтрактПараметров (токен уже заменен значением)
//
// Возвращаемое значение:
//  Булево - Истина, если подтверждение не нужно
//
&НаКлиенте
Функция ПоискДопустимБезПодтверждения(Вызов, Ключ, Значение)

	Происхождение = Вызов.Происхождение.Получить(Ключ);

	Если Значение = Неопределено Тогда

		Возврат Истина;

	ИначеЕсли Ключ = "comment_contains" Тогда

		Возврат Ложь;

	ИначеЕсли Ключ = "events" Тогда

		Возврат СобытияЖурналаДопустимыБезПодтверждения(Значение, Происхождение);

	ИначеЕсли Ключ = "user" И ЕстьЗначениеПохожееНаУИД(Значение) Тогда

		Возврат Ложь;

	КонецЕсли;

	Возврат Происхождение = "token_protected";

КонецФункции

// Фильтр по событиям журнала. Идентификаторы платформы - открытый список; произвольное имя события - данные,
// поэтому оно проходит только как токен защищенного источника. Токен неизвестного происхождения не проходит.
// Идентификатор сверяется дословно, с учетом регистра: другой регистр - это уже не идентификатор платформы.
//
// Параметры:
//  Значение - Произвольный - значение events: строка или массив строк
//  Происхождение - Строка, Неопределено - происхождение параметра (client, token_protected, token_unknown)
//
// Возвращаемое значение:
//  Булево - Истина, если подтверждение не нужно
//
&НаКлиенте
Функция СобытияЖурналаДопустимыБезПодтверждения(Значение, Происхождение)

	Если Происхождение = "token_protected" Тогда

		Возврат Истина;

	ИначеЕсли Происхождение <> "client" Тогда

		Возврат Ложь;

	КонецЕсли;

	Стандартные = СтандартныеСобытияЖурнала();
	ЭлементыЗначения = ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);

	Если ТипЗнч(Значение) = Тип("Строка") Тогда

		ЭлементыЗначения.Добавить(Значение);

	КонецЕсли;

	Для Каждого Событие Из ЭлементыЗначения Цикл

		Если ТипЗнч(Событие) <> Тип("Строка") Или Стандартные.Получить(Событие) = Неопределено Тогда

			Возврат Ложь;

		КонецЕсли;

	КонецЦикла;

	Возврат ЭлементыЗначения.Количество() > 0;

КонецФункции

// Идентификаторы стандартных событий журнала регистрации. Список открытый (документация платформы, "Представление
// события журнала регистрации" и "Выгрузить журнал регистрации"). Неполный список безопасен: пропущенный
// идентификатор уходит на подтверждение.
//
// Возвращаемое значение:
//  Соответствие - ключ: идентификатор события (Строка); значение: Истина
//
&НаКлиенте
Функция СтандартныеСобытияЖурнала()

	События = Новый Соответствие;
	ДобавитьСтандартныеСобытия(События, "_$Access$_.", "Access,AccessDenied");
	ДобавитьСтандартныеСобытия(События, "_$Data$_.", "Delete,DeletePredefinedData,DeleteVersions,New,NewPredefinedData,"
		+ "NewVersion,Post,PredefinedDataInitialization,PredefinedDataInitializationDataNotFound,"
		+ "SetPredefinedDataInitialization,SetStandardODataInterfaceContent,Unpost,Update,UpdatePredefinedData");
	ДобавитьСтандартныеСобытия(События, "_$InfoBase$_.", "ConfigUpdate,DBConfigUpdate,EventLogSettingsUpdate,"
		+ "InfoBaseAdmParamsUpdate,MasterNodeUpdate,RegionalSettingsUpdate,TARInfo,TARMess");
	ДобавитьСтандартныеСобытия(События, "_$Job$_.", "Cancel,Fail,Start,Succeed,Terminate");
	ДобавитьСтандартныеСобытия(События, "_$Session$_.", "Authentication,AuthenticationError,AuthenticationFirstFactor,"
		+ "ConfigExtensionApplyError,Finish,PasswordChangeError,Start");
	ДобавитьСтандартныеСобытия(События, "_$Transaction$_.", "Begin,Commit,Rollback");
	ДобавитьСтандартныеСобытия(События, "_$User$_.", "AuthenticationLock,Delete,DeleteError,New,NewError,Update,UpdateError");
	События.Вставить("_$PerformError$_", Истина);

	Возврат События;

КонецФункции

// Добавляет в соответствие идентификаторы событий одной группы.
//
// Параметры:
//  События - Соответствие - заполняемое соответствие идентификаторов
//  Префикс - Строка - общая часть идентификатора группы, включая точку
//  Имена - Строка - окончания идентификаторов через запятую
//
&НаКлиенте
Процедура ДобавитьСтандартныеСобытия(События, Префикс, Имена)

	Для Каждого Имя Из РазбитьИменаКонтракта(Имена) Цикл

		События.Вставить(Префикс + Имя, Истина);

	КонецЦикла;

КонецПроцедуры

// Признак значения (строки или массива строк), похожего на УИД: 36 символов с дефисами на позициях 9, 14, 19, 24.
// Поиск пользователя журнала по такому значению преобразует его в УИД, а это уже операция над значением.
//
// Параметры:
//  Значение - Произвольный - значение user: строка или массив
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одно значение похоже на УИД
//
&НаКлиенте
Функция ЕстьЗначениеПохожееНаУИД(Значение)

	ЭлементыЗначения = ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);

	Если ТипЗнч(Значение) = Тип("Строка") Тогда

		ЭлементыЗначения.Добавить(Значение);

	КонецЕсли;

	Для Каждого Элемент Из ЭлементыЗначения Цикл

		Если ТипЗнч(Элемент) = Тип("Строка") И СтрДлина(СокрЛП(Элемент)) = 36 И Сред(СокрЛП(Элемент), 9, 1) = "-"
			И Сред(СокрЛП(Элемент), 14, 1) = "-" И Сред(СокрЛП(Элемент), 19, 1) = "-"
			И Сред(СокрЛП(Элемент), 24, 1) = "-" Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Признак навигационной ссылки на запись внешнего источника данных (поиск по естественному ключу).
// Определение повторяет разбор в ObjectModule (путь до "?" начинается с "внешнийисточникданных."), без обращения
// к данным; английское имя и вхождение в любом месте ссылки тоже считаются признаком (отказ в сторону защиты).
//
// Параметры:
//  Ссылка - Произвольный - значение link
//
// Возвращаемое значение:
//  Булево - Истина, если ссылка ведет во внешний источник данных
//
&НаКлиенте
Функция ЭтоСсылкаВнешнегоИсточника(Ссылка)

	Если ТипЗнч(Ссылка) <> Тип("Строка") Тогда

		Возврат Ложь;

	КонецЕсли;

	Нижняя = НРег(Ссылка);

	Возврат Найти(Нижняя, "внешнийисточникданных") > 0 Или Найти(Нижняя, "externaldatasource") > 0;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: ЭПОХА ЗАЩИТЫ И АТОМАРНОЕ ПЕРЕКЛЮЧЕНИЕ
// ─────────────────────────────────────────────────────────────────────────────────

// Обработчик флажка строгого режима. Его вызывает только событие формы, которое порождает человек:
// ни HTTP, ни MCP этот обработчик не вызывают. Эпоха меняется только при действительной смене режима.
//
// Параметры:
//  Элемент - ПолеФормы - флажок строгого режима
//
&НаКлиенте
Процедура СтрогийРежимАнонимизацииПриИзменении(Элемент)

	Если СтрогийРежимАнонимизации И НЕ ИспользоватьТочнуюАнонимизацию Тогда

		СтрогийРежимАнонимизации = Ложь;
		Возврат;

	КонецЕсли;

	СохранитьВыборСтрогогоРежимаНаСервере(СтрогийРежимАнонимизации);

	Если СтрогийРежимАнонимизации И НЕ СостояниеЗащиты.Строгий Тогда

		ВключитьСтрогийРежимАтомарно();

	ИначеЕсли НЕ СтрогийРежимАнонимизации И СостояниеЗащиты.Строгий Тогда

		ВыключитьСтрогийРежимАтомарно();

	Иначе

		ОбновитьОтображениеСостоянияЗащиты();

	КонецЕсли;

КонецПроцедуры

// Включает сохраненный строгий режим при открытии формы, до запуска сервера. Строгий режим работает
// только с маскированием и только во встроенном сервере; сохраненный выбор при этом не меняется.
// При startup вызывается повторно, после применения режима подключения из параметра запуска.
//
// Параметры:
//  ВыборСохранен - Булево - сохраненный выбор строгого режима (ПрочитатьВыборСтрогогоРежимаНаСервере)
//
&НаКлиенте
Процедура ВключитьСохраненныйСтрогийРежим(ВыборСохранен)

	СтрогийРежимАнонимизации = ИспользоватьТочнуюАнонимизацию И РежимПодключения = 1 И ВыборСохранен;

	Если СтрогийРежимАнонимизации И НЕ СостояниеЗащиты.Строгий Тогда

		ВключитьСтрогийРежимАтомарно();

	КонецЕсли;

КонецПроцедуры

// Атомарное включение строгого режима (design: Strict epoch / Atomic switch).
// Порядок важен: прием вызовов остановлен -> ожидающие прошлой эпохи отклонены -> задания сняты ->
// кэши прошлой эпохи сброшены -> новая карта токенов -> правила защиты прочитаны один раз ->
// строгий режим активен, когда задания прошлой эпохи действительно остановлены.
//
&НаКлиенте
Процедура ВключитьСтрогийРежимАтомарно()

	ИдентификаторыЗаданий = НачатьПереключениеСтрогогоРежима();
	СнимокПравилСтрогогоРежима = СнимокПравилЗащиты();
	СброситьПодтверждениеСтруктурныхПолей();

	Если НЕ ПустаяСтрока(СнимокПравилСтрогогоРежима.Ошибка) Тогда

		СостояниеЗащиты.ПричинаНеактивности = "конфликт правил анонимизации";
		ДобавитьВЛог("Строгий режим не активен, правила защиты не прочитаны: " + СнимокПравилСтрогогоРежима.Ошибка);

	КонецЕсли;

	СостояниеЗащиты.Строгий = Истина;
	СостояниеЗащиты.ГарантияПриостановлена = ПрочитатьПриостановкуГарантииНаСервере();
	ДобавитьВЛог("Строгий режим включается, эпоха защиты " + Формат(ЭпохаЗащиты, "ЧГ="));

	Если НЕ ПустаяСтрока(ТекстДляДеАнонимизации) Тогда

		ОбновитьПросмотрMarkdown();

	КонецЕсли;

	ОжидатьОстановкуЗаданий(ИдентификаторыЗаданий, 0);
	ПредложитьПодтверждениеСтруктурныхПолейПослеВключения();

	Если НЕ ПустаяСтрока(СнимокПравилСтрогогоРежима.Ошибка) Тогда

		Возврат;

	ИначеЕсли СнимокПравилСтрогогоРежима.ПравилНаПоляхОткрытыхТипов < 0 Тогда

		ДобавитьВЛог("Строгий режим: счетчик правил на полях открытых типов не посчитан");

	Иначе

		Количество = Формат(СнимокПравилСтрогогоРежима.ПравилНаПоляхОткрытыхТипов, "ЧН=0; ЧГ=");
		ДобавитьВЛог("Строгий режим: правил точной анонимизации на полях открытых типов (числа, даты, ссылки), "
			+ "которые строгий режим не применяет: " + Количество);

	КонецЕсли;

КонецПроцедуры

// Атомарное выключение строгого режима: та же последовательность, что при включении.
// Токены строгой эпохи в маскирование не переходят: карта токенов начинается заново.
//
&НаКлиенте
Процедура ВыключитьСтрогийРежимАтомарно()

	ИдентификаторыЗаданий = НачатьПереключениеСтрогогоРежима();
	СнимокПравилСтрогогоРежима = Неопределено;
	СостояниеЗащиты.Строгий = Ложь;
	СброситьПодтверждениеСтруктурныхПолей();
	СостояниеЗащиты.ГарантияПриостановлена = Ложь;
	ДобавитьВЛог("Строгий режим выключается, эпоха защиты " + Формат(ЭпохаЗащиты, "ЧГ="));

	Если НЕ ПустаяСтрока(ТекстДляДеАнонимизации) Тогда

		ОбновитьПросмотрMarkdown();

	КонецЕсли;

	ОжидатьОстановкуЗаданий(ИдентификаторыЗаданий, 0);

КонецПроцедуры

// Общая часть переключения: прием вызовов остановлен, эпоха защиты сменена, ожидающие ответа прошлой
// эпохи получили E_EPOCH_CHANGED, задания сняты, кэши прошлой эпохи сброшены, карта токенов начата заново.
//
// Возвращаемое значение:
//  Массив - идентификаторы фоновых заданий прошлой эпохи, остановку которых надо дождаться
//
&НаКлиенте
Функция НачатьПереключениеСтрогогоРежима()

	СостояниеЗащиты.Переключение = Истина;
	СостояниеЗащиты.Активен = Ложь;
	СостояниеЗащиты.ПричинаНеактивности = "";
	ЭпохаЗащиты = ЭпохаЗащиты + 1;
	ИдентификаторыЗаданий = ИдентификаторыАктивныхЗаданий();
	ОжиданиеОстановкиЗаданий = Неопределено;
	ОтключитьОбработчикОжидания("ПроверитьОстановкуЗаданийПрошлойЭпохи");
	ОтклонитьОжидающиеПрошлойЭпохи();
	СнятьВсеЗадания();
	СброситьКэшиПрошлойЭпохи();
	ОчиститьКартуМаскирования();
	НачатьЭпохуТокенов();

	Возврат ИдентификаторыЗаданий;

КонецФункции

// Идентификаторы фоновых заданий, остановку которых надо дождаться: задания реестра и задания, которых
// еще ждало предыдущее переключение. Копируются до того, как СнятьВсеЗадания очистит реестр.
//
// Возвращаемое значение:
//  Массив - идентификаторы фоновых заданий (УникальныйИдентификатор)
//
&НаКлиенте
Функция ИдентификаторыАктивныхЗаданий()

	Идентификаторы = Новый Массив;

	Если ОжиданиеОстановкиЗаданий <> Неопределено Тогда

		Для Каждого Ид Из ОжиданиеОстановкиЗаданий.Идентификаторы Цикл

			Идентификаторы.Добавить(Ид);

		КонецЦикла;

	КонецЕсли;

	Если АктивныеЗадания = Неопределено Тогда

		Возврат Идентификаторы;

	КонецЕсли;

	Для Каждого КлючЗначение Из АктивныеЗадания Цикл

		Если ЗначениеЗаполнено(КлючЗначение.Значение.ИдентификаторЗадания) Тогда

			Идентификаторы.Добавить(КлючЗначение.Значение.ИдентификаторЗадания);

		КонецЕсли;

	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

// Строгий режим становится активным только когда ни одно задание прошлой эпохи не выполняется.
// Пять повторных проверок с интервалом 2 с; дальше форма требует перезапуска сеанса.
//
// Параметры:
//  ИдентификаторыЗаданий - Массив - идентификаторы фоновых заданий прошлой эпохи
//  НомерПроверки - Число - номер проверки, начиная с 0
//
&НаКлиенте
Процедура ОжидатьОстановкуЗаданий(ИдентификаторыЗаданий, НомерПроверки)

	Осталось = 0;

	Если ИдентификаторыЗаданий.Количество() > 0 Тогда

		Осталось = КоличествоЕщеАктивныхЗаданийНаСервере(ИдентификаторыЗаданий);

	КонецЕсли;

	Если Осталось = 0 Тогда

		СостояниеЗащиты.Активен = СостояниеЗащиты.Строгий И ПустаяСтрока(СостояниеЗащиты.ПричинаНеактивности);
		СостояниеЗащиты.Переключение = Ложь;

	ИначеЕсли НомерПроверки >= 5 Тогда

		СостояниеЗащиты.Переключение = Ложь;
		СостояниеЗащиты.ПричинаНеактивности = "задания не остановлены, нужен перезапуск";
		ДобавитьВЛог("Фоновые задания прошлой эпохи не остановлены: " + Формат(Осталось, "ЧГ=")
			+ ". Перезапустите сеанс 1С.");

	Иначе

		ОжиданиеОстановкиЗаданий = Новый Структура("Идентификаторы, Номер, Эпоха",
			ИдентификаторыЗаданий, НомерПроверки + 1, ЭпохаЗащиты);
		ПодключитьОбработчикОжидания("ПроверитьОстановкуЗаданийПрошлойЭпохи", 2, Истина);

	КонецЕсли;

	ОбновитьОтображениеСостоянияЗащиты();

КонецПроцедуры

// Обработчик ожидания: повторная проверка остановки заданий прошлой эпохи.
// Проверка, запланированная до следующего переключения, ничего не делает.
//
&НаКлиенте
Процедура ПроверитьОстановкуЗаданийПрошлойЭпохи() Экспорт

	Ожидание = ОжиданиеОстановкиЗаданий;

	Если Ожидание = Неопределено Или Ожидание.Эпоха <> ЭпохаЗащиты Тогда

		Возврат;

	КонецЕсли;

	ОжиданиеОстановкиЗаданий = Неопределено;
	ОжидатьОстановкуЗаданий(Ожидание.Идентификаторы, Ожидание.Номер);

КонецПроцедуры

// Количество фоновых заданий из списка, которые еще выполняются.
//
// Параметры:
//  Идентификаторы - Массив - идентификаторы фоновых заданий (УникальныйИдентификатор)
//
// Возвращаемое значение:
//  Число - количество заданий в состоянии Активно
//
&НаСервереБезКонтекста
Функция КоличествоЕщеАктивныхЗаданийНаСервере(Знач Идентификаторы)

	Количество = 0;

	Для Каждого Ид Из Идентификаторы Цикл

		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Ид);

		Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда

			Количество = Количество + 1;

		КонецЕсли;

	КонецЦикла;

	Возврат Количество;

КонецФункции

// Отвечает E_EPOCH_CHANGED всем, кто ждет ответа прошлой эпохи: фоновым заданиям реестра,
// вызовам у шлюза строгого режима, асинхронным проверкам строгого режима и вызовам у формы подтверждения
// опасных операций. Очередь шлюза и снимки подтвержденных вызовов прошлой эпохи сбрасываются. Открытая форма
// шлюза больше не держит очередь (КлючОткрытогоШлюза сброшен), ее решение будет отброшено.
//
&НаКлиенте
Процедура ОтклонитьОжидающиеПрошлойЭпохи()

	Количество = ОтклонитьЗаданияПрошлойЭпохи();

	Для Каждого КлючЗначение Из ОжидающиеШлюза Цикл

		ЗаписатьВЖурналШлюза(КлючЗначение.Значение, "epoch");
		ОтправитьОшибкуЭпохи(КлючЗначение.Значение.Доставка);
		Количество = Количество + 1;

	КонецЦикла;

	ОжидающиеШлюза = Новый Соответствие;
	ОчередьШлюза = Новый Массив;
	КлючОткрытогоШлюза = 0;
	СнимкиПодтвержденныхВызовов = Новый Соответствие;
	Количество = Количество + ОтклонитьПроверкиПрошлойЭпохи();

	Если ОжидающиеПодтверждения <> Неопределено Тогда

		Для Каждого КлючЗначение Из ОжидающиеПодтверждения Цикл

			ОтправитьОшибкуЭпохи(ДоставкаИзКонтекстаПодтверждения(КлючЗначение.Значение));
			Количество = Количество + 1;

		КонецЦикла;

		ОжидающиеПодтверждения = Новый Соответствие;

	КонецЕсли;

	Если Количество > 0 Тогда

		ДобавитьВЛог("Ожидающим ответа прошлой эпохи защиты отправлен E_EPOCH_CHANGED: " + Формат(Количество, "ЧГ="));

	КонецЕсли;

КонецПроцедуры

// Отвечает E_EPOCH_CHANGED на запросы, чьи фоновые задания еще в реестре. Сам реестр не меняет:
// задания снимает СнятьВсеЗадания.
//
// Возвращаемое значение:
//  Число - количество отклоненных запросов
//
&НаКлиенте
Функция ОтклонитьЗаданияПрошлойЭпохи()

	Количество = 0;

	Если АктивныеЗадания = Неопределено Тогда

		Возврат Количество;

	КонецЕсли;

	Для Каждого КлючЗначение Из АктивныеЗадания Цикл

		ОтправитьОшибкуЭпохи(ДоставкаИзЗаписиЗадания(КлючЗначение.Значение));
		Количество = Количество + 1;

	КонецЦикла;

	Возврат Количество;

КонецФункции

// Доставка ответа по записи фонового задания (см. ЗапуститьВФонеИЗарегистрировать). Для вызова строгого режима
// возвращается исходная доставка вызова, а не копия: признак Отвечено (ОтветДоставкиДан) ставится и проверяется
// в той же структуре, что и на остальных путях ответа.
//
// Параметры:
//  Запись - Структура - запись реестра АктивныеЗадания
//
// Возвращаемое значение:
//  Структура - Режим, ДанныеЗапроса, Ид, ИдПотокаSSE
//
&НаКлиенте
Функция ДоставкаИзЗаписиЗадания(Запись)

	Если Запись.Свойство("Строгий") Тогда

		Возврат Запись.Строгий.Доставка;

	КонецЕсли;

	Возврат Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE",
		Запись.Режим, Запись.ДанныеЗапроса, Запись.Ид, Запись.ИдПотокаSSE);

КонецФункции

// Доставка ответа по контексту формы подтверждения опасной операции. В REST-контексте нет полей Ид
// и ИдПотокаSSE, в MCP-контексте нет поля Режим: недостающие поля берутся по умолчанию.
//
// Параметры:
//  Контекст - Структура - элемент ОжидающиеПодтверждения
//
// Возвращаемое значение:
//  Структура - Режим, ДанныеЗапроса, Ид, ИдПотокаSSE
//
&НаКлиенте
Функция ДоставкаИзКонтекстаПодтверждения(Контекст)

	Доставка = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE", "mcp", Неопределено, Неопределено, "");
	ЗаполнитьЗначенияСвойств(Доставка, Контекст);

	Возврат Доставка;

КонецФункции

// Отправляет E_EPOCH_CHANGED через транспорт доставки. Без компоненты отправлять некуда. Если ответ по доставке
// уже дан (ОтветДоставкиДан), второй не отправляется.
//
// Параметры:
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE; сюда добавляется Отвечено
//
&НаКлиенте
Процедура ОтправитьОшибкуЭпохи(Доставка)

	Если Компонента = Неопределено Или ОтветДоставкиДан(Доставка) Тогда

		Возврат;

	КонецЕсли;

	Ошибка = ОшибкаСтрогогоРежима("E_EPOCH_CHANGED");

	Если Доставка.Режим = "rest" Тогда

		ОтправитьОтветСтрогогоРежима(ОтветОшибкиСтрогогоREST(Ошибка), Доставка);

	Иначе

		ОтправитьОтветСтрогогоРежима(ОтветОшибкиСтрогогоMCP(Ошибка), Доставка);

	КонецЕсли;

КонецПроцедуры

// Отправляет ошибку выполнения через транспорт доставки после сбоя продолжения асинхронной конвертации TOON.
// В строгом режиме - E_EXECUTION строгого формата, иначе ошибка формата транспорта (isError для MCP, 500 для REST)
// с фиксированным текстом. Без компоненты отправлять некуда. Если ответ по доставке уже дан (ОтветДоставкиДан),
// второй не отправляется.
//
// Параметры:
//  Доставка - Структура - Режим (mcp или rest), ДанныеЗапроса, Ид, ИдПотокаSSE; сюда добавляется Отвечено
//
&НаКлиенте
Процедура ОтправитьОшибкуВыполненияДоставки(Доставка)

	Если Компонента = Неопределено Или ОтветДоставкиДан(Доставка) Тогда

		Возврат;

	КонецЕсли;

	Если СостояниеЗащиты.Строгий Тогда

		Ответ = ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Доставка);

	ИначеЕсли Доставка.Режим = "rest" Тогда

		Ответ = СформироватьRESTОшибка(500, ТекстОшибкиСтрогогоРежима("E_EXECUTION"));

	Иначе

		Ответ = СформироватьToolsCallОшибку("Error: " + ТекстОшибкиСтрогогоРежима("E_EXECUTION"));

	КонецЕсли;

	ОтправитьОтветСтрогогоРежима(Ответ, Доставка);

КонецПроцедуры

// Запрос принят в прошлой эпохе защиты. Эпоху ставит ПродолжитьОбработкуЗапроса в данные транспорта,
// а не клиент: аргументы вызова ее подменить не могут. Пока строгий режим не переключали, эпоха не меняется
// и проверка всегда дает Ложь.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//
// Возвращаемое значение:
//  Булево - Истина, если запрос принят в другой эпохе защиты
//
&НаКлиенте
Функция ЗапросУстарелПоЭпохе(ДанныеЗапроса)

	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда

		Возврат Ложь;

	КонецЕсли;

	Эпоха = Неопределено;

	Возврат ДанныеЗапроса.Свойство("_epoch", Эпоха) И Эпоха <> ЭпохаЗащиты;

КонецФункции

// Проверка отложенного ответа перед отправкой: ответ на запрос прошлой эпохи защиты заменяется
// ошибкой E_EPOCH_CHANGED. Для запроса текущей эпохи ничего не делает.
//
// Параметры:
//  Режим - Строка - транспорт ответа (mcp или rest)
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  Ид - Произвольный - идентификатор JSON-RPC запроса
//  ИдПотокаSSE - Строка - идентификатор SSE-потока для отложенного ответа
//
// Возвращаемое значение:
//  Булево - Истина, если вместо ответа отправлена ошибка и отправлять ответ не нужно
//
&НаКлиенте
Функция ОтветОтклоненПоЭпохе(Режим, ДанныеЗапроса, Ид, ИдПотокаSSE)

	Если НЕ ЗапросУстарелПоЭпохе(ДанныеЗапроса) Тогда

		Возврат Ложь;

	КонецЕсли;

	ДобавитьВЛог("Ответ на запрос прошлой эпохи защиты отброшен");
	ОтправитьОшибкуЭпохи(Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE", Режим, ДанныеЗапроса, Ид, ИдПотокаSSE));

	Возврат Истина;

КонецФункции

// Отложенная обработка lineage/regex запроса прошлой эпохи прекращается до маскирования: его значения
// не попадают в карту токенов новой эпохи, клиенту уходит E_EPOCH_CHANGED. Контексты прокси пропускаются.
//
// Параметры:
//  КонтекстLineage - Структура, Неопределено - Режим, ДанныеЗапроса, Ид, ИдПотока
//
// Возвращаемое значение:
//  Булево - Истина, если обработка прекращена и ответ уже отправлен
//
&НаКлиенте
Функция ОбработкаОтклоненаПоЭпохе(КонтекстLineage)

	Если ТипЗнч(КонтекстLineage) <> Тип("Структура") Или НЕ КонтекстLineage.Свойство("ДанныеЗапроса") Тогда

		Возврат Ложь;

	КонецЕсли;

	Доставка = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока", "mcp", Неопределено, Неопределено, "");
	ЗаполнитьЗначенияСвойств(Доставка, КонтекстLineage);

	Возврат Доставка.Режим <> "proxy"
		И ОтветОтклоненПоЭпохе(Доставка.Режим, Доставка.ДанныеЗапроса, Доставка.Ид, Доставка.ИдПотока);

КонецФункции

// Сбрасывает кэши прошлой эпохи при переключении строгого режима:
// клиентский кэш расширений с адресами временного хранилища за ним и кэш схем инструментов.
// Пересборка ленивая: следующий get_metadata считает метаданные заново.
//
&НаКлиенте
Процедура СброситьКэшиПрошлойЭпохи()

	Адреса = АдресаКэшаРасширений();
	КэшТокеновМетаданныхРасширений = Новый Соответствие;
	КэшСхемИнструментов = Неопределено;

	Если Адреса.Количество() > 0 Тогда

		ОсвободитьАдресаКэшаРасширения(Адреса);

	КонецЕсли;

	ДобавитьВЛог("Кэш прошлой эпохи сброшен, освобождено адресов: " + Формат(Адреса.Количество(), "ЧН=0; ЧГ="));

КонецПроцедуры

// Адреса временного хранилища за записями клиентского кэша расширений: data_token, index_token и детали.
//
// Возвращаемое значение:
//  Массив - адреса временного хранилища (пустые значения отбрасывает ОсвободитьАдресаКэшаРасширения)
//
&НаКлиенте
Функция АдресаКэшаРасширений()

	Адреса = Новый Массив;

	Если КэшТокеновМетаданныхРасширений = Неопределено Тогда

		Возврат Адреса;

	КонецЕсли;

	Для Каждого КлючЗначение Из КэшТокеновМетаданныхРасширений Цикл

		Адреса.Добавить(КлючЗначение.Значение.data_token);
		Адреса.Добавить(КлючЗначение.Значение.index_token);

		Для Каждого ЭлементДеталей Из КлючЗначение.Значение.details Цикл

			Адреса.Добавить(ЭлементДеталей.Значение);

		КонецЦикла;

	КонецЦикла;

	Возврат Адреса;

КонецФункции

// Карта токенов маскирования начинается заново: токены прошлой эпохи в новую не переходят.
// Словарь анонимизации пересобирается так же, как при запуске встроенного сервера.
//
&НаКлиенте
Процедура ОчиститьКартуМаскирования()

	АнонимизаторОчистить();

	Если НЕ ВстроенныйСерверЗапущен Тогда

		Возврат;

	КонецЕсли;

	Если ИспользоватьТочнуюАнонимизацию Тогда

		ПостроитьИЗаполнитьСловарьАнонимизации();

	КонецЕсли;

	ОбновитьТаблицуМаппинговВстроенный();

КонецПроцедуры

// Новая эпоха токенов строгого режима: происхождение токенов прошлой эпохи забывается, генератор номеров
// создается заново. Конструктор без параметра инициализирует генератор источником энтропии. В веб-клиенте
// генератора нет: он остается Неопределено, и выдача токенов строгого режима отказывает (НовыйСлучайныйТокен).
//
&НаКлиенте
Процедура НачатьЭпохуТокенов()

	ПроисхождениеТокенов = Новый Соответствие;
	ГСЧТокенов = Неопределено;

	Попытка

		ГСЧТокенов = Новый ГенераторСлучайныхЧисел();

	Исключение

		ДобавитьВЛог("Генератор случайных чисел недоступен: токены строгого режима не выдаются");

	КонецПопытки;

КонецПроцедуры

// Случайный номер токена строгого режима. Формат [КАТЕГОРИЯ-NNNNN] сохранен: первая цифра не ноль; после каждых
// 10 занятых номеров подряд разрядность растет на единицу, но не выше 9 знаков.
//
// Параметры:
//  Категория - Строка - категория токена (STR, PER, ORG и т.п.)
//
// Возвращаемое значение:
//  Строка - токен, которого еще нет в карте МаппингДеанонимизации
//
&НаКлиенте
Функция НовыйСлучайныйТокен(Категория)

	Если ГСЧТокенов = Неопределено Тогда

		ВызватьИсключение "Не удалось выдать токен";

	КонецЕсли;

	НижняяГраница = 10000;

	Для НомерПопытки = 1 По 60 Цикл

		Номер = ГСЧТокенов.СлучайноеЧисло(НижняяГраница, НижняяГраница * 10 - 1);
		Токен = "[" + Категория + "-" + Формат(Номер, "ЧГ=0") + "]";

		Если МаппингДеанонимизации.Получить(ВРег(Токен)) = Неопределено Тогда

			Возврат Токен;

		КонецЕсли;

		Если НомерПопытки % 10 = 0 И НижняяГраница < 100000000 Тогда

			НижняяГраница = НижняяГраница * 10;

		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение "Не удалось выдать токен";

КонецФункции

// Токенизация строгого режима. Только Происхождение = "protected" (прямое чтение защищенного поля без
// преобразования) читает и пополняет основную карту: одно значение - один токен в сессии. Остальные значения
// маскируются в изолированной области одного ответа: она не читает и не пополняет основную карту, а токены
// помечены своим происхождением. Значение клиента сюда не передается никогда: оно возвращается как есть.
//
// Параметры:
//  Значение - Строка - маскируемое значение
//  Категория - Строка - категория токена (ОпределитьКатегориюТокена по пути поля или STR)
//  Происхождение - Строка - protected или происхождение изолированной области (protected_derived, unknown, mixed)
//  ИзолированныйМаппинг - Соответствие - значение -> токен изолированной области текущего ответа
//
// Возвращаемое значение:
//  Строка - токен
//
&НаКлиенте
Функция СтрогийТокенизировать(Значение, Категория, Происхождение, ИзолированныйМаппинг)

	АнонимизаторИнициализировать();
	ОсновнаяКарта = (Происхождение = "protected");
	Токен = ?(ОсновнаяКарта, МаппингАнонимизации.Получить(Значение), ИзолированныйМаппинг.Получить(Значение));

	Если Токен <> Неопределено Тогда

		Возврат Токен;

	КонецЕсли;

	Токен = НовыйСлучайныйТокен(Категория);
	МаппингДеанонимизации.Вставить(ВРег(Токен), Значение);
	ПроисхождениеТокенов.Вставить(ВРег(Токен), Происхождение);

	Если ОсновнаяКарта Тогда

		МаппингАнонимизации.Вставить(Значение, Токен);
		ОчередьВставки.Добавить(Значение);

	Иначе

		ИзолированныйМаппинг.Вставить(Значение, Токен);

	КонецЕсли;

	Возврат Токен;

КонецФункции

// Происхождение токена, выданного строгим режимом в текущей эпохе.
//
// Параметры:
//  Токен - Строка - токен в любом регистре
//
// Возвращаемое значение:
//  Строка, Неопределено - protected, происхождение изолированной области или Неопределено для токена,
//                         не выданного строгим режимом в этой эпохе
//
&НаКлиенте
Функция ПроисхождениеТокена(Токен)

	Возврат ПроисхождениеТокенов.Получить(ВРег(Токен));

КонецФункции

// Правила защиты строгого режима, прочитанные один раз при включении. Если regex-правила
// в хранилище не сохранены, берутся правила по умолчанию из макета обработки.
//
// Возвращаемое значение:
//  Структура - ТочныеПравила (Соответствие, Неопределено), RegexПравила (Массив), РазрешенныеКоды (Массив),
//              СтруктурныеПоля (Соответствие), Ошибка (Строка; непустая - строгий режим не становится активным)
//
&НаКлиенте
Функция СнимокПравилЗащиты()

	Снимок = СнимокПравилЗащитыНаСервере();

	Если Снимок.RegexПравила = Неопределено Тогда

		Снимок.RegexПравила = ПолучитьRegexПравилаПоУмолчанию();

	КонецЕсли;

	Возврат Снимок;

КонецФункции

// Правила защиты из хранилища: правила точной анонимизации, сохраненные regex-правила и таблицы,
// чьи коды и номера разрешено показывать (по умолчанию - все планы счетов). Конфликт правил
// точной анонимизации не прерывает открытие формы: он возвращается в поле Ошибка.
// СтруктурныеПоля всегда пусты и из хранилища не читаются: хранилище мог переписать код клиента в режиме
// маскирования. Поля попадают в снимок только по действию человека на форме.
//
// Возвращаемое значение:
//  Структура - ТочныеПравила (Соответствие, Неопределено), RegexПравила (Массив, Неопределено),
//              РазрешенныеКоды (Массив), СтруктурныеПоля (Соответствие: ВРег(ИдПоля) -> Истина), Ошибка (Строка)
//
&НаСервереБезКонтекста
Функция СнимокПравилЗащитыНаСервере()

	РазрешенныеКоды = Новый Массив;

	Для Каждого ОбъектПланСчетов Из Метаданные.ПланыСчетов Цикл

		РазрешенныеКоды.Добавить(ОбъектПланСчетов.ПолноеИмя());

	КонецЦикла;

	Снимок = Новый Структура("ТочныеПравила, RegexПравила, РазрешенныеКоды, СтруктурныеПоля, Ошибка,"
			+ "ПравилНаПоляхОткрытыхТипов",
		Неопределено, ПолучитьRegexПравилаИзХранилищаНаСервере(), РазрешенныеКоды, Новый Соответствие, "", -1);

	Попытка

		Снимок.ТочныеПравила = УжесточающиеПравилаТочнойАнонимизации(ПолучитьПравилаТочнойАнонимизацииИзХранилища());

	Исключение

		Снимок.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

	// Счетчик только информирует: его сбой не должен мешать включению строгого режима.
	Попытка

		Снимок.ПравилНаПоляхОткрытыхТипов = КоличествоПравилНаПоляхОткрытыхТипов(Снимок.ТочныеПравила);

	Исключение

		Снимок.ПравилНаПоляхОткрытыхТипов = -1;

	КонецПопытки;

	Возврат Снимок;

КонецФункции

// Число правил точной анонимизации, которые строгий режим не применяет: правило стоит на поле открытого типа.
// Тип определяется упрощенно, без поиска метаданных по каждому ссылочному типу: поле открыто, если в его
// описании типов нет строки и хранилища значения. Политика полей (КлассПоляПоТипу в модуле объекта) еще
// закрывает поля неизвестных типов, поэтому число информационное и на таких полях может разойтись с ней.
//
// Параметры:
//  ТочныеПравила - Соответствие, Неопределено - ВРег(путь поля) -> правило anonymize
//
// Возвращаемое значение:
//  Число - количество таких правил
//
&НаСервереБезКонтекста
Функция КоличествоПравилНаПоляхОткрытыхТипов(ТочныеПравила)

	Количество = 0;

	Если ТипЗнч(ТочныеПравила) <> Тип("Соответствие") Тогда

		Возврат Количество;

	КонецЕсли;

	ОткрытыеПоляТаблиц = Новый Соответствие;

	Для Каждого Правило Из ТочныеПравила Цикл

		// Путь правила: "<Вид>.<Объект>.<Поле>" или "<Вид>.<Объект>.<ТабличнаяЧасть>.<Поле>".
		Путь = Правило.Ключ;
		ПозицияТочки = Найти(Путь, ".");
		ПозицияТочки = ПозицияТочки + Найти(Сред(Путь, ПозицияТочки + 1), ".");
		Хвост = Найти(Сред(Путь, ПозицияТочки + 1), ".");
		ПозицияТочки = ПозицияТочки + Хвост;
		ПутьТаблицы = Лев(Путь, ПозицияТочки - 1);
		ОткрытыеПоля = ОткрытыеПоляТаблиц.Получить(ПутьТаблицы);

		Если ОткрытыеПоля = Неопределено Тогда

			ОткрытыеПоля = ОткрытыеПоляТаблицыДляСчетчика(ПутьТаблицы);
			ОткрытыеПоляТаблиц.Вставить(ПутьТаблицы, ОткрытыеПоля);

		КонецЕсли;

		Если ОткрытыеПоля.Получить(ВРег(Сред(Путь, ПозицияТочки + 1))) = Истина Тогда

			Количество = Количество + 1;

		КонецЕсли;

	КонецЦикла;

	Возврат Количество;

КонецФункции

// Имена полей таблицы правил, открытых по типу (без строки и хранилища значения): коллекции, по которым
// форма точной анонимизации строит пути правил.
//
// Параметры:
//  ПутьТаблицы - Строка - "<Вид>.<Объект>" или "<Вид>.<Объект>.<ТабличнаяЧасть>"
//
// Возвращаемое значение:
//  Соответствие - ВРег(имя поля) -> Истина; пустое, если таблица не найдена
//
&НаСервереБезКонтекста
Функция ОткрытыеПоляТаблицыДляСчетчика(ПутьТаблицы)

	ОткрытыеПоля = Новый Соответствие;
	ПозицияТочки = Найти(ПутьТаблицы, ".");
	ИмяТЧ = Сред(ПутьТаблицы, ПозицияТочки + 1);
	ПозицияТЧ = Найти(ИмяТЧ, ".");
	ИмяОбъекта = ?(ПозицияТЧ = 0, ПутьТаблицы, Лев(ПутьТаблицы, ПозицияТочки + ПозицияТЧ - 1));
	ИмяТЧ = ?(ПозицияТЧ = 0, "", Сред(ИмяТЧ, ПозицияТЧ + 1));
	ОбъектМД = ?(ПозицияТочки = 0, Неопределено, Метаданные.НайтиПоПолномуИмени(ИмяОбъекта));

	Если ОбъектМД = Неопределено Тогда

		Возврат ОткрытыеПоля;

	КонецЕсли;

	Для Каждого Коллекция Из КоллекцииПолейДляСчетчика(ОбъектМД, Лев(ИмяОбъекта, ПозицияТочки - 1), ИмяТЧ) Цикл

		Для Каждого Описание Из Коллекция Цикл

			Типы = Описание.Тип;

			Если Типы.Типы().Количество() > 0 И НЕ Типы.СодержитТип(Тип("Строка"))
				И НЕ Типы.СодержитТип(Тип("ХранилищеЗначения")) Тогда

				ОткрытыеПоля.Вставить(ВРег(Описание.Имя), Истина);

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат ОткрытыеПоля;

КонецФункции

// Коллекции полей таблицы правил: для табличной части - ее реквизиты, для объекта - стандартные реквизиты,
// реквизиты и коллекции, которые есть у его вида (измерения и ресурсы регистров, признаки учета, реквизиты адресации).
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект метаданных
//  Вид - Строка - первая часть пути таблицы
//  ИмяТЧ - Строка - имя табличной части; пустая строка - таблица самого объекта
//
// Возвращаемое значение:
//  Массив - коллекции описаний полей (у каждого есть Имя и Тип)
//
&НаСервереБезКонтекста
Функция КоллекцииПолейДляСчетчика(ОбъектМД, Вид, ИмяТЧ)

	Коллекции = Новый Массив;
	ВидВРег = ВРег(Вид);

	Если НЕ ПустаяСтрока(ИмяТЧ) Тогда

		ТабличнаяЧасть = ОбъектМД.ТабличныеЧасти.Найти(ИмяТЧ);

		Если ТабличнаяЧасть <> Неопределено Тогда

			Коллекции.Добавить(ТабличнаяЧасть.Реквизиты);

		КонецЕсли;

	ИначеЕсли Найти(",РЕГИСТРСВЕДЕНИЙ,РЕГИСТРНАКОПЛЕНИЯ,РЕГИСТРБУХГАЛТЕРИИ,РЕГИСТРРАСЧЕТА,", "," + ВидВРег + ",") > 0 Тогда

		Коллекции.Добавить(ОбъектМД.Измерения);
		Коллекции.Добавить(ОбъектМД.Ресурсы);
		Коллекции.Добавить(ОбъектМД.Реквизиты);

	ИначеЕсли ВидВРег <> "ПЕРЕЧИСЛЕНИЕ" Тогда

		Коллекции.Добавить(ОбъектМД.СтандартныеРеквизиты);
		Коллекции.Добавить(ОбъектМД.Реквизиты);

		Если ВидВРег = "ЗАДАЧА" Тогда

			Коллекции.Добавить(ОбъектМД.РеквизитыАдресации);

		КонецЕсли;

	Иначе

		// У перечисления полей с правилами нет.

	КонецЕсли;

	Возврат Коллекции;

КонецФункции

// Строгий режим принимает правила точной анонимизации только как ужесточение (план, вопрос Q4):
// хранилище правил мог переписать код клиента в режиме маскирования. Остаются правила с action = "anonymize";
// keep и любое другое действие в снимок не попадают, и ни один потребитель снимка не может их применить.
// Коды и номера показываются только по явному списку РазрешенныеКоды.
//
// Параметры:
//  ИндексПравил - Соответствие - индекс правил: ключ пути -> Структура(action, token_category)
//
// Возвращаемое значение:
//  Соответствие - только правила с action = "anonymize"
//
&НаСервереБезКонтекста
Функция УжесточающиеПравилаТочнойАнонимизации(ИндексПравил)

	Ужесточающие = Новый Соответствие;

	Если ТипЗнч(ИндексПравил) <> Тип("Соответствие") Тогда

		Возврат Ужесточающие;

	КонецЕсли;

	Для Каждого Элемент Из ИндексПравил Цикл

		Действие = Неопределено;

		Если ТипЗнч(Элемент.Значение) = Тип("Структура") И Элемент.Значение.Свойство("action", Действие)
			И Действие = "anonymize" Тогда

			Ужесточающие.Вставить(Элемент.Ключ, Элемент.Значение);

		КонецЕсли;

	КонецЦикла;

	Возврат Ужесточающие;

КонецФункции

// Политика полей для компоненты строгой проверки, собранная на сервере по метаданным конфигурации.
// Правила защиты берутся из переданного среза снимка, взятого при включении строгого режима
// (СрезПравилДляПолитики): настройки из хранилища на сервере повторно не читаются.
// Возвращается компактная строка JSON, а не соответствие: большая структура на клиенте
// стоила бы секунд на каждой передаче.
//
// Параметры:
//  ИменаТаблиц - Массив - полные имена таблиц запроса
//  ПравилаЗащиты - Структура - срез правил защиты (СрезПравилДляПолитики)
//  Дополнение - Соответствие, Неопределено - разделы политики, которые собирает клиент (params, tokens):
//               заменяют одноименные разделы
//
// Возвращаемое значение:
//  Строка - JSON политики полей (версия 1)
//
&НаСервере
Функция ПолитикаПолейНаСервере(ИменаТаблиц, ПравилаЗащиты, Дополнение = Неопределено)

	Обработка = РеквизитФормыВЗначение("Объект");
	Политика = Обработка.СформироватьПолитикуПолейСтрогогоРежима(ИменаТаблиц, ПравилаЗащиты);

	Если ТипЗнч(Дополнение) = Тип("Соответствие") Тогда

		Для Каждого Элемент Из Дополнение Цикл

			Политика.Вставить(Элемент.Ключ, Элемент.Значение);

		КонецЦикла;

	КонецЕсли;

	Возврат ЗаписатьJSON2(Политика, Ложь);

КонецФункции

// Срез снимка правил строгого режима для построения политики: все разрешенные коды и только те
// точные правила, чей путь содержит имя одного из запрошенных объектов. Так на сервер уходит
// малая часть списка правил, который может содержать десятки тысяч записей.
//
// Параметры:
//  Снимок - Структура - снимок правил строгого режима: ТочныеПравила, РазрешенныеКоды, СтруктурныеПоля
//           (в снимке прежней сборки ключа может не быть - срез получает пустой набор)
//  ИменаТаблиц - Массив - полные имена таблиц запроса
//
// Возвращаемое значение:
//  Структура - ТочныеПравила (Соответствие), РазрешенныеКоды (Массив), СтруктурныеПоля (Соответствие)
//
&НаКлиентеНаСервереБезКонтекста
Функция СрезПравилДляПолитики(Снимок, ИменаТаблиц)

	ПоляСреза = Новый Соответствие;

	Если Снимок.Свойство("СтруктурныеПоля") И ТипЗнч(Снимок.СтруктурныеПоля) = Тип("Соответствие") Тогда

		ПоляСреза = Снимок.СтруктурныеПоля;

	КонецЕсли;

	Срез = Новый Структура("ТочныеПравила, РазрешенныеКоды, СтруктурныеПоля",
		Новый Соответствие, Снимок.РазрешенныеКоды, ПоляСреза);

	Если ТипЗнч(Снимок.ТочныеПравила) <> Тип("Соответствие") Или Снимок.ТочныеПравила.Количество() = 0 Тогда

		Возврат Срез;

	КонецЕсли;

	Фрагменты = Новый Массив;

	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл

		Фрагменты.Добавить(ФрагментПутиПравилТаблицыПолитики(ИмяТаблицы));

	КонецЦикла;

	Для Каждого Правило Из Снимок.ТочныеПравила Цикл

		Для Каждого Фрагмент Из Фрагменты Цикл

			Если ПутьПравилаОтноситсяКФрагменту(Правило.Ключ, Фрагмент) Тогда

				Срез.ТочныеПравила.Вставить(Правило.Ключ, Правило.Значение);

				Прервать;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат Срез;

КонецФункции

// Относится ли правило к таблице: фрагмент вида ".Имя." ищется в ключе, префикс констант - только в его начале.
//
// Параметры:
//  Ключ - Строка - ключ правила (путь в верхнем регистре)
//  Фрагмент - Строка - результат ФрагментПутиПравилТаблицыПолитики
//
// Возвращаемое значение:
//  Булево - Истина, если правило относится к таблице
//
&НаКлиентеНаСервереБезКонтекста
Функция ПутьПравилаОтноситсяКФрагменту(Ключ, Фрагмент)

	Если Лев(Фрагмент, 1) = "." Тогда

		Возврат Найти(Ключ, Фрагмент) > 0;

	КонецЕсли;

	Возврат Лев(Ключ, СтрДлина(Фрагмент)) = Фрагмент;

КонецФункции

// Фрагмент ключа правил точной анонимизации, по которому отбираются правила таблицы запроса: имя объекта
// между точками; для таблицы констант ("Константы", "Константа.<Имя>") - префикс путей правил констант.
//
// Параметры:
//  ИмяТаблицы - Строка - имя таблицы запроса
//
// Возвращаемое значение:
//  Строка - фрагмент в верхнем регистре
//
&НаКлиентеНаСервереБезКонтекста
Функция ФрагментПутиПравилТаблицыПолитики(ИмяТаблицы)

	ИмяВерхним = ВРег(СокрЛП(ИмяТаблицы));

	Если ИмяВерхним = "КОНСТАНТЫ" ИЛИ ИмяВерхним = "CONSTANTS" ИЛИ Лев(ИмяВерхним, 10) = "КОНСТАНТА."
		ИЛИ Лев(ИмяВерхним, 9) = "CONSTANT." Тогда

		Возврат "КОНСТАНТА.";

	КонецЕсли;

	Возврат "." + ВРег(ИмяОбъектаИзИмениТаблицыПолитики(ИмяТаблицы)) + ".";

КонецФункции

// Имя объекта метаданных из имени таблицы запроса: вторая часть полного имени.
//
// Параметры:
//  ИмяТаблицы - Строка - например "Справочник.Контрагенты" или "РегистрНакопления.Остатки.Остатки"
//
// Возвращаемое значение:
//  Строка - имя объекта; пустая строка, если в имени нет точки
//
&НаКлиентеНаСервереБезКонтекста
Функция ИмяОбъектаИзИмениТаблицыПолитики(ИмяТаблицы)

	ПозицияТочки = Найти(ИмяТаблицы, ".");

	Если ПозицияТочки = 0 Тогда

		Возврат "";

	КонецЕсли;

	Остаток = Сред(ИмяТаблицы, ПозицияТочки + 1);
	ПозицияТочки = Найти(Остаток, ".");

	Возврат СокрЛП(?(ПозицияТочки = 0, Остаток, Лев(Остаток, ПозицияТочки - 1)));

КонецФункции

// Читает признак "гарантия приостановлена". Вызывается только при включении строгого режима
// и при восстановлении доверия; запись признака добавляется отдельно.
//
// Возвращаемое значение:
//  Булево - Истина, если сохранена запись с Приостановлена = Истина
//
&НаСервереБезКонтекста
Функция ПрочитатьПриостановкуГарантииНаСервере()

	Запись = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтрогийГарантияПриостановлена");
	Приостановлена = Неопределено;

	Возврат ТипЗнч(Запись) = Тип("Структура") И Запись.Свойство("Приостановлена", Приостановлена)
		И Приостановлена = Истина;

КонецФункции

// Приостанавливает гарантию строгого режима, если подтвержденное действие относится к классу защиты.
// Сначала пишется сам признак, потом отдельным шагом снимок регламентных заданий: сбой снимка
// (нет прав) не оставляет гарантию в силе. Признак переживает перезапуск.
// Классы защиты: R_PROTECTION, R_DEFERRED, R_CREDENTIALS, R_RELAUNCH, любая запись R_WRITE и
// R_CLIENT_CONTEXT (выполнение в контексте клиента). R_RELAUNCH и R_CLIENT_CONTEXT вызывающий
// (шлюз подтверждения, задачи 47-48) добавляет в Риски сам. Нечитаемый элемент Рисков считается классом защиты.
//
// Параметры:
//  Проверка - Структура - результат проверки; Риски - Массив: элемент - Структура или Соответствие с полем code
//             (формат CheckCode: code, line, col) либо просто строка кода
//
&НаКлиенте
Процедура ОтметитьПодтверждениеКлассаЗащиты(Проверка)

	Риски = Неопределено;

	Если СостояниеЗащиты.ГарантияПриостановлена Или НЕ СостояниеЗащиты.Строгий Тогда

		Возврат;

	КонецЕсли;

	Если ТипЗнч(Проверка) <> Тип("Структура") Или НЕ Проверка.Свойство("Риски", Риски) Или ТипЗнч(Риски) <> Тип("Массив") Тогда

		Риски = Новый Массив;
		Риски.Добавить(Неопределено);

	КонецЕсли;

	Для Каждого Риск Из Риски Цикл

		Код = КодРискаПроверки(Риск);

		Если Код = "" Или КлассЗащитыПоКодуРиска(Код) Тогда

			ЗаписатьПриостановкуГарантииНаСервере();
			СостояниеЗащиты.ГарантияПриостановлена = Истина;
			ДобавитьВЛог("Гарантия строгого режима приостановлена: подтверждено действие класса " + Код);
			ОбновитьОтображениеСостоянияЗащиты();
			ПричинаСбоя = ДополнитьПриостановкуСнимкомЗаданийНаСервере();

			Если НЕ ПустаяСтрока(ПричинаСбоя) Тогда

				ДобавитьВЛог("Снимок регламентных заданий не получен: " + ПричинаСбоя);

			КонецЕсли;

			Возврат;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Код риска из элемента Рисков: поле code структуры или соответствия, либо сама строка.
//
// Параметры:
//  Риск - Структура, Соответствие, Строка, Произвольный - элемент Рисков
//
// Возвращаемое значение:
//  Строка - код риска; пустая строка, если элемент нечитаем
//
&НаКлиенте
Функция КодРискаПроверки(Риск)

	Код = Неопределено;

	Если ТипЗнч(Риск) = Тип("Строка") Тогда

		Возврат Риск;

	ИначеЕсли ТипЗнч(Риск) = Тип("Структура") И Риск.Свойство("code", Код) И ТипЗнч(Код) = Тип("Строка") Тогда

		Возврат Код;

	ИначеЕсли ТипЗнч(Риск) = Тип("Соответствие") И ТипЗнч(Риск.Получить("code")) = Тип("Строка") Тогда

		Возврат Риск.Получить("code");

	Иначе

		Возврат "";

	КонецЕсли;

КонецФункции

// Относится ли код риска к классу защиты (приостанавливает гарантию). Решение #5: каждый риск компоненты
// и шлюза приостанавливает гарантию (известные коды: R_PROTECTION, R_WRITE, R_DEFERRED, R_CREDENTIALS, R_RELAUNCH,
// R_CLIENT_CONTEXT, R_UNKNOWN_EFFECT, R_CONFIRMED_REASONS). Список не является разрешающим: код вне списка тоже класс защиты
// (fail closed), чтобы новый код риска компоненты не прошел без приостановки. Исключение - L_LOOKUP: это метка
// встроенного поиска по защищенному значению (ВердиктВстроенныхПоисковСтрогогоРежима), а не риск действия.
//
// Параметры:
//  Код - Строка - код риска
//
// Возвращаемое значение:
//  Булево - Истина для любого непустого кода, кроме L_LOOKUP
//
&НаКлиенте
Функция КлассЗащитыПоКодуРиска(Код)

	Возврат НЕ ПустаяСтрока(Код) И Код <> "L_LOOKUP";

КонецФункции

// Сохраняет признак "гарантия приостановлена" без снимка регламентных заданий.
// Уже сохраненный признак не перезаписывается: сравнивать надо с самым ранним снимком.
//
&НаСервереБезКонтекста
Процедура ЗаписатьПриостановкуГарантииНаСервере()

	Если ПрочитатьПриостановкуГарантииНаСервере() Тогда

		Возврат;

	КонецЕсли;

	Запись = Новый Структура("Приостановлена, Момент, СнимокРегламентных, ПричинаБезСнимка",
		Истина, ТекущаяДатаСеанса(), Неопределено, "снимок еще не получен");
	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "СтрогийГарантияПриостановлена", Запись);

КонецПроцедуры

// Второй шаг приостановки: дописывает в сохраненный признак снимок регламентных заданий.
// Сбой чтения заданий (нет прав) признак не снимает: в нем остается причина.
//
// Возвращаемое значение:
//  Строка - пустая строка при успехе, иначе причина сбоя
//
&НаСервереБезКонтекста
Функция ДополнитьПриостановкуСнимкомЗаданийНаСервере()

	Запись = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтрогийГарантияПриостановлена");

	Если ТипЗнч(Запись) <> Тип("Структура") Или НЕ Запись.Свойство("СнимокРегламентных") Тогда

		Возврат "признак приостановки не найден";

	КонецЕсли;

	Если Запись.СнимокРегламентных <> Неопределено Тогда

		Возврат "";

	КонецЕсли;

	Попытка
		Запись.СнимокРегламентных = СнимокРегламентныхЗаданийНаСервере();
		Запись.ПричинаБезСнимка = "";
		Причина = "";
	Исключение
		Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Запись.ПричинаБезСнимка = "снимок не получен: " + Причина;
	КонецПопытки;

	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "СтрогийГарантияПриостановлена", Запись);

	Возврат Причина;

КонецФункции

// Снимок регламентных заданий базы: по нему при восстановлении доверия видно, что изменилось
// после приостановки (платформа не хранит время изменения задания).
//
// Возвращаемое значение:
//  Массив - Структуры: Имя, Ключ, Метод, Использование, Расписание (внутреннее представление строкой)
//
&НаСервереБезКонтекста
Функция СнимокРегламентныхЗаданийНаСервере()

	Снимок = Новый Массив;

	Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл

		Снимок.Добавить(Новый Структура("Имя, Ключ, Метод, Использование, Расписание",
			Задание.Метаданные.Имя, Задание.Ключ, Задание.Метаданные.ИмяМетода, Задание.Использование,
			ЗначениеВСтрокуВнутр(Задание.Расписание)));

	КонецЦикла;

	Возврат Снимок;

КонецФункции

// Текст для человека перед восстановлением доверия: активные фоновые задания, регламентные задания,
// измененные после приостановки, и текущие настройки защиты (без токена и ключей).
//
// Возвращаемое значение:
//  Строка - текст обзора
//
&НаСервереБезКонтекста
Функция СписокДляВосстановленияДоверияНаСервере()

	Текст = "Активные фоновые задания:" + Символы.ПС;
	Отбор = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);
	Активные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);

	Для Каждого Задание Из Активные Цикл

		Текст = Текст + "  " + Задание.Наименование + " [" + Задание.ИмяМетода + "]" + Символы.ПС;

	КонецЦикла;

	Если Активные.Количество() = 0 Тогда

		Текст = Текст + "  нет" + Символы.ПС;

	КонецЕсли;

	Запись = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтрогийГарантияПриостановлена");
	Исходные = Неопределено;

	Если ТипЗнч(Запись) = Тип("Структура") Тогда

		Запись.Свойство("СнимокРегламентных", Исходные);

	КонецЕсли;

	ПричинаБезСнимка = Неопределено;

	Если ТипЗнч(Запись) = Тип("Структура") И Запись.Свойство("ПричинаБезСнимка", ПричинаБезСнимка)
		И НЕ ПустаяСтрока(ПричинаБезСнимка) Тогда

		Текст = Текст + Символы.ПС + ПричинаБезСнимка + Символы.ПС;

	КонецЕсли;

	Текст = Текст + Символы.ПС + "Регламентные задания, измененные после приостановки:" + Символы.ПС
		+ РазличияРегламентныхЗаданий(Исходные, СнимокРегламентныхЗаданийНаСервере());

	Возврат Текст + Символы.ПС + "Текущие настройки защиты:" + Символы.ПС + ОписаниеНастроекЗащитыДляОбзора();

КонецФункции

// Сравнивает снимок регламентных заданий на момент приостановки с текущим состоянием.
//
// Параметры:
//  Исходные - Массив, Неопределено - снимок на момент приостановки
//  Текущие - Массив - текущий снимок
//
// Возвращаемое значение:
//  Строка - построчный список различий
//
&НаСервереБезКонтекста
Функция РазличияРегламентныхЗаданий(Исходные, Текущие)

	Если ТипЗнч(Исходные) <> Тип("Массив") Тогда

		Возврат "  снимок не найден" + Символы.ПС;

	КонецЕсли;

	Результат = "";
	Было = Новый Соответствие;

	Для Каждого Элемент Из Исходные Цикл

		Было.Вставить(Элемент.Имя + "|" + Элемент.Ключ + "|" + Элемент.Метод, Элемент);

	КонецЦикла;

	Для Каждого Элемент Из Текущие Цикл

		Ключ = Элемент.Имя + "|" + Элемент.Ключ + "|" + Элемент.Метод;
		Прежний = Было.Получить(Ключ);
		Было.Удалить(Ключ);

		Если Прежний = Неопределено Тогда

			Результат = Результат + "  новое: " + Ключ + Символы.ПС;

		ИначеЕсли Прежний.Использование <> Элемент.Использование Или Прежний.Расписание <> Элемент.Расписание Тогда

			Результат = Результат + "  изменено: " + Ключ + Символы.ПС;

		Иначе

			// Задание не менялось после приостановки

		КонецЕсли;

	КонецЦикла;

	Для Каждого Элемент Из Было Цикл

		Результат = Результат + "  удалено: " + Элемент.Ключ + Символы.ПС;

	КонецЦикла;

	Возврат ?(Результат = "", "  нет" + Символы.ПС, Результат);

КонецФункции

// Описание настроек защиты для обзора человеком: флажки и размеры наборов правил.
// Токен подключения и ключ шифрования не выводятся.
//
// Возвращаемое значение:
//  Строка - построчное описание
//
&НаСервереБезКонтекста
Функция ОписаниеНастроекЗащитыДляОбзора()

	Точная = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ИспользоватьТочнуюАнонимизацию");
	Строгий = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтрогийРежимАнонимизации");
	Правила = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v2");
	Регулярные = ХранилищеОбщихНастроек.Загрузить("ExecuteQueryRegexRules.v1", "rules");

	Возврат "  точная анонимизация: " + Строка(Точная) + Символы.ПС
		+ "  строгий режим: " + Строка(Строгий) + Символы.ПС
		+ "  правила полей v2, размер: " + СтрДлина(ЗначениеВСтрокуВнутр(Правила)) + Символы.ПС
		+ "  правила регулярных выражений, размер: " + СтрДлина(ЗначениеВСтрокуВнутр(Регулярные)) + Символы.ПС;

КонецФункции

// Обработчик команды "Восстановить доверие": показывает обзор сервера в существующей форме подтверждения.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда
//
&НаКлиенте
Процедура ВосстановитьДоверие(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Режим", "restore_trust");
	ПараметрыФормы.Вставить("Риски", "Данные, записанные за время приостановки, будут считаться достоверными.");
	ПараметрыФормы.Вставить("ТекстКПодтверждению", СписокДляВосстановленияДоверияНаСервере());
	ОткрытьФорму(
		"ВнешняяОбработка.MCPToolkit.Форма.ФормаСтрогогоПодтверждения",
		ПараметрыФормы,
		ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ПослеВопросаВосстановленияДоверия", ЭтаФорма),
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

// Завершает восстановление доверия: при подтверждении сбрасывает сохраненный признак приостановки.
//
// Параметры:
//  Результат - Строка, Неопределено - "approved", если человек подтвердил восстановление
//  ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура ПослеВопросаВосстановленияДоверия(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> "approved" Тогда

		Возврат;

	КонецЕсли;

	СнятьПриостановкуГарантииНаСервере();
	СостояниеЗащиты.ГарантияПриостановлена = Ложь;
	ДобавитьВЛог("Доверие восстановлено человеком, гарантия строгого режима возобновлена");
	ОбновитьОтображениеСостоянияЗащиты();

КонецПроцедуры

// Записывает Приостановлена = Ложь. Единственный вызывающий - ответ человека на вопрос восстановления доверия.
//
&НаСервереБезКонтекста
Процедура СнятьПриостановкуГарантииНаСервере()

	Запись = Новый Структура("Приостановлена, Момент, СнимокРегламентных", Ложь, ТекущаяДатаСеанса(), Новый Массив);
	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "СтрогийГарантияПриостановлена", Запись);

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: СТРУКТУРНЫЕ СТРОКОВЫЕ ПОЛЯ
// ─────────────────────────────────────────────────────────────────────────────────

// Загружает список структурных полей из хранилища настроек. Все строки загружаются неподтвержденными:
// хранилищу доверять нельзя (в режиме маскирования его мог переписать код клиента), поле попадает в снимок
// правил строгого режима только после проверки значений и ответа человека (ПроверитьИПрименитьСтруктурныеПоля).
//
&НаСервере
Процедура ЗагрузитьСтруктурныеПоляИзХранилища()

	СтруктурныеПоля.Очистить();
	Сохраненные = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтруктурныеПоляСтрогогоРежима");

	Если ТипЗнч(Сохраненные) <> Тип("Массив") Тогда

		Возврат;

	КонецЕсли;

	Для Каждого ИдПоля Из Сохраненные Цикл

		Если ТипЗнч(ИдПоля) = Тип("Строка") И НЕ ПустаяСтрока(ИдПоля) Тогда

			СтрокаПоля = СтруктурныеПоля.Добавить();
			СтрокаПоля.ИдПоля = ИдПоля;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Сохраняет список структурных полей в хранилище настроек.
//
// Параметры:
//  Идентификаторы - Массив - идентификаторы полей (Строка)
//
&НаСервереБезКонтекста
Процедура СохранитьСтруктурныеПоляНаСервере(Знач Идентификаторы)

	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "СтруктурныеПоляСтрогогоРежима", Идентификаторы);

КонецПроцедуры

// Идентификаторы полей из таблицы формы.
//
// Возвращаемое значение:
//  Массив - идентификаторы полей (Строка)
//
&НаКлиенте
Функция ИдентификаторыСтруктурныхПолей()

	Идентификаторы = Новый Массив;

	Для Каждого СтрокаПоля Из СтруктурныеПоля Цикл

		Идентификаторы.Добавить(СтрокаПоля.ИдПоля);

	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

// Строка таблицы структурных полей по идентификатору (без учета регистра).
//
// Параметры:
//  ИдПоля - Строка - идентификатор поля
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - найденная строка или Неопределено
//
&НаКлиенте
Функция НайтиСтрокуСтруктурногоПоля(ИдПоля)

	Для Каждого СтрокаПоля Из СтруктурныеПоля Цикл

		Если ВРег(СтрокаПоля.ИдПоля) = ВРег(ИдПоля) Тогда

			Возврат СтрокаПоля;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Обработчик команды "Добавить": запрашивает идентификатор поля.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда
//
&НаКлиенте
Процедура ДобавитьСтруктурноеПоле(Команда)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ПослеВводаСтруктурногоПоля", ЭтаФорма), "",
		"Поле: Вид.Объект.Поле или Вид.Объект.ТабличнаяЧасть.Поле", 300, Ложь);

КонецПроцедуры

// Завершает добавление: проверяет поле на сервере и добавляет его в список неподтвержденным.
//
// Параметры:
//  ВведеннаяСтрока - Строка, Неопределено - введенный идентификатор; Неопределено, если ввод отменен
//  ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура ПослеВводаСтруктурногоПоля(ВведеннаяСтрока, ДополнительныеПараметры) Экспорт

	Если ВведеннаяСтрока = Неопределено Тогда

		Возврат;

	КонецЕсли;

	ПроверкаИмени = ПроверитьИмяСтруктурногоПоляНаСервере(ВведеннаяСтрока);

	Если НЕ ПустаяСтрока(ПроверкаИмени.Ошибка) Тогда

		ПоказатьПредупреждение(, ПроверкаИмени.Ошибка);

		Возврат;

	КонецЕсли;

	Если НайтиСтрокуСтруктурногоПоля(ПроверкаИмени.ИдПоля) <> Неопределено Тогда

		ПоказатьПредупреждение(, "Поле уже есть в списке");

		Возврат;

	КонецЕсли;

	СтрокаПоля = СтруктурныеПоля.Добавить();
	СтрокаПоля.ИдПоля = ПроверкаИмени.ИдПоля;
	СохранитьСтруктурныеПоляНаСервере(ИдентификаторыСтруктурныхПолей());
	ДобавитьВЛог("Структурное поле добавлено в список, не подтверждено: " + ПроверкаИмени.ИдПоля);

КонецПроцедуры

// Проверяет идентификатор поля по метаданным: поле есть среди полей политики, это не Наименование,
// тип поля - только строка.
//
// Параметры:
//  ИдПоля - Строка - введенный идентификатор
//
// Возвращаемое значение:
//  Структура - ИдПоля (Строка, идентификатор в каноническом виде), Ошибка (Строка; пустая, если поле подходит)
//
&НаСервере
Функция ПроверитьИмяСтруктурногоПоляНаСервере(Знач ИдПоля)

	Обработка = РеквизитФормыВЗначение("Объект");

	Возврат Обработка.ПроверитьИдентификаторСтруктурногоПоля(ИдПоля);

КонецФункции

// Обработчик команды "Удалить": убирает поле из списка и из снимка правил строгого режима. Ужесточение
// не требует подтверждения. Вызов, уже проверенный до удаления, сохраняет метки своей проверки; все проверки
// после удаления идут с закрытым полем: кэша вердиктов по эпохам нет, политика собирается на каждую проверку.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда
//
&НаКлиенте
Процедура УдалитьСтруктурноеПоле(Команда)

	ТекущаяСтрока = Элементы.СтруктурныеПоляПоле.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда

		Возврат;

	КонецЕсли;

	ИдПоля = ТекущаяСтрока.ИдПоля;

	Если СнимокПравилСтрогогоРежима <> Неопределено
		И ТипЗнч(СнимокПравилСтрогогоРежима.СтруктурныеПоля) = Тип("Соответствие") Тогда

		СнимокПравилСтрогогоРежима.СтруктурныеПоля.Удалить(ВРег(ИдПоля));

	КонецЕсли;

	СтруктурныеПоля.Удалить(ТекущаяСтрока);
	СохранитьСтруктурныеПоляНаСервере(ИдентификаторыСтруктурныхПолей());
	ДобавитьВЛог("Структурное поле удалено из списка и закрыто: " + ИдПоля);

КонецПроцедуры

// Обработчик команды "Проверить и применить".
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда
//
&НаКлиенте
Процедура ПроверитьИПрименитьСтруктурныеПоля(Команда)

	НачатьПодтверждениеСтруктурныхПолей();

КонецПроцедуры

// Обработчик ожидания: после включения строгого режима один раз предлагает подтвердить сохраненные поля.
// Не блокирует включение и запуск сервера.
//
&НаКлиенте
Процедура ПредложитьПодтвердитьСтруктурныеПоля() Экспорт

	Если СостояниеЗащиты.Строгий Тогда

		НачатьПодтверждениеСтруктурныхПолей();

	КонецЕсли;

КонецПроцедуры

// Проверяет значения всех полей списка одним вызовом сервера, показывает результаты в таблице и задает
// человеку один вопрос. Без строгого режима подтверждать нечего.
//
&НаКлиенте
Процедура НачатьПодтверждениеСтруктурныхПолей()

	Если НЕ СостояниеЗащиты.Строгий ИЛИ СнимокПравилСтрогогоРежима = Неопределено Тогда

		ПоказатьПредупреждение(, "Подтверждение действует только в строгом режиме");

		Возврат;

	КонецЕсли;

	Если СтруктурныеПоля.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Идентификаторы = ИдентификаторыСтруктурныхПолей();
	Итог = ПоказатьРезультатыПроверкиСтруктурныхПолей(
		ПроверитьСтруктурныеПоляНаСервере(Идентификаторы, СрезПравилДляПроверкиСтруктурныхПолей(Идентификаторы)));

	Контекст = Новый Структура("Идентификаторы, Эпоха, Закрытые", Итог.Кандидаты, ЭпохаЗащиты, Итог.Закрытые);

	Если Итог.Кандидаты.Количество() = 0 Тогда

		Если Итог.Закрытые.Количество() = 0 Тогда

			ПоказатьПредупреждение(, "Нет полей, которые можно открыть:" + Итог.ТекстСписка);

		Иначе

			СпроситьОбУдаленииПравилСтруктурныхПолей(Контекст);

		КонецЕсли;

		Возврат;

	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОСтруктурныхПолях", ЭтаФорма, Контекст),
		"Структурные поля:" + Итог.ТекстСписка + Символы.ПС + Символы.ПС + "Открыть эти поля для строгого режима? "
		+ "Значения этих полей будут возвращаться и сравниваться без маскирования.",
		РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Структурные поля");

КонецПроцедуры

// Записывает результаты проверки в таблицу формы и собирает текст для вопроса.
//
// Параметры:
//  Проверки - Массив - результаты ПроверитьСтруктурныеПоляНаСервере
//
// Возвращаемое значение:
//  Структура - Кандидаты (Массив, поля без ошибки проверки; идентификаторы в виде, который использует политика),
//              ТекстСписка (Строка, по строке на поле),
//              Закрытые (Массив, поля, закрытые точным правилом анонимизации: Структуры ИдПоля, ИсходныйИд,
//              КлючПравила)
//
&НаКлиенте
Функция ПоказатьРезультатыПроверкиСтруктурныхПолей(Проверки)

	Итог = Новый Структура("Кандидаты, ТекстСписка, Закрытые", Новый Массив, "", Новый Массив);
	ИдентификаторыИзменены = Ложь;

	Для Каждого ПроверкаПоля Из Проверки Цикл

		ТекстПроверки = ТекстПроверкиСтруктурногоПоля(ПроверкаПоля);
		СтрокаПоля = НайтиСтрокуСтруктурногоПоля(ПроверкаПоля.ИсходныйИд);
		СтрокаПоля.Проверка = ТекстПроверки;
		Итог.ТекстСписка = Итог.ТекстСписка + Символы.ПС + ?(ПроверкаПоля.НеИменаМетаданных > 0, "(!) ", "")
			+ ПроверкаПоля.ИдПоля + ": " + ТекстПроверки;

		Если ПустаяСтрока(ПроверкаПоля.Ошибка) Тогда

			Итог.Кандидаты.Добавить(ПроверкаПоля.ИдПоля);
			ИдентификаторыИзменены = ИдентификаторыИзменены ИЛИ СтрокаПоля.ИдПоля <> ПроверкаПоля.ИдПоля;
			СтрокаПоля.ИдПоля = ПроверкаПоля.ИдПоля;

		ИначеЕсли ПроверкаПоля.МожноУдалитьПравило Тогда

			Итог.Закрытые.Добавить(Новый Структура("ИдПоля, ИсходныйИд, КлючПравила",
				ПроверкаПоля.ИдПоля, ПроверкаПоля.ИсходныйИд, ПроверкаПоля.КлючПравила));

		КонецЕсли;

	КонецЦикла;

	Если ИдентификаторыИзменены Тогда

		СохранитьСтруктурныеПоляНаСервере(ИдентификаторыСтруктурныхПолей());

	КонецЕсли;

	Возврат Итог;

КонецФункции

// Результат проверки одного поля как текст для таблицы и вопроса.
//
// Параметры:
//  ПроверкаПоля - Структура - результат проверки: Различных, НеИменаМетаданных, Ошибка
//
// Возвращаемое значение:
//  Строка - текст результата
//
&НаКлиенте
Функция ТекстПроверкиСтруктурногоПоля(ПроверкаПоля)

	Если НЕ ПустаяСтрока(ПроверкаПоля.Ошибка) Тогда

		Если ПроверкаПоля.НеИменаМетаданных > 0 Тогда

			Возврат ПроверкаПоля.Ошибка + "; не имена метаданных: " + Формат(ПроверкаПоля.НеИменаМетаданных, "ЧГ=0")
				+ " из " + Формат(ПроверкаПоля.Различных, "ЧГ=0") + " различных значений";

		КонецЕсли;

		Возврат ПроверкаПоля.Ошибка;

	КонецЕсли;

	Если ПроверкаПоля.НеИменаМетаданных = 0 Тогда

		Возврат "Различных значений: " + Формат(ПроверкаПоля.Различных, "ЧГ=0") + ", все - имена метаданных";

	КонецЕсли;

	Возврат "Не имена метаданных: " + Формат(ПроверкаПоля.НеИменаМетаданных, "ЧГ=0") + " из "
		+ Формат(ПроверкаПоля.Различных, "ЧГ=0") + " различных значений";

КонецФункции

// Срез правил для проверки структурных полей: правила объектов этих полей. Структурные поля в срезе пусты:
// проверяемое поле сервер помечает подтвержденным сам, по каноническому идентификатору. Снимок не меняется,
// на сервер уходит малая часть правил.
//
// Параметры:
//  Идентификаторы - Массив - идентификаторы проверяемых полей (Строка)
//
// Возвращаемое значение:
//  Структура - срез правил (СрезПравилДляПолитики)
//
&НаКлиенте
Функция СрезПравилДляПроверкиСтруктурныхПолей(Идентификаторы)

	Срез = СрезПравилДляПолитики(СнимокПравилСтрогогоРежима, Идентификаторы);
	Срез.СтруктурныеПоля = Новый Соответствие;

	Возврат Срез;

КонецФункции

// Проверка значений полей списка на сервере. Значения не покидают сервер: возвращаются только счетчики.
// Поле, которое правила точной анонимизации оставят закрытым и после подтверждения, получает Ошибку с причиной.
//
// Параметры:
//  Идентификаторы - Массив - идентификаторы полей (Строка)
//  ПравилаЗащиты - Структура - срез правил (СрезПравилДляПроверкиСтруктурныхПолей)
//
// Возвращаемое значение:
//  Массив - по одной структуре на поле: ИдПоля (в виде, который использует политика), ИсходныйИд (как в списке),
//           Строк, Различных, НеИменаМетаданных, Ошибка, КлючПравила (Строка, ключ точного правила анонимизации,
//           которое закрывает поле; пустая строка, если поле закрыто не им), МожноУдалитьПравило (Булево: без этого
//           правила поле открывается и в его значениях только имена метаданных)
//
&НаСервере
Функция ПроверитьСтруктурныеПоляНаСервере(Знач Идентификаторы, Знач ПравилаЗащиты)

	Обработка = РеквизитФормыВЗначение("Объект");
	Проверки = Новый Массив;

	Для Каждого ИдПоля Из Идентификаторы Цикл

		ПроверкаПоля = Обработка.ПроверитьЗначенияСтруктурногоПоля(ИдПоля);
		ПроверкаПоля.Вставить("ИсходныйИд", ИдПоля);
		ПроверкаПоля.Вставить("КлючПравила", "");
		ПроверкаПоля.Вставить("МожноУдалитьПравило", Ложь);

		Если ПустаяСтрока(ПроверкаПоля.Ошибка) Тогда

			ПроверкаПоля.Ошибка = Обработка.ПричинаЗакрытостиСтруктурногоПоля(ПроверкаПоля.ИдПоля, ПравилаЗащиты);
			ПроверкаПоля.КлючПравила = КлючПравилаЗакрывающегоПоле(ПроверкаПоля, ПравилаЗащиты);
			ПроверкаПоля.МожноУдалитьПравило = НЕ ПустаяСтрока(ПроверкаПоля.КлючПравила)
				И ПолеОткрываетсяБезПравила(Обработка, ПроверкаПоля, ПравилаЗащиты);

		КонецЕсли;

		Проверки.Добавить(ПроверкаПоля);

	КонецЦикла;

	Возврат Проверки;

КонецФункции

// Открывается ли поле, если убрать закрывающее его правило. Правило убирается только из копии среза: переданный
// срез не меняется, ничего не удаляется. Значения поля должны быть именами метаданных.
//
// Параметры:
//  Обработка - ВнешняяОбработкаОбъект - объект обработки
//  ПроверкаПоля - Структура - результат проверки поля: ИдПоля, НеИменаМетаданных, КлючПравила
//  ПравилаЗащиты - Структура - срез правил (СрезПравилДляПроверкиСтруктурныхПолей)
//
// Возвращаемое значение:
//  Булево - Истина, если поле открывается без правила
//
&НаСервереБезКонтекста
Функция ПолеОткрываетсяБезПравила(Обработка, ПроверкаПоля, ПравилаЗащиты)

	Если ПроверкаПоля.НеИменаМетаданных > 0 Тогда

		Возврат Ложь;

	КонецЕсли;

	БезПравила = Новый Соответствие;

	Для Каждого Правило Из ПравилаЗащиты.ТочныеПравила Цикл

		Если Правило.Ключ <> ПроверкаПоля.КлючПравила Тогда

			БезПравила.Вставить(Правило.Ключ, Правило.Значение);

		КонецЕсли;

	КонецЦикла;

	Срез = Новый Структура("ТочныеПравила, РазрешенныеКоды, СтруктурныеПоля", БезПравила,
		ПравилаЗащиты.РазрешенныеКоды, ПравилаЗащиты.СтруктурныеПоля);

	Возврат ПустаяСтрока(Обработка.ПричинаЗакрытостиСтруктурногоПоля(ПроверкаПоля.ИдПоля, Срез));

КонецФункции

// Ключ точного правила анонимизации, которое закрывает поле: правило для поля есть в срезе, а причина закрытости
// уже получена. ПричинаЗакрытостиСтруктурногоПоля проверяет это правило первым, поэтому при его наличии причина - оно.
//
// Параметры:
//  ПроверкаПоля - Структура - результат проверки поля: ИдПоля, Ошибка (причина закрытости)
//  ПравилаЗащиты - Структура - срез правил (СрезПравилДляПроверкиСтруктурныхПолей)
//
// Возвращаемое значение:
//  Строка - ключ правила (ВРег пути поля); пустая строка, если поле открывается или закрыто не правилом
//
&НаСервереБезКонтекста
Функция КлючПравилаЗакрывающегоПоле(ПроверкаПоля, ПравилаЗащиты)

	Если ПустаяСтрока(ПроверкаПоля.Ошибка) ИЛИ ТипЗнч(ПравилаЗащиты.ТочныеПравила) <> Тип("Соответствие") Тогда

		Возврат "";

	КонецЕсли;

	Ключ = ВРег(ПроверкаПоля.ИдПоля);
	Правило = ПравилаЗащиты.ТочныеПравила.Получить(Ключ);

	Если ТипЗнч(Правило) = Тип("Структура") И Правило.Свойство("action") И Правило.action = "anonymize" Тогда

		Возврат Ключ;

	КонецЕсли;

	Возврат "";

КонецФункции

// Завершает подтверждение: при ответе "Да" помещает проверенные поля в снимок правил строгого режима.
// Поле, удаленное из списка за время вопроса, пропускается. Если за время вопроса строгий режим выключили
// или эпоха сменилась, ответ отбрасывается.
//
// Параметры:
//  Результат - КодВозвратаДиалога - ответ человека
//  Контекст - Структура - Идентификаторы (Массив, поля без ошибок проверки), Эпоха (Число),
//             Закрытые (Массив, поля, закрытые точным правилом анонимизации)
//
&НаКлиенте
Процедура ПослеВопросаОСтруктурныхПолях(Результат, Контекст) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда

		Возврат;

	КонецЕсли;

	ПодтвердитьСтруктурныеПоляПослеВопроса(Контекст);
	СпроситьОбУдаленииПравилСтруктурныхПолей(Контекст);

КонецПроцедуры

// Помещает проверенные поля в снимок правил строгого режима и отмечает их в таблице.
//
// Параметры:
//  Контекст - Структура - Идентификаторы (Массив, поля без ошибок проверки), Эпоха (Число)
//
&НаКлиенте
Процедура ПодтвердитьСтруктурныеПоляПослеВопроса(Контекст)

	Если НЕ СостояниеЗащиты.Строгий ИЛИ Контекст.Эпоха <> ЭпохаЗащиты ИЛИ СнимокПравилСтрогогоРежима = Неопределено Тогда

		ДобавитьВЛог("Структурные поля не применены: строгий режим переключался во время вопроса");

		Возврат;

	КонецЕсли;

	Список = "";

	Для Каждого ИдПоля Из Контекст.Идентификаторы Цикл

		СтрокаПоля = НайтиСтрокуСтруктурногоПоля(ИдПоля);

		Если СтрокаПоля = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СнимокПравилСтрогогоРежима.СтруктурныеПоля.Вставить(ВРег(ИдПоля), Истина);
		СтрокаПоля.Подтверждено = Истина;
		Список = Список + ?(ПустаяСтрока(Список), "", ", ") + ИдПоля;

	КонецЦикла;

	ДобавитьВЛог("Структурные поля подтверждены: " + Список);

КонецПроцедуры

// Один вопрос о полях, которые закрыты только точным правилом анонимизации: удалить правила и подтвердить поля.
// Поля, закрытые иначе, в вопрос не входят. Если за время диалога строгий режим переключился, вопроса нет.
//
// Параметры:
//  Контекст - Структура - Эпоха (Число), Закрытые (Массив: Структуры ИдПоля, ИсходныйИд, КлючПравила)
//
&НаКлиенте
Процедура СпроситьОбУдаленииПравилСтруктурныхПолей(Контекст)

	Если Контекст.Закрытые.Количество() = 0 ИЛИ НЕ СостояниеЗащиты.Строгий ИЛИ Контекст.Эпоха <> ЭпохаЗащиты
		ИЛИ СнимокПравилСтрогогоРежима = Неопределено Тогда

		Возврат;

	КонецЕсли;

	Список = "";

	Для Каждого Закрытое Из Контекст.Закрытые Цикл

		Список = Список + Символы.ПС + Закрытое.ИдПоля;

	КонецЦикла;

	Текст = ?(Контекст.Закрытые.Количество() = 1,
		"Поле" + Список + " закрыто правилом анонимизации. Удалить правило и подтвердить поле как структурное?",
		"Поля закрыты правилами анонимизации:" + Список + Символы.ПС
			+ "Удалить правила и подтвердить поля как структурные?");
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбУдаленииПравил", ЭтаФорма, Контекст),
		Текст, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Правила анонимизации");

КонецПроцедуры

// Завершает вопрос об удалении правил: при ответе "Да" удаляет правила полей из хранилища и из снимка строгого
// режима, повторно проверяет каждое поле и подтверждает прошедшие проверку как структурные. Снимок целиком из
// хранилища не перечитывается. Если за время вопроса строгий режим переключился, ответ отбрасывается.
//
// Параметры:
//  Результат - КодВозвратаДиалога - ответ человека
//  Контекст - Структура - Эпоха (Число), Закрытые (Массив: Структуры ИдПоля, ИсходныйИд, КлючПравила)
//
&НаКлиенте
Процедура ПослеВопросаОбУдаленииПравил(Результат, Контекст) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда

		Возврат;

	КонецЕсли;

	Если НЕ СостояниеЗащиты.Строгий ИЛИ Контекст.Эпоха <> ЭпохаЗащиты ИЛИ СнимокПравилСтрогогоРежима = Неопределено Тогда

		ДобавитьВЛог("Правила анонимизации не удалены: строгий режим переключался во время вопроса");

		Возврат;

	КонецЕсли;

	Подтвержденные = Новый Массив;

	Для Каждого Закрытое Из Контекст.Закрытые Цикл

		СтрокаПоля = НайтиСтрокуСтруктурногоПоля(Закрытое.ИсходныйИд);

		Если СтрокаПоля = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		УдалитьПравилоТочнойАнонимизации(Закрытое.КлючПравила);
		ДобавитьВЛог("Правило точной анонимизации удалено по решению человека: " + Закрытое.ИдПоля);

		Если ПодтвердитьПолеПослеУдаленияПравила(СтрокаПоля, Закрытое.ИдПоля) Тогда

			Подтвержденные.Добавить(Закрытое.ИдПоля);

		КонецЕсли;

	КонецЦикла;

	Если Подтвержденные.Количество() > 0 Тогда

		СохранитьСтруктурныеПоляНаСервере(ИдентификаторыСтруктурныхПолей());
		ДобавитьВЛог("Структурные поля подтверждены: " + СоединитьМассив(Подтвержденные));

	КонецЕсли;

КонецПроцедуры

// Повторно проверяет поле после удаления правила и, если оно открывается, подтверждает его как структурное.
// Поле, в значениях которого есть не имена метаданных, не подтверждается: человек увидит их при следующем вызове
// "Проверить и применить", как у любого другого поля.
//
// Параметры:
//  СтрокаПоля - СтрокаТаблицыЗначений - строка таблицы структурных полей
//  ИдПоля - Строка - идентификатор поля в виде, который использует политика
//
// Возвращаемое значение:
//  Булево - Истина, если поле подтверждено
//
&НаКлиенте
Функция ПодтвердитьПолеПослеУдаленияПравила(СтрокаПоля, ИдПоля)

	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ИдПоля);
	ПроверкаПоля = ПроверитьСтруктурныеПоляНаСервере(Идентификаторы,
		СрезПравилДляПроверкиСтруктурныхПолей(Идентификаторы))[0];
	СтрокаПоля.Проверка = ТекстПроверкиСтруктурногоПоля(ПроверкаПоля);

	Если НЕ ПустаяСтрока(ПроверкаПоля.Ошибка) ИЛИ ПроверкаПоля.НеИменаМетаданных > 0 Тогда

		Возврат Ложь;

	КонецЕсли;

	СтрокаПоля.ИдПоля = ПроверкаПоля.ИдПоля;
	СтрокаПоля.Подтверждено = Истина;
	СнимокПравилСтрогогоРежима.СтруктурныеПоля.Вставить(ВРег(ПроверкаПоля.ИдПоля), Истина);

	Возврат Истина;

КонецФункции

// Удаляет точное правило анонимизации из снимка строгого режима и из хранилища настроек.
//
// Параметры:
//  КлючПравила - Строка - путь источника правила в верхнем регистре
//
&НаКлиенте
Процедура УдалитьПравилоТочнойАнонимизации(КлючПравила)

	УдалитьПравилоИзХранилищаНаСервере(КлючПравила);
	ОбновитьСводкуПравилТочнойАнонимизацииНаСервере();

	Если ТипЗнч(СнимокПравилСтрогогоРежима.ТочныеПравила) = Тип("Соответствие") Тогда

		СнимокПравилСтрогогоРежима.ТочныеПравила.Удалить(КлючПравила);

	КонецЕсли;

КонецПроцедуры

// Удаляет из сохраненного набора точных правил анонимизации правила action = anonymize с этим путем источника.
// Набор читается из ExecuteQueryFieldRules.v2 (при отсутствии - из v1) и сохраняется туда же в прежнем формате:
// остальные правила и настройки набора не меняются.
//
// Параметры:
//  КлючПравила - Строка - путь источника правила в верхнем регистре
//
&НаСервереБезКонтекста
Процедура УдалитьПравилоИзХранилищаНаСервере(Знач КлючПравила)

	ИмяНастройки = "ExecuteQueryFieldRules.v2";
	Набор = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", ИмяНастройки);

	Если ТипЗнч(Набор) <> Тип("Структура") ИЛИ НЕ Набор.Свойство("Правила") Тогда

		ИмяНастройки = "ExecuteQueryFieldRules.v1";
		Набор = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", ИмяНастройки);

	КонецЕсли;

	Если ТипЗнч(Набор) <> Тип("Структура") ИЛИ НЕ Набор.Свойство("Правила") Тогда

		Возврат;

	КонецЕсли;

	Правила = Набор.Правила;
	Количество = Правила.Количество();

	// Обход с конца: удаление строки не сдвигает индексы еще не просмотренных.
	Для Номер = 1 По Количество Цикл

		Индекс = Количество - Номер;
		Правило = Правила.Получить(Индекс);

		Если ТипЗнч(Правило.source_path) = Тип("Строка") И ВРег(Правило.source_path) = КлючПравила
			И Правило.action = "anonymize" Тогда

			Правила.Удалить(Индекс);

		КонецЕсли;

	КонецЦикла;

	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", ИмяНастройки, Набор);

КонецПроцедуры

// Сбрасывает подтверждения и результаты проверки в таблице при переключении строгого режима и снимает
// отложенное предложение подтвердить поля.
//
&НаКлиенте
Процедура СброситьПодтверждениеСтруктурныхПолей()

	ОтключитьОбработчикОжидания("ПредложитьПодтвердитьСтруктурныеПоля");

	Для Каждого СтрокаПоля Из СтруктурныеПоля Цикл

		СтрокаПоля.Подтверждено = Ложь;
		СтрокаПоля.Проверка = "";

	КонецЦикла;

КонецПроцедуры

// После включения строгого режима один раз предлагает подтвердить сохраненные поля через обработчик ожидания,
// чтобы не задерживать включение и запуск сервера.
//
&НаКлиенте
Процедура ПредложитьПодтверждениеСтруктурныхПолейПослеВключения()

	Если СостояниеЗащиты.Строгий И СтруктурныеПоля.Количество() > 0 Тогда

		ПодключитьОбработчикОжидания("ПредложитьПодтвердитьСтруктурныеПоля", 1, Истина);

	КонецЕсли;

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// СТРОГИЙ РЕЖИМ: МАСКИРОВАНИЕ ВЫВОДА ПО ПРОИСХОЖДЕНИЮ
// ─────────────────────────────────────────────────────────────────────────────────

// Маскирование результата инструмента в строгом режиме только по меткам происхождения путей вывода: словарь,
// regex и эвристики не используются. Ответ собирается заново: в него попадают только поля ДопустимыеПоляОтвета,
// каждое уже замаскированное; остальные поля не отправляются. Неуспешный результат сводится к фиксированной ошибке.
// Метки не наследуются: узел без своей метки маскируется в изолированной области ответа (unlabeled). Описание
// ссылки получает правило ссылки только на пути с меткой ref, по форме узла - никогда. Изолированные области
// создаются на один ответ и после него отбрасываются. Вне строгого режима результат возвращается без изменений.
//
// Параметры:
//  Результат - Произвольный - результат выполнения инструмента
//  ИмяИнструмента - Строка - каноническое имя инструмента
//  Проверка - Структура, Неопределено - проверка компоненты (РазобратьРезультатПроверки) для execute_query
//             и execute_code; Неопределено для остальных инструментов
//  Происхождение - Соответствие, Неопределено - происхождение параметров вызова (Вызов.Происхождение: имя параметра ->
//                  client, token_protected, token_unknown); нужно полям, которые повторяют вход клиента
//
// Возвращаемое значение:
//  Произвольный - ответ: success, data и поля инструмента или success, error, error_code и, если задано, parameter
//
&НаКлиенте
Функция ЗамаскироватьРезультатСтрогий(Результат, ИмяИнструмента, Проверка, Происхождение = Неопределено)

	Если НЕ СостояниеЗащиты.Строгий Тогда

		Возврат Результат;

	КонецЕсли;

	// Осознанное исключение из правила "чтение базы без Попытка": внутри серверный вызов политики полей
	// (get_object_by_link) и выдача токенов, которая может отказать. Любой сбой закрывает ответ ошибкой
	// E_EXECUTION (fail closed): частично замаскированный ответ не отправляется.
	Попытка

		Контекст = НовыйКонтекстМаскированияСтрогий(ИмяИнструмента, Проверка, Результат, Происхождение);
		Замаскированный = ЗамаскироватьКонвертСтрогий(Результат, ИмяИнструмента, Контекст);

	Исключение

		ДобавитьВЛог("Строгий режим: ответ не удалось замаскировать, клиенту отправлена ошибка E_EXECUTION");
		Замаскированный = ОшибкаСтрогогоРежима("E_EXECUTION");

	КонецПопытки;

	Возврат Замаскированный;

КонецФункции

// Конверт ответа строгого режима: новый объект только из разрешенных полей успешного результата. Поле, которого
// нет в ДопустимыеПоляОтвета, не отправляется; в журнал формы пишется только его имя.
//
// Параметры:
//  Результат - Произвольный - результат выполнения инструмента
//  ИмяИнструмента - Строка - каноническое имя инструмента
//  Контекст - Структура - контекст маскирования (НовыйКонтекстМаскированияСтрогий)
//
// Возвращаемое значение:
//  Структура - замаскированный ответ
//
&НаКлиенте
Функция ЗамаскироватьКонвертСтрогий(Результат, ИмяИнструмента, Контекст)

	ЭтоОбъект = (ТипЗнч(Результат) = Тип("Структура") Или ТипЗнч(Результат) = Тип("Соответствие"));

	Если НЕ ЭтоОбъект Или ПолеРезультатаПроверки(Результат, "success") <> Истина Тогда

		Возврат ЗамаскироватьОшибкуСтрогий(Результат, ИмяИнструмента, Контекст.Изолированный);

	КонецЕсли;

	Допустимые = ДопустимыеПоляОтвета(ИмяИнструмента);
	Конверт = Новый Структура("success", Истина);

	Для Каждого Поле Из Результат Цикл

		Если Поле.Ключ <> "success" И Допустимые.Получить(Поле.Ключ) <> Неопределено Тогда

			Путь = "$." + Поле.Ключ;
			Метка = МеткаПутиСтрогий(Путь, Контекст);
			Конверт.Вставить(Поле.Ключ, ЗамаскироватьУзелСтрогий(Поле.Значение, Путь, Метка, Контекст));

		ИначеЕсли Поле.Ключ <> "success" Тогда

			ДобавитьВЛог("Строгий режим: поле ответа не отправлено: " + Поле.Ключ);

		Иначе

			// Признак успеха уже записан в конверт.

		КонецЕсли;

	КонецЦикла;

	Возврат Конверт;

КонецФункции

// Неуспешный результат строгого режима: фиксированная ошибка. Текст возвращается как есть, только если это
// фиксированный текст известного кода (ТекстОшибкиСтрогогоРежима). Любой другой текст уходит одним токеном
// изолированной области с кодом E_EXECUTION; результат без текста дает фиксированную ошибку E_EXECUTION.
//
// Параметры:
//  Результат - Произвольный - неуспешный результат инструмента
//  ИмяИнструмента - Строка - каноническое имя инструмента
//  Изолированный - Соответствие - изолированные области текущего ответа (ИзолированнаяОбластьСтрогий)
//
// Возвращаемое значение:
//  Структура - success (Ложь), error, error_code и, если задано, parameter
//
&НаКлиенте
Функция ЗамаскироватьОшибкуСтрогий(Результат, ИмяИнструмента, Изолированный)

	Код = ПолеРезультатаПроверки(Результат, "error_code");
	Текст = ПолеРезультатаПроверки(Результат, "error");
	Известный = (ТипЗнч(Код) = Тип("Строка") И ТаблицаОшибокСтрогогоРежима().Получить(Код) <> Неопределено);

	Если Известный И Текст = ТекстОшибкиСтрогогоРежима(Код) Тогда

		ИмяПараметра = ?(ТипЗнч(Результат) = Тип("Структура"), ИмяПараметраИзКонтракта(Результат, ИмяИнструмента), "");

		Возврат ОшибкаСтрогогоРежима(Код, ИмяПараметра);

	КонецЕсли;

	Ошибка = ОшибкаСтрогогоРежима("E_EXECUTION");

	Если ТипЗнч(Текст) = Тип("Строка") И Текст <> "" Тогда

		Ошибка.error = ЗамаскироватьЗначениеПоМетке(Текст, "unlabeled", "STR", Изолированный);

	КонецЕсли;

	Возврат Ошибка;

КонецФункции

// Контекст маскирования одного ответа строгого режима: метки путей вывода, изолированные области токенов и правила
// узлов. Источники меток: execute_query - колонки проверки компоненты и схема результата; execute_code - result_labels
// проверки (CheckCode; пока их нет, весь результат без меток); get_object_by_link - политика полей таблицы объекта;
// find_references_to_object и get_access_rights - ДобавитьМеткиВыводаПоВызову; остальные - МеткиВыводаИнструмента.
//
// Параметры:
//  ИмяИнструмента - Строка - каноническое имя инструмента
//  Проверка - Структура, Неопределено - проверка компоненты (РазобратьРезультатПроверки)
//  Результат - Произвольный - результат инструмента (схема execute_query, имя таблицы get_object_by_link)
//  Происхождение - Соответствие, Неопределено - происхождение параметров вызова (Вызов.Происхождение)
//
// Возвращаемое значение:
//  Структура - Метки (Соответствие: ВРег(путь) -> метка), Изолированный (Соответствие: происхождение -> область),
//              КлючиДанные (Булево: ключ структуры без своей метки маскируется), СтандартныеСобытия (Соответствие)
//
&НаКлиенте
Функция НовыйКонтекстМаскированияСтрогий(ИмяИнструмента, Проверка, Результат, Происхождение = Неопределено)

	Контекст = Новый Структура("Метки, Изолированный, КлючиДанные, СтандартныеСобытия",
		МеткиВыводаИнструмента(ИмяИнструмента), Новый Соответствие, Ложь, Новый Соответствие);

	Если ИмяИнструмента = "execute_code" Тогда

		// Результат кода строит код клиента: ключи структур - данные, форма узла ничего не доказывает (B-7).
		Контекст.КлючиДанные = Истина;
		ДобавитьМеткиРезультатаКода(Контекст.Метки, ПолеРезультатаПроверки(Проверка, "result_labels"));

	ИначеЕсли ИмяИнструмента = "execute_query" Тогда

		ДобавитьМеткиКолонокЗапроса(Контекст.Метки, ПолеРезультатаПроверки(Проверка, "columns"),
			СсылочныеКолонкиЗапроса(Результат));

	ИначеЕсли ИмяИнструмента = "get_object_by_link" Тогда

		ДобавитьМеткиОбъектаПоСсылке(Контекст.Метки, Результат);

	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда

		Контекст.СтандартныеСобытия = СтандартныеСобытияЖурнала();

	ИначеЕсли ИмяИнструмента = "find_references_to_object" Или ИмяИнструмента = "get_access_rights" Тогда

		ДобавитьМеткиВыводаПоВызову(Контекст.Метки, ИмяИнструмента, Результат, Происхождение);

	Иначе

		// Остальные инструменты: только статическая таблица МеткиВыводаИнструмента.

	КонецЕсли;

	Возврат Контекст;

КонецФункции

// Метка пути по таблице меток; пути без метки - unlabeled (метки не наследуются).
//
// Параметры:
//  Путь - Строка - путь узла вывода
//  Контекст - Структура - контекст маскирования (НовыйКонтекстМаскированияСтрогий)
//
// Возвращаемое значение:
//  Строка - метка пути
//
&НаКлиенте
Функция МеткаПутиСтрогий(Путь, Контекст)

	Метка = Контекст.Метки.Получить(ВРег(Путь));

	Возврат ?(Метка = Неопределено, "unlabeled", Метка);

КонецФункции

// Маскирование одного узла вывода по его метке. Описание ссылки получает правило ссылки
// (ЗамаскироватьОписаниеСсылкиСтрогий) только на пути с меткой ref; объект и массив обходятся рекурсивно, и каждый
// дочерний узел маскируется по своей метке; скаляр - ЗамаскироватьЗначениеПоМетке.
//
// Параметры:
//  Значение - Произвольный - значение узла
//  Путь - Строка - путь узла: $ - конверт, .Ключ - поле объекта, .* - любое поле объекта, [*] - элемент массива
//  Метка - Строка - метка пути узла
//  Контекст - Структура - контекст маскирования (НовыйКонтекстМаскированияСтрогий)
//
// Возвращаемое значение:
//  Произвольный - замаскированное значение узла
//
&НаКлиенте
Функция ЗамаскироватьУзелСтрогий(Значение, Путь, Метка, Контекст)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда

		Если Метка = "ref" И ЭтоОписаниеСсылкиСтрогий(Значение) Тогда

			Возврат ЗамаскироватьОписаниеСсылкиСтрогий(Значение, Контекст.Изолированный);

		КонецЕсли;

		Возврат ЗамаскироватьОбъектСтрогий(Значение, Путь, Метка, Контекст);

	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда

		Возврат ЗамаскироватьМассивСтрогий(Значение, Путь, Контекст);

	КонецЕсли;

	Категория = ?(Контекст.КлючиДанные, "STR", ОпределитьКатегориюТокена(Путь));

	Возврат ЗамаскироватьЗначениеПоМетке(Значение, МеткаСкаляраСтрогий(Значение, Метка, Контекст), Категория,
		Контекст.Изолированный);

КонецФункции

// Метка скалярного узла: событие журнала - open для стандартного идентификатора (СтандартныеСобытияЖурнала), иначе
// protected; метка ref или container на скаляре ничего не доказывает и заменяется на unlabeled; остальные - как есть.
//
// Параметры:
//  Значение - Произвольный - скалярное значение узла
//  Метка - Строка - метка пути узла
//  Контекст - Структура - контекст маскирования (НовыйКонтекстМаскированияСтрогий)
//
// Возвращаемое значение:
//  Строка - метка, по которой маскируется значение
//
&НаКлиенте
Функция МеткаСкаляраСтрогий(Значение, Метка, Контекст)

	Если Метка = "event" Тогда

		Возврат ?(Контекст.СтандартныеСобытия.Получить(Значение) = Неопределено, "protected", "open");

	КонецЕсли;

	Возврат ?(Метка = "ref" Или Метка = "container", "unlabeled", Метка);

КонецФункции

// Маскирование объекта вывода (Структура или Соответствие): каждое поле - по своей метке (ПутьПоляОбъектаСтрогий).
// Ключи остаются открытыми, только если метка объекта open или client. Иначе маскируются в изолированной области
// все ключи соответствия, а при ключах-данных (КлючиДанные) еще и ключи структуры без своей метки; такой объект
// возвращается Соответствием: токен не может быть ключом структуры.
//
// Параметры:
//  Значение - Структура, Соответствие - объект вывода
//  Путь - Строка - путь объекта
//  Метка - Строка - метка объекта
//  Контекст - Структура - контекст маскирования (НовыйКонтекстМаскированияСтрогий)
//
// Возвращаемое значение:
//  Структура, Соответствие - замаскированный объект
//
&НаКлиенте
Функция ЗамаскироватьОбъектСтрогий(Значение, Путь, Метка, Контекст)

	КлючиОткрыты = (Метка = "open" Или Метка = "client");
	ЭтоСоответствие = (ТипЗнч(Значение) = Тип("Соответствие"));
	Результат = ?(ЭтоСоответствие Или Контекст.КлючиДанные, Новый Соответствие, Новый Структура);

	Для Каждого Элемент Из Значение Цикл

		Ключ = Строка(Элемент.Ключ);
		МеткаЭлемента = Неопределено;
		ПутьЭлемента = ПутьПоляОбъектаСтрогий(Путь, Ключ, Контекст.Метки, МеткаЭлемента);
		ЗначениеЭлемента = ЗамаскироватьУзелСтрогий(Элемент.Значение, ПутьЭлемента,
			?(МеткаЭлемента = Неопределено, "unlabeled", МеткаЭлемента), Контекст);

		Если НЕ КлючиОткрыты И (ЭтоСоответствие Или Контекст.КлючиДанные И МеткаЭлемента = Неопределено) Тогда

			Ключ = ЗамаскироватьЗначениеПоМетке(Ключ, "unknown", "STR", Контекст.Изолированный);

		КонецЕсли;

		Результат.Вставить(Ключ, ЗначениеЭлемента);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Путь и метка поля объекта: сначала точный путь <Путь>.<Ключ>, затем путь любого поля <Путь>.*. Ключ с точкой,
// скобкой или звездочкой путь меток не продолжает: такое поле остается без метки.
//
// Параметры:
//  Путь - Строка - путь объекта
//  Ключ - Строка - ключ поля
//  Метки - Соответствие - таблица меток: ВРег(путь) -> метка
//  Метка - Строка, Неопределено - возвращаемый параметр: метка поля или Неопределено, если ее нет
//
// Возвращаемое значение:
//  Строка - путь поля, по которому ищутся метки его дочерних узлов
//
&НаКлиенте
Функция ПутьПоляОбъектаСтрогий(Путь, Ключ, Метки, Метка)

	ПутьЭлемента = Путь + "." + Ключ;
	Метка = Неопределено;

	Если Найти(Ключ, ".") > 0 Или Найти(Ключ, "[") > 0 Или Найти(Ключ, "*") > 0 Тогда

		Возврат ПутьЭлемента;

	КонецЕсли;

	Метка = Метки.Получить(ВРег(ПутьЭлемента));

	Если Метка <> Неопределено Тогда

		Возврат ПутьЭлемента;

	КонецЕсли;

	Метка = Метки.Получить(ВРег(Путь + ".*"));

	Возврат ?(Метка = Неопределено, ПутьЭлемента, Путь + ".*");

КонецФункции

// Маскирование массива вывода: каждый элемент - узел пути <Путь>[*] со своей меткой. Элемент, у которого в таблице
// меток есть собственный путь <Путь>[<номер>] (номер с нуля), маскируется по нему: так метки зависят от самого
// элемента, например от таблицы, в которой найдена запись (find_references_to_object).
//
// Параметры:
//  Значение - Массив - массив вывода
//  Путь - Строка - путь массива
//  Контекст - Структура - контекст маскирования (НовыйКонтекстМаскированияСтрогий)
//
// Возвращаемое значение:
//  Массив - замаскированные элементы
//
&НаКлиенте
Функция ЗамаскироватьМассивСтрогий(Значение, Путь, Контекст)

	ПутьЭлемента = Путь + "[*]";
	МеткаЭлемента = МеткаПутиСтрогий(ПутьЭлемента, Контекст);
	Результат = Новый Массив;
	Номер = 0;

	Для Каждого Элемент Из Значение Цикл

		ПутьНомера = Путь + "[" + Формат(Номер, "ЧН=0; ЧГ=") + "]";
		МеткаНомера = Контекст.Метки.Получить(ВРег(ПутьНомера));

		Если МеткаНомера = Неопределено Тогда

			Результат.Добавить(ЗамаскироватьУзелСтрогий(Элемент, ПутьЭлемента, МеткаЭлемента, Контекст));

		Иначе

			Результат.Добавить(ЗамаскироватьУзелСтрогий(Элемент, ПутьНомера, МеткаНомера, Контекст));

		КонецЕсли;

		Номер = Номер + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Маскирование одного скалярного значения по метке происхождения. open и client - как есть. protected - токен
// основной карты, у нестрокового значения - токен его строкового представления. protected_derived, unknown, mixed -
// строка уходит в изолированную область своего происхождения, число, дата и булево - как есть. Это осознанное
// решение плана (задача 51): такие метки дает только проверка компоненты, и вызов с ними всегда проходит шлюз, где
// человек видел текст, породивший эти значения. Любая другая метка (в том числе unlabeled) - любое значение уходит
// в изолированную область unknown. Неопределено, Null и пустая строка возвращаются как есть. Значение клиента
// никогда не ищется в основной карте.
//
// Параметры:
//  Значение - Произвольный - скалярное значение
//  Метка - Строка - метка происхождения пути
//  Категория - Строка - категория токена (STR, PER, ORG и т.п.)
//  Изолированный - Соответствие - изолированные области текущего ответа (ИзолированнаяОбластьСтрогий)
//
// Возвращаемое значение:
//  Произвольный - значение или токен
//
&НаКлиенте
Функция ЗамаскироватьЗначениеПоМетке(Значение, Метка, Категория, Изолированный)

	Если Значение = Неопределено Или Значение = Null Или Значение = "" Или Метка = "open" Или Метка = "client" Тогда

		Возврат Значение;

	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Текст = ?(ТипЗначения = Тип("Строка"), Значение, Строка(Значение));

	Если Метка = "protected" Тогда

		Возврат СтрогийТокенизировать(Текст, Категория, "protected", Изолированный);

	КонецЕсли;

	Производная = (Метка = "protected_derived" Или Метка = "unknown" Или Метка = "mixed");

	Если Производная И (ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Дата") Или ТипЗначения = Тип("Булево")) Тогда

		Возврат Значение;

	КонецЕсли;

	Происхождение = ?(Производная, Метка, "unknown");

	Возврат СтрогийТокенизировать(Текст, Категория, Происхождение, ИзолированнаяОбластьСтрогий(Изолированный, Происхождение));

КонецФункции

// Изолированная область токенов одного происхождения в текущем ответе: одно значение разных происхождений получает
// разные токены, и ПроисхождениеТокенов хранит для каждого свое происхождение.
//
// Параметры:
//  Изолированный - Соответствие - области текущего ответа: происхождение -> Соответствие (значение -> токен)
//  Происхождение - Строка - происхождение области (protected_derived, unknown, mixed)
//
// Возвращаемое значение:
//  Соответствие - значение -> токен
//
&НаКлиенте
Функция ИзолированнаяОбластьСтрогий(Изолированный, Происхождение)

	Область = Изолированный.Получить(Происхождение);

	Если Область = Неопределено Тогда

		Область = Новый Соответствие;
		Изолированный.Вставить(Происхождение, Область);

	КонецЕсли;

	Возврат Область;

КонецФункции

// Признак описания ссылки в форме ОписаниеОбъектаПоСсылке: _objectRef = Истина, строковые УникальныйИдентификатор
// и ТипОбъекта. Сама форма узла доверия не дает: правило ссылки применяется только на пути с меткой ref.
//
// Параметры:
//  Значение - Структура, Соответствие - объект вывода
//
// Возвращаемое значение:
//  Булево - Истина, если объект имеет форму описания ссылки
//
&НаКлиенте
Функция ЭтоОписаниеСсылкиСтрогий(Значение)

	Возврат ПолеРезультатаПроверки(Значение, "_objectRef") = Истина
		И ЭтоИдентификаторСсылкиСтрогий(ПолеРезультатаПроверки(Значение, "УникальныйИдентификатор"))
		И ЭтоТипСсылкиСтрогий(ПолеРезультатаПроверки(Значение, "ТипОбъекта"));

КонецФункции

// Строка в формате идентификатора 8-4-4-4-12 из шестнадцатеричных цифр.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение
//
// Возвращаемое значение:
//  Булево - Истина, если значение - строка такого формата
//
&НаКлиенте
Функция ЭтоИдентификаторСсылкиСтрогий(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда

		Возврат Ложь;

	КонецЕсли;

	Для Позиция = 1 По 36 Цикл

		Символ = Сред(Значение, Позиция, 1);

		Если Позиция = 9 Или Позиция = 14 Или Позиция = 19 Или Позиция = 24 Тогда

			Если Символ <> "-" Тогда

				Возврат Ложь;

			КонецЕсли;

		ИначеЕсли Найти("0123456789abcdefABCDEF", Символ) = 0 Тогда

			Возврат Ложь;

		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Строка вида <Вид>Ссылка.<Имя> без пробелов и дополнительных точек.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение
//
// Возвращаемое значение:
//  Булево - Истина, если значение - имя ссылочного типа
//
&НаКлиенте
Функция ЭтоТипСсылкиСтрогий(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда

		Возврат Ложь;

	КонецЕсли;

	ПозицияТочки = Найти(Значение, ".");

	Если ПозицияТочки = 0 Тогда

		Возврат Ложь;

	КонецЕсли;

	Вид = Лев(Значение, ПозицияТочки - 1);
	Имя = Сред(Значение, ПозицияТочки + 1);

	Возврат Найти(Имя, ".") = 0 И СтрДлина(Вид) > 6 И Прав(Вид, 6) = "Ссылка"
		И Не ПустаяСтрока(Имя) И Найти(Значение, " ") = 0;

КонецФункции

// Правило ссылки (решение #3): УникальныйИдентификатор и ТипОбъекта остаются открытыми, Представление вычислено
// платформой из хранимых данных и всегда маскируется как protected в основной карте. Другие поля не отправляются.
//
// Параметры:
//  Описание - Структура, Соответствие - описание ссылки (ЭтоОписаниеСсылкиСтрогий) на пути с меткой ref
//  Изолированный - Соответствие - изолированные области текущего ответа (ИзолированнаяОбластьСтрогий)
//
// Возвращаемое значение:
//  Структура - _objectRef, УникальныйИдентификатор, ТипОбъекта, Представление
//
&НаКлиенте
Функция ЗамаскироватьОписаниеСсылкиСтрогий(Описание, Изолированный)

	ТипОбъекта = ПолеРезультатаПроверки(Описание, "ТипОбъекта");
	Результат = Новый Структура("_objectRef, УникальныйИдентификатор, ТипОбъекта", Истина,
		ПолеРезультатаПроверки(Описание, "УникальныйИдентификатор"), ТипОбъекта);
	Представление = ПолеРезультатаПроверки(Описание, "Представление");
	Результат.Вставить("Представление",
		ЗамаскироватьЗначениеПоМетке(Представление, "protected", ОпределитьКатегориюТокена(ТипОбъекта), Изолированный));

	Возврат Результат;

КонецФункции

// Поля успешного ответа, которые строгий режим отправляет клиенту: success, data и поля инструмента из его схемы.
// Ответ с ошибкой строится отдельно (ЗамаскироватьОшибкуСтрогий): success, error, error_code, parameter. Служебные
// поля (debug, _cmd_arguments_json, _original_data_json, mcp_cache_*) и поля снимка экрана сюда не входят.
//
// Параметры:
//  ИмяИнструмента - Строка - каноническое имя инструмента
//
// Возвращаемое значение:
//  Соответствие - ключ: имя поля (Строка); значение: Истина
//
&НаКлиенте
Функция ДопустимыеПоляОтвета(ИмяИнструмента)

	Если ИмяИнструмента = "execute_query" Тогда

		Поля = "data,schema";

	ИначеЕсли ИмяИнструмента = "get_metadata" Тогда

		Поля = "data,configuration,extension,truncated,limit,returned,count,offset,has_more,next_offset";

	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда

		Поля = "data,count,last_date,next_same_second_offset,has_more";

	ИначеЕсли ИмяИнструмента = "submit_for_deanonymization" Тогда

		Поля = "received";

	Иначе

		Поля = "data";

	КонецЕсли;

	Допустимые = Новый Соответствие;
	Допустимые.Вставить("success", Истина);

	Для Каждого Имя Из РазбитьИменаКонтракта(Поля) Цикл

		Допустимые.Вставить(Имя, Истина);

	КонецЦикла;

	Возврат Допустимые;

КонецФункции

// Статическая таблица меток вывода инструментов. Метки не наследуются: открытым бывает
// только явно перечисленный путь. Метки: open, client, protected, event (стандартный идентификатор события - open,
// иначе protected), ref (правило ссылки), container (узел-контейнер, сам значений не открывает), unknown. Ключи
// объекта открыты только у объекта с меткой open или client. Путь без метки маскируется в изолированной области.
//
// Параметры:
//  ИмяИнструмента - Строка - каноническое имя инструмента
//
// Возвращаемое значение:
//  Соответствие - ключ: ВРег(путь); значение: метка (Строка)
//
&НаКлиенте
Функция МеткиВыводаИнструмента(ИмяИнструмента)

	Метки = Новый Соответствие;

	Если ИмяИнструмента = "execute_query" Тогда

		ДобавитьМеткиВыводаСтрогий(Метки, "$.", "data,data[*],schema,schema.columns,schema.columns[*]", "container");
		ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.schema.columns[*].types");
		ДобавитьМеткуВыводаСтрогий(Метки, "$.schema.columns[*].name", "open");

	ИначеЕсли ИмяИнструмента = "get_metadata" Тогда

		ДобавитьМеткиВыводаМетаданных(Метки);

	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда

		ДобавитьМеткиВыводаЖурнала(Метки);

	ИначеЕсли ИмяИнструмента = "get_object_by_link" Тогда

		ДобавитьМеткуВыводаСтрогий(Метки, "$.data", "container");
		ДобавитьМеткуВыводаСтрогий(Метки, "$.data._type", "open");
		ДобавитьМеткуВыводаСтрогий(Метки, "$.data._presentation", "ref");

	ИначеЕсли ИмяИнструмента = "find_references_to_object" Или ИмяИнструмента = "get_access_rights" Тогда

		ДобавитьМеткиВыводаПоискаИПрав(Метки, ИмяИнструмента);

	ИначеЕсли ИмяИнструмента = "get_bsl_syntax_help" Тогда

		ДобавитьМеткиВыводаСправкиСинтаксиса(Метки);

	ИначеЕсли ИмяИнструмента = "get_link_of_object" Или ИмяИнструмента = "submit_for_deanonymization" Тогда

		ДобавитьМеткиВыводаСтрогий(Метки, "$.", "data,received", "open");

	Иначе

		// execute_code: метки дает проверка компоненты; у прочих инструментов меток нет, вывод маскируется целиком.

	КонецЕсли;

	Возврат Метки;

КонецФункции

// Метки вывода get_metadata для обеих форм поля data: массив строк списка и сводки (O,
// ПолучитьСводкуМетаданных, список объектов и расширений) и объект описания объекта или элемента. Имя информационной
// базы, комментарии, поставщик и представления предопределенных элементов - protected; литеральные значения свойств
// (ЗначениеЗаполнения, ПараметрыВыбора, ОсновнойОтбор, Маска) - unknown; не перечисленные поля маскируются.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//
&НаКлиенте
Процедура ДобавитьМеткиВыводаМетаданных(Метки)

	ДобавитьМеткиВыводаСтрогий(Метки, "$.", "extension,truncated,limit,returned,count,offset,has_more,next_offset", "open");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.", "configuration,data,data[*]", "container");
	ДобавитьМеткуВыводаСтрогий(Метки, "$.configuration.platform_version", "open");
	ДобавитьМеткуВыводаСтрогий(Метки, "$.configuration.infobase_name", "protected");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.configuration.", "metadata,metadata.*", "open");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.configuration.metadata.", "Комментарий,Поставщик", "protected");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data[*].", "Тип,Количество,ПолноеИмя,Синоним,Имя,Версия,Активно,БезопасныйРежим,"
		+ "ГлавныйУзел,ЗащитаОтОпасныхДействий,ИспользоватьОсновныеРолиДляВсехПользователей,"
		+ "ИспользуетсяВРаспределеннойИнформационнойБазе,Назначение,ОбластьДействия,УникальныйИдентификатор,ХешСумма", "open");
	ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.data[*].ОсновныеРоли");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data.", "Имя,Синоним,ПолноеИмя,ТипОбъектаМетаданных,Тип", "open");
	ДобавитьМеткиОтметокРасширенияСтрогий(Метки, "$.data.");
	ДобавитьМеткиОписанияОбъектаМетаданных(Метки);
	ДобавитьМеткиСсылочныхЗначенийМетаданных(Метки);

КонецПроцедуры

// Метки значений-ссылок в свойствах описания метаданных (БезопасноеЗначениеДляПередачи: _objectRef,
// УникальныйИдентификатор, ТипОбъекта, Представление). Свойство со значением-ссылкой лежит там же, где литерал
// (properties.*, ЗначениеЗаполнения, ПараметрыВыбора, ОсновнойОтбор, Маска, ЗначениеОтбораВидов), поэтому метки
// ставятся на поля описания, а не на сам путь. По решению #3 идентификатор и тип ссылки открыты (без значения
// реквизита они ничего не раскрывают), а Представление вычислено платформой из хранимых данных - protected.
// Литерал в том же свойстве остается под меткой своего пути.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//
&НаКлиенте
Процедура ДобавитьМеткиСсылочныхЗначенийМетаданных(Метки)

	Имена = РазбитьИменаКонтракта("*,ЗначениеЗаполнения,ПараметрыВыбора,ОсновнойОтбор,Маска");
	Пути = Новый Массив;

	Для Каждого Имя Из Имена Цикл

		Пути.Добавить("$.data.properties." + Имя);

	КонецЦикла;

	Пути.Добавить("$.data.characteristics[*].ЗначениеОтбораВидов");

	Для Каждого Путь Из Пути Цикл

		ДобавитьМеткиВыводаСтрогий(Метки, Путь + ".", "_objectRef,УникальныйИдентификатор,ТипОбъекта", "open");
		ДобавитьМеткуВыводаСтрогий(Метки, Путь + ".Представление", "protected");

	КонецЦикла;

КонецПроцедуры

// Метки разделов описания объекта метаданных в get_metadata: реквизиты, табличные части, измерения, ресурсы,
// признаки учета, значения перечисления, владельцы, формы, команды, макеты, движения, предопределенные, свойства,
// характеристики и страница типов элемента.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//
&НаКлиенте
Процедура ДобавитьМеткиОписанияОбъектаМетаданных(Метки)

	// type_error без метки (маскируется): это ОписаниеОшибки() платформы при чтении типов поля, не фиксированный текст.
	ПоляСтроки = "Имя,Синоним,Тип,Стандартный,total_types_count,shown_types_count";

	Для Каждого Раздел Из РазбитьИменаКонтракта("Реквизиты,РеквизитыАдресации,Измерения,Ресурсы,ПризнакиУчета,"
		+ "ПризнакиУчетаСубконто") Цикл

		ДобавитьМеткиРазделаМетаданных(Метки, "$.data." + Раздел, ПоляСтроки);

	КонецЦикла;

	Для Каждого Раздел Из РазбитьИменаКонтракта("ТабличныеЧасти,СтандартныеТабличныеЧасти") Цикл

		ДобавитьМеткиРазделаМетаданных(Метки, "$.data." + Раздел, "Имя,Синоним");
		ДобавитьМеткиРазделаМетаданных(Метки, "$.data." + Раздел + "[*].Реквизиты", ПоляСтроки);

	КонецЦикла;

	ДобавитьМеткиРазделаМетаданных(Метки, "$.data.ЗначенияПеречисления", "Имя,Синоним");
	ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.data.Владельцы");

	Для Каждого Раздел Из РазбитьИменаКонтракта("forms,commands,layouts,movements,predefined") Цикл

		ДобавитьМеткиРазделаМетаданных(Метки, "$.data." + Раздел, "ПолноеИмя,Синоним,ТипМакета,ИмяПредопределенныхДанных");

	КонецЦикла;

	ДобавитьМеткуВыводаСтрогий(Метки, "$.data.predefined[*].Представление", "protected");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data.", "properties,properties.*", "open");
	ДобавитьМеткуВыводаСтрогий(Метки, "$.data.properties.Комментарий", "protected");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data.properties.", "ЗначениеЗаполнения,ПараметрыВыбора,ОсновнойОтбор,Маска",
		"unknown");
	ДобавитьМеткиРазделаМетаданных(Метки, "$.data.characteristics", "ВидыХарактеристик,ЗначенияХарактеристик,ПолеВида,"
		+ "ПолеЗначения,ПолеИспользованияМножественныхЗначений,ПолеКлюча,ПолеКлючаМножественныхЗначений,ПолеОбъекта,"
		+ "ПолеОтбораВидов,ПолеПорядкаМножественныхЗначений,ПолеПутиКДанным");
	ДобавитьМеткуВыводаСтрогий(Метки, "$.data.characteristics[*].ЗначениеОтбораВидов", "unknown");
	ДобавитьМеткуВыводаСтрогий(Метки, "$.data.types", "container");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data.types.", "count,limit,offset,returned,truncated,has_more,next_offset", "open");
	ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.data.types.items");

КонецПроцедуры

// Метки одного раздела-массива описания метаданных: массив и его строки - контейнеры, перечисленные поля строки
// открыты, отметки расширений строки - по ДобавитьМеткиОтметокРасширенияСтрогий.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Путь - Строка - путь массива раздела
//  Поля - Строка - открытые поля строки через запятую
//
&НаКлиенте
Процедура ДобавитьМеткиРазделаМетаданных(Метки, Путь, Поля)

	ДобавитьМеткуВыводаСтрогий(Метки, Путь, "container");
	ДобавитьМеткуВыводаСтрогий(Метки, Путь + "[*]", "container");
	ДобавитьМеткиВыводаСтрогий(Метки, Путь + "[*].", Поля, "open");
	ДобавитьМеткиОтметокРасширенияСтрогий(Метки, Путь + "[*].");

КонецПроцедуры

// Метки отметок расширений (ПолучитьExtensionMarksЕслиНужно): принадлежность, признак изменений и описание
// расширения (имя, синоним, идентификатор) открыты.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Префикс - Строка - путь объекта-владельца с точкой на конце
//
&НаКлиенте
Процедура ДобавитьМеткиОтметокРасширенияСтрогий(Метки, Префикс)

	ДобавитьМеткиВыводаСтрогий(Метки, Префикс, "extension_marks,extension_marks.РасширениеКонфигурации", "container");
	ДобавитьМеткиВыводаСтрогий(Метки, Префикс + "extension_marks.",
		"ПринадлежностьОбъекта,ЕстьИзмененияРасширениямиКонфигурации", "open");
	ДобавитьМеткиВыводаСтрогий(Метки, Префикс + "extension_marks.РасширениеКонфигурации.",
		"Имя,Синоним,УникальныйИдентификатор", "open");

КонецПроцедуры

// Метки вывода get_event_log: пользователь, компьютер, комментарий и представление данных -
// protected (пользователь в форме УИД тоже); имя события - по списку стандартных; остальные поля записи открыты.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//
&НаКлиенте
Процедура ДобавитьМеткиВыводаЖурнала(Метки)

	ДобавитьМеткиВыводаСтрогий(Метки, "$.", "count,last_date,next_same_second_offset,has_more", "open");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.", "data,data[*]", "container");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data[*].", "date,level,metadata,session,application,transaction_status", "open");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data[*].", "user,computer,comment,data_presentation", "protected");
	ДобавитьМеткуВыводаСтрогий(Метки, "$.data[*].event", "event");

КонецПроцедуры

// Статические метки вывода find_references_to_object и get_access_rights. Без
// статической метки остаются: record_key находки (метки зависят от таблицы, ДобавитьМеткиКлючейЗаписейПоиска),
// note (смешивает имена и значения, в строгом режиме сервер его не отправляет, вместо него note_omitted) и user.name
// прав доступа (эхо входа клиента, метка по происхождению параметра, ДобавитьМеткиВыводаПоВызову).
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  ИмяИнструмента - Строка - find_references_to_object или get_access_rights
//
&НаКлиенте
Процедура ДобавитьМеткиВыводаПоискаИПрав(Метки, ИмяИнструмента)

	Если ИмяИнструмента = "find_references_to_object" Тогда

		ДобавитьМеткиВыводаСтрогий(Метки, "$.", "data,data.hits,data.hits[*]", "container");
		ДобавитьМеткиВыводаСтрогий(Метки, "$.data.", "total_hits,candidates_checked,timeout_exceeded", "open");
		ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.data.skipped_names");
		// note_omitted - фиксированный признак сервера: значений он не несет.
		ДобавитьМеткиВыводаСтрогий(Метки, "$.data.hits[*].", "found_in_meta,path,match_kind,note_omitted", "open");
		ДобавитьМеткуВыводаСтрогий(Метки, "$.data.hits[*].found_in_object", "ref");

	Иначе

		ДобавитьМеткиВыводаСтрогий(Метки, "$.", "data,data.roles,data.roles[*],data.user", "container");
		ДобавитьМеткиВыводаСтрогий(Метки, "$.data.", "metadata_object,metadata_type,total_roles,roles_with_rights", "open");
		ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.data.applicable_rights");
		ДобавитьМеткиВыводаСтрогий(Метки, "$.data.roles[*].", "name,synonym,rights,rights.*", "open");
		ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.data.user.roles");
		ДобавитьМеткиВыводаСтрогий(Метки, "$.data.user.", "effective_rights,effective_rights.*", "open");
		ДобавитьМеткуВыводаСтрогий(Метки, "$.data.user.full_name", "protected");

	КонецЕсли;

КонецПроцедуры

// Метки вывода find_references_to_object и get_access_rights, которые зависят от вызова: ключи записей находок -
// от таблицы, в которой найдена запись; user.name прав доступа - от происхождения параметра user_name.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  ИмяИнструмента - Строка - find_references_to_object или get_access_rights
//  Результат - Произвольный - результат инструмента
//  Происхождение - Соответствие, Неопределено - происхождение параметров вызова (Вызов.Происхождение)
//
&НаКлиенте
Процедура ДобавитьМеткиВыводаПоВызову(Метки, ИмяИнструмента, Результат, Происхождение)

	Если ИмяИнструмента = "find_references_to_object" Тогда

		ДобавитьМеткиКлючейЗаписейПоиска(Метки, Результат);

	Иначе

		ДобавитьМеткуВыводаСтрогий(Метки, "$.data.user.name", МеткаЭхоВходаСтрогий(Происхождение, "user_name"));

	КонецЕсли;

КонецПроцедуры

// Метка поля ответа, которое повторяет значение параметра вызова (сервер возвращает вход после замены токена
// значением). Значение клиента - client: оно клиенту уже известно. Значение из защищенного токена - protected:
// основная карта по значению отдает тот же токен, который клиент прислал. Токен непроверенного происхождения и вход,
// происхождение которого не записано, - unknown: значение уходит в изолированную область ответа.
//
// Параметры:
//  Происхождение - Соответствие, Неопределено - происхождение параметров вызова (Вызов.Происхождение)
//  ИмяПараметра - Строка - имя параметра, значение которого повторяет поле ответа
//
// Возвращаемое значение:
//  Строка - метка поля: client, protected или unknown
//
&НаКлиенте
Функция МеткаЭхоВходаСтрогий(Происхождение, ИмяПараметра)

	Источник = ?(ТипЗнч(Происхождение) = Тип("Соответствие"), Происхождение.Получить(ИмяПараметра), Неопределено);

	Если Источник = "client" Тогда

		Возврат "client";

	ИначеЕсли Источник = "token_protected" Тогда

		Возврат "protected";

	КонецЕсли;

	Возврат "unknown";

КонецФункции

// Метки ключей записей находок find_references_to_object (record_key: значения измерений, периода и регистратора
// записи регистра). Метка значения - класс поля в политике полей регистра, в котором найдена запись
// (ПолитикаПолейНаСервере): protected - токен основной карты, open - как есть, ссылочное поле - правило ссылки, поле
// без класса или вне политики маскируется. Метки зависят от таблицы находки, поэтому ставятся на путь находки по
// номеру (<массив>[<номер>], см. ЗамаскироватьМассивСтрогий); находка без ключа записи идет по общим меткам [*].
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Результат - Произвольный - результат find_references_to_object
//
&НаКлиенте
Процедура ДобавитьМеткиКлючейЗаписейПоиска(Метки, Результат)

	Находки = ПолеРезультатаПроверки(ПолеРезультатаПроверки(Результат, "data"), "hits");

	Если ТипЗнч(Находки) <> Тип("Массив") Тогда

		Возврат;

	КонецЕсли;

	ТаблицыНаходок = Новый Соответствие;

	Для Номер = 0 По Находки.Количество() - 1 Цикл

		ИмяТаблицы = ПолеРезультатаПроверки(Находки[Номер], "found_in_meta");
		КлючЗаписи = ПолеРезультатаПроверки(Находки[Номер], "record_key");

		Если ТипЗнч(ИмяТаблицы) = Тип("Строка") И (ТипЗнч(КлючЗаписи) = Тип("Структура")
			Или ТипЗнч(КлючЗаписи) = Тип("Соответствие")) Тогда

			ТаблицыНаходок.Вставить(Номер, ИмяТаблицы);

		КонецЕсли;

	КонецЦикла;

	Если ТаблицыНаходок.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Таблицы = ТаблицыПолитикиПолейНаходок(ТаблицыНаходок);

	Для Каждого Находка Из ТаблицыНаходок Цикл

		Поля = ПолеРезультатаПроверки(ПолеРезультатаПроверки(Таблицы, Находка.Значение), "fields");
		ДобавитьМеткиЗаписиНаходки(Метки, Находка.Ключ, Поля);

	КонецЦикла;

КонецПроцедуры

// Таблицы политики полей для регистров, в которых найдены записи (один серверный вызов на ответ).
//
// Параметры:
//  ТаблицыНаходок - Соответствие - номер находки -> полное имя таблицы (found_in_meta)
//
// Возвращаемое значение:
//  Соответствие, Неопределено - раздел tables политики: полное имя таблицы -> описание таблицы
//
&НаКлиенте
Функция ТаблицыПолитикиПолейНаходок(ТаблицыНаходок)

	ИменаТаблиц = Новый Массив;
	Различные = Новый Соответствие;

	Для Каждого Находка Из ТаблицыНаходок Цикл

		Если Различные.Получить(Находка.Значение) = Неопределено Тогда

			Различные.Вставить(Находка.Значение, Истина);
			ИменаТаблиц.Добавить(Находка.Значение);

		КонецЕсли;

	КонецЦикла;

	Срез = СрезПравилДляПолитики(СнимокПравилСтрогогоРежима, ИменаТаблиц);
	Политика = ПрочитатьJSON2(ПолитикаПолейНаСервере(ИменаТаблиц, Срез));

	Возврат ПолеРезультатаПроверки(Политика, "tables");

КонецФункции

// Метки одной находки с ключом записи: путь находки по номеру, открытые поля находки, ссылка на объект и поля
// ключа записи по политике полей таблицы.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Номер - Число - номер находки в массиве hits (с нуля)
//  Поля - Соответствие, Структура, Неопределено - поля таблицы находки в политике: имя -> {class, refs, ...}
//
&НаКлиенте
Процедура ДобавитьМеткиЗаписиНаходки(Метки, Номер, Поля)

	ПутьНаходки = "$.data.hits[" + Формат(Номер, "ЧН=0; ЧГ=") + "]";

	ДобавитьМеткуВыводаСтрогий(Метки, ПутьНаходки, "container");
	ДобавитьМеткиВыводаСтрогий(Метки, ПутьНаходки + ".", "found_in_meta,path,match_kind,note_omitted", "open");
	ДобавитьМеткуВыводаСтрогий(Метки, ПутьНаходки + ".found_in_object", "ref");
	ДобавитьМеткуВыводаСтрогий(Метки, ПутьНаходки + ".record_key", "container");
	ДобавитьМеткиПолейПолитики(Метки, ПутьНаходки + ".record_key.", Поля);

КонецПроцедуры

// Метки вывода get_bsl_syntax_help: локальная справка, все перечисленные поля открыты,
// candidates - массив строк путей справки.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//
&НаКлиенте
Процедура ДобавитьМеткиВыводаСправкиСинтаксиса(Метки)

	ДобавитьМеткуВыводаСтрогий(Метки, "$.data", "container");
	ДобавитьМеткиВыводаСтрогий(Метки, "$.data.",
		"total,offset,limit,has_more,content,content_page,content_total_pages,content_has_more", "open");
	ДобавитьМеткиСтрокВыводаСтрогий(Метки, "$.data.candidates");

КонецПроцедуры

// Метки массива открытых строк (имен метаданных, ролей, прав): массив - контейнер, его элементы открыты.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Путь - Строка - путь массива
//
&НаКлиенте
Процедура ДобавитьМеткиСтрокВыводаСтрогий(Метки, Путь)

	ДобавитьМеткуВыводаСтрогий(Метки, Путь, "container");
	ДобавитьМеткуВыводаСтрогий(Метки, Путь + "[*]", "open");

КонецПроцедуры

// Добавляет одну метку пути вывода. Путь хранится в верхнем регистре: так его ищут МеткаПутиСтрогий и
// ПутьПоляОбъектаСтрогий (имена колонок запроса и ключи структур сравниваются без учета регистра). Если у пути
// уже есть метка, остается более жесткая (ЖесткостьМеткиВыводаСтрогий): последняя не побеждает.
//
// Параметры:
//  Метки - Соответствие - таблица меток: ВРег(путь) -> метка
//  Путь - Строка - путь узла вывода
//  Метка - Строка - метка происхождения
//
&НаКлиенте
Процедура ДобавитьМеткуВыводаСтрогий(Метки, Путь, Метка)

	Ключ = ВРег(Путь);
	Прежняя = Метки.Получить(Ключ);

	Если Прежняя <> Неопределено И ЖесткостьМеткиВыводаСтрогий(Прежняя) > ЖесткостьМеткиВыводаСтрогий(Метка) Тогда

		Возврат;

	КонецЕсли;

	Метки.Вставить(Ключ, Метка);

КонецПроцедуры

// Жесткость метки вывода: чем больше число, тем больше маскируется. Неизвестная метка жестче всех.
//
// Параметры:
//  Метка - Строка - метка вывода
//
// Возвращаемое значение:
//  Число - жесткость метки
//
&НаКлиенте
Функция ЖесткостьМеткиВыводаСтрогий(Метка)

	Порядок = "|open|client|ref|container|event|mixed|protected_derived|protected|unknown|";
	Позиция = Найти(Порядок, "|" + Метка + "|");

	Возврат ?(Позиция = 0 Или Найти(Метка, "|") > 0, 100, Позиция);

КонецФункции

// Добавляет одну метку нескольким путям с общим префиксом.
//
// Параметры:
//  Метки - Соответствие - таблица меток: ВРег(путь) -> метка
//  Префикс - Строка - общая часть путей
//  Имена - Строка - окончания путей через запятую
//  Метка - Строка - метка происхождения
//
&НаКлиенте
Процедура ДобавитьМеткиВыводаСтрогий(Метки, Префикс, Имена, Метка)

	Для Каждого Имя Из РазбитьИменаКонтракта(Имена) Цикл

		ДобавитьМеткуВыводаСтрогий(Метки, Префикс + Имя, Метка);

	КонецЦикла;

КонецПроцедуры

// Метки колонок execute_query по проверке компоненты (columns: name, origin, direct). Имя колонки - каноническое
// имя результата (StatementResultNames). direct поднимает метку до protected (основная карта) только при origin
// protected; protected без direct - protected_derived; direct при другом origin не учитывается. Колонка open
// ссылочного типа (по схеме результата) получает метку ref; так же - колонка protected с direct, все типы которой
// ссылочные. Совпадение имен без учета регистра дает unknown.
// Колонка вне списка остается без метки.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Колонки - Массив, Неопределено - колонки проверки компоненты
//  Ссылочные - Соответствие - ВРег(имя колонки) -> Истина, если все типы колонки ссылочные и среди них нет
//    перечислений, Ложь, если ссылочный тип смешан с прочими или есть перечисление; колонки без ссылочных типов
//    отсутствуют (СсылочныеКолонкиЗапроса). Метку ref получают open-колонки с любым значением и direct protected
//    только со значением Истина
//
&НаКлиенте
Процедура ДобавитьМеткиКолонокЗапроса(Метки, Колонки, Ссылочные)

	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда

		Возврат;

	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл

		Имя = ПолеРезультатаПроверки(Колонка, "name");
		Метка = МеткаКолонкиЗапроса(Колонка, Ссылочные);

		Если ТипЗнч(Имя) = Тип("Строка") И Метка <> Неопределено Тогда

			Путь = ВРег("$.data[*]." + Имя);
			Прежняя = Метки.Получить(Путь);
			Метки.Вставить(Путь, ?(Прежняя = Неопределено Или Прежняя = Метка, Метка, "unknown"));

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Метка одной колонки execute_query (см. ДобавитьМеткиКолонокЗапроса).
//
// Параметры:
//  Колонка - Структура, Соответствие - колонка проверки компоненты (name, origin, direct)
//  Ссылочные - Соответствие - ВРег(имя колонки) -> Истина (все типы ссылочные, без перечислений) или Ложь (смешанные
//    типы либо есть перечисление); колонок без ссылочных типов нет (СсылочныеКолонкиЗапроса)
//
// Возвращаемое значение:
//  Строка, Неопределено - метка колонки; Неопределено, если имя или origin колонки не строка
//
&НаКлиенте
Функция МеткаКолонкиЗапроса(Колонка, Ссылочные)

	Имя = ПолеРезультатаПроверки(Колонка, "name");
	Происхождение = ПолеРезультатаПроверки(Колонка, "origin");

	Если ТипЗнч(Имя) <> Тип("Строка") Или ТипЗнч(Происхождение) <> Тип("Строка") Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если Происхождение = "protected" Тогда

		Если ПолеРезультатаПроверки(Колонка, "direct") <> Истина Тогда

			Возврат "protected_derived";

		КонецЕсли;

		// Прямо защищенная колонка только ссылочных типов без перечислений: тип и идентификатор открыты,
		// Представление маскируется.
		Возврат ?(Ссылочные.Получить(ВРег(Имя)) = Истина, "ref", "protected");

	КонецЕсли;

	Возврат ?(Происхождение = "open" И Ссылочные.Получить(ВРег(Имя)) <> Неопределено, "ref", Происхождение);

КонецФункции

// Колонки результата execute_query, среди типов которых есть ссылочный (схема результата: schema.columns, типы
// ссылок записаны как <Вид>Ссылка.<Имя>). Без схемы результата ссылочных колонок нет: описания ссылок маскируются.
//
// Параметры:
//  Результат - Произвольный - результат execute_query
//
// Возвращаемое значение:
//  Соответствие - ВРег(имя колонки) -> Истина, если все типы колонки ссылочные и нет перечислений, Ложь, если есть
//    прочие типы или перечисление (ВидСсылочностиТиповКолонки)
//
&НаКлиенте
Функция СсылочныеКолонкиЗапроса(Результат)

	Ссылочные = Новый Соответствие;
	Колонки = ПолеРезультатаПроверки(ПолеРезультатаПроверки(Результат, "schema"), "columns");

	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда

		Возврат Ссылочные;

	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл

		Имя = ПолеРезультатаПроверки(Колонка, "name");
		Типы = ПолеРезультатаПроверки(Колонка, "types");

		Если ТипЗнч(Имя) = Тип("Строка") И ТипЗнч(Типы) = Тип("Массив") Тогда

			ВидСсылочности = ВидСсылочностиТиповКолонки(Типы);

			Если ВидСсылочности <> Неопределено Тогда

				Ссылочные.Вставить(ВРег(Имя), ВидСсылочности);

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат Ссылочные;

КонецФункции

// Ссылочность типов одной колонки результата execute_query (типы ссылок записаны как <Вид>Ссылка.<Имя>). Тип Null
// платформа добавляет к типам колонок результата: он нейтрален и не делает колонку ссылочной, и не нарушает «только
// ссылки» (значение Null маскирование отдает как есть при любой метке).
//
// Параметры:
//  Типы - Массив - имена типов колонки из схемы результата
//
// Возвращаемое значение:
//  Булево, Неопределено - Неопределено, если среди типов нет ссылочного; Истина, если все типы ссылочные и среди них
//    нет перечислений; Ложь, если ссылочный тип смешан с прочими или среди типов есть ПеречислениеСсылка
//    (значения перечислений - метаданные, открытый идентификатор позволил бы клиенту подставить значение по нему)
//
&НаКлиенте
Функция ВидСсылочностиТиповКолонки(Типы)

	ЕстьСсылочный = Ложь;
	ТолькоСсылочные = Истина;

	Для Каждого ИмяТипа Из Типы Цикл

		Если ИмяТипа = "Null" Тогда

			Продолжить;

		КонецЕсли;

		Если ТипЗнч(ИмяТипа) <> Тип("Строка") Или Найти(ИмяТипа, "Ссылка.") = 0 Тогда

			ТолькоСсылочные = Ложь;

		Иначе

			ЕстьСсылочный = Истина;
			ТолькоСсылочные = ТолькоСсылочные И Найти(ИмяТипа, "ПеречислениеСсылка.") = 0;

		КонецЕсли;

	КонецЦикла;

	Возврат ?(ЕстьСсылочный, ТолькоСсылочные, Неопределено);

КонецФункции

// Метки результата execute_code из result_labels проверки (CheckCode, задача 27). Пути result_labels заданы над
// сериализованным Результат ($ - сам Результат) и переносятся под поле data конверта. Без result_labels меток нет.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  МеткиРезультата - Соответствие, Структура, Неопределено - result_labels: путь -> метка
//
&НаКлиенте
Процедура ДобавитьМеткиРезультатаКода(Метки, МеткиРезультата)

	Если ТипЗнч(МеткиРезультата) <> Тип("Соответствие") И ТипЗнч(МеткиРезультата) <> Тип("Структура") Тогда

		Возврат;

	КонецЕсли;

	Для Каждого Элемент Из МеткиРезультата Цикл

		Путь = Строка(Элемент.Ключ);

		Если Лев(Путь, 1) = "$" И ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда

			ДобавитьМеткуВыводаСтрогий(Метки, "$.data" + Сред(Путь, 2), Элемент.Значение);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Метки полей get_object_by_link по политике полей таблицы объекта (ПолитикаПолейНаСервере): поля основной таблицы -
// $.data.<Поле>, поля табличных частей - $.data.<ТЧ>[*].<Поле>. Имя таблицы - поле _type результата, его пишет
// сервер. Поле класса unknown и поле, которого нет в политике (в том числе у внешних таблиц), остаются без метки.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Результат - Произвольный - результат get_object_by_link
//
&НаКлиенте
Процедура ДобавитьМеткиОбъектаПоСсылке(Метки, Результат)

	ИмяТаблицы = ПолеРезультатаПроверки(ПолеРезультатаПроверки(Результат, "data"), "_type");

	Если ТипЗнч(ИмяТаблицы) <> Тип("Строка") Или ПустаяСтрока(ИмяТаблицы) Тогда

		Возврат;

	КонецЕсли;

	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить(ИмяТаблицы);
	Срез = СрезПравилДляПолитики(СнимокПравилСтрогогоРежима, ИменаТаблиц);
	Политика = ПрочитатьJSON2(ПолитикаПолейНаСервере(ИменаТаблиц, Срез));
	Таблица = ПолеРезультатаПроверки(ПолеРезультатаПроверки(Политика, "tables"), ИмяТаблицы);
	ДобавитьМеткиПолейПолитики(Метки, "$.data.", ПолеРезультатаПроверки(Таблица, "fields"));
	Разделы = ПолеРезультатаПроверки(Таблица, "tabular_sections");

	Если ТипЗнч(Разделы) <> Тип("Соответствие") И ТипЗнч(Разделы) <> Тип("Структура") Тогда

		Возврат;

	КонецЕсли;

	Для Каждого Раздел Из Разделы Цикл

		ПутьРаздела = "$.data." + Раздел.Ключ;
		ДобавитьМеткуВыводаСтрогий(Метки, ПутьРаздела, "container");
		ДобавитьМеткуВыводаСтрогий(Метки, ПутьРаздела + "[*]", "container");
		ДобавитьМеткуВыводаСтрогий(Метки, ПутьРаздела + "[*].НомерСтроки", "open");
		ДобавитьМеткиПолейПолитики(Метки, ПутьРаздела + "[*].", ПолеРезультатаПроверки(Раздел.Значение, "fields"));

	КонецЦикла;

КонецПроцедуры

// Метки полей одной таблицы политики: protected - protected; open со ссылочными типами (refs) - ref, без них - open;
// unknown - без метки. Защищенное поле, объявленные типы которого только ссылочные без перечислений (признак
// ref_only в политике), получает ref (решение #3): идентификатор и тип открыты, Представление маскируется в основной
// карте. Метка по объявленным типам, а не по значению: иначе вид значения строки был бы виден клиенту. Без признака
// поле остается protected.
//
// Параметры:
//  Метки - Соответствие - заполняемая таблица меток: ВРег(путь) -> метка
//  Префикс - Строка - путь таблицы с точкой на конце
//  Поля - Соответствие, Структура, Неопределено - поля политики: имя -> {class, refs, ...}
//
&НаКлиенте
Процедура ДобавитьМеткиПолейПолитики(Метки, Префикс, Поля)

	Если ТипЗнч(Поля) <> Тип("Соответствие") И ТипЗнч(Поля) <> Тип("Структура") Тогда

		Возврат;

	КонецЕсли;

	Для Каждого Поле Из Поля Цикл

		Класс = ПолеРезультатаПроверки(Поле.Значение, "class");
		Ссылки = ПолеРезультатаПроверки(Поле.Значение, "refs");
		Класс = ?(Класс = "open" И ТипЗнч(Ссылки) = Тип("Массив") И Ссылки.Количество() > 0, "ref", Класс);

		Если Класс = "protected" И ПолеРезультатаПроверки(Поле.Значение, "ref_only") = Истина Тогда

			Класс = "ref";

		КонецЕсли;

		Если Класс = "open" Или Класс = "protected" Или Класс = "ref" Тогда

			ДобавитьМеткуВыводаСтрогий(Метки, Префикс + Поле.Ключ, Класс);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ПРОВЕРКА ЦЕЛОСТНОСТИ СОСТОЯНИЯ ЗАЩИТЫ ПОСЛЕ ПОДТВЕРЖДЕННОГО ВЫПОЛНЕНИЯ
// ─────────────────────────────────────────────────────────────────────────────────

// Снимок состояния защиты перед подтвержденным выполнением кода: состояние строгого режима, свойства формы,
// влияющие на защиту (включая токен подключения), и настройки защиты в хранилище.
// Снимок берется ПОСЛЕ ОтметитьПодтверждениеКлассаЗащиты, иначе отметка ему неизвестна.
//
// Возвращаемое значение:
//  Структура - Состояние (Структура), Форма (Структура), Сервер (Массив)
//
&НаКлиенте
Функция СнимокСостоянияЗащиты()

	Возврат Новый Структура("Состояние, Форма, Сервер", ЗначенияСостоянияЗащиты(), ЗначенияСвойствЗащитыФормы(),
		СнимокНастроекЗащитыНаСервере());

КонецФункции

// Сверяет состояние защиты со снимком. Откатывается только изменение в сторону более слабой защиты.
// При любом различии сначала пишется журнал (только имена, без значений) и приостанавливается гарантия
// (как после подтверждения действия класса R_PROTECTION), затем восстанавливаются форма и хранилище настроек.
//
// Параметры:
//  Снимок - Структура, Неопределено - результат СнимокСостоянияЗащиты; Неопределено - сверять нечего
//
// Возвращаемое значение:
//  Булево - Истина, если найдены различия и состояние восстановлено
//
&НаКлиенте
Функция СверитьИВосстановитьСостояниеЗащиты(Снимок)

	Если ТипЗнч(Снимок) <> Тип("Структура") Тогда

		Возврат Ложь;

	КонецЕсли;

	КлиентскиеРазличия = Новый Массив;
	ДополнитьРазличияСтруктур(КлиентскиеРазличия, Снимок.Состояние, ЗначенияСостоянияЗащиты());
	ДополнитьРазличияСтруктур(КлиентскиеРазличия, Снимок.Форма, ЗначенияСвойствЗащитыФормы());
	Серверные = РазличияНастроекЗащитыНаСервере(Снимок.Сервер, СостояниеЗащиты.ГарантияПриостановлена);

	Если КлиентскиеРазличия.Количество() + Серверные.Количество() = 0 Тогда

		Возврат Ложь;

	КонецЕсли;

	Различия = Новый Массив;

	Для Каждого Имя Из КлиентскиеРазличия Цикл

		Различия.Добавить(Имя);

	КонецЦикла;

	Для Каждого Элемент Из Серверные Цикл

		Различия.Добавить(Элемент.Объект + "/" + Элемент.Настройка);

	КонецЦикла;

	ДобавитьВЛог("Состояние защиты изменено кодом и восстановлено: " + СоединитьМассив(Различия, ", "));
	ВосстановитьЗащитуПослеРазличий(Снимок, КлиентскиеРазличия, Серверные);

	Возврат Истина;

КонецФункции

// Приостанавливает гарантию и откатывает различия. Порядок: признак приостановки в памяти (до любого шага,
// который может завершиться ошибкой), откат клиентского состояния, запись признака в хранилище (после отката:
// иначе подмена признака строгого режима обходит приостановку), откат настроек в хранилище. Каждый шаг
// выполняется независимо от сбоя предыдущих; ошибка не скрывается: первая из них вызывается повторно в конце.
//
// Параметры:
//  Снимок - Структура - результат СнимокСостоянияЗащиты
//  КлиентскиеРазличия - Массив - имена изменившихся значений состояния и свойств формы
//  Серверные - Массив - результат РазличияНастроекЗащитыНаСервере
//
&НаКлиенте
Процедура ВосстановитьЗащитуПослеРазличий(Снимок, КлиентскиеРазличия, Серверные)

	ОписаниеСбоя = Неопределено;
	ПриостановитьГарантиюВПамяти();

	Попытка

		ВосстановитьСостояниеЗащитыКлиента(Снимок, КлиентскиеРазличия);

	Исключение

		ОписаниеСбоя = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

	ПриостановитьГарантиюВПамяти();

	СбойХранилища = ЗаписатьПриостановкуИВосстановитьНастройки(Серверные);
	ОбновитьОтображениеСостоянияЗащиты();

	Если ОписаниеСбоя = Неопределено Тогда

		ОписаниеСбоя = СбойХранилища;

	КонецЕсли;

	Если ОписаниеСбоя <> Неопределено Тогда

		ВызватьИсключение ОписаниеСбоя;

	КонецЕсли;

КонецПроцедуры

// Устанавливает признак приостановки гарантии в памяти, создавая поле состояния при его отсутствии.
//
&НаКлиенте
Процедура ПриостановитьГарантиюВПамяти()

	Если ТипЗнч(СостояниеЗащиты) <> Тип("Структура") Тогда

		СостояниеЗащиты = Новый Структура;

	КонецЕсли;

	СостояниеЗащиты.Вставить("ГарантияПриостановлена", Истина);

КонецПроцедуры

// Откатывает настройки защиты в хранилище, затем записывает признак приостановки гарантии (с дополнением
// снимком регламентных заданий; уже восстановленная запись признака не перезаписывается). Второй шаг
// выполняется независимо от сбоя первого. Запись признака идет напрямую, а не через
// ОтметитьПодтверждениеКлассаЗащиты: та выходит, если гарантия уже приостановлена в памяти или строгий
// режим выключен подменой.
//
// Параметры:
//  Серверные - Массив - результат РазличияНастроекЗащитыНаСервере
//
// Возвращаемое значение:
//  Строка, Неопределено - описание первого сбоя; Неопределено, если сбоев не было
//
&НаКлиенте
Функция ЗаписатьПриостановкуИВосстановитьНастройки(Серверные)

	ОписаниеСбоя = Неопределено;

	Попытка

		ВосстановитьНастройкиЗащитыНаСервере(Серверные, Истина);

	Исключение

		ОписаниеСбоя = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

	Попытка

		ЗаписатьПриостановкуГарантииНаСервере();
		ПричинаСбоя = ДополнитьПриостановкуСнимкомЗаданийНаСервере();

		Если НЕ ПустаяСтрока(ПричинаСбоя) Тогда

			ДобавитьВЛог("Снимок регламентных заданий не получен: " + ПричинаСбоя);

		КонецЕсли;

	Исключение

		ОписаниеСбоя = ?(ОписаниеСбоя = Неопределено, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), ОписаниеСбоя);

	КонецПопытки;

	Возврат ОписаниеСбоя;

КонецФункции

// Значения полей состояния защиты, которые проверяются. Поля Активен, Переключение и ПричинаНеактивности
// меняются законно при асинхронном переключении режима и не проверяются.
//
// Возвращаемое значение:
//  Структура - Строгий, ГарантияПриостановлена (Неопределено, если поля нет)
//
&НаКлиенте
Функция ЗначенияСостоянияЗащиты()

	Значения = Новый Структура("Строгий, ГарантияПриостановлена", Неопределено, Неопределено);
	Значение = Неопределено;

	Если ТипЗнч(СостояниеЗащиты) <> Тип("Структура") Тогда

		Возврат Значения;

	КонецЕсли;

	Если СостояниеЗащиты.Свойство("Строгий", Значение) Тогда

		Значения.Строгий = Значение;

	КонецЕсли;

	Если СостояниеЗащиты.Свойство("ГарантияПриостановлена", Значение) Тогда

		Значения.ГарантияПриостановлена = Значение;

	КонецЕсли;

	Возврат Значения;

КонецФункции

// Направление, в котором значение защиты можно откатывать: "+" - только к Истина, "-" - только к Ложь,
// "=" - к точному значению снимка.
//
// Параметры:
//  Имя - Строка - имя значения защиты
//
// Возвращаемое значение:
//  Строка - "+", "-" или "="
//
&НаКлиенте
Функция НаправлениеОткатаЗащиты(Имя)

	Если Имя = "Строгий" Или Имя = "ГарантияПриостановлена" Или Имя = "ИспользоватьТочнуюАнонимизацию"
		Или Имя = "СтрогийРежимАнонимизации" Или Имя = "РазрешатьОпасныеОперацииСПодтверждением" Тогда

		Возврат "+";

	ИначеЕсли Найти(Имя, "АвтоРазрешить") = 1 Или Найти(Имя, "ИнструментВключен_") = 1 Тогда

		Возврат "-";

	КонецЕсли;

	Возврат "=";

КонецФункции

// Добавляет в массив имена значений, которые надо откатить: изменившихся в сторону более слабой защиты.
//
// Параметры:
//  Различия - Массив - сюда добавляются имена значений
//  Было - Структура - значения из снимка
//  Стало - Структура - текущие значения
//
&НаКлиенте
Процедура ДополнитьРазличияСтруктур(Различия, Было, Стало)

	Для Каждого Элемент Из Было Цикл

		Значение = Неопределено;
		Стало.Свойство(Элемент.Ключ, Значение);
		Направление = НаправлениеОткатаЗащиты(Элемент.Ключ);

		Если Значение = Элемент.Значение Или (Направление = "+" И Элемент.Значение <> Истина)
			Или (Направление = "-" И Элемент.Значение <> Ложь) Тогда

			Продолжить;

		КонецЕсли;

		Различия.Добавить(Элемент.Ключ);

	КонецЦикла;

КонецПроцедуры

// Возвращает значения свойств формы, влияющих на защиту и адрес сервера.
//
// Возвращаемое значение:
//  Структура - имя свойства -> значение
//
&НаКлиенте
Функция ЗначенияСвойствЗащитыФормы()

	Значения = Новый Структура;
	Значения.Вставить("ИспользоватьТочнуюАнонимизацию", ИспользоватьТочнуюАнонимизацию);
	Значения.Вставить("СтрогийРежимАнонимизации", СтрогийРежимАнонимизации);
	Значения.Вставить("РежимПодключения", РежимПодключения);
	Значения.Вставить("АдресСервера", АдресСервера);
	Значения.Вставить("ПортВстроенногоСервера", ПортВстроенногоСервера);
	Значения.Вставить("ТокенВстроенногоСервера", ТокенВстроенногоСервера);
	Значения.Вставить("АвтоРазрешитьЗаписать", АвтоРазрешитьЗаписать);
	Значения.Вставить("АвтоРазрешитьПривилегированныйРежим", АвтоРазрешитьПривилегированныйРежим);
	Значения.Вставить("РазрешатьОпасныеОперацииСПодтверждением", РазрешатьОпасныеОперацииСПодтверждением);
	Значения.Вставить("ЛимитМаппингаВстроенный", ЛимитМаппингаВстроенный);
	Значения.Вставить("ИнструментВключен_ExecuteQuery", ИнструментВключен_ExecuteQuery);
	Значения.Вставить("ИнструментВключен_ExecuteCode", ИнструментВключен_ExecuteCode);
	Значения.Вставить("ИнструментВключен_GetMetadata", ИнструментВключен_GetMetadata);
	Значения.Вставить("ИнструментВключен_GetEventLog", ИнструментВключен_GetEventLog);
	Значения.Вставить("ИнструментВключен_GetObjectByLink", ИнструментВключен_GetObjectByLink);
	Значения.Вставить("ИнструментВключен_GetLinkOfObject", ИнструментВключен_GetLinkOfObject);
	Значения.Вставить("ИнструментВключен_FindReferences", ИнструментВключен_FindReferences);
	Значения.Вставить("ИнструментВключен_GetAccessRights", ИнструментВключен_GetAccessRights);
	Значения.Вставить("ИнструментВключен_GetBslSyntaxHelp", ИнструментВключен_GetBslSyntaxHelp);
	Значения.Вставить("ИнструментВключен_SubmitDeanon", ИнструментВключен_SubmitDeanon);
	Значения.Вставить("ИнструментВключен_GetScreenshot", ИнструментВключен_GetScreenshot);
	Значения.Вставить("ИнструментВключен_Restart1cSession", ИнструментВключен_Restart1cSession);
	Значения.Вставить("ИнструментВключен_Close1cSession", ИнструментВключен_Close1cSession);

	Возврат Значения;

КонецФункции

// Откатывает значения из списка различий: поля состояния строгого режима и свойства формы.
// Остальные значения не затрагиваются.
//
// Параметры:
//  Снимок - Структура - результат СнимокСостоянияЗащиты
//  Различия - Массив - имена значений, которые надо откатить
//
&НаКлиенте
Процедура ВосстановитьСостояниеЗащитыКлиента(Снимок, Различия)

	Умолчания = Новый Структура("Строгий, Активен, Переключение, ГарантияПриостановлена, ПричинаНеактивности",
		Ложь, Ложь, Ложь, Ложь, "");

	Если ТипЗнч(СостояниеЗащиты) <> Тип("Структура") Тогда

		СостояниеЗащиты = Новый Структура;

	КонецЕсли;

	Для Каждого Элемент Из Умолчания Цикл

		Если НЕ СостояниеЗащиты.Свойство(Элемент.Ключ) Тогда

			СостояниеЗащиты.Вставить(Элемент.Ключ, Элемент.Значение);

		КонецЕсли;

	КонецЦикла;

	Значения = ЗначенияСвойствЗащитыФормы();

	Для Каждого Имя Из Различия Цикл

		Если Снимок.Состояние.Свойство(Имя) Тогда

			СостояниеЗащиты.Вставить(Имя, Снимок.Состояние[Имя]);

		ИначеЕсли Снимок.Форма.Свойство(Имя) Тогда

			Значения.Вставить(Имя, Снимок.Форма[Имя]);

		КонецЕсли;

	КонецЦикла;

	ПрименитьСвойстваЗащитыФормы(Значения);

КонецПроцедуры

// Записывает значения в свойства формы, влияющие на защиту.
//
// Параметры:
//  Значения - Структура - результат ЗначенияСвойствЗащитыФормы
//
&НаКлиенте
Процедура ПрименитьСвойстваЗащитыФормы(Значения)

	ИспользоватьТочнуюАнонимизацию = Значения.ИспользоватьТочнуюАнонимизацию;
	СтрогийРежимАнонимизации = Значения.СтрогийРежимАнонимизации;
	РежимПодключения = Значения.РежимПодключения;
	АдресСервера = Значения.АдресСервера;
	ПортВстроенногоСервера = Значения.ПортВстроенногоСервера;
	ТокенВстроенногоСервера = Значения.ТокенВстроенногоСервера;
	АвтоРазрешитьЗаписать = Значения.АвтоРазрешитьЗаписать;
	АвтоРазрешитьПривилегированныйРежим = Значения.АвтоРазрешитьПривилегированныйРежим;
	РазрешатьОпасныеОперацииСПодтверждением = Значения.РазрешатьОпасныеОперацииСПодтверждением;
	ЛимитМаппингаВстроенный = Значения.ЛимитМаппингаВстроенный;
	ИнструментВключен_ExecuteQuery = Значения.ИнструментВключен_ExecuteQuery;
	ИнструментВключен_ExecuteCode = Значения.ИнструментВключен_ExecuteCode;
	ИнструментВключен_GetMetadata = Значения.ИнструментВключен_GetMetadata;
	ИнструментВключен_GetEventLog = Значения.ИнструментВключен_GetEventLog;
	ИнструментВключен_GetObjectByLink = Значения.ИнструментВключен_GetObjectByLink;
	ИнструментВключен_GetLinkOfObject = Значения.ИнструментВключен_GetLinkOfObject;
	ИнструментВключен_FindReferences = Значения.ИнструментВключен_FindReferences;
	ИнструментВключен_GetAccessRights = Значения.ИнструментВключен_GetAccessRights;
	ИнструментВключен_GetBslSyntaxHelp = Значения.ИнструментВключен_GetBslSyntaxHelp;
	ИнструментВключен_SubmitDeanon = Значения.ИнструментВключен_SubmitDeanon;
	ИнструментВключен_GetScreenshot = Значения.ИнструментВключен_GetScreenshot;
	ИнструментВключен_Restart1cSession = Значения.ИнструментВключен_Restart1cSession;
	ИнструментВключен_Close1cSession = Значения.ИнструментВключен_Close1cSession;

КонецПроцедуры

// Ключи настроек защиты в общем хранилище настроек: защита, адрес и порт сервера, токен, режим подключения,
// ключ шифрования перезапуска, набор инструментов, признак приостановки гарантии, правила регулярных выражений.
//
// Возвращаемое значение:
//  Массив - Структуры: Объект, Настройка
//
&НаСервереБезКонтекста
Функция КлючиНастроекЗащитыНаСервере()

	Ключи = Новый Массив;
	Имена = "ТокенВстроенногоСервера,ИспользоватьТочнуюАнонимизацию,СтрогийРежимАнонимизации,"
		+ "СтрогийГарантияПриостановлена,ExecuteQueryFieldRules.v2,ExecuteQueryFieldRules.v1,"
		+ "НастройкиИнструментов,РежимПодключения,ЛимитМаппингаВстроенный,РежимАутентификацииПерезапуска,"
		+ "ПользовательскийКлючШифрованияПерезапуска,ПортВстроенногоСервера,АдресСервера,ИдентификаторКанала,"
		+ "ВыборАдресаВстроенногоСервера,ФорматОтветаВстроенный,ПараллельноеВыполнение,КонтрольСервера,"
		+ "ТаймаутЗапросаСек,ТаймаутШлюзаСек";

	Для Каждого Имя Из РазделитьСтрокуПоРазделителю(Имена, ",") Цикл

		Ключи.Добавить(Новый Структура("Объект, Настройка", "MCPToolkit", Имя));

	КонецЦикла;

	Ключи.Добавить(Новый Структура("Объект, Настройка", "ExecuteQueryRegexRules.v1", "rules"));

	Возврат Ключи;

КонецФункции

// Снимок настроек защиты в хранилище: значения во внутреннем представлении и признак наличия записи.
//
// Возвращаемое значение:
//  Массив - Структуры: Объект, Настройка, Есть (Булево), Значение (Строка)
//
&НаСервереБезКонтекста
Функция СнимокНастроекЗащитыНаСервере()

	Снимок = Новый Массив;

	Для Каждого Ключ Из КлючиНастроекЗащитыНаСервере() Цикл

		Значение = ХранилищеОбщихНастроек.Загрузить(Ключ.Объект, Ключ.Настройка);
		Снимок.Добавить(Новый Структура("Объект, Настройка, Есть, Значение",
			Ключ.Объект, Ключ.Настройка, Значение <> Неопределено, ЗначениеВСтрокуВнутр(Значение)));

	КонецЦикла;

	Возврат Снимок;

КонецФункции

// Элементы снимка настроек, которые надо вернуть в хранилище. Откат идет только в сторону более строгой защиты:
// - обычные настройки: к значению снимка (в том числе удаление появившейся и возврат удаленной записи);
// - признак приостановки гарантии: действующая приостановка не снимается и не откатывается, даже если в снимке
//   ее не было; отсутствующая или снятая запись восстанавливается, если приостановка есть в снимке или в памяти;
// - СтрогийРежимАнонимизации и ИспользоватьТочнуюАнонимизацию: из снимка возвращается только Истина.
//
// Параметры:
//  Снимок - Массив - результат СнимокНастроекЗащитыНаСервере
//  ПриостановленаВПамяти - Булево - СостояниеЗащиты.ГарантияПриостановлена
//
// Возвращаемое значение:
//  Массив - элементы снимка, требующие восстановления
//
&НаСервереБезКонтекста
Функция РазличияНастроекЗащитыНаСервере(Снимок, ПриостановленаВПамяти)

	Различия = Новый Массив;

	Для Каждого Элемент Из Снимок Цикл

		Текущее = ХранилищеОбщихНастроек.Загрузить(Элемент.Объект, Элемент.Настройка);

		Если ЗначениеВСтрокуВнутр(Текущее) <> Элемент.Значение
			И ЗащитуНужноВосстановить(Элемент, Текущее, ПриостановленаВПамяти) Тогда

			Различия.Добавить(Элемент);

		КонецЕсли;

	КонецЦикла;

	Возврат Различия;

КонецФункции

// Возвращает в хранилище настройки из списка различий. Перед записью условие проверяется заново.
//
// Параметры:
//  Элементы - Массив - результат РазличияНастроекЗащитыНаСервере
//  ПриостановленаВПамяти - Булево - СостояниеЗащиты.ГарантияПриостановлена
//
&НаСервереБезКонтекста
Процедура ВосстановитьНастройкиЗащитыНаСервере(Элементы, ПриостановленаВПамяти)

	Для Каждого Элемент Из Элементы Цикл

		Текущее = ХранилищеОбщихНастроек.Загрузить(Элемент.Объект, Элемент.Настройка);

		Если НЕ ЗащитуНужноВосстановить(Элемент, Текущее, ПриостановленаВПамяти) Тогда

			Продолжить;

		КонецЕсли;

		Если Элемент.Настройка = "СтрогийГарантияПриостановлена" И НЕ ПриостановкаВСнимке(Элемент) Тогда

			ХранилищеОбщихНастроек.Сохранить(Элемент.Объект, Элемент.Настройка,
				Новый Структура("Приостановлена, Момент, СнимокРегламентных, ПричинаБезСнимка",
				Истина, ТекущаяДатаСеанса(), Неопределено, "запись восстановлена после изменения кодом"));

		ИначеЕсли Элемент.Есть Тогда

			ХранилищеОбщихНастроек.Сохранить(Элемент.Объект, Элемент.Настройка, ЗначениеИзСтрокиВнутр(Элемент.Значение));

		Иначе

			ХранилищеОбщихНастроек.Удалить(Элемент.Объект, Элемент.Настройка, ИмяПользователя());

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Нужно ли возвращать настройку к значению из снимка (только если это не ослабляет защиту).
//
// Параметры:
//  Элемент - Структура - элемент снимка настроек
//  Текущее - Произвольный - текущее значение настройки
//  ПриостановленаВПамяти - Булево - гарантия приостановлена по состоянию формы
//
// Возвращаемое значение:
//  Булево - Истина, если надо записать значение из снимка (или приостановку)
//
&НаСервереБезКонтекста
Функция ЗащитуНужноВосстановить(Элемент, Текущее, ПриостановленаВПамяти)

	Если Элемент.Настройка = "СтрогийГарантияПриостановлена" Тогда

		Приостановлена = Неопределено;

		Если ТипЗнч(Текущее) = Тип("Структура") И Текущее.Свойство("Приостановлена", Приостановлена)
			И Приостановлена = Истина Тогда

			Возврат Ложь;

		КонецЕсли;

		Возврат ПриостановленаВПамяти Или ПриостановкаВСнимке(Элемент);

	КонецЕсли;

	Если Элемент.Настройка = "СтрогийРежимАнонимизации" Или Элемент.Настройка = "ИспользоватьТочнуюАнонимизацию" Тогда

		Возврат Текущее <> Истина И Элемент.Есть И ЗначениеИзСтрокиВнутр(Элемент.Значение) = Истина;

	КонецЕсли;

	Возврат Истина;

КонецФункции

// Была ли в снимке настроек действующая приостановка гарантии.
//
// Параметры:
//  Элемент - Структура - элемент снимка настроек "СтрогийГарантияПриостановлена"
//
// Возвращаемое значение:
//  Булево - Истина, если в снимке запись с Приостановлена = Истина
//
&НаСервереБезКонтекста
Функция ПриостановкаВСнимке(Элемент)

	Запись = ?(Элемент.Есть, ЗначениеИзСтрокиВнутр(Элемент.Значение), Неопределено);
	Приостановлена = Неопределено;

	Возврат ТипЗнч(Запись) = Тип("Структура") И Запись.Свойство("Приостановлена", Приостановлена)
		И Приостановлена = Истина;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// ПЕРЕЗАПУСК СЕССИИ (restart_1c_session)
// ─────────────────────────────────────────────────────────────────────────────────

// Пишется ли карта токенов во временный файл перезапуска. В строгом режиме (и во время переключения) карта на диск
// не пишется никогда: файл достижим для ИИ-клиента, а токены нового сеанса должны быть неизвестны (E_TOKEN_UNKNOWN).
//
// Параметры:
//  БезКартыТокенов - Булево - вызывающий запретил запись карты (строгий вызов restart / close)
//
// Возвращаемое значение:
//  Булево - Истина, если карту токенов нужно записать в файл
//
&НаКлиенте
Функция КартаТокеновПишетсяВФайлПерезапуска(БезКартыТокенов)

	Возврат НЕ БезКартыТокенов И НЕ СостояниеЗащиты.Строгий И НЕ СостояниеЗащиты.Переключение;

КонецФункции

// Добавляет в параметры перезапуска флаги опасных операций. В строгом режиме (и во время переключения) флаги в файл
// не пишутся: состояние защиты не передается через файл, достижимый для ИИ-клиента.
//
// Параметры:
//  ПараметрыЗапуска - Структура - содержимое файла параметров перезапуска; дополняется
//
&НаКлиенте
Процедура ДобавитьФлагиОпасныхОперацийВПараметрыПерезапуска(ПараметрыЗапуска)

	Если СостояниеЗащиты.Строгий Или СостояниеЗащиты.Переключение Тогда

		Возврат;

	КонецЕсли;

	ПараметрыЗапуска.Вставить("danger_auto_write", АвтоРазрешитьЗаписать);
	ПараметрыЗапуска.Вставить("danger_auto_priv", АвтоРазрешитьПривилегированныйРежим);
	ПараметрыЗапуска.Вставить("danger_confirm", РазрешатьОпасныеОперацииСПодтверждением);

КонецПроцедуры

// Возвращает путь к temp-файлу или "" если маппинги пусты/не нужны
&НаКлиенте
Функция СохранитьМаппингиАнонимизацииВоВременныйФайл(ПутьФайла = "")
	// В proxy mode маппинги живут в Python — передавать нечего
	Если РежимПодключения = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если МаппингАнонимизации = Неопределено Или МаппингАнонимизации.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	МассивМ = Новый Массив;
	Для Каждого П Из МаппингАнонимизации Цикл
		МассивМ.Добавить(Новый Структура("к,т", П.Ключ, П.Значение));
	КонецЦикла;

	МассивС = Новый Массив;
	Если СчетчикиТокенов <> Неопределено Тогда
		Для Каждого П Из СчетчикиТокенов Цикл
			МассивС.Добавить(Новый Структура("к,с", П.Ключ, П.Значение));
		КонецЦикла;
	КонецЕсли;

	// Живой хвост очереди вставки (порядок вытеснения) — только от головы до конца.
	// Индекс головы сериализовать не нужно: на диск идёт уже компактная очередь.
	МассивО = Новый Массив;
	Если ОчередьВставки <> Неопределено Тогда
		Голова = ?(ГоловаОчереди = Неопределено, 0, ГоловаОчереди);
		Для Инд = Голова По ОчередьВставки.Количество() - 1 Цикл
			МассивО.Добавить(ОчередьВставки[Инд]);
		КонецЦикла;
	КонецЕсли;

	Данные = Новый Структура("м,с,о", МассивМ, МассивС, МассивО);

	ВременныйФайл = ?(ЗначениеЗаполнено(ПутьФайла), ПутьФайла, ПолучитьИмяВременногоФайла("json"));
	ЗТМапп = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	Попытка
		ЗТМапп.Записать(ЗаписатьJSON2(Данные));
	Исключение
		Попытка ЗТМапп.Закрыть(); Исключение КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	ЗТМапп.Закрыть();

	Возврат ВременныйФайл;
КонецФункции

&НаКлиенте
Процедура ВосстановитьМаппингиАнонимизацииИзФайла(Путь)
	Если Путь = "" Тогда
		Возврат;
	КонецЕсли;

	ЧТМапп = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Попытка
		ТекстМапп = ЧТМапп.Прочитать();
	Исключение
		Попытка ЧТМапп.Закрыть(); Исключение КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	ЧТМапп.Закрыть();
	Данные = ПрочитатьJSON2(ТекстМапп);
	УдалитьФайлы(Путь);

	МаппингАнонимизации   = Новый Соответствие;
	МаппингДеанонимизации = Новый Соответствие;
	Для Каждого З Из Данные.м Цикл
		МаппингАнонимизации[З.к]         = З.т;
		МаппингДеанонимизации[ВРег(З.т)] = З.к;
	КонецЦикла;

	СчетчикиТокенов = Новый Соответствие;
	Для Каждого З Из Данные.с Цикл
		СчетчикиТокенов[З.к] = З.с;
	КонецЦикла;

	// Очередь вставки (порядок вытеснения) — обязательная часть eviction-state.
	// Толерантно к старому формату без поля "о": восстанавливаем порядок из карты
	// (обход Данные.м), чтобы каждая живая пара была ровно один раз в eviction-order.
	ОчередьВставки = Новый Массив;
	Если Данные.Свойство("о") И Данные.о <> Неопределено Тогда
		Для Каждого ЭлемОчереди Из Данные.о Цикл
			ОчередьВставки.Добавить(ЭлемОчереди);
		КонецЦикла;
	Иначе
		Для Каждого З Из Данные.м Цикл
			ОчередьВставки.Добавить(З.к);
		КонецЦикла;
	КонецЕсли;
	ГоловаОчереди = 0;
КонецПроцедуры

// Восстанавливает МСПСессии из плоского массива строк (session ID).
// Восстановленные сессии получают текущее время — корректно, они все "только что" пришли.
&НаКлиенте
Процедура ВосстановитьМСПСессии(МассивИдС)
	Если МассивИдС = Неопределено Или МассивИдС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	МСПСессии = Новый Соответствие;
	Для Каждого ИдС Из МассивИдС Цикл
		Если ТипЗнч(ИдС) <> Тип("Строка") Или НЕ ВалидныйФорматСессии(ИдС) Тогда
			ВызватьИсключение "Sessions restore error: invalid session ID type or format: " + Строка(ИдС);
		КонецЕсли;
		МСПСессии[ИдС] = ТекущаяДата();
	КонецЦикла;
	ДобавитьВЛог("Восстановлено сессий: " + МассивИдС.Количество() + " → " + СоединитьМассив(МассивИдС, ", "));
КонецПроцедуры

// Побитовый XOR двух байт (0-255) через арифметику
&НаКлиенте
Функция XORБайт(А, Б)
	Рез = 0; Ст = 1;
	Для Индекс = 0 По 7 Цикл
		Рез = Рез + (Цел(А / Ст) % 2 + Цел(Б / Ст) % 2) % 2 * Ст;
		Ст = Ст * 2;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Шифрует пароль XOR с ключом; результат — Base64. Никаких temp-файлов.
&НаКлиенте
Функция ЗашифроватьПарольПерезапуска(Пароль, КлючШифрования = "")
	Если НЕ ЗначениеЗаполнено(Пароль) Тогда Возврат ""; КонецЕсли;

	ДД_Пароль = ПолучитьДвоичныеДанныеИзСтроки(Пароль, КодировкаТекста.UTF8);
	ДД_Ключ   = ПолучитьДвоичныеДанныеИзСтроки(?(ЗначениеЗаполнено(КлючШифрования), КлючШифрования, ПолучитьКлючШифрования()), КодировкаТекста.UTF8);

	КлючБайты = Новый Массив;
	ЧтК = Новый ЧтениеДанных(ДД_Ключ.ОткрытьПотокДляЧтения());
	Б = ЧтК.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		КлючБайты.Добавить(Б);
		Б = ЧтК.ПрочитатьБайт();
	КонецЦикла;
	ЧтК.Закрыть();
	Если КлючБайты.Количество() = 0 Тогда ВызватьИсключение "XOR key is empty"; КонецЕсли;

	ПотокРез = Новый ПотокВПамяти();
	ЗпР = Новый ЗаписьДанных(ПотокРез);
	ЧтП = Новый ЧтениеДанных(ДД_Пароль.ОткрытьПотокДляЧтения());
	КлючИндекс = 0;
	Б = ЧтП.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		ЗпР.ЗаписатьБайт(XORБайт(Б, КлючБайты[КлючИндекс % КлючБайты.Количество()]));
		КлючИндекс = КлючИндекс + 1;
		Б = ЧтП.ПрочитатьБайт();
	КонецЦикла;
	ЧтП.Закрыть();
	ЗпР.Закрыть();
	Возврат Base64Строка(ПотокРез.ЗакрытьИПолучитьДвоичныеДанные());
КонецФункции

// Расшифровывает — XOR симметричен, логика идентична шифрованию.
&НаКлиенте
Функция РасшифроватьПарольПерезапуска(ЗашифрованнаяСтрока, КлючШифрования = "")
	Если НЕ ЗначениеЗаполнено(ЗашифрованнаяСтрока) Тогда Возврат ""; КонецЕсли;

	ДД_Шифр = Base64Значение(ЗашифрованнаяСтрока);
	ДД_Ключ = ПолучитьДвоичныеДанныеИзСтроки(?(ЗначениеЗаполнено(КлючШифрования), КлючШифрования, ПолучитьКлючШифрования()), КодировкаТекста.UTF8);

	КлючБайты = Новый Массив;
	ЧтК = Новый ЧтениеДанных(ДД_Ключ.ОткрытьПотокДляЧтения());
	Б = ЧтК.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		КлючБайты.Добавить(Б);
		Б = ЧтК.ПрочитатьБайт();
	КонецЦикла;
	ЧтК.Закрыть();
	Если КлючБайты.Количество() = 0 Тогда ВызватьИсключение "XOR key is empty"; КонецЕсли;

	ПотокРез = Новый ПотокВПамяти();
	ЗпР = Новый ЗаписьДанных(ПотокРез);
	ЧтШ = Новый ЧтениеДанных(ДД_Шифр.ОткрытьПотокДляЧтения());
	КлючИндекс = 0;
	Б = ЧтШ.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		ЗпР.ЗаписатьБайт(XORБайт(Б, КлючБайты[КлючИндекс % КлючБайты.Количество()]));
		КлючИндекс = КлючИндекс + 1;
		Б = ЧтШ.ПрочитатьБайт();
	КонецЦикла;
	ЧтШ.Закрыть();
	ЗпР.Закрыть();
	Возврат ПолучитьСтрокуИзДвоичныхДанных(ПотокРез.ЗакрытьИПолучитьДвоичныеДанные(), КодировкаТекста.UTF8);
КонецФункции

&НаСервере
Функция ПолучитьПользовательскийКлючИзХранилищаНаСервере()
	Попытка
		ЗначениеИзХранилища = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ПользовательскийКлючШифрованияПерезапуска");
		Если ТипЗнч(ЗначениеИзХранилища) = Тип("Строка") Тогда
			Возврат Лев(СокрЛП(ЗначениеИзХранилища), 20);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции

&НаКлиенте
