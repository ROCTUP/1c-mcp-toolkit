	Попытка
		Окна = ПолучитьОкна();
		// Имя Окно занято свойством управляемой формы, недоступным для записи.
		Для Каждого ОкноКлиента Из Окна Цикл
			ПробаСодержимого = ОкноКлиента.Содержимое;
			Прервать;
		КонецЦикла;
		Доступно = Истина;
	Исключение
		Доступно = Ложь;
	КонецПопытки;
	Возврат Доступно;
КонецФункции

