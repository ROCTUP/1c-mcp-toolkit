			"registration", ИдРегистрацииСервера, "ОткрытьMCPToolkit", ОтпечатокРегистрацииЗапуска);
	КонецЕсли;
	ПутьИсточника = ПолучитьПутьКОбработкеНаСервере();
	Если Лев(НРег(СтрЗаменить(ПутьИсточника, "\", "/")), 6) = "e1cib/" Тогда
		ВызватьИсключение "Не удалось определить путь к обработке, открытой из файла. Перезапустите сеанс 1С и откройте обработку из файла повторно.";
