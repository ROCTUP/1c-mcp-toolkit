// Снимок точных ссылок на доступные формы всех окон — основа доказательства владения
// для пути link. Независим от совпадения с целевой ссылкой. Ошибка чтения содержимого
// окна не молчит: признак Полный = Ложь запрещает считать отсутствие экземпляра
// доказательством создания.
Функция СнимокДоступныхФормЗахвата()
	Снимок = Новый Массив;
	ПеречислениеПолное = Истина;
	Окна = ПолучитьОкна();
	Для Каждого ОкноКлиента Из Окна Цикл
		СодержимоеОкна = Неопределено;
		Попытка
			СодержимоеОкна = ОкноКлиента.Содержимое;
		Исключение
			ПеречислениеПолное = Ложь;
			Продолжить;
		КонецПопытки;
		Если СодержимоеОкна = Неопределено Тогда
			ПеречислениеПолное = Ложь;
			Продолжить;
		КонецЕсли;
		Для Каждого ФормаОкна Из СодержимоеОкна Цикл
			Если ЭтоФормаКлиентскогоПриложения(ФормаОкна) Тогда
				Снимок.Добавить(ФормаОкна);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Формы, Полный", Снимок, ПеречислениеПолное);
КонецФункции

&НаКлиенте
// Поиск открытых форм объекта по нормализованному ключу идентичности (НРег ссылки).
// Содержимое окна рассматривается только после совпадения навигационной ссылки окна;
// активное окно специально не предпочитается. Дубликаты одной формы схлопываются.
Функция НайтиФормыЗахватаПоСсылке(КлючИдентичности)
	Найденные = Новый Массив;
	УчтенныеФормы = Новый Массив;
	Окна = ПолучитьОкна();
	Для Каждого ОкноКлиента Из Окна Цикл
		СсылкаОкна = НавигационнаяСсылкаОкна(ОкноКлиента);
		Если СсылкаОкна = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(СокрЛП(СсылкаОкна)) <> КлючИдентичности Тогда
			Продолжить;
		КонецЕсли;
		СодержимоеОкна = Неопределено;
		Попытка
			СодержимоеОкна = ОкноКлиента.Содержимое;
		Исключение
			Продолжить;
		КонецПопытки;
		Если СодержимоеОкна = Неопределено ИЛИ СодержимоеОкна.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ФормаОкна = СодержимоеОкна[0];
		Если НЕ ЭтоФормаКлиентскогоПриложения(ФормаОкна) Тогда
			Продолжить;
		КонецЕсли;
		Если ФормаЕстьВМассиве(УчтенныеФормы, ФормаОкна) Тогда
			Продолжить;
		КонецЕсли;
		УчтенныеФормы.Добавить(ФормаОкна);
		Найденные.Добавить(Новый Структура("Форма, Окно", ФормаОкна, ОкноКлиента));
	КонецЦикла;
	Возврат Найденные;
КонецФункции

&НаКлиенте
// Разрешение цели по навигационной ссылке. Возвращает Неопределено при успехе
// (ФормаЗахвата/ОкноЗахвата заполнены, владение зафиксировано) или структуру ошибки.
// Идентификация цели (совпадение ссылки) и владение экземпляром (доказанно создан
// этим запросом) — разные проверки; недоказанное владение никогда не приводит
// к автоматическому закрытию чужой формы.
Функция ПодготовитьФормуЗахватаПоСсылке(КонтекстВыполненияКоманды, Подготовка)
	Если НЕ СодержимоеОконДоступно() Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Снимок по link не поддерживается на этой версии платформы (требуется 8.3.5+)");
	КонецЕсли;

	// Снимок до поиска и перехода: владение доказывается отсутствием экземпляра в нём
	ИсходныеФормы = СнимокДоступныхФормЗахвата();

	Найденные = НайтиФормыЗахватаПоСсылке(Подготовка.КлючИдентичностиЦели);
	Если Найденные.Количество() > 1 Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Найдено несколько открытых форм объекта по ссылке; выбор неоднозначен, ни одна не изменена");
	КонецЕсли;
	Если Найденные.Количество() = 1 Тогда
		// Существующая форма: переход не вызываем, владения нет — не закрываем
		КонтекстВыполненияКоманды.ФормаЗахвата = Найденные[0].Форма;
		КонтекстВыполненияКоманды.ОкноЗахвата = Найденные[0].Окно;
		Возврат Неопределено;
	КонецЕсли;

	// Ни одной: один переход, повторный поиск
	Попытка
		ПерейтиПоНавигационнойСсылке(Подготовка.СсылкаЦели);
	Исключение
		Возврат Новый Структура("success,error", Ложь,
			"Переход по ссылке не выполнен: " + ОписаниеОшибки());
	КонецПопытки;

	Найденные = НайтиФормыЗахватаПоСсылке(Подготовка.КлючИдентичностиЦели);
	Если Найденные.Количество() = 0 Тогда
		Возврат Новый Структура("success,error", Ложь,
			"Целевая форма не найдена после перехода по ссылке");
	КонецЕсли;
	Если Найденные.Количество() > 1 Тогда
		Возврат Новый Структура("success,error", Ложь,
			"После перехода найдено несколько форм объекта; владение не доказано, формы не изменены");
	КонецЕсли;

	Найденная = Найденные[0];
	Если НЕ ИсходныеФормы.Полный Тогда
		// Не удалось перечислить все формы до перехода: отсутствие экземпляра
		// в снимке ничего не доказывает. Форму не закрываем и операцию не продолжаем.
		Возврат Новый Структура("success,error", Ложь,
			"Владение формой не доказано: неполное перечисление форм до перехода");
	КонецЕсли;
	Если ФормаЕстьВМассиве(ИсходныеФормы.Формы, Найденная.Форма) Тогда
		// Форма существовала до перехода, но не была найдена первым поиском:
		// перечисление неполное — доверять владению нельзя. Форму не закрываем
		// и операцию не продолжаем, чтобы не снять чужое окно.
		Возврат Новый Структура("success,error", Ложь,
			"Владение формой не доказано: экземпляр существовал до перехода, но не был найден при первом поиске");
	КонецЕсли;

	// Экземпляр отсутствовал в исходном снимке и найден после одного перехода —
	// однозначно создан этой операцией
	КонтекстВыполненияКоманды.ФормаЗахвата = Найденная.Форма;
	КонтекстВыполненияКоманды.ОкноЗахвата = Найденная.Окно;
	КонтекстВыполненияКоманды.ФормаДляЗакрытия = Найденная.Форма;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
// Поиск страницы по внутреннему имени и построение цепочки переключений.
// Возвращает Структуру(Ошибка, Цепочка): Цепочка — массив Структура(Группа,
// ЦелеваяСтраница) от вложенной группы к внешней (снизу вверх).
Функция ПодготовитьПереключениеСтраницыЗахвата(ФормаЗахвата, ИмяСтраницы)
	Результат = Новый Структура("Ошибка, Цепочка", Неопределено, Неопределено);

	ЭлементСтраницы = ФормаЗахвата.Элементы.Найти(ИмяСтраницы);
	Если ЭлементСтраницы = Неопределено Тогда
		Результат.Ошибка = "Страница не найдена: " + ИмяСтраницы;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ЭлементСтраницы) <> Тип("ГруппаФормы")
		ИЛИ ЭлементСтраницы.Вид <> ВидГруппыФормы.Страница Тогда
		Результат.Ошибка = "Элемент не является страницей формы: " + ИмяСтраницы;
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЭлементСтраницы.Видимость ИЛИ НЕ ЭлементСтраницы.Доступность Тогда
		Результат.Ошибка = "Страница скрыта или недоступна: " + ИмяСтраницы;
		Возврат Результат;
	КонецЕсли;

	Цепочка = Новый Массив;
	ЦелеваяСтраницаУровня = ЭлементСтраницы;
	ТекущийРодитель = ЭлементСтраницы.Родитель;
	Пока ТипЗнч(ТекущийРодитель) = Тип("ГруппаФормы") Цикл
		Если НЕ ТекущийРодитель.Видимость ИЛИ НЕ ТекущийРодитель.Доступность Тогда
			Результат.Ошибка = "Родительский элемент страницы скрыт или недоступен: " + ТекущийРодитель.Имя;
			Возврат Результат;
		КонецЕсли;
		Если ТекущийРодитель.Вид = ВидГруппыФормы.Страницы Тогда
			Если ТекущийРодитель.ТекущаяСтраница = Неопределено Тогда
				// Точное восстановление невозможно — отклоняем переключение до изменений
				Результат.Ошибка = "Исходная страница группы не представлена в программной модели: " + ТекущийРодитель.Имя;
				Возврат Результат;
			КонецЕсли;
			Цепочка.Добавить(Новый Структура("Группа, ЦелеваяСтраница", ТекущийРодитель, ЦелеваяСтраницаУровня));
		ИначеЕсли ТекущийРодитель.Вид = ВидГруппыФормы.Страница Тогда
			ЦелеваяСтраницаУровня = ТекущийРодитель;
		КонецЕсли;
		ТекущийРодитель = ТекущийРодитель.Родитель;
	КонецЦикла;

	Результат.Цепочка = Цепочка;
	Возврат Результат;
КонецФункции

&НаКлиенте
// Применяет подготовленную цепочку от внешней группы к вложенной. Уже текущие страницы
// не переключаются. Каждое фактическое изменение пишется в ИзмененныеСтраницыЗахвата
// до присваивания. Возвращает Неопределено или строку ошибки.
Функция ПрименитьЦепочкуСтраницЗахвата(КонтекстОперации)
	Цепочка = Неопределено;
	Если НЕ КонтекстОперации.Свойство("ЦепочкаСтраницЗахвата", Цепочка) ИЛИ Цепочка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для ИндексЦепочки = 1 По Цепочка.Количество() Цикл
		// Прерывание между шагами (вложенная отмена/чужой слот): продолжать нельзя,
		// восстановлением уже сделанного займётся терминал/отмена
		Если АктивныйЗахватСкриншота = Неопределено
			ИЛИ АктивныйЗахватСкриншота.ИдОперации <> КонтекстОперации.ИдОперации Тогда
			Возврат "Операция прервана при переключении страниц";
		КонецЕсли;
		ШагЦепочки = Цепочка[Цепочка.Количество() - ИндексЦепочки];
		ГруппаСтраниц = ШагЦепочки.Группа;
		Если ГруппаСтраниц.ТекущаяСтраница = ШагЦепочки.ЦелеваяСтраница Тогда
			Продолжить;
		КонецЕсли;
		// Запись восстановления пишется ДО присваивания: исключение или вложенная
		// отмена во время установки не теряют уже сделанное изменение
		ЗаписьИзменения = Новый Структура("Группа, ИсходнаяСтраница, УстановленнаяСтраница",
			ГруппаСтраниц, ГруппаСтраниц.ТекущаяСтраница, ШагЦепочки.ЦелеваяСтраница);
		КонтекстОперации.ИзмененныеСтраницыЗахвата.Добавить(ЗаписьИзменения);
		Попытка
			ГруппаСтраниц.ТекущаяСтраница = ШагЦепочки.ЦелеваяСтраница;
		Исключение
			Возврат "Ошибка переключения страницы: " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
// Проверка перед вызовом DLL: выбранная цепочка страниц не должна измениться
// после переключения. Возвращает Неопределено или строку ошибки; повторных
// переключений не выполняет.
Функция ПроверитьЦепочкуСтраницЗахвата(КонтекстОперации)
	Цепочка = Неопределено;
	Если НЕ КонтекстОперации.Свойство("ЦепочкаСтраницЗахвата", Цепочка) ИЛИ Цепочка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ШагЦепочки Из Цепочка Цикл
		ТекущаяСтраницаГруппы = Неопределено;
		Попытка
			ТекущаяСтраницаГруппы = ШагЦепочки.Группа.ТекущаяСтраница;
		Исключение
			Возврат "Группа страниц стала недоступна до захвата";
		КонецПопытки;
		Если ТекущаяСтраницаГруппы <> ШагЦепочки.ЦелеваяСтраница Тогда
			Возврат "Выбранная страница изменилась до захвата: " + ШагЦепочки.Группа.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
// Восстановление страниц ранее открытой формы после снимка. Восстанавливаются только
// фактически изменённые этой операцией группы, в обратном порядке, и только если
// текущая страница всё ещё равна установленной операцией (выбор пользователя не
// перетирается). Собственная новая форма закрывается без обратных переключений.
// Возвращает "" или текст ошибки восстановления; идемпотентна.
Функция ВосстановитьСтраницыЗахвата(КонтекстОперации)
	ЖурналИзменений = Неопределено;
	Если НЕ КонтекстОперации.Свойство("ИзмененныеСтраницыЗахвата", ЖурналИзменений)
		ИЛИ ЖурналИзменений = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	КонтекстОперации.Вставить("ИзмененныеСтраницыЗахвата", Неопределено);

	ФормаДляЗакрытияЗн = Неопределено;
	Если КонтекстОперации.Свойство("ФормаДляЗакрытия", ФормаДляЗакрытияЗн)
		И ФормаДляЗакрытияЗн <> Неопределено Тогда
		Возврат ""; // своя форма закрывается, восстановление не нужно
	КонецЕсли;

	ФормаЗахвата = Неопределено;
	Если НЕ КонтекстОперации.Свойство("ФормаЗахвата", ФормаЗахвата) ИЛИ ФормаЗахвата = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ФормаОткрыта = Ложь;
	Попытка
		ФормаОткрыта = ФормаЗахвата.Открыта();
	Исключение
		Возврат ""; // форма недоступна — заново ради восстановления не открываем
	КонецПопытки;
	Если НЕ ФормаОткрыта Тогда
		Возврат "";
	КонецЕсли;

	ОшибкиВосстановления = "";
	Для ИндексЖурнала = 1 По ЖурналИзменений.Количество() Цикл
		ЗаписьИзменения = ЖурналИзменений[ЖурналИзменений.Количество() - ИндексЖурнала];
		Попытка
			Если ЗаписьИзменения.Группа.ТекущаяСтраница <> ЗаписьИзменения.УстановленнаяСтраница Тогда
				// Пользователь или конфигурация выбрали другую страницу — пропуск,
				// это не ошибка восстановления
				Продолжить;
			КонецЕсли;
			ЗаписьИзменения.Группа.ТекущаяСтраница = ЗаписьИзменения.ИсходнаяСтраница;
		Исключение
			ДобавитьВЛог("Скриншот: не удалось восстановить страницу: " + ОписаниеОшибки());
			ОшибкиВосстановления = ОшибкиВосстановления
				+ ?(ПустаяСтрока(ОшибкиВосстановления), "", "; ") + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	Возврат ОшибкиВосстановления;
КонецФункции

&НаКлиенте
Функция СтадияЗахватаАктуальна(КонтекстОперации, ОжидаемаяСтадия)
	Стадия = "";
	Если НЕ КонтекстОперации.Свойство("СтадияЗахвата", Стадия) ИЛИ Стадия <> ОжидаемаяСтадия Тогда
		Возврат Ложь;
	КонецЕсли;
	Отменена = Ложь;
	Если КонтекстОперации.Свойство("Отменена", Отменена) И Отменена Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ПоколениеКонтекстаАктуально(КонтекстОперации) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ФормаЗахватаОткрыта(КонтекстОперации, ТекстОшибкиЗакрытия)
	ФормаЗахвата = Неопределено;
	Если НЕ КонтекстОперации.Свойство("ФормаЗахвата", ФормаЗахвата)
		ИЛИ ФормаЗахвата = Неопределено Тогда
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, ТекстОшибкиЗакрытия);
		Возврат Ложь;
	КонецЕсли;
	ФормаОткрыта = Ложь;
	Попытка
		ФормаОткрыта = ФормаЗахвата.Открыта();
	Исключение
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, ТекстОшибкиЗакрытия);
		Возврат Ложь;
	КонецПопытки;
	Если НЕ ФормаОткрыта Тогда
		// Пользователь закрыл форму: повторно не открываем
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, ТекстОшибкиЗакрытия);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура АктивироватьФормуЗахвата() Экспорт
	// Одноразовое ожидание первой стадии (1,5 с после открытия формы).
	// Таймер будит текущую машину состояний: идентификатор операции недоступен
	КонтекстОперации = АктивныйЗахватСкриншота;
	Если КонтекстОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ СтадияЗахватаАктуальна(КонтекстОперации, "ОжиданиеОткрытия") Тогда
		Возврат; // событие чужой или другой стадии
	КонецЕсли;

	ОстатокМс = КонтекстОперации.СрокСтадии - ТекущиеМиллисекундыКлиента();
	Если ОстатокМс > 0 Тогда
		// Событие пришло раньше срока: перепостановка на остаток
		Попытка
			ПодключитьОбработчикОжидания("АктивироватьФормуЗахвата",
				Макс(0.1, ОстатокМс / 1000), Истина);
		Исключение
			ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации,
				"Ошибка подключения обработчика ожидания: " + ОписаниеОшибки());
		КонецПопытки;
		Возврат;
	КонецЕсли;

	Если НЕ ФормаЗахватаОткрыта(КонтекстОперации, "Форма закрыта до активации") Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КонтекстОперации.ФормаЗахвата.Активизировать();
	Исключение
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации,
			"Ошибка активации формы: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Подготовка интерфейса: выбор запрошенной страницы после активации формы.
	// Стадия меняется ДО UI-вызовов переключения, способных вызвать вложенные события
	ИмяСтраницыЗн = "";
	КонтекстОперации.Свойство("ИмяСтраницыЗахвата", ИмяСтраницыЗн);
	Если ЗначениеЗаполнено(ИмяСтраницыЗн) Тогда
		КонтекстОперации.СтадияЗахвата = "ПодготовкаИнтерфейса";
		Попытка
			ПодготовкаСтраницы = ПодготовитьПереключениеСтраницыЗахвата(
				КонтекстОперации.ФормаЗахвата, ИмяСтраницыЗн);
			Если ПодготовкаСтраницы.Ошибка <> Неопределено Тогда
				ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, ПодготовкаСтраницы.Ошибка);
				Возврат;
			КонецЕсли;
			КонтекстОперации.Вставить("ЦепочкаСтраницЗахвата", ПодготовкаСтраницы.Цепочка);
			ОшибкаПереключения = ПрименитьЦепочкуСтраницЗахвата(КонтекстОперации);
			Если ОшибкаПереключения <> Неопределено Тогда
				ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, ОшибкаПереключения);
				Возврат;
			КонецЕсли;
		Исключение
			// Платформенные обращения на этой стадии — вне прямого контроля: любое
			// исключение уходит в общий терминал, слот и страницы не зависают
			ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации,
				"Ошибка подготовки страницы: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		// UI-вызовы могли спровоцировать вложенные события: слот, отмена и поколение
		// проверяются повторно перед установкой следующего таймера
		Если АктивныйЗахватСкриншота = Неопределено
			ИЛИ АктивныйЗахватСкриншота.ИдОперации <> КонтекстОперации.ИдОперации Тогда
			Возврат;
		КонецЕсли;
		Если НЕ СтадияЗахватаАктуальна(КонтекстОперации, "ПодготовкаИнтерфейса") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Стадия меняется до регистрации следующего ожидания: повторный вход — no-op.
	// Срок отсчитывается от окончания всех изменений интерфейса (включая страницы)
	КонтекстОперации.СтадияЗахвата = "ОжиданиеАктивации";
	КонтекстОперации.СрокСтадии = ТекущиеМиллисекундыКлиента() + 700;

	Попытка
		ПодключитьОбработчикОжидания("НачатьЗахватПослеАктивации", 0.7, Истина);
	Исключение
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации,
			"Ошибка подключения обработчика ожидания: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗахватПослеАктивации() Экспорт
	// Одноразовое ожидание второй стадии (0,7 с после активации формы)
	КонтекстОперации = АктивныйЗахватСкриншота;
	Если КонтекстОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ СтадияЗахватаАктуальна(КонтекстОперации, "ОжиданиеАктивации") Тогда
		Возврат;
	КонецЕсли;

	ОстатокМс = КонтекстОперации.СрокСтадии - ТекущиеМиллисекундыКлиента();
	Если ОстатокМс > 0 Тогда
		Попытка
			ПодключитьОбработчикОжидания("НачатьЗахватПослеАктивации",
				Макс(0.1, ОстатокМс / 1000), Истина);
		Исключение
			ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации,
				"Ошибка подключения обработчика ожидания: " + ОписаниеОшибки());
		КонецПопытки;
		Возврат;
	КонецЕсли;

	Если НЕ ФормаЗахватаОткрыта(КонтекстОперации, "Форма закрыта до захвата") Тогда
		Возврат;
	КонецЕсли;

	// Выбранная цепочка страниц должна сохраниться до захвата; повторных
	// переключений здесь не выполняем — изменение состояния это ошибка операции
	ОшибкаЦепочки = ПроверитьЦепочкуСтраницЗахвата(КонтекстОперации);
	Если ОшибкаЦепочки <> Неопределено Тогда
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, ОшибкаЦепочки);
		Возврат;
	КонецЕсли;

	// Стадия меняется до запуска DLL: повторное событие не запустит второй захват
	КонтекстОперации.СтадияЗахвата = "Захват";
	Подготовка = КонтекстОперации.Подготовка;

	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		КонтекстОперации.ВызовКомпонентыВыполняется = Истина;
		РезультатЗапуска = ЗапуститьАсинхронныйЗахватКомпоненты(КонтекстОперации);
		Если РезультатЗапуска <> Неопределено Тогда
			КонтекстОперации.ВызовКомпонентыВыполняется = Ложь;
			ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, РезультатЗапуска.error);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Попытка
		Ответ = КомпонентаScreenCapture.CaptureWindow(Подготовка.МасштабПроц, Подготовка.ПоказатьСетку,
			Подготовка.РегионX, Подготовка.РегионY, Подготовка.РегионШирина, Подготовка.РегионВысота,
			Подготовка.СтрокаРектов);
	Исключение
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации,
			"Ошибка захвата: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Попытка
		Результат = РазобратьОтветScreenCapture(Ответ);
	Исключение
		ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации,
			"Ошибка разбора ответа захвата: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ЗавершитьОперациюСкриншота(КонтекстОперации, Результат);
КонецПроцедуры

&НаКлиенте
Функция ЗапуститьАсинхронныйЗахватКомпоненты(КонтекстОперации)
	// Общий запуск DLL для путей с формой и без неё; слот занимается вызывающим кодом
	Подготовка = КонтекстОперации.Подготовка;
	Попытка
		КомпонентаScreenCapture.НачатьВызовCaptureWindow(
			Новый ОписаниеОповещения("ПослеЗахватаСкриншота", ЭтаФорма, КонтекстОперации),
			Подготовка.МасштабПроц, Подготовка.ПоказатьСетку,
			Подготовка.РегионX, Подготовка.РегионY, Подготовка.РегионШирина, Подготовка.РегионВысота,
			Подготовка.СтрокаРектов);
	Исключение
		// Ошибка регистрации вызова: слот и форма освобождаются вызывающим кодом
		Возврат Новый Структура("success,error", Ложь,
			"Ошибка запуска захвата: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ЗавершитьОперациюСкриншотаОшибкой(КонтекстОперации, ТекстОшибки)
	ЗавершитьОперациюСкриншота(КонтекстОперации,
		Новый Структура("success,error", Ложь, ТекстОшибки));
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОперациюСкриншота(КонтекстОперации, Результат)
	ПринятУже = Ложь;
	Если КонтекстОперации.Свойство("РезультатПринят", ПринятУже) И ПринятУже Тогда
		Возврат; // защита от повторного завершения
	КонецЕсли;
	КонтекстОперации.Вставить("РезультатПринят", Истина);
	КонтекстОперации.Вставить("СтадияЗахвата", "Завершено");

	// Свои ожидания отключает только владелец слота: старый callback
	// не отключает таймеры нового запроса
	Если АктивныйЗахватСкриншота <> Неопределено
		И АктивныйЗахватСкриншота.ИдОперации = КонтекстОперации.ИдОперации Тогда
		Попытка
			ОтключитьОбработчикОжидания("АктивироватьФормуЗахвата");
		Исключение
		КонецПопытки;
		Попытка
			ОтключитьОбработчикОжидания("НачатьЗахватПослеАктивации");
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Восстановление страниц ранее открытой формы и закрытие собственной формы —
	// на всех путях завершения; закрывается только своя
	ОшибкаВосстановления = ВосстановитьСтраницыЗахвата(КонтекстОперации);
	ЗакрытьФормуЗахвата(КонтекстОперации);

	Если НЕ ПустаяСтрока(ОшибкаВосстановления) Тогда
		// Успешный захват с неудачным обязательным восстановлением — ошибка очистки;
		// при уже неуспешном результате сохраняем основную причину и добавляем контекст
		УспехРезультата = Ложь;
		Если Результат.Свойство("success") И Результат.success = Истина Тогда
			УспехРезультата = Истина;
		КонецЕсли;
		Если УспехРезультата Тогда
			Результат = Новый Структура("success,error", Ложь,
				"Ошибка восстановления страниц после захвата: " + ОшибкаВосстановления);
		Иначе
			ОшибкаРезультата = "";
			Результат.Свойство("error", ОшибкаРезультата);
			Результат.Вставить("error", ОшибкаРезультата
				+ "; восстановление страниц: " + ОшибкаВосстановления);
		КонецЕсли;
	КонецЕсли;

	Если АктивныйЗахватСкриншота <> Неопределено
		И АктивныйЗахватСкриншота.ИдОперации = КонтекстОперации.ИдОперации Тогда
		АктивныйЗахватСкриншота = Неопределено;
	КонецЕсли;

	Отменена = Ложь;
	Если КонтекстОперации.Свойство("Отменена", Отменена) И Отменена Тогда
		Возврат; // отменённая операция не доставляет результат
	КонецЕсли;

	Если НЕ ПоколениеКонтекстаАктуально(КонтекстОперации) Тогда
		ДобавитьВЛог("Скриншот: результат операции отброшен, подключение устарело");
		Возврат;
	КонецЕсли;

	ДоставитьРезультатКоманды(КонтекстОперации, Результат);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьАктивныйЗахватСкриншота(ФильтрРежима)
	// ФильтрРежима: "" — любая операция; "proxy" — только proxy; "server" — mcp/rest.
	// Отключение прокси не отменяет операции встроенных транспортов, и наоборот
	КонтекстОперации = АктивныйЗахватСкриншота;
	Если КонтекстОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;

