Функция ПроверитьНормализоватьПолеРегиона(Рег, ИмяПоля, МинЗначение)
	Если НЕ Рег.Свойство(ИмяПоля) Тогда
		Возврат "Field 'region." + ИмяПоля + "': required";
	КонецЕсли;
	СырЗн = Рег[ИмяПоля];
	Если СырЗн = Null ИЛИ СырЗн = Неопределено Тогда
		Возврат "Field 'region." + ИмяПоля + "': Input should be a valid integer";
	КонецЕсли;
	ЧислоЗнч = Неопределено;
	Если ТипЗнч(СырЗн) = Тип("Число") Тогда
		ЧислоЗнч = СырЗн;
	ИначеЕсли ТипЗнч(СырЗн) = Тип("Строка") Тогда
		СтрЗнч = СокрЛП(СырЗн);
		Если НЕ ПустаяСтрока(СтрЗнч) Тогда
			Попытка ЧислоЗнч = Число(СтрЗнч); Исключение ЧислоЗнч = Неопределено; КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	// Булево явно НЕ принимается (паритет с Python reject_bool; контракт = строгий integer)
	Если ЧислоЗнч = Неопределено ИЛИ ЧислоЗнч <> Цел(ЧислоЗнч) Тогда
		Возврат "Field 'region." + ИмяПоля + "': Input should be a valid integer";
	КонецЕсли;
	ЦелЗнч = Цел(ЧислоЗнч);
	Если ЦелЗнч < МинЗначение Тогда
		Возврат "Field 'region." + ИмяПоля + "': Input should be greater than or equal to " + Строка(МинЗначение);
	КонецЕсли;
	Если ЦелЗнч > 32767 Тогда
		Возврат "Field 'region." + ИмяПоля + "': Input should be less than or equal to 32767";
	КонецЕсли;
	Рег.Вставить(ИмяПоля, ЦелЗнч);
	Возврат Неопределено;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СхемаПолеРегиона(МинЗнч, Описание)
