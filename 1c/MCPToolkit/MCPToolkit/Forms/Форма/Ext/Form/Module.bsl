		Пакет.Вставить("probe_restart_used", Истина);
		Пакет.deadline = ТекущаяУниверсальнаяДата() + 30;
		ПоместитьВоВременноеХранилище(Пакет, Операция.АдресПакета);
		Ответ = НачатьПараллельноеЗадание(Среда, Новый Структура("packet_address,result_address", Операция.АдресПакета, Пакет.result_address));
