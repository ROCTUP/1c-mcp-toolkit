// ─────────────────────────────────────────────────────────────────────────────────
// СОХРАНЕНИЕ И ЗАГРУЗКА НАСТРОЕК
// ─────────────────────────────────────────────────────────────────────────────────

&НаСервере
Процедура ЗагрузитьНастройки()
	
	// Загрузка адреса сервера из хранилища настроек
	Попытка
		СохраненныйАдрес = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "АдресСервера");
		Если СохраненныйАдрес <> Неопределено И Не ПустаяСтрока(СохраненныйАдрес) Тогда
			АдресСервера = СохраненныйАдрес;
		КонецЕсли;
	Исключение
		// Настройки не найдены или ошибка загрузки
	КонецПопытки;
	
	// Загрузка идентификатора канала из хранилища настроек
	Попытка
		СохранённыйКанал = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ИдентификаторКанала");
		Если СохранённыйКанал <> Неопределено Тогда
			ИдентификаторКанала = СохранённыйКанал;
		КонецЕсли;
	Исключение
		// Настройки не найдены или ошибка загрузки
	КонецПопытки;

	// Загрузка формата ответов встроенного сервера (по умолчанию TOON = 1)
	Попытка
		СохранённыйФормат = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ФорматОтветаВстроенный");
		Если СохранённыйФормат <> Неопределено Тогда
			ФорматОтветаВстроенный = СохранённыйФормат;
		Иначе
			ФорматОтветаВстроенный = 1; // TOON по умолчанию
		КонецЕсли;
	Исключение
		ФорматОтветаВстроенный = 1; // TOON по умолчанию
	КонецПопытки;

	// Загрузка флага точной анонимизации
	ИспользоватьТочнуюАнонимизацию = Истина; // дефолт до попытки загрузки
	Попытка
		СохранённыйФлаг = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ИспользоватьТочнуюАнонимизацию");
		Если СохранённыйФлаг <> Неопределено Тогда
			ИспользоватьТочнуюАнонимизацию = СохранённыйФлаг;
		КонецЕсли;
	Исключение
		// Ошибка чтения настроек — остаётся дефолт Истина
	КонецПопытки;

	// Загрузка флага параллельного выполнения
	ПараллельноеВыполнение = Ложь; // дефолт до попытки загрузки
	Попытка
		СохраненныйПараллельный = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ПараллельноеВыполнение");
		Если СохраненныйПараллельный <> Неопределено Тогда
			ПараллельноеВыполнение = СохраненныйПараллельный;
		КонецЕсли;
	Исключение
		// Ошибка чтения настроек — остается дефолт Ложь
	КонецПопытки;

	// Загрузка порта встроенного сервера (по умолчанию 6003)
	Попытка
		СохраненныйПорт = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ПортВстроенногоСервера");
		Если ТипЗнч(СохраненныйПорт) = Тип("Число") И СохраненныйПорт > 0 Тогда
			ПортВстроенногоСервера = СохраненныйПорт;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Загрузка токена встроенного сервера (по умолчанию пусто = аутентификация выключена)
	Попытка
		СохранённыйТокен = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ТокенВстроенногоСервера");
		Если СохранённыйТокен <> Неопределено Тогда
			ТокенВстроенногоСервера = СохранённыйТокен;
		КонецЕсли;
	Исключение
		// Настройки не найдены или ошибка загрузки
	КонецПопытки;

	// Загрузка лимита записей маппинга анонимизации (по умолчанию 0 = без лимита)
	Попытка
		СохранённыйЛимитМаппинга = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ЛимитМаппингаВстроенный");
		Если ТипЗнч(СохранённыйЛимитМаппинга) = Тип("Число") И СохранённыйЛимитМаппинга >= 0 Тогда
			ЛимитМаппингаВстроенный = СохранённыйЛимитМаппинга;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Загрузка режима аутентификации при перезапуске (по умолчанию 0 = Windows)
	Попытка
		СохраненныйРежимАутентификации = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "РежимАутентификацииПерезапуска");
		Если ТипЗнч(СохраненныйРежимАутентификации) = Тип("Число") Тогда
			РежимАутентификацииПерезапуска = СохраненныйРежимАутентификации;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Загрузка пользовательского ключа шифрования для перезапуска (отображение; шифрование читает из хранилища напрямую)
	Попытка
		ЗначениеПользовательскогоКлюча = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ПользовательскийКлючШифрованияПерезапуска");
		Если ТипЗнч(ЗначениеПользовательскогоКлюча) = Тип("Строка") Тогда
			ПользовательскийКлючШифрования = Лев(СокрЛП(ЗначениеПользовательскогоКлюча), 20);
		Иначе
			НовыйПользовательскийКлюч = СгенерироватьПользовательскийКлюч();
			Попытка
				ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ПользовательскийКлючШифрованияПерезапуска", НовыйПользовательскийКлюч);
				ПользовательскийКлючШифрования = НовыйПользовательскийКлюч;
			Исключение
			КонецПопытки;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Загрузка режима подключения (по умолчанию — встроенный сервер = 1)
	Попытка
		СохранённыйРежим = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "РежимПодключения");
		Если СохранённыйРежим <> Неопределено Тогда
			РежимПодключения = СохранённыйРежим;
		Иначе
			РежимПодключения = 1;
		КонецЕсли;
	Исключение
		РежимПодключения = 1;
	КонецПопытки;

	// Загрузка настроек инструментов (по умолчанию все включены)
	ИнструментВключен_ExecuteQuery     = Истина;
	ИнструментВключен_ExecuteCode      = Истина;
	ИнструментВключен_GetMetadata      = Истина;
	ИнструментВключен_GetEventLog      = Истина;
	ИнструментВключен_GetObjectByLink  = Истина;
	ИнструментВключен_GetLinkOfObject  = Истина;
	ИнструментВключен_FindReferences   = Истина;
	ИнструментВключен_GetAccessRights  = Истина;
	ИнструментВключен_GetBslSyntaxHelp   = Истина;
	ИнструментВключен_SubmitDeanon       = Истина;
	ИнструментВключен_GetScreenshot  = Истина;
	ИнструментВключен_Restart1cSession = Истина;
	ИнструментВключен_Close1cSession  = Истина;
	Попытка
		НастройкиИнструментов = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "НастройкиИнструментов");
		Если ТипЗнч(НастройкиИнструментов) = Тип("Структура") Тогда
			Знач_ExecuteQuery     = Неопределено; НастройкиИнструментов.Свойство("ExecuteQuery",     Знач_ExecuteQuery);
			Знач_ExecuteCode      = Неопределено; НастройкиИнструментов.Свойство("ExecuteCode",      Знач_ExecuteCode);
			Знач_GetMetadata      = Неопределено; НастройкиИнструментов.Свойство("GetMetadata",      Знач_GetMetadata);
			Знач_GetEventLog      = Неопределено; НастройкиИнструментов.Свойство("GetEventLog",      Знач_GetEventLog);
			Знач_GetObjectByLink  = Неопределено; НастройкиИнструментов.Свойство("GetObjectByLink",  Знач_GetObjectByLink);
			Знач_GetLinkOfObject  = Неопределено; НастройкиИнструментов.Свойство("GetLinkOfObject",  Знач_GetLinkOfObject);
			Знач_FindReferences   = Неопределено; НастройкиИнструментов.Свойство("FindReferences",   Знач_FindReferences);
			Знач_GetAccessRights  = Неопределено; НастройкиИнструментов.Свойство("GetAccessRights",  Знач_GetAccessRights);
			Знач_GetBslSyntaxHelp      = Неопределено; НастройкиИнструментов.Свойство("GetBslSyntaxHelp",      Знач_GetBslSyntaxHelp);
			Знач_SubmitDeanon          = Неопределено; НастройкиИнструментов.Свойство("SubmitDeanon",          Знач_SubmitDeanon);
			Знач_GetScreenshot     = Неопределено; НастройкиИнструментов.Свойство("GetScreenshot",     Знач_GetScreenshot);
			Знач_Restart1cSession   = Неопределено; НастройкиИнструментов.Свойство("Restart1cSession",   Знач_Restart1cSession);
			Знач_Close1cSession     = Неопределено; НастройкиИнструментов.Свойство("Close1cSession",     Знач_Close1cSession);
			Если ТипЗнч(Знач_ExecuteQuery)     = Тип("Булево") Тогда ИнструментВключен_ExecuteQuery     = Знач_ExecuteQuery     КонецЕсли;
			Если ТипЗнч(Знач_ExecuteCode)      = Тип("Булево") Тогда ИнструментВключен_ExecuteCode      = Знач_ExecuteCode      КонецЕсли;
			Если ТипЗнч(Знач_GetMetadata)      = Тип("Булево") Тогда ИнструментВключен_GetMetadata      = Знач_GetMetadata      КонецЕсли;
			Если ТипЗнч(Знач_GetEventLog)      = Тип("Булево") Тогда ИнструментВключен_GetEventLog      = Знач_GetEventLog      КонецЕсли;
			Если ТипЗнч(Знач_GetObjectByLink)  = Тип("Булево") Тогда ИнструментВключен_GetObjectByLink  = Знач_GetObjectByLink  КонецЕсли;
			Если ТипЗнч(Знач_GetLinkOfObject)  = Тип("Булево") Тогда ИнструментВключен_GetLinkOfObject  = Знач_GetLinkOfObject  КонецЕсли;
			Если ТипЗнч(Знач_FindReferences)   = Тип("Булево") Тогда ИнструментВключен_FindReferences   = Знач_FindReferences   КонецЕсли;
			Если ТипЗнч(Знач_GetAccessRights)  = Тип("Булево") Тогда ИнструментВключен_GetAccessRights  = Знач_GetAccessRights  КонецЕсли;
			Если ТипЗнч(Знач_GetBslSyntaxHelp)     = Тип("Булево") Тогда ИнструментВключен_GetBslSyntaxHelp     = Знач_GetBslSyntaxHelp     КонецЕсли;
			Если ТипЗнч(Знач_SubmitDeanon)          = Тип("Булево") Тогда ИнструментВключен_SubmitDeanon          = Знач_SubmitDeanon          КонецЕсли;
			Если ТипЗнч(Знач_GetScreenshot)      = Тип("Булево") Тогда ИнструментВключен_GetScreenshot     = Знач_GetScreenshot     КонецЕсли;
		Если ТипЗнч(Знач_Restart1cSession)   = Тип("Булево") Тогда ИнструментВключен_Restart1cSession = Знач_Restart1cSession КонецЕсли;
		Если ТипЗнч(Знач_Close1cSession)     = Тип("Булево") Тогда ИнструментВключен_Close1cSession   = Знач_Close1cSession   КонецЕсли;
		КонецЕсли;
	Исключение
		// Ошибка чтения хранилища — остаются дефолты Истина
	КонецПопытки;

