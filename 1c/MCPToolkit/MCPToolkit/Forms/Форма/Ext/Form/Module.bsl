			Возврат;
		КонецЕсли;
 	КонецЕсли;
 	
 	// Обычное выполнение без подтверждения
	КонтекстОтвета = НовыйКонтекстВыполненияКоманды("proxy");
	КонтекстОтвета.КомандаId = Команда.id;
