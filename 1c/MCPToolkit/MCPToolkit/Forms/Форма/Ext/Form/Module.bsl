			Иначе
				ДопустимыеУровни = Новый Соответствие;
				ДопустимыеУровни.Вставить("Information", Истина);
				ДопустимыеУровни.Вставить("Warning", Истина);
				ДопустимыеУровни.Вставить("Error", Истина);
				ДопустимыеУровни.Вставить("Note", Истина);
				
