Функция ПолучитьМассивСтрокИзСвойства(СтруктураДанных, ИмяСвойства)

	Результат = Новый Массив;
	ЗначениеСвойства = Неопределено;
	Если НЕ СтруктураДанных.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ЗначениеСвойства) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементМассива Из ЗначениеСвойства Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Строка") И НЕ ПустаяСтрока(ЭлементМассива) Тогда
			Результат.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

