		КлючПоследнейСекунды = "";
		КоличествоВПоследнейСекунде = 0;

		Для Каждого СтрокаТаблицы Из ТаблицаЖурнала Цикл
			// Ключ секунды текущей строки
			КлючСекундыСтроки = Формат(СтрокаТаблицы.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");

