&НаКлиенте
Процедура ИспользоватьТочнуюАнонимизациюПриИзменении(Элемент)

	Если НЕ ИспользоватьТочнуюАнонимизацию Тогда

		// Строгий режим работает только с маскированием: сохраненный выбор строгого режима снимается.
		СохранитьВыборСтрогогоРежима(Ложь);

		Если СостояниеЗащиты.Строгий Тогда

			СтрогийРежимАнонимизации = Ложь;
			ВыключитьСтрогийРежимАтомарно();

		КонецЕсли;

	КонецЕсли;

	ИспользоватьТочнуюАнонимизациюСохранитьНаСервере(ИспользоватьТочнуюАнонимизацию);
	КэшСхемИнструментов = Неопределено;

	Если ВстроенныйСерверЗапущен Тогда
		Если ИспользоватьТочнуюАнонимизацию Тогда
			ПостроитьИЗаполнитьСловарьАнонимизации();
		Иначе
			АнонимизаторОчистить();
			ОбновитьТаблицуМаппинговВстроенный();
		КонецЕсли;
	КонецЕсли;

	ОбновитьОтображениеСостоянияЗащиты();

КонецПроцедуры

// Обработчик флажка строгого режима. Его вызывает только событие формы, которое порождает человек:
// ни HTTP, ни MCP этот обработчик не вызывают. Эпоха меняется только при действительной смене режима.
//
// Параметры:
//  Элемент - ПолеФормы - флажок строгого режима
//
&НаКлиенте
Процедура СтрогийРежимАнонимизацииПриИзменении(Элемент)

	Если СтрогийРежимАнонимизации И НЕ ИспользоватьТочнуюАнонимизацию Тогда

		СтрогийРежимАнонимизации = Ложь;
		Возврат;

	КонецЕсли;

	СохранитьВыборСтрогогоРежима(СтрогийРежимАнонимизации);

	Если СтрогийРежимАнонимизации И НЕ СостояниеЗащиты.Строгий Тогда

		ВключитьСтрогийРежимАтомарно();

	ИначеЕсли НЕ СтрогийРежимАнонимизации И СостояниеЗащиты.Строгий Тогда

		ВыключитьСтрогийРежимАтомарно();

	Иначе

		ОбновитьОтображениеСостоянияЗащиты();

	КонецЕсли;

КонецПроцедуры

// Показывает состояние защиты: текст состояния, предупреждения, команду восстановления доверия
// и доступность флажка строгого режима. Данные берет из СостояниеЗащиты, ничего не меняет.
//
// Параметры:
//  Нет
//
&НаКлиенте
Процедура ОбновитьОтображениеСостоянияЗащиты()

	Если СостояниеЗащиты.ГарантияПриостановлена Тогда
		ТекстСостояния = "Гарантия приостановлена";
	ИначеЕсли НЕ СостояниеЗащиты.Строгий Тогда
		ТекстСостояния = "Выключен";
	ИначеЕсли СостояниеЗащиты.Активен Тогда
		ТекстСостояния = "Активен";
	ИначеЕсли НЕ ПустаяСтрока(СостояниеЗащиты.ПричинаНеактивности) Тогда
		ТекстСостояния = "Не активен: " + СостояниеЗащиты.ПричинаНеактивности;
	ИначеЕсли СостояниеЗащиты.Переключение Тогда
		ТекстСостояния = "Переключается";
	Иначе
		ТекстСостояния = "Не активен - нужен перезапуск";
	КонецЕсли;

	Элементы.ДекорацияСостояниеЗащиты.Заголовок = ТекстСостояния;
	Элементы.КнопкаВосстановитьДоверие.Видимость = СостояниеЗащиты.ГарантияПриостановлена;
	Элементы.ДекорацияПредупреждениеМаскирования.Видимость = ИспользоватьТочнуюАнонимизацию
		И НЕ СостояниеЗащиты.Строгий;
	Элементы.ДекорацияПримечаниеМаскирования.Видимость = ИспользоватьТочнуюАнонимизацию;
	Элементы.ФлагСтрогийРежимАнонимизации.Доступность = ИспользоватьТочнуюАнонимизацию
		И РежимПодключения = 1;

	// В строгом режиме решение принимает только шлюз подтверждения: флажки опасных операций не действуют.
	ПримечаниеСтрогого = ?(СостояниеЗащиты.Строгий, " (в строгом режиме не действует)", "");
	Элементы.ГруппаАвтоРазрешение.Доступность = НЕ СостояниеЗащиты.Строгий;
	Элементы.ФлагРазрешатьОпасныеОперацииСПодтверждением.Доступность = НЕ СостояниеЗащиты.Строгий;
	Элементы.ФлагРазрешатьОпасныеОперацииСПодтверждением.Заголовок = "Разрешать опасные операции с подтверждением"
		+ ПримечаниеСтрогого;
	Элементы.ФлагАвтоЗаписать.Заголовок = "Записать" + ПримечаниеСтрогого;
	Элементы.ФлагАвтоПривилегированныйРежим.Заголовок = "УстановитьПривилегированныйРежим" + ПримечаниеСтрогого;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИспользоватьТочнуюАнонимизациюСохранитьНаСервере(Значение)

	Попытка
		ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ИспользоватьТочнуюАнонимизацию", Значение);
	Исключение
		// Ошибка сохранения настроек
	КонецПопытки;

КонецПроцедуры

// Читает сохраненный выбор строгого режима. Вызывается один раз при открытии формы:
// позднее значение из хранилища не перечитывается, состояние защиты живет в памяти.
//
// Параметры:
//  Нет
//
// Возвращаемое значение:
//  Булево - Истина, только если в хранилище сохранено значение Истина.
//
&НаСервереБезКонтекста
Функция ПрочитатьВыборСтрогогоРежимаНаСервере()

	Возврат ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтрогийРежимАнонимизации") = Истина;

КонецФункции

// Сохраняет выбор строгого режима. Вызывают только обработчики элементов формы, которые меняет человек: флажок
// строгого режима, а также выключение маскирования и уход из встроенного сервера (сохраняют Ложь).
// Вместе с личным выбором ставится общая метка базы: запись "MCPToolkitStrict.v1" этого пользователя (пустое имя
// пользователя хранилища), по которой запуск сервера MCP запрещен всем пользователям базы. При выключении
// удаляется только запись этого пользователя (и прежний булев ключ метки, если он остался), записи других
// пользователей не меняются. Запись метки требует прав: при ошибке личный выбор остается сохраненным.
//
// Параметры:
//  Значение - Булево - выбранное значение.
//
// Возвращаемое значение:
//  Булево - Истина, если общая метка соответствует выбору (или менять ее не требовалось); Ложь - метку записать не удалось.
//
&НаСервереБезКонтекста
Функция СохранитьВыборСтрогогоРежимаНаСервере(Значение)

	КлючПользователя = Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	БылВключен = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтрогийРежимАнонимизации") = Истина;
	ЕстьЗапись = ХранилищеОбщихНастроек.Загрузить("MCPToolkitStrict.v1", КлючПользователя, , "") = Истина;
	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "СтрогийРежимАнонимизации", Значение);

	Если НЕ Значение И НЕ БылВключен И НЕ ЕстьЗапись Тогда

		Возврат Истина;

	КонецЕсли;

	Попытка

		Если Значение Тогда

			ХранилищеОбщихНастроек.Сохранить("MCPToolkitStrict.v1", КлючПользователя, Истина, , "");

		Иначе

			ХранилищеОбщихНастроек.Удалить("MCPToolkitStrict.v1", КлючПользователя, "");
			УдалитьПрежнююМеткуСтрогогоРежима();

		КонецЕсли;

	Исключение

		Возврат Ложь;

