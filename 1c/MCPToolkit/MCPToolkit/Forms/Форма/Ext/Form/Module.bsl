		СтатусПараллельности = "Проверка возможности параллельного выполнения…";
		ПодключитьОбработчикОжидания("ПроверитьВключениеПараллельности", 1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СнимокНастроекПараллельности()
	ФлагиИнструментов = Строка(ИнструментВключен_ExecuteQuery) + Строка(ИнструментВключен_ExecuteCode)
		+ Строка(ИнструментВключен_GetMetadata) + Строка(ИнструментВключен_GetEventLog)
		+ Строка(ИнструментВключен_GetObjectByLink) + Строка(ИнструментВключен_GetLinkOfObject)
		+ Строка(ИнструментВключен_FindReferences) + Строка(ИнструментВключен_GetAccessRights);
	Возврат Новый Структура("write,privileged,confirm,anonymization,anon_confirm,mode,format,source,rules_version,tools",
		АвтоРазрешитьЗаписать, АвтоРазрешитьПривилегированныйРежим,
		РазрешатьОпасныеОперацииСПодтверждением, ИспользоватьТочнуюАнонимизацию,
		ПодтверждениеАнонимизации, РежимПодключения, ФорматОтветаВстроенный, ИсточникПравилТочнойАнонимизации,
		ВерсияНастроекАнонимизацииПараллельности, ФлагиИнструментов);
КонецФункции

&НаКлиенте
Функция НастройкиПараллельнойОперацииАктуальны(Операция)
	ТекущиеНастройки = СнимокНастроекПараллельности();
	Для Каждого ПолеНастройки Из Операция.Настройки Цикл
		Если ПолеНастройки.Значение <> ТекущиеНастройки[ПолеНастройки.Ключ] Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура УведомитьПроксиОбОтмененныхОперациях()
	Если ПланировщикФормы = Неопределено Тогда Возврат; КонецЕсли;
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		УведомитьПроксиОбОтменеОперации(ПараОперации.Значение);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УведомитьПроксиОбОтменеОперации(Операция)
	Если Операция = Неопределено Тогда Возврат; КонецЕсли;
	Если Операция.ОтветВыдан Или Операция.Маршрут.Режим <> "proxy" Тогда Возврат; КонецЕсли;
	Если ПоколениеКонтекстаАктуально(Операция.Маршрут) Тогда Возврат; КонецЕсли;
	Если Операция.Свойство("ПопыткаУведомленияОбОтменеПрокси") Тогда Возврат; КонецЕсли;
	// Единственная попытка: даже при недоступном прокси не задерживаем каждый проход планировщика.
	Операция.Вставить("ПопыткаУведомленияОбОтменеПрокси", Истина);
	Причина = "Подключение к 1С закрыто, команда отменена";
	ПрерватьОперациюПланировщика(Операция, Причина);
	Попытка
		// Только ошибка и только сохранённый маршрут. Данные старого задания не отправляем.
		Маршрут = Операция.Маршрут;
		Отправка = ОтправитьРезультатНаСервер(Маршрут.АдресПрокси, Маршрут.КомандаId,
			Новый Структура("success,error", Ложь, Причина), Маршрут.КаналПрокси, 1, Маршрут);
		Если НЕ Отправка.Успех Тогда
			ДобавитьВЛог("Не удалось сообщить прокси об отмене команды: " + Отправка.ОписаниеОшибки);
		КонецЕсли;
	Исключение
		ДобавитьВЛог("Не удалось сообщить прокси об отмене команды: " + ОписаниеОшибки());
	КонецПопытки;
	// Слот и ресурсы задания остаются занятыми до подтверждённой остановки.
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьАктуальностьПараллельныхОпераций()
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		Операция = ПараОперации.Значение;
		Если Операция.Маршрут.Режим = "probe" Тогда Продолжить; КонецЕсли;
		Если НЕ ПоколениеКонтекстаАктуально(Операция.Маршрут) Тогда
			УведомитьПроксиОбОтменеОперации(Операция);
			ПрерватьОперациюПланировщика(Операция, "Connection generation changed; operation cancelled");
		ИначеЕсли НЕ НастройкиПараллельнойОперацииАктуальны(Операция) Тогда
			ПрерватьОперациюПланировщика(Операция, "Execution settings changed; operation cancelled");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПринятьПараллельнуюКоманду(Команда, КонтекстОтвета)
	ПеренестиИсточникОтвета(КонтекстОтвета, Команда);
	Если СправкаЗакрывается Тогда
		Возврат Новый Структура("success,error", Ложь, "Processing form is closing; command not started");
	КонецЕсли;
	Если ПланировщикФормы = Неопределено Или КонтекстОтвета = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Если ПланировщикФормы.Режим = "disabled" Или НЕ ЭтоСервернаяКомандаПланировщика(Команда) Тогда Возврат Неопределено; КонецЕсли;
	Сейчас = ТекущиеМиллисекундыКлиента();
	Срок = 0;
	Если КонтекстОтвета.Режим = "proxy" Тогда
		Команда.Свойство("_mcp_deadline_ms", Срок);
		КонтекстОтвета.Вставить("КаналПрокси", СокрЛП(ИдентификаторКанала));
	Иначе
		КонтекстОтвета.ДанныеЗапроса.Свойство("_mcp_deadline_ms", Срок);
	КонецЕсли;
	Если Срок = Неопределено Или Срок <= Сейчас Тогда
		Возврат Новый Структура("success,error", Ложь, "Request deadline is unavailable or expired; update the transport");
	КонецЕсли;
	Принятие = ПринятьКомандуПланировщика(ПланировщикФормы, КонтекстОтвета.ИдОперации,
		Команда, КонтекстОтвета, СнимокНастроекПараллельности(), Срок, Сейчас);
	Если НЕ Принятие.accepted Тогда
		Возврат Новый Структура("success,error", Ложь, "Parallel command not accepted: " + Принятие.reason);
	КонецЕсли;
	Операция = ПланировщикФормы.Операции.Получить(КонтекстОтвета.ИдОперации);
	Попытка
		Операция.Вставить("Подготовка", ПодготовитьСервернуюКоманду(Операция.Команда));
	Исключение
		ПрерватьОперациюПланировщика(Операция, ОписаниеОшибки());
	КонецПопытки;
	Операция.Маршрут.Вставить("ИдПараллельнойОперации", Операция.Ид);
	Операция.Маршрут.Вставить("ПоколениеПланировщика", Операция.Поколение);
	Операция.Маршрут.Вставить("Эпоха", ЭпохаЗащиты);

	Если КонтекстОтвета.Свойство("Строгий") Тогда

		Операция.Маршрут.Вставить("Строгий", КонтекстОтвета.Строгий);

	КонецЕсли;

	КонтекстОтвета.Отложено = Истина;
	ЗапланироватьПроходПараллельности();
	Возврат Новый Структура("success", Истина);
КонецФункции

&НаКлиенте
Процедура ЗавершитьПробуПараллельности(Операция)
	Если СправкаЗакрывается И Операция.ЗавершениеЗапрошено Тогда
		// Отмена при закрытии — штатное завершение проверки, а не отказ параллельности.
		ЗавершитьВыдачуПланировщика(ПланировщикФормы, Операция.Ид, Операция.Поколение);
		ПараллельныйОтветВОбработке = "";
		Возврат;
	КонецЕсли;
	Если ПроверитьКонвертПараллельногоРезультата(Операция, Операция.Результат)
		И Операция.Результат.background И НЕ Операция.ЗавершениеЗапрошено Тогда
		Если ПланировщикФормы.Режим = "checking" Тогда
			СредаПараллельности.ready = Истина;
			ПроверитьТранспортПараллельности();
		КонецЕсли;
	Иначе
		Причина = "Пробное задание не подтвердило выполнение в фоне";
		Если ТипЗнч(Операция.Результат) = Тип("Структура") И Операция.Результат.Свойство("error") Тогда Причина = Операция.Результат.error; КонецЕсли;
		ОтклонитьВключениеПараллельности(Причина);
	КонецЕсли;
	ЗавершитьВыдачуПланировщика(ПланировщикФормы, Операция.Ид, Операция.Поколение);
	ПараллельныйОтветВОбработке = "";
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыдачуПараллельногоРезультата(Операция)
	ПараллельныйОтветВОбработке = Операция.Ид;
	Если Операция.ИсполнительВладельца = "owner_help" Тогда

		Если Операция.Маршрут.Свойство("Строгий") Тогда

			ДоставитьГотовыйРезультатСтрогий(Операция, Операция.Результат);

		Иначе

			ДоставитьРезультатКоманды(Операция.Маршрут, Операция.Результат);

		КонецЕсли;

		Возврат;

	КонецЕсли;
	Если Операция.Маршрут.Режим = "probe" Тогда
		ЗавершитьПробуПараллельности(Операция);
		Возврат;
	КонецЕсли;
	КонтекстОтвета = Операция.Маршрут;
	Если НЕ ПоколениеКонтекстаАктуально(КонтекстОтвета) Тогда
		ЗавершитьПараллельнуюДоставку(КонтекстОтвета);
		Возврат;
	КонецЕсли;

	Если КонтекстОтвета.Свойство("Строгий") Тогда

		СверитьИлиОтложитьСостояниеОперации(Операция);

	КонецЕсли;

	Если ОперацияПрошлойЭпохи(Операция) Тогда

		ДобавитьВЛог("Результат операции прошлой эпохи защиты отброшен");

		Если НЕ КонтекстОтвета.Свойство("ЭпохаОтвечена") Тогда

			ОтправитьОшибкуЭпохи(ДоставкаИзМаршрутаОперации(КонтекстОтвета));

		КонецЕсли;

		ЗавершитьПараллельнуюДоставку(КонтекстОтвета);

		Возврат;

	КонецЕсли;
	Попытка
		Результат = Операция.Результат;
		Если ПроверитьКонвертПараллельногоРезультата(Операция, Результат) Тогда
			Конверт = Результат;
			Результат = Конверт.body;
			Если Конверт.cache <> Неопределено И НЕ Операция.ЗавершениеЗапрошено Тогда
				Если Конверт.cache.extension <> Операция.Подготовка.ИмяРасширения
					Или Конверт.cache.key <> Операция.Подготовка.КлючДеталей Тогда ВызватьИсключение "Invalid worker cache route"; КонецЕсли;
				ОжидаемыйКэш = Новый Структура("id,instance,generation,extension,key,hash", Операция.Ид, Операция.Экземпляр,
					Операция.Поколение, Конверт.cache.extension, Конверт.cache.key, Конверт.cache.hash);
				ТокеныКэша = СохранитьКэшИзЗадания(Операция.АдресРезультата, УникальныйИдентификатор, ОжидаемыйКэш);
				Если ТокеныКэша <> Неопределено Тогда
					Для Каждого ТокенКэша Из ТокеныКэша Цикл Результат.Вставить(ТокенКэша.Ключ, ТокенКэша.Значение); КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Результат) <> Тип("Структура") Тогда
			ВызватьИсключение "Invalid background result";
		ИначеЕсли Результат.Свойство("protocol") Тогда
			ВызватьИсключение "Background result identity mismatch";
		ИначеЕсли Результат.Свойство("success") И Результат.success И НЕ Операция.Свойство("ПрямойРезультат") Тогда
			ВызватьИсключение "Background result envelope is missing";
		КонецЕсли;
		Если Операция.ЗавершениеЗапрошено Тогда
			Результат = Новый Структура("success,error", Ложь, Операция.ПричинаЗавершения);
		Иначе
			Результат = ЗавершитьСервернуюКоманду(Операция.Подготовка, Результат);
		КонецЕсли;

		Если КонтекстОтвета.Свойство("Строгий") Тогда

			ДоставитьГотовыйРезультатСтрогий(Операция, Результат);

			Возврат;

		КонецЕсли;

		КонтекстОтвета.Вставить("Результат", Результат);
		НачатьАнонимизациюПараллельногоОтвета(Операция, КонтекстОтвета);
	Исключение

		Если КонтекстОтвета.Свойство("Строгий") Тогда

			ДобавитьВЛог("Строгий режим: сбой завершения результата операции: "
				+ ДиагностикаИсключенияДляЖурнала(ИнформацияОбОшибке(), "job_result"));
			ДоставитьГотовыйРезультатСтрогий(Операция, Новый Структура("success,error", Ложь, "Result finalization failed"));

		Иначе

			КонтекстОтвета.Вставить("Результат", Новый Структура("success,error", Ложь,
				"Result finalization failed: " + ОписаниеОшибки()));
			ДоставитьРезультатКоманды(КонтекстОтвета, КонтекстОтвета.Результат);

		КонецЕсли;

	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НачатьАнонимизациюПараллельногоОтвета(Операция, КонтекстОтвета)
	Результат = КонтекстОтвета.Результат;
	ИмяИнструмента = Операция.Команда.tool;
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		ТекстЗапроса = ПолучитьТекстЗапросаLineageИзКоманды(Операция.Команда);
		Если НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапроса, Результат) Тогда
			КонтекстОтвета.Вставить("ТекстЗапроса", ТекстЗапроса);
			НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстОтвета);
			Возврат;
		КонецЕсли;
		Если ИспользоватьТочнуюАнонимизацию И ТипЗнч(Результат) = Тип("Структура")
			И Результат.Свойство("data") И РежимПодключения <> 0
			И (ИмяИнструмента = "execute_code" Или ИмяИнструмента = "execute_query"
				Или ИмяИнструмента = "get_object_by_link" Или ИмяИнструмента = "find_references_to_object"
				Или ИмяИнструмента = "get_event_log" Или ИмяИнструмента = "get_access_rights") Тогда
			// Метаданные и навигационные ссылки не проходят анонимизацию и не требуют её подтверждения.
			Результат.Вставить("_original_data_json", ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
			РегексКонтекст = Новый Структура("Результат,ВключённыеПравилаJSON,ТекстыJSON,МаппингИндексов,ЕстьТекстыДляRegex,КонтекстLineage",
				Результат, "", "", Неопределено, Ложь, КонтекстОтвета);
			Если ИмяИнструмента = "execute_code" Тогда
				РегексКонтекст.Вставить("ЭтоExecuteCode", Истина);
				РегексКонтекст.Вставить("МаппингПутей", Неопределено);
				АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
			ИначеЕсли ИмяИнструмента = "get_object_by_link" Тогда
				Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
				РегексКонтекст.Вставить("ЭтоОбъект", Истина);
				АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
			ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда
				РегексКонтекст.Вставить("ЭтоFindReferences", Истина);
				АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
			ИначеЕсли ИмяИнструмента = "get_event_log" Тогда
				РегексКонтекст.Вставить("ЭтоGetEventLog", Истина);
				АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст);
			ИначеЕсли ИмяИнструмента = "get_access_rights" Тогда
				АнонимизироватьРезультатGetAccessRights(Результат);
				ОбновитьТаблицуМаппинговВстроенный();
			ИначеЕсли ИмяИнструмента = "execute_query" Тогда
				// Даже без схемы выполняем штатную policy/Regex-цепочку запроса.
				ПродолжитьПослеLineage(КонтекстОтвета);
				Возврат;
			КонецЕсли;
			РегексКонтекст.Результат = Результат;
			КонтекстОтвета.Результат = Результат;
			Если ИмяИнструмента = "execute_code" Или ИмяИнструмента = "get_object_by_link"
				Или ИмяИнструмента = "find_references_to_object" Или ИмяИнструмента = "get_event_log" Тогда
				ЗапуститьRegexФазу(РегексКонтекст);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗавершитьАнонимизациюПараллельногоОтвета(КонтекстОтвета);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьАнонимизациюПараллельногоОтвета(КонтекстОтвета)
	Если НЕ ПодготовитьВыдачуПараллельногоОтвета(КонтекстОтвета, КонтекстОтвета.Результат) Тогда Возврат; КонецЕсли;
	Если КонтекстОтвета.Режим <> "proxy" Тогда
		Если ПроверитьПодтверждениеАнонимизации(КонтекстОтвета.Результат, КонтекстОтвета.ДанныеЗапроса,
			КонтекстОтвета.Ид, КонтекстОтвета.ИдПотока, КонтекстОтвета.Режим, КонтекстОтвета) Тогда Возврат; КонецЕсли;
	КонецЕсли;
	ДоставитьРезультатКоманды(КонтекстОтвета, КонтекстОтвета.Результат);
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьВыдачуПараллельногоОтвета(КонтекстОтвета, Результат)
	Если НЕ КонтекстОтвета.Свойство("ИдПараллельнойОперации") Тогда Возврат Истина; КонецЕсли;
	Операция = ПланировщикФормы.Операции.Получить(КонтекстОтвета.ИдПараллельнойОперации);
	Если Операция = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Если Операция.ОтветВыдан Или Операция.Поколение <> КонтекстОтвета.ПоколениеПланировщика Тогда Возврат Ложь; КонецЕсли;
	Если НЕ ПоколениеКонтекстаАктуально(КонтекстОтвета) Тогда
		ЗавершитьПараллельнуюДоставку(КонтекстОтвета);
		Возврат Ложь;
	КонецЕсли;
	Если НЕ НастройкиПараллельнойОперацииАктуальны(Операция) Тогда
		ПрерватьОперациюПланировщика(Операция, "Execution settings changed; result discarded");
	КонецЕсли;
	Если ТекущиеМиллисекундыКлиента() >= Операция.Срок Тогда ПрерватьОперациюПланировщика(Операция, "Operation expired"); КонецЕсли;
	Если Операция.ЗавершениеЗапрошено Тогда Результат = Новый Структура("success,error", Ложь, Операция.ПричинаЗавершения); КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ЗавершитьПараллельнуюДоставку(КонтекстОтвета)
	Если НЕ КонтекстОтвета.Свойство("ИдПараллельнойОперации") Тогда Возврат; КонецЕсли;
	Операция = ПланировщикФормы.Операции.Получить(КонтекстОтвета.ИдПараллельнойОперации);
	Если Операция <> Неопределено И Операция.Поколение = КонтекстОтвета.ПоколениеПланировщика Тогда
		УведомитьПроксиОбОтменеОперации(Операция);
	КонецЕсли;
	Если ЗавершитьВыдачуПланировщика(ПланировщикФормы, КонтекстОтвета.ИдПараллельнойОперации, КонтекстОтвета.ПоколениеПланировщика) Тогда
		Если ПараллельныйОтветВОбработке = КонтекстОтвета.ИдПараллельнойОперации Тогда ПараллельныйОтветВОбработке = ""; КонецЕсли;
		ЗапланироватьПроходПараллельности();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьПодтверждениеПараллельногоОтвета(КонтекстПодтверждения, ФормаПодтверждения)
	Операция = ПланировщикФормы.Операции.Получить(КонтекстПодтверждения.КонтекстДоставки.ИдПараллельнойОперации);
	Операция.Вставить("ФормаПодтверждения", ФормаПодтверждения);
	Операция.Вставить("КонтекстПодтверждения", КонтекстПодтверждения);
	Операция.Результат = КонтекстПодтверждения.Результат;
	Операция.Состояние = "confirmation_wait";
	Если ПараллельныйОтветВОбработке = Операция.Ид Тогда ПараллельныйОтветВОбработке = ""; КонецЕсли;
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПодтверждениеПараллельногоОтвета(РезультатФормы, КонтекстПодтверждения)
	КонтекстОтвета = КонтекстПодтверждения.КонтекстДоставки;
	Операция = ПланировщикФормы.Операции.Получить(КонтекстОтвета.ИдПараллельнойОперации);
	Если Операция = Неопределено Тогда Возврат; КонецЕсли;
	Если Операция.Состояние <> "confirmation_wait" Или Операция.ОтветВыдан Тогда Возврат; КонецЕсли;
	Результат = КонтекстПодтверждения.Результат;
	Операция.Удалить("ФормаПодтверждения");
	Операция.Удалить("КонтекстПодтверждения");
	КонтекстПодтверждения.Результат = Неопределено;
	Если НЕ ПодготовитьВыдачуПараллельногоОтвета(КонтекстОтвета, Результат) Тогда
		КонтекстОтвета.Удалить("Результат");
		Возврат;
	КонецЕсли;
	Если РезультатФормы <> Истина Тогда Результат = Новый Структура("success,error", Ложь, "Пользователь отклонил передачу данных агенту."); КонецЕсли;
	Операция.Результат = Результат;
	КонтекстОтвета.Удалить("Результат");
	// TOON и отправка начнутся только после освобождения общей цепочки компонент.
	Операция.Состояние = "delivery_ready";
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОтмененныеПодтвержденияПараллельности()
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		Операция = ПараОперации.Значение;
		// Отмена переводит approval в result_ready: проверяем признак, а не прежнее состояние.
		Если Операция.ЗавершениеЗапрошено Тогда
			ОчиститьРазрешениеОпаснойКоманды(Операция, Истина);
		КонецЕсли;
		Если Операция.Состояние <> "confirmation_wait" Или НЕ Операция.ЗавершениеЗапрошено Тогда Продолжить; КонецЕсли;
		// До Закрыть: его callback уже не должен принимать старое подтверждение.
		Операция.Состояние = "delivery_ready";
		Операция.Результат = Новый Структура("success,error", Ложь, Операция.ПричинаЗавершения);
		Операция.Маршрут.Удалить("Результат");
		Если Операция.Свойство("КонтекстПодтверждения") Тогда
			Операция.КонтекстПодтверждения.Результат = Неопределено;
			Операция.Удалить("КонтекстПодтверждения");
		КонецЕсли;
		Если Операция.Свойство("ФормаПодтверждения") Тогда
			ФормаПодтверждения = Операция.ФормаПодтверждения;
			Операция.Удалить("ФормаПодтверждения");
			Попытка ФормаПодтверждения.Закрыть(Ложь); Исключение ДобавитьВЛог("Закрытие просроченного подтверждения: " + ОписаниеОшибки()); КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыдачуПодтвержденногоПараллельногоОтвета()
	Если ПараллельныйОтветВОбработке <> "" Тогда Возврат; КонецЕсли;
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		Операция = ПараОперации.Значение;
		Если Операция.Состояние <> "delivery_ready" Или Операция.ОтветВыдан Тогда Продолжить; КонецЕсли;
		Операция.Состояние = "finishing";
		ПараллельныйОтветВОбработке = Операция.Ид;
		ДоставитьРезультатКоманды(Операция.Маршрут, Операция.Результат);
		Возврат;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПараллельноеВыполнениеПриИзменении(Элемент)
	Если ФайловаяБазаДляПараллельности Тогда
		ПараллельноеВыполнение = Ложь;
		Возврат;
	КонецЕсли;
	Попытка
		Сохранено = СохранитьПараллельноеВыполнениеНаСервере(ПараллельноеВыполнение);
	Исключение
		Сохранено = Ложь;
	КонецПопытки;
	Если Сохранено <> Истина Тогда
		ДобавитьВЛог("Настройка параллельного выполнения не сохранена. При следующем открытии может действовать прежнее значение.");
	КонецЕсли;
	Если ПараллельноеВыполнение Тогда
		Если ПланировщикФормы.Режим = "draining" Тогда
			ПланировщикФормы.ПовторноеВключение = Истина;
			Возврат;
		КонецЕсли;
		Если ПланировщикФормы.Режим <> "disabled" Тогда Возврат; КонецЕсли;
		ПричинаНедоступностиПараллельности = "";
		ПланировщикФормы.Поколение = ПланировщикФормы.Поколение + 1;
		ПланировщикФормы.Режим = "checking";
		СтатусПараллельности = "Проверка возможности параллельного выполнения…";
		ПодключитьОбработчикОжидания("ПроверитьВключениеПараллельности", 1, Истина);
	Иначе
		ПланировщикФормы.ПовторноеВключение = Ложь;
		Если ПланировщикФормы.Режим = "disabled" Тогда Возврат; КонецЕсли;
		ПланировщикФормы.Режим = "draining";
		СтатусПараллельности = "Завершение активных команд…";
		ЗапланироватьПроходПараллельности();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьПроходПараллельности()
	Если ПланировщикФормы = Неопределено Тогда Возврат; КонецЕсли;
	Если ПроходПараллельностиЗапланирован = Истина Тогда Возврат; КонецЕсли;
	Если ПланировщикФормы.Операции.Количество() = 0 И ПланировщикФормы.Режим <> "draining" Тогда Возврат; КонецЕсли;
	ПодключитьОбработчикОжидания("ОбработатьПараллельныеЗадания", 0.3, Истина);
	ПроходПараллельностиЗапланирован = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВключениеПараллельности()
	Если СправкаЗакрывается Или ПланировщикФормы.Режим <> "checking" Тогда Возврат; КонецЕсли;
	ПроверкаПараллельностиВыполняется = Истина;
	// Контроль подключаем до серверных вызовов: выполнение может прерваться
	// платформой без возврата в Исключение и без выполнения кода после вызова.
	ПодключитьОбработчикОжидания("ОбнаружитьПрерываниеПроверкиПараллельности", 1, Истина);
	Попытка
		Если ФайловаяБазаДляПараллельности Тогда ВызватьИсключение "Недоступно в файловой базе"; КонецЕсли;
		// Проверка БСП выполняется только при включении, до чтения и передачи EPF.
		КонтекстРегистрации = КонтекстРегистрацииПараллельности();
		Возможности = ВозможностиПараллельногоВыполнения(УникальныйИдентификатор, КонтекстРегистрации);
		Если НЕ Возможности.available Тогда ВызватьИсключение Возможности.reason; КонецЕсли;
		#Если ВебКлиент Тогда
			ВызватьИсключение "Загрузка открытой EPF для заданий в веб-клиенте не поддерживается";
		#Иначе
			ДвоичныеОбработки = Неопределено;
			Если Возможности.adapter <> "bsp21_registered" Тогда ДвоичныеОбработки = ПолучитьEPFДляПараллельности(); КонецЕсли;
			СредаПараллельности = ПодготовитьСредуПараллельногоВыполнения(ДвоичныеОбработки,
				УникальныйИдентификатор, ПланировщикФормы.Экземпляр, ПланировщикФормы.Поколение, СборкаПараллельногоЯдра(), КонтекстРегистрации);
		#КонецЕсли
		Если НЕ СправкаЗакрывается Тогда
			ИдПробы = Строка(Новый УникальныйИдентификатор);
			Принятие = ПринятьКомандуПланировщика(ПланировщикФормы, ИдПробы,
				Новый Структура("tool,params", "execute_query", Новый Структура),
				Новый Структура("Режим", "probe"), Новый Структура, ТекущиеМиллисекундыКлиента() + 30000, ТекущиеМиллисекундыКлиента());
			Если НЕ Принятие.accepted Тогда ВызватьИсключение "Не удалось зарегистрировать пробное задание"; КонецЕсли;
			Проба = ПланировщикФормы.Операции.Получить(ИдПробы);
			Проба.Вставить("ЭтоПроба", Истина);
			Проба.Вставить("Подготовка", Новый Структура("Команда,КлючДеталей", Проба.Команда, ""));
			Проба.Состояние = "starting";
			Проба.СостояниеСтарта = "start_unknown";
			Проба.ЗанимаетСлот = Истина;
			ЗапланироватьПроходПараллельности();
			ЗапуститьОперациюВЗадании(Проба);
		КонецЕсли;
	Исключение
		Если НЕ СправкаЗакрывается Тогда ОтклонитьВключениеПараллельности(ОписаниеОшибки()); КонецЕсли;
	КонецПопытки;
	ПроверкаПараллельностиВыполняется = Ложь;
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ОбнаружитьПрерываниеПроверкиПараллельности()
	Если ПроверкаПараллельностиВыполняется <> Истина Тогда Возврат; КонецЕсли;
	Если НЕ СправкаЗакрывается И ПланировщикФормы.Режим = "checking" Тогда
		Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
			Проба = ПараОперации.Значение;
			ЭтоПроба = Ложь;
			Если НЕ Проба.Свойство("ЭтоПроба", ЭтоПроба) Или НЕ ЭтоПроба Тогда Продолжить; КонецЕсли;
			Если Проба.ЗавершениеЗапрошено Или Проба.ОтветВыдан Тогда Продолжить; КонецЕсли;
			ПовторИспользован = Ложь;
			Если Проба.Свойство("ПовторПослеПрерывания", ПовторИспользован) И ПовторИспользован Тогда Прервать; КонецЕсли;
			ОжидаетсяПовтор = Ложь;
			Если Проба.Свойство("ОжидаетсяПовторПослеПрерывания", ОжидаетсяПовтор) И ОжидаетсяПовтор Тогда Возврат; КонецЕсли;
			Проба.Вставить("ОжидаетсяПовторПослеПрерывания", Истина);
			СтатусПараллельности = "Проверка прервана. Повторная попытка через 30 секунд…";
			ДобавитьВЛог("Проверка параллельности прервана. Повторная попытка через 30 секунд.");
			ПодключитьОбработчикОжидания("ЗавершитьПрерваннуюПроверкуПараллельности", 30, Истина);
			// До повтора сохраняем признак проверки: опрос не должен списать пробу по таймауту.
			Возврат;
		КонецЦикла;
	КонецЕсли;
	ЗавершитьПрерваннуюПроверкуПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПрерваннуюПроверкуПараллельности()
	// Восстанавливаем запуск после паузы, назначенной при обнаружении прерывания.
	Если ПроверкаПараллельностиВыполняется <> Истина Тогда Возврат; КонецЕсли;
	ПроверкаПараллельностиВыполняется = Ложь;
	Если ПланировщикФормы.Операции.Количество() = 0 Тогда
		Если НЕ СправкаЗакрывается Тогда
			ОтклонитьВключениеПараллельности("Подготовка проверки прервана до запуска пробного задания");
		КонецЕсли;
	Иначе
		Если НЕ СправкаЗакрывается Тогда
			СтатусПараллельности = "Проверка результата запуска пробного задания…";
			ДобавитьВЛог("Проверка параллельности: проверяется состояние предыдущего пробного задания.");
			Если ПланировщикФормы.Режим = "checking" Тогда
				Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
					Проба = ПараОперации.Значение;
					ЭтоПроба = Ложь;
					Если НЕ Проба.Свойство("ЭтоПроба", ЭтоПроба) Или НЕ ЭтоПроба Тогда Продолжить; КонецЕсли;
					Если Проба.ЗавершениеЗапрошено Или Проба.ОтветВыдан Тогда Продолжить; КонецЕсли;
					ПовторИспользован = Ложь;
					Если Проба.Свойство("ПовторПослеПрерывания", ПовторИспользован) И ПовторИспользован Тогда
						ОтклонитьВключениеПараллельности("Повторный запуск проверки прерван. Включите параллельное выполнение заново после подтверждения предупреждений.");
						Прервать;
					КонецЕсли;
					Проба.Вставить("ПовторПослеПрерывания", Истина);
					// Время, потраченное на предупреждение, не расходует срок восстановленной проверки.
					Проба.Срок = ТекущиеМиллисекундыКлиента() + 30000;
					ПроверкаПараллельностиВыполняется = Истина;
					ПодключитьОбработчикОжидания("ОбнаружитьПрерываниеПроверкиПараллельности", 1, Истина);
					Попытка
						СтартПробы = ВосстановитьПрерванныйЗапускПробы(СредаПараллельности, ДескрипторПараллельнойОперации(Проба));
						Если ЗначениеЗаполнено(СтартПробы.bsp_result_address) Тогда Проба.Вставить("АдресРезультатаБСП", СтартПробы.bsp_result_address); КонецЕсли;
						ПрименитьСтартПланировщика(ПланировщикФормы, Проба.Ид, Проба.Поколение, СтартПробы);
						Если СтартПробы.restarted Тогда
							ДобавитьВЛог("Проверка параллельности: пробное задание не найдено; выполнен повтор запуска после прерывания.");
						КонецЕсли;
						Если СтартПробы.error <> "" Тогда ОтклонитьВключениеПараллельности(СтартПробы.error); КонецЕсли;
					Исключение
						ОтклонитьВключениеПараллельности("Не удалось восстановить проверку: " + ОписаниеОшибки());
					КонецПопытки;
					ПроверкаПараллельностиВыполняется = Ложь;
					Прервать;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьВключениеПараллельности(Причина)
	Если СправкаЗакрывается Тогда Возврат; КонецЕсли;
	ПараллельноеВыполнение = Ложь;
	ПланировщикФормы.Режим = "draining";
	ПричинаНедоступностиПараллельности = Причина;
	СтатусПараллельности = "Недоступно: " + Причина;
	ДобавитьВЛог("Параллельное выполнение: " + Причина);
КонецПроцедуры

&НаКлиенте
Функция ДескрипторПараллельнойОперации(Операция)
	ЭтоПроба = Ложь;
	Операция.Свойство("ЭтоПроба", ЭтоПроба);
	АдресБСП = "";
	Операция.Свойство("АдресРезультатаБСП", АдресБСП);
	АдресПакета = "";
	Операция.Свойство("АдресПакета", АдресПакета);
	Возврат Новый Структура("Ид,Поколение,ИдЗадания,КлючЗапуска,АдресРезультата,АдресРезультатаБСП,АдресПакета,ЗанимаетСлот,СостояниеСтарта,ЭтоПроба,Экземпляр",
		Операция.Ид, Операция.Поколение, Операция.ИдЗадания, Операция.КлючЗапуска,
		Операция.АдресРезультата, АдресБСП, АдресПакета, Операция.ЗанимаетСлот, Операция.СостояниеСтарта, ЭтоПроба, Операция.Экземпляр);
КонецФункции

&НаКлиенте
Процедура ЗапуститьОперациюВЗадании(Операция)
	ЭтоПроба = Ложь;
	Если Операция.Свойство("ЭтоПроба") Тогда ЭтоПроба = Операция.ЭтоПроба; КонецЕсли;

	Если ОперацияПрошлойЭпохи(Операция) Тогда

		ПрерватьОперациюПланировщика(Операция, "Protection epoch changed; command not started");
		ПрименитьСтартПланировщика(ПланировщикФормы, Операция.Ид, Операция.Поколение,
			Новый Структура("state,job_id,result_address,error,result", "not_started", Неопределено,
			Операция.АдресРезультата, "Protection epoch changed; command not started", Неопределено));

		Возврат;

	КонецЕсли;

	Попытка
		ПакетКоманды = ПодготовитьПакетФоновойКоманды(СредаПараллельности, Операция.Ид, Операция.КлючЗапуска,
			Операция.Подготовка.Команда, Операция.Подготовка.КлючДеталей,
			(Операция.Срок - ТекущиеМиллисекундыКлиента()) / 1000, ЭтоПроба);
		Операция.АдресРезультата = ПакетКоманды.result_address;
		Операция.Вставить("АдресПакета", ПакетКоманды.packet_address);
	Исключение
		ПрименитьСтартПланировщика(ПланировщикФормы, Операция.Ид, Операция.Поколение,
			Новый Структура("state,job_id,result_address,error,result", "not_started", Неопределено,
				Операция.АдресРезультата, ОписаниеОшибки(), Неопределено));
		Возврат;
	КонецПопытки;
	// Адрес результата и ключ записаны до RPC: потеря ответа не допускает повторного старта.
	Попытка
		СтартЗадания = НачатьПараллельноеЗадание(СредаПараллельности, ПакетКоманды);
		Операция.Вставить("АдресРезультатаБСП", СтартЗадания.bsp_result_address);
		ПрименитьСтартПланировщика(ПланировщикФормы, Операция.Ид, Операция.Поколение, СтартЗадания);
	Исключение
		ДобавитьВЛог("Исход запуска задания неизвестен; повторного запуска не будет: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКонвертПараллельногоРезультата(Операция, Конверт)
	Если ТипЗнч(Конверт) <> Тип("Структура") Тогда Возврат Ложь; КонецЕсли;
	Попытка
		Возврат Конверт.protocol = ВерсияПараллельногоПротокола() И Конверт.build = СредаПараллельности.build
			И Конверт.instance = Операция.Экземпляр И Конверт.generation = Операция.Поколение
			И Конверт.id = Операция.Ид И Конверт.user = СредаПараллельности.user
			И Конверт.privileged = СредаПараллельности.privileged
			И (НЕ СредаПараллельности.safe_mode Или Конверт.safe_mode);
	Исключение Возврат Ложь; КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ОбработатьПараллельныеЗадания()
	ПроходПараллельностиЗапланирован = Ложь;
	// Сначала обработчик восстановления разбирает прерванный синхронный запуск.
	// Иначе таймер опроса может списать пробу по таймауту раньше него.
	Если ПроверкаПараллельностиВыполняется = Истина Тогда
		ЗапланироватьПроходПараллельности();
		Возврат;
	КонецЕсли;
	Если ПроходПланировщикаВыполняется Тогда Возврат; КонецЕсли;
	ПроходПланировщикаВыполняется = Истина;
	Попытка
		ОбновитьАктуальностьПараллельныхОпераций();
		ОбработатьИсполнительСправкиФормы();
		ПрежнийРежим = ПланировщикФормы.Режим;
		ТранспортПроверен = ОбновитьСостоянияТранспортаПередПроходом();
		Если НЕ ТранспортПроверен Тогда ПланировщикФормы.Режим = "checking"; КонецЕсли;
		Действия = ПодготовитьПроходПланировщика(ПланировщикФормы, ТекущиеМиллисекундыКлиента());
		ПланировщикФормы.Режим = ПрежнийРежим;
		ЗавершитьОтмененныеПодтвержденияПараллельности();
		Для Каждого ИдЗапуска Из Действия.start Цикл
			Операция = ПланировщикФормы.Операции.Получить(ИдЗапуска);
			ЗапуститьОперациюВЗадании(Операция);
		КонецЦикла;
		Опрос = Новый Массив;
		Для Каждого ИдОпроса Из Действия.poll Цикл
			Опрос.Добавить(ДескрипторПараллельнойОперации(ПланировщикФормы.Операции.Получить(ИдОпроса)));
		КонецЦикла;
		Если Опрос.Количество() > 0 Тогда
			Для Каждого Состояние Из СостоянияПараллельныхЗаданий(Опрос) Цикл
				Операция = ПланировщикФормы.Операции.Получить(Состояние.id);
				Операция.Вставить("ПоследнееСостояниеЗадания", Состояние.state);
				Операция.Вставить("ОшибкаОпросаЗадания", Состояние.error);
				Если ЗначениеЗаполнено(Состояние.job_id) Тогда Операция.ИдЗадания = Состояние.job_id; КонецЕсли;
				Если Состояние.state = "probe_expired" Тогда Операция.СостояниеСтарта = "probe_expired"; КонецЕсли;
				Если Состояние.state = "finished" Или Состояние.state = "probe_expired" Тогда
					РезультатЗадания = Состояние.result;
					Если НЕ ПустаяСтрока(Состояние.error) Тогда
						РезультатЗадания = Новый Структура("success,error", Ложь, Состояние.error);
					КонецЕсли;
					ПрименитьЗавершениеЗадания(ПланировщикФормы, Состояние.id, Состояние.generation, РезультатЗадания);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Отмены = Новый Массив;
		Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
			Операция = ПараОперации.Значение;
			Если Операция.ЗавершениеЗапрошено И Операция.ЗанимаетСлот И НЕ Операция.ОтменаОтправлена Тогда
				Отмены.Добавить(ДескрипторПараллельнойОперации(Операция));
			КонецЕсли;
		КонецЦикла;
		Если Отмены.Количество() > 0 Тогда
			Для Каждого ОтветОтмены Из ОтменитьПараллельныеЗадания(Отмены) Цикл
				ПланировщикФормы.Операции.Получить(ОтветОтмены.id).ОтменаОтправлена = ОтветОтмены.requested;
				ПланировщикФормы.Операции.Получить(ОтветОтмены.id).Вставить("ОшибкаОтменыЗадания", ОтветОтмены.error);
			КонецЦикла;
		КонецЕсли;
		Для Каждого ИдПоследовательной Из Действия.sequential Цикл
			Операция = ПланировщикФормы.Операции.Получить(ИдПоследовательной);

			Если ОперацияПрошлойЭпохи(Операция) Тогда

				Операция.Результат = Новый Структура("success,error", Ложь, "Protection epoch changed; command not started");

			Иначе

				Попытка Операция.Результат = ВыполнитьСервернуюКомандуСКонтролем(Операция.Подготовка.Команда);
				Исключение Операция.Результат = Новый Структура("success,error", Ложь, ОписаниеОшибки()); КонецПопытки;

			КонецЕсли;

			Операция.Вставить("ПрямойРезультат", Истина);
			Операция.Состояние = "result_ready";
		КонецЦикла;
		ПродолжитьВыдачуПодтвержденногоПараллельногоОтвета();
		Если ПараллельныйОтветВОбработке = "" Тогда
			ГотоваяОперация = ВзятьРезультатПланировщика(ПланировщикФормы);
			Если ГотоваяОперация <> Неопределено И ГотоваяОперация.ИсполнительВладельца = "owner_help"
				И НЕ ТранспортПроверен И НЕ ГотоваяОперация.ЗавершениеЗапрошено
				И НЕ ГотоваяОперация.СтарыйТранспортСправки Тогда
				// Ошибка/ожидание опроса не подтверждает актуальность получателя справки.
				ГотоваяОперация.ВыдачаНачата = Ложь;
				ГотоваяОперация.Состояние = "result_ready";
				ГотоваяОперация = Неопределено;
			КонецЕсли;
			Если ГотоваяОперация <> Неопределено Тогда НачатьВыдачуПараллельногоРезультата(ГотоваяОперация); КонецЕсли;
		КонецЕсли;
		СверитьОтложенныеСостоянияОпераций();
		Удаляемые = Новый Массив;
		Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
			Операция = ПараОперации.Значение;
			Если Операция.ОтветВыдан И НЕ Операция.ЗанимаетСлот И НЕ Операция.ПоискЗанят Тогда
				Если Операция.ИсполнительВладельца = "owner_help" Тогда
					Операция.РесурсыОсвобождены = Истина;
					Удаляемые.Добавить(Операция.Ид);
					Продолжить;
				КонецЕсли;
				Если ОсвободитьРезультатПараллельнойОперации(ДескрипторПараллельнойОперации(Операция)) Тогда
					Операция.РесурсыОсвобождены = Истина;
					Удаляемые.Добавить(Операция.Ид);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ИдУдаления Из Удаляемые Цикл УдалитьОперациюПланировщика(ПланировщикФормы, ИдУдаления); КонецЦикла;
		Если ПланировщикФормы.Режим = "draining" И НЕ ЕстьНезавершенныеОперацииПриЗакрытии() Тогда
			Если СредаПараллельности <> Неопределено Тогда
				ОсвободитьСредуПараллельногоВыполнения(СредаПараллельности, Новый Массив);
				СредаПараллельности = Неопределено;
			КонецЕсли;
			ПланировщикФормы.Режим = "disabled";
			СтатусПараллельности = ?(ПричинаНедоступностиПараллельности = "", "Выключено", "Недоступно: " + ПричинаНедоступностиПараллельности);
			Если ПланировщикФормы.ПовторноеВключение Тогда ПараллельноеВыполнениеПриИзменении(Неопределено); КонецЕсли;
		КонецЕсли;
		Если СправкаЗакрывается Тогда ОбновитьОжиданиеЗакрытияФормы(); КонецЕсли;
	Исключение
		ДобавитьВЛог("Планировщик заданий: " + ОписаниеОшибки());
		Если СправкаЗакрывается Тогда СтатусПараллельности = "Закрытие отложено: " + ОписаниеОшибки(); КонецЕсли;
	КонецПопытки;
	ПроходПланировщикаВыполняется = Ложь;
	ЗапланироватьПроходПараллельности();
КонецПроцедуры


&НаКлиенте
Функция ПрочитатьСостоянияКомандПрокси(АдресПрокси, Канал, Идентификаторы)
	СтруктураURL = РазобратьURL(АдресПрокси);
	ОпцииЗапроса = Новый Структура("channel,ids", Канал, СоединитьМассив(Идентификаторы, ","));
	ПутьЗапроса = СформироватьПутьЗапроса(СтруктураURL.Путь + "/1c/commands/status", ОпцииЗапроса);
	Если СтруктураURL.Протокол = "https" Тогда
		Соединение = Новый HTTPСоединение(СтруктураURL.Хост, СтруктураURL.Порт, , , , 2, Новый ЗащищенноеСоединениеOpenSSL());
	Иначе
		Соединение = Новый HTTPСоединение(СтруктураURL.Хост, СтруктураURL.Порт, , , , 2);
	КонецЕсли;
	Ответ = Соединение.Получить(Новый HTTPЗапрос(ПутьЗапроса));
	Если Ответ.КодСостояния <> 200 Тогда ВызватьИсключение "Прокси не поддерживает наблюдение за параллельными командами"; КонецЕсли;
	Возврат ПрочитатьJSON2(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
КонецФункции

&НаКлиенте
Процедура ПроверитьТранспортПараллельности()
	Если ПланировщикФормы.Режим <> "checking" Тогда Возврат; КонецЕсли;
	Если НЕ ВстроенныйСерверЗапущен И НЕ ФлагПодключения Тогда
		СтатусПараллельности = "Ожидание запуска сервера или подключения к прокси";
		ПодключитьОбработчикОжидания("ПроверитьТранспортПараллельности", 1, Истина);
		Возврат;
	КонецЕсли;
	Попытка
		КонтекстПроверки = Новый Структура("Проба,Поколение", Истина, ПланировщикФормы.Поколение);
		Если РежимПодключения = 0 Тогда
			Ответ = ПрочитатьСостоянияКомандПрокси(АдресСервера, СокрЛП(ИдентификаторКанала), Новый Массив);
			ПринятьСостоянияПараллельногоТранспорта(Ответ, КонтекстПроверки);
		ИначеЕсли ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			ИдОпросаПараллельногоТранспорта = Строка(Новый УникальныйИдентификатор);
			КонтекстПроверки.Вставить("ИдОпроса", ИдОпросаПараллельногоТранспорта);
			СрокОжиданияПараллельногоТранспорта = ТекущиеМиллисекундыКлиента() + 5000;
			Компонента.НачатьВызовGetRequestStates(Новый ОписаниеОповещения("ПослеСостоянийПараллельногоТранспорта", ЭтаФорма, КонтекстПроверки), "");
			ПодключитьОбработчикОжидания("ПроверитьТаймаутПробыТранспорта", 5, Истина);
		Иначе
			ПринятьСостоянияПараллельногоТранспорта(ПрочитатьJSON2(Компонента.GetRequestStates("")), КонтекстПроверки);
		КонецЕсли;
	Исключение ОтклонитьВключениеПараллельности("Транспорт не поддерживает параллельное выполнение: " + ОписаниеОшибки()); КонецПопытки;
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ПослеСостоянийПараллельногоТранспорта(РезВызова, ПарВызова, ДопПар) Экспорт
	Если ДопПар.Поколение <> ПланировщикФормы.Поколение Или ДопПар.ИдОпроса <> ИдОпросаПараллельногоТранспорта Тогда Возврат; КонецЕсли;
	ИдОпросаПараллельногоТранспорта = Неопределено;
	Попытка
		ПринятьСостоянияПараллельногоТранспорта(ПрочитатьJSON2(РезВызова), ДопПар);
	Исключение
		ОжидаютсяСостоянияТранспорта = Ложь;
		Если ДопПар.Проба Тогда
			ОтклонитьВключениеПараллельности("Не получены возможности транспорта: " + ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ПринятьСостоянияПараллельногоТранспорта(Ответ, КонтекстПроверки)
	Если КонтекстПроверки.Поколение <> ПланировщикФормы.Поколение Тогда Возврат; КонецЕсли;
	ОжидаютсяСостоянияТранспорта = Ложь;
	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда ВызватьИсключение "Invalid transport status response"; КонецЕсли;
	Если НЕ Ответ.Свойство("version") Или Ответ.version <> 1 Или НЕ Ответ.Свойство("items") Тогда
		ВызватьИсключение "Transport status protocol v1 is required";
	КонецЕсли;
	Если КонтекстПроверки.Проба Тогда
		Если ПланировщикФормы.Режим <> "checking" Тогда Возврат; КонецЕсли;
		ПланировщикФормы.Режим = "enabled";
		СтатусПараллельности = "Включено: до " + Строка(ПланировщикФормы.ЛимитЗаданий) + " серверных команд";
		Если СредаПараллельности.adapter = "platform_file" Тогда СтатусПараллельности = СтатусПараллельности + "; задания в безопасном режиме"; КонецЕсли;
		ДобавитьВЛог("Проверка параллельности успешно завершена. Параллельное выполнение включено: до " + Строка(ПланировщикФормы.ЛимитЗаданий) + " серверных команд.");
		Возврат;
	КонецЕсли;
	Если Ответ.items.Количество() <> КонтекстПроверки.Идентификаторы.Количество() Тогда ВызватьИсключение "Incomplete transport state batch"; КонецЕсли;
	ПроверенныеИд = Новый Соответствие;
	Для Каждого Состояние Из Ответ.items Цикл
		Если КонтекстПроверки.Идентификаторы.Найти(Состояние.id) = Неопределено Или ПроверенныеИд.Получить(Состояние.id) <> Неопределено Тогда
			ВызватьИсключение "Invalid transport state batch identity";
		КонецЕсли;
		ПроверенныеИд.Вставить(Состояние.id, Истина);
	КонецЦикла;
	Для Каждого Состояние Из Ответ.items Цикл
		Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
			Операция = ПараОперации.Значение;
			Если Операция.Маршрут.Режим = "probe" Или Операция.ОтветВыдан Тогда Продолжить; КонецЕсли;
			Если ИдентификаторТранспортаОперации(Операция) <> Состояние.id Тогда Продолжить; КонецЕсли;
			Если НЕ Состояние.active Тогда
				ПрерватьОперациюПланировщика(Операция, "Transport request is no longer active");
			ИначеЕсли Состояние.remaining_ms >= 0 Тогда
				Операция.Срок = Мин(Операция.Срок, КонтекстПроверки.Начало + Состояние.remaining_ms);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	СостоянияТранспортаГотовы = Истина;
КонецПроцедуры

&НаКлиенте
Функция ИдентификаторТранспортаОперации(Операция)
	Маршрут = Операция.Маршрут;
	Если Маршрут.Режим = "proxy" Тогда Возврат Маршрут.КомандаId; КонецЕсли;
	Если ЗначениеЗаполнено(Маршрут.ИдПотока) Тогда Возврат Маршрут.ИдПотока; КонецЕсли;
	Возврат Маршрут.ДанныеЗапроса.id;
КонецФункции

&НаКлиенте
Функция ОбновитьСостоянияТранспортаПередПроходом()
	Если СостоянияТранспортаГотовы Тогда СостоянияТранспортаГотовы = Ложь; Возврат Истина; КонецЕсли;
	Если ОжидаютсяСостоянияТранспорта Тогда
		Если ТекущиеМиллисекундыКлиента() < СрокОжиданияПараллельногоТранспорта Тогда Возврат Ложь; КонецЕсли;
		ОжидаютсяСостоянияТранспорта = Ложь;
		ИдОпросаПараллельногоТранспорта = Неопределено;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		Операция = ПараОперации.Значение;
		Если Операция.Маршрут.Режим = "probe" Или Операция.ОтветВыдан Или Операция.ЗавершениеЗапрошено Тогда Продолжить; КонецЕсли;
		Если Операция.Свойство("СтарыйТранспортСправки") И Операция.СтарыйТранспортСправки Тогда Продолжить; КонецЕсли;
		Если НЕ ПоколениеКонтекстаАктуально(Операция.Маршрут) Тогда Продолжить; КонецЕсли;
		Если ТекущиеМиллисекундыКлиента() >= Операция.Срок Тогда Продолжить; КонецЕсли;
		ИдТранспорта = ИдентификаторТранспортаОперации(Операция);
		Если Идентификаторы.Найти(ИдТранспорта) = Неопределено Тогда Идентификаторы.Добавить(ИдТранспорта); КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда Возврат Истина; КонецЕсли;
	КонтекстПроверки = Новый Структура("Проба,Поколение,Начало", Ложь, ПланировщикФормы.Поколение, ТекущиеМиллисекундыКлиента());
	КонтекстПроверки.Вставить("Идентификаторы", Идентификаторы);
	Попытка
		Если РежимПодключения = 0 Тогда
			Ответ = ПрочитатьСостоянияКомандПрокси(АдресСервера, СокрЛП(ИдентификаторКанала), Идентификаторы);
			ПринятьСостоянияПараллельногоТранспорта(Ответ, КонтекстПроверки);
		ИначеЕсли ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			ОжидаютсяСостоянияТранспорта = Истина;
			ИдОпросаПараллельногоТранспорта = Строка(Новый УникальныйИдентификатор);
			КонтекстПроверки.Вставить("ИдОпроса", ИдОпросаПараллельногоТранспорта);
			СрокОжиданияПараллельногоТранспорта = ТекущиеМиллисекундыКлиента() + 5000;
			Компонента.НачатьВызовGetRequestStates(Новый ОписаниеОповещения("ПослеСостоянийПараллельногоТранспорта", ЭтаФорма, КонтекстПроверки), СоединитьМассив(Идентификаторы, ","));
			Возврат Ложь;
		Иначе
			ПринятьСостоянияПараллельногоТранспорта(ПрочитатьJSON2(Компонента.GetRequestStates(СоединитьМассив(Идентификаторы, ","))), КонтекстПроверки);
		КонецЕсли;
	Исключение
		ОжидаютсяСостоянияТранспорта = Ложь;
		// Неизвестный статус не разрешает старт. Уже работающие задания будут опрошены после истечения срока.
		Возврат Ложь;
	КонецПопытки;
	СостоянияТранспортаГотовы = Ложь;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ОтменитьПараллельныеКомандыМСПСессии(ИдСессии)
	Если ПланировщикФормы = Неопределено Или НЕ ЗначениеЗаполнено(ИдСессии) Тогда Возврат; КонецЕсли;
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		Операция = ПараОперации.Значение;
		Маршрут = Операция.Маршрут;
		Если Маршрут.Режим <> "mcp" Тогда Продолжить; КонецЕсли;
		// Legacy SSE принадлежит отдельному потоку, а не Streamable HTTP-сеансу.
		Если ЗначениеЗаполнено(Маршрут.ИдПотока) Тогда Продолжить; КонецЕсли;
		Если Маршрут.ДанныеЗапроса.headers["mcp-session-id"] <> ИдСессии Тогда Продолжить; КонецЕсли;
		ПрерватьОперациюПланировщика(Операция, "MCP session closed; operation cancelled");
	КонецЦикла;
	ЗавершитьОтмененныеПодтвержденияПараллельности();
	// Остановку заданий и выдачу ошибок выполнит обычный проход: занятые слоты сохраняются.
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПараллельныйMCPЗапрос(ТелоJSON, ДанныеЗапроса, ИдПотока = "")
	Если ПланировщикФормы = Неопределено Тогда Возврат; КонецЕсли;
	Если НЕ ТелоJSON.Свойство("params") Или ТипЗнч(ТелоJSON.params) <> Тип("Структура") Тогда Возврат; КонецЕсли;
	Если НЕ ТелоJSON.params.Свойство("requestId") Тогда Возврат; КонецЕсли;
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		Операция = ПараОперации.Значение;
		Маршрут = Операция.Маршрут;
		Если Маршрут.Режим <> "mcp" Тогда Продолжить; КонецЕсли;
		Если ТипЗнч(Маршрут.Ид) <> ТипЗнч(ТелоJSON.params.requestId) Или Маршрут.Ид <> ТелоJSON.params.requestId Тогда Продолжить; КонецЕсли;
		Если НЕ ПоколениеКонтекстаАктуально(Маршрут) Тогда Продолжить; КонецЕсли;
		Если ЗначениеЗаполнено(ИдПотока) Тогда
			Если Маршрут.ИдПотока <> ИдПотока Тогда Продолжить; КонецЕсли;
		Иначе
			Если Маршрут.ДанныеЗапроса.headers["mcp-session-id"] <> ДанныеЗапроса.headers["mcp-session-id"] Тогда Продолжить; КонецЕсли;
		КонецЕсли;
		ПрерватьОперациюПланировщика(Операция, "MCP client cancelled the request");
	КонецЦикла;
	ЗапланироватьПроходПараллельности();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемПараллельности(Отказ, СтандартнаяОбработка)
	Если ПланировщикФормы = Неопределено Тогда Возврат; КонецЕсли;
	СправкаЗакрывается = Истина;
	ОтменитьАвтостартПриОткрытии();
	ОстановитьПланировщикКоманд(ПланировщикФормы, "Processing form is closing");
	Если ЕстьНезавершенныеОперацииПриЗакрытии() Тогда
		Отказ = Истина;
		ОбновитьОжиданиеЗакрытияФормы();
		ЗапланироватьПроходПараллельности();
	ИначеЕсли СредаПараллельности <> Неопределено Тогда
		Попытка
			ОсвободитьСредуПараллельногоВыполнения(СредаПараллельности, Новый Массив);
			СредаПараллельности = Неопределено;
		Исключение
			Отказ = Истина;
			СтатусПараллельности = "Не удалось освободить ресурсы заданий: " + ОписаниеОшибки();
			ЗапланироватьПроходПараллельности();
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЕстьНезавершенныеОперацииПриЗакрытии()
	Возврат ПроверкаПараллельностиВыполняется = Истина
		Или ПланировщикФормы.Операции.Количество() > 0
		Или ИсполнительСправкиФормы.Запущен Или ИсполнительСправкиФормы.Остановка
		Или ИсполнительСправкиФормы.Вызов <> Неопределено;
КонецФункции

&НаКлиенте
Процедура ОбновитьОжиданиеЗакрытияФормы()
	Если НЕ ЕстьНезавершенныеОперацииПриЗакрытии() И СредаПараллельности = Неопределено Тогда
		Если ЗакрытиеФормыЗапланировано <> Истина Тогда
			ПодключитьОбработчикОжидания("ЗакрытьФормуПослеЗавершенияЗаданий", 0.1, Истина);
			ЗакрытиеФормыЗапланировано = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ТекстОжидания = "Закрытие: освобождение ресурсов команд…";
	Если ПроверкаПараллельностиВыполняется = Истина Тогда
		ТекстОжидания = "Закрытие: завершение проверки параллельности…";
	ИначеЕсли ИсполнительСправкиФормы.Запущен Или ИсполнительСправкиФормы.Остановка
		Или ИсполнительСправкиФормы.Вызов <> Неопределено Тогда
		ТекстОжидания = "Закрытие: остановка поиска по справке…";
	КонецЕсли;
	Для Каждого ПараОперации Из ПланировщикФормы.Операции Цикл
		Операция = ПараОперации.Значение;
		Если НЕ Операция.ЗанимаетСлот Тогда Продолжить; КонецЕсли;
		ИмяОжидания = ?(Операция.Маршрут.Режим = "probe", "пробного задания", "задания " + Операция.Команда.tool);
		ТекстОжидания = "Закрытие: ожидается остановка " + ИмяОжидания + "…";
		ПоследнееСостояние = "";
		Операция.Свойство("ПоследнееСостояниеЗадания", ПоследнееСостояние);
		Если ПоследнееСостояние = "start_unknown" Тогда
			ТекстОжидания = "Закрытие: состояние " + ИмяОжидания + " не подтверждено; выполняется повторная проверка.";
		КонецЕсли;
		ОшибкаОперации = "";
		Если Операция.Свойство("ОшибкаОпросаЗадания", ОшибкаОперации) И ОшибкаОперации <> "" Тогда
			ТекстОжидания = ТекстОжидания + " Ошибка проверки: " + ОшибкаОперации;
		КонецЕсли;
		Если Операция.Свойство("ОшибкаОтменыЗадания", ОшибкаОперации) И ОшибкаОперации <> "" Тогда
			ТекстОжидания = ТекстОжидания + " Ошибка остановки: " + ОшибкаОперации;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Если СтатусПараллельности <> ТекстОжидания Тогда
		СтатусПараллельности = ТекстОжидания;
		ДобавитьВЛог(ТекстОжидания);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуПослеЗавершенияЗаданий()
	ЗакрытиеФормыЗапланировано = Ложь;
	Если НЕ СправкаЗакрывается Тогда Возврат; КонецЕсли;
	Если ЕстьНезавершенныеОперацииПриЗакрытии() Или СредаПараллельности <> Неопределено Тогда
		ЗапланироватьПроходПараллельности();
		Возврат;
	КонецЕсли;
	Закрыть();
КонецПроцедуры

&НаКлиенте
Функция ЗарезервироватьПодтверждениеПараллельнойКоманды(Команда, Режим, ДанныеЗапроса = Неопределено, Ид = Неопределено, ИдПотока = "")
	Если ПланировщикФормы = Неопределено Или ПланировщикФормы.Режим = "disabled" Тогда Возврат Истина; КонецЕсли;
	Если НЕ ЭтоСервернаяКомандаПланировщика(Команда) Тогда Возврат Истина; КонецЕсли;
	Маршрут = НовыйКонтекстВыполненияКоманды(Режим);
	Если Режим = "proxy" Тогда
		Маршрут.КомандаId = Команда.id;
		Маршрут.АдресПрокси = АдресСервера;
	Иначе
		Маршрут.ДанныеЗапроса = ДанныеЗапроса;
		Маршрут.Ид = Ид;
		Маршрут.ИдПотока = ИдПотока;
	КонецЕсли;
	Принятие = ПринятьПараллельнуюКоманду(Команда, Маршрут);
	Если НЕ Маршрут.Отложено Тогда
		ДоставитьРезультатКоманды(Маршрут, Принятие);
		Возврат Ложь;
	КонецЕсли;
	Операция = ПланировщикФормы.Операции.Получить(Маршрут.ИдОперации);
	Если Операция.ЗавершениеЗапрошено Тогда Возврат Ложь; КонецЕсли;
	Операция.Состояние = "approval";
	ПозицияВОчереди = ПланировщикФормы.Очередь.Найти(Операция.Ид);
	Если ПозицияВОчереди <> Неопределено Тогда ПланировщикФормы.Очередь.Удалить(ПозицияВОчереди); КонецЕсли;
	Команда.Вставить("_parallel_approval_id", Операция.Ид);
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ОткрытьПодтверждениеОпаснойКоманды(Команда, ОпцииФормы, ОповещениеЗакрытия, ИдОжидания = Неопределено)
	Операция = Неопределено;
	УникальностьФормы = Строка(Новый УникальныйИдентификатор);
	РежимОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	Если Команда.Свойство("_parallel_approval_id") Тогда
		Операция = ПланировщикФормы.Операции.Получить(Команда._parallel_approval_id);
		Если Операция = Неопределено Тогда
			Если ИдОжидания <> Неопределено Тогда ОжидающиеПодтверждения.Удалить(ИдОжидания); КонецЕсли;
			Возврат;
		КонецЕсли;
		Если ИдОжидания <> Неопределено Тогда Операция.Вставить("ИдОжиданияОпаснойКоманды", ИдОжидания); КонецЕсли;
		Если Операция.ЗавершениеЗапрошено Или Операция.Состояние <> "approval" Тогда
			ОчиститьРазрешениеОпаснойКоманды(Операция, Истина);
			Возврат;
		КонецЕсли;
		УникальностьФормы = Операция.Ид;
		РежимОкна = РежимОткрытияОкнаФормы.Независимый;
	КонецЕсли;
	Попытка
		ФормаРазрешения = ОткрытьФорму(
			"ВнешняяОбработка.MCPToolkit.Форма.ФормаПодтверждения",
			ОпцииФормы, ЭтаФорма, УникальностьФормы, , , ОповещениеЗакрытия, РежимОкна);
		Если ФормаРазрешения = Неопределено Тогда ВызватьИсключение "Не удалось открыть подтверждение опасной операции"; КонецЕсли;
		Если Операция <> Неопределено Тогда Операция.Вставить("ФормаРазрешенияОпаснойКоманды", ФормаРазрешения); КонецЕсли;
	Исключение
		Если ИдОжидания <> Неопределено Тогда ОжидающиеПодтверждения.Удалить(ИдОжидания); КонецЕсли;
		Если Операция = Неопределено Тогда ВызватьИсключение; КонецЕсли;
		ПрерватьОперациюПланировщика(Операция, "Ошибка открытия подтверждения опасной операции: " + ОписаниеОшибки());
		ОчиститьРазрешениеОпаснойКоманды(Операция, Истина);
		ЗапланироватьПроходПараллельности();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРазрешениеОпаснойКоманды(Операция, ЗакрытьОкно = Ложь)
	ИдОжидания = Неопределено;
	Если Операция.Свойство("ИдОжиданияОпаснойКоманды", ИдОжидания) Тогда
		// До закрытия окна: callback уже не должен находить отменённое ожидание.
		ОжидающиеПодтверждения.Удалить(ИдОжидания);
		Операция.Удалить("ИдОжиданияОпаснойКоманды");
	КонецЕсли;
	ФормаРазрешения = Неопределено;
	Если Операция.Свойство("ФормаРазрешенияОпаснойКоманды", ФормаРазрешения) Тогда
		Операция.Удалить("ФормаРазрешенияОпаснойКоманды");
		Если ЗакрытьОкно Тогда
			Попытка ФормаРазрешения.Закрыть(Ложь);
			Исключение ДобавитьВЛог("Закрытие подтверждения опасной операции: " + ОписаниеОшибки()); КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПродолжитьПодтверждениеПараллельнойКоманды(Команда, Разрешено)
	Если НЕ Команда.Свойство("_parallel_approval_id") Тогда Возврат Ложь; КонецЕсли;
	Операция = ПланировщикФормы.Операции.Получить(Команда._parallel_approval_id);
	Если Операция = Неопределено Тогда Возврат Истина; КонецЕсли;
	ОчиститьРазрешениеОпаснойКоманды(Операция);
	Если Операция.Состояние <> "approval" Или Операция.ЗавершениеЗапрошено Тогда Возврат Истина; КонецЕсли;
	Если Разрешено = Истина И ТекущиеМиллисекундыКлиента() < Операция.Срок
		И ПоколениеКонтекстаАктуально(Операция.Маршрут) И НастройкиПараллельнойОперацииАктуальны(Операция) Тогда
		Операция.Состояние = "queued";
		ПланировщикФормы.Очередь.Добавить(Операция.Ид);
	Иначе
		ПрерватьОперациюПланировщика(Операция, "Approval denied or operation expired");
