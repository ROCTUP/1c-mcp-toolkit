// Возвращает путь к temp-файлу или "" если маппинги пусты/не нужны
&НаКлиенте
Функция СохранитьМаппингиАнонимизацииВоВременныйФайл(ПутьФайла = "")
	// В proxy mode маппинги живут в Python — передавать нечего
	Если РежимПодключения = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если МаппингАнонимизации = Неопределено Или МаппингАнонимизации.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	МассивМ = Новый Массив;
	Для Каждого П Из МаппингАнонимизации Цикл
		МассивМ.Добавить(Новый Структура("к,т", П.Ключ, П.Значение));
	КонецЦикла;

	МассивС = Новый Массив;
	Если СчетчикиТокенов <> Неопределено Тогда
		Для Каждого П Из СчетчикиТокенов Цикл
			МассивС.Добавить(Новый Структура("к,с", П.Ключ, П.Значение));
		КонецЦикла;
	КонецЕсли;

	// Живой хвост очереди вставки (порядок вытеснения) — только от головы до конца.
	// Индекс головы сериализовать не нужно: на диск идёт уже компактная очередь.
	МассивО = Новый Массив;
	Если ОчередьВставки <> Неопределено Тогда
		Голова = ?(ГоловаОчереди = Неопределено, 0, ГоловаОчереди);
		Для Инд = Голова По ОчередьВставки.Количество() - 1 Цикл
			МассивО.Добавить(ОчередьВставки[Инд]);
		КонецЦикла;
	КонецЕсли;

	Данные = Новый Структура("м,с,о", МассивМ, МассивС, МассивО);

	ВременныйФайл = ?(ЗначениеЗаполнено(ПутьФайла), ПутьФайла, ПолучитьИмяВременногоФайла("json"));
	ЗТМапп = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	Попытка
		ЗТМапп.Записать(ЗаписатьJSON2(Данные));
	Исключение
		Попытка ЗТМапп.Закрыть(); Исключение КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	ЗТМапп.Закрыть();

	Возврат ВременныйФайл;
КонецФункции

&НаКлиенте
Процедура ВосстановитьМаппингиАнонимизацииИзФайла(Путь)
	Если Путь = "" Тогда
		Возврат;
	КонецЕсли;

	ЧТМапп = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Попытка
		ТекстМапп = ЧТМапп.Прочитать();
	Исключение
		Попытка ЧТМапп.Закрыть(); Исключение КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	ЧТМапп.Закрыть();
	Данные = ПрочитатьJSON2(ТекстМапп);
	УдалитьФайлы(Путь);

	МаппингАнонимизации   = Новый Соответствие;
	МаппингДеанонимизации = Новый Соответствие;
	Для Каждого З Из Данные.м Цикл
		МаппингАнонимизации[З.к]         = З.т;
		МаппингДеанонимизации[ВРег(З.т)] = З.к;
	КонецЦикла;

	СчетчикиТокенов = Новый Соответствие;
	Для Каждого З Из Данные.с Цикл
		СчетчикиТокенов[З.к] = З.с;
	КонецЦикла;

	// Очередь вставки (порядок вытеснения) — обязательная часть eviction-state.
	// Толерантно к старому формату без поля "о": восстанавливаем порядок из карты
	// (обход Данные.м), чтобы каждая живая пара была ровно один раз в eviction-order.
	ОчередьВставки = Новый Массив;
	Если Данные.Свойство("о") И Данные.о <> Неопределено Тогда
		Для Каждого ЭлемОчереди Из Данные.о Цикл
			ОчередьВставки.Добавить(ЭлемОчереди);
		КонецЦикла;
	Иначе
		Для Каждого З Из Данные.м Цикл
			ОчередьВставки.Добавить(З.к);
		КонецЦикла;
	КонецЕсли;
	ГоловаОчереди = 0;
КонецПроцедуры

// Восстанавливает МСПСессии из плоского массива строк (session ID).
// Восстановленные сессии получают текущее время — корректно, они все "только что" пришли.
&НаКлиенте
Процедура ВосстановитьМСПСессии(МассивИдС)
	Если МассивИдС = Неопределено Или МассивИдС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	МСПСессии = Новый Соответствие;
	Для Каждого ИдС Из МассивИдС Цикл
		Если ТипЗнч(ИдС) <> Тип("Строка") Или НЕ ВалидныйФорматСессии(ИдС) Тогда
			ВызватьИсключение "Sessions restore error: invalid session ID type or format: " + Строка(ИдС);
		КонецЕсли;
		МСПСессии[ИдС] = ТекущаяДата();
	КонецЦикла;
	ДобавитьВЛог("Восстановлено сессий: " + МассивИдС.Количество() + " → " + СоединитьМассив(МассивИдС, ", "));
КонецПроцедуры

// Побитовый XOR двух байт (0-255) через арифметику
&НаКлиенте
Функция XORБайт(А, Б)
	Рез = 0; Ст = 1;
	Для Индекс = 0 По 7 Цикл
		Рез = Рез + (Цел(А / Ст) % 2 + Цел(Б / Ст) % 2) % 2 * Ст;
		Ст = Ст * 2;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Шифрует пароль XOR с ключом; результат — Base64. Никаких temp-файлов.
&НаКлиенте
Функция ЗашифроватьПарольПерезапуска(Пароль, КлючШифрования = "")
	Если НЕ ЗначениеЗаполнено(Пароль) Тогда Возврат ""; КонецЕсли;

	ДД_Пароль = ПолучитьДвоичныеДанныеИзСтроки(Пароль, КодировкаТекста.UTF8);
	ДД_Ключ   = ПолучитьДвоичныеДанныеИзСтроки(?(ЗначениеЗаполнено(КлючШифрования), КлючШифрования, ПолучитьКлючШифрования()), КодировкаТекста.UTF8);

	КлючБайты = Новый Массив;
	ЧтК = Новый ЧтениеДанных(ДД_Ключ.ОткрытьПотокДляЧтения());
	Б = ЧтК.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		КлючБайты.Добавить(Б);
		Б = ЧтК.ПрочитатьБайт();
	КонецЦикла;
	ЧтК.Закрыть();
	Если КлючБайты.Количество() = 0 Тогда ВызватьИсключение "XOR key is empty"; КонецЕсли;

	ПотокРез = Новый ПотокВПамяти();
	ЗпР = Новый ЗаписьДанных(ПотокРез);
	ЧтП = Новый ЧтениеДанных(ДД_Пароль.ОткрытьПотокДляЧтения());
	КлючИндекс = 0;
	Б = ЧтП.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		ЗпР.ЗаписатьБайт(XORБайт(Б, КлючБайты[КлючИндекс % КлючБайты.Количество()]));
		КлючИндекс = КлючИндекс + 1;
		Б = ЧтП.ПрочитатьБайт();
	КонецЦикла;
	ЧтП.Закрыть();
	ЗпР.Закрыть();
	Возврат Base64Строка(ПотокРез.ЗакрытьИПолучитьДвоичныеДанные());
КонецФункции

// Расшифровывает — XOR симметричен, логика идентична шифрованию.
&НаКлиенте
Функция РасшифроватьПарольПерезапуска(ЗашифрованнаяСтрока, КлючШифрования = "")
	Если НЕ ЗначениеЗаполнено(ЗашифрованнаяСтрока) Тогда Возврат ""; КонецЕсли;

	ДД_Шифр = Base64Значение(ЗашифрованнаяСтрока);
	ДД_Ключ = ПолучитьДвоичныеДанныеИзСтроки(?(ЗначениеЗаполнено(КлючШифрования), КлючШифрования, ПолучитьКлючШифрования()), КодировкаТекста.UTF8);

	КлючБайты = Новый Массив;
	ЧтК = Новый ЧтениеДанных(ДД_Ключ.ОткрытьПотокДляЧтения());
	Б = ЧтК.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		КлючБайты.Добавить(Б);
		Б = ЧтК.ПрочитатьБайт();
	КонецЦикла;
	ЧтК.Закрыть();
	Если КлючБайты.Количество() = 0 Тогда ВызватьИсключение "XOR key is empty"; КонецЕсли;

	ПотокРез = Новый ПотокВПамяти();
	ЗпР = Новый ЗаписьДанных(ПотокРез);
	ЧтШ = Новый ЧтениеДанных(ДД_Шифр.ОткрытьПотокДляЧтения());
	КлючИндекс = 0;
	Б = ЧтШ.ПрочитатьБайт();
	Пока Б <> Неопределено Цикл
		ЗпР.ЗаписатьБайт(XORБайт(Б, КлючБайты[КлючИндекс % КлючБайты.Количество()]));
		КлючИндекс = КлючИндекс + 1;
		Б = ЧтШ.ПрочитатьБайт();
	КонецЦикла;
	ЧтШ.Закрыть();
	ЗпР.Закрыть();
	Возврат ПолучитьСтрокуИзДвоичныхДанных(ПотокРез.ЗакрытьИПолучитьДвоичныеДанные(), КодировкаТекста.UTF8);
КонецФункции

&НаСервере
Функция ПолучитьПользовательскийКлючИзХранилищаНаСервере()
	Попытка
