КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_Финал(ТунПодключён)
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если ТунПодключён Тогда
		КомпонентаТун = Новый("AddIn.ToonConv.ToonConverter");
	КонецЕсли;
	// Для kind=interface нужен список адресов — на async-платформе через НачатьВызов (как GetRequestBody)
	Выбор = ВыборАдресаВстроенногоСервера;
	Если Выбор <> Неопределено И Выбор.kind = "interface" Тогда
		Компонента.НачатьВызовПолучитьЛокальныеАдреса(
			Новый ОписаниеОповещения("ЗапускСервера_ПослеАдресов", ЭтаФорма));
		Возврат;
	КонецЕсли;
	ЗапускСервера_СБиндАдресом(ВычислитьАдресПривязки(Выбор, ""));
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_ПослеАдресов(РезВызова, ПарВызова, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	ДжейсонАдресов = ?(РезВызова = Неопределено, "", РезВызова);
	ЗапускСервера_СБиндАдресом(ВычислитьАдресПривязки(ВыборАдресаВстроенногоСервера, ДжейсонАдресов));
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_СБиндАдресом(Адрес)
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	АдресПривязкиВстроенногоСервера = Адрес;
	Компонента.НачатьВызовStart(
		Новый ОписаниеОповещения("ПослеЗапускаВстроенногоСервера", ЭтаФорма),
		ПортВстроенногоСервера, Адрес);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗапускаВстроенногоСервера(РезВызова, ПарВызова, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если РезВызова = Истина Тогда
		ВстроенныйСерверЗапущен = Истина;
		МСПСессии = Новый Соответствие;
		SSEПотоки = Новый Соответствие;
		ЛегасиССЕПотоки = Новый Соответствие;
		ОжидающиеПодтверждения = Новый Соответствие;
		ЗапускСервераВПроцессе = Ложь;
		УстановитьСтатус("Сервер запущен (адрес " + АдресПривязкиВстроенногоСервера + ", порт " + Формат(ПортВстроенногоСервера, "ЧГ=") + ")", Истина);
		ДобавитьВЛог("Встроенный HTTP-сервер запущен на " + АдресПривязкиВстроенногоСервера + ":" + Формат(ПортВстроенногоСервера, "ЧГ="));
		АнонимизаторОчистить();
		Если ИспользоватьТочнуюАнонимизацию Тогда
			ПостроитьИЗаполнитьСловарьАнонимизации();
		КонецЕсли;
		ЗавершитьАвтостартПослеЗапускаВстроенногоСервера();
	Иначе
		ЗапускСервераВПроцессе = Ложь;
		Компонента = Неопределено;
		ДобавитьВЛог("Не удалось запустить сервер на порту " + Формат(ПортВстроенногоСервера, "ЧГ="));
		ЗавершитьАвтостартСОшибкой("Embedded server start failed");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВстроенныйСерверСинхронно()

	Если ВстроенныйСерверЗапущен Тогда
		ДобавитьВЛог("Сервер уже запущен");
		Возврат;
	КонецЕсли;

	// Подключение компоненты MCPHttp
	Попытка
		Результат = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport",
			"MCPHttp", ТипВнешнейКомпоненты.Native);
		Если НЕ Результат Тогда
			// Fallback: загрузка из макета через файл
			ДвоичныеДанные = ПолучитьМакетНаСервере();
			ИмяФайла = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ИмяФайла);
			ПодключитьВнешнююКомпоненту(ИмяФайла, "MCPHttp", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
	ПроверитьПоддержкуФинальногоОтвета();
	Исключение
		ДобавитьВЛог("Ошибка подключения компоненты: " + ОписаниеОшибки());
		ЗавершитьАвтостартСОшибкой("Server add-in load failed (sync): " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Подключение ToonConverter
	КомпонентаТун = Неопределено;
	Попытка
		РезТун = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.MCPToolkit.Макет.ToonConverter",
			"ToonConv", ТипВнешнейКомпоненты.Native);
		Если НЕ РезТун Тогда
			ДвоичныеДанные = ПолучитьМакетТунКонвертераНаСервере();
			ИмяФайла = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ИмяФайла);
			ПодключитьВнешнююКомпоненту(ИмяФайла, "ToonConv", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		КомпонентаТун = Новый("AddIn.ToonConv.ToonConverter");
	Исключение
		ДобавитьВЛог("Предупреждение: ToonConverter не загружена. TOON-формат недоступен. " + ОписаниеОшибки());
	КонецПопытки;

	// Подключение SyntaxHelpReader
	ПодключитьКомпонентуSyntaxHelpСинхронно();

	// Подключение ScreenCapture
	ПодключитьКомпонентуScreenCaptureСинхронно();

	// Запуск HTTP-сервера
	АдресПривязкиВстроенногоСервера = ОпределитьАдресПривязкиСинхронно();

	ПрименитьТаймаутЗапроса();

	Если Компонента.Start(ПортВстроенногоСервера, АдресПривязкиВстроенногоСервера) Тогда
		ВстроенныйСерверЗапущен = Истина;
		МСПСессии = Новый Соответствие;
		SSEПотоки = Новый Соответствие;
		ЛегасиССЕПотоки = Новый Соответствие;
		ОжидающиеПодтверждения = Новый Соответствие;
		УстановитьСтатус("Сервер запущен (адрес " + АдресПривязкиВстроенногоСервера + ", порт " + Формат(ПортВстроенногоСервера, "ЧГ=") + ")", Истина);
		ДобавитьВЛог("Встроенный HTTP-сервер запущен на " + АдресПривязкиВстроенногоСервера + ":" + Формат(ПортВстроенногоСервера, "ЧГ="));
		АнонимизаторОчистить();
		Если ИспользоватьТочнуюАнонимизацию Тогда
			ПостроитьИЗаполнитьСловарьАнонимизации();
		КонецЕсли;
		ЗавершитьАвтостартПослеЗапускаВстроенногоСервера();
	Иначе
		ДобавитьВЛог("Не удалось запустить сервер на порту " + Формат(ПортВстроенногоСервера, "ЧГ="));
		Компонента = Неопределено;
		ЗавершитьАвтостартСОшибкой("Embedded server start failed (sync)");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбъектSyntaxHelpИИнициализировать()
	Попытка
		КомпонентаSyntaxHelp = Новый("AddIn.SyntaxH.SyntaxHelpReader");
		КолвоТемBSL = КомпонентаSyntaxHelp.Инициализировать(КаталогПрограммы());
		Если КолвоТемBSL < 0 Тогда
			ДобавитьВЛог("SyntaxHelpReader: ошибка парсинга .hbk файлов (код " + КолвоТемBSL + ")");
			КомпонентаSyntaxHelp = Неопределено;
		ИначеЕсли КолвоТемBSL = 0 Тогда
			ДобавитьВЛог("SyntaxHelpReader: тем не найдено. Проверьте наличие shcntx_ru.hbk и shquery_ru.hbk в " + КаталогПрограммы());
		Иначе
			ДобавитьВЛог("SyntaxHelpReader загружен, тем: " + КолвоТемBSL);
			КэшСхемИнструментов = Неопределено; // сбросить кэш — инструмент теперь доступен
		КонецЕсли;
	Исключение
		КомпонентаSyntaxHelp = Неопределено;
		ДобавитьВЛог("SyntaxHelpReader: исключение при инициализации: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
// Создание контекста попытки инициализации SyntaxHelp: идентификатор выдаётся на старте
// подключения, до первого асинхронного шага, и пробрасывается через callbacks загрузки DLL.
Функция НовыйКонтекстПопыткиSyntaxHelp(РежимЗапуска, ТунПодключён = Ложь)
	КонтекстПопытки = Новый Структура;
	КонтекстПопытки.Вставить("РежимЗапуска", РежимЗапуска);
	КонтекстПопытки.Вставить("ТунПодключён", ТунПодключён);
	КонтекстПопытки.Вставить("ОбъектКомпоненты", Неопределено);
	КонтекстПопытки.Вставить("РезультатПринят", Ложь);
	КонтекстПопытки.Вставить("ИнициализацияНачата", Ложь);
	Если РежимЗапуска = "proxy" Тогда
		ИдПопыткиSyntaxHelpПрокси = ИдПопыткиSyntaxHelpПрокси + 1;
		КонтекстПопытки.Вставить("ИдПопытки", ИдПопыткиSyntaxHelpПрокси);
		КонтекстПопытки.Вставить("ПоколениеПодключения", ПоколениеПодключенияПрокси);
	Иначе
		ИдПопыткиSyntaxHelpСервер = ИдПопыткиSyntaxHelpСервер + 1;
		КонтекстПопытки.Вставить("ИдПопытки", ИдПопыткиSyntaxHelpСервер);
		КонтекстПопытки.Вставить("ПоколениеПодключения", ПоколениеПодключенияСервер);
	КонецЕсли;
	Возврат КонтекстПопытки;
КонецФункции

&НаКлиенте
// Проверка владельца попытки: попытка актуальна, пока её идентификатор и поколение
// режима не изменены отзывом или новой попыткой подключения.
Функция ПопыткаSyntaxHelpАктуальна(КонтекстПопытки)
	Если КонтекстПопытки.РежимЗапуска = "proxy" Тогда
		Возврат КонтекстПопытки.ИдПопытки = ИдПопыткиSyntaxHelpПрокси
			И КонтекстПопытки.ПоколениеПодключения = ПоколениеПодключенияПрокси;
	Иначе
		Возврат КонтекстПопытки.ИдПопытки = ИдПопыткиSyntaxHelpСервер
			И КонтекстПопытки.ПоколениеПодключения = ПоколениеПодключенияСервер;
	КонецЕсли;
КонецФункции

&НаКлиенте
// Завершение попытки (терминальный путь: отказ загрузки или принятый результат
// инициализации). Возвращает Истина только первому вызову — повторное завершение
// той же попытки ничего не делает.
Функция ЗавершитьПопыткуSyntaxHelp(КонтекстПопытки)
	Если НЕ ПопыткаSyntaxHelpАктуальна(КонтекстПопытки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если КонтекстПопытки.РезультатПринят Тогда
		Возврат Ложь;
	КонецЕсли;
	КонтекстПопытки.РезультатПринят = Истина;
	Возврат Истина;
КонецФункции

&НаКлиенте
// Асинхронная инициализация SyntaxHelpReader: объект компоненты живёт в контексте попытки
// и публикуется в КомпонентаSyntaxHelp только после принятого успешного результата.
Функция НачатьИнициализациюSyntaxHelp(КонтекстПопытки)
	Если НЕ ПопыткаSyntaxHelpАктуальна(КонтекстПопытки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если КонтекстПопытки.РезультатПринят Тогда
		Возврат Ложь; // попытка уже завершена
	КонецЕсли;
	Если КонтекстПопытки.ИнициализацияНачата Тогда
		Возврат Ложь; // инициализация этой попытки уже запущена
	КонецЕсли;
	КонтекстПопытки.ИнициализацияНачата = Истина;
	Попытка
		КонтекстПопытки.ОбъектКомпоненты = Новый("AddIn.SyntaxH.SyntaxHelpReader");
		КонтекстПопытки.ОбъектКомпоненты.НачатьВызовИнициализировать(
			Новый ОписаниеОповещения("ПослеИнициализацииSyntaxHelp", ЭтаФорма, КонтекстПопытки),
			КаталогПрограммы());
	Исключение
		// Ошибка создания объекта или регистрации вызова: справка необязательна —
		// продолжаем цепочку один раз. Попытка завершена: поздний callback ничего не продолжит
		КонтекстПопытки.РезультатПринят = Истина;
		ДобавитьВЛог("SyntaxHelpReader: исключение при запуске инициализации: " + ОписаниеОшибки());
		Если КонтекстПопытки.РежимЗапуска = "server" Тогда
			ЗапускСервера_ПодключитьScreenCapture(КонтекстПопытки.ТунПодключён);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПослеИнициализацииSyntaxHelp(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = КонтекстПопыткиSyntaxHelp. Устаревшая попытка не публикует компоненту
	// и не продолжает серверную цепочку.
	Если НЕ ЗавершитьПопыткуSyntaxHelp(ДопПар) Тогда
		Возврат; // устаревшая или уже завершённая попытка: ничего не публикует и не продолжает
	КонецЕсли;

	КолвоТемРезультат = Неопределено;
	Если ТипЗнч(РезВызова) = Тип("Число") Тогда
		КолвоТемРезультат = РезВызова;
	КонецЕсли;

	Если КолвоТемРезультат = Неопределено ИЛИ КолвоТемРезультат < 0 Тогда
		// Ошибка инициализации — справка необязательна: логируем и продолжаем цепочку один раз
		Если КолвоТемРезультат = Неопределено Тогда
			ДобавитьВЛог("SyntaxHelpReader: неожиданный тип результата инициализации: " + ТипЗнч(РезВызова));
		Иначе
			ДобавитьВЛог("SyntaxHelpReader: ошибка парсинга .hbk файлов (код " + КолвоТемРезультат + ")");
		КонецЕсли;
		Если ДопПар.РежимЗапуска = "server" Тогда
			ЗапускСервера_ПодключитьScreenCapture(ДопПар.ТунПодключён);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Публикуем компоненту только после принятого успешного результата
	КомпонентаSyntaxHelp = ДопПар.ОбъектКомпоненты;
	Если КолвоТемРезультат = 0 Тогда
		ДобавитьВЛог("SyntaxHelpReader: тем не найдено. Проверьте наличие shcntx_ru.hbk и shquery_ru.hbk в " + КаталогПрограммы());
	Иначе
		ДобавитьВЛог("SyntaxHelpReader загружен, тем: " + КолвоТемРезультат);
		КэшСхемИнструментов = Неопределено; // сбросить кэш — инструмент теперь доступен
	КонецЕсли;

	Если ДопПар.РежимЗапуска = "server" Тогда
		ЗапускСервера_ПодключитьScreenCapture(ДопПар.ТунПодключён);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКомпонентуSyntaxHelpСинхронно()
	Попытка
		Если НЕ ПодключитьВнешнююКомпоненту(
				"ВнешняяОбработка.MCPToolkit.Макет.SyntaxHelpReader",
				"SyntaxH", ТипВнешнейКомпоненты.Native) Тогда
			ДвоичныеДанные = ПолучитьМакетSyntaxHelpНаСервере();
			ВремФайл = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ВремФайл);
			ПодключитьВнешнююКомпоненту(ВремФайл, "SyntaxH", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		СоздатьОбъектSyntaxHelpИИнициализировать();
	Исключение
		КомпонентаSyntaxHelp = Неопределено;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияМакетаSyntaxHelpProxy(Подключено, КонтекстПопытки) Экспорт
	Если НЕ ПопыткаSyntaxHelpАктуальна(КонтекстПопытки) Тогда Возврат; КонецЕсли;
