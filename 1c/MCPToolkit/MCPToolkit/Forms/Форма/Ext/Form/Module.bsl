	СвойствоFormName = Новый Структура;
	СвойствоFormName.Вставить("type", "string");
	СвойствоFormName.Вставить("description", "1C form name to open before capture (optional). If omitted, captures the current active 1C window.");
	Свойства.Вставить("form_name", СвойствоFormName);

	СвойствоScale = Новый Структура;
	СвойствоScale.Вставить("type", "integer");
	СвойствоScale.Вставить("default", 100);
	СвойствоScale.Вставить("minimum", 10);
	СвойствоScale.Вставить("maximum", 200);
	СвойствоScale.Вставить("description", "Output image scale (10–200, default 100). Values above 100 produce a larger image with more detail (e.g. 200 = 2× size). Values below 100 produce a smaller image (e.g. 50 = half size). Grid coordinate labels always show original window pixel coordinates regardless of scale.");
	Свойства.Вставить("scale_percent", СвойствоScale);

	СвойствоShowGrid = Новый Структура;
	СвойствоShowGrid.Вставить("type", "boolean");
	СвойствоShowGrid.Вставить("default", Ложь);
	СвойствоShowGrid.Вставить("description", "If true, draws a grid on the screenshot (up to 10×10, dynamic density based on image size — small regions get fewer lines or none): red lines, yellow coordinate labels (px) on black background at each axis, red dots at intersections. Coordinate origin (0, 0) is at the top-left corner of the captured image. Grid line coordinates are also returned as text (grid_coords).");
	Свойства.Вставить("show_grid", СвойствоShowGrid);

	СвойстваРег = Новый Структура;
	СвойстваРег.Вставить("x",      СхемаПолеРегиона(0, "X offset from client-area top-left"));
	СвойстваРег.Вставить("y",      СхемаПолеРегиона(0, "Y offset from client-area top-left"));
	СвойстваРег.Вставить("width",  СхемаПолеРегиона(1, "Width of region"));
	СвойстваРег.Вставить("height", СхемаПолеРегиона(1, "Height of region"));
	МассивRequired = Новый Массив;
	МассивRequired.Добавить("x"); МассивRequired.Добавить("y");
	МассивRequired.Добавить("width"); МассивRequired.Добавить("height");
	СхемаОбъект = Новый Структура;
	СхемаОбъект.Вставить("type", "object");
	СхемаОбъект.Вставить("properties", СвойстваРег);
	СхемаОбъект.Вставить("required", МассивRequired);
	АнйОф = Новый Массив;
	АнйОф.Добавить(СхемаОбъект);
	АнйОф.Добавить(Новый Структура("type", "null"));
	СвойствоРегион = Новый Структура;
	СвойствоРегион.Вставить("anyOf", АнйОф);
	СвойствоРегион.Вставить("description", "Optional. Crop to this sub-region before scaling. Omit or set null for full window. Coordinates in original client-area pixels. Returns error if region is outside window bounds.");
	Свойства.Вставить("region", СвойствоРегион);

	СвойстваРектЭлем = Новый Структура;
	СвойстваРектЭлем.Вставить("x",      СхемаПолеРегиона(0, "X offset from client-area top-left"));
	СвойстваРектЭлем.Вставить("y",      СхемаПолеРегиона(0, "Y offset from client-area top-left"));
	СвойстваРектЭлем.Вставить("width",  СхемаПолеРегиона(1, "Width"));
	СвойстваРектЭлем.Вставить("height", СхемаПолеРегиона(1, "Height"));
	МассивRequiredРект = Новый Массив;
	МассивRequiredРект.Добавить("x"); МассивRequiredРект.Добавить("y");
	МассивRequiredРект.Добавить("width"); МассивRequiredРект.Добавить("height");
	СхемаЭлемРект = Новый Структура;
	СхемаЭлемРект.Вставить("type", "object");
	СхемаЭлемРект.Вставить("properties", СвойстваРектЭлем);
	СхемаЭлемРект.Вставить("required", МассивRequiredРект);
	СхемаМассивРект = Новый Структура;
	СхемаМассивРект.Вставить("type", "array");
	СхемаМассивРект.Вставить("maxItems", 20);
	СхемаМассивРект.Вставить("items", СхемаЭлемРект);
	АнйОфРект = Новый Массив;
	АнйОфРект.Добавить(СхемаМассивРект);
	АнйОфРект.Добавить(Новый Структура("type", "null"));
	СвойствоРекты = Новый Структура;
	СвойствоРекты.Вставить("anyOf", АнйОфРект);
	СвойствоРекты.Вставить("description", "Optional. Draw numbered blue rectangles (3 px, RGB 0,120,255) on the screenshot. Each rectangle is labeled with its 1-based index. Rectangles must not overlap — returns error if they do. Coordinates are in original client-area pixels, origin (0, 0) at the top-left corner of the captured image (same coordinate space as grid labels).");
	Свойства.Вставить("highlight_rects", СвойствоРекты);

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Новый Массив);
	Возврат Схема;
КонецФункции

