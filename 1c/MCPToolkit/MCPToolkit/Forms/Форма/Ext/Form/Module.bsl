&НаСервере
Функция ПроверитьНужноАсинхронноеПодключениеКомпонент()
	// Читаем настройку через Выполнить, чтобы избежать ошибки компиляции на 8.2.x:
	// прямое обращение Метаданные.РежимИспользованияСинхронныхВызовов
	// может не компилироваться на платформах, где это свойство не определено.
	//
	// Значения РежимИспользованияСинхронныхВызовов:
	//   "Использовать"                  — sync ОК, async не нужен
	//   "ИспользоватьСПредупреждениями" — sync пишет предупреждения → лучше async
	//   "НеИспользовать"               — sync ЗАБЛОКИРОВАН → async обязателен
	// Полное имя свойства (из документации ОбъектМетаданныхКонфигурация):
	// РежимИспользованияСинхронныхВызововРасширенийПлатформыИВнешнихКомпонент
	// Доступность: Сервер, толстый клиент, внешнее соединение.
	// Через Выполнить — чтобы не дать compile error на 8.2.x.
	Попытка
		Рез = "";
		Выполнить("Рез = Строка(Метаданные.РежимИспользованияСинхронныхВызововРасширенийПлатформыИВнешнихКомпонент)");
		Возврат Рез <> "Использовать";
	Исключение
		Возврат Ложь; // 8.2.x или старые 8.3.x: свойства нет → синхронный вызов безопасен
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ПолучитьТекстЗапросаLineageИзКоманды(Команда)
	Если Команда = Неопределено Или ТипЗнч(Команда) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ Команда.Свойство("params") Тогда
		Возврат "";
	КонецЕсли;
	ПараметрыКомандыLineage = Команда.params;
	Если ПараметрыКомандыLineage = Неопределено Или ТипЗнч(ПараметрыКомандыLineage) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если ПараметрыКомандыLineage.Свойство("query") Тогда
		Возврат ПараметрыКомандыLineage.query;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Функция НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапроса, Результат)
	Если СокрЛП(ИмяИнструмента) <> "execute_query" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Результат.Свойство("success") Или НЕ Результат.success Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Результат.Свойство("schema") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Результат.schema = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПодключитьКомпонентуLineageСинхронно()
	Если КомпонентаLineage <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		РезLineage = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.MCPToolkit.Макет.QueryLineageAnalyzer",
			"Lineage", ТипВнешнейКомпоненты.Native);
		Если НЕ РезLineage Тогда
			ДвоичныеДанныеLineage = ПолучитьМакетLineageАнализатораНаСервере();
			ИмяФайлаLineage = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанныеLineage.Записать(ИмяФайлаLineage);
			ПодключитьВнешнююКомпоненту(ИмяФайлаLineage, "Lineage", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		КомпонентаLineage = Новый("AddIn.Lineage.QueryLineageAnalyzer");
		Возврат Истина;
	Исключение
		ДобавитьВЛог("Предупреждение: QueryLineageAnalyzer не загружена. " + ОписаниеОшибки());
		КомпонентаLineage = Неопределено;
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ОбогатитьСхемуИсточниками(ТекстЗапроса, Результат)
	Если НЕ НуженLineageДляРезультата("execute_query", ТекстЗапроса, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ ПодключитьКомпонентуLineageСинхронно() Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		СхемаJSONLineage = ЗаписатьJSON2(Результат.schema);
		ОбогащеннаяСхемаJSON = КомпонентаLineage.AnalyzeSources(ТекстЗапроса, СхемаJSONLineage);
		Если ЗначениеЗаполнено(ОбогащеннаяСхемаJSON) Тогда
			Результат.schema = ПрочитатьJSON2(ОбогащеннаяСхемаJSON);
		КонецЕсли;
	Исключение
		ДобавитьВЛог("Предупреждение: ошибка enrichment schema lineage: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура НачатьПодключениеКомпонентыLineage(КонтекстLineage)
	НачатьАсинхронноеПодключениеКомпоненты(
		Новый ОписаниеОповещения("ПослеПодключенияМакетаLineage", ЭтаФорма, КонтекстLineage),
		"ВнешняяОбработка.MCPToolkit.Макет.QueryLineageAnalyzer", "Lineage");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияМакетаLineage(Подключено, ДопПар) Экспорт
	Если Подключено Тогда
		Попытка
			КомпонентаLineage = Новый("AddIn.Lineage.QueryLineageAnalyzer");
			ЗапуститьAsyncLineageАнализ(ДопПар);
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Попытка
		ДвоичныеДанныеLineage = ПолучитьМакетLineageАнализатораНаСервере();
		ИмяФайлаLineage = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанныеLineage.Записать(ИмяФайлаLineage);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияФайлаLineage", ЭтаФорма, ДопПар),
			ИмяФайлаLineage, "Lineage");
	Исключение
		ПродолжитьПослеLineage(ДопПар);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаLineage(Подключено, ДопПар) Экспорт
	Если Подключено Тогда
		Попытка
			КомпонентаLineage = Новый("AddIn.Lineage.QueryLineageAnalyzer");
			ЗапуститьAsyncLineageАнализ(ДопПар);
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	ПродолжитьПослеLineage(ДопПар);
КонецПроцедуры

&НаКлиенте
Процедура НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage)
	Если КомпонентаLineage = Неопределено Тогда
		НачатьПодключениеКомпонентыLineage(КонтекстLineage);
	Иначе
		ЗапуститьAsyncLineageАнализ(КонтекстLineage);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьAsyncLineageАнализ(КонтекстLineage)
	Попытка
		СхемаJSONLineage = ЗаписатьJSON2(КонтекстLineage.Результат.schema);
		КомпонентаLineage.НачатьВызовAnalyzeSources(
			Новый ОписаниеОповещения("ПослеAnalyzeSourcesОбщий", ЭтаФорма, КонтекстLineage),
			КонтекстLineage.ТекстЗапроса, СхемаJSONLineage);
	Исключение
		ПродолжитьПослеLineage(КонтекстLineage);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеAnalyzeSourcesОбщий(РезВызова, ПарВызова, ДопПар) Экспорт
	Попытка
		Если ЗначениеЗаполнено(РезВызова) Тогда
			ДопПар.Результат.schema = ПрочитатьJSON2(РезВызова);
		КонецЕсли;
	Исключение
	КонецПопытки;
	ПродолжитьПослеLineage(ДопПар);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеLineage(КонтекстLineage)
	Если КонтекстLineage.Свойство("Результат") Тогда
		Если ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0
				И ТипЗнч(КонтекстLineage.Результат) = Тип("Структура")
				И КонтекстLineage.Результат.Свойство("data") Тогда
				КонтекстLineage.Результат.Вставить("_original_data_json",
					ЗаписатьJSON2(КонтекстLineage.Результат.data));
				КонтекстLineage.Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			КонтекстLineage.Результат = ПрименитьТочнуюPolicyКРезультатуExecuteQuery(КонтекстLineage.Результат,
				РежимПодключения = 0, ПолучитьНастройкиТочнойАнонимизации());
			Если РежимПодключения <> 0 Тогда
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            КонтекстLineage.Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("КонтекстLineage",       КонтекстLineage);
				АнонимизироватьРезультатВстроенный(КонтекстLineage.Результат, РегексКонтекст);
				ЗапуститьRegexФазу(РегексКонтекст);
				Возврат; // продолжение в ПродолжитьПослеRegex
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Если анонимизация не нужна или режим = 0 — сразу финальная обработка
	ПродолжитьПослеRegexБезКонтекста(КонтекстLineage);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеRegexБезКонтекста(КонтекстLineage)
	Если КонтекстLineage.Свойство("Результат")
		И ТипЗнч(КонтекстLineage.Результат) = Тип("Структура") Тогда
		Если КонтекстLineage.Результат.Свойство("_anon_schema_forced")
			И КонтекстLineage.Результат._anon_schema_forced Тогда
			Попытка КонтекстLineage.Результат.Удалить("schema");               Исключение КонецПопытки;
			Попытка КонтекстLineage.Результат.Удалить("_anon_schema_forced");  Исключение КонецПопытки;
			// _original_data_json НЕ удаляем здесь — нужен для ДобавитьВЛог в proxy-пути (L13001).
			// Downstream-функции (ОтправитьРезультатНаСервер whitelist, ОчиститьВнутренниеПоляPolicy)
			// уберут его до отправки к AI.
			Попытка КонтекстLineage.Результат.Удалить("_blind_anonymization"); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	РежимLineage = "";
	Если КонтекстLineage.Свойство("Режим", РежимLineage) = Ложь Тогда
		Возврат;
	КонецЕсли;

	Если РежимLineage = "proxy" Тогда
		ПродолжитьОтправкуРезультатаПроксиПослеLineage(КонтекстLineage);
	ИначеЕсли РежимLineage = "rest" Тогда
		ПродолжитьRESTОтветПослеLineage(КонтекстLineage);
	ИначеЕсли РежимLineage = "mcp" Тогда
		ПродолжитьMCPОтветПослеLineage(КонтекстLineage);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтправкуРезультатаПроксиПослеLineage(КонтекстLineage)
	РезультатОтправкиLineage = ОтправитьРезультатНаСервер(АдресСервера, КонтекстLineage.КомандаId, КонтекстLineage.Результат);
	Если РезультатОтправкиLineage.Успех Тогда
		ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(КонтекстLineage.Результат));
	Иначе
		ДобавитьВЛог("Ошибка отправки результата: " + РезультатОтправкиLineage.ОписаниеОшибки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьRESTОтветПослеLineage(КонтекстLineage)
	// Точка перехвата: confirm анонимизации до async Toon — иначе при ФорматОтветаВстроенный=1 обходится
	Если ПроверитьПодтверждениеАнонимизации(КонтекстLineage.Результат,
		КонтекстLineage.ДанныеЗапроса, "", "", "rest") Тогда
		Возврат;
	КонецЕсли;

	Если ИспользоватьАсинхронноеПодключениеКомпонент И КомпонентаТун <> Неопределено
		И ФорматОтветаВстроенный = 1 И ТипЗнч(КонтекстLineage.Результат) = Тип("Структура")
		И КонтекстLineage.Результат.Свойство("success") И КонтекстLineage.Результат.success
		И КонтекстLineage.Результат.Свойство("data") Тогда
		КомпонентаТун.НачатьВызовJsonToToon(
			Новый ОписаниеОповещения("ПослеJsonToToonREST", ЭтаФорма,
				Новый Структура("ДанныеЗапроса, Результат", КонтекстLineage.ДанныеЗапроса, КонтекстLineage.Результат)),
			ЗаписатьJSON2(КонтекстLineage.Результат.data));
		Возврат;
	КонецЕсли;

	КонтекстLineage.Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(КонтекстLineage.Результат);
	ПрименитьТунКонвертацию(КонтекстLineage.Результат);
	КомпонентаSendResponse(КонтекстLineage.ДанныеЗапроса.id, 200,
		ЗаголовкиJSON(), ЗаписатьJSON2(КонтекстLineage.Результат));
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьMCPОтветПослеLineage(КонтекстLineage)
	// Точка перехвата C: после lineage/regex async
	Если ПроверитьПодтверждениеАнонимизации(КонтекстLineage.Результат,
		КонтекстLineage.ДанныеЗапроса, КонтекстLineage.Ид, КонтекстLineage.ИдПотока) Тогда
		Возврат;
	КонецЕсли;

	ТулКолРезLineage = СформироватьToolsCallРезультат(
		КонтекстLineage.Результат, КонтекстLineage.ДанныеЗапроса,
		КонтекстLineage.Ид, КонтекстLineage.ИдПотока);
	Если ТулКолРезLineage = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтветJSONLineage = СформироватьJSONRPCОтвет(КонтекстLineage.Ид, ТулКолРезLineage);
	Если ЗначениеЗаполнено(КонтекстLineage.ИдПотока) Тогда
		КомпонентаSendSSEEvent(КонтекстLineage.ИдПотока, ОтветJSONLineage, "{}", "message");
	Иначе
		ОтправитьSSEОтвет(КонтекстLineage.ДанныеЗапроса, ОтветJSONLineage);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьВстроенныйСервер()

	Если НЕ ВстроенныйСерверЗапущен Тогда
		Возврат;
	КонецЕсли;

	// Весь teardown-код ДО вызова Stop
	СнятьВсеЗадания(); // HTTP-вызывающие уже потеряны, задания не должны остаться висеть
	SSEПотоки = Новый Соответствие;
	ЛегасиССЕПотоки = Новый Соответствие;
	МСПСессии = Новый Соответствие;
	ОжидающиеПодтверждения = Новый Соответствие;
	ВстроенныйСерверЗапущен = Ложь;
	АнонимизаторОчистить();
	ОбновитьТаблицуМаппинговВстроенный();
	УстановитьСтатус("Отключено", Ложь);
	ДобавитьВЛог("Встроенный HTTP-сервер остановлен");

	Если Компонента <> Неопределено Тогда
		Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			Компонента.НачатьВызовStop(
				Новый ОписаниеОповещения("ИгнорироватьРезультатКомпоненты", ЭтаФорма));
		Иначе
			Компонента.Stop();
		КонецЕсли;
	КонецЕсли;

	Компонента = Неопределено;
	КомпонентаТун = Неопределено;

КонецПроцедуры

// Пустой колбэк для fire-and-forget вызовов компоненты
&НаКлиенте
Процедура ИгнорироватьРезультатКомпоненты(РезВызова, ПарВызова, ДопПар) Экспорт
КонецПроцедуры

// ═══════════════════════════════════════════════════════════════════════════════
// ВЫБОР АДРЕСА ПРИВЯЗКИ ВСТРОЕННОГО СЕРВЕРА
// ═══════════════════════════════════════════════════════════════════════════════

// ── Персистентность: одна версионированная запись в хранилище настроек ──

&НаСервереБезКонтекста
Функция ПрочитатьВыборАдресаВстроенногоСервераССервера()
	// Возвращает Структуру {Присутствует, Значение}, чтобы клиент мог отличить
	// «ключа нет вообще» (первый запуск → 0.0.0.0) от «запись есть, но невалидна/нечитаема»
	// (fail-closed → 127.0.0.1). Нельзя сводить оба случая к Неопределено.
	Результат = Новый Структура("Присутствует, Значение", Ложь, Неопределено);
	Попытка
		Значение = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ВыборАдресаВстроенногоСервера");
		Если Значение <> Неопределено Тогда
			Результат.Присутствует = Истина;
			Результат.Значение = Значение;
		КонецЕсли;
	Исключение
		// Ошибка чтения — считаем «присутствует, но нечитаемо» (fail-closed, не первый запуск)
		Результат.Присутствует = Истина;
		Результат.Значение = Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьВыборАдресаВстроенногоСервераНаСервере(ЗначениеJSON)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ВыборАдресаВстроенногоСервера", ЗначениеJSON);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция СериализоватьВыборАдреса(Выбор)
	// Проектный сериализатор (совместим с 8.2.13, в отличие от платформенного ЗаписьJSON/ЗаписатьJSON)
	Возврат ЗаписатьJSON2(Выбор);
КонецФункции

&НаКлиенте
Функция ДефолтВыбораАдреса()
	Выбор = Новый Структура;
	Выбор.Вставить("version", 1);
	Выбор.Вставить("kind", "all");
	Выбор.Вставить("interfaceId", "");
	Выбор.Вставить("displayName", "");
	Выбор.Вставить("lastAddress", "0.0.0.0");
	Возврат Выбор;
КонецФункции

&НаКлиенте
Функция ВыборАдресаНевалиден()
	Выбор = Новый Структура;
	Выбор.Вставить("version", 1);
	Выбор.Вставить("kind", "invalid");
	Выбор.Вставить("interfaceId", "");
	Выбор.Вставить("displayName", "");
	Выбор.Вставить("lastAddress", "127.0.0.1");
	Возврат Выбор;
КонецФункции

&НаКлиенте
Функция ВыборАдресаВалиден(Выбор)
	Если ТипЗнч(Выбор) <> Тип("Структура") Тогда Возврат Ложь; КонецЕсли;
	Если НЕ Выбор.Свойство("version") ИЛИ Выбор.version <> 1 Тогда Возврат Ложь; КонецЕсли;
	Если НЕ Выбор.Свойство("kind") ИЛИ ТипЗнч(Выбор.kind) <> Тип("Строка") Тогда Возврат Ложь; КонецЕсли;
	Если Выбор.kind <> "all" И Выбор.kind <> "loopback" И Выбор.kind <> "interface" Тогда
		Возврат Ложь;
	КонецЕсли;
	// Обязательные поля должны быть строками (недоверенный JSON из хранилища мог прийти с массивами и т.п.)
	Если НЕ Выбор.Свойство("interfaceId") ИЛИ ТипЗнч(Выбор.interfaceId) <> Тип("Строка")
		ИЛИ НЕ Выбор.Свойство("displayName") ИЛИ ТипЗнч(Выбор.displayName) <> Тип("Строка")
		ИЛИ НЕ Выбор.Свойство("lastAddress") ИЛИ ТипЗнч(Выбор.lastAddress) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Загрузка канонического выбора в клиентском ПриОткрытии (различаем отсутствие и невалидность)
&НаКлиенте
Процедура ЗагрузитьВыборАдресаВстроенногоСервера()
	Инфо = ПрочитатьВыборАдресаВстроенногоСервераССервера();
	Если НЕ Инфо.Присутствует Тогда
		// Ключа нет — доказанный первый запуск, дефолт 0.0.0.0 (совместимость)
		ВыборАдресаВстроенногоСервера = ДефолтВыбораАдреса();
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Инфо.Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Инфо.Значение) Тогда
		// Запись есть, но не строка / нечитаема — fail-closed, исходную запись НЕ перезаписываем
		ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
		Возврат;
	КонецЕсли;
	Попытка
		Разобранный = ПрочитатьJSON2(Инфо.Значение);
		Если ВыборАдресаВалиден(Разобранный) Тогда
			ВыборАдресаВстроенногоСервера = Разобранный;
		Иначе
			// Запись есть, но невалидна — fail-closed, исходную запись НЕ перезаписываем
			ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
		КонецЕсли;
	Исключение
		ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
	КонецПопытки;
КонецПроцедуры

// ── Список адресов выпадающего поля ──
// GetLocalAddresses — метод уже существующей компоненты MCPHttp. Список наполняется при показе
// группы и по кнопке ⟳: базовый список (искусственные пункты + сохранённый) показывается сразу без
// компоненты, затем реальные интерфейсы подтягиваются веткой async/sync (как GetRequestBody).

&НаКлиенте
Процедура КомандаОбновитьАдреса(Команда)
	ОбновитьСписокАдресов();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокАдресов()
	ПостроитьБазовыйСписокАдресов(); // мгновенно, без компоненты — выпадающий список не пуст
	// Реальные интерфейсы: компонента переиспользуется, если уже загружена, иначе грузим как везде
	Если Компонента <> Неопределено Тогда
		ПолучитьАдресаИПостроить();
	ИначеЕсли ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПодключенияМСП", ЭтаФорма),
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport", "MCPHttp");
	ИначеЕсли ПодключитьMCPHttpСинхронно() Тогда
		ПолучитьАдресаИПостроить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПодключенияМСП(Подключено, ДопПар) Экспорт
	Если Компонента <> Неопределено Тогда // уже загружена (напр. запуском сервера) — не пересоздаём
		ПолучитьАдресаИПостроить();
		Возврат;
	КонецЕсли;
	Если Подключено Тогда
		Попытка
			Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
			ПолучитьАдресаИПостроить();
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Fallback: .dll из макета через файл
	Попытка
		ДвоичныеДанные = ПолучитьМакетНаСервере();
		ИмяФайла = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ИмяФайла);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПодключенияФайлаМСП", ЭтаФорма),
			ИмяФайла, "MCPHttp");
	Исключение
		ДобавитьВЛог("Не удалось подключить MCPHttp для списка адресов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПодключенияФайлаМСП(Подключено, ДопПар) Экспорт
	Если Компонента <> Неопределено Тогда // уже загружена — не пересоздаём
		ПолучитьАдресаИПостроить();
		Возврат;
	КонецЕсли;
	Если Подключено Тогда
		Попытка
			Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
			ПолучитьАдресаИПостроить();
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	ДобавитьВЛог("Не удалось подключить внешнюю компоненту MCPHttp для списка адресов");
КонецПроцедуры

&НаКлиенте
Функция ПодключитьMCPHttpСинхронно()
	Попытка
		Рез = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport", "MCPHttp", ТипВнешнейКомпоненты.Native);
		Если НЕ Рез Тогда
			ДвоичныеДанные = ПолучитьМакетНаСервере();
			ИмяФайла = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ИмяФайла);
			ПодключитьВнешнююКомпоненту(ИмяФайла, "MCPHttp", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
	Исключение
		ДобавитьВЛог("Ошибка загрузки компоненты MCPHttp: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

// GetLocalAddresses — метод существующей компоненты. Ветка async/sync (как GetRequestBody).
&НаКлиенте
Процедура ПолучитьАдресаИПостроить()
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		Компонента.НачатьВызовПолучитьЛокальныеАдреса(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПолученияАдресов", ЭтаФорма));
		Возврат;
	КонецЕсли;
	Джсон = "";
	Попытка
		Джсон = Компонента.ПолучитьЛокальныеАдреса();
	Исключение
		ДобавитьВЛог("Ошибка получения списка адресов: " + ОписаниеОшибки());
	КонецПопытки;
	ЗаполнитьСписокАдресов_Построить(Джсон);
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПолученияАдресов(РезВызова, ПарВызова, ДопПар) Экспорт
	ЗаполнитьСписокАдресов_Построить(?(РезВызова = Неопределено, "", РезВызова));
КонецПроцедуры

// Синхронный базовый список без загрузки компоненты: искусственные пункты + сохранённый интерфейс.
// Гарантирует непустой выпадающий список при показе группы; реальные интерфейсы — по кнопке ⟳.
&НаКлиенте
Процедура ПостроитьБазовыйСписокАдресов()
	СписокВыбора = Элементы.ПолеАдресВстроенногоСервера.СписокВыбора;
	СписокВыбора.Очистить();
	КэшАдресовВстроенногоСервера = Новый Соответствие;

	КэшАдресовВстроенногоСервера.Вставить("all",
		Новый Структура("kind,interfaceId,address,displayName", "all", "", "0.0.0.0", "Все интерфейсы"));
	СписокВыбора.Добавить("all", "0.0.0.0 — все интерфейсы");
	КэшАдресовВстроенногоСервера.Вставить("loopback",
		Новый Структура("kind,interfaceId,address,displayName", "loopback", "", "127.0.0.1", "Только локально"));
	СписокВыбора.Добавить("loopback", "127.0.0.1 — только локально");

	Выбор = ВыборАдресаВстроенногоСервера;
	Если Выбор <> Неопределено И Выбор.kind = "interface" Тогда
		КэшАдресовВстроенногоСервера.Вставить("saved",
			Новый Структура("kind,interfaceId,address,displayName",
				"interface", Выбор.interfaceId, Выбор.lastAddress, Выбор.displayName));
		СписокВыбора.Добавить("saved", Выбор.lastAddress + " (" + Выбор.displayName + ")");
	КонецЕсли;

	УстановитьОтображениеВыбораАдреса();
КонецПроцедуры

// Строит СписокВыбора из JSON адресов (all/loopback + реальные интерфейсы) и обновляет отображение.
&НаКлиенте
Процедура ЗаполнитьСписокАдресов_Построить(ДжейсонАдресов)
	СписокВыбора = Элементы.ПолеАдресВстроенногоСервера.СписокВыбора;
	СписокВыбора.Очистить();
	КэшАдресовВстроенногоСервера = Новый Соответствие;

	// Искусственные пункты (компонента их не отдаёт)
	КэшАдресовВстроенногоСервера.Вставить("all",
		Новый Структура("kind,interfaceId,address,displayName", "all", "", "0.0.0.0", "Все интерфейсы"));
	СписокВыбора.Добавить("all", "0.0.0.0 — все интерфейсы");
	КэшАдресовВстроенногоСервера.Вставить("loopback",
		Новый Структура("kind,interfaceId,address,displayName", "loopback", "", "127.0.0.1", "Только локально"));
	СписокВыбора.Добавить("loopback", "127.0.0.1 — только локально");

	// Реальные IPv4-адреса от компоненты
	Адреса = Новый Массив;
	Если НЕ ПустаяСтрока(ДжейсонАдресов) Тогда
		Попытка
			Адреса = ПрочитатьJSON2(ДжейсонАдресов);
		Исключение
			ДобавитьВЛог("Ошибка разбора списка адресов: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Индекс = 0;
	Для Каждого А Из Адреса Цикл
		Ключ = "iface_" + Формат(Индекс, "ЧГ=");
		Индекс = Индекс + 1;
		КэшАдресовВстроенногоСервера.Вставить(Ключ,
			Новый Структура("kind,interfaceId,address,displayName", "interface", А.id, А.address, А.displayName));
		СписокВыбора.Добавить(Ключ, А.address + " (" + А.displayName + ")");
	КонецЦикла;

	УстановитьОтображениеВыбораАдреса();
КонецПроцедуры

// Установить отображаемый ключ в поле по каноническому выбору (отображение отделено от канонического значения)
&НаКлиенте
Процедура УстановитьОтображениеВыбораАдреса()
	Выбор = ВыборАдресаВстроенногоСервера;
	Если Выбор = Неопределено Тогда
		АдресВстроенногоСервераОтображение = "all";
		Возврат;
	КонецЕсли;
	Если Выбор.kind = "all" Тогда
		АдресВстроенногоСервераОтображение = "all";
	ИначеЕсли Выбор.kind = "loopback" Тогда
		АдресВстроенногоСервераОтображение = "loopback";
	ИначеЕсли Выбор.kind = "interface" Тогда
		НайденныйКлюч = НайтиКлючИнтерфейса(Выбор.interfaceId, Выбор.lastAddress);
		Если НайденныйКлюч <> Неопределено Тогда
			АдресВстроенногоСервераОтображение = НайденныйКлюч;
		Иначе
			// Интерфейс недоступен — нередактируемый пункт только для отображения (не для выбора)
			Элементы.ПолеАдресВстроенногоСервера.СписокВыбора.Добавить("unavailable",
				?(ПустаяСтрока(Выбор.displayName), Выбор.interfaceId, Выбор.displayName) + " — интерфейс недоступен");
			АдресВстроенногоСервераОтображение = "unavailable";
		КонецЕсли;
	Иначе
		// invalid — визуальный дефолт, канонический выбор НЕ трогаем (резолвер уйдёт на 127.0.0.1)
		АдресВстроенногоСервераОтображение = "all";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция НайтиКлючИнтерфейса(ИдИнтерфейса, ПредпочтительныйАдрес)
	КлючПоАдресу = Неопределено;
	КлючПоИнтерфейсу = Неопределено;
	Для Каждого КлючЗначение Из КэшАдресовВстроенногоСервера Цикл
		Зап = КлючЗначение.Значение;
		Если Зап.kind = "interface" И Зап.interfaceId = ИдИнтерфейса Тогда
			Если КлючПоИнтерфейсу = Неопределено Тогда
				КлючПоИнтерфейсу = КлючЗначение.Ключ;
			КонецЕсли;
			Если Зап.address = ПредпочтительныйАдрес Тогда
				КлючПоАдресу = КлючЗначение.Ключ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(КлючПоАдресу <> Неопределено, КлючПоАдресу, КлючПоИнтерфейсу);
КонецФункции

// Обработчик изменения поля (выбор из выпадающего списка): восстановить выбор из кэша по ключу
&НаКлиенте
Процедура АдресВстроенногоСервераПриИзменении(Элемент)
	ПрименитьВыборАдреса(АдресВстроенногоСервераОтображение, Истина);
КонецПроцедуры

// [++]  Пак И.О. 23.08.2026 OS-84818 / Разработать механизм ввода начальных остатков для витрины
// ЛОКАЛЬНАЯ ПРАВКА (ветка local/request-timeout-900), в оригинале этих двух процедур нет.
// Таймаут ожидания ответа компоненты. В поставке он равен 180 с и нигде не выставляется,
// из-за чего долгий запрос отдает клиенту 504, хотя в 1С продолжает считаться и досчитывается.
&НаКлиенте
Процедура ПолеТаймаутЗапросаПриИзменении(Элемент)
	Если ТаймаутЗапросаСек <= 0 Тогда
		ТаймаутЗапросаСек = 180;
	КонецЕсли;

	СохранитьТаймаутЗапросаНаСервере(ТаймаутЗапросаСек);
	ПрименитьТаймаутЗапроса();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьТаймаутЗапросаНаСервере(Знач Значение)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ТаймаутЗапросаСек", Значение);
	Исключение
		// Ошибка сохранения настроек: на работу текущего сеанса не влияет
	КонецПопытки;
КонецПроцедуры

// Свойство компоненты атомарное и читается на каждом запросе, поэтому применяется
// и к уже запущенному серверу — перезапускать его не нужно.
&НаКлиенте
Процедура ПрименитьТаймаутЗапроса()
	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Компонента.RequestTimeout = ТаймаутЗапросаСек;
	ДобавитьВЛог("Таймаут ожидания ответа: " + Формат(Компонента.RequestTimeout, "ЧГ=") + " с");
КонецПроцедуры
// [--] Пак И.О. 23.08.2026

// Применить выбранный ключ: собрать каноническую запись из кэша и сохранить.
// ВосстановитьПриНеизвестном=Истина — откатить отображение на канонический выбор (защита от ручного ввода мусора).
&НаКлиенте
Процедура ПрименитьВыборАдреса(Ключ, ВосстановитьПриНеизвестном)
	Зап = КэшАдресовВстроенногоСервера.Получить(Ключ);
	Если Зап = Неопределено Тогда
		Если ВосстановитьПриНеизвестном Тогда
			УстановитьОтображениеВыбораАдреса();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	НовыйВыбор = Новый Структура;
	НовыйВыбор.Вставить("version", 1);
	НовыйВыбор.Вставить("kind", Зап.kind);
	НовыйВыбор.Вставить("interfaceId", Зап.interfaceId);
	НовыйВыбор.Вставить("displayName", Зап.displayName);
	НовыйВыбор.Вставить("lastAddress", Зап.address);
	ВыборАдресаВстроенногоСервера = НовыйВыбор;
	СохранитьВыборАдресаВстроенногоСервераНаСервере(СериализоватьВыборАдреса(НовыйВыбор));
КонецПроцедуры

// ── Резолв bind-адреса: читает ТОЛЬКО канонический выбор ──

// Чистый расчёт bind-адреса по каноническому выбору и JSON списка адресов (без вызова компоненты)
&НаКлиенте
Функция ВычислитьАдресПривязки(Выбор, ДжейсонАдресов)
	Если Выбор = Неопределено Тогда
		Возврат "0.0.0.0";
	КонецЕсли;
	Если Выбор.kind = "all" Тогда
		Возврат "0.0.0.0";
	ИначеЕсли Выбор.kind = "loopback" Тогда
		Возврат "127.0.0.1";
	ИначеЕсли Выбор.kind = "invalid" Тогда
		ДобавитьВЛог("Сохранённый выбор адреса невалиден, bind на 127.0.0.1");
		Возврат "127.0.0.1";
	КонецЕсли;
	// kind = interface — резолв: сохранённый адрес → единственный текущий → откат на loopback
	АдресаИнтерфейса = Новый Массив;
	Если НЕ ПустаяСтрока(ДжейсонАдресов) Тогда
		Попытка
			Адреса = ПрочитатьJSON2(ДжейсонАдресов);
			Для Каждого А Из Адреса Цикл
				Если А.id = Выбор.interfaceId Тогда
					АдресаИнтерфейса.Добавить(А.address);
				КонецЕсли;
			КонецЦикла;
		Исключение
			ДобавитьВЛог("Ошибка разбора адресов, bind на 127.0.0.1: " + ОписаниеОшибки());
			Возврат "127.0.0.1";
		КонецПопытки;
	КонецЕсли;
	Если АдресаИнтерфейса.Найти(Выбор.lastAddress) <> Неопределено Тогда
		Возврат Выбор.lastAddress; // точный осознанный выбор (в т.ч. интерфейс с несколькими IPv4)
	ИначеЕсли АдресаИнтерфейса.Количество() = 1 Тогда
		Возврат АдресаИнтерфейса[0]; // DHCP-переезд на том же интерфейсе
	Иначе
		ДобавитьВЛог("Сохранённый интерфейс " + Выбор.displayName + " недоступен/неоднозначен, bind на 127.0.0.1");
		Возврат "127.0.0.1";
	КонецЕсли;
КонецФункции

// Синхронный резолв (для sync-платформ и для не-interface выбора — без вызова компоненты)
&НаКлиенте
Функция ОпределитьАдресПривязкиСинхронно()
	Выбор = ВыборАдресаВстроенногоСервера;
	ДжейсонАдресов = "";
	Если Выбор <> Неопределено И Выбор.kind = "interface" И Компонента <> Неопределено Тогда
		Попытка
			ДжейсонАдресов = Компонента.ПолучитьЛокальныеАдреса();
		Исключение
			ДобавитьВЛог("Ошибка получения списка адресов: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Возврат ВычислитьАдресПривязки(Выбор, ДжейсонАдресов);
КонецФункции

