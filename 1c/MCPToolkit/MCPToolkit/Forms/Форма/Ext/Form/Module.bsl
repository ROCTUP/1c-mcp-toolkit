&НаКлиенте
Процедура АнонимизаторИнициализировать()

	Если МаппингАнонимизации = Неопределено Тогда
		МаппингАнонимизации   = Новый Соответствие;
	КонецЕсли;
	Если МаппингДеанонимизации = Неопределено Тогда
		МаппингДеанонимизации = Новый Соответствие;
	КонецЕсли;
	Если СчетчикиТокенов = Неопределено Тогда
		СчетчикиТокенов       = Новый Соответствие;
	КонецЕсли;
	Если СловарьАнонимизации = Неопределено Тогда
		СловарьАнонимизации   = Новый Массив;
	КонецЕсли;
	Если БакетИндексСловаря = Неопределено Тогда
		БакетИндексСловаря    = Новый Соответствие;
	КонецЕсли;
	Если СловарьПостроен = Неопределено Тогда
		СловарьПостроен       = Ложь;
	КонецЕсли;
	Если ОчередьВставки = Неопределено Тогда
		ОчередьВставки        = Новый Массив;
	КонецЕсли;
	Если ГоловаОчереди = Неопределено Тогда
		ГоловаОчереди         = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АнонимизаторОчистить()

	МаппингАнонимизации   = Новый Соответствие;
	МаппингДеанонимизации = Новый Соответствие;
	СчетчикиТокенов       = Новый Соответствие;
	СловарьАнонимизации   = Новый Массив;
	БакетИндексСловаря    = Новый Соответствие;
	СловарьПостроен       = Ложь;
	ОчередьВставки        = Новый Массив;
	ГоловаОчереди         = 0;
	Элементы.НадписьКоличествоЗаписейСловаря.Заголовок = "";

КонецПроцедуры

&НаКлиенте
Функция АнонимизаторТокенизировать(Значение, Категория)

	АнонимизаторИнициализировать();

	СуществующийТокен = МаппингАнонимизации.Получить(Значение);
	Если СуществующийТокен <> Неопределено Тогда
		Возврат СуществующийТокен;
	КонецЕсли;

	Счётчик = СчетчикиТокенов.Получить(Категория);
	Если Счётчик = Неопределено Тогда
		Счётчик = 0;
	КонецЕсли;
	Счётчик = Счётчик + 1;
	СчетчикиТокенов.Вставить(Категория, Счётчик);

	Токен = "[" + Категория + "-" + Формат(Счётчик, "ЧЦ=5; ЧВН=; ЧН=0; ЧГ=0") + "]";
	МаппингАнонимизации.Вставить(Значение, Токен);
	МаппингДеанонимизации.Вставить(ВРег(Токен), Значение);
	// Только копим порядок вставки; вытеснение — на границе запроса (АнонимизаторВытеснитьДоЛимита),
	// иначе крупный ответ вытеснил бы собственные токены до отдачи агенту.
	ОчередьВставки.Добавить(Значение);

	Возврат Токен;

КонецФункции

// Вытеснение старых пар до ЛимитМаппингаВстроенный (мягкий лимит, FIFO).
// Вызывается на границе запроса ПОСЛЕ детокенизации входящих параметров
// (см. ДеАнонимизироватьПараметрыКомандыИВытеснить), не во время построения ответа.
// Использует индекс головы вместо Удалить(0) в цикле (иначе O(n^2) сдвиг хвоста массива).
// СчетчикиТокенов НЕ сбрасываем — иначе коллизии номеров у выживших токенов.
&НаКлиенте
Процедура АнонимизаторВытеснитьДоЛимита()

	АнонимизаторИнициализировать();

	Если ЛимитМаппингаВстроенный <= 0 Тогда
		Возврат;
	КонецЕсли;

	Пока МаппингАнонимизации.Количество() > ЛимитМаппингаВстроенный
	      И ГоловаОчереди < ОчередьВставки.Количество() Цикл
		СтароеЗначение = ОчередьВставки[ГоловаОчереди];
		ГоловаОчереди  = ГоловаОчереди + 1;   // сдвигаем голову, массив не трогаем
		СтарыйТокен = МаппингАнонимизации.Получить(СтароеЗначение);
		МаппингАнонимизации.Удалить(СтароеЗначение);
		Если СтарыйТокен <> Неопределено Тогда
			МаппингДеанонимизации.Удалить(ВРег(СтарыйТокен));
		КонецЕсли;
	КонецЦикла;

	// Редкая компактизация: срезаем «съеденный» префикс за один проход,
	// только когда он большой (амортизированно линейно).
	Если ГоловаОчереди > 1000 И ГоловаОчереди * 2 > ОчередьВставки.Количество() Тогда
		НовыйМассив = Новый Массив;
		Для Инд = ГоловаОчереди По ОчередьВставки.Количество() - 1 Цикл
			НовыйМассив.Добавить(ОчередьВставки[Инд]);
		КонецЦикла;
		ОчередьВставки = НовыйМассив;
		ГоловаОчереди  = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЭтоВалидныйТокенФормат(Строка)

	// Формат: [CATEGORY-NNNNN] — буквы, дефис, минимум 5 цифр (счётчик > 99999 даёт > 5 знаков)
	Длина = СтрДлина(Строка);
	Если Длина < 9 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Лев(Строка, 1) <> "[" Или Прав(Строка, 1) <> "]" Тогда
		Возврат Ложь;
	КонецЕсли;
	Внутренняя = Сред(Строка, 2, Длина - 2);
	ПозицияДефиса = Найти(Внутренняя, "-");
	Если ПозицияДефиса < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	ЧастьКатегории = Лев(Внутренняя, ПозицияДефиса - 1);
	ЧастьНомера    = Сред(Внутренняя, ПозицияДефиса + 1);
	Если СтрДлина(ЧастьНомера) < 5 Тогда // минимум 5 цифр — счётчик > 99999 будет > 5 знаков
		Возврат Ложь;
	КонецЕсли;
	// категория — только буквы
	Для Инд = 1 По СтрДлина(ЧастьКатегории) Цикл
		СимВРег = ВРег(Сред(ЧастьКатегории, Инд, 1));
		КодСим  = КодСимвола(СимВРег);
		Если КодСим < 65 Или КодСим > 90 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	// номер — только цифры
	Для Инд = 1 По СтрДлина(ЧастьНомера) Цикл
		КодСим = КодСимвола(Сред(ЧастьНомера, Инд, 1));
		Если КодСим < 48 Или КодСим > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция АнонимизаторДеТокенизироватьСтроку(Текст)

	АнонимизаторИнициализировать();

	Если МаппингДеанонимизации.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = "";
	Позиция   = 1;
	Длина     = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		ПозОткр = Найти(Сред(Текст, Позиция), "[");
		Если ПозОткр = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;
		ПозОткр = Позиция + ПозОткр - 1;
		Результат = Результат + Сред(Текст, Позиция, ПозОткр - Позиция);

		ПозЗакр = Найти(Сред(Текст, ПозОткр), "]");
		Если ПозЗакр = 0 Тогда
			Результат = Результат + Сред(Текст, ПозОткр);
			Прервать;
		КонецЕсли;
		ПозЗакр = ПозОткр + ПозЗакр - 1;

		Кандидат = Сред(Текст, ПозОткр, ПозЗакр - ПозОткр + 1);
		Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
			Оригинал = МаппингДеанонимизации.Получить(ВРег(Кандидат));
			Если Оригинал <> Неопределено Тогда
				Результат = Результат + Оригинал;
			Иначе
				Результат = Результат + Кандидат;
			КонецЕсли;
		Иначе
			Результат = Результат + Кандидат;
		КонецЕсли;

		Позиция = ПозЗакр + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция АнонимизаторАнонимизироватьСтроку(Текст)

	АнонимизаторИнициализировать();

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	// Шаг 1: словарь — организации, физлица (с границами слов, создаёт новые токены)
	// Если ИспользоватьТочнуюАнонимизацию выключена — функция вернёт текст без изменений
	Результат = ПрименитьСловарьКСтроке(Текст);

	// Шаг 2: regex-паттерны (ИНН, телефон, email и т.д.)
	Если КомпонентаRegexНедоступна = Истина Тогда
		Возврат Результат;
	КонецЕсли;
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") И Правило.enabled = Истина Тогда
			ВключённыеПравила.Добавить(Новый Структура("pattern, category",
				Правило.pattern, Правило.category));
		КонецЕсли;
	КонецЦикла;
	Если ВключённыеПравила.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если КомпонентаRegex = Неопределено Тогда
		ПодключитьКомпонентуRegexСинхронно();
	КонецЕсли;
	Если КомпонентаRegex = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ПравилаJSON  = ЗаписатьJSON2(ВключённыеПравила);
	ТекстыМассив = Новый Массив;
	ТекстыМассив.Добавить(Результат);
	ТекстыJSON   = ЗаписатьJSON2(ТекстыМассив);
	СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(ПравилаJSON, ТекстыJSON);

	Возврат ПрименитьRegexТокеныКСтроке(Результат, СовпаденияJSON);

КонецФункции

