КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаLineage(Подключено, ДопПар) Экспорт
	Если Подключено Тогда
		Попытка
			КомпонентаLineage = Новый("AddIn.Lineage.QueryLineageAnalyzer");
			ПродолжитьПослеПодключенияLineage(ДопПар, Истина);
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	ПродолжитьПослеПодключенияLineage(ДопПар, Ложь);
КонецПроцедуры

// Продолжение после асинхронного подключения компоненты lineage. Контекст с полем ПродолжениеПодключения
// (проверка строгого режима) передается названному в нем обработчику; без этого поля - прежнее продолжение
// lineage: анализ источников, если компонента подключена, иначе обработка результата без него.
//
// Параметры:
//  ДопПар - Структура - контекст lineage или контекст проверки строгого режима
//  Подключена - Булево - объект компоненты создан
//
&НаКлиенте
Процедура ПродолжитьПослеПодключенияLineage(ДопПар, Подключена)

	Продолжение = Неопределено;

	Если ТипЗнч(ДопПар) = Тип("Структура") И ДопПар.Свойство("ПродолжениеПодключения", Продолжение)
		И Продолжение = "ПослеПодключенияLineageСтрогий" Тогда

		ПослеПодключенияLineageСтрогий(ДопПар, Подключена);

	ИначеЕсли Подключена Тогда

		ЗапуститьAsyncLineageАнализ(ДопПар);

	Иначе

		ПродолжитьПослеLineage(ДопПар);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage)
	Если КомпонентаLineage = Неопределено Тогда
		НачатьПодключениеКомпонентыLineage(КонтекстLineage);
	Иначе
		ЗапуститьAsyncLineageАнализ(КонтекстLineage);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьAsyncLineageАнализ(КонтекстLineage)
	Попытка
		СхемаJSONLineage = ЗаписатьJSON2(КонтекстLineage.Результат.schema);
		КомпонентаLineage.НачатьВызовAnalyzeSources(
			Новый ОписаниеОповещения("ПослеAnalyzeSourcesОбщий", ЭтаФорма, КонтекстLineage),
			КонтекстLineage.ТекстЗапроса, СхемаJSONLineage);
	Исключение
		ПродолжитьПослеLineage(КонтекстLineage);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеAnalyzeSourcesОбщий(РезВызова, ПарВызова, ДопПар) Экспорт
	Попытка
		Если ЗначениеЗаполнено(РезВызова) Тогда
			ДопПар.Результат.schema = ПрочитатьJSON2(РезВызова);
		КонецЕсли;
	Исключение
	КонецПопытки;
	ПродолжитьПослеLineage(ДопПар);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеLineage(КонтекстLineage)

	Если ОбработкаОтклоненаПоЭпохе(КонтекстLineage) Тогда

		ЗавершитьПараллельнуюДоставку(КонтекстLineage);

		Возврат;

	КонецЕсли;

	Если КонтекстLineage.Свойство("Результат") Тогда
		Если ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0
				И ТипЗнч(КонтекстLineage.Результат) = Тип("Структура")
				И КонтекстLineage.Результат.Свойство("data") Тогда
				КонтекстLineage.Результат.Вставить("_original_data_json",
					ЗаписатьJSON2(КонтекстLineage.Результат.data));
				КонтекстLineage.Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			КонтекстLineage.Результат = ПрименитьТочнуюPolicyКРезультатуExecuteQuery(КонтекстLineage.Результат, РежимПодключения = 0);
			Если РежимПодключения <> 0 Тогда
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            КонтекстLineage.Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("КонтекстLineage",       КонтекстLineage);
				АнонимизироватьРезультатВстроенный(КонтекстLineage.Результат, РегексКонтекст);
				ЗапуститьRegexФазу(РегексКонтекст);
				Возврат; // продолжение в ПродолжитьПослеRegex
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Если анонимизация не нужна или режим = 0 — сразу финальная обработка
	ПродолжитьПослеRegexБезКонтекста(КонтекстLineage);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеRegexБезКонтекста(КонтекстLineage)
	Если КонтекстLineage.Свойство("Результат")
		И ТипЗнч(КонтекстLineage.Результат) = Тип("Структура") Тогда
		Если КонтекстLineage.Результат.Свойство("_anon_schema_forced")
			И КонтекстLineage.Результат._anon_schema_forced Тогда
			Попытка КонтекстLineage.Результат.Удалить("schema");               Исключение КонецПопытки;
			Попытка КонтекстLineage.Результат.Удалить("_anon_schema_forced");  Исключение КонецПопытки;
			// _original_data_json НЕ удаляем здесь — нужен для ДобавитьВЛог в proxy-пути (L13001).
			// Downstream-функции (ОтправитьРезультатНаСервер whitelist, ОчиститьВнутренниеПоляPolicy)
			// уберут его до отправки к AI.
			Попытка КонтекстLineage.Результат.Удалить("_blind_anonymization"); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Если КонтекстLineage.Свойство("ИдПараллельнойОперации") Тогда
		ЗавершитьАнонимизациюПараллельногоОтвета(КонтекстLineage);
		Возврат;
	КонецЕсли;
	РежимLineage = "";
	Если КонтекстLineage.Свойство("Режим", РежимLineage) = Ложь Тогда
		Возврат;
	КонецЕсли;

	Если РежимLineage = "proxy" Тогда
		ПродолжитьОтправкуРезультатаПроксиПослеLineage(КонтекстLineage);
	ИначеЕсли РежимLineage = "rest" Тогда
		ПродолжитьRESTОтветПослеLineage(КонтекстLineage);
	ИначеЕсли РежимLineage = "mcp" Тогда
		ПродолжитьMCPОтветПослеLineage(КонтекстLineage);
	КонецЕсли;
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ОТПРАВКА РЕЗУЛЬТАТОВ КОМАНД
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция ПоколениеКонтекстаАктуально(Контекст)
	// Старые маршруты без маркера актуальности — поведение прежнее
	Если ТипЗнч(Контекст) <> Тип("Структура") ИЛИ НЕ Контекст.Свойство("ПоколениеПодключения") Тогда
		Возврат Истина;
	КонецЕсли;
	Если Контекст.Свойство("Режим") И Контекст.Режим = "proxy" Тогда
		Возврат Контекст.ПоколениеПодключения = ПоколениеПодключенияПрокси;
	Иначе
		Возврат Контекст.ПоколениеПодключения = ПоколениеПодключенияСервер;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ОтправитьРезультатКомандыПрокси(Контекст, Результат)
	Если НЕ ПодготовитьВыдачуПараллельногоОтвета(Контекст, Результат) Тогда Возврат; КонецЕсли;
	АдресРезультата = АдресСервера;
	Если Контекст.Свойство("АдресПрокси") И ЗначениеЗаполнено(Контекст.АдресПрокси) Тогда
		АдресРезультата = Контекст.АдресПрокси;
	КонецЕсли;
	КаналДоставки = Неопределено;
	Контекст.Свойство("КаналПрокси", КаналДоставки);
	РезультатОтправки = ОтправитьРезультатНаСервер(АдресРезультата, Контекст.КомандаId, Результат, КаналДоставки, , Контекст);
	Если РезультатОтправки.Успех Тогда
		ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	Иначе
		ДобавитьВЛог("Ошибка отправки результата: " + РезультатОтправки.ОписаниеОшибки);
	КонецЕсли;
	ЗавершитьПараллельнуюДоставку(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьРезультатКомандыREST(Контекст, Знач Результат)
	Если НЕ ПодготовитьВыдачуПараллельногоОтвета(Контекст, Результат) Тогда Возврат; КонецЕсли;
	Результат = РезультатСИсточникомБазы(Результат, Контекст);
	Если ИспользоватьАсинхронноеПодключениеКомпонент И КомпонентаТун <> Неопределено
		И ФорматОтветаВстроенный = 1 И ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("success") И Результат.success
		И Результат.Свойство("data") Тогда
		Если Контекст.Свойство("ПоколениеПодключения") Тогда
			// Новый маршрут: защищённый continuation с проверкой актуальности
			Контекст.Вставить("Результат", Результат);
			КомпонентаТун.НачатьВызовJsonToToon(
				Новый ОписаниеОповещения("ПослеJsonToToonREST_Команды", ЭтаФорма, Контекст),
				ЗаписатьJSON2(Результат.data));
		Иначе
			КомпонентаТун.НачатьВызовJsonToToon(
				Новый ОписаниеОповещения("ПослеJsonToToonREST", ЭтаФорма,
					Новый Структура("ДанныеЗапроса, Результат", Контекст.ДанныеЗапроса, Результат)),
				ЗаписатьJSON2(Результат.data));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(Результат);
	ПрименитьТунКонвертацию(Результат);
	ОтветJSON = ЗаписатьJSON2(Результат);
	Если НачатьОтложеннуюДоставкуСправки(Контекст, ОтветJSON) Тогда Возврат; КонецЕсли;
	КомпонентаSendResponse(Контекст.ДанныеЗапроса.id, 200,
		ЗаголовкиJSON(), ОтветJSON);
	ЗавершитьПараллельнуюДоставку(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьРезультатКомандыMCP(Контекст, Знач Результат)
	Если НЕ ПодготовитьВыдачуПараллельногоОтвета(Контекст, Результат) Тогда Возврат; КонецЕсли;
	Результат = РезультатСИсточникомБазы(Результат, Контекст);
	КонтекстДоставки = Неопределено;
	Если Контекст.Свойство("ПоколениеПодключения") Тогда
		КонтекстДоставки = Контекст;
	КонецЕсли;
	ТулКолРез = СформироватьToolsCallРезультат(Результат, Контекст.ДанныеЗапроса,
		Контекст.Ид, Контекст.ИдПотока, КонтекстДоставки);
	Если ТулКолРез = Неопределено Тогда
		Возврат; // async TOON: доставкой владеет continuation
	КонецЕсли;

	ОтветJSON = СформироватьJSONRPCОтвет(Контекст.Ид, ТулКолРез);
	Если НачатьОтложеннуюДоставкуСправки(Контекст, ОтветJSON) Тогда Возврат; КонецЕсли;
	Если ЗначениеЗаполнено(Контекст.ИдПотока) Тогда
		КомпонентаSendSSEEvent(Контекст.ИдПотока, ОтветJSON, "{}", "message");
	ИначеЕсли КонтекстДоставки <> Неопределено Тогда
		ОтправитьSSEОтветКоманды(Контекст.ДанныеЗапроса, ОтветJSON, Контекст);
	Иначе
		ОтправитьSSEОтвет(Контекст.ДанныеЗапроса, ОтветJSON);
	КонецЕсли;
	ЗавершитьПараллельнуюДоставку(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура ДоставитьРезультатКоманды(Контекст, Результат)
	Если НЕ ПоколениеКонтекстаАктуально(Контекст) Тогда
		ДобавитьВЛог("Результат команды отброшен: подключение устарело");
		ЗавершитьПараллельнуюДоставку(Контекст);
		Возврат;
	КонецЕсли;

	Если Контекст.Режим <> "proxy"
		И ОтветОтклоненПоЭпохе(Контекст.Режим, Контекст.ДанныеЗапроса, Контекст.Ид, Контекст.ИдПотока) Тогда

		ЗавершитьПараллельнуюДоставку(Контекст);

		Возврат;

	КонецЕсли;

	Если Контекст.Свойство("Строгий") Тогда

		Если НЕ ПодготовитьВыдачуПараллельногоОтвета(Контекст, Результат) Тогда

			Возврат;

		КонецЕсли;

		ДоставитьРезультатСтрогий(Результат, Контекст.Строгий, Контекст);

		Возврат;

	КонецЕсли;

	Если Контекст.Режим <> "proxy" И (СостояниеЗащиты.Строгий Или СостояниеЗащиты.Переключение) Тогда

		ДобавитьВЛог("Результат команды, принятой до строгого режима, отброшен");
		ОтправитьОшибкуЭпохи(Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE",
			Контекст.Режим, Контекст.ДанныеЗапроса, Контекст.Ид, Контекст.ИдПотока));
		ЗавершитьПараллельнуюДоставку(Контекст);

		Возврат;

	КонецЕсли;

	Если Контекст.Режим <> "proxy" Тогда

		Результат = ЗакрытьОшибкуРезультатаСтрогогоРежима(Результат, "");

	КонецЕсли;

	Попытка
	Если Контекст.Режим = "proxy" Тогда
		ОтправитьРезультатКомандыПрокси(Контекст, Результат);
	ИначеЕсли Контекст.Режим = "rest" Тогда
		ОтправитьРезультатКомандыREST(Контекст, Результат);
	ИначеЕсли Контекст.Режим = "mcp" Тогда
		ОтправитьРезультатКомандыMCP(Контекст, Результат);
	Иначе
		ДобавитьВЛог("ДоставитьРезультатКоманды: неизвестный режим " + Контекст.Режим);
	КонецЕсли;
	Исключение
		Если НЕ Контекст.Свойство("ИдПараллельнойОперации") Тогда ВызватьИсключение; КонецЕсли;
		ДобавитьВЛог("Ошибка доставки результата; повторной отправки не будет: " + ОписаниеОшибки());
		ЗавершитьПараллельнуюДоставку(Контекст);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеJsonToToonREST_Команды(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = Контекст команды (ДанныеЗапроса, Результат, ПоколениеПодключения, Режим)
	Если НЕ ПоколениеКонтекстаАктуально(ДопПар) ИЛИ Компонента = Неопределено Тогда
		ДобавитьВЛог("Результат команды отброшен: подключение устарело");
		ЗавершитьПараллельнуюДоставку(ДопПар);
		Возврат;
	КонецЕсли;
	Если ОтветОтклоненПоЭпохе("rest", ДопПар.ДанныеЗапроса, "", "") Тогда

		ЗавершитьПараллельнуюДоставку(ДопПар);

		Возврат;

	КонецЕсли;

	Доставка = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE", "rest", ДопПар.ДанныеЗапроса, "", "");

	Попытка

		Если ЗначениеЗаполнено(РезВызова) Тогда
			ДопПар.Результат.data = РезВызова;
		КонецЕсли;
		Если НЕ ПодготовитьВыдачуПараллельногоОтвета(ДопПар, ДопПар.Результат) Тогда Возврат; КонецЕсли;
		ДопПар.Результат = РезультатСИсточникомБазы(ДопПар.Результат, ДопПар);
		ДопПар.Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(ДопПар.Результат);
		ОтветJSON = ЗаписатьJSON2(ДопПар.Результат);
		Если НачатьОтложеннуюДоставкуСправки(ДопПар, ОтветJSON) Тогда Возврат; КонецЕсли;
		Доставка.Вставить("Отвечено", Истина);
		КомпонентаSendResponse(ДопПар.ДанныеЗапроса.id, 200,
			ЗаголовкиJSON(), ОтветJSON);

	Исключение

		ДобавитьВЛог("Сбой продолжения конвертации TOON: " + ОписаниеОшибки());
		ОтправитьОшибкуВыполненияДоставки(Доставка);

	КонецПопытки;

	ЗавершитьПараллельнуюДоставку(ДопПар);
КонецПроцедуры

&НаКлиенте
Процедура ПослеJsonToToonMCP_Команды(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = Контекст команды (ДанныеЗапроса, Ид, РезДляВывода, ИдПотока, ПоколениеПодключения, Режим)
	Если НЕ ПоколениеКонтекстаАктуально(ДопПар) ИЛИ Компонента = Неопределено Тогда
		ДобавитьВЛог("Результат команды отброшен: подключение устарело");
		ЗавершитьПараллельнуюДоставку(ДопПар);
		Возврат;
	КонецЕсли;
	Если ОтветОтклоненПоЭпохе("mcp", ДопПар.ДанныеЗапроса, ДопПар.Ид, ДопПар.ИдПотока) Тогда

		ЗавершитьПараллельнуюДоставку(ДопПар);

		Возврат;

	КонецЕсли;

	Доставка = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE",
		"mcp", ДопПар.ДанныеЗапроса, ДопПар.Ид, ДопПар.ИдПотока);

	Попытка

		Если ЗначениеЗаполнено(РезВызова) Тогда
			ДопПар.РезДляВывода.data = РезВызова;
		КонецЕсли;
		Если НЕ ПодготовитьВыдачуПараллельногоОтвета(ДопПар, ДопПар.РезДляВывода) Тогда Возврат; КонецЕсли;
		ДопПар.РезДляВывода = РезультатСИсточникомБазы(ДопПар.РезДляВывода, ДопПар);
		Элемент = Новый Структура("type, text", "text", ЗаписатьJSON2(ДопПар.РезДляВывода));
		Содержимое = Новый Массив;
		Содержимое.Добавить(Элемент);
		ТулКолРез = Новый Структура("content", Содержимое);
		ОтветJSON = СформироватьJSONRPCОтвет(ДопПар.Ид, ТулКолРез);
		Если НачатьОтложеннуюДоставкуСправки(ДопПар, ОтветJSON) Тогда Возврат; КонецЕсли;
		Доставка.Вставить("Отвечено", Истина);
		// Ветка legacy SSE vs streamable HTTP:
		Если ЗначениеЗаполнено(ДопПар.ИдПотока) Тогда
			КомпонентаSendSSEEvent(ДопПар.ИдПотока, ОтветJSON, "{}", "message"); // Legacy SSE
		Иначе
			ОтправитьSSEОтветКоманды(ДопПар.ДанныеЗапроса, ОтветJSON, ДопПар); // Streamable HTTP
		КонецЕсли;

	Исключение

		ДобавитьВЛог("Сбой продолжения конвертации TOON: " + ОписаниеОшибки());
		ОтправитьОшибкуВыполненияДоставки(Доставка);

	КонецПопытки;

	ЗавершитьПараллельнуюДоставку(ДопПар);
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьSSEОтветКоманды(ДанныеЗапроса, ОтветJSON, Контекст)
	Если НЕ ПоколениеКонтекстаАктуально(Контекст) ИЛИ Компонента = Неопределено Тогда
		ДобавитьВЛог("Результат команды отброшен: подключение устарело");
		Возврат;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		// CloseSSEStream вызывается в колбэке — гарантированный порядок
		ДопПарКоманды = Новый Структура("ИдЗапроса, Контекст", ДанныеЗапроса.id, Контекст);
		Компонента.НачатьВызовSendSSEEvent(
			Новый ОписаниеОповещения("ПослеОтправкиSSEОтветаКоманды", ЭтаФорма, ДопПарКоманды),
			ДанныеЗапроса.id, ОтветJSON,
			СформироватьSSEЗаголовки(ДанныеЗапроса), "message");
	Иначе
		Компонента.SendSSEEvent(ДанныеЗапроса.id, ОтветJSON,
			СформироватьSSEЗаголовки(ДанныеЗапроса));
		Компонента.CloseSSEStream(ДанныеЗапроса.id);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиSSEОтветаКоманды(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = {ИдЗапроса, Контекст}: проверка актуальности перед закрытием потока
	Если НЕ ПоколениеКонтекстаАктуально(ДопПар.Контекст) ИЛИ Компонента = Неопределено Тогда
		ДобавитьВЛог("Закрытие SSE-потока пропущено: подключение устарело");
		Возврат;
	КонецЕсли;
	КомпонентаCloseSSEStream(ДопПар.ИдЗапроса);
КонецПроцедуры

&НаКлиенте
Функция НачатьОтложеннуюДоставкуСправки(Контекст, ОтветJSON)
	Если НЕ ИспользоватьАсинхронноеПодключениеКомпонент Или НЕ Контекст.Свойство("ИдПараллельнойОперации") Тогда Возврат Ложь; КонецЕсли;
	Операция = ПланировщикФормы.Операции.Получить(Контекст.ИдПараллельнойОперации);
	Если Операция = Неопределено Или Операция.ИсполнительВладельца <> "owner_help" Тогда Возврат Ложь; КонецЕсли;
	Если Операция.Свойство("ДоставкаСправки") Или Операция.ОтветВыдан Тогда Возврат Истина; КонецЕсли;
	ЗакрытьПоток = Ложь;
	Если Контекст.Режим = "mcp" Тогда ЗакрытьПоток = НЕ ЗначениеЗаполнено(Контекст.ИдПотока); КонецЕсли;
	Доставка = Новый Структура("Контекст,Транспорт,Стадия,ЗакрытьПоток,ИдЗапроса",
		Контекст, Компонента, "send", ЗакрытьПоток, Контекст.ДанныеЗапроса.id);
	Операция.Вставить("ДоставкаСправки", Доставка);
	Попытка
		Оповещение = Новый ОписаниеОповещения("ПослеОтправкиОтветаСправки", ЭтаФорма, Доставка);
		Если Контекст.Режим = "rest" Тогда
			Доставка.Транспорт.НачатьВызовSendResponse(Оповещение, Доставка.ИдЗапроса, 200, ЗаголовкиJSON(), ОтветJSON);
		ИначеЕсли Доставка.ЗакрытьПоток Тогда
			Доставка.Транспорт.НачатьВызовSendSSEEvent(Оповещение, Доставка.ИдЗапроса, ОтветJSON, СформироватьSSEЗаголовки(Контекст.ДанныеЗапроса), "message");
		Иначе
			Доставка.Транспорт.НачатьВызовSendSSEEvent(Оповещение, Контекст.ИдПотока, ОтветJSON, "{}", "message");
		КонецЕсли;
	Исключение
		ДобавитьВЛог("Отправка справки завершилась ошибкой; повторной отправки не будет: " + ОписаниеОшибки());
		Операция.Удалить("ДоставкаСправки");
		ЗавершитьПараллельнуюДоставку(Контекст);
	КонецПопытки;
	// Другие ответы могут отправляться, но эта операция остаётся в общем лимите.
	Если ПараллельныйОтветВОбработке = Операция.Ид Тогда ПараллельныйОтветВОбработке = ""; КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ОперацияДоставкиСправки(Доставка)
	Операция = ПланировщикФормы.Операции.Получить(Доставка.Контекст.ИдПараллельнойОперации);
	Если Операция = Неопределено Или Операция.ОтветВыдан Тогда Возврат Неопределено; КонецЕсли;
	Если Операция.Поколение <> Доставка.Контекст.ПоколениеПланировщика Тогда Возврат Неопределено; КонецЕсли;
	Если НЕ Операция.Свойство("ДоставкаСправки") Или Операция.ДоставкаСправки <> Доставка Тогда Возврат Неопределено; КонецЕсли;
	Возврат Операция;
КонецФункции

&НаКлиенте
Процедура ПослеОтправкиОтветаСправки(РезВызова, ПарВызова, Доставка) Экспорт
	Операция = ОперацияДоставкиСправки(Доставка);
	Если Операция = Неопределено Или Доставка.Стадия <> "send" Тогда Возврат; КонецЕсли;
	Если Доставка.ЗакрытьПоток И ПоколениеКонтекстаАктуально(Доставка.Контекст)
		И Доставка.Транспорт = Компонента И ТекущиеМиллисекундыКлиента() < Операция.Срок Тогда
		Доставка.Стадия = "close";
		Попытка
			Доставка.Транспорт.НачатьВызовCloseSSEStream(
				Новый ОписаниеОповещения("ПослеЗакрытияПотокаСправки", ЭтаФорма, Доставка), Доставка.ИдЗапроса);
			Возврат;
		Исключение ДобавитьВЛог("Закрытие потока справки: " + ОписаниеОшибки()); КонецПопытки;
	КонецЕсли;
	Операция.Удалить("ДоставкаСправки");
	ЗавершитьПараллельнуюДоставку(Доставка.Контекст);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияПотокаСправки(РезВызова, ПарВызова, Доставка) Экспорт
	Операция = ОперацияДоставкиСправки(Доставка);
	Если Операция = Неопределено Или Доставка.Стадия <> "close" Тогда Возврат; КонецЕсли;
	Операция.Удалить("ДоставкаСправки");
	ЗавершитьПараллельнуюДоставку(Доставка.Контекст);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтправкуРезультатаПроксиПослеLineage(КонтекстLineage)
	ОтправитьРезультатКомандыПрокси(КонтекстLineage, КонтекстLineage.Результат);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьRESTОтветПослеLineage(КонтекстLineage)

	Если ОтветОтклоненПоЭпохе("rest", КонтекстLineage.ДанныеЗапроса, "", "") Тогда

		ЗавершитьПараллельнуюДоставку(КонтекстLineage);

		Возврат;

	КонецЕсли;

	// Точка перехвата: confirm анонимизации до async Toon — иначе при ФорматОтветаВстроенный=1 обходится
	Если ПроверитьПодтверждениеАнонимизации(КонтекстLineage.Результат,
		КонтекстLineage.ДанныеЗапроса, "", "", "rest") Тогда
		Возврат;
	КонецЕсли;

	ОтправитьРезультатКомандыREST(КонтекстLineage, КонтекстLineage.Результат);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьMCPОтветПослеLineage(КонтекстLineage)

	Если ОтветОтклоненПоЭпохе("mcp", КонтекстLineage.ДанныеЗапроса, КонтекстLineage.Ид, КонтекстLineage.ИдПотока) Тогда

		ЗавершитьПараллельнуюДоставку(КонтекстLineage);

		Возврат;

	КонецЕсли;

	// Точка перехвата C: после lineage/regex async
	Если ПроверитьПодтверждениеАнонимизации(КонтекстLineage.Результат,
		КонтекстLineage.ДанныеЗапроса, КонтекстLineage.Ид, КонтекстLineage.ИдПотока) Тогда
		Возврат;
	КонецЕсли;

	ОтправитьРезультатКомандыMCP(КонтекстLineage, КонтекстLineage.Результат);
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьВстроенныйСервер()

	Если НЕ ВстроенныйСерверЗапущен Тогда
		Возврат;
	КонецЕсли;

	// Реальная остановка — отзыв маркеров актуальности server-подключения
	ПоколениеПодключенияСервер = ПоколениеПодключенияСервер + 1;
	ОтменитьАктивныйЗахватСкриншота("server");
	ИдПопыткиSyntaxHelpСервер = ИдПопыткиSyntaxHelpСервер + 1;
	Если ИсполнительСправкиФормы <> Неопределено Тогда
		ИсполнительСправкиФормы.Вставить("ТранспортОстановлен", Истина);
		ПодключитьОбработчикОжидания("ОбработатьИсполнительСправкиФормы", 0.1, Истина);
	КонецЕсли;

	// Весь teardown-код ДО вызова Stop
	SSEПотоки = Новый Соответствие;
	ЛегасиССЕПотоки = Новый Соответствие;
	МСПСессии = Новый Соответствие;
	ОжидающиеПодтверждения = Новый Соответствие;
	ВстроенныйСерверЗапущен = Ложь;
	АнонимизаторОчистить();
	ОбновитьТаблицуМаппинговВстроенный();
	УстановитьСтатус("Отключено", Ложь);
	ДобавитьВЛог("Встроенный HTTP-сервер остановлен");

	Если Компонента <> Неопределено Тогда
		Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			Компонента.НачатьВызовStop(
				Новый ОписаниеОповещения("ИгнорироватьРезультатКомпоненты", ЭтаФорма));
		Иначе
			Компонента.Stop();
		КонецЕсли;
	КонецЕсли;

	Компонента = Неопределено;
	КомпонентаТун = Неопределено;

КонецПроцедуры

// Пустой колбэк для fire-and-forget вызовов компоненты
&НаКлиенте
Процедура ИгнорироватьРезультатКомпоненты(РезВызова, ПарВызова, ДопПар) Экспорт
КонецПроцедуры

// ═══════════════════════════════════════════════════════════════════════════════
// ВЫБОР АДРЕСА ПРИВЯЗКИ ВСТРОЕННОГО СЕРВЕРА
// ═══════════════════════════════════════════════════════════════════════════════

// ── Персистентность: одна версионированная запись в хранилище настроек ──

&НаСервереБезКонтекста
Функция ПрочитатьВыборАдресаВстроенногоСервераССервера()
	// Возвращает Структуру {Присутствует, Значение}, чтобы клиент мог отличить
	// «ключа нет вообще» (первый запуск → 0.0.0.0) от «запись есть, но невалидна/нечитаема»
	// (fail-closed → 127.0.0.1). Нельзя сводить оба случая к Неопределено.
	Результат = Новый Структура("Присутствует, Значение", Ложь, Неопределено);
	Попытка
		Значение = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ВыборАдресаВстроенногоСервера");
		Если Значение <> Неопределено Тогда
			Результат.Присутствует = Истина;
			Результат.Значение = Значение;
		КонецЕсли;
	Исключение
		// Ошибка чтения — считаем «присутствует, но нечитаемо» (fail-closed, не первый запуск)
		Результат.Присутствует = Истина;
		Результат.Значение = Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьВыборАдресаВстроенногоСервераНаСервере(ЗначениеJSON)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "ВыборАдресаВстроенногоСервера", ЗначениеJSON);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция СериализоватьВыборАдреса(Выбор)
	// Проектный сериализатор (совместим с 8.2.13, в отличие от платформенного ЗаписьJSON/ЗаписатьJSON)
	Возврат ЗаписатьJSON2(Выбор);
КонецФункции

&НаКлиенте
Функция ДефолтВыбораАдреса()
	Выбор = Новый Структура;
	Выбор.Вставить("version", 1);
	Выбор.Вставить("kind", "all");
	Выбор.Вставить("interfaceId", "");
	Выбор.Вставить("displayName", "");
	Выбор.Вставить("lastAddress", "0.0.0.0");
	Возврат Выбор;
КонецФункции

&НаКлиенте
Функция ВыборАдресаНевалиден()
	Выбор = Новый Структура;
	Выбор.Вставить("version", 1);
	Выбор.Вставить("kind", "invalid");
	Выбор.Вставить("interfaceId", "");
	Выбор.Вставить("displayName", "");
	Выбор.Вставить("lastAddress", "127.0.0.1");
	Возврат Выбор;
КонецФункции

&НаКлиенте
Функция ВыборАдресаВалиден(Выбор)
	Если ТипЗнч(Выбор) <> Тип("Структура") Тогда Возврат Ложь; КонецЕсли;
	Если НЕ Выбор.Свойство("version") ИЛИ Выбор.version <> 1 Тогда Возврат Ложь; КонецЕсли;
	Если НЕ Выбор.Свойство("kind") ИЛИ ТипЗнч(Выбор.kind) <> Тип("Строка") Тогда Возврат Ложь; КонецЕсли;
	Если Выбор.kind <> "all" И Выбор.kind <> "loopback" И Выбор.kind <> "interface" Тогда
		Возврат Ложь;
	КонецЕсли;
	// Обязательные поля должны быть строками (недоверенный JSON из хранилища мог прийти с массивами и т.п.)
	Если НЕ Выбор.Свойство("interfaceId") ИЛИ ТипЗнч(Выбор.interfaceId) <> Тип("Строка")
		ИЛИ НЕ Выбор.Свойство("displayName") ИЛИ ТипЗнч(Выбор.displayName) <> Тип("Строка")
		ИЛИ НЕ Выбор.Свойство("lastAddress") ИЛИ ТипЗнч(Выбор.lastAddress) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Загрузка канонического выбора в клиентском ПриОткрытии (различаем отсутствие и невалидность)
&НаКлиенте
Процедура ЗагрузитьВыборАдресаВстроенногоСервера()
	Инфо = ПрочитатьВыборАдресаВстроенногоСервераССервера();
	Если НЕ Инфо.Присутствует Тогда
		// Ключа нет — доказанный первый запуск, дефолт 0.0.0.0 (совместимость)
		ВыборАдресаВстроенногоСервера = ДефолтВыбораАдреса();
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Инфо.Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Инфо.Значение) Тогда
		// Запись есть, но не строка / нечитаема — fail-closed, исходную запись НЕ перезаписываем
		ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
		Возврат;
	КонецЕсли;
	Попытка
		Разобранный = ПрочитатьJSON2(Инфо.Значение);
		Если ВыборАдресаВалиден(Разобранный) Тогда
			ВыборАдресаВстроенногоСервера = Разобранный;
		Иначе
			// Запись есть, но невалидна — fail-closed, исходную запись НЕ перезаписываем
			ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
		КонецЕсли;
	Исключение
		ВыборАдресаВстроенногоСервера = ВыборАдресаНевалиден();
	КонецПопытки;
КонецПроцедуры

// ── Список адресов выпадающего поля ──
// GetLocalAddresses — метод уже существующей компоненты MCPHttp. Список наполняется при показе
// группы и по кнопке ⟳: базовый список (искусственные пункты + сохранённый) показывается сразу без
// компоненты, затем реальные интерфейсы подтягиваются веткой async/sync (как GetRequestBody).

&НаКлиенте
Процедура КомандаОбновитьАдреса(Команда)
	ОбновитьСписокАдресов();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокАдресов()
	ПостроитьБазовыйСписокАдресов(); // мгновенно, без компоненты — выпадающий список не пуст
	// Реальные интерфейсы: компонента переиспользуется, если уже загружена, иначе грузим как везде
	Если Компонента <> Неопределено Тогда
		ПолучитьАдресаИПостроить();
	ИначеЕсли ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПодключенияМСП", ЭтаФорма),
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport", "MCPHttp");
	ИначеЕсли ПодключитьMCPHttpСинхронно() Тогда
		ПолучитьАдресаИПостроить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПодключенияМСП(Подключено, ДопПар) Экспорт
	Если Компонента <> Неопределено Тогда // уже загружена (напр. запуском сервера) — не пересоздаём
		ПолучитьАдресаИПостроить();
		Возврат;
	КонецЕсли;
	Если Подключено Тогда
		Попытка
			Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
			ПолучитьАдресаИПостроить();
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Fallback: .dll из макета через файл
	Попытка
		ДвоичныеДанные = ПолучитьМакетНаСервере();
		ИмяФайла = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ИмяФайла);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПолеАдрес_ПослеПодключенияФайлаМСП", ЭтаФорма),
			ИмяФайла, "MCPHttp");
	Исключение
		ДобавитьВЛог("Не удалось подключить MCPHttp для списка адресов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПолеАдрес_ПослеПодключенияФайлаМСП(Подключено, ДопПар) Экспорт
	Если Компонента <> Неопределено Тогда // уже загружена — не пересоздаём
