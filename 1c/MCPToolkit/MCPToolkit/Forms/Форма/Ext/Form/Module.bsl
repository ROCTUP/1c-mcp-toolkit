			ЕстьПериод = Ложь;
			ПолноеИмяЧасти = РазделитьСтрокуПоРазделителю(ИмяМета, ".");
			ТипРегистра = "";
			Если ПолноеИмяЧасти.Количество() >= 1 Тогда
