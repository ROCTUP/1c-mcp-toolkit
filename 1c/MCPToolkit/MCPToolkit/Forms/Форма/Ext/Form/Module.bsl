		Операция = Пара.Значение;
		Если Операция.ИсполнительВладельца <> "owner_help" Тогда Продолжить; КонецЕсли;
		Если НЕ ПоколениеКонтекстаАктуально(Операция.Маршрут)
			Или (Операция.Маршрут.Режим <> "proxy" И НЕ ИнструментВключен_GetBslSyntaxHelp)
			Или ТекущиеМиллисекундыКлиента() >= Операция.Срок Тогда
