&НаКлиентеНаСервереБезКонтекста
Функция ПрименитьТочнуюPolicyКРезультатуExecuteQuery(Результат, ОтключитьАгрессивныйРежим = Ложь,
	НастройкиАнонимизации = Неопределено)

	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ Результат.Свойство("schema") Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат.schema = Неопределено Или ТипЗнч(Результат.schema) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Если НастройкиАнонимизации = Неопределено Тогда
		НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииИзХранилища();
	КонецЕсли;
	ПравилаТочнойАнонимизации = НастройкиАнонимизации.Правила;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;
	Если ОтключитьАгрессивныйРежим Тогда
		АгрессивныйРежим = Ложь;
	КонецЕсли;
	КешРазыменования = Неопределено;
	Если НуженКешРазыменования(Результат.schema, ПравилаТочнойАнонимизации) Тогда
		КешРазыменования = ВычислитьКешРазыменованияДляSchema(Результат.schema, ПравилаТочнойАнонимизации);
	КонецЕсли;
	ПрименитьТочнуюPolicyКSchema(Результат.schema, ПравилаТочнойАнонимизации, КешРазыменования, АгрессивныйРежим);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат)

	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат Результат; КонецЕсли;
	Если НЕ Результат.Свойство("data") Или ТипЗнч(Результат.data) <> Тип("Структура") Тогда Возврат Результат; КонецЕсли;

	ТипОбъекта = "";
	Если НЕ Результат.data.Свойство("_type", ТипОбъекта) Тогда
		// Fail-closed: тип объекта неизвестен — нет схемы, слепая анонимизация строк
		Результат.Вставить("_blind_anonymization", Истина);
		Результат.Вставить("_anon_schema_forced",  Истина);
		Возврат Результат;
	КонецЕсли;

	ЭтоВнешняяТаблица = (НРег(Лев(ТипОбъекта, СтрДлина("внешнийисточникданных."))) = "внешнийисточникданных.");

	МетаданныеОбъекта = Неопределено;
	Попытка
		Если ЭтоВнешняяТаблица Тогда
			// Парсим "ВнешнийИсточникДанных.ИмяИсточника.Таблица.ИмяТаблицы"
			Части = РазделитьСтрокуПоРазделителю(ТипОбъекта, ".");
			Если Части.Количество() = 4 Тогда
				МетаИсточника = Метаданные.ВнешниеИсточникиДанных.Найти(Части[1]);
				Если МетаИсточника <> Неопределено Тогда
					МетаданныеОбъекта = МетаИсточника.Таблицы.Найти(Части[3]);
				КонецЕсли;
			КонецЕсли;
		Иначе
			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ТипОбъекта);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если МетаданныеОбъекта = Неопределено Тогда
		// Fail-closed: метаданные недоступны — слепая анонимизация строк
		Результат.Вставить("_blind_anonymization", Истина);
		Результат.Вставить("_anon_schema_forced",  Истина);
		Возврат Результат;
	КонецЕсли;

	Схема = СформироватьСхемуОбъектаДляАнонимизации(МетаданныеОбъекта, ТипОбъекта, ЭтоВнешняяТаблица);

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииИзХранилища();
	Правила = НастройкиАнонимизации.Правила;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;

	// Основные колонки
	КешРазыменования = Неопределено;
	Если НуженКешРазыменования(Схема, Правила) Тогда
		КешРазыменования = ВычислитьКешРазыменованияДляSchema(Схема, Правила);
	КонецЕсли;
	ПрименитьТочнуюPolicyКSchema(Схема, Правила, КешРазыменования, АгрессивныйРежим);

	// Табличные части
	Для Каждого КВП Из Схема.tabular_sections Цикл
		СхемаТЧ = КВП.Значение;
		КешТЧ = Неопределено;
		Если НуженКешРазыменования(СхемаТЧ, Правила) Тогда
			КешТЧ = ВычислитьКешРазыменованияДляSchema(СхемаТЧ, Правила);
		КонецЕсли;
		ПрименитьТочнуюPolicyКSchema(СхемаТЧ, Правила, КешТЧ, АгрессивныйРежим);
	КонецЦикла;

	Результат.Вставить("_anon_schema_forced", Истина);
	Результат.Вставить("schema", Схема);
	Возврат Результат;

КонецФункции

// Клиентский кэш набора правил. Серверная функция возвращает Соответствие на десятки тысяч
// элементов: маршалинг клиент/сервер стоит секунды, поэтому ходим на сервер один раз за сеанс.
// Сброс — в ПослеЗакрытияНастроекТочнойАнонимизации, там же где КэшRegexПравил.
&НаКлиенте
Функция ПолучитьНастройкиТочнойАнонимизации()

	Если КэшНастроекТочнойАнонимизации = Неопределено Тогда
		КэшНастроекТочнойАнонимизации = ПолучитьНастройкиТочнойАнонимизацииИзХранилища();
	КонецЕсли;

	Возврат КэшНастроекТочнойАнонимизации;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкиТочнойАнонимизацииИзХранилища()

	СоответствиеПравил = Новый Соответствие;
	АгрессивныйРежим   = Ложь;
	КонфирмРежим       = Ложь;

	Попытка
		ЭтоНаборВерсии2 = Истина;
		НаборПравил = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v2");
		Если ТипЗнч(НаборПравил) <> Тип("Структура") Или НЕ НаборПравил.Свойство("Правила") Тогда
			ЭтоНаборВерсии2 = Ложь;
			НаборПравил = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v1");
		КонецЕсли;

		Если ТипЗнч(НаборПравил) = Тип("Структура") И НаборПравил.Свойство("Правила") Тогда
			ЗаполнитьСоответствиеПравилТочнойАнонимизации(СоответствиеПравил, НаборПравил.Правила);
			Если ЭтоНаборВерсии2 Тогда
				// Флаги хранятся только в v2-наборе
				ЗначениеФлага = Неопределено;
				Если НаборПравил.Свойство("aggressive_mode", ЗначениеФлага) Тогда
					АгрессивныйРежим = (ЗначениеФлага = Истина);
				КонецЕсли;
				ЗначениеФлага = Неопределено;
				Если НаборПравил.Свойство("confirmation_mode", ЗначениеФлага) Тогда
					КонфирмРежим = (ЗначениеФлага = Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Новый Структура("Правила, АгрессивныйРежим, ПодтверждениеАнонимизации",
		СоответствиеПравил, АгрессивныйРежим, КонфирмРежим);

КонецФункции

// Заполняет соответствие "путь источника" -> структура правила.
// Правила хранятся таблицей значений; наличие колонок проверяется один раз до цикла,
// а не исключением на каждой строке — на наборе в 70 тыс. правил это разница в разы.
&НаСервереБезКонтекста
Процедура ЗаполнитьСоответствиеПравилТочнойАнонимизации(СоответствиеПравил, Правила)

	Если ТипЗнч(Правила) = Тип("ТаблицаЗначений") Тогда

		Если Правила.Колонки.Найти("source_path") = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЕстьДействие  = Правила.Колонки.Найти("action") <> Неопределено;
		ЕстьКатегория = Правила.Колонки.Найти("token_category") <> Неопределено;

		Для Каждого СтрокаПравила Из Правила Цикл
			ПутьИсточника = СтрокаПравила.source_path;
			Если ТипЗнч(ПутьИсточника) <> Тип("Строка") Или ПустаяСтрока(ПутьИсточника) Тогда
				Продолжить;
			КонецЕсли;
			Действие  = ?(ЕстьДействие,  СтрокаПравила.action,         "");
			Категория = ?(ЕстьКатегория, СтрокаПравила.token_category, "");
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			СоответствиеПравил.Вставить(ПутьИсточника,
				Новый Структура("action, token_category", Действие, Категория));
		КонецЦикла;

		Возврат;

	КонецЕсли;

	// Устаревшие наборы: массив структур
	Для Каждого СтрокаПравила Из Правила Цикл
		Если ТипЗнч(СтрокаПравила) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		ПутьИсточника = "";
		Если НЕ СтрокаПравила.Свойство("source_path", ПутьИсточника)
			Или ТипЗнч(ПутьИсточника) <> Тип("Строка") Или ПустаяСтрока(ПутьИсточника) Тогда
			Продолжить;
		КонецЕсли;
		Действие = "";
		СтрокаПравила.Свойство("action", Действие);
		Если Действие = Неопределено Тогда Действие = ""; КонецЕсли;
		Категория = "";
		СтрокаПравила.Свойство("token_category", Категория);
		Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
		СоответствиеПравил.Вставить(ПутьИсточника,
			Новый Структура("action, token_category", Действие, Категория));
	КонецЦикла;

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────
// HTML-генератор для окна подтверждения анонимизации
// ─────────────────────────────────────────────────────────────────────────────

&НаКлиентеНаСервереБезКонтекста
Функция HTMLЭскейп(Знач Текст)
	Текст = СтрЗаменить(Текст, "&",  "&amp;");
	Текст = СтрЗаменить(Текст, "<",  "&lt;");
	Текст = СтрЗаменить(Текст, ">",  "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Возврат Текст;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьЗначениеДляHTML(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипЗн = ТипЗнч(Значение);
	Если ТипЗн = Тип("Структура") Тогда
		Прес = "";
		Если НЕ Значение.Свойство("presentation", Прес) Тогда
			Если НЕ Значение.Свойство("Представление", Прес) Тогда
				Значение.Свойство("_presentation", Прес);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Прес) Тогда
			Возврат HTMLЭскейп(Строка(Прес));
		КонецЕсли;
		Возврат "<code>" + HTMLЭскейп(ЗаписатьJSON2(Значение)) + "</code>";
	КонецЕсли;
	Если ТипЗн = Тип("Соответствие") Тогда
		Прес = Значение["presentation"];
		Если Прес = Неопределено Тогда
			Прес = Значение["Представление"];
		КонецЕсли;
		Если Прес = Неопределено Тогда
			Прес = Значение["_presentation"];
		КонецЕсли;
		Если ЗначениеЗаполнено(Прес) Тогда
			Возврат HTMLЭскейп(Строка(Прес));
		КонецЕсли;
		Возврат "<code>" + HTMLЭскейп(ЗаписатьJSON2(Значение)) + "</code>";
	КонецЕсли;
	Если ТипЗн = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;
		Буфер = "<ul style=""margin:0;padding-left:16px"">";
		Для Каждого Эл Из Значение Цикл
			Буфер = Буфер + "<li>" + НормализоватьЗначениеДляHTML(Эл) + "</li>";
		КонецЦикла;
		Буфер = Буфер + "</ul>";
		Возврат Буфер;
	КонецЕсли;
	Возврат HTMLЭскейп(Строка(Значение));
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОбъектБезPresentation(Значение)
	ТипЗн = ТипЗнч(Значение);
	Если ТипЗн = Тип("Структура") Тогда
		Прес = "";
		Если Значение.Свойство("presentation",  Прес) И ЗначениеЗаполнено(Прес) Тогда Возврат Ложь; КонецЕсли;
		Если Значение.Свойство("Представление", Прес) И ЗначениеЗаполнено(Прес) Тогда Возврат Ложь; КонецЕсли;
		Если Значение.Свойство("_presentation", Прес) И ЗначениеЗаполнено(Прес) Тогда Возврат Ложь; КонецЕсли;
		Возврат Истина;
	ИначеЕсли ТипЗн = Тип("Соответствие") Тогда
		Прес = Значение["presentation"];
		Если Прес <> Неопределено И ЗначениеЗаполнено(Прес) Тогда Возврат Ложь; КонецЕсли;
		Прес = Значение["Представление"];
		Если Прес <> Неопределено И ЗначениеЗаполнено(Прес) Тогда Возврат Ложь; КонецЕсли;
		Прес = Значение["_presentation"];
		Если Прес <> Неопределено И ЗначениеЗаполнено(Прес) Тогда Возврат Ложь; КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСкалярСтроку(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипЗн = ТипЗнч(Значение);
	Если ТипЗн = Тип("Структура") Тогда
		Прес = "";
		Если Значение.Свойство("presentation",  Прес) И ЗначениеЗаполнено(Прес) Тогда Возврат Строка(Прес); КонецЕсли;
		Если Значение.Свойство("Представление", Прес) И ЗначениеЗаполнено(Прес) Тогда Возврат Строка(Прес); КонецЕсли;
		Если Значение.Свойство("_presentation", Прес) И ЗначениеЗаполнено(Прес) Тогда Возврат Строка(Прес); КонецЕсли;
		Возврат ЗаписатьJSON2(Значение);
	КонецЕсли;
	Если ТипЗн = Тип("Соответствие") Тогда
		Прес = Значение["presentation"];
		Если Прес = Неопределено Тогда Прес = Значение["Представление"]; КонецЕсли;
		Если Прес = Неопределено Тогда Прес = Значение["_presentation"];  КонецЕсли;
		Если ЗначениеЗаполнено(Прес) Тогда Возврат Строка(Прес); КонецЕсли;
		Возврат ЗаписатьJSON2(Значение);
	КонецЕсли;
	Если ТипЗн = Тип("Массив") Тогда
		Возврат ЗаписатьJSON2(Значение);
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Разбить строку на токены (слова) + разделители (" ,:.;"{}[]")
// Возвращает массив Структура("Текст, ЭтоРазделитель")
&НаКлиентеНаСервереБезКонтекста
Функция ТокенизироватьСтроку(Текст)
	Разделители = " ,:.;""{[]}";
	Токены = Новый Массив;
	ТекущийТокен = "";
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Поз, 1);
		Если Найти(Разделители, Символ) > 0 Тогда
			Если ЗначениеЗаполнено(ТекущийТокен) Тогда
				Токены.Добавить(Новый Структура("Текст, ЭтоРазделитель", ТекущийТокен, Ложь));
				ТекущийТокен = "";
			КонецЕсли;
			Токены.Добавить(Новый Структура("Текст, ЭтоРазделитель", Символ, Истина));
		Иначе
			ТекущийТокен = ТекущийТокен + Символ;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ТекущийТокен) Тогда
		Токены.Добавить(Новый Структура("Текст, ЭтоРазделитель", ТекущийТокен, Ложь));
	КонецЕсли;
	Возврат Токены;
КонецФункции

// LCS только по словам (не-разделителям).
// Возвращает отсортированный массив пар Структура("ИндОриг, ИндАнон") — полные индексы в массивах токенов.
&НаКлиентеНаСервереБезКонтекста
Функция ВычислитьLCSТокенов(ТокеныОриг, ТокеныАнон)
	СловаОриг = Новый Массив; // Структура("Текст, Инд")
	Для Нп = 0 По ТокеныОриг.Количество() - 1 Цикл
		Если НЕ ТокеныОриг[Нп].ЭтоРазделитель Тогда
			СловаОриг.Добавить(Новый Структура("Текст, Инд", ТокеныОриг[Нп].Текст, Нп));
		КонецЕсли;
	КонецЦикла;
	СловаАнон = Новый Массив;
	Для Нп = 0 По ТокеныАнон.Количество() - 1 Цикл
		Если НЕ ТокеныАнон[Нп].ЭтоРазделитель Тогда
			СловаАнон.Добавить(Новый Структура("Текст, Инд", ТокеныАнон[Нп].Текст, Нп));
		КонецЕсли;
	КонецЦикла;

	Н = СловаОриг.Количество();
	М = СловаАнон.Количество();

	DP = Новый Массив((Н + 1) * (М + 1));
	Для Кз = 0 По (Н + 1) * (М + 1) - 1 Цикл
		DP[Кз] = 0;
	КонецЦикла;
	Для Р = 1 По Н Цикл
		Для Кол = 1 По М Цикл
			Если СловаОриг[Р - 1].Текст = СловаАнон[Кол - 1].Текст Тогда
				DP[Р * (М + 1) + Кол] = DP[(Р - 1) * (М + 1) + (Кол - 1)] + 1;
			Иначе
				Прев1 = DP[(Р - 1) * (М + 1) + Кол];
				Прев2 = DP[Р * (М + 1) + (Кол - 1)];
				DP[Р * (М + 1) + Кол] = ?(Прев1 > Прев2, Прев1, Прев2);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Пары = Новый Массив;
	Р = Н; Кол = М;
	Пока Р > 0 И Кол > 0 Цикл
		Если СловаОриг[Р - 1].Текст = СловаАнон[Кол - 1].Текст Тогда
			Пары.Вставить(0, Новый Структура("ИндОриг, ИндАнон",
				СловаОриг[Р - 1].Инд, СловаАнон[Кол - 1].Инд));
			Р = Р - 1; Кол = Кол - 1;
		ИначеЕсли DP[(Р - 1) * (М + 1) + Кол] > DP[Р * (М + 1) + (Кол - 1)] Тогда
			Р = Р - 1;
		Иначе
			Кол = Кол - 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Пары;
КонецФункции

// Рендерит пару gap-ов с подсветкой: вычисляет общий prefix/suffix по тексту токенов,
// выводит их без подсветки, различающуюся середину - в span.
// Возвращает Структура("Оригинал, Анонимизированный").
&НаКлиентеНаСервереБезКонтекста
Функция СобратьHTMLПарыГэповСПодсветкой(ТокеныО, НачО, КонО, ТокеныА, НачА, КонА)
	ДлО = ?(НачО > КонО, 0, КонО - НачО + 1);
	ДлА = ?(НачА > КонА, 0, КонА - НачА + 1);

	// Общий префикс
	ОбщПреф = 0;
	Пока ОбщПреф < ДлО И ОбщПреф < ДлА Цикл
		Если ТокеныО[НачО + ОбщПреф].Текст = ТокеныА[НачА + ОбщПреф].Текст Тогда
			ОбщПреф = ОбщПреф + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Общий суффикс (без перекрытия с префиксом)
	ОбщСуф = 0;
	Пока (ОбщПреф + ОбщСуф < ДлО) И (ОбщПреф + ОбщСуф < ДлА) Цикл
		Если ТокеныО[НачО + ДлО - 1 - ОбщСуф].Текст = ТокеныА[НачА + ДлА - 1 - ОбщСуф].Текст Тогда
			ОбщСуф = ОбщСуф + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Префикс (общий, без подсветки)
	ПрефО = ""; ПрефА = "";
	Для Нп = 0 По ОбщПреф - 1 Цикл
		ПрефО = ПрефО + HTMLЭскейп(ТокеныО[НачО + Нп].Текст);
		ПрефА = ПрефА + HTMLЭскейп(ТокеныА[НачА + Нп].Текст);
	КонецЦикла;

	// Середина (различающаяся, в span)
	СерО = "";
	Для Нп = НачО + ОбщПреф По НачО + ДлО - 1 - ОбщСуф Цикл
		СерО = СерО + HTMLЭскейп(ТокеныО[Нп].Текст);
	КонецЦикла;
	СерА = "";
	Для Нп = НачА + ОбщПреф По НачА + ДлА - 1 - ОбщСуф Цикл
		СерА = СерА + HTMLЭскейп(ТокеныА[Нп].Текст);
	КонецЦикла;

	// Суффикс (общий, без подсветки)
	СуфО = ""; СуфА = "";
	Для Нп = 0 По ОбщСуф - 1 Цикл
		СуфО = СуфО + HTMLЭскейп(ТокеныО[НачО + ДлО - ОбщСуф + Нп].Текст);
		СуфА = СуфА + HTMLЭскейп(ТокеныА[НачА + ДлА - ОбщСуф + Нп].Текст);
	КонецЦикла;

	РезО = ПрефО + ?(СерО <> "", "<span class=""changed-orig"">" + СерО + "</span>", "") + СуфО;
	РезА = ПрефА + ?(СерА <> "", "<span class=""changed-anon"">" + СерА + "</span>", "") + СуфА;
	Возврат Новый Структура("Оригинал, Анонимизированный", РезО, РезА);
КонецФункции

// Построить HTML с inline-подсветкой изменённых токенов через парный обход гэпов
// ТекстОриг, ТекстАнон - чистые строки (НЕ экранированные)
// Возвращает Структура("Оригинал, Анонимизированный, ВесьЯчейка")
&НаКлиентеНаСервереБезКонтекста
Функция ПодсветитьДиффСтрок(ТекстОриг, ТекстАнон)
	Рез = Новый Структура("Оригинал, Анонимизированный, ВесьЯчейка", "", "", Ложь);
	Если ТекстОриг = ТекстАнон Тогда
		Рез.Оригинал         = HTMLЭскейп(ТекстОриг);
		Рез.Анонимизированный = HTMLЭскейп(ТекстАнон);
		Возврат Рез;
	КонецЕсли;

	ТокеныОриг = ТокенизироватьСтроку(ТекстОриг);
	ТокеныАнон = ТокенизироватьСтроку(ТекстАнон);
	Пары = ВычислитьLCSТокенов(ТокеныОриг, ТокеныАнон);
	Если Пары.Количество() = 0 Тогда
		Рез.Оригинал         = HTMLЭскейп(ТекстОриг);
		Рез.Анонимизированный = HTMLЭскейп(ТекстАнон);
		Рез.ВесьЯчейка        = Истина;
		Возврат Рез;
	КонецЕсли;

	БуфОриг = ""; БуфАнон = "";
	ПредО = -1;   ПредА = -1;

	Для Каждого Пара Из Пары Цикл
		ГэпОHTML = ""; ГэпОТекст = "";
		Для Нп = ПредО + 1 По Пара.ИндОриг - 1 Цикл
			ГэпОHTML  = ГэпОHTML  + HTMLЭскейп(ТокеныОриг[Нп].Текст);
			ГэпОТекст = ГэпОТекст + ТокеныОриг[Нп].Текст;
		КонецЦикла;
		ГэпАHTML = ""; ГэпАТекст = "";
		Для Нп = ПредА + 1 По Пара.ИндАнон - 1 Цикл
			ГэпАHTML  = ГэпАHTML  + HTMLЭскейп(ТокеныАнон[Нп].Текст);
			ГэпАТекст = ГэпАТекст + ТокеныАнон[Нп].Текст;
		КонецЦикла;
		Если ГэпОТекст <> ГэпАТекст Тогда
			ПараГэпов = СобратьHTMLПарыГэповСПодсветкой(ТокеныОриг, ПредО + 1, Пара.ИндОриг - 1, ТокеныАнон, ПредА + 1, Пара.ИндАнон - 1);
			БуфОриг = БуфОриг + ПараГэпов.Оригинал;
			БуфАнон = БуфАнон + ПараГэпов.Анонимизированный;
		Иначе
			БуфОриг = БуфОриг + ГэпОHTML;
			БуфАнон = БуфАнон + ГэпАHTML;
		КонецЕсли;
		БуфОриг = БуфОриг + HTMLЭскейп(ТокеныОриг[Пара.ИндОриг].Текст);
		БуфАнон = БуфАнон + HTMLЭскейп(ТокеныАнон[Пара.ИндАнон].Текст);
		ПредО = Пара.ИндОриг; ПредА = Пара.ИндАнон;
	КонецЦикла;

	// Хвостовые гэпы
	ГэпОТекст = ""; ГэпОHTML = ""; ГэпАТекст = ""; ГэпАHTML = "";
	Для Нп = ПредО + 1 По ТокеныОриг.Количество() - 1 Цикл
		ГэпОТекст = ГэпОТекст + ТокеныОриг[Нп].Текст;
		ГэпОHTML  = ГэпОHTML  + HTMLЭскейп(ТокеныОриг[Нп].Текст);
	КонецЦикла;
	Для Нп = ПредА + 1 По ТокеныАнон.Количество() - 1 Цикл
		ГэпАТекст = ГэпАТекст + ТокеныАнон[Нп].Текст;
		ГэпАHTML  = ГэпАHTML  + HTMLЭскейп(ТокеныАнон[Нп].Текст);
	КонецЦикла;
	Если ГэпОТекст <> ГэпАТекст Тогда
		ПараГэпов = СобратьHTMLПарыГэповСПодсветкой(
			ТокеныОриг, ПредО + 1, ТокеныОриг.Количество() - 1,
			ТокеныАнон, ПредА + 1, ТокеныАнон.Количество() - 1);
		БуфОриг = БуфОриг + ПараГэпов.Оригинал;
		БуфАнон = БуфАнон + ПараГэпов.Анонимизированный;
	Иначе
		БуфОриг = БуфОриг + ГэпОHTML;
		БуфАнон = БуфАнон + ГэпАHTML;
	КонецЕсли;

	Рез.Оригинал         = БуфОриг;
	Рез.Анонимизированный = БуфАнон;
	Возврат Рез;
КонецФункции

// Нормализовать пару значений ячейки с inline-подсветкой изменений
// Возвращает Структура("Оригинал, Анонимизированный")
&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьПаруЗначенийСПодсветкой(ЗначОриг, ЗначАнон)
	Рез = Новый Структура("Оригинал, Анонимизированный, ВесьЯчейка", "", "", Ложь);
	ТипОриг = ТипЗнч(ЗначОриг);
	ТипАнон = ТипЗнч(ЗначАнон);

	// Несовместимые типы (один - массив, другой нет): whole-cell highlight
	Если (ТипОриг = Тип("Массив")) <> (ТипАнон = Тип("Массив")) Тогда
		Рез.Оригинал         = НормализоватьЗначениеДляHTML(ЗначОриг);
		Рез.Анонимизированный = НормализоватьЗначениеДляHTML(ЗначАнон);
		Рез.ВесьЯчейка        = Истина;
		Возврат Рез;
	КонецЕсли;

	// Оба - массивы: рекурсивно поэлементно, агрегируем ВесьЯчейка
	Если ТипОриг = Тип("Массив") И ТипАнон = Тип("Массив") Тогда
		КолОриг = ЗначОриг.Количество();
		КолАнон = ЗначАнон.Количество();
		Макс    = ?(КолОриг > КолАнон, КолОриг, КолАнон);
		// ВсеЯчейка = Истина только если длины равны, все элементы изменились и ни один не имеет inline diff
		ВсеЯчейка = (КолОриг = КолАнон);
		БуфОриг = "<ul style=""margin:0;padding-left:16px"">";
		БуфАнон = "<ul style=""margin:0;padding-left:16px"">";
		Для Нп = 0 По Макс - 1 Цикл
			ЭлОриг    = ?(Нп < КолОриг, ЗначОриг[Нп], Неопределено);
			ЭлАнон    = ?(Нп < КолАнон, ЗначАнон[Нп], Неопределено);
			ЗнОригHTML = НормализоватьЗначениеДляHTML(ЭлОриг);
			ЗнАнонHTML = НормализоватьЗначениеДляHTML(ЭлАнон);
			Если ЗнОригHTML = ЗнАнонHTML Тогда
				// элемент не изменился - inline не нужен, но ВсеЯчейка снимаем
				ВсеЯчейка = Ложь;
				БуфОриг = БуфОриг + "<li>" + ЗнОригHTML + "</li>";
				БуфАнон = БуфАнон + "<li>" + ЗнАнонHTML + "</li>";
			Иначе
				ПараЭл = НормализоватьПаруЗначенийСПодсветкой(ЭлОриг, ЭлАнон);
				Если НЕ ПараЭл.ВесьЯчейка Тогда
					ВсеЯчейка = Ложь;
					БуфОриг = БуфОриг + "<li>"                       + ПараЭл.Оригинал         + "</li>";
					БуфАнон = БуфАнон + "<li>"                       + ПараЭл.Анонимизированный + "</li>";
				Иначе
					БуфОриг = БуфОриг + "<li class=""changed-orig"">" + ПараЭл.Оригинал         + "</li>";
					БуфАнон = БуфАнон + "<li class=""changed-anon"">" + ПараЭл.Анонимизированный + "</li>";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ВсеЯчейка Тогда
			Рез.Оригинал         = НормализоватьЗначениеДляHTML(ЗначОриг);
			Рез.Анонимизированный = НормализоватьЗначениеДляHTML(ЗначАнон);
			Рез.ВесьЯчейка        = Истина;
		Иначе
			Рез.Оригинал         = БуфОриг + "</ul>";
			Рез.Анонимизированный = БуфАнон + "</ul>";
		КонецЕсли;
		Возврат Рез;
	КонецЕсли;

	// Скаляры и объекты: diff по строковому представлению
	СтрОриг = ПолучитьСкалярСтроку(ЗначОриг);
	СтрАнон = ПолучитьСкалярСтроку(ЗначАнон);
	ВОбъект = ЭтоОбъектБезPresentation(ЗначОриг) Или ЭтоОбъектБезPresentation(ЗначАнон);
	Дифф    = ПодсветитьДиффСтрок(СтрОриг, СтрАнон);
	Если ВОбъект Тогда
		Рез.Оригинал         = "<code>" + Дифф.Оригинал         + "</code>";
		Рез.Анонимизированный = "<code>" + Дифф.Анонимизированный + "</code>";
	Иначе
		Рез.Оригинал         = Дифф.Оригинал;
		Рез.Анонимизированный = Дифф.Анонимизированный;
	КонецЕсли;
	Рез.ВесьЯчейка = Дифф.ВесьЯчейка;
	Возврат Рез;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьКлючиОбъектов(МассивОбъектов)
	// Возвращает массив ключей — объединение всех ключей всех строк
	КлючиСоответствие = Новый Соответствие;
	КлючиМассив = Новый Массив;
	Для Каждого Объект Из МассивОбъектов Цикл
		Если ТипЗнч(Объект) = Тип("Структура") Тогда
			Для Каждого КЗ Из Объект Цикл
				Если КлючиСоответствие[КЗ.Ключ] = Неопределено Тогда
					КлючиСоответствие[КЗ.Ключ] = Истина;
					КлючиМассив.Добавить(КЗ.Ключ);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
			Для Каждого КЗ Из Объект Цикл
				Если КлючиСоответствие[КЗ.Ключ] = Неопределено Тогда
					КлючиСоответствие[КЗ.Ключ] = Истина;
					КлючиМассив.Добавить(КЗ.Ключ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат КлючиМассив;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЗначениеОбъекта(Объект, Ключ)
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Зн = Неопределено;
		Объект.Свойство(Ключ, Зн);
		Возврат Зн;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект[Ключ];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьHTMLТаблицуИзМассиваОбъектов(МассивОриг, МассивАнон, Колонки)
	ЕстьИзменения = Ложь;
	HTMLОриг = "<table><tr>";
	HTMLАнон = "<table><tr>";
	Для Каждого Кол Из Колонки Цикл
		HTMLОриг = HTMLОриг + "<th>" + HTMLЭскейп(Строка(Кол)) + "</th>";
		HTMLАнон = HTMLАнон + "<th>" + HTMLЭскейп(Строка(Кол)) + "</th>";
	КонецЦикла;
	HTMLОриг = HTMLОриг + "</tr>";
	HTMLАнон = HTMLАнон + "</tr>";

	КолВо = МассивОриг.Количество();
	Если КолВо > 200 Тогда КолВо = 200; КонецЕсли;

	Для НдкО = 0 По КолВо - 1 Цикл
		ОригСтрока = МассивОриг[НдкО];
		АнонСтрока = Неопределено;
		Если НдкО < МассивАнон.Количество() Тогда
			АнонСтрока = МассивАнон[НдкО];
		КонецЕсли;
		HTMLОриг = HTMLОриг + "<tr>";
		HTMLАнон = HTMLАнон + "<tr>";
		Для Каждого Кол Из Колонки Цикл
			РВОриг = ПолучитьЗначениеОбъекта(ОригСтрока, Кол);
			РВАнон = РВОриг;
			Если АнонСтрока <> Неопределено Тогда
				РВАнон = ПолучитьЗначениеОбъекта(АнонСтрока, Кол);
			КонецЕсли;
			ЗнОриг = НормализоватьЗначениеДляHTML(РВОриг);
			ЗнАнон = НормализоватьЗначениеДляHTML(РВАнон);
			Если ЗнОриг <> ЗнАнон Тогда
				ЕстьИзменения = Истина;
				ПараHTMLДифф = НормализоватьПаруЗначенийСПодсветкой(РВОриг, РВАнон);
				Если ПараHTMLДифф.ВесьЯчейка Тогда
					HTMLОриг = HTMLОриг + "<td class=""changed-orig"">" + ПараHTMLДифф.Оригинал         + "</td>";
					HTMLАнон = HTMLАнон + "<td class=""changed-anon"">" + ПараHTMLДифф.Анонимизированный + "</td>";
				Иначе
					HTMLОриг = HTMLОриг + "<td>" + ПараHTMLДифф.Оригинал         + "</td>";
					HTMLАнон = HTMLАнон + "<td>" + ПараHTMLДифф.Анонимизированный + "</td>";
				КонецЕсли;
			Иначе
				HTMLОриг = HTMLОриг + "<td>" + ЗнОриг + "</td>";
				HTMLАнон = HTMLАнон + "<td>" + ЗнАнон + "</td>";
			КонецЕсли;
		КонецЦикла;
		HTMLОриг = HTMLОриг + "</tr>";
		HTMLАнон = HTMLАнон + "</tr>";
	КонецЦикла;

	Если МассивОриг.Количество() > 200 Тогда
		Стр = "<tr><td colspan=""" + Колонки.Количество() + """>Показано 200 из "
			+ МассивОриг.Количество() + " строк</td></tr>";
		HTMLОриг = HTMLОриг + Стр;
		HTMLАнон = HTMLАнон + Стр;
	КонецЕсли;

	HTMLОриг = HTMLОриг + "</table>";
	HTMLАнон = HTMLАнон + "</table>";
	Возврат Новый Структура("Оригинал, Анонимизированный, ЕстьИзменения", HTMLОриг, HTMLАнон, ЕстьИзменения);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьHTMLТаблицуИзМассиваСкаляров(МассивОриг, МассивАнон)
	ЕстьИзменения = Ложь;
	HTMLОриг = "<ol>";
	HTMLАнон = "<ol>";
	КолВо = МассивОриг.Количество();
	Если КолВо > 200 Тогда КолВо = 200; КонецЕсли;
	Для НдкО = 0 По КолВо - 1 Цикл
		РВОриг = МассивОриг[НдкО];
		РВАнон = РВОриг;
		Если НдкО < МассивАнон.Количество() Тогда
			РВАнон = МассивАнон[НдкО];
		КонецЕсли;
		ЗнОриг = НормализоватьЗначениеДляHTML(РВОриг);
		ЗнАнон = НормализоватьЗначениеДляHTML(РВАнон);
		Если ЗнОриг <> ЗнАнон Тогда
			ЕстьИзменения = Истина;
			ПараHTMLДифф = НормализоватьПаруЗначенийСПодсветкой(РВОриг, РВАнон);
			Если ПараHTMLДифф.ВесьЯчейка Тогда
				HTMLОриг = HTMLОриг + "<li class=""changed-orig"">" + ПараHTMLДифф.Оригинал         + "</li>";
				HTMLАнон = HTMLАнон + "<li class=""changed-anon"">" + ПараHTMLДифф.Анонимизированный + "</li>";
			Иначе
				HTMLОриг = HTMLОриг + "<li>" + ПараHTMLДифф.Оригинал         + "</li>";
				HTMLАнон = HTMLАнон + "<li>" + ПараHTMLДифф.Анонимизированный + "</li>";
			КонецЕсли;
		Иначе
			HTMLОриг = HTMLОриг + "<li>" + ЗнОриг + "</li>";
			HTMLАнон = HTMLАнон + "<li>" + ЗнАнон + "</li>";
		КонецЕсли;
	КонецЦикла;
	Если МассивОриг.Количество() > 200 Тогда
		HTMLОриг = HTMLОриг + "<li>Показано 200 из " + МассивОриг.Количество() + " строк</li>";
		HTMLАнон = HTMLАнон + "<li>Показано 200 из " + МассивАнон.Количество() + " строк</li>";
	КонецЕсли;
	HTMLОриг = HTMLОриг + "</ol>";
	HTMLАнон = HTMLАнон + "</ol>";
	Возврат Новый Структура("Оригинал, Анонимизированный, ЕстьИзменения", HTMLОриг, HTMLАнон, ЕстьИзменения);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьHTMLТаблицуИзОбъекта(ОригОбъект, АнонОбъект)
	ЕстьИзменения = Ложь;
	HTMLОриг = "<table><tr><th>Ключ</th><th>Значение</th></tr>";
	HTMLАнон = "<table><tr><th>Ключ</th><th>Значение</th></tr>";
	Ключи = Новый Массив;
	Если ТипЗнч(ОригОбъект) = Тип("Структура") Тогда
		Для Каждого КЗ Из ОригОбъект Цикл Ключи.Добавить(КЗ.Ключ); КонецЦикла;
	ИначеЕсли ТипЗнч(ОригОбъект) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из ОригОбъект Цикл Ключи.Добавить(КЗ.Ключ); КонецЦикла;
	КонецЕсли;
	Для Каждого Ключ Из Ключи Цикл
		РВОриг = ПолучитьЗначениеОбъекта(ОригОбъект, Ключ);
		РВАнон = ПолучитьЗначениеОбъекта(АнонОбъект, Ключ);
		ЗнОриг = НормализоватьЗначениеДляHTML(РВОриг);
		ЗнАнон = НормализоватьЗначениеДляHTML(РВАнон);
		Если ЗнОриг <> ЗнАнон Тогда
			ЕстьИзменения = Истина;
			ПараHTMLДифф = НормализоватьПаруЗначенийСПодсветкой(РВОриг, РВАнон);
			КлючHTML = HTMLЭскейп(Строка(Ключ));
			Если ПараHTMLДифф.ВесьЯчейка Тогда
				HTMLОриг = HTMLОриг + "<tr><td>" + КлючHTML + "</td><td class=""changed-orig"">" + ПараHTMLДифф.Оригинал         + "</td></tr>";
				HTMLАнон = HTMLАнон + "<tr><td>" + КлючHTML + "</td><td class=""changed-anon"">" + ПараHTMLДифф.Анонимизированный + "</td></tr>";
			Иначе
				HTMLОриг = HTMLОриг + "<tr><td>" + КлючHTML + "</td><td>" + ПараHTMLДифф.Оригинал         + "</td></tr>";
				HTMLАнон = HTMLАнон + "<tr><td>" + КлючHTML + "</td><td>" + ПараHTMLДифф.Анонимизированный + "</td></tr>";
			КонецЕсли;
		Иначе
			HTMLОриг = HTMLОриг + "<tr><td>" + HTMLЭскейп(Строка(Ключ)) + "</td><td>" + ЗнОриг + "</td></tr>";
			HTMLАнон = HTMLАнон + "<tr><td>" + HTMLЭскейп(Строка(Ключ)) + "</td><td>" + ЗнАнон + "</td></tr>";
		КонецЕсли;
	КонецЦикла;
	HTMLОриг = HTMLОриг + "</table>";
	HTMLАнон = HTMLАнон + "</table>";
	Возврат Новый Структура("Оригинал, Анонимизированный, ЕстьИзменения", HTMLОриг, HTMLАнон, ЕстьИзменения);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьHTMLДляСравненияАнонимизации(ОригиналJSON, АнонимJSON)
	ОбертываниеCSS = "<html><head><meta charset=""utf-8""><style>"
		+ "body{font-family:sans-serif;font-size:11px;margin:4px}"
		+ "table{border-collapse:collapse;width:100%}"
		+ "th{background:#f0f0f0;border:1px solid #ccc;padding:3px 6px}"
		+ "td{border:1px solid #ddd;padding:3px 6px;vertical-align:top}"
		+ ".changed-orig{background:#FFF3CD}"
		+ ".changed-anon{background:#D4EDDA}"
		+ "</style></head><body>";
	ОбертываниеКонец = "</body></html>";

	Рез = Новый Структура("Оригинал, Анонимизированный, ЕстьИзменения", "", "", Ложь);
	Попытка
		ОригДанные = ПрочитатьJSON2(ОригиналJSON);
		АнонДанные = ПрочитатьJSON2(АнонимJSON);
	Исключение
		ЗнОриг = HTMLЭскейп(ОригиналJSON);
		ЗнАнон = HTMLЭскейп(АнонимJSON);
		ЕстьИзм = (ЗнОриг <> ЗнАнон);
		Рез.Оригинал         = ОбертываниеCSS + "<pre>" + ЗнОриг + "</pre>" + ОбертываниеКонец;
		Рез.Анонимизированный = ОбертываниеCSS + "<pre>" + ЗнАнон + "</pre>" + ОбертываниеКонец;
		Рез.ЕстьИзменения    = ЕстьИзм;
		Возврат Рез;
	КонецПопытки;

	ТипОриг = ТипЗнч(ОригДанные);
	ТипАнон = ТипЗнч(АнонДанные);

	ЧастичныйРезультат = Неопределено;

	Если ТипОриг = Тип("Массив") И ТипАнон = Тип("Массив") Тогда
		// Таблица только если ВСЕ элементы обоих массивов — объекты (смешанный → список)
		ВсеОбъекты = Истина;
		Для Каждого Эл Из ОригДанные Цикл
			Если ТипЗнч(Эл) <> Тип("Структура") И ТипЗнч(Эл) <> Тип("Соответствие") Тогда
				ВсеОбъекты = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ВсеОбъекты Тогда
			Для Каждого Эл Из АнонДанные Цикл
				Если ТипЗнч(Эл) <> Тип("Структура") И ТипЗнч(Эл) <> Тип("Соответствие") Тогда
					ВсеОбъекты = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ВсеОбъекты Тогда
			Колонки = СобратьКлючиОбъектов(ОригДанные);
			ДопКолонки = СобратьКлючиОбъектов(АнонДанные);
			Для Каждого К Из ДопКолонки Цикл
				НайденоВОсн = Ложь;
				Для Каждого КО Из Колонки Цикл
					Если КО = К Тогда НайденоВОсн = Истина; Прервать; КонецЕсли;
				КонецЦикла;
				Если НЕ НайденоВОсн Тогда Колонки.Добавить(К); КонецЕсли;
			КонецЦикла;
			ЧастичныйРезультат = СформироватьHTMLТаблицуИзМассиваОбъектов(ОригДанные, АнонДанные, Колонки);
		Иначе
			ЧастичныйРезультат = СформироватьHTMLТаблицуИзМассиваСкаляров(ОригДанные, АнонДанные);
		КонецЕсли;
	ИначеЕсли (ТипОриг = Тип("Структура") Или ТипОриг = Тип("Соответствие"))
		И (ТипАнон = Тип("Структура") Или ТипАнон = Тип("Соответствие")) Тогда
		ЧастичныйРезультат = СформироватьHTMLТаблицуИзОбъекта(ОригДанные, АнонДанные);
	Иначе
		ЗнОриг = HTMLЭскейп(ОригиналJSON);
		ЗнАнон = HTMLЭскейп(АнонимJSON);
		ЧастичныйРезультат = Новый Структура("Оригинал, Анонимизированный, ЕстьИзменения",
			"<pre>" + ЗнОриг + "</pre>",
			"<pre>" + ЗнАнон + "</pre>",
			ЗнОриг <> ЗнАнон);
	КонецЕсли;

	Рез.Оригинал          = ОбертываниеCSS + ЧастичныйРезультат.Оригинал + ОбертываниеКонец;
	Рез.Анонимизированный = ОбертываниеCSS + ЧастичныйРезультат.Анонимизированный + ОбертываниеКонец;
	Рез.ЕстьИзменения     = ЧастичныйРезультат.ЕстьИзменения;
	Возврат Рез;
КонецФункции

