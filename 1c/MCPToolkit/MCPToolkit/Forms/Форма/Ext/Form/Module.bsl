&НаКлиентеНаСервереБезКонтекста
Функция МКПРазобратьВход(СтрокаВхода)
	ПервыйРазделитель = Найти(СтрокаВхода, ";");
	Если ПервыйРазделитель = 0 Тогда ВызватьИсключение "Не переданы данные запуска MCP Toolkit."; КонецЕсли;
	РежимЗапуска = Лев(СтрокаВхода, ПервыйРазделитель - 1);
	Если РежимЗапуска <> "autostart" И РежимЗапуска <> "coldstart" Тогда
		ВызватьИсключение "Неизвестный режим запуска MCP Toolkit.";
	КонецЕсли;
	ОстатокВхода = Сред(СтрокаВхода, ПервыйРазделитель + 1);
	ВторойРазделитель = Найти(ОстатокВхода, ";");
	Если ВторойРазделитель = 0 Тогда ВызватьИсключение "Не передан файл данных запуска MCP Toolkit."; КонецЕсли;
	МеткаЗапуска = Лев(ОстатокВхода, ВторойРазделитель - 1);
	ВозрастЗапуска = ТекущаяДата() - Дата(МеткаЗапуска);
	Если ВозрастЗапуска < 0 Или ВозрастЗапуска > 300 Тогда ВызватьИсключение "Срок действия входа MCP Toolkit истёк."; КонецЕсли;
	ПутьЗапуска = Сред(ОстатокВхода, ВторойРазделитель + 1);
	Если ПустаяСтрока(ПутьЗапуска) Тогда ВызватьИсключение "Не передан файл данных запуска MCP Toolkit."; КонецЕсли;
	Возврат Новый Структура("mode,path", РежимЗапуска, ПутьЗапуска);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура МКППроверитьКонтракт(ДанныеЗапуска)
	Если ТипЗнч(ДанныеЗапуска) <> Тип("Структура") Тогда ВызватьИсключение "Неверный формат данных запуска."; КонецЕсли;
	ВерсияЗапуска = Неопределено;
	Если Не ДанныеЗапуска.Свойство("protocol_version", ВерсияЗапуска) Или ВерсияЗапуска <> МКПВерсияКонтракта() Тогда
		ВызватьИсключение "Версия контракта запуска не поддерживается.";
	КонецЕсли;
	ИдОперации = Неопределено;
	Если Не ДанныеЗапуска.Свойство("operation_id", ИдОперации) Или ТипЗнч(ИдОперации) <> Тип("Строка") Тогда
		ВызватьИсключение "Не передан идентификатор операции запуска.";
	КонецЕсли;
	UUIDОперации = Новый УникальныйИдентификатор(ИдОперации);
	КаталогОперации = Неопределено;
	Если Не ДанныеЗапуска.Свойство("operation_dir", КаталогОперации)
		Или ТипЗнч(КаталогОперации) <> Тип("Строка") Или ПустаяСтрока(КаталогОперации) Тогда
		ВызватьИсключение "Не передан каталог операции запуска.";
	КонецЕсли;
	ИсточникЗапуска = Неопределено;
	Если Не ДанныеЗапуска.Свойство("source", ИсточникЗапуска) Или ТипЗнч(ИсточникЗапуска) <> Тип("Структура") Тогда
		ВызватьИсключение "Не передан источник запуска.";
	КонецЕсли;
	Если ИсточникЗапуска.kind <> "registration" Или ИсточникЗапуска.command_id <> "ОткрытьMCPToolkit" Тогда
		ВызватьИсключение "Загрузчик поддерживает только клиентскую команду MCP Toolkit из регистрации.";
	КонецЕсли;
	UUIDРегистрации = Новый УникальныйИдентификатор(ИсточникЗапуска.registration_id);
	Если ТипЗнч(ИсточникЗапуска.registration_fingerprint) <> Тип("Строка") Или ПустаяСтрока(ИсточникЗапуска.registration_fingerprint) Тогда
		ВызватьИсключение "Не передан отпечаток зарегистрированной обработки.";
	КонецЕсли;
	Если ТипЗнч(ДанныеЗапуска.connection_settings) <> Тип("Структура") Тогда ВызватьИсключение "Не переданы настройки подключения."; КонецЕсли;
	Если ТипЗнч(ДанныеЗапуска.signal_path) <> Тип("Строка") Или ПустаяСтрока(ДанныеЗапуска.signal_path) Тогда
		ВызватьИсключение "Не передан путь результата запуска.";
	КонецЕсли;
КонецПроцедуры

