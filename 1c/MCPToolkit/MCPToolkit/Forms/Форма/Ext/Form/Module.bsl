&НаКлиенте
Процедура ПриИзмененииРежимаПодключения(Элемент)

	ПроксиРежим = (РежимПодключения = 0);

	// Видимость групп
	Элементы.ГруппаПроксиНастройки.Видимость = ПроксиРежим;
	Элементы.ГруппаВстроенныйСервер.Видимость = НЕ ПроксиРежим;
	Элементы.СтраницаАнонимизация.Видимость = Истина;
	Элементы.КнопкаОбновитьМаппинги.Видимость = ПроксиРежим;
	Элементы.КнопкаАнонимизировать.Видимость = НЕ ПроксиРежим;
	// Лимит маппинга — только встроенный режим (в прокси задаётся через env)
	Элементы.ЛимитМаппингаВстроенныйПоле.Видимость = НЕ ПроксиРежим;

	// Заголовки кнопок
	Если ПроксиРежим Тогда
		Элементы.КнопкаПодключиться.Заголовок = "Подключиться";
		Элементы.КнопкаОтключиться.Заголовок = "Отключиться";
	Иначе
		Элементы.КнопкаПодключиться.Заголовок = "Запустить сервер";
		Элементы.КнопкаОтключиться.Заголовок = "Остановить сервер";
	КонецЕсли;

	СохранитьРежимПодключенияНаСервере(РежимПодключения);
	ОбновитьСводкуПравилТочнойАнонимизацииНаСервере();

	// В режиме встроенного сервера сразу обновляем список адресов: базовые пункты показываются
	// мгновенно, реальные интерфейсы подтягиваются (загрузка компоненты при необходимости).
	Если НЕ ПроксиРежим Тогда
		ОбновитьСписокАдресов();
	КонецЕсли;

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ЗАПУСК / ОСТАНОВКА ВСТРОЕННОГО СЕРВЕРА
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ЗапуститьВстроенныйСервер()
	СохранитьПортВстроенногоСервераНаСервере(ПортВстроенногоСервера);
	Если ВстроенныйСерверЗапущен ИЛИ ЗапускСервераВПроцессе Тогда
		ДобавитьВЛог("Сервер уже запущен или запускается");
		Возврат;
	КонецЕсли;

	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		ЗапускСервераВПроцессе = Истина;
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияМакетаМСП_ЗапускСервера", ЭтаФорма),
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport", "MCPHttp");
	Иначе
		ЗапуститьВстроенныйСерверСинхронно(); // 8.2.x / "Использовать"
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьАсинхронноеПодключениеКомпоненты(ОписаниеОповещения, Местоположение, Имя)
	Выполнить("НачатьПодключениеВнешнейКомпоненты(ОписаниеОповещения, Местоположение, Имя, ТипВнешнейКомпоненты.Native)");
КонецПроцедуры

// Колбэки async-цепочки запуска сервера

&НаКлиенте
Процедура ПослеПодключенияМакетаМСП_ЗапускСервера(Подключено, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если Подключено Тогда
		ЗапускСервера_ПодключитьТун();
	Иначе
		// Fallback: получить .dll с сервера, записать во временный файл
		ДвоичныеДанные = ПолучитьМакетНаСервере();
		ИмяФайла = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ИмяФайла);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияФайлаМСП_ЗапускСервера", ЭтаФорма),
			ИмяФайла, "MCPHttp");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаМСП_ЗапускСервера(Подключено, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если НЕ Подключено Тогда
		ЗапускСервераВПроцессе = Ложь;
		ДобавитьВЛог("Не удалось подключить внешнюю компоненту MCPHttp");
		ЗавершитьАвтостартСОшибкой("Server add-in load failed");
		Возврат;
	КонецЕсли;
	ЗапускСервера_ПодключитьТун();
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_ПодключитьТун()
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
	НачатьАсинхронноеПодключениеКомпоненты(
		Новый ОписаниеОповещения("ПослеПодключенияМакетаТун_ЗапускСервера", ЭтаФорма),
		"ВнешняяОбработка.MCPToolkit.Макет.ToonConverter", "ToonConv");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияМакетаТун_ЗапускСервера(Подключено, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если Подключено Тогда
		ЗапускСервера_ПодключитьSyntaxHelp(Истина);
	Иначе
		// Fallback: ToonConverter из файла
		ДвоичныеДанные = ПолучитьМакетТунКонвертераНаСервере();
		ИмяФайла = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ИмяФайла);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияФайлаТун_ЗапускСервера", ЭтаФорма),
			ИмяФайла, "ToonConv");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаТун_ЗапускСервера(Подключено, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	ЗапускСервера_ПодключитьSyntaxHelp(Подключено); // ToonConverter некритична: даже если нет — продолжаем
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_ПодключитьSyntaxHelp(ТунПодключён)
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	НачатьАсинхронноеПодключениеКомпоненты(
		Новый ОписаниеОповещения("ПослеПодключенияМакетаSyntaxHelp_Запуск", ЭтаФорма, ТунПодключён),
		"ВнешняяОбработка.MCPToolkit.Макет.SyntaxHelpReader", "SyntaxH");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияМакетаSyntaxHelp_Запуск(Подключено, ТунПодключён) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если Подключено Тогда
		СоздатьОбъектSyntaxHelpИИнициализировать();
		ЗапускСервера_ПодключитьScreenCapture(ТунПодключён);
		Возврат;
	КонецЕсли;
	// Fallback через файл
	Попытка
		ДвоичныеДанные = ПолучитьМакетSyntaxHelpНаСервере();
		ВремФайл = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ВремФайл);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияФайлаSyntaxHelp_Запуск", ЭтаФорма, ТунПодключён),
			ВремФайл, "SyntaxH");
	Исключение
		ЗапускСервера_ПодключитьScreenCapture(ТунПодключён); // SyntaxHelp некритична — продолжаем
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаSyntaxHelp_Запуск(Подключено, ТунПодключён) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если Подключено Тогда
		СоздатьОбъектSyntaxHelpИИнициализировать();
	КонецЕсли;
	ЗапускСервера_ПодключитьScreenCapture(ТунПодключён);
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_ПодключитьScreenCapture(ТунПодключён)
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	НачатьАсинхронноеПодключениеКомпоненты(
		Новый ОписаниеОповещения("ПослеПодключенияМакетаScreenCapture_Запуск", ЭтаФорма, ТунПодключён),
		"ВнешняяОбработка.MCPToolkit.Макет.ScreenCapture", "ScreenCapture");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияМакетаScreenCapture_Запуск(Подключено, ТунПодключён) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если Подключено Тогда
		КомпонентаScreenCapture = Новый("AddIn.ScreenCapture.ScreenCapture");
		КэшСхемИнструментов = Неопределено;
		ЗапускСервера_Финал(ТунПодключён);
		Возврат;
	КонецЕсли;
	Попытка
		ДД = ПолучитьМакетScreenCaptureНаСервере();
		ВремФайл = ПолучитьИмяВременногоФайла("dll");
		ДД.Записать(ВремФайл);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияФайлаScreenCapture_Запуск", ЭтаФорма, ТунПодключён),
			ВремФайл, "ScreenCapture");
	Исключение
		ЗапускСервера_Финал(ТунПодключён); // некритична
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаScreenCapture_Запуск(Подключено, ТунПодключён) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если Подключено Тогда
		КомпонентаScreenCapture = Новый("AddIn.ScreenCapture.ScreenCapture");
		КэшСхемИнструментов = Неопределено;
	КонецЕсли;
	ЗапускСервера_Финал(ТунПодключён);
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_Финал(ТунПодключён)
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если ТунПодключён Тогда
		КомпонентаТун = Новый("AddIn.ToonConv.ToonConverter");
	КонецЕсли;
	// Для kind=interface нужен список адресов — на async-платформе через НачатьВызов (как GetRequestBody)
	Выбор = ВыборАдресаВстроенногоСервера;
	Если Выбор <> Неопределено И Выбор.kind = "interface" Тогда
		Компонента.НачатьВызовПолучитьЛокальныеАдреса(
			Новый ОписаниеОповещения("ЗапускСервера_ПослеАдресов", ЭтаФорма));
		Возврат;
	КонецЕсли;
	ЗапускСервера_СБиндАдресом(ВычислитьАдресПривязки(Выбор, ""));
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_ПослеАдресов(РезВызова, ПарВызова, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	ДжейсонАдресов = ?(РезВызова = Неопределено, "", РезВызова);
	ЗапускСервера_СБиндАдресом(ВычислитьАдресПривязки(ВыборАдресаВстроенногоСервера, ДжейсонАдресов));
КонецПроцедуры

&НаКлиенте
Процедура ЗапускСервера_СБиндАдресом(Адрес)
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	АдресПривязкиВстроенногоСервера = Адрес;
	Компонента.НачатьВызовStart(
		Новый ОписаниеОповещения("ПослеЗапускаВстроенногоСервера", ЭтаФорма),
		ПортВстроенногоСервера, Адрес);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗапускаВстроенногоСервера(РезВызова, ПарВызова, ДопПар) Экспорт
	Если НЕ ЗапускСервераВПроцессе Тогда Возврат; КонецЕсли;
	Если РезВызова = Истина Тогда
		ВстроенныйСерверЗапущен = Истина;
		СнятьВсеЗадания();
		МСПСессии = Новый Соответствие;
		SSEПотоки = Новый Соответствие;
		ЛегасиССЕПотоки = Новый Соответствие;
		ОжидающиеПодтверждения = Новый Соответствие;
		ЗапускСервераВПроцессе = Ложь;
		УстановитьСтатус("Сервер запущен (адрес " + АдресПривязкиВстроенногоСервера + ", порт " + Формат(ПортВстроенногоСервера, "ЧГ=") + ")", Истина);
		ДобавитьВЛог("Встроенный HTTP-сервер запущен на " + АдресПривязкиВстроенногоСервера + ":" + Формат(ПортВстроенногоСервера, "ЧГ="));
		ПодготовитьМаршрутЧерезМодульОбъекта();
		АнонимизаторОчистить();
		Если ИспользоватьТочнуюАнонимизацию Тогда
			ПостроитьИЗаполнитьСловарьАнонимизации();
		КонецЕсли;
		ЗавершитьАвтостартПослеЗапускаВстроенногоСервера();
	Иначе
		ЗапускСервераВПроцессе = Ложь;
		Компонента = Неопределено;
		ДобавитьВЛог("Не удалось запустить сервер на порту " + Формат(ПортВстроенногоСервера, "ЧГ="));
		ЗавершитьАвтостартСОшибкой("Embedded server start failed");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВстроенныйСерверСинхронно()

	Если ВстроенныйСерверЗапущен Тогда
		ДобавитьВЛог("Сервер уже запущен");
		Возврат;
	КонецЕсли;

	// Подключение компоненты MCPHttp
	Попытка
		Результат = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.MCPToolkit.Макет.MCPHttpTransport",
			"MCPHttp", ТипВнешнейКомпоненты.Native);
		Если НЕ Результат Тогда
			// Fallback: загрузка из макета через файл
			ДвоичныеДанные = ПолучитьМакетНаСервере();
			ИмяФайла = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ИмяФайла);
			ПодключитьВнешнююКомпоненту(ИмяФайла, "MCPHttp", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		Компонента = Новый("AddIn.MCPHttp.MCPHttpTransport");
	Исключение
		ДобавитьВЛог("Ошибка подключения компоненты: " + ОписаниеОшибки());
		ЗавершитьАвтостартСОшибкой("Server add-in load failed (sync): " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Подключение ToonConverter
	КомпонентаТун = Неопределено;
	Попытка
		РезТун = ПодключитьВнешнююКомпоненту(
			"ВнешняяОбработка.MCPToolkit.Макет.ToonConverter",
			"ToonConv", ТипВнешнейКомпоненты.Native);
		Если НЕ РезТун Тогда
			ДвоичныеДанные = ПолучитьМакетТунКонвертераНаСервере();
			ИмяФайла = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ИмяФайла);
			ПодключитьВнешнююКомпоненту(ИмяФайла, "ToonConv", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		КомпонентаТун = Новый("AddIn.ToonConv.ToonConverter");
	Исключение
		ДобавитьВЛог("Предупреждение: ToonConverter не загружена. TOON-формат недоступен. " + ОписаниеОшибки());
	КонецПопытки;

	// Подключение SyntaxHelpReader
	ПодключитьКомпонентуSyntaxHelpСинхронно();

	// Подключение ScreenCapture
	ПодключитьКомпонентуScreenCaptureСинхронно();
	
	// [++]  Пак И.О. 23.08.2026 OS-84818 / Разработать механизм ввода начальных остатков для витрины
	// Запуск HTTP-сервера
	АдресПривязкиВстроенногоСервера = ОпределитьАдресПривязкиСинхронно();
		
	// ЛОКАЛЬНАЯ ПРАВКА (ветка local/request-timeout-900), в оригинале этих строк нет.
	ПрименитьТаймаутЗапроса();
	// [--] Пак И.О. 23.08.2026

	Если Компонента.Start(ПортВстроенногоСервера, АдресПривязкиВстроенногоСервера) Тогда
		ВстроенныйСерверЗапущен = Истина;
		СнятьВсеЗадания();
		МСПСессии = Новый Соответствие;
		SSEПотоки = Новый Соответствие;
		ЛегасиССЕПотоки = Новый Соответствие;
		ОжидающиеПодтверждения = Новый Соответствие;
		УстановитьСтатус("Сервер запущен (адрес " + АдресПривязкиВстроенногоСервера + ", порт " + Формат(ПортВстроенногоСервера, "ЧГ=") + ")", Истина);
		ДобавитьВЛог("Встроенный HTTP-сервер запущен на " + АдресПривязкиВстроенногоСервера + ":" + Формат(ПортВстроенногоСервера, "ЧГ="));
		ПодготовитьМаршрутЧерезМодульОбъекта();
		АнонимизаторОчистить();
		Если ИспользоватьТочнуюАнонимизацию Тогда
			ПостроитьИЗаполнитьСловарьАнонимизации();
		КонецЕсли;
		ЗавершитьАвтостартПослеЗапускаВстроенногоСервера();
	Иначе
		ДобавитьВЛог("Не удалось запустить сервер на порту " + Формат(ПортВстроенногоСервера, "ЧГ="));
		Компонента = Неопределено;
		ЗавершитьАвтостартСОшибкой("Embedded server start failed (sync)");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбъектSyntaxHelpИИнициализировать()
	Попытка
		КомпонентаSyntaxHelp = Новый("AddIn.SyntaxH.SyntaxHelpReader");
		КолвоТемBSL = КомпонентаSyntaxHelp.Инициализировать(КаталогПрограммы());
		Если КолвоТемBSL < 0 Тогда
			ДобавитьВЛог("SyntaxHelpReader: ошибка парсинга .hbk файлов (код " + КолвоТемBSL + ")");
			КомпонентаSyntaxHelp = Неопределено;
		ИначеЕсли КолвоТемBSL = 0 Тогда
			ДобавитьВЛог("SyntaxHelpReader: тем не найдено. Проверьте наличие shcntx_ru.hbk и shquery_ru.hbk в " + КаталогПрограммы());
		Иначе
			ДобавитьВЛог("SyntaxHelpReader загружен, тем: " + КолвоТемBSL);
			КэшСхемИнструментов = Неопределено; // сбросить кэш — инструмент теперь доступен
		КонецЕсли;
	Исключение
		КомпонентаSyntaxHelp = Неопределено;
		ДобавитьВЛог("SyntaxHelpReader: исключение при инициализации: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКомпонентуSyntaxHelpСинхронно()
	Попытка
		Если НЕ ПодключитьВнешнююКомпоненту(
				"ВнешняяОбработка.MCPToolkit.Макет.SyntaxHelpReader",
				"SyntaxH", ТипВнешнейКомпоненты.Native) Тогда
			ДвоичныеДанные = ПолучитьМакетSyntaxHelpНаСервере();
			ВремФайл = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ВремФайл);
			ПодключитьВнешнююКомпоненту(ВремФайл, "SyntaxH", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		СоздатьОбъектSyntaxHelpИИнициализировать();
	Исключение
		КомпонентаSyntaxHelp = Неопределено;
	КонецПопытки;
КонецПроцедуры

