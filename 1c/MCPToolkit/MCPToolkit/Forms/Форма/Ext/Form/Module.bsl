//
// Возвращаемое значение:
//  Строка - код ошибки из ТаблицаОшибокСтрогогоРежима (E_TOOL_UNKNOWN, E_TOOL_DISABLED, E_PARAM_INTERNAL,
//           E_PARAM_FORMAT) или пустая строка, если вызов допустим
//
&НаКлиенте
Функция ПроверитьВызовНестрогогоРежима(ИмяИнструмента, Аргументы = Неопределено)

	Включен = СостояниеИнструментаПоТочномуИмени(ИмяИнструмента);

	Если Включен = Неопределено Тогда

		Возврат "E_TOOL_UNKNOWN";

	ИначеЕсли Включен <> Истина Тогда

		Возврат "E_TOOL_DISABLED";

	КонецЕсли;

	Если Аргументы = Неопределено Тогда

		Возврат "";

	КонецЕсли;

	КодОшибки = ПроверитьВнутренниеПоляКлиента(Аргументы);

	Если НЕ ПустаяСтрока(КодОшибки) Тогда

		Возврат КодОшибки;

	КонецЕсли;

	Если ИмяИнструмента = "execute_query" И ЕстьЗарезервированныеПараметрыВАргументах(Аргументы) Тогда

		Возврат "E_PARAM_INTERNAL";

	КонецЕсли;

	Возврат "";

КонецФункции

// Признак зарезервированных имен (МСПТокен...) в execute_query.params. Принимает те виды params, которые
// принимает нестрогий вход: Структура, Соответствие и JSON-строка с объектом. Нераспознанный вид здесь
// пропускается: его отклонит проверка аргументов инструмента.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова execute_query
//
// Возвращаемое значение:
//  Булево - Истина, если среди имен параметров запроса есть зарезервированное
//
&НаКлиенте
Функция ЕстьЗарезервированныеПараметрыВАргументах(Аргументы)

	ПараметрыЗапроса = Неопределено;

	Если НЕ Аргументы.Свойство("params", ПараметрыЗапроса) Тогда

		Возврат Ложь;

	КонецЕсли;

	Если ТипЗнч(ПараметрыЗапроса) = Тип("Строка") Тогда

		Попытка
			ПараметрыЗапроса = ПрочитатьJSON2(ПараметрыЗапроса);
		Исключение
			ПараметрыЗапроса = Неопределено;
		КонецПопытки;

	КонецЕсли;

	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") И ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие") Тогда

		Возврат Ложь;

	КонецЕсли;

	Возврат ЕстьЗарезервированноеИмяПараметра(ПараметрыЗапроса);

КонецФункции

// REST-ответ с ошибкой входа нестрогих режимов. Текст фиксированный (из ТаблицаОшибокСтрогогоРежима), в прежней
// форме тела {success, error}. Код ответа: неизвестный инструмент - 200, как прежде (ошибка в теле), отключенный - 403,
// ошибки параметров - 400.
//
// Параметры:
//  КодОшибки - Строка - код из ПроверитьВызовНестрогогоРежима
//
// Возвращаемое значение:
//  Структура - КодОтвета (Число), Тело (Строка)
//
&НаКлиенте
Функция ОтветОшибкиВходаНестрогогоРежимаREST(КодОшибки)

	КодОтвета = 400;

	Если КодОшибки = "E_TOOL_UNKNOWN" Тогда

		КодОтвета = 200;

	ИначеЕсли КодОшибки = "E_TOOL_DISABLED" Тогда

		КодОтвета = 403;

	КонецЕсли;

	Возврат СформироватьRESTОшибка(КодОтвета, ТаблицаОшибокСтрогогоРежима().Получить(КодОшибки));

КонецФункции

&НаКлиенте
Функция ОбработатьToolsCall(ДанныеЗапроса, ТелоJSON, Ид, ИдПотокаSSE = "")
	ЗафиксироватьИсточникОтвета(ДанныеЗапроса);
	ОпцииВызова = Неопределено;
	ИмяВызова = Неопределено;
	ТелоJSON.Свойство("params", ОпцииВызова);
	Если ТипЗнч(ОпцииВызова) = Тип("Структура") Тогда ОпцииВызова.Свойство("name", ИмяВызова); КонецЕсли;
	Если НЕ ЭтоИзвестныйИнструментMCP(ИмяВызова) Тогда ДанныеЗапроса.Удалить("ИсточникОтвета"); КонецЕсли;
	Результат = ВыполнитьПринятыйToolsCall(ДанныеЗапроса, ТелоJSON, Ид, ИдПотокаSSE);
	Возврат СодержимоеСИсточникомБазы(Результат, ДанныеЗапроса);
КонецФункции

&НаКлиенте
Функция ВыполнитьПринятыйToolsCall(ДанныеЗапроса, ТелоJSON, Ид, ИдПотокаSSE = "")

	// Извлечение params.name и params.arguments
	ПараметрыЗапроса = Неопределено;
	ТелоJSON.Свойство("params", ПараметрыЗапроса);
	Если ПараметрыЗапроса = Неопределено ИЛИ ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
		Возврат СформироватьToolsCallОшибку("Missing params");
	КонецЕсли;

	ИмяИнструмента = "";
	ПараметрыЗапроса.Свойство("name", ИмяИнструмента);
	ОтказВызова = ПроверитьДоступностьИнструментаMCP(ИмяИнструмента);
	Если ОтказВызова <> Неопределено Тогда
		Возврат СформироватьToolsCallРезультат(РезультатОтказаИнструментаMCP(ОтказВызова));
	КонецЕсли;
	ИмяИнструмента = КаноническоеИмяИнструментаMCP(ИмяИнструмента);

	Аргументы = Новый Структура;
	Если НЕ ПараметрыЗапроса.Свойство("arguments", Аргументы) Тогда Аргументы = Новый Структура; КонецЕсли;
	ОтказВызова = ПроверитьВнешниеАргументыMCP(Аргументы);
	Если ОтказВызова <> Неопределено Тогда
		Возврат СформироватьToolsCallРезультат(РезультатОтказаИнструментаMCP(ОтказВызова));
	КонецЕсли;

	Если СостояниеЗащиты.Строгий Или СостояниеЗащиты.Переключение Тогда

		Возврат ОбработатьToolsCallСтрогий(ДанныеЗапроса, ТелоJSON, Ид, ИдПотокаSSE);

	КонецЕсли;

	КодОшибкиВхода = ПроверитьВызовНестрогогоРежима(ИмяИнструмента, Аргументы);

	Если НЕ ПустаяСтрока(КодОшибкиВхода) Тогда

		Возврат СформироватьToolsCallОшибку(ТаблицаОшибокСтрогогоРежима().Получить(КодОшибкиВхода));

	КонецЕсли;

	// Формируем команду (тот же формат что для proxy)
	Команда = Новый Структура;
	ПеренестиИсточникОтвета(Команда, ДанныеЗапроса);
	Команда.Вставить("id", Строка(Ид));
	Команда.Вставить("tool", ИмяИнструмента);
	Команда.Вставить("params", Аргументы);

	ДобавитьВЛог("Получена команда: " + ИмяИнструмента + Символы.ПС + ПолучитьТекстКоманды(Команда));

	// restart/close обрабатываются до деанонимизации — отложенный ответ
	Если ИмяИнструмента = "restart_1c_session" Тогда
		ВыполнитьПерезапускСессии("", ДанныеЗапроса, Ид, ИдПотокаSSE);
		Возврат Неопределено;
	КонецЕсли;
	Если ИмяИнструмента = "close_1c_session" Тогда
		ВыполнитьЗакрытиеСессии("", ДанныеЗапроса, Ид, ИдПотокаSSE);
		Возврат Неопределено;
	КонецЕсли;

	// Деанонимизация входных параметров (встроенный сервер, точная анонимизация)
	Если ИспользоватьТочнуюАнонимизацию Тогда
		ДеАнонимизироватьПараметрыКомандыИВытеснить(Команда);
		Аргументы = Команда.params;
	КонецЕсли;

	// execute_query: дефолт/валидация limit как в прокси (default=100, ge=1, le=1000),
	// но только для встроенного HTTP-сервера (tools/call / REST).
	ДетальОшибки = ПроверитьИНормализоватьАргументыИнструмента(ИмяИнструмента, Аргументы);
	Если ДетальОшибки <> Неопределено Тогда
		СообщениеОшибки = "Ошибка валидации параметров: " + ДетальОшибки
			+ " / Parameter validation failed: " + ДетальОшибки;
		Возврат СформироватьToolsCallРезультат(
			Новый Структура("success, error", Ложь, СообщениеОшибки)
		);
	КонецЕсли;

	// Повторная проверка: params из JSON-строки разбираются уже после деанонимизации
	КодОшибкиВхода = ПроверитьВызовНестрогогоРежима(ИмяИнструмента, Аргументы);

	Если НЕ ПустаяСтрока(КодОшибкиВхода) Тогда

		Возврат СформироватьToolsCallОшибку(ТаблицаОшибокСтрогогоРежима().Получить(КодОшибкиВхода));

	КонецЕсли;

	// Проверка опасных операций для execute_code
	Если ИмяИнструмента = "execute_code" Тогда
		Код = "";
		Аргументы.Свойство("code", Код);
		МассивОпасныхСлов = ПроверитьОпасныеСлова(Код);

		Если МассивОпасныхСлов.Количество() > 0 Тогда
			Если ВсеОперацииАвтоРазрешены(МассивОпасныхСлов) Тогда
				// Автоматически разрешено
				ДобавитьВЛог("Операции автоматически разрешены: " + СоединитьМассив(МассивОпасныхСлов, ", "));
			ИначеЕсли РазрешатьОпасныеОперацииСПодтверждением Тогда
				// Нужен диалог — async
				ОпасныеСлова = СоединитьМассив(МассивОпасныхСлов, ", ");
				Если НЕ ЗарезервироватьПодтверждениеПараллельнойКоманды(Команда, "mcp", ДанныеЗапроса, Ид, ИдПотокаSSE) Тогда Возврат Неопределено; КонецЕсли;
				ОжидающиеПодтверждения.Вставить(ДанныеЗапроса.id,
					Новый Структура(
						"ДанныеЗапроса, Команда, Ид, ОпасныеКлючевыеСлова, ОпасныеКлючевыеСловаТекст, ИдПотокаSSE",
						ДанныеЗапроса,
						Команда,
						Ид,
						МассивОпасныхСлов,
						ОпасныеСлова,
						ИдПотокаSSE
					));

				// Открываем ту же форму подтверждения, что и в прокси-режиме, чтобы UI/логика были одинаковыми.
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ОпасныеСлова", ОпасныеСлова);
				ПараметрыФормы.Вставить("Код", Код);
				
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"ОбработатьРезультатПодтвержденияВстроенный",
					ЭтаФорма,
					Новый Структура("RequestId", ДанныеЗапроса.id));
				
				ОткрытьПодтверждениеОпаснойКоманды(Команда, ПараметрыФормы, ОписаниеОповещения, ДанныеЗапроса.id);

				Возврат Неопределено; // async
			Иначе
				// Подтверждение опасных операций запрещено — блок (как в прокси block mode)
				КлючевыеСловаТекст = СоединитьМассив(МассивОпасныхСлов, ", ");
				ТекстОшибкиБлок = "Операция запрещена: код содержит опасные ключевые слова: " + КлючевыеСловаТекст
					+ " / Operation not allowed: code contains dangerous keywords: " + КлючевыеСловаТекст;
				ОшибкаБлок = Новый Структура("success, error, dangerous_keywords",
					Ложь, ТекстОшибкиБлок, МассивОпасныхСлов);
				Возврат СформироватьToolsCallРезультат(ОшибкаБлок);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Выполнение
	КонтекстОтвета = НовыйКонтекстВыполненияКоманды("mcp", Команда);
	КонтекстОтвета.ДанныеЗапроса = ДанныеЗапроса;
	КонтекстОтвета.Ид = Ид;
	КонтекстОтвета.ИдПотока = ИдПотокаSSE;
	Попытка
		Результат = ВыполнитьКомандуСУчетомКонтекста(Команда, КонтекстОтвета);
	Исключение
		Информация = ИнформацияОбОшибке();
		ТекстОшибки = ОписаниеОшибки();
		СверитьСостояниеПодтвержденногоВызова(ДанныеЗапроса);

		Если СостояниеЗащиты.Строгий Или СостояниеЗащиты.Переключение Тогда

			ДобавитьВЛог("Строгий режим: ошибка выполнения: " + ДиагностикаИсключенияДляЖурнала(Информация, "command_mcp"));

			Возврат ОтветОшибкиСтрогогоMCP(ОшибкаСтрогогоРежима("E_EXECUTION"));

		КонецЕсли;

		Возврат СформироватьToolsCallОшибку("Error: " + ТекстОшибки);
	КонецПопытки;
	Если КонтекстОтвета.Отложено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СверитьСостояниеПодтвержденногоВызова(ДанныеЗапроса);
	Результат = ЗакрытьОшибкуРезультатаСтрогогоРежима(Результат, ИмяИнструмента);
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Вставить("_cmd_arguments_json", """tool"": """ + ИмяИнструмента + """" + Символы.ПС + ЗаписатьJSON2(Аргументы));
	КонецЕсли;

	ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Команда);
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапросаLineage, Результат) Тогда
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат, ТекстЗапроса",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат, ТекстЗапросаLineage);
		ПеренестиИсточникОтвета(КонтекстLineage, Команда);
		НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "execute_query" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		Результат = ПрименитьТочнуюPolicyКРезультатуExecuteQuery(Результат, Ложь);
		РегексКонтекст = Новый Структура;
		РегексКонтекст.Вставить("Результат",            Результат);
		РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
		РегексКонтекст.Вставить("ТекстыJSON",            "");
		РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
		РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
		ПеренестиИсточникОтвета(КонтекстLineage, Команда);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		АнонимизироватьРезультатВстроенный(Результат, РегексКонтекст);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоОбъект",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
		ПеренестиИсточникОтвета(КонтекстLineage, Команда);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоFindReferences",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
			"mcp", ДанныеЗапроса, Ид, ИдПотокаSSE, Результат);
		ПеренестиИсточникОтвета(КонтекстLineage, Команда);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_event_log" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
