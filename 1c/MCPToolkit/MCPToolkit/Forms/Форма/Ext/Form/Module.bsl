&НаКлиенте
Процедура МКПВосстановитьПодключение(ДанныеЗапуска)
	Если Не ДанныеЗапуска.Свойство("source") Тогда Возврат; КонецЕсли;
	МКППроверитьКонтракт(ДанныеЗапуска);
	НастройкиЗапуска = ДанныеЗапуска.connection_settings;
	Если НастройкиЗапуска.mode <> 0 И НастройкиЗапуска.mode <> 1 Тогда ВызватьИсключение "Неверный режим подключения."; КонецЕсли;
	Если ПрименятьВнешнееЗначениеЗащиты("mode", НастройкиЗапуска.mode <> 1) Тогда
		РежимПодключения = НастройкиЗапуска.mode;
	КонецЕсли;
	АдресСервера = НастройкиЗапуска.proxy;
	ИдентификаторКанала = НастройкиЗапуска.channel;
	ПортВстроенногоСервера = НастройкиЗапуска.port;
	Если ПрименятьВнешнееЗначениеЗащиты("bind", ЗначениеЗапускаМеняется(ВыборАдресаВстроенногоСервера, НастройкиЗапуска.bind)) Тогда
		ВыборАдресаВстроенногоСервера = НастройкиЗапуска.bind;
	КонецЕсли;
	Если ПрименятьВнешнееЗначениеЗащиты("token", ЗначениеЗапускаМеняется(ТокенВстроенногоСервера, НастройкиЗапуска.token)) Тогда
		ТокенВстроенногоСервера = НастройкиЗапуска.token;
	КонецЕсли;
	Если ПрименятьВнешнееЗначениеЗащиты("auth_mode", РежимАутентификацииПерезапуска <> НастройкиЗапуска.auth_mode) Тогда
		РежимАутентификацииПерезапуска = НастройкиЗапуска.auth_mode;
	КонецЕсли;
	ОбновитьПредставлениеРежимаПодключения();
	ОбновитьВидимостьПароляПерезапуска();
	Если РежимПодключения = 1 Тогда ПостроитьБазовыйСписокАдресов(); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МКПДополнитьДанныеЗапуска(ДанныеЗапуска, ПодготовленныйИсточник, ХолодныйЗапуск)
	Если ПодготовленныйИсточник = Неопределено Или ПодготовленныйИсточник.source.kind <> "registration" Тогда Возврат; КонецЕсли;
	ИдОперации = Строка(Новый УникальныйИдентификатор());
	КаталогОперации = КаталогВременныхФайлов() + "MCPToolkit/Operations/" + ИдОперации;
	СоздатьКаталог(КаталогОперации);
	МКПЗаписатьТекст(МКППутьОперации(КаталогОперации, "guard"), "");
	МКПЗаписатьТекст(МКППутьОперации(КаталогОперации, "state"), ?(ХолодныйЗапуск, "prepared", "pending"));
	ДанныеЗапуска.Вставить("protocol_version", МКПВерсияКонтракта());
	ДанныеЗапуска.Вставить("operation_id", ИдОперации);
	ДанныеЗапуска.Вставить("operation_dir", КаталогОперации);
	ДанныеЗапуска.Вставить("source", ПодготовленныйИсточник.source);
	ДанныеЗапуска.Вставить("launcher_path", ПодготовленныйИсточник.path);
	ДанныеЗапуска.Вставить("launcher_hash", ПодготовленныйИсточник.hash);
	ДанныеЗапуска.Вставить("connection_settings", МКПСнимокПодключения());
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьЗапускИзРегистрации(ДанныеЗапуска, ВходЗапуска) Экспорт
	МКППроверитьКонтракт(ДанныеЗапуска);
	Если ДанныеЗапуска.source.registration_id <> ИдРегистрацииСервера
		Или ДанныеЗапуска.source.registration_fingerprint <> ОтпечатокРегистрацииЗапуска Тогда
		ВызватьИсключение "Открытая обработка не соответствует подготовленному запуску.";
	КонецЕсли;
	Если МКПДанныеВхода <> Неопределено Тогда ВызватьИсключение "Данные запуска уже переданы форме."; КонецЕсли;
	МКППодготовленныйВход = ВходЗапуска;
	МКПДанныеВхода = ДанныеЗапуска;
	МКПВходПринят = Ложь;
КонецПроцедуры

&НаКлиенте
Функция ОперацияЗапускаИзРегистрацииПринята() Экспорт
	Возврат МКПВходПринят = Истина;
КонецФункции

&НаКлиенте
Процедура МКППринятьВходРегистрации(ДанныеЗапуска, РежимЗапуска)
	Если Не ДанныеЗапуска.Свойство("source") Тогда Возврат; КонецЕсли;
	МКППроверитьКонтракт(ДанныеЗапуска);
	Если МКПДанныеВхода = Неопределено Или МКПВходПринят = Истина Тогда ВызватьИсключение "Запуск из регистрации не подготовлен или уже принят."; КонецЕсли;
	Если МКПДанныеВхода.operation_id <> ДанныеЗапуска.operation_id
		Или МКППодготовленныйВход.mode <> РежимЗапуска
		Или МКПДанныеВхода.operation_dir <> ДанныеЗапуска.operation_dir
		Или ДанныеЗапуска.source.registration_id <> ИдРегистрацииСервера
		Или ДанныеЗапуска.source.registration_fingerprint <> ОтпечатокРегистрацииЗапуска Тогда
		ВызватьИсключение "Операция запуска изменилась.";
	КонецЕсли;
	Если МКППереходОперации(ДанныеЗапуска.operation_dir, "pending", "accepted") <> "won" Тогда
		ВызватьИсключение "Запуск уже принят, отозван или недоступен.";
	КонецЕсли;
	МКПВходПринят = Истина;
	Если РежимЗапуска = "autostart" Тогда
		ПутьФайлаСигналаАвтостарта = ДанныеЗапуска.signal_path;
	Иначе
		ПутьФайлаСигналаХолодногоСтарта = ДанныеЗапуска.signal_path;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция МКПСкриптРегистрационногоЗапуска(ИсходныйТекст, ЭтоWindows, КаталогОперации, ПутьПараметров, ПутьМаппингов)
	Если ЭтоWindows Тогда
		ТекстСкрипта = СтрЗаменить(ИсходныйТекст, "exit 1", "Stop-MCPLaunch; exit 1");
		ПрефиксСкрипта = СтрЗаменить(МКПШаблонСкриптаPS1(), "__MCP_OPERATION__", СтрЗаменить(КаталогОперации, "'", "''"));
		ПрефиксСкрипта = СтрЗаменить(ПрефиксСкрипта, "__MCP_PARAMS__", СтрЗаменить(ПутьПараметров, "'", "''"));
		ПрефиксСкрипта = СтрЗаменить(ПрефиксСкрипта, "__MCP_MAPPINGS__", СтрЗаменить(ПутьМаппингов, "'", "''"));
	Иначе
		ТекстСкрипта = СтрЗаменить(ИсходныйТекст, "exit 1", "mcp_stop; exit 1");
		ПрефиксСкрипта = СтрЗаменить(МКПШаблонСкриптаSH(), "__MCP_OPERATION__", ЭкранироватьБашОдинарнаяКавычка(КаталогОперации));
		ПрефиксСкрипта = СтрЗаменить(ПрефиксСкрипта, "__MCP_PARAMS__", ЭкранироватьБашОдинарнаяКавычка(ПутьПараметров));
		ПрефиксСкрипта = СтрЗаменить(ПрефиксСкрипта, "__MCP_MAPPINGS__", ЭкранироватьБашОдинарнаяКавычка(ПутьМаппингов));
	КонецЕсли;
	Возврат ПрефиксСкрипта + Символы.ПС + ТекстСкрипта;
КонецФункции

