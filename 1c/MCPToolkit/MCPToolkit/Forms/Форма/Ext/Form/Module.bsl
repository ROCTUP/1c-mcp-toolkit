					ОдинТип.Добавить(Сырой);
					АргументыЗапроса.Вставить("metadata_type", ОдинТип);
				КонецЕсли;
			ИначеЕсли ТипЗнч(МетаТип) = Тип("Массив") Или ТипЗнч(МетаТип) = Тип("ФиксированныйМассив") Тогда
				// ок
