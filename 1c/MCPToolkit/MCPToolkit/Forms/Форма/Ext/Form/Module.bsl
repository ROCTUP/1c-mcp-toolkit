Функция АнонимизаторДеТокенизироватьСтрокуВBSL(Текст)
	// Аналог АнонимизаторДеТокенизироватьСтроку, но при подстановке экранирует " → ""
	// чтобы замена токена не ломала строковый литерал BSL (актуально для params.code в execute_code)

	АнонимизаторИнициализировать();

	Если МаппингДеанонимизации.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = "";
	Позиция   = 1;
	Длина     = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		ПозОткр = Найти(Сред(Текст, Позиция), "[");
		Если ПозОткр = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;
		ПозОткр = Позиция + ПозОткр - 1;
		Результат = Результат + Сред(Текст, Позиция, ПозОткр - Позиция);

		ПозЗакр = Найти(Сред(Текст, ПозОткр), "]");
		Если ПозЗакр = 0 Тогда
			Результат = Результат + Сред(Текст, ПозОткр);
			Прервать;
		КонецЕсли;
		ПозЗакр = ПозОткр + ПозЗакр - 1;

		Кандидат = Сред(Текст, ПозОткр, ПозЗакр - ПозОткр + 1);
		Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
			Оригинал = МаппингДеанонимизации.Получить(ВРег(Кандидат));
			Если Оригинал <> Неопределено Тогда
				Результат = Результат + СтрЗаменить(Оригинал, """", """""");
			Иначе
				Результат = Результат + Кандидат;
			КонецЕсли;
		Иначе
			Результат = Результат + Кандидат;
		КонецЕсли;

		Позиция = ПозЗакр + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция АнонимизаторДеТокенизироватьСтрокуДляЗапроса(Текст)
	// Детокенизация текста 1С запроса с контекстным экранированием кавычек.
	// State-machine отслеживает текущий режим кавычек:
	//   0 = снаружи строкового литерала
	//   1 = внутри "..." (двойные кавычки)
	//   2 = внутри '...' (одинарные кавычки)
	// При нахождении токена — экранирование выбирается по текущему состоянию.

	АнонимизаторИнициализировать();
	Если МаппингДеанонимизации.Количество() = 0 Тогда Возврат Текст; КонецЕсли;

	Результат         = "";
	Позиция           = 1;
	Длина             = СтрДлина(Текст);
	СостояниеКавычек  = 0; // 0=снаружи, 1=двойные, 2=одинарные

	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);

		// Обновляем состояние кавычек
		Если СостояниеКавычек = 0 Тогда
			Если Символ = """" Тогда
				СостояниеКавычек = 1;
				Результат = Результат + Символ;
				Позиция = Позиция + 1;
				Продолжить;
			ИначеЕсли Символ = "'" Тогда
				СостояниеКавычек = 2;
				Результат = Результат + Символ;
				Позиция = Позиция + 1;
				Продолжить;
			КонецЕсли;
		ИначеЕсли СостояниеКавычек = 1 Тогда // внутри "..."
			Если Символ = """" Тогда
				Если Позиция < Длина И Сред(Текст, Позиция + 1, 1) = """" Тогда
					// "" — экранированная кавычка, оставляем как есть
					Результат = Результат + """""";
					Позиция = Позиция + 2;
					Продолжить;
				Иначе
					СостояниеКавычек = 0; // закрывающая кавычка
					Результат = Результат + Символ;
					Позиция = Позиция + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СостояниеКавычек = 2 Тогда // внутри '...'
			Если Символ = "'" Тогда
				Если Позиция < Длина И Сред(Текст, Позиция + 1, 1) = "'" Тогда
					// '' — экранированная кавычка, оставляем как есть
					Результат = Результат + "''";
					Позиция = Позиция + 2;
					Продолжить;
				Иначе
					СостояниеКавычек = 0; // закрывающая кавычка
					Результат = Результат + Символ;
					Позиция = Позиция + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// Проверяем начало токена
		Если Символ = "[" Тогда
			ПозЗакр = Найти(Сред(Текст, Позиция), "]");
			Если ПозЗакр > 0 Тогда
				ПозЗакр = Позиция + ПозЗакр - 1;
				Кандидат = Сред(Текст, Позиция, ПозЗакр - Позиция + 1);
				Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
					Оригинал = МаппингДеанонимизации.Получить(ВРег(Кандидат));
					Если Оригинал <> Неопределено Тогда
						Если СостояниеКавычек = 1 Тогда
							Результат = Результат + СтрЗаменить(Оригинал, """", """""");
						ИначеЕсли СостояниеКавычек = 2 Тогда
							Результат = Результат + СтрЗаменить(Оригинал, "'", "''");
						Иначе
							Результат = Результат + Оригинал;
						КонецЕсли;
						Позиция = ПозЗакр + 1;
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Результат = Результат + Символ;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// АНОНИМИЗАЦИЯ — АВТО-ОПРЕДЕЛЕНИЕ КАТЕГОРИИ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьКатегориюТокена(ПолноеИмяПоля)

	Сегменты = РазложитьПутьНаСегменты(ПолноеИмяПоля);
	ИмяПоля  = ВРег(Сегменты[Сегменты.ВГраница()]);

	// По имени поля
	Если ИмяПоля = "ИНН"             Тогда Возврат "INN";       КонецЕсли;
	Если ИмяПоля = "КПП"             Тогда Возврат "KPP";       КонецЕсли;
	Если ИмяПоля = "ОГРН" Или ИмяПоля = "ОГРНИП"  Тогда Возврат "OGRN"; КонецЕсли;
	Если ИмяПоля = "СНИЛС"           Тогда Возврат "SNILS";     КонецЕсли;
	Если ИмяПоля = "БИК"             Тогда Возврат "BIK";       КонецЕсли;
	Если ИмяПоля = "СЧЕТ"            Тогда Возврат "ACC";       КонецЕсли;
	Если ИмяПоля = "АВТОР"           Или ИмяПоля = "ОТВЕТСТВЕННЫЙ" Или ИмяПоля = "ИСПОЛНИТЕЛЬ"
	  Или ИмяПоля = "ИЗМЕНИЛ"        Или ИмяПоля = "РЕДАКТОР"      Или ИмяПоля = "РЕДАКТИРУЕТ"
	  Или ИмяПоля = "ФАМИЛИЯ"        Или ИмяПоля = "ОТЧЕСТВО"
	  Или ИмяПоля = "ФИЗИЧЕСКОЕЛИЦО" Или ИмяПоля = "ФИЗЛИЦО"       Или ИмяПоля = "ФИО"           Тогда Возврат "PER"; КонецЕсли;
	Если ИмяПоля = "СТРАНА"          Или ИмяПоля = "ГОРОД"         Или ИмяПоля = "УЛИЦА"
	  Или ИмяПоля = "ДОМ"            Или ИмяПоля = "КВАРТИРА"                                     Тогда Возврат "LOC"; КонецЕсли;
	Если Найти(ИмяПоля, "ТЕЛЕФОН")     > 0 Или Найти(ИмяПоля, "PHONE")      > 0 Тогда Возврат "PHONE";    КонецЕсли;
	Если Найти(ИмяПоля, "EMAIL")       > 0 Или Найти(ИмяПоля, "ПОЧТА")      > 0 Тогда Возврат "EMAIL";    КонецЕсли;
	Если Найти(ИмяПоля, "ПАСПОРТ")     > 0 Или Найти(ИмяПоля, "PASSPORT")   > 0 Тогда Возврат "PASSPORT"; КонецЕсли;
	Если Найти(ИмяПоля, "ДАТА")        > 0 Или Найти(ИмяПоля, "DATE")       > 0 Тогда Возврат "DATE";     КонецЕсли;
	Если Найти(ИмяПоля, "АДРЕС")       > 0 Или Найти(ИмяПоля, "ADDRESS")    > 0 Тогда Возврат "LOC";      КонецЕсли;
	Если Найти(ИмяПоля, "РАСЧЕТНЫЙ")   > 0                                       Тогда Возврат "ACC";      КонецЕсли;
	Если Найти(ИмяПоля, "ОРГАНИЗАЦИЯ") > 0 Или Найти(ИмяПоля, "КОНТРАГЕНТ") > 0
	  Или Найти(ИмяПоля, "PARTNER")    > 0                                       Тогда Возврат "ORG";      КонецЕсли;
	Если Найти(ИмяПоля, "ФИЗЛИЦО")     > 0 Или Найти(ИмяПоля, "СОТРУДНИК")  > 0
	  Или Найти(ИмяПоля, "PERSON")     > 0                                       Тогда Возврат "PER";      КонецЕсли;

	// По имени объекта (второй сегмент)
	Если Сегменты.Количество() >= 2 Тогда
		ИмяОбъекта = ВРег(Сегменты[1]);
		Если Найти(ИмяОбъекта, "ФИЗЛИЦ")     > 0
		  Или Найти(ИмяОбъекта, "СОТРУДНИК") > 0
		  Или Найти(ИмяОбъекта, "PERSON")    > 0 Тогда
			Возврат "PER";
		КонецЕсли;
		Если Найти(ИмяОбъекта, "КОНТРАГЕНТ")  > 0
		  Или Найти(ИмяОбъекта, "ОРГАНИЗАЦИЯ") > 0
		  Или Найти(ИмяОбъекта, "PARTNER")    > 0 Тогда
			Возврат "ORG";
		КонецЕсли;
	КонецЕсли;

	Возврат "STR";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьПутьНаСегменты(Путь)

	Сегменты = Новый Массив;
	ОстатокПути = Путь;
	Пока Истина Цикл
		Поз = Найти(ОстатокПути, ".");
		Если Поз = 0 Тогда
			Сегменты.Добавить(ОстатокПути);
			Прервать;
		КонецЕсли;
		Сегменты.Добавить(Лев(ОстатокПути, Поз - 1));
		ОстатокПути = Сред(ОстатокПути, Поз + 1);
	КонецЦикла;
	Возврат Сегменты;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// АНОНИМИЗАЦИЯ — СЛОВАРНЫЙ ДВИЖОК
// ─────────────────────────────────────────────────────────────────────────────────

&НаСервереБезКонтекста
Функция ПостроитьСловарьАнонимизацииНаСервере()

	Результат = Новый Массив;
	Лог       = Новый Массив;

	Попытка
		НаборПравил = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v2");
		Если ТипЗнч(НаборПравил) <> Тип("Структура") Или НЕ НаборПравил.Свойство("Правила") Тогда
			НаборПравил = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v1");
		КонецЕсли;
		Если ТипЗнч(НаборПравил) <> Тип("Структура") Или НЕ НаборПравил.Свойство("Правила") Тогда
			Лог.Добавить("Словарь: правила не найдены в хранилище");
			Возврат Новый Структура("Данные, Лог", Результат, Лог);
		КонецЕсли;
	Исключение
		Лог.Добавить("Словарь: ошибка загрузки правил — " + ОписаниеОшибки());
		Возврат Новый Структура("Данные, Лог", Результат, Лог);
	КонецПопытки;

	Для Каждого СтрокаПравила Из НаборПравил.Правила Цикл

		ИспользоватьДляСловаря = Ложь;
		Попытка
			ИспользоватьДляСловаря = СтрокаПравила.use_for_dictionary;
		Исключение КонецПопытки;
		Если НЕ ИспользоватьДляСловаря Тогда
			Продолжить;
		КонецЕсли;

		ПутьИсточника = "";
		КатегорияПравила = "";
		Попытка
			ПутьИсточника = СтрокаПравила.source_path;
		Исключение КонецПопытки;
		Попытка
			КатегорияПравила = СтрокаПравила.token_category;
		Исключение КонецПопытки;
		Если КатегорияПравила = Неопределено Тогда КатегорияПравила = ""; КонецЕсли;

		Если ПустаяСтрока(ПутьИсточника) Тогда
			Лог.Добавить("Словарь: правило пропущено — пустой source_path");
			Продолжить;
		КонецЕсли;

		Сегменты = РазложитьПутьНаСегменты(ПутьИсточника);
		Если Сегменты.Количество() <> 3 Тогда
			Лог.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — ожидается 3 сегмента, найдено " + Сегменты.Количество());
			Продолжить;
		КонецЕсли;

		ИмяОбъекта = Сегменты[0] + "." + Сегменты[1];
		ИмяПоля    = Сегменты[2];

		ОбъектМД = Неопределено;
		Попытка
			ОбъектМД = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		Исключение КонецПопытки;
		Если ОбъектМД = Неопределено Тогда
			Лог.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — объект метаданных '" + ИмяОбъекта + "' не найден");
			Продолжить;
		КонецЕсли;

		РеквизитМД = НайтиРеквизитВКоллекциях(ОбъектМД, ИмяПоля);
		Если РеквизитМД = Неопределено Тогда
			Лог.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — реквизит '" + ИмяПоля + "' не найден в метаданных");
			Продолжить;
		КонецЕсли;

		ЕстьСтрока = Ложь;
		Попытка
			Для Каждого ТипПоля Из РеквизитМД.Тип.Типы() Цикл
				Если ТипПоля = Тип("Строка") Тогда
					ЕстьСтрока = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение КонецПопытки;
		Если НЕ ЕстьСтрока Тогда
			Лог.Добавить("Словарь [" + ПутьИсточника + "]: пропущено — поле не является строковым");
			Продолжить;
		КонецЕсли;

		КатегорияТокена = КатегорияПравила;
		Если ПустаяСтрока(КатегорияТокена) Тогда
			КатегорияТокена = ОпределитьКатегориюТокена(ПутьИсточника);
		КонецЕсли;

		КоличествоДоЗапроса = Результат.Количество();
		Попытка
			ЗапросТекст =
				"ВЫБРАТЬ ПЕРВЫЕ 100000 РАЗЛИЧНЫЕ
				|	ВЫРАЗИТЬ(" + ИмяПоля + " КАК Строка(1000)) КАК Значение
				|ИЗ
				|	" + ИмяОбъекта + "
				|ГДЕ
				|	ВЫРАЗИТЬ(" + ИмяПоля + " КАК Строка(1000)) <> """"";
			ЗапросОбъект = Новый Запрос(ЗапросТекст);
			ВыборкаЗапроса = ЗапросОбъект.Выполнить().Выбрать();
			Пока ВыборкаЗапроса.Следующий() Цикл
				ЗначениеОриг = СокрЛП(ВыборкаЗапроса.Значение);
				Если ТипЗнч(ЗначениеОриг) <> Тип("Строка") Тогда
					Продолжить;
				КонецЕсли;
				Если СтрДлина(ЗначениеОриг) < 3 Тогда
					Продолжить;
				КонецЕсли;
				Запись = Новый Структура;
				Запись.Вставить("ЗначениеОриг",   ЗначениеОриг);
				Запись.Вставить("ЗначениеНижний", НРег(ЗначениеОриг));
				Запись.Вставить("Категория",      КатегорияТокена);
				Запись.Вставить("Длина",          СтрДлина(ЗначениеОриг));
				Результат.Добавить(Запись);
			КонецЦикла;
			Лог.Добавить("Словарь [" + ПутьИсточника + "]: добавлено " + (Результат.Количество() - КоличествоДоЗапроса) + " значений");
		Исключение
			Лог.Добавить("Словарь [" + ПутьИсточника + "]: ошибка запроса — " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	// Сортировка по убыванию длины (сервер — ТаблицаЗначений доступна)
	ТаблицаВрем = Новый ТаблицаЗначений;
	ТаблицаВрем.Колонки.Добавить("Длина",          Новый ОписаниеТипов("Число"));
	ТаблицаВрем.Колонки.Добавить("ЗначениеОриг",   Новый ОписаниеТипов("Строка"));
	ТаблицаВрем.Колонки.Добавить("ЗначениеНижний", Новый ОписаниеТипов("Строка"));
	ТаблицаВрем.Колонки.Добавить("Категория",      Новый ОписаниеТипов("Строка"));
	Для Каждого Запись Из Результат Цикл
		Стр = ТаблицаВрем.Добавить();
		Стр.Длина          = Запись.Длина;
		Стр.ЗначениеОриг   = Запись.ЗначениеОриг;
		Стр.ЗначениеНижний = Запись.ЗначениеНижний;
		Стр.Категория      = Запись.Категория;
	КонецЦикла;
	ТаблицаВрем.Сортировать("Длина Убыв");
	Результат = Новый Массив;
	Для Каждого Стр Из ТаблицаВрем Цикл
		Запись = Новый Структура;
		Запись.Вставить("ЗначениеОриг",   Стр.ЗначениеОриг);
		Запись.Вставить("ЗначениеНижний", Стр.ЗначениеНижний);
		Запись.Вставить("Категория",      Стр.Категория);
		Запись.Вставить("Длина",          Стр.Длина);
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Новый Структура("Данные, Лог", Результат, Лог);

КонецФункции

&НаКлиенте
Процедура ПостроитьИЗаполнитьСловарьАнонимизации()

	РезСловаря = ПостроитьСловарьАнонимизацииНаСервере();
	Для Каждого СтрЛог Из РезСловаря.Лог Цикл
		ДобавитьВЛог(СтрЛог);
	КонецЦикла;
	ЗаполнитьСловарьАнонимизации(РезСловаря.Данные);
	Элементы.НадписьКоличествоЗаписейСловаря.Заголовок = "Записей в словаре:  " + Формат(СловарьАнонимизации.Количество(), "ЧРГ= ");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСловарьАнонимизации(ДанныеСловаря)

	АнонимизаторИнициализировать();

	// Данные уже отсортированы сервером по убыванию длины
	СловарьАнонимизации = Новый Массив;
	БакетИндексСловаря  = Новый Соответствие;

	Для Каждого Запись Из ДанныеСловаря Цикл
		СловарьАнонимизации.Добавить(Запись);

		Если Запись.Длина >= 3 Тогда
			Бакет = Лев(Запись.ЗначениеНижний, 3);
			МассивЗаписей = БакетИндексСловаря.Получить(Бакет);
			Если МассивЗаписей = Неопределено Тогда
				МассивЗаписей = Новый Массив;
				БакетИндексСловаря.Вставить(Бакет, МассивЗаписей);
			КонецЕсли;
			МассивЗаписей.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	СловарьПостроен = Истина;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоБуквоЦифра(Символ)

	КодСим = КодСимвола(Символ);
	Если КодСим >= 48  И КодСим <= 57  Тогда Возврат Истина; КонецЕсли; // 0-9
	Если КодСим >= 65  И КодСим <= 90  Тогда Возврат Истина; КонецЕсли; // A-Z
	Если КодСим >= 97  И КодСим <= 122 Тогда Возврат Истина; КонецЕсли; // a-z
	Если КодСим >= 1040 И КодСим <= 1103 Тогда Возврат Истина; КонецЕсли; // А-я
	Если КодСим = 1025 Или КодСим = 1105 Тогда Возврат Истина; КонецЕсли; // Ё, ё
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ПрименитьСловарьКСтроке(Текст)

	АнонимизаторИнициализировать();

	Если НЕ СловарьПостроен Или СловарьАнонимизации.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Длина = СтрДлина(Текст);
	Если Длина = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	// Собираем диапазоны уже существующих токенов для защиты
	ДиапазоныТокенов = Новый Массив;
	ПоискПоз = 1;
	Пока ПоискПоз <= Длина Цикл
		ПозОткр = Найти(Сред(Текст, ПоискПоз), "[");
		Если ПозОткр = 0 Тогда Прервать; КонецЕсли;
		ПозОткр = ПоискПоз + ПозОткр - 1;
		ПозЗакр = Найти(Сред(Текст, ПозОткр), "]");
		Если ПозЗакр = 0 Тогда Прервать; КонецЕсли;
		ПозЗакр = ПозОткр + ПозЗакр - 1;
		Кандидат = Сред(Текст, ПозОткр, ПозЗакр - ПозОткр + 1);
		Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
			ДиапазоныТокенов.Добавить(Новый Структура("Начало, Конец", ПозОткр, ПозЗакр));
		КонецЕсли;
		ПоискПоз = ПозЗакр + 1;
	КонецЦикла;

	ТекстНижний = НРег(Текст);

	// Формируем список замен
	Замены       = Новый Массив;
	Позиция      = 1;
	ИндексТокена = 0;

	Пока Позиция <= Длина Цикл

		// Проверка: внутри существующего токена?
		ВнутриТокена = Ложь;
		КонецТокена  = 0;
		Для Инд = ИндексТокена По ДиапазоныТокенов.ВГраница() Цикл
			Диапазон = ДиапазоныТокенов[Инд];
			Если Позиция >= Диапазон.Начало И Позиция <= Диапазон.Конец Тогда
				ВнутриТокена = Истина;
				КонецТокена  = Диапазон.Конец;
				ИндексТокена = Инд;
				Прервать;
			КонецЕсли;
			Если Позиция < Диапазон.Начало Тогда Прервать; КонецЕсли;
		КонецЦикла;

		Если ВнутриТокена Тогда
			Позиция = КонецТокена + 1;
			Продолжить;
		КонецЕсли;

		Если Позиция + 2 > Длина Тогда
			Прервать;
		КонецЕсли;

		Бакет    = Сред(ТекстНижний, Позиция, 3);
		Кандидаты = БакетИндексСловаря.Получить(Бакет);
		Если Кандидаты = Неопределено Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		НашлиЗамену = Ложь;
		Для Каждого Кандидат Из Кандидаты Цикл
			ДлинаКандидата = Кандидат.Длина;
			Если ДлинаКандидата < 3 Тогда Продолжить; КонецЕсли;
			Если Позиция + ДлинаКандидата - 1 > Длина Тогда Продолжить; КонецЕсли;
			Если Сред(ТекстНижний, Позиция, ДлинаКандидата) <> Кандидат.ЗначениеНижний Тогда
				Продолжить;
			КонецЕсли;

			ГраницаОК = Истина;
			Если Позиция > 1 Тогда
				Если ЭтоБуквоЦифра(Сред(Текст, Позиция - 1, 1)) Тогда
					ГраницаОК = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если ГраницаОК И Позиция + ДлинаКандидата <= Длина Тогда
				Если ЭтоБуквоЦифра(Сред(Текст, Позиция + ДлинаКандидата, 1)) Тогда
					ГраницаОК = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если НЕ ГраницаОК Тогда Продолжить; КонецЕсли;

			Токен   = АнонимизаторТокенизировать(Кандидат.ЗначениеОриг, Кандидат.Категория);
			Замены.Добавить(Новый Структура("Начало, Длина, Токен", Позиция, ДлинаКандидата, Токен));
			Позиция = Позиция + ДлинаКандидата;
			НашлиЗамену = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ НашлиЗамену Тогда
			Позиция = Позиция + 1;
		КонецЕсли;

	КонецЦикла;

	Если Замены.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	РезультатТекст  = "";
	ТекущаяПозиция  = 1;
	Для Каждого Замена Из Замены Цикл
		Если Замена.Начало > ТекущаяПозиция Тогда
			РезультатТекст = РезультатТекст + Сред(Текст, ТекущаяПозиция, Замена.Начало - ТекущаяПозиция);
		КонецЕсли;
		РезультатТекст = РезультатТекст + Замена.Токен;
		ТекущаяПозиция = Замена.Начало + Замена.Длина;
	КонецЦикла;
	Если ТекущаяПозиция <= Длина Тогда
		РезультатТекст = РезультатТекст + Сред(Текст, ТекущаяПозиция);
	КонецЕсли;

	Возврат РезультатТекст;

КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// АНОНИМИЗАЦИЯ — ДВИЖОК ОБРАБОТКИ РЕЗУЛЬТАТОВ И ДЕ-АНОНИМИЗАЦИЯ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция АнонимизироватьЗначениеВстроенный(Значение, МассивSources, ПравилаАнонимизации)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	// Ищем явную категорию в правилах
	Категория = "";
	Для Каждого SourcePath Из МассивSources Цикл
		Правило = ПравилаАнонимизации.Получить(SourcePath);
		Если Правило = Неопределено Тогда Продолжить; КонецЕсли;
		КатегорияПравила = "";
		Попытка
			Правило.Свойство("token_category", КатегорияПравила);
		Исключение КонецПопытки;
		Если НЕ ПустаяСтрока(КатегорияПравила) Тогда
			Категория = КатегорияПравила;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Авто-определение если явная категория не задана
	Если ПустаяСтрока(Категория) Тогда
		НеSTR = "";
		Для Каждого SourcePath Из МассивSources Цикл
			АвтоКат = ОпределитьКатегориюТокена(SourcePath);
			Если АвтоКат <> "STR" Тогда
				НеSTR = АвтоКат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Категория = ?(НЕ ПустаяСтрока(НеSTR), НеSTR, "STR");
	КонецЕсли;

	Возврат АнонимизаторТокенизировать(Значение, Категория);

КонецФункции

&НаКлиенте
Функция ЭтоБухгалтерскийСчет(Строка)
	Если ПустаяСтрока(Строка) Тогда Возврат Ложь; КонецЕсли;
	// Inline-разбор без серверного РазделитьСтрокуПоРазделителю
	ТекущийСегмент = "";
	НомерСегмента  = 0;
	Для СимИнд = 1 По СтрДлина(Строка) + 1 Цикл
		Если СимИнд > СтрДлина(Строка) Тогда
			Символ = ".";  // виртуальная точка для финального сегмента
		Иначе
			Символ = Сред(Строка, СимИнд, 1);
		КонецЕсли;
		Если Символ = "." Тогда
			Если СтрДлина(ТекущийСегмент) = 0 Тогда Возврат Ложь; КонецЕсли;
			МаксДлина = ?(НомерСегмента = 0, 2, 3);
			Если СтрДлина(ТекущийСегмент) > МаксДлина Тогда Возврат Ложь; КонецЕсли;
			НомерСегмента = НомерСегмента + 1;
			Если НомерСегмента > 4 Тогда Возврат Ложь; КонецЕсли;
			ТекущийСегмент = "";
		ИначеЕсли Найти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		Иначе
			ТекущийСегмент = ТекущийСегмент + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ЭтоВалюта(Строка)
	Если ПустаяСтрока(Строка) Тогда Возврат Ложь; КонецЕсли;
	ВерхРегистр = ВРег(СокрЛП(Строка));
	ВалютыISO = "RUB,USD,EUR,GBP,CNY,JPY,CHF,KZT,BYN,BYR,UAH,TRY,AED,INR,CAD,AUD,"
		+ "SEK,NOK,DKK,PLN,CZK,HUF,SGD,HKD,NZD,MXN,ZAR,KGS,UZS,AMD,AZN,GEL,MDL,TJS,РУБ.";
	Если Найти("," + ВалютыISO + ",", "," + ВерхРегистр + ",") > 0 Тогда Возврат Истина; КонецЕсли;
	НижРегистр = НРег(СокрЛП(Строка));
	ВалютыРус = "российский рубль,доллар сша,евро,фунт стерлингов,китайский юань,"
		+ "японская иена,швейцарский франк,казахстанский тенге,белорусский рубль,"
		+ "украинская гривна,рубль,доллар,юань,иена,тенге,гривна";
	Если Найти("," + ВалютыРус + ",", "," + НижРегистр + ",") > 0 Тогда Возврат Истина; КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ЭтоUUID(Строка)
	Если СтрДлина(Строка) <> 36 Тогда Возврат Ложь; КонецЕсли;
	Для СимИнд = 1 По 36 Цикл
		Символ = Сред(Строка, СимИнд, 1);
		Если СимИнд = 9 Или СимИнд = 14 Или СимИнд = 19 Или СимИнд = 24 Тогда
			Если Символ <> "-" Тогда Возврат Ложь; КонецЕсли;
		ИначеЕсли Найти("0123456789abcdefABCDEF", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ЭтоИсключениеАгрессивнойАнонимизации(Строка)
	Возврат ЭтоБухгалтерскийСчет(Строка) Или ЭтоВалюта(Строка) Или ЭтоUUID(Строка);
КонецФункции

&НаКлиенте
Функция ЭтоИзвестныйТокенАнонимизации(Строка)
	Если НЕ ЭтоВалидныйТокенФормат(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;
	АнонимизаторИнициализировать();
	Возврат МаппингДеанонимизации.Получить(ВРег(Строка)) <> Неопределено;
КонецФункции

&НаКлиенте
Процедура АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст)
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;
	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизации();
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;
	Данные = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data", Данные) Тогда
		НовыеДанные = АнонимизироватьExecuteCodeЗначение(Данные, 0, АгрессивныйРежим);
		Результат.Вставить("data", НовыеДанные);
	КонецЕсли;
	СобратьТекстыДляRegexExecuteCode(Результат, РегексКонтекст);
КонецПроцедуры

&НаКлиенте
Функция АнонимизироватьExecuteCodeЗначение(Значение, Глубина = 0, АгрессивныйРежим = Ложь, ВнутриКонтейнера = Ложь)
	Если Глубина > 10 Или Значение = Неопределено Тогда Возврат Значение; КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		АнонимизаторИнициализировать();
		СуществующийТокен = МаппингАнонимизации.Получить(Значение);
		Если СуществующийТокен <> Неопределено Тогда Возврат СуществующийТокен; КонецЕсли;
		// Защита от повторной токенизации: только реально существующие токены текущего сеанса
		Если ЭтоИзвестныйТокенАнонимизации(Значение) Тогда Возврат Значение; КонецЕсли;
		// Словарь идёт первым: сохраняет точные категории (PER, ORG, ...)
		РезультатСловаря = ПрименитьСловарьКСтроке(Значение);
		// Агрессивный режим — только если строка является полем структуры или элементом массива
		Если АгрессивныйРежим И ВнутриКонтейнера
			И НЕ ПустаяСтрока(Значение)
			И НЕ ЭтоИсключениеАгрессивнойАнонимизации(Значение) Тогда
			// Словарь полностью токенизировал строку — возвращаем точный токен
			Если ЭтоВалидныйТокенФормат(РезультатСловаря) Тогда Возврат РезультатСловаря; КонецЕсли;
			// Частичная или нулевая замена — токенизируем по оригиналу (не РезультатСловаря),
			// чтобы МаппингДеанонимизации хранил исходную строку без вложенных токенов
			Возврат АнонимизаторТокенизировать(Значение, "STR");
		КонецЕсли;
		Возврат РезультатСловаря;

	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		ЭтоОбъектРеф = Ложь;
		Значение.Свойство("_objectRef", ЭтоОбъектРеф);
		НоваяСтруктура = Новый Структура;
		Для Каждого КВП Из Значение Цикл
			// Если это trusted-ссылка, технические поля копируем без анонимизации
			Если ЭтоОбъектРеф = Истина
				И (КВП.Ключ = "_objectRef"
					Или КВП.Ключ = "УникальныйИдентификатор"
					Или КВП.Ключ = "ТипОбъекта") Тогда
				НоваяСтруктура.Вставить(КВП.Ключ, КВП.Значение);
				Продолжить;
			КонецЕсли;
			// Все остальные поля (включая Представление и любые user-поля) — рекурсивно
			НоваяСтруктура.Вставить(КВП.Ключ,
				АнонимизироватьExecuteCodeЗначение(КВП.Значение, Глубина + 1, АгрессивныйРежим, Истина));
		КонецЦикла;
		Возврат НоваяСтруктура;

	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		НовыйМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			НовыйМассив.Добавить(АнонимизироватьExecuteCodeЗначение(Элемент, Глубина + 1, АгрессивныйРежим, Истина));
		КонецЦикла;
		Возврат НовыйМассив;
	КонецЕсли;

	Возврат Значение;
КонецФункции

&НаКлиенте
Процедура СобратьТекстыДляRegexExecuteCode(Результат, РегексКонтекст)
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") И Правило.enabled = Истина Тогда
			ВключённыеПравила.Добавить(Новый Структура("pattern, category",
				Правило.pattern, Правило.category));
		КонецЕсли;
	КонецЦикла;
	Если ВключённыеПравила.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь; Возврат;
	КонецЕсли;
	МассивПравилJSON = Новый Массив;
	Для Каждого П Из ВключённыеПравила Цикл
		МассивПравилJSON.Добавить(Новый Структура("pattern, category", П.pattern, П.category));
	КонецЦикла;
	РегексКонтекст.ВключённыеПравилаJSON = ЗаписатьJSON2(МассивПравилJSON);
	ТекстыМассив = Новый Массив;
	МаппингПутей = Новый Массив;
	Данные = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data", Данные) Тогда
		НачальныйПуть = Новый Массив;
		НачальныйПуть.Добавить("data");
		СобратьСтрокиExecuteCodeРекурсивно(Данные, НачальныйПуть,
			ТекстыМассив, МаппингПутей, 0);
	КонецЕсли;
	Если ТекстыМассив.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь; Возврат;
	КонецЕсли;
	РегексКонтекст.ТекстыJSON         = ЗаписатьJSON2(ТекстыМассив);
	РегексКонтекст.МаппингПутей       = МаппингПутей;
	РегексКонтекст.ЕстьТекстыДляRegex = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СобратьСтрокиExecuteCodeРекурсивно(Значение, ТекущийПуть,
	ТекстыМассив, МаппингПутей, Глубина)
	Если Глубина > 10 Или Значение = Неопределено Тогда Возврат; КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		// Не отправлять реальные токены текущего сеанса в regex — широкие правила могут их сломать
		Если НЕ ЭтоИзвестныйТокенАнонимизации(Значение) Тогда
			ТекстыМассив.Добавить(Значение);
			КопияПути = Новый Массив;
			Для Каждого Эл Из ТекущийПуть Цикл КопияПути.Добавить(Эл); КонецЦикла;
			МаппингПутей.Добавить(КопияПути);
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		ЭтоОбъектРеф = Ложь;
		Значение.Свойство("_objectRef", ЭтоОбъектРеф);
		Для Каждого КВП Из Значение Цикл
			// Технические поля trusted-ссылки не собираем
			Если ЭтоОбъектРеф = Истина
				И (КВП.Ключ = "_objectRef"
					Или КВП.Ключ = "УникальныйИдентификатор"
					Или КВП.Ключ = "ТипОбъекта") Тогда
				Продолжить;
			КонецЕсли;
			НовыйПуть = Новый Массив;
			Для Каждого Эл Из ТекущийПуть Цикл НовыйПуть.Добавить(Эл); КонецЦикла;
			НовыйПуть.Добавить(КВП.Ключ);
			СобратьСтрокиExecuteCodeРекурсивно(КВП.Значение, НовыйПуть,
				ТекстыМассив, МаппингПутей, Глубина + 1);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Инд = 0 По Значение.Количество() - 1 Цикл
			НовыйПуть = Новый Массив;
			Для Каждого Эл Из ТекущийПуть Цикл НовыйПуть.Добавить(Эл); КонецЦикла;
			НовыйПуть.Добавить(Инд);
			СобратьСтрокиExecuteCodeРекурсивно(Значение[Инд], НовыйПуть,
				ТекстыМассив, МаппингПутей, Глубина + 1);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьRegexТокеныExecuteCode(РегексКонтекст, СовпаденияJSON)
	Если НЕ ЗначениеЗаполнено(СовпаденияJSON) Тогда Возврат; КонецЕсли;
	РезСовпадений = Неопределено;
	Попытка РезСовпадений = ПрочитатьJSON2(СовпаденияJSON); Исключение Возврат; КонецПопытки;
	Если ТипЗнч(РезСовпадений) <> Тип("Массив") Тогда Возврат; КонецЕсли;
	МаппингПутей    = РегексКонтекст.МаппингПутей;
	КореньРезультат = РегексКонтекст.Результат;
	Для ТекстИнд = 0 По РезСовпадений.Количество() - 1 Цикл
		Если ТекстИнд >= МаппингПутей.Количество() Тогда Прервать; КонецЕсли;
		ЭлСовпадений = РезСовпадений[ТекстИнд];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Путь = МаппингПутей[ТекстИнд];
		Если Путь.Количество() = 0 Тогда Продолжить; КонецЕсли;
		// Обход от корня до родительского контейнера
		Контейнер = КореньРезультат;
		ОшибкаПути = Ложь;
		Для НавИнд = 0 По Путь.Количество() - 2 Цикл
			ЭлПути = Путь[НавИнд];
			Если ТипЗнч(Контейнер) = Тип("Массив") Тогда
				Контейнер = Контейнер[ЭлПути];
			ИначеЕсли ТипЗнч(Контейнер) = Тип("Структура") Тогда
				Вложенное = Неопределено;
				Контейнер.Свойство(ЭлПути, Вложенное);
				Контейнер = Вложенное;
			Иначе
				ОшибкаПути = Истина; Прервать;
			КонецЕсли;
			Если Контейнер = Неопределено Тогда ОшибкаПути = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		Если ОшибкаПути Тогда Продолжить; КонецЕсли;
		Ключ = Путь[Путь.Количество() - 1];
		Если ТипЗнч(Контейнер) = Тип("Массив") Тогда
			ТекущийТекст = Контейнер[Ключ];
		ИначеЕсли ТипЗнч(Контейнер) = Тип("Структура") Тогда
			ТекущийТекст = Неопределено;
			Контейнер.Свойство(Ключ, ТекущийТекст);
		Иначе
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Тогда Продолжить; КонецЕсли;
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = ""; МатчТекст = ""; Начало = 0; Длина = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория); С.Свойство("match", МатчТекст);
				С.Свойство("start", Начало);       С.Свойство("length", Длина);
			Иначе
				Категория = С["category"]; МатчТекст = С["match"];
				Начало = С["start"];       Длина = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;
		Если ТипЗнч(Контейнер) = Тип("Массив") Тогда
			Контейнер[Ключ] = НовыйТекст;
		Иначе
			Контейнер.Вставить(Ключ, НовыйТекст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПрименитьRegexТокеныКСтроке(Текст, СовпаденияJSON)
	// Упрощённый аналог ПрименитьRegexТокеныExecuteCode для одиночной строки.
	// Применяет замены справа налево, чтобы смещение позиций после замены не ломало последующие индексы.
	Если НЕ ЗначениеЗаполнено(СовпаденияJSON) Тогда Возврат Текст; КонецЕсли;
	РезСовпадений = Неопределено;
	Попытка РезСовпадений = ПрочитатьJSON2(СовпаденияJSON); Исключение Возврат Текст; КонецПопытки;
	Если ТипЗнч(РезСовпадений) <> Тип("Массив") Или РезСовпадений.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ЭлСовпадений = РезСовпадений[0];
	Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Замены = Новый Массив;
	Для Каждого С Из ЭлСовпадений Цикл
		Категория = ""; МатчТекст = ""; Начало = 0; Длина = 0;
		Если ТипЗнч(С) = Тип("Структура") Тогда
			С.Свойство("category", Категория); С.Свойство("match", МатчТекст);
			С.Свойство("start",    Начало);    С.Свойство("length", Длина);
		Иначе
			Категория = С["category"]; МатчТекст = С["match"];
			Начало    = С["start"];    Длина      = С["length"];
		КонецЕсли;
		Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
		Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
		Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
		Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
		Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
		Замены.Добавить(Новый Структура("Начало, Длина, МатчТекст, Категория",
			Начало, Длина, МатчТекст, Категория));
	КонецЦикла;
	// Пузырьковая сортировка по убыванию Начало (правые замены сначала)
	Для Инд1 = 0 По Замены.Количество() - 2 Цикл
		Для Инд2 = 0 По Замены.Количество() - 2 - Инд1 Цикл
			Если Замены[Инд2].Начало < Замены[Инд2 + 1].Начало Тогда
				Врем             = Замены[Инд2];
				Замены[Инд2]     = Замены[Инд2 + 1];
				Замены[Инд2 + 1] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	НовыйТекст = Текст;
	Для Каждого Замена Из Замены Цикл
		Токен = АнонимизаторТокенизировать(Замена.МатчТекст, Замена.Категория);
		// start в regex — 0-based, в 1C Сред/Лев — 1-based
		Если Замена.Начало >= 0 И (Замена.Начало + Замена.Длина) <= СтрДлина(НовыйТекст) Тогда
			НовыйТекст = Лев(НовыйТекст, Замена.Начало)
				+ Токен
				+ Сред(НовыйТекст, Замена.Начало + Замена.Длина + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат НовыйТекст;
КонецФункции

&НаКлиенте
Процедура АнонимизироватьРезультатВстроенный(Результат, РегексКонтекст = Неопределено)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	ПравилаАнонимизации = ПолучитьНастройкиТочнойАнонимизации().Правила;

	// Строим карту политик колонок из уже проставленных полей schema
	СоответствиеPolicy = Новый Соответствие;
	Схема = Неопределено;
	Если НЕ Результат.Свойство("schema", Схема)
		Или ТипЗнч(Схема) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Колонки = Неопределено;
	Если НЕ Схема.Свойство("columns", Колонки)
		Или ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
		ИмяКолонки = "";
		Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
		Режим = "default";
		Колонка.Свойство("anonymization_mode", Режим);
		РежимСсылки = "default";
		Колонка.Свойство("reference_presentation_mode", РежимСсылки);
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		СоответствиеPolicy.Вставить(ИмяКолонки,
			Новый Структура("mode, ref_mode, sources", Режим, РежимСсылки, Sources));
	КонецЦикла;

	// Обходим строки данных
	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Данные Цикл
		Если ТипЗнч(Строка) <> Тип("Соответствие")
			И ТипЗнч(Строка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого PolicyЭлт Из СоответствиеPolicy Цикл
			ИмяКолонки = PolicyЭлт.Ключ;
			Policy      = PolicyЭлт.Значение;

			ЗначениеКолонки = Неопределено;
			Если ТипЗнч(Строка) = Тип("Структура") Тогда
				Если НЕ Строка.Свойство(ИмяКолонки, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
			Иначе
				ЗначениеКолонки = Строка[ИмяКолонки];
			КонецЕсли;
			Если ЗначениеКолонки = Неопределено Тогда Продолжить; КонецЕсли;

			Если ТипЗнч(ЗначениеКолонки) = Тип("Структура")
				И ЗначениеКолонки.Свойство("Представление") Тогда
				// Объектное значение — анонимизируем только Представление
				// Перечисления не анонимизируются никогда (в т.ч. при смешанном типе колонки)
				// Планы счетов по умолчанию не анонимизируются, если нет явного force_anonymize
				ТипОбъектаЗначения = "";
				ЗначениеКолонки.Свойство("ТипОбъекта", ТипОбъектаЗначения);
				Если Найти(ТипОбъектаЗначения, "ПеречислениеСсылка.") = 1 Тогда
					Продолжить;
				КонецЕсли;
				Если Найти(ТипОбъектаЗначения, "ПланСчетовСсылка.") = 1
					И Policy.mode <> "force_anonymize"
					И Policy.ref_mode <> "force_anonymize" Тогда
					Продолжить;
				КонецЕсли;
				Если Policy.mode = "force_keep" Тогда
					Продолжить;
				ИначеЕсли Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
					ЗначениеКолонки.Вставить("Представление",
						АнонимизироватьЗначениеВстроенный(ЗначениеКолонки.Представление, Policy.sources, ПравилаАнонимизации));
				ИначеЕсли Policy.ref_mode = "force_keep" Тогда
					Продолжить;
				Иначе
					ЗначениеКолонки.Вставить("Представление",
						ПрименитьСловарьКСтроке(ЗначениеКолонки.Представление));
				КонецЕсли;

			ИначеЕсли ТипЗнч(ЗначениеКолонки) = Тип("Строка") Тогда
				// Строковое значение
				НовоеЗначение = Неопределено;
				Если Policy.mode = "force_anonymize" Тогда
					НовоеЗначение = АнонимизироватьЗначениеВстроенный(ЗначениеКолонки, Policy.sources, ПравилаАнонимизации);
				ИначеЕсли Policy.mode = "default" Тогда
					НовоеЗначение = ПрименитьСловарьКСтроке(ЗначениеКолонки);
				КонецЕсли;
				Если НовоеЗначение <> Неопределено Тогда
					Если ТипЗнч(Строка) = Тип("Структура") Тогда
						Строка.Вставить(ИмяКолонки, НовоеЗначение);
					Иначе
						Строка[ИмяКолонки] = НовоеЗначение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	// Фаза regex: собрать тексты после словарной анонимизации
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegex(Результат, РегексКонтекст);
	КонецЕсли;

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// АНОНИМИЗАЦИЯ find_references_to_object
// ─────────────────────────────────────────────────────────────────────────────────

// Анонимизирует результат find_references_to_object: обходит hits и применяет
// трёхфазную анонимизацию (точные поля → словарь → regex) к чувствительным полям.
//
// Параметры:
//  Результат - Структура - результат инструмента {success, data: {hits, ...}}
//  РегексКонтекст - Структура, Неопределено - контекст для regex-фазы
//
&НаКлиенте
Процедура АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст = Неопределено)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизации();
	ПравилаАнонимизации = НастройкиАнонимизации.Правила;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;

	Для Каждого Хит Из Хиты Цикл
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		РежимFound = "default";
		SourcesFoundInObject = Новый Массив;

		// 1. found_in_object.Представление (документы/справочники)
		НайденВОбъекте = Неопределено;
		Если Хит.Свойство("found_in_object", НайденВОбъекте)
			И ТипЗнч(НайденВОбъекте) = Тип("Структура") Тогда
			РезОбъекта = АнонимизироватьПредставлениеObjectRef(НайденВОбъекте, ПравилаАнонимизации, АгрессивныйРежим);
			РежимFound = РезОбъекта.Режим;
			SourcesFoundInObject = РезОбъекта.Sources;
		КонецЕсли;

		// 2. record_key.*.Представление (objectRef-измерения регистров)
		ВсеИзмеренияЗащищены = Истина;
		ЕстьСсылочноеИзмерение = Ложь;
		ЕстьИзмерениеForceAnonymize = Ложь;
		КлючЗаписи = Неопределено;
		Если Хит.Свойство("record_key", КлючЗаписи)
			И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
			Для Каждого КВП Из КлючЗаписи Цикл
				Если ТипЗнч(КВП.Значение) = Тип("Структура") Тогда
					РезКлюча = АнонимизироватьПредставлениеObjectRef(КВП.Значение, ПравилаАнонимизации, АгрессивныйРежим);
					ЕстьСсылочноеИзмерение = Истина;
					Если РезКлюча.Режим = "force_anonymize" Тогда
						ЕстьИзмерениеForceAnonymize = Истина;
					КонецЕсли;
					Если РезКлюча.Режим <> "force_keep" Тогда
						ВсеИзмеренияЗащищены = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВсеИзмеренияЗащищены = ВсеИзмеренияЗащищены И ЕстьСсылочноеИзмерение;

		// 3. note
		Примечание = Неопределено;
		Если Хит.Свойство("note", Примечание)
			И ТипЗнч(Примечание) = Тип("Строка")
			И НЕ ПустаяСтрока(Примечание) Тогда
			Если НайденВОбъекте <> Неопределено Тогда
				// Документ/справочник: note следует режиму found_in_object
				Если РежимFound = "force_anonymize" Тогда
					Хит.Вставить("note", АнонимизироватьЗначениеВстроенный(Примечание, SourcesFoundInObject, ПравилаАнонимизации));
				ИначеЕсли РежимFound <> "force_keep" Тогда
					Хит.Вставить("note", ПрименитьСловарьКСтроке(Примечание));
				Иначе
				КонецЕсли;
			ИначеЕсли НЕ ВсеИзмеренияЗащищены Тогда
				// Регистр: обрабатываем если хотя бы одно измерение не force_keep
				Если АгрессивныйРежим Или ЕстьИзмерениеForceAnonymize Тогда
					Хит.Вставить("note", АнонимизаторТокенизировать(Примечание, "STR"));
				Иначе
					Хит.Вставить("note", ПрименитьСловарьКСтроке(Примечание));
				КонецЕсли;
			Иначе
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Phase 3: сбор текстов для regex-токенизации
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexFindReferences(Результат, РегексКонтекст, ПравилаАнонимизации, АгрессивныйРежим);
	КонецЕсли;

КонецПроцедуры

// Анонимизирует поле Представление в одном objectRef-описании (Phase 1 или Phase 2).
// Возвращает {Режим, Sources} для обработки note вызывающим кодом.
//
// Параметры:
//  ОписаниеОбъекта  - Структура - {_objectRef, ТипОбъекта, Представление, ...}
//  ПравилаАнонимизации - Соответствие - правила точной анонимизации
//  АгрессивныйРежим - Булево - признак агрессивного режима
//
&НаКлиенте
Функция АнонимизироватьПредставлениеObjectRef(ОписаниеОбъекта, ПравилаАнонимизации, АгрессивныйРежим)

	ПустойРезультат = Новый Структура("Режим, Sources", "default", Новый Массив);
	ЗащищённыйРезультат = Новый Структура("Режим, Sources", "force_keep", Новый Массив);

	ТипОбъекта = "";
	ОписаниеОбъекта.Свойство("ТипОбъекта", ТипОбъекта);
	Если Найти(ТипОбъекта, "ПеречислениеСсылка.") = 1 Тогда Возврат ЗащищённыйРезультат; КонецЕсли;

	Представление = Неопределено;
	Если НЕ ОписаниеОбъекта.Свойство("Представление", Представление) Тогда Возврат ПустойРезультат; КонецЕсли;
	Если ТипЗнч(Представление) <> Тип("Строка") Или ПустаяСтрока(Представление) Тогда Возврат ПустойРезультат; КонецЕсли;

	Режим = ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим);

	Если Режим = "force_keep" Тогда
		Возврат Новый Структура("Режим, Sources", Режим, Новый Массив);
	ИначеЕсли Режим = "force_anonymize" Тогда
		ПутьНаименования = ПолучитьПутьНаименованияПоТипуОбъекта(ТипОбъекта);
		МассивSources = Новый Массив;
		МассивSources.Добавить(?(НЕ ПустаяСтрока(ПутьНаименования), ПутьНаименования, ТипОбъекта));
		ОписаниеОбъекта.Вставить("Представление",
			АнонимизироватьЗначениеВстроенный(Представление, МассивSources, ПравилаАнонимизации));
		Возврат Новый Структура("Режим, Sources", Режим, МассивSources);
	КонецЕсли;

	// Phase 2: нет правила, не агрессивный — словарная замена
	ОписаниеОбъекта.Вставить("Представление", ПрименитьСловарьКСтроке(Представление));
	Возврат Новый Структура("Режим, Sources", "default", Новый Массив);

КонецФункции

// Собирает тексты из hits для regex-фазы анонимизации find_references_to_object.
// Аналог СобратьТекстыДляRegex / СобратьТекстыДляRegexОбъект для hits-структуры.
// Пропускает поля с force_keep (аналог execute_query line 16934).
//
// Параметры:
//  Результат           - Структура - результат инструмента
//  РегексКонтекст      - Структура - контекст: ВключённыеПравилаJSON, ТекстыJSON,
//                                    МаппингИндексов, ЕстьТекстыДляRegex
//  ПравилаАнонимизации - Соответствие - правила точной анонимизации
//  АгрессивныйРежим    - Булево - признак агрессивного режима
//
&НаКлиенте
Процедура СобратьТекстыДляRegexFindReferences(Результат, РегексКонтекст, ПравилаАнонимизации, АгрессивныйРежим)

	// Получить включённые regex-правила
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") Тогда
			Включено = Истина;
			Попытка Правило.Свойство("enabled", Включено); Исключение КонецПопытки;
			Если Включено Тогда
				ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ВключённыеПравила.Количество() = 0 Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	ТекстыМассив = Новый Массив;
	МаппингИндексов = Новый Массив;

	Для ХитИндекс = 0 По Хиты.Количество() - 1 Цикл
		Хит = Хиты[ХитИндекс];
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// found_in_object.Представление
		НайденВОбъектеN = Неопределено;
		РежимFoundN = "default";
		Если Хит.Свойство("found_in_object", НайденВОбъектеN)
			И ТипЗнч(НайденВОбъектеN) = Тип("Структура") Тогда
			ТипОбъекта = "";
			НайденВОбъектеN.Свойство("ТипОбъекта", ТипОбъекта);
			РежимFoundN = ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим);
			Если РежимFoundN <> "force_keep" Тогда
				Представление = Неопределено;
				Если НайденВОбъектеN.Свойство("Представление", Представление)
					И ТипЗнч(Представление) = Тип("Строка")
					И НЕ ПустаяСтрока(Представление) Тогда
					ТекстыМассив.Добавить(Представление);
					МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид", ХитИндекс, "found_in_object"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// record_key.*.Представление
		ВсеИзмеренияЗащищеныN = Истина;
		ЕстьСсылочноеИзмерениеN = Ложь;
		ЕстьИзмерениеForceAnonymizeN = Ложь;
		КлючЗаписи = Неопределено;
		Если Хит.Свойство("record_key", КлючЗаписи)
			И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
			Для Каждого КВП Из КлючЗаписи Цикл
				Если ТипЗнч(КВП.Значение) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				ТипОбъектаПоля = "";
				КВП.Значение.Свойство("ТипОбъекта", ТипОбъектаПоля);
				РежимПоля = ВычислитьРежимObjectRef(ТипОбъектаПоля, ПравилаАнонимизации, АгрессивныйРежим);
				ЕстьСсылочноеИзмерениеN = Истина;
				Если РежимПоля = "force_anonymize" Тогда
					ЕстьИзмерениеForceAnonymizeN = Истина;
				КонецЕсли;
				Если РежимПоля = "force_keep" Тогда Продолжить; КонецЕсли;
				ВсеИзмеренияЗащищеныN = Ложь;
				ПредставлениеПоля = Неопределено;
				Если КВП.Значение.Свойство("Представление", ПредставлениеПоля)
					И ТипЗнч(ПредставлениеПоля) = Тип("Строка")
					И НЕ ПустаяСтрока(ПредставлениеПоля) Тогда
					ТекстыМассив.Добавить(ПредставлениеПоля);
					МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид, ИмяПоля",
						ХитИндекс, "record_key", КВП.Ключ));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВсеИзмеренияЗащищеныN = ВсеИзмеренияЗащищеныN И ЕстьСсылочноеИзмерениеN;

		// note
		Примечание = Неопределено;
		ДобавитьNote = Ложь;
		Если Хит.Свойство("note", Примечание)
			И ТипЗнч(Примечание) = Тип("Строка")
			И НЕ ПустаяСтрока(Примечание) Тогда
			Если НайденВОбъектеN <> Неопределено Тогда
				ДобавитьNote = (РежимFoundN <> "force_keep");
			Иначе
				ДобавитьNote = НЕ ВсеИзмеренияЗащищеныN И НЕ ЕстьИзмерениеForceAnonymizeN;
			КонецЕсли;
		КонецЕсли;
		Если ДобавитьNote Тогда
			ТекстыМассив.Добавить(Примечание);
			МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид", ХитИндекс, "note"));
		КонецЕсли;

	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда Возврат; КонецЕсли;

	РегексКонтекст.Вставить("ВключённыеПравилаJSON", ЗаписатьJSON2(ВключённыеПравила));
	РегексКонтекст.Вставить("ТекстыJSON",            ЗаписатьJSON2(ТекстыМассив));
	РегексКонтекст.Вставить("МаппингИндексов",       МаппингИндексов);
	РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Истина);

КонецПроцедуры

// Применяет результаты regex-фазы к полям hits find_references_to_object.
// Аналог ПрименитьRegexТокены / ПрименитьRegexТокеныОбъект для hits-структуры.
//
// Параметры:
//  РегексКонтекст  - Структура - содержит Результат, МаппингИндексов
//  СовпаденияJSON  - Строка    - JSON-массив результатов regex
//
&НаКлиенте
Процедура ПрименитьRegexТокеныFindReferences(РегексКонтекст, СовпаденияJSON)

	Если ПустаяСтрока(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	МаппингИндексов = Неопределено;
	Если НЕ РегексКонтекст.Свойство("МаппингИндексов", МаппингИндексов)
		Или МаппингИндексов = Неопределено Тогда Возврат; КонецЕсли;

	Результат = Неопределено;
	Если НЕ РегексКонтекст.Свойство("Результат", Результат)
		Или ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	Попытка
		Совпадения = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Совпадения) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	// РезСовпадений — массив по тем же индексам, что и МаппингИндексов / ТекстыМассив.
	// Каждый элемент — массив совпадений {category, match, start, length}, отсортированных по start DESC.
	РезСовпадений = Совпадения;
	Для ТекстИндекс = 0 По МаппингИндексов.Количество() - 1 Цикл

		Если ТекстИндекс >= РезСовпадений.Количество() Тогда Прервать; КонецЕсли;

		ЭлСовпадений = РезСовпадений[ТекстИндекс];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда Продолжить; КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИндекс];
		Если ТипЗнч(МаппингЭлт) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		ХитИндекс = 0;
		МаппингЭлт.Свойство("ХитИндекс", ХитИндекс);
		Вид = "";
		МаппингЭлт.Свойство("Вид", Вид);

		Если ХитИндекс >= Хиты.Количество() Тогда Продолжить; КонецЕсли;
		Хит = Хиты[ХитИндекс];
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// Прочитать текущий текст из хита, сохранить ссылку для обратной записи
		ТекущийТекст    = "";
		СтруктураЗаписи = Неопределено; // структура, в которую пишем "Представление"
		ПрямаяЗапись    = Ложь;         // для "note" — пишем прямо в Хит

		Если Вид = "found_in_object" Тогда
			НайденВОбъекте = Неопределено;
			Если Хит.Свойство("found_in_object", НайденВОбъекте)
				И ТипЗнч(НайденВОбъекте) = Тип("Структура") Тогда
				НайденВОбъекте.Свойство("Представление", ТекущийТекст);
				СтруктураЗаписи = НайденВОбъекте;
			КонецЕсли;

		ИначеЕсли Вид = "record_key" Тогда
			ИмяПоля = "";
			МаппингЭлт.Свойство("ИмяПоля", ИмяПоля);
			КлючЗаписи = Неопределено;
			Если Хит.Свойство("record_key", КлючЗаписи)
				И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
				ЗначениеПоля = Неопределено;
				Если КлючЗаписи.Свойство(ИмяПоля, ЗначениеПоля)
					И ТипЗнч(ЗначениеПоля) = Тип("Структура") Тогда
					ЗначениеПоля.Свойство("Представление", ТекущийТекст);
					СтруктураЗаписи = ЗначениеПоля;
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли Вид = "note" Тогда
			Хит.Свойство("note", ТекущийТекст);
			ПрямаяЗапись = Истина;

		КонецЕсли;

		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Или ПустаяСтрока(ТекущийТекст) Тогда Продолжить; КонецЕсли;

		// Применить совпадения справа налево (отсортированы DESC по start)
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = "";
			МатчТекст = "";
			Начало    = 0;
			Длина     = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		// Записать результат обратно
		Если ПрямаяЗапись Тогда
			Хит.Вставить("note", НовыйТекст);
		ИначеЕсли СтруктураЗаписи <> Неопределено Тогда
			СтруктураЗаписи.Вставить("Представление", НовыйТекст);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Возвращает Истина если строка выглядит как GUID (8-4-4-4-12, UUID-формат).
// Используется чтобы не анонимизировать системные UID в поле user журнала регистрации.
//
&НаКлиенте
Функция ЭтоGUID(Знач Строка)
	Возврат СтрДлина(Строка) = 36
		И Сред(Строка,  9, 1) = "-"
		И Сред(Строка, 14, 1) = "-"
		И Сред(Строка, 19, 1) = "-"
		И Сред(Строка, 24, 1) = "-";
КонецФункции

// Анонимизирует результат get_access_rights: user.name и user.full_name → PER-токены
//
&НаКлиенте
Процедура АнонимизироватьРезультатGetAccessRights(Результат)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;
	Если НЕ Результат.Свойство("success") Или НЕ Результат.success Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные) Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	ДанныеПользователя = Неопределено;
	Если НЕ Данные.Свойство("user", ДанныеПользователя) Тогда Возврат; КонецЕсли;
	Если ТипЗнч(ДанныеПользователя) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	// name → PER-токен
	ИмяПольз = "";
	Если ДанныеПользователя.Свойство("name", ИмяПольз)
		И ТипЗнч(ИмяПольз) = Тип("Строка")
		И НЕ ПустаяСтрока(ИмяПольз) Тогда
		ДанныеПользователя.Вставить("name", АнонимизаторТокенизировать(ИмяПольз, "PER"));
	КонецЕсли;

	// full_name → PER-токен (поле опциональное)
	ПолноеИмя = "";
	Если ДанныеПользователя.Свойство("full_name", ПолноеИмя)
		И ТипЗнч(ПолноеИмя) = Тип("Строка")
		И НЕ ПустаяСтрока(ПолноеИмя) Тогда
		ДанныеПользователя.Вставить("full_name", АнонимизаторТокенизировать(ПолноеИмя, "PER"));
	КонецЕсли;

КонецПроцедуры

// Анонимизирует результат get_event_log (data — Массив записей).
// user  → АнонимизаторТокенизировать("PER"), если не UUID
// computer → АнонимизаторТокенизировать("STR"), всегда
// comment, data_presentation → словарная замена + regex-фаза
//
&НаКлиенте
Процедура АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст = Неопределено)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Результат.Свойство("success", РезультатУспех);
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизации();
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;

	Для ЗаписьИндекс = 0 По Данные.Количество() - 1 Цикл
		Запись = Данные[ЗаписьИндекс];
		Если ТипЗнч(Запись) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// user - токенизируем как персону, если не UUID
		Польз = "";
		Если Запись.Свойство("user", Польз)
			И ТипЗнч(Польз) = Тип("Строка")
			И НЕ ПустаяСтрока(Польз)
			И НЕ ЭтоGUID(Польз) Тогда
			Запись.Вставить("user", АнонимизаторТокенизировать(Польз, "PER"));
		КонецЕсли;

		// computer — всегда токенизируем как строку
		Комп = "";
		Если Запись.Свойство("computer", Комп)
			И ТипЗнч(Комп) = Тип("Строка")
			И НЕ ПустаяСтрока(Комп) Тогда
			Запись.Вставить("computer", АнонимизаторТокенизировать(Комп, "STR"));
		КонецЕсли;

		// comment — словарная замена (regex-фаза позже)
		Коммент = "";
		Если Запись.Свойство("comment", Коммент)
			И ТипЗнч(Коммент) = Тип("Строка")
			И НЕ ПустаяСтрока(Коммент) Тогда
			Запись.Вставить("comment", ПрименитьСловарьКСтроке(Коммент));
		КонецЕсли;

		// data_presentation — агрессивный режим: целиком; иначе — словарная замена (regex-фаза позже)
		ДатаПред = "";
		Если Запись.Свойство("data_presentation", ДатаПред)
			И ТипЗнч(ДатаПред) = Тип("Строка")
			И НЕ ПустаяСтрока(ДатаПред) Тогда
			Если АгрессивныйРежим Тогда
				Запись.Вставить("data_presentation", АнонимизаторТокенизировать(ДатаПред, "STR"));
			Иначе
				Запись.Вставить("data_presentation", ПрименитьСловарьКСтроке(ДатаПред));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Собрать тексты для regex-фазы
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexGetEventLog(Результат, РегексКонтекст, АгрессивныйРежим);
	КонецЕсли;

КонецПроцедуры

// Собирает comment и data_presentation из записей журнала для regex-фазы.
//
&НаКлиенте
Процедура СобратьТекстыДляRegexGetEventLog(Результат, РегексКонтекст, АгрессивныйРежим = Ложь)

	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") Тогда
			Включено = Истина;
			Попытка Правило.Свойство("enabled", Включено); Исключение КонецПопытки;
			Если Включено Тогда
				ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ВключённыеПравила.Количество() = 0 Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	ТекстыМассив  = Новый Массив;
	МаппингИндексов = Новый Массив;

	Для ЗаписьИндекс = 0 По Данные.Количество() - 1 Цикл
		Запись = Данные[ЗаписьИндекс];
		Если ТипЗнч(Запись) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// comment (после словарной замены)
		Коммент = "";
		Если Запись.Свойство("comment", Коммент)
			И ТипЗнч(Коммент) = Тип("Строка")
			И НЕ ПустаяСтрока(Коммент) Тогда
			ТекстыМассив.Добавить(Коммент);
			МаппингИндексов.Добавить(Новый Структура("ЗаписьИндекс, ИмяПоля", ЗаписьИндекс, "comment"));
		КонецЕсли;

		// data_presentation (после словарной замены) — только если не агрессивный режим
		Если НЕ АгрессивныйРежим Тогда
			ДатаПред = "";
			Если Запись.Свойство("data_presentation", ДатаПред)
				И ТипЗнч(ДатаПред) = Тип("Строка")
				И НЕ ПустаяСтрока(ДатаПред) Тогда
				ТекстыМассив.Добавить(ДатаПред);
				МаппингИндексов.Добавить(Новый Структура("ЗаписьИндекс, ИмяПоля", ЗаписьИндекс, "data_presentation"));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда Возврат; КонецЕсли;

	РегексКонтекст.Вставить("ВключённыеПравилаJSON", ЗаписатьJSON2(ВключённыеПравила));
	РегексКонтекст.Вставить("ТекстыJSON",            ЗаписатьJSON2(ТекстыМассив));
	РегексКонтекст.Вставить("МаппингИндексов",       МаппингИндексов);
	РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Истина);

КонецПроцедуры

// Применяет результаты regex-фазы к полям comment/data_presentation записей журнала.
//
&НаКлиенте
Процедура ПрименитьRegexТокеныGetEventLog(РегексКонтекст, СовпаденияJSON)

	Если ПустаяСтрока(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	МаппингИндексов = Неопределено;
	Если НЕ РегексКонтекст.Свойство("МаппингИндексов", МаппингИндексов)
		Или МаппингИндексов = Неопределено Тогда Возврат; КонецЕсли;

	Результат = Неопределено;
	Если НЕ РегексКонтекст.Свойство("Результат", Результат)
		Или ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	Попытка
		Совпадения = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Совпадения) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	РезСовпадений = Совпадения;
	Для ТекстИндекс = 0 По МаппингИндексов.Количество() - 1 Цикл

		Если ТекстИндекс >= РезСовпадений.Количество() Тогда Прервать; КонецЕсли;

		ЭлСовпадений = РезСовпадений[ТекстИндекс];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда Продолжить; КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИндекс];
		Если ТипЗнч(МаппингЭлт) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		ЗаписьИндекс = 0;
		МаппингЭлт.Свойство("ЗаписьИндекс", ЗаписьИндекс);
		ИмяПоля = "";
		МаппингЭлт.Свойство("ИмяПоля", ИмяПоля);

		Если ЗаписьИндекс >= Данные.Количество() Тогда Продолжить; КонецЕсли;
		Запись = Данные[ЗаписьИндекс];
		Если ТипЗнч(Запись) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		ТекущийТекст = "";
		Запись.Свойство(ИмяПоля, ТекущийТекст);
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Или ПустаяСтрока(ТекущийТекст) Тогда Продолжить; КонецЕсли;

		// Применить совпадения справа налево (отсортированы DESC по start)
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = "";
			МатчТекст = "";
			Начало    = 0;
			Длина     = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		Запись.Вставить(ИмяПоля, НовыйТекст);

	КонецЦикла;

КонецПроцедуры

// Анонимизирует результат get_object_by_link (data — Структура, не Массив).
// Поддерживает два режима:
//   - Schema mode: колонки берутся из schema, применяется policy
//   - Blind mode (_blind_anonymization = Истина): schema нет, токенизируем все строки
//
&НаКлиенте
Процедура АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст = Неопределено)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Результат.Свойство("success", РезультатУспех);
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные) Или ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	// — BLIND MODE —
	ЕстьСхема = Результат.Свойство("schema") И НЕ Результат.Свойство("_blind_anonymization");
	Если НЕ ЕстьСхема Тогда
		// Технические ключи, которые нельзя трогать
		СлужебныеКлючи = Новый Соответствие;
		СлужебныеКлючи.Вставить("_type",               Истина);
		СлужебныеКлючи.Вставить("_objectRef",          Истина);
		СлужебныеКлючи.Вставить("ТипОбъекта",          Истина);
		СлужебныеКлючи.Вставить("УникальныйИдентификатор", Истина);

		Для Каждого КВП Из Данные Цикл
			Если СлужебныеКлючи[КВП.Ключ] = Истина Тогда Продолжить; КонецЕсли;
			Значение = КВП.Значение;
			Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
				Данные.Вставить(КВП.Ключ, АнонимизаторТокенизировать(Значение, "STR"));
			ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
				// _objectRef или другая структура — токенизируем Представление
				ПредставлениеОбъекта = "";
				Если Значение.Свойство("Представление", ПредставлениеОбъекта)
					И ТипЗнч(ПредставлениеОбъекта) = Тип("Строка")
					И ПредставлениеОбъекта <> "" Тогда
					Значение.Вставить("Представление", АнонимизаторТокенизировать(ПредставлениеОбъекта, "STR"));
				КонецЕсли;
			ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
				// ТЧ или массив строк (ФиксированныйМассив → Массив после ПреобразоватьЗначениеДляJSON)
				Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
					ЭлтМасс = Значение[ЭлтИнд];
					Если ТипЗнч(ЭлтМасс) = Тип("Строка") И ЭлтМасс <> "" Тогда
						Значение[ЭлтИнд] = АнонимизаторТокенизировать(ЭлтМасс, "STR");
					ИначеЕсли ТипЗнч(ЭлтМасс) = Тип("Структура") Тогда
						Для Каждого КВПСтр Из ЭлтМасс Цикл
							Если СлужебныеКлючи[КВПСтр.Ключ] = Истина Тогда Продолжить; КонецЕсли;
							ЗнчСтр = КВПСтр.Значение;
							Если ТипЗнч(ЗнчСтр) = Тип("Строка") И ЗнчСтр <> "" Тогда
								ЭлтМасс.Вставить(КВПСтр.Ключ, АнонимизаторТокенизировать(ЗнчСтр, "STR"));
							ИначеЕсли ТипЗнч(ЗнчСтр) = Тип("Структура") Тогда
								ПредстСтр = "";
								Если ЗнчСтр.Свойство("Представление", ПредстСтр)
									И ТипЗнч(ПредстСтр) = Тип("Строка") И ПредстСтр <> "" Тогда
									ЗнчСтр.Вставить("Представление", АнонимизаторТокенизировать(ПредстСтр, "STR"));
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		// Regex в blind mode не запускаем — все строки уже целиком токенизированы
		// РегексКонтекст.ЕстьТекстыДляRegex остаётся Ложь
		Возврат;
	КонецЕсли;

	// — SCHEMA MODE —
	ПравилаАнонимизации = ПолучитьНастройкиТочнойАнонимизации().Правила;

	Схема = Результат.schema;
	Колонки = Неопределено;
	Если НЕ Схема.Свойство("columns", Колонки) Или ТипЗнч(Колонки) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	// Карта политик основных колонок
	СоответствиеPolicy = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
		ИмяКолонки = "";
		Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
		Режим = "default";      Колонка.Свойство("anonymization_mode", Режим);
		РежимСсылки = "default"; Колонка.Свойство("reference_presentation_mode", РежимСсылки);
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		СоответствиеPolicy.Вставить(ИмяКолонки,
			Новый Структура("mode, ref_mode, sources", Режим, РежимСсылки, Sources));
	КонецЦикла;

	// Карты политик табличных частей
	СоответствиеPolicyТЧ = Новый Соответствие; // ИмяТЧ -> Соответствие (имя колонки -> policy)
	ТабличныеЧасти = Неопределено;
	Если Схема.Свойство("tabular_sections", ТабличныеЧасти) Тогда
		Для Каждого КВПтч Из ТабличныеЧасти Цикл
			ИмяТЧ    = КВПтч.Ключ;
			СхемаТЧ  = КВПтч.Значение;
			PolicyТЧ = Новый Соответствие;
			КолонкиТЧ = Неопределено;
			Если СхемаТЧ.Свойство("columns", КолонкиТЧ) Тогда
				Для Каждого КолТЧ Из КолонкиТЧ Цикл
					Если ТипЗнч(КолТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
					ИмяКол = ""; Если НЕ КолТЧ.Свойство("name", ИмяКол) Тогда Продолжить; КонецЕсли;
					Реж = "default";      КолТЧ.Свойство("anonymization_mode", Реж);
					РежСсылки = "default"; КолТЧ.Свойство("reference_presentation_mode", РежСсылки);
					Src = ПолучитьМассивСтрокИзСвойства(КолТЧ, "sources");
					PolicyТЧ.Вставить(ИмяКол,
						Новый Структура("mode, ref_mode, sources", Реж, РежСсылки, Src));
				КонецЦикла;
			КонецЕсли;
			СоответствиеPolicyТЧ.Вставить(ИмяТЧ, PolicyТЧ);
		КонецЦикла;
	КонецЕсли;

	// Обходим поля data (Структура)
	Для Каждого КВП Из Данные Цикл
		ИмяПоля = КВП.Ключ;
		Значение = КВП.Значение;

		// Табличная часть?
		Если СоответствиеPolicyТЧ[ИмяПоля] <> Неопределено
			И ТипЗнч(Значение) = Тип("Массив") Тогда
			PolicyМапТЧ = СоответствиеPolicyТЧ[ИмяПоля];
			Для Каждого СтрокаТЧ Из Значение Цикл
				Если ТипЗнч(СтрокаТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				Для Каждого PolicyЭлт Из PolicyМапТЧ Цикл
					ИмяКолонки = PolicyЭлт.Ключ;
					Policy      = PolicyЭлт.Значение;
					ЗначениеКолонки = Неопределено;
					Если НЕ СтрокаТЧ.Свойство(ИмяКолонки, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
					Если ЗначениеКолонки = Неопределено Тогда Продолжить; КонецЕсли;
					ОбработатьЗначениеОбъектаВстроенный(СтрокаТЧ, ИмяКолонки, ЗначениеКолонки, Policy, ПравилаАнонимизации);
				КонецЦикла;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		// Обычное поле
		Policy = СоответствиеPolicy[ИмяПоля];
		Если Policy = Неопределено Тогда Продолжить; КонецЕсли;
		ОбработатьЗначениеОбъектаВстроенный(Данные, ИмяПоля, Значение, Policy, ПравилаАнонимизации);
	КонецЦикла;

	// Фаза regex
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexОбъект(Результат, РегексКонтекст);
	КонецЕсли;

КонецПроцедуры

// Вспомогательная — применяет policy к одному полю объекта/строки ТЧ
&НаКлиенте
Процедура ОбработатьЗначениеОбъектаВстроенный(Контейнер, ИмяПоля, Значение, Policy, ПравилаАнонимизации)

	Если ТипЗнч(Значение) = Тип("Структура")
		И Значение.Свойство("Представление") Тогда
		// objectRef — анонимизируем Представление по ref_mode
		ТипОбъектаЗначения = "";
		Значение.Свойство("ТипОбъекта", ТипОбъектаЗначения);
		Если Найти(ТипОбъектаЗначения, "ПеречислениеСсылка.") = 1 Тогда Возврат; КонецЕсли;
		Если Найти(ТипОбъектаЗначения, "ПланСчетовСсылка.") = 1
			И Policy.mode <> "force_anonymize" И Policy.ref_mode <> "force_anonymize" Тогда
			Возврат;
		КонецЕсли;
		Если Policy.mode = "force_keep" Тогда Возврат;
		ИначеЕсли Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
			Значение.Вставить("Представление",
				АнонимизироватьЗначениеВстроенный(Значение.Представление, Policy.sources, ПравилаАнонимизации));
		ИначеЕсли Policy.ref_mode = "force_keep" Тогда Возврат;
		Иначе
			Значение.Вставить("Представление", ПрименитьСловарьКСтроке(Значение.Представление));
		КонецЕсли;

	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		НовоеЗначение = Неопределено;
		Если Policy.mode = "force_anonymize" Тогда
			НовоеЗначение = АнонимизироватьЗначениеВстроенный(Значение, Policy.sources, ПравилаАнонимизации);
		ИначеЕсли Policy.mode = "default" Тогда
			НовоеЗначение = ПрименитьСловарьКСтроке(Значение);
		КонецЕсли;
		Если НовоеЗначение <> Неопределено Тогда
			Контейнер.Вставить(ИмяПоля, НовоеЗначение);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		// Реквизит типа ФиксированныйМассив (строки или ссылки) после ПреобразоватьЗначениеДляJSON
		Если Policy.mode = "force_keep" Тогда Возврат; КонецЕсли;
		Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
			Элт = Значение[ЭлтИнд];
			Если ТипЗнч(Элт) = Тип("Структура") И Элт.Свойство("Представление") Тогда
				ТипОбъектаЭлт = "";
				Элт.Свойство("ТипОбъекта", ТипОбъектаЭлт);
				Если Найти(ТипОбъектаЭлт, "ПеречислениеСсылка.") = 1 Тогда Продолжить; КонецЕсли;
				Если Найти(ТипОбъектаЭлт, "ПланСчетовСсылка.") = 1
					И Policy.mode <> "force_anonymize" И Policy.ref_mode <> "force_anonymize" Тогда
					Продолжить;
				КонецЕсли;
				Если Policy.ref_mode = "force_keep" Тогда Продолжить; КонецЕсли;
				Если Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
					Элт.Вставить("Представление",
						АнонимизироватьЗначениеВстроенный(Элт.Представление, Policy.sources, ПравилаАнонимизации));
				Иначе
					Элт.Вставить("Представление", ПрименитьСловарьКСтроке(Элт.Представление));
				КонецЕсли;
			ИначеЕсли ТипЗнч(Элт) = Тип("Строка") Тогда
				НовЭлт = Неопределено;
				Если Policy.mode = "force_anonymize" Тогда
					НовЭлт = АнонимизироватьЗначениеВстроенный(Элт, Policy.sources, ПравилаАнонимизации);
				ИначеЕсли Policy.mode = "default" Тогда
					НовЭлт = ПрименитьСловарьКСтроке(Элт);
				КонецЕсли;
				Если НовЭлт <> Неопределено Тогда
					Значение[ЭлтИнд] = НовЭлт;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуМаппинговВстроенный()

	АнонимизаторИнициализировать();
	ТаблицаМаппингов.Очистить();

	Если МаппингДеанонимизации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстПоиска = НРег(СокрЛП(ПоискМаппингов));
	Всего = 0;

	Для Каждого КвП Из МаппингДеанонимизации Цикл
		Токен           = КвП.Ключ;
		РеальноеЗначение = КвП.Значение;

		Категория = "";
		Если СтрДлина(Токен) > 2 И Лев(Токен, 1) = "[" Тогда
			Внутренняя = Сред(Токен, 2, СтрДлина(Токен) - 2);
			ПозДефиса  = Найти(Внутренняя, "-");
			Если ПозДефиса > 0 Тогда
				Категория = Лев(Внутренняя, ПозДефиса - 1);
			КонецЕсли;
		КонецЕсли;

		Всего = Всего + 1;

		Если Не ПустаяСтрока(ТекстПоиска) Тогда
			Если Найти(НРег(Токен), ТекстПоиска) = 0
				И Найти(НРег(РеальноеЗначение), ТекстПоиска) = 0
				И Найти(НРег(Категория), ТекстПоиска) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока = ТаблицаМаппингов.Добавить();
		НоваяСтрока.Токен           = Токен;
		НоваяСтрока.РеальноеЗначение = РеальноеЗначение;
		НоваяСтрока.Категория       = Категория;
	КонецЦикла;

	Количество = ТаблицаМаппингов.Количество();
	Если Не ПустаяСтрока(ТекстПоиска) Тогда
		Элементы.НадписьСтатистикаМаппингов.Заголовок = "Показано " + Количество + " из " + Всего;
	Иначе
		Элементы.НадписьСтатистикаМаппингов.Заголовок = "Всего записей: " + Всего;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ДеТокенизироватьРекурсивно(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат АнонимизаторДеТокенизироватьСтроку(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Ключи = Новый Массив;
		НовыеЗначения = Новый Массив;
		Для Каждого КвП Из Значение Цикл
			Ключи.Добавить(КвП.Ключ);
			НовыеЗначения.Добавить(ДеТокенизироватьРекурсивно(КвП.Значение));
		КонецЦикла;
		Для Инд = 0 По Ключи.ВГраница() Цикл
			Значение.Вставить(Ключи[Инд], НовыеЗначения[Инд]);
		КонецЦикла;

	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Ключи = Новый Массив;
		НовыеЗначения = Новый Массив;
		Для Каждого КвП Из Значение Цикл
			Ключи.Добавить(КвП.Ключ);
			НовыеЗначения.Добавить(ДеТокенизироватьРекурсивно(КвП.Значение));
		КонецЦикла;
		Для Инд = 0 По Ключи.ВГраница() Цикл
			Значение.Вставить(Ключи[Инд], НовыеЗначения[Инд]);
		КонецЦикла;

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Инд = 0 По Значение.ВГраница() Цикл
			Значение[Инд] = ДеТокенизироватьРекурсивно(Значение[Инд]);
		КонецЦикла;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Единая граница запроса для встроенного режима: детокенизация входящих параметров,
// затем обязательный prune. Порядок важен — сначала детокенизация (использованные токены
// остаются в карте для round-trip), потом вытеснение старья. prune нельзя прятать внутри
// ДеАнонимизироватьПараметрыКоманды из-за её ранних Возврат — поэтому обёртка, и ею заменены
// ВСЕ три транспортных вызова (ОбработатьКоманду, ОбработатьToolsCall, ОбработатьRESTЗапрос).
&НаКлиенте
Процедура ДеАнонимизироватьПараметрыКомандыИВытеснить(Команда)

	ДеАнонимизироватьПараметрыКоманды(Команда);
	АнонимизаторВытеснитьДоЛимита();

КонецПроцедуры

&НаКлиенте
Процедура ДеАнонимизироватьПараметрыКоманды(Команда)

	АнонимизаторИнициализировать();

	Если МаппингДеанонимизации = Неопределено
		Или МаппингДеанонимизации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Команда.Свойство("params") Или Команда.params = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Поля с кодом/текстом запроса требуют специального экранирования кавычек
	КодовыеПоля = Новый Соответствие;
	КодовыеПоля.Вставить("execute_code",  "code");
	КодовыеПоля.Вставить("execute_query", "query");

	КодовоеПоле = КодовыеПоля.Получить(Команда.tool);
	Если КодовоеПоле <> Неопределено Тогда
		НовыеПараметры = Новый Структура;
		Для Каждого КвП Из Команда.params Цикл
			Если КвП.Ключ = КодовоеПоле Тогда
				Если Команда.tool = "execute_query" Тогда
					НовыеПараметры.Вставить(КвП.Ключ,
						АнонимизаторДеТокенизироватьСтрокуДляЗапроса(КвП.Значение));
				Иначе
					НовыеПараметры.Вставить(КвП.Ключ,
						АнонимизаторДеТокенизироватьСтрокуВBSL(КвП.Значение));
				КонецЕсли;
			Иначе
				НовыеПараметры.Вставить(КвП.Ключ, ДеТокенизироватьРекурсивно(КвП.Значение));
			КонецЕсли;
		КонецЦикла;
		Команда.Вставить("params", НовыеПараметры);
		Возврат;
	КонецЕсли;

	Команда.Вставить("params", ДеТокенизироватьРекурсивно(Команда.params));

КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// АНОНИМИЗАЦИЯ — ПРОСМОТР МАППИНГОВ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ОбновитьМаппинги(Команда)
	ЗагрузитьМаппинги();
КонецПроцедуры

&НаКлиенте
Процедура ДеАнонимизироватьТекст(Команда)
	Если РежимПодключения = 0 Тогда
		// Прокси: синхронно обновить кэш с сервера (при ошибке — использует последний успешный кэш)
		ЗагрузитьМаппинги();
		// Пересоздать МаппингДеанонимизации из кэша (избежать смеси старых и новых данных)
		ЗаполнитьМаппингДеАнонимизацииИзКэша();
	КонецЕсли;
	// Встроенный режим: МаппингДеанонимизации уже актуален из текущей сессии
	ТекстДляДеАнонимизации = АнонимизаторДеТокенизироватьСтроку(ТекстДляДеАнонимизации);
	ОбновитьПросмотрMarkdown();
КонецПроцедуры

&НаКлиенте
Процедура АнонимизироватьТекст(Команда)
	// Только встроенный режим — в proxy-режиме кнопка скрыта, но защита на всякий случай
	Если РежимПодключения = 0 Тогда Возврат; КонецЕсли;
	ТекстДляДеАнонимизации = АнонимизаторАнонимизироватьСтроку(ТекстДляДеАнонимизации);
	ОбновитьТаблицуМаппинговВстроенный(); // синхронизировать список маппингов в UI
	ОбновитьПросмотрMarkdown();
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьSubmitForDeanonymization(Текст)
	// Попытка герметизирует весь блок: даже при исключении агент получает только
	// фиксированную безопасную строку, а не ОписаниеОшибки() с деанонимизированными данными
	Попытка
		Если РежимПодключения = 0 Тогда
			ЗагрузитьМаппинги();
			ЗаполнитьМаппингДеАнонимизацииИзКэша();
		КонецЕсли;

		ДеАнонимизированный = АнонимизаторДеТокенизироватьСтроку(Текст);

		ВремяМетка = Формат(ТекущаяДата(), "ДФ='HH:mm:ss dd.MM.yyyy'");
		Разделитель = "═══════ [" + ВремяМетка + "] ═══════";

		Если ПустаяСтрока(ТекстДляДеАнонимизации) Тогда
			ТекстДляДеАнонимизации = Разделитель + Символы.ПС + Символы.ПС + ДеАнонимизированный;
		Иначе
			ТекстДляДеАнонимизации = ТекстДляДеАнонимизации
				+ Символы.ПС + Символы.ПС
				+ Разделитель + Символы.ПС + Символы.ПС
				+ ДеАнонимизированный;
		КонецЕсли;
		ОбновитьПросмотрMarkdown();

		// success=Истина нужен для ОтправитьРезультатНаСервер (proxy-режим);
		// received=Истина — содержательное поле ответа агенту
		Возврат Новый Структура("success, received", Истина, Истина);
	Исключение
		// Фиксированная строка — ОписаниеОшибки() не возвращаем, там могут быть реальные данные
		Возврат Новый Структура("success, error", Ложь, "submit_for_deanonymization failed");
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПолеТекстДляДеАнонимизацииПриИзменении(Элемент)
	ОбновитьПросмотрMarkdown();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПросмотрMarkdown()
	Если ПустаяСтрока(ШаблонMarkdownПросмотра) Тогда
		Возврат;
	КонецЕсли;
	КонтентHTML = ЭкранироватьHTMLДляПросмотра(ТекстДляДеАнонимизации);
	ТекстДляДеАнонимизацииHTML = СтрЗаменить(ШаблонMarkdownПросмотра, "{{HTML_ESCAPED_CONTENT}}", КонтентHTML);
КонецПроцедуры

&НаКлиенте
Функция ЭкранироватьHTMLДляПросмотра(Знач Текст)
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Возврат Текст;
КонецФункции

&НаКлиенте
Процедура ПоискМаппинговПриИзменении(Элемент)
	ЗаполнитьТаблицуМаппингов(); // перефильтровка из кэша без HTTP-запроса
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМаппинги()

	Если РежимПодключения <> 0 Тогда
		ЗаполнитьТаблицуМаппингов();
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(АдресСервера) Тогда
		Элементы.НадписьСтатистикаМаппингов.Заголовок = "Не указан адрес сервера";
		Возврат;
	КонецЕсли;

	Попытка
		СтруктураURL = РазобратьURL(АдресСервера);

		Если СтруктураURL.Протокол = "https" Тогда
			Соединение = Новый HTTPСоединение(СтруктураURL.Хост, СтруктураURL.Порт, , , , 10, Новый ЗащищенноеСоединениеOpenSSL());
		Иначе
			Соединение = Новый HTTPСоединение(СтруктураURL.Хост, СтруктураURL.Порт, , , , 10);
		КонецЕсли;

		ПараметрыЗапроса = Новый Структура;
		Если Не ПустаяСтрока(ИдентификаторКанала) Тогда
			ПараметрыЗапроса.Вставить("channel", СокрЛП(ИдентификаторКанала));
		КонецЕсли;

		ПутьЗапроса = СформироватьПутьЗапроса(СтруктураURL.Путь + "/1c/anonymization_mappings", ПараметрыЗапроса);

		Запрос = Новый HTTPЗапрос(ПутьЗапроса);
		Запрос.Заголовки.Вставить("Accept", "application/json");

		Ответ = Соединение.Получить(Запрос);

		Если Ответ.КодСостояния = 200 Тогда
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			Если Не ПустаяСтрока(ТелоОтвета) Тогда
				КэшМаппинговОтвет = ПрочитатьJSON2(ТелоОтвета);
				ЗаполнитьТаблицуМаппингов();
			Иначе
				Элементы.НадписьСтатистикаМаппингов.Заголовок = "Пустой ответ от сервера";
			КонецЕсли;
		Иначе
			// Кэш НЕ очищаем — оставляем старые данные при ошибке
			Элементы.НадписьСтатистикаМаппингов.Заголовок = "Ошибка: HTTP " + Ответ.КодСостояния;
		КонецЕсли;

	Исключение
		// Кэш НЕ очищаем — оставляем старые данные при ошибке соединения
		Элементы.НадписьСтатистикаМаппингов.Заголовок = "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуМаппингов()

	Если РежимПодключения <> 0 Тогда
		ОбновитьТаблицуМаппинговВстроенный();
		Возврат;
	КонецЕсли;

	ТаблицаМаппингов.Очистить();

	Если КэшМаппинговОтвет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Проверка: анонимизация отключена на сервере
	АнонВключена = Неопределено;
	Если ТипЗнч(КэшМаппинговОтвет) = Тип("Структура") Тогда
		КэшМаппинговОтвет.Свойство("enabled", АнонВключена);
	Иначе
		АнонВключена = КэшМаппинговОтвет["enabled"];
	КонецЕсли;

	Если АнонВключена = Ложь Тогда
		Элементы.НадписьСтатистикаМаппингов.Заголовок = "Анонимизация отключена на сервере";
		Возврат;
	КонецЕсли;

	// Получаем массив маппингов
	Маппинги = Неопределено;
	Если ТипЗнч(КэшМаппинговОтвет) = Тип("Структура") Тогда
		КэшМаппинговОтвет.Свойство("mappings", Маппинги);
	Иначе
		Маппинги = КэшМаппинговОтвет["mappings"];
	КонецЕсли;

	Если Маппинги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Фильтр (регистронезависимый)
	ТекстПоиска = НРег(СокрЛП(ПоискМаппингов));
	Всего = Маппинги.Количество();

	Для Каждого Элт Из Маппинги Цикл
		Токен = "";
		РеальноеЗначение = "";
		Категория = "";

		Если ТипЗнч(Элт) = Тип("Структура") Тогда
			Элт.Свойство("token", Токен);
			Элт.Свойство("real_value", РеальноеЗначение);
			Элт.Свойство("category", Категория);
		Иначе
			Токен = Элт["token"];
			РеальноеЗначение = Элт["real_value"];
			Категория = Элт["category"];
		КонецЕсли;

		// Клиентская фильтрация
		Если Не ПустаяСтрока(ТекстПоиска) Тогда
			Если Найти(НРег(Токен), ТекстПоиска) = 0
				И Найти(НРег(РеальноеЗначение), ТекстПоиска) = 0
				И Найти(НРег(Категория), ТекстПоиска) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока = ТаблицаМаппингов.Добавить();
		НоваяСтрока.Токен = Токен;
		НоваяСтрока.РеальноеЗначение = РеальноеЗначение;
		НоваяСтрока.Категория = Категория;
	КонецЦикла;

	// Статистика
	Количество = ТаблицаМаппингов.Количество();
	Если Не ПустаяСтрока(ТекстПоиска) Тогда
		Элементы.НадписьСтатистикаМаппингов.Заголовок = "Показано " + Количество + " из " + Всего;
	Иначе
		Элементы.НадписьСтатистикаМаппингов.Заголовок = "Всего записей: " + Всего;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМаппингДеАнонимизацииИзКэша()
	// Явно пересоздаём — не просто вставляем, чтобы не смешать со старыми данными
	МаппингДеанонимизации = Новый Соответствие;

	Если КэшМаппинговОтвет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Проверяем флаг enabled — аналогично ЗаполнитьТаблицуМаппингов()
	АнонВключена = Неопределено;
	Если ТипЗнч(КэшМаппинговОтвет) = Тип("Структура") Тогда
		КэшМаппинговОтвет.Свойство("enabled", АнонВключена);
	Иначе
		АнонВключена = КэшМаппинговОтвет["enabled"];
	КонецЕсли;
	Если АнонВключена = Ложь Тогда
		Возврат; // Анонимизация отключена на сервере — маппинги не используем
	КонецЕсли;

	Маппинги = Неопределено;
	Если ТипЗнч(КэшМаппинговОтвет) = Тип("Структура") Тогда
		КэшМаппинговОтвет.Свойство("mappings", Маппинги);
	Иначе
		Маппинги = КэшМаппинговОтвет["mappings"];
	КонецЕсли;

	Если Маппинги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элт Из Маппинги Цикл
		Токен = "";
		РеальноеЗначение = "";
		Если ТипЗнч(Элт) = Тип("Структура") Тогда
			Элт.Свойство("token", Токен);
			Элт.Свойство("real_value", РеальноеЗначение);
		Иначе
			Токен = Элт["token"];
			РеальноеЗначение = Элт["real_value"];
		КонецЕсли;
		Если Не ПустаяСтрока(Токен) Тогда
			МаппингДеанонимизации.Вставить(ВРег(Токен), РеальноеЗначение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

