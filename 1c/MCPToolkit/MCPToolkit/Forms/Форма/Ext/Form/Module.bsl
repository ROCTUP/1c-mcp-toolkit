Функция МКПШаблонСкриптаSH()
	Возврат "#!/bin/bash
|MCP_OPERATION='__MCP_OPERATION__'
|MCP_PARAMS='__MCP_PARAMS__'
|MCP_MAPPINGS='__MCP_MAPPINGS__'
