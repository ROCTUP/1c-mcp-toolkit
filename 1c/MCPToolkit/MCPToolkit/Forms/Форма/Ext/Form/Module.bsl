// Читает сохраненный выбор строгого режима. Вызывается один раз при открытии формы:
// позднее значение из хранилища не перечитывается, состояние защиты живет в памяти.
//
// Параметры:
//  Нет
//
// Возвращаемое значение:
//  Булево - Истина, только если в хранилище сохранено значение Истина.
//
&НаСервереБезКонтекста
Функция ПрочитатьВыборСтрогогоРежимаНаСервере()

	Возврат ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "СтрогийРежимАнонимизации") = Истина;

КонецФункции

// Сохраняет выбор строгого режима. Вызывают только обработчики элементов формы, которые меняет человек: флажок
// строгого режима, а также выключение маскирования и уход из встроенного сервера (сохраняют Ложь).
//
// Параметры:
//  Значение - Булево - выбранное значение.
//
&НаСервереБезКонтекста
Процедура СохранитьВыборСтрогогоРежимаНаСервере(Значение)

	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "СтрогийРежимАнонимизации", Значение);

КонецПроцедуры

&НаКлиенте
Процедура ПараллельноеВыполнениеПриИзменении(Элемент)

	Если НЕ ПараллельноеВыполнение Тогда
		ПараллельноеВыполнениеСохранитьНаСервере(Ложь);
		МеханизмФоновогоЗапуска = "";
		ДобавитьВЛог("Параллельное выполнение выключено. Незавершенные задания дорабатывают.");
		Возврат;
	КонецЕсли;

	// Включение проверяется здесь, а не при первом запросе: иначе флажок стоял бы
	// включенным в базе, где фон невозможен, и механизм выглядел бы сломанным.
	Проверка = ПроверитьВозможностьПараллельногоВыполнения();

	Если НЕ Проверка.Доступно Тогда
		ПараллельноеВыполнение = Ложь;
		ПараллельноеВыполнениеСохранитьНаСервере(Ложь);
		БСПДоступна = Ложь;
		МеханизмФоновогоЗапуска = "";
		ДобавитьВЛог("Параллельное выполнение недоступно (" + Проверка.Причина + "): "
			+ СтрЗаменить(Проверка.Текст, Символы.ПС, " "));
		ПоказатьПредупреждение(Неопределено, Проверка.Текст, , "Параллельное выполнение недоступно");
		Возврат;
	КонецЕсли;

	ПараллельноеВыполнениеСохранитьНаСервере(Истина);
	БСПДоступна = Истина;
	МеханизмФоновогоЗапуска = Проверка.Механизм;
	ДобавитьВЛог("Параллельное выполнение включено."
		+ ?(ЗначениеЗаполнено(Проверка.ВерсияБСП), " БСП " + Проверка.ВерсияБСП + ".", "")
		+ " Механизм запуска: " + Проверка.Механизм + ".");

	Если ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
		ДобавитьВЛог("Оговорка (" + Проверка.Причина + "): "
			+ СтрЗаменить(Проверка.Предупреждение, Символы.ПС, " "));
		ПоказатьПредупреждение(Неопределено, Проверка.Предупреждение, , "Параллельное выполнение включено с оговоркой");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СнятьПараллельноеВыполнениеЕслиНедоступно()

	Если НЕ ПараллельноеВыполнение Тогда
		Возврат;
	КонецЕсли;

	// Флажок могли включить до запуска сервера — тогда пробного запуска не было, механизм
	// выбран только по наличию методов. Здесь обработка уже развернута, поэтому сценарий
	// проверяется целиком: право на фоновые задания, запрет регламентных заданий в базе
	// и сам запуск каждым кандидатом. Иначе такая база молчала бы до первого запроса.
	Проверка = ПроверитьВозможностьПараллельногоВыполнения();

	Если Проверка.Доступно Тогда
		МеханизмФоновогоЗапуска = Проверка.Механизм;
		БСПДоступна = Истина;
		Если ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
			ДобавитьВЛог("Оговорка (" + Проверка.Причина + "): "
				+ СтрЗаменить(Проверка.Предупреждение, Символы.ПС, " "));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПараллельноеВыполнение = Ложь;
	ПараллельноеВыполнениеСохранитьНаСервере(Ложь);
	БСПДоступна = Ложь;
	МеханизмФоновогоЗапуска = "";
	ДобавитьВЛог("Параллельное выполнение отключено (" + Проверка.Причина + "): "
		+ СтрЗаменить(Проверка.Текст, Символы.ПС, " "));

КонецПроцедуры

