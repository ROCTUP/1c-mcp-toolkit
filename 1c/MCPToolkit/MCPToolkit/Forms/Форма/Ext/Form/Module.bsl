			Выполнить("ИмяОбработкиЗапуска = ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(СсылкаЗапуска);");
			Если Не ЗначениеЗаполнено(ИмяОбработкиЗапуска) Тогда ВызватьИсключение "БСП не подключила зарегистрированную обработку."; КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("reference,name,fingerprint", СсылкаЗапуска, ИмяОбработкиЗапуска, ХешРегистрации);
КонецФункции

