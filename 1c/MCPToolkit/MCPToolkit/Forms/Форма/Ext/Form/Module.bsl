&НаКлиентеНаСервереБезКонтекста
Функция СформироватьRESTGETОшибкаЦелого(ИмяПоля, СыройТекст)
	
	ИмяПоля = СокрЛП(Строка(ИмяПоля));
	СыройТекст = Строка(СыройТекст);
	
	Сообщение = "Ошибка валидации: " + ИмяПоля + " должен быть целым числом, получено '" + СыройТекст + "' / "
		+ "Validation error: " + ИмяПоля + " must be an integer, got '" + СыройТекст + "'";
	
	Лок = Новый Массив;
	Лок.Добавить(ИмяПоля);
	
	Детали = Новый Массив;
	Детали.Добавить(Новый Структура(
		"loc, msg, type, input",
		Лок,
		"value is not a valid integer",
		"int_parsing",
		СыройТекст
	));
	
	Возврат СформироватьRESTОшибка(422, Сообщение, Детали);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, ИмяПоля)
	
	// Если поле отсутствует — ок.
	// Если есть и это строка, но не целое — возвращает структуру REST ошибки (КодОтвета/Тело).
	// Если можно распарсить — заменяет значение на целое и возвращает Неопределено.
	
	Если RESTПараметры = Неопределено Или ТипЗнч(RESTПараметры) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ RESTПараметры.Свойство(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сырой = RESTПараметры[ИмяПоля];
	
	// Если пришло несколько значений — берём первое (как request.query_params.get в прокси).
	Если ТипЗнч(Сырой) = Тип("Массив") Или ТипЗнч(Сырой) = Тип("ФиксированныйМассив") Тогда
		Если Сырой.Количество() = 0 Тогда
			Сырой = "";
		Иначе
			Сырой = Сырой[0];
		КонецЕсли;
	КонецЕсли;
	
	Если Сырой = Null Или Сырой = Неопределено Тогда
		Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, "");
	КонецЕсли;
	
	Если ТипЗнч(Сырой) = Тип("Число") Тогда
		Если Сырой <> Цел(Сырой) Тогда
			Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, Строка(Сырой));
		КонецЕсли;
		RESTПараметры.Вставить(ИмяПоля, Цел(Сырой));
		Возврат Неопределено;
	КонецЕсли;
	
	СыройСтрока = СокрЛП(Строка(Сырой));
	Если ПустаяСтрока(СыройСтрока) Тогда
		Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, СыройСтрока);
	КонецЕсли;
	
	ЧислоЗначение = Неопределено;
	Попытка
		ЧислоЗначение = Число(СыройСтрока);
	Исключение
		ЧислоЗначение = Неопределено;
	КонецПопытки;
	
	Если ЧислоЗначение = Неопределено Или ЧислоЗначение <> Цел(ЧислоЗначение) Тогда
		Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, СыройСтрока);
	КонецЕсли;
	
	RESTПараметры.Вставить(ИмяПоля, Цел(ЧислоЗначение));
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ОбработатьRESTЗапрос(ДанныеЗапроса)

	Если СостояниеЗащиты.Строгий Или СостояниеЗащиты.Переключение Тогда

		Возврат ОбработатьRESTЗапросСтрогий(ДанныеЗапроса);

	КонецЕсли;

	// path → tool: /api/execute_query → execute_query
	ИмяИнструмента = Сред(ДанныеЗапроса.path, 6); // убираем "/api/"

	КодОшибкиВхода = ПроверитьВызовНестрогогоРежима(ИмяИнструмента);

	Если НЕ ПустаяСтрока(КодОшибкиВхода) Тогда

		Возврат ОтветОшибкиВходаНестрогогоРежимаREST(КодОшибкиВхода);

	КонецЕсли;

	// Формируем Команда
	Команда = Новый Структура;
	Команда.Вставить("id", ДанныеЗапроса.id);
	Команда.Вставить("tool", ИмяИнструмента);

	// REST: restart/close -- перехват ДО парсинга body (endpoint без параметров, пустой/любой POST валиден)
	Если ИмяИнструмента = "restart_1c_session" Тогда
		Если ДанныеЗапроса.method <> "POST" Тогда
			Возврат СформироватьRESTОшибка(405, "Method not allowed: restart_1c_session requires POST");
		КонецЕсли;
		// Двойной guard: ПерезапускВОжидании -- during active restart;
		// ЗавершениеПослеПерезапускаЗапущено -- during shutdown (after ПерезапускВОжидании reset)
		Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
			Возврат СформироватьRESTОшибка(500, "Restart or close already in progress");
		КонецЕсли;
		ВыполнитьПерезапускСессии("", ДанныеЗапроса, ДанныеЗапроса.id, "", Истина);
		Возврат Неопределено;
	КонецЕсли;
	Если ИмяИнструмента = "close_1c_session" Тогда
		Если ДанныеЗапроса.method <> "POST" Тогда
			Возврат СформироватьRESTОшибка(405, "Method not allowed: close_1c_session requires POST");
		КонецЕсли;
		Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
			Возврат СформироватьRESTОшибка(500, "Restart or close already in progress");
		КонецЕсли;
		ВыполнитьЗакрытиеСессии("", ДанныеЗапроса, ДанныеЗапроса.id, "", Истина);
		Возврат Неопределено;
	КонецЕсли;

	// POST-only для submit_for_deanonymization
	Если ИмяИнструмента = "submit_for_deanonymization" И ДанныеЗапроса.method <> "POST" Тогда
		Возврат СформироватьRESTОшибка(405, "Method not allowed: submit_for_deanonymization requires POST");
	КонецЕсли;

	// Параметры: GET из query, POST из body
	RESTОшибка = ПрочитатьПараметрыREST(ДанныеЗапроса, Команда);
	Если RESTОшибка <> Неопределено Тогда
		Возврат RESTОшибка;
	КонецЕсли;

	КодОшибкиВхода = ПроверитьВызовНестрогогоРежима(ИмяИнструмента, Команда.params);

	Если НЕ ПустаяСтрока(КодОшибкиВхода) Тогда

		Возврат ОтветОшибкиВходаНестрогогоРежимаREST(КодОшибкиВхода);

	КонецЕсли;

	ДобавитьВЛог("Получена команда: " + ИмяИнструмента + Символы.ПС + ПолучитьТекстКоманды(Команда));

	// Деанонимизация входных параметров (встроенный сервер, точная анонимизация)
	Если ИспользоватьТочнуюАнонимизацию Тогда
		ДеАнонимизироватьПараметрыКомандыИВытеснить(Команда);
	КонецЕсли;

	// Валидация аргументов (строгие типы/дефолты): только для встроенного HTTP-сервера (REST).
	ПараметрыRESTЗапроса = Неопределено;
	Команда.Свойство("params", ПараметрыRESTЗапроса);

	Если ТипЗнч(ПараметрыRESTЗапроса) = Тип("Структура") Тогда
		ДетальОшибки = ПроверитьИНормализоватьАргументыИнструмента(ИмяИнструмента, ПараметрыRESTЗапроса);
		Если ДетальОшибки <> Неопределено Тогда
			СообщениеОшибки = "Ошибка валидации параметров: " + ДетальОшибки
				+ " / Parameter validation failed: " + ДетальОшибки;
			Возврат Новый Структура("КодОтвета, Тело", 422,
				ЗаписатьJSON2(Новый Структура("success, error", Ложь, СообщениеОшибки))
			);
		КонецЕсли;

		// Повторная проверка: params из JSON-строки разбираются уже после деанонимизации
		КодОшибкиВхода = ПроверитьВызовНестрогогоРежима(ИмяИнструмента, ПараметрыRESTЗапроса);

		Если НЕ ПустаяСтрока(КодОшибкиВхода) Тогда

			Возврат ОтветОшибкиВходаНестрогогоРежимаREST(КодОшибкиВхода);

		КонецЕсли;
	Иначе
		// Если параметры не объект, то не пытаемся "валидировать лимиты" по типам,
		// иначе будет неинформативная ошибка на неверный JSON. Лимит-поля всё равно не извлечь.
	КонецЕсли;

	// Проверка опасных операций для execute_code (REST)
	Если ИмяИнструмента = "execute_code" Тогда
		Код = "";
		Если ТипЗнч(Команда.params) = Тип("Структура") Тогда
			Команда.params.Свойство("code", Код);
		КонецЕсли;
		МассивОпасныхСлов = ПроверитьОпасныеСлова(Код);
		Если МассивОпасныхСлов.Количество() > 0 Тогда
			Если ВсеОперацииАвтоРазрешены(МассивОпасныхСлов) Тогда
				ДобавитьВЛог("REST: операции автоматически разрешены: " + СоединитьМассив(МассивОпасныхСлов, ", "));
			ИначеЕсли РазрешатьОпасныеОперацииСПодтверждением Тогда
				ОпасныеСлова = СоединитьМассив(МассивОпасныхСлов, ", ");
				ОжидающиеПодтверждения.Вставить(ДанныеЗапроса.id,
					Новый Структура(
						"Режим, ДанныеЗапроса, Команда, ОпасныеКлючевыеСлова, ОпасныеКлючевыеСловаТекст",
						"rest", ДанныеЗапроса, Команда, МассивОпасныхСлов, ОпасныеСлова));
				ОткрытьФорму(
					"ВнешняяОбработка.MCPToolkit.Форма.ФормаПодтверждения",
					Новый Структура("ОпасныеСлова, Код", ОпасныеСлова, Код),
					ЭтаФорма, , , ,
					Новый ОписаниеОповещения("ОбработатьРезультатПодтвержденияВстроенный",
						ЭтаФорма, Новый Структура("RequestId", ДанныеЗапроса.id)),
					РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
				Возврат Неопределено;
			Иначе
				КлючевыеСловаТекст = СоединитьМассив(МассивОпасныхСлов, ", ");
				Возврат СформироватьRESTОшибка(403,
					"Операция запрещена: код содержит опасные ключевые слова: " + КлючевыеСловаТекст
					+ " / Operation not allowed: code contains dangerous keywords: " + КлючевыеСловаТекст);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат ВыполнитьВызовREST(Команда, ИмяИнструмента, ДанныеЗапроса);

КонецФункции

// Читает параметры REST-запроса в Команда.params: GET из query, POST из body.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса (method, query, body)
//  Команда - Структура - команда выполнения; в нее записывается params
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено, если параметры прочитаны
//
&НаКлиенте
Функция ПрочитатьПараметрыREST(ДанныеЗапроса, Команда)

	Если ДанныеЗапроса.method = "GET" Тогда

		Возврат ПрочитатьПараметрыRESTGET(ДанныеЗапроса, Команда);

	КонецЕсли;

	Возврат ПрочитатьПараметрыRESTPOST(ДанныеЗапроса, Команда);

КонецФункции

// Читает параметры GET-запроса из query и проверяет числовые поля.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  Команда - Структура - команда выполнения; в нее записывается params
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено при успехе
//
&НаКлиенте
Функция ПрочитатьПараметрыRESTGET(ДанныеЗапроса, Команда)

	RESTПараметры = ПрочитатьQueryREST(ДанныеЗапроса);
	RESTОшибка = ПроверитьЧисловыеПараметрыRESTGET(RESTПараметры);

	Если RESTОшибка <> Неопределено Тогда

		Возврат RESTОшибка;

	КонецЕсли;

	Команда.Вставить("params", RESTПараметры);

	Возврат Неопределено;

КонецФункции

// Копирует ключи query в структуру параметров; списочные поля нормализуются.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//
// Возвращаемое значение:
//  Структура - параметры запроса
//
&НаКлиенте
Функция ПрочитатьQueryREST(ДанныеЗапроса)

	RESTПараметры = Новый Структура;
	Попытка
		Для Каждого КлючЗначение Из ДанныеЗапроса.query Цикл
			ИмяПоля = КлючЗначение.Ключ;
			Значения = КлючЗначение.Значение;
			
			// channel — транспортный параметр прокси-режима (маршрутизация на разные БД).
			// Во встроенном сервере не используется и не должен попадать в params инструмента.
			Если ИмяПоля = "channel" Тогда
				Продолжить;
			КонецЕсли;
			
			// Списки: поддерживаем CSV и повторяющиеся параметры как в прокси.
			Если ИмяПоля = "meta_type"
				Или ИмяПоля = "sections"
				Или ИмяПоля = "levels"
				Или ИмяПоля = "events"
				Или ИмяПоля = "rights_filter"
				Или ИмяПоля = "roles_filter"
				Или ИмяПоля = "names"
			Тогда
				СписокЗначений = НормализоватьRESTQueryСписок(Значения);
				Если СписокЗначений <> Неопределено Тогда
					Если СписокЗначений.Количество() = 1 Тогда
						RESTПараметры.Вставить(ИмяПоля, СписокЗначений[0]);
					Иначе
						RESTПараметры.Вставить(ИмяПоля, СписокЗначений);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ТипЗнч(Значения) = Тип("Массив") И Значения.Количество() = 1 Тогда
				RESTПараметры.Вставить(ИмяПоля, Значения[0]);
			Иначе
				RESTПараметры.Вставить(ИмяПоля, Значения);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// query может быть пустым
	КонецПопытки;

	Возврат RESTПараметры;

КонецФункции

// Разбирает целочисленные поля query; повторные types_limit/types_offset с разными значениями отклоняются.
//
// Параметры:
//  RESTПараметры - Структура - параметры запроса; числовые поля заменяются числами
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено при успехе
//
&НаКлиенте
Функция ПроверитьЧисловыеПараметрыRESTGET(RESTПараметры)

	// Числовые параметры из query: если не парсятся, отдаём ошибку как в прокси (422 + details).
	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "limit");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "offset");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "same_second_offset");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "limit_hits");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "limit_per_meta");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "timeout_budget_sec");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;

	RESTОшибка = ПроверитьНеоднозначностьТиповRESTGET(RESTПараметры);
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;

	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "types_limit");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
	RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "types_offset");
	Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Отклоняет повторные types_limit/types_offset с разными значениями (ошибка неоднозначности).
//
// Параметры:
//  RESTПараметры - Структура - параметры запроса
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено, если неоднозначности нет
//
&НаКлиенте
Функция ПроверитьНеоднозначностьТиповRESTGET(RESTПараметры)

	// Повторные types_limit/types_offset с разными значениями неоднозначны:
	// отклоняем до выбора «первого» значения (контракт: ошибка неоднозначности).
	ИменаПолейТипов = Новый Массив;
	ИменаПолейТипов.Добавить("types_limit");
	ИменаПолейТипов.Добавить("types_offset");
	Для Каждого ИмяТипПоля Из ИменаПолейТипов Цикл
		Если RESTПараметры.Свойство(ИмяТипПоля)
			И (ТипЗнч(RESTПараметры[ИмяТипПоля]) = Тип("Массив")
				Или ТипЗнч(RESTПараметры[ИмяТипПоля]) = Тип("ФиксированныйМассив"))
			И RESTПараметры[ИмяТипПоля].Количество() > 1 Тогда
			ПервоеЗначениеПоля = RESTПараметры[ИмяТипПоля][0];
			Неоднозначно = Ложь;
			Для ИндексЗначенияПоля = 1 По RESTПараметры[ИмяТипПоля].Количество() - 1 Цикл
				Если Строка(RESTПараметры[ИмяТипПоля][ИндексЗначенияПоля]) <> Строка(ПервоеЗначениеПоля) Тогда
					Неоднозначно = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Неоднозначно Тогда
				Возврат СформироватьRESTОшибка(422,
					"Ошибка валидации: параметр " + ИмяТипПоля + " передан несколько раз с разными значениями / "
					+ "Validation error: parameter '" + ИмяТипПоля + "' is ambiguous (repeated with different values)");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Читает параметры POST-запроса из JSON-тела.
//
// Параметры:
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//  Команда - Структура - команда выполнения; в нее записывается params
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ-ошибка (КодОтвета, Тело) или Неопределено при успехе
//
&НаКлиенте
Функция ПрочитатьПараметрыRESTPOST(ДанныеЗапроса, Команда)

	Попытка
		ТелоREST = ПрочитатьJSON2(ДанныеЗапроса.body);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат СформироватьRESTОшибка(400,
			"Ошибка разбора JSON: " + ТекстОшибки + " / JSON parse error: " + ТекстОшибки);
	КонецПопытки;
	
	Если ТипЗнч(ТелоREST) <> Тип("Структура") Тогда
		Возврат СформироватьRESTОшибка(400,
			"Тело запроса должно быть JSON объектом / Request body must be a JSON object");
	КонецЕсли;
	
	// channel — транспортный параметр прокси-режима (маршрутизация на разные БД).
	// Во встроенном сервере не используется и не должен попадать в params инструмента.
	УдалитьПолеЕслиЕсть(ТелоREST, "channel");
	
	Команда.Вставить("params", ТелоREST);

	Возврат Неопределено;

КонецФункции

// Выполнение инструмента REST: фоновое задание или синхронный вызов, затем хвост ответа.
//
// Параметры:
//  Команда - Структура - команда выполнения (id, tool, params)
//  ИмяИнструмента - Строка - имя инструмента
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//
// Возвращаемое значение:
//  Структура, Неопределено - ответ (КодОтвета, Тело) или Неопределено, если ответ уйдет асинхронно
//
&НаКлиенте
Функция ВыполнитьВызовREST(Команда, ИмяИнструмента, ДанныеЗапроса)

	Если ВыполнятьВФоне(ИмяИнструмента, Команда) Тогда
		Если ЗапуститьВФонеИЗарегистрировать(Команда, ИмяИнструмента, Неопределено,
				ДанныеЗапроса, "rest", "", "") Тогда
			Возврат Неопределено; // ответ уйдет из обработчика доставки
		КонецЕсли;
	КонецЕсли;

	КонтекстОтвета = НовыйКонтекстВыполненияКоманды("rest");
	КонтекстОтвета.ДанныеЗапроса = ДанныеЗапроса;
	Попытка
		Результат = ВыполнитьКомандуСУчетомКонтекста(Команда, КонтекстОтвета);
	Исключение
		СверитьСостояниеПодтвержденногоВызова(ДанныеЗапроса);

		Если СостояниеЗащиты.Строгий Тогда

			Возврат ОтветОшибкиСтрогогоREST(ОшибкаСтрогогоРежима("E_EXECUTION"));

		КонецЕсли;

		ТекстОшибки = ОписаниеОшибки();
		Возврат СформироватьRESTОшибка(500,
			"Необработанное исключение сервера: " + ТекстОшибки
			+ " / Unhandled server exception: " + ТекстОшибки);
	КонецПопытки;
	Если КонтекстОтвета.Отложено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗавершитьRESTЗапрос(Результат, ИмяИнструмента, Команда, ДанныеЗапроса);

КонецФункции

// Хвост обработки REST-запроса: анонимизация, lineage, TOON и формирование ответа.
// Вынесен отдельно, потому что при включенном параллельном режиме результат
// приходит из фонового задания и тот же хвост нужно выполнить позже (задача 000001, шаг 3).
&НаКлиенте
Функция ЗавершитьRESTЗапрос(Результат, ИмяИнструмента, Команда, ДанныеЗапроса)

	СверитьСостояниеПодтвержденногоВызова(ДанныеЗапроса);
	Результат = ЗакрытьОшибкуРезультатаСтрогогоРежима(Результат, ИмяИнструмента);
	ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Команда);
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапросаLineage, Результат) Тогда
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат, ТекстЗапроса",
			"rest", ДанныеЗапроса, Результат, ТекстЗапросаLineage);
		НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоОбъект",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
			"rest", ДанныеЗапроса, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоFindReferences",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
			"rest", ДанныеЗапроса, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_event_log" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоGetEventLog",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
			"rest", ДанныеЗапроса, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_access_rights" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		АнонимизироватьРезультатGetAccessRights(Результат);
		ОбновитьТаблицуМаппинговВстроенный();
		Если ПроверитьПодтверждениеАнонимизации(Результат, ДанныеЗапроса, "", "", "rest") Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "execute_code" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		УжеАнонимизирован = Ложь;
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			ВремАнон = Неопределено;
			УжеАнонимизирован = Результат.Свойство("_original_data_json", ВремАнон) И ЗначениеЗаполнено(ВремАнон);
		КонецЕсли;
		Если НЕ УжеАнонимизирован Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			РегексКонтекст = Новый Структура(
				"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
			КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
				"rest", ДанныеЗапроса, Результат);
			РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
			ЗапуститьRegexФазу(РегексКонтекст);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Возврат СформироватьRESTРезультат(Результат, ДанныеЗапроса);

КонецФункции

// REST-ответ 200 с результатом инструмента: JSON, а при формате TOON - конвертация данных. С асинхронным
// подключением компонент конвертация идет асинхронно, и ответ отправляет ПослеJsonToToonREST.
//
// Параметры:
//  Результат - Произвольный - результат инструмента, готовый к отправке
//  ДанныеЗапроса - Структура - данные HTTP-запроса
//
// Возвращаемое значение:
//  Структура, Неопределено - КодОтвета и Тело или Неопределено, если ответ отправит асинхронная конвертация
//
&НаКлиенте
Функция СформироватьRESTРезультат(Результат, ДанныеЗапроса)

	// Async-ветка для JsonToToon:
	Если ИспользоватьАсинхронноеПодключениеКомпонент И КомпонентаТун <> Неопределено
		И ФорматОтветаВстроенный = 1 И ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("success") И Результат.success И Результат.Свойство("data") Тогда

		КомпонентаТун.НачатьВызовJsonToToon(
			Новый ОписаниеОповещения("ПослеJsonToToonREST", ЭтаФорма,
				Новый Структура("ДанныеЗапроса, Результат", ДанныеЗапроса, Результат)),
			ЗаписатьJSON2(Результат.data));

		Возврат Неопределено;

	КонецЕсли;

	// sync path: оригинальный вызов ПрименитьТунКонвертацию и Возврат
	Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(Результат);
	ПрименитьТунКонвертацию(Результат);

	Возврат Новый Структура("КодОтвета, Тело", 200, ЗаписатьJSON2(Результат));

КонецФункции

// ============================================================================
// Параллельное выполнение (задача 000001, шаг 3).
// Серверные инструменты уходят в фоновое задание БСП, результат доставляется
// обработчиком ожидания и проходит тот же хвост, что и синхронный путь.
// ============================================================================

// Белый список инструментов, которые разрешено выполнять в фоновом задании.
// Только белый: черный список при появлении нового инструмента отдал бы молча
// неверный ответ вместо ошибки (get_bsl_syntax_help в фоне возвращает 0 тем).
&НаКлиенте
Функция ИнструментДопустимВФоне(ИмяИнструмента, Команда)

	Если ИмяИнструмента = "execute_code" Тогда
		// execution_context = "client" по определению требует клиентского контекста
		КонтекстВыполнения = "server";
		Если Команда.Свойство("params") И Команда.params <> Неопределено
			И Команда.params.Свойство("execution_context") Тогда
			КонтекстВыполнения = Команда.params.execution_context;
		КонецЕсли;
		Возврат КонтекстВыполнения <> "client";
	КонецЕсли;

	Возврат ИмяИнструмента = "execute_query"
		Или ИмяИнструмента = "get_metadata"
		Или ИмяИнструмента = "get_event_log"
		Или ИмяИнструмента = "find_references_to_object"
		Или ИмяИнструмента = "get_access_rights"
		Или ИмяИнструмента = "get_object_by_link"
		Или ИмяИнструмента = "get_link_of_object";

КонецФункции

&НаКлиенте
Функция ВыполнятьВФоне(ИмяИнструмента, Команда)

	Если НЕ ПараллельноеВыполнение Тогда
		Возврат Ложь;
	КонецЕсли;
	// Во время автовосстановления сеанса команду отклоняет синхронный путь с контролем.
	Если АвтоматическийПерезапуск = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РежимПодключения = 0 Тогда // только встроенный сервер
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ИнструментДопустимВФоне(ИмяИнструмента, Команда) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(АдресБинарникаОбработки) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Механизм определяется один раз за сеанс: иначе каждый запрос платил бы лишний
	// серверный вызов и строку в логе, прежде чем откатиться в синхронный путь.
	// Обычно он уже выбран — при включении флажка или при запуске сервера.
	Если БСПДоступна = Неопределено Тогда
		Проверка = ПроверитьВозможностьПараллельногоВыполнения();
		БСПДоступна = Проверка.Доступно;
		МеханизмФоновогоЗапуска = Проверка.Механизм;
		Если НЕ БСПДоступна Тогда
			ДобавитьВЛог("Параллельное выполнение недоступно (" + Проверка.Причина + "):"
				+ " запросы выполняются как раньше.");
		КонецЕсли;
	КонецЕсли;
	Если НЕ БСПДоступна Или НЕ ЗначениеЗаполнено(МеханизмФоновогоЗапуска) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции


// Версия БСП строго ниже 2.2 (например, "2.1.9.2"). До 2.2 нет ДлительныеОперации.
// ВыполнитьПроцедуруМодуляОбъектаОбработки вообще — а ее наличие нельзя проверить, не вызвав,
// поскольку это Процедура, а не Функция со свойством, и вызов уже запускает фоновое задание.
// Поэтому именно здесь, в порядке исключения из общего правила "проверяется возможность,
// а не версия", решение принимается по номеру версии.
// Неизвестная или нечисловая версия не отклоняется: пусть решает пробный запуск.
&НаСервереБезКонтекста
Функция ВерсияБСПНиже22(ВерсияБСП)

	Если НЕ ЗначениеЗаполнено(ВерсияБСП) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Части = РазделитьСтрокуПоРазделителю(ВерсияБСП, ".");
		Мажор = Число(Части[0]);
		Минор = Число(Части[1]);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Мажор < 2 ИЛИ (Мажор = 2 И Минор < 2);

КонецФункции

// Почему параллельное выполнение возможно или невозможно именно в этой базе.
// Возвращает структуру: Доступно, Причина (короткий код для журнала),
// Текст (объяснение пользователю: что не так и что делать), Предупреждение
// (режим работает, но выигрыша не будет), ВерсияБСП, Механизм и Кандидаты.
//
// Проверяется не версия БСП, а наличие конкретной возможности: один и тот же номер
// версии встречается и в полной, и в урезанной, и в допиленной библиотеке. Кандидаты
// возвращаются списком в порядке предпочтения — какой из них реально работает,
// решает пробный запуск, а не эта функция. Исключение — БСП ниже 2.2: там нет ни одного
// метода, который можно было бы вызвать без побочных эффектов, чтобы проверить его наличие,
// поэтому для этого одного порога решение принимается по номеру версии (см. ВерсияБСПНиже22).
// Пробует кандидатов 1 и 2 по наличию метода, а если ни один не нашелся — для БСП 2.1
// ищет зарегистрированную обработку, либо добавляет кандидата 3. Возвращает Истина, если Результат уже
// содержит окончательный отказ (Причина/Текст заполнены и вызывающему нужно сразу его вернуть).
&НаСервереБезКонтекста
Функция НайтиКандидатыИлиПричинуОтказа(Результат, МодульДлительныеОперации, ВерсияВСкобках)

	Если Найти(Результат.ВерсияБСП, "2.0.") = 1 Тогда
		Результат.Причина = "БСП20ПривилегированныйВызов";
		Результат.Текст = "Параллельное выполнение на БСП 2.0 отключено: ее диспетчер вызывает обработку"
			+ " в привилегированном режиме. Используйте последовательное выполнение.";
		Возврат Истина;
	КонецЕсли;
	Если Найти(Результат.ВерсияБСП, "2.1.") = 1 Тогда
		Найденная = НайтиЗарегистрированнуюОбработку(Результат.ВерсияБСП);
		Если ЗначениеЗаполнено(Найденная.Ссылка) Тогда
			Результат.Кандидаты.Добавить("ДопОбработкаБСП21");
			Возврат Ложь;
		КонецЕсли;
		Результат.Причина = Найденная.Причина;
		Результат.Текст = ТекстНедоступностиДопОбработки(Найденная.Причина, ВерсияВСкобках);
		Возврат Истина;
	КонецЕсли;

	// Механизм выбирается по НАЛИЧИЮ возможности, а не по номеру версии БСП: библиотека
	// бывает внедрена частично и допилена, а нужные методы появлялись в разных релизах.
	// Порядок добавления кандидатов = порядок предпочтения.
	//
	// 1) ВнешнийОтчетОбработка — свойство ПараметрыВыполненияФункции (БСП примерно с 3.1.10,
	//    проверено живьем на 3.1.12.335; 3.2.1.541 не тестировалась вживую, но ее ДлительныеОперации
	//    байт-в-байт совпадает с 3.1.12.335 по исходникам).
	//    В фон уходят ДВОИЧНЫЕ ДАННЫЕ обработки, поэтому путь переживает кластер из нескольких
	//    рабочих серверов.
	Попытка
		ПараметрыФункции = МодульДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
		ПараметрыФункции.ВнешнийОтчетОбработка = Неопределено;
		Результат.Кандидаты.Добавить("ВнешнийОтчетОбработка");
	Исключение
		// Нет метода или нет свойства — на этой БСП путь недоступен, пробуем следующий
	КонецПопытки;

	// 2) ВыполнитьПроцедуруМодуляОбъектаОбработки — служебная процедура ДлительныеОперации,
	//    присутствует во всей линейке начиная с 2.2 (проверено живьем на 3.0.3.341 и 3.1.5.473,
	//    в исходниках — на 2.3.7.10, 2.4.6.241, 3.0.3.341, 3.1.10, 3.1.12.335). На БСП 2.2.x этот
	//    кандидат не находится — там еще нет ПараметрыВыполненияВФоне, см. кандидата 3 ниже.
	//    Она сама создает обработку из ФАЙЛА на сервере и вызывает метод модуля объекта.
	//    Ограничение: в фон уходит путь, а не двоичные данные — в кластере задание может уйти
	//    на рабочий сервер, где файла еще нет. Поэтому кандидат второй, а не первый.
	//    На БСП 2.2-2.3 она читает Параметры.ДополнительнаяОбработкаСсылка без Свойство() — ключ
	//    обязателен, см. ПараметрыВызоваМодуляОбъекта ниже.
	Попытка
		МодульДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		Результат.Кандидаты.Добавить("МодульОбъектаОбработки");
	Исключение
		// Совсем старая (БСП 2.2.x) или урезанная БСП — пробуем следующий кандидат
	КонецПопытки;

	Если Результат.Кандидаты.Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// БСП ниже 2.2 не поддерживается: платформа стартует фоновое задание только с метода
	// общего модуля конфигурации, а передать ему внешнюю обработку без записи ее в справочник
	// ДополнительныеОтчетыИОбработки (то есть без записи данных в базу пользователя) там нечем —
	// ни ВыполнитьПроцедуруМодуляОбъектаОбработки, ни ВнешнийОтчетОбработка в этих версиях нет.
	Если ВерсияБСПНиже22(Результат.ВерсияБСП) Тогда
		Результат.Причина = "БСПНиже22";
		Результат.Текст = "Параллельное выполнение на этой версии БСП ниже 2.2 недоступно."
			+ " Используйте последовательное выполнение.";
		Возврат Истина;
	КонецЕсли;

	// 3) ФоновоеЗаданиеПлатформы — на БСП 2.2.x уже есть ВыполнитьПроцедуруМодуляОбъектаОбработки,
	//    но еще нет ВыполнитьВФоне/ПараметрыВыполненияВФоне (кандидат 2 их не находит), а легаси
	//    ДлительныеОперации.ЗапуститьВыполнениеВФоне для фона непригодна: в файловой базе с занятой
	//    очередью или в отладке она выполняет вызов синхронно в текущем сеансе, а иначе сама блокирует
	//    клиента на 2-4 с в Задание.ОжидатьЗавершения — оба случая убивают параллельность. Поэтому
	//    здесь вызывается платформенный ФоновыеЗадания.Выполнить напрямую, без участия БСП: ДлительныеОперации
	//    в 2.2.x — обычный неглобальный общий модуль (Server=true, Global=false), платформа принимает
	//    ее имя как "ИмяМодуля.ИмяМетода". Наличие метода нельзя проверить без вызова — как и для
	//    легаси-диспетчера, кандидат добавляется по версии, а реальную работоспособность подтверждает
	//    пробный запуск ниже, как и для первых двух.
	Результат.Кандидаты.Добавить("ФоновоеЗаданиеПлатформы");
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиЗарегистрированнуюОбработку(ВерсияБСП)

	Результат = Новый Структура("Ссылка, Причина", Неопределено, "ДопОбработкаНеЗарегистрирована");
	Попытка
		Если Найти(ВерсияБСП, "2.1.") = 1
			И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеОтчетыИОбработки") Тогда
			Результат.Причина = "ДопОбработкаОтключенаФО";
			Возврат Результат;
		КонецЕсли;
	Исключение
		// В доработанной конфигурации функциональная опция может отсутствовать.
	КонецПопытки;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 2
			| ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка,
			| ДополнительныеОтчетыИОбработки.Публикация КАК Публикация,
			| ДополнительныеОтчетыИОбработки.БезопасныйРежим КАК БезопасныйРежим
			|ИЗ Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
			|ГДЕ ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
			| И ДополнительныеОтчетыИОбработки.Вид =
			| ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка)
			| И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО ДополнительныеОтчетыИОбработки.Ссылка";
		Запрос.УстановитьПараметр("ИмяОбъекта", "MCPToolkit");
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда Возврат Результат; КонецЕсли;
		Ссылка = Выборка.Ссылка;
		Публикация = Выборка.Публикация;
		БезопасныйРежим = Выборка.БезопасныйРежим;
		Если Выборка.Следующий() Тогда
			Результат.Причина = "ДопОбработкаДубликаты";
			Возврат Результат;
		КонецЕсли;
		Если НЕ (Публикация =
			Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется Или Публикация =
			Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.РежимОтладки) Тогда
			Результат.Причина = "ДопОбработкаНеОпубликована";
		ИначеЕсли БезопасныйРежим Тогда
			Результат.Причина = "ДопОбработкаБезопасныйРежим";
		Иначе
			Результат.Ссылка = Ссылка;
		КонецЕсли;
	Исключение
		Результат.Причина = "ДопОбработкаНетДоступа";
	КонецПопытки;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстНедоступностиДопОбработки(Причина, ВерсияВСкобках)

	Если Причина = "ДопОбработкаБезопасныйРежим" Тогда
		Пояснение = "обработка зарегистрирована в безопасном режиме, где execute_code лишен файлов и привилегий";
		Действие = "перерегистрировать обработку пользователем с полными правами";
	ИначеЕсли Причина = "ДопОбработкаНеОпубликована" Тогда
		Пояснение = "карточка MCP Toolkit отключена или помечена на удаление";
		Действие = "включить публикацию карточки и снять пометку удаления";
	ИначеЕсли Причина = "ДопОбработкаОтключенаФО" Тогда
		Пояснение = "в базе выключено использование дополнительных отчетов и обработок";
		Действие = "включить подсистему в общих настройках базы";
	ИначеЕсли Причина = "ДопОбработкаНетДоступа" Тогда
		Пояснение = "нет доступа к справочнику дополнительных отчетов и обработок";
		Действие = "предоставить право чтения справочника и его двоичного реквизита";
	ИначеЕсли Причина = "ДопОбработкаДубликаты" Тогда
		Пояснение = "найдено несколько карточек MCP Toolkit; невозможно безопасно выбрать одну из них";
		Действие = "попросить администратора убрать дублирующие карточки";
	Иначе
		Пояснение = "MCP Toolkit не зарегистрирован как дополнительная обработка";
		Действие = "попросить администратора зарегистрировать этот файл .epf в справочнике дополнительных обработок";
	КонецЕсли;
	Возврат "Параллельное выполнение пока недоступно. БСП" + ВерсияВСкобках + ": " + Пояснение
		+ ". Что делать: " + Действие + ". Со снятым флажком запросы выполняются по одному.";

КонецФункции

&НаСервереБезКонтекста
Функция ОбработкаЗарегистрированаАктуальная(Ссылка, АдресБинарника)

	Попытка
		Текущие = ПолучитьИзВременногоХранилища(АдресБинарника);
		Зарегистрированные = Ссылка.ХранилищеОбработки.Получить();
		Если ТипЗнч(Текущие) <> Тип("ДвоичныеДанные")
			Или ТипЗнч(Зарегистрированные) <> Тип("ДвоичныеДанные") Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Текущие.Размер() = Зарегистрированные.Размер()
			И Base64Строка(Текущие) = Base64Строка(Зарегистрированные);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Повторяет проверку СтандартныеПодсистемыПовтИсп.ЭтоПлатформа83БезРежимаСовместимости() из БСП:
// в файловой базе с режимом совместимости 8.1/8.2.13/8.2.16/8.3.1/8.3.2 (или на платформе не 8.3)
// платформа не запускает менеджер фоновых заданий.
&НаСервереБезКонтекста
Функция ЕстьМенеджерФоновыхЗаданий()

	Информация = Новый СистемнаяИнформация;
	Возврат Лев(Информация.ВерсияПриложения, 3) = "8.3"
		И (Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать
		Или (Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_1
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_13
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости["Версия8_2_16"]
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости["Версия8_3_1"]
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости["Версия8_3_2"]));

КонецФункции

// Файловая база в старых режимах совместимости не запускает менеджер фоновых заданий — флажок
// снимается принудительно (см. ЕстьМенеджерФоновыхЗаданий). В прочих файловых базах режим не
// запрещает, но и не ускоряет: фоновые задания там идут по очереди, пользователь предупрежден.
&НаСервереБезКонтекста
Процедура ПроверитьФайловуюБазу(Результат)

	Если Найти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") > 0 Тогда

		Если НЕ ЕстьМенеджерФоновыхЗаданий() Тогда

			Результат.Доступно = Ложь;
			Результат.Механизм = "";
			Результат.Причина = "ФайловаяБазаБезМенеджераЗаданий";
			Результат.Текст =
				"Параллельное выполнение в этой базе невозможно.
				|
				|Причина: база файловая, а режим совместимости конфигурации — "
					+ Строка(Метаданные.РежимСовместимости) + ".
				|В таком режиме платформа не запускает фоновые задания в файловой базе (менеджер заданий не активен).
				|
				|Что делать: ничего — флажок оставлен снятым, запросы выполняются по одному, как раньше.
				|Параллельность заработает в клиент-серверной базе.";
			Возврат;

		КонецЕсли;

		Результат.Причина = "ФайловаяБаза";
		Результат.Предупреждение =
			"Параллельное выполнение включено, но ускорения в этой базе не будет.
			|
			|Причина: база файловая, а в файловом режиме 1С выполняет фоновые задания по очереди, а не одновременно.
			|Ответы останутся корректными, но каждый запрос дополнительно потратит время на запуск фонового задания.
			|
			|Что делать: если параллельность нужна ради скорости — перевести базу в клиент-серверный режим.
			|Иначе флажок разумнее снять.";

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДиагностикаБСПНаСервере()

	Результат = Новый Структура("Доступно, Причина, Текст, Предупреждение, ВерсияБСП, Механизм, Кандидаты",
		Ложь, "", "", "", "", "", Новый Массив);

	Попытка
		Результат.ВерсияБСП = Вычислить("СтандартныеПодсистемыСервер.ВерсияБиблиотеки()");
	Исключение
		Результат.ВерсияБСП = "";
	КонецПопытки;

	ВерсияВСкобках = ?(ЗначениеЗаполнено(Результат.ВерсияБСП), " (" + Результат.ВерсияБСП + ")", "");

	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");
	Исключение
		Результат.Причина = "НетБСП";
		Результат.Текст = ТекстНетБСП();
		Возврат Результат;
	КонецПопытки;

	Если НайтиКандидатыИлиПричинуОтказа(Результат, МодульДлительныеОперации, ВерсияВСкобках) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Результат.Кандидаты.Количество() = 0 Тогда
		Результат.Причина = "НетМеханизма";
		Результат.Текст = ТекстНетМеханизма(ВерсияВСкобках);
		Возврат Результат;
	КонецЕсли;

	Результат.Механизм = Результат.Кандидаты[0];
	Результат.Доступно = Истина;

	ПроверитьФайловуюБазу(Результат);

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстНетБСП()

	Возврат
		"Параллельное выполнение в этой базе невозможно.
		|
		|Причина: в конфигурации нет библиотеки стандартных подсистем (БСП) — общий модуль ДлительныеОперации не найден.
		|Фоновое задание умеет стартовать только с метода общего модуля конфигурации, а внешнюю обработку
		|туда передает именно БСП — без нее запускать инструменты в фоне нечем.
		|
		|Что делать: внедрить БСП в конфигурацию либо оставить флажок снятым. Со снятым флажком инструмент
		|исправен — запросы просто выполняются по одному, как и до появления этого режима.";

КонецФункции

&НаСервереБезКонтекста
Функция ТекстНетМеханизма(ВерсияВСкобках)

	Возврат
		"Параллельное выполнение в этой базе невозможно.
		|
		|Причина: версия БСП" + ВерсияВСкобках + " не умеет запускать внешнюю обработку в фоновом задании:
		|нет ни свойства ВнешнийОтчетОбработка у ДлительныеОперации.ПараметрыВыполненияФункции,
		|ни рабочего ДлительныеОперации.ПараметрыВыполненияВФоне, ни ВыполнитьПроцедуруМодуляОбъектаОбработки.
		|
		|Что делать: обновить БСП в конфигурации либо оставить флажок снятым. Со снятым флажком
		|инструмент исправен: запросы выполняются по одному, как и до появления этого режима.";

КонецФункции

// Пробный запуск фонового задания тем же путем, каким пойдут боевые запросы.
// Ловит то, чего не видно статической проверкой: нет права на фоновые задания,
// запрещены регламентные задания в базе, обработка не развернулась на сервере,
// у механизма не оказалось нужного метода. ОжидатьЗавершение = 3: ожидание идет
// на сервере, клиент не крутит цикл опроса.
&НаСервереБезКонтекста
Функция ПробныйЗапускФоновогоЗаданияНаСервере(АдресБинарника, ИдентификаторФормы, Механизм)

	Результат = Новый Структура("Успех, Текст, ВОсновномПотоке", Ложь, "", Ложь);

	Команда = Новый Структура("tool, params", "execute_code", Новый Структура("code", "Результат = 1;"));

	Пуск = ЗапуститьЗаданиеВФоне(Команда, АдресБинарника, ИдентификаторФормы, Механизм,
		"MCP Toolkit: проверка параллельного выполнения", 3);

	Если Пуск.Ошибка Тогда
		Результат.Текст = Пуск.Текст;
		Возврат Результат;
	КонецЕсли;
	Если Механизм = "ДопОбработкаБСП21" И Пуск.Статус = "Выполняется" Тогда
		Попытка
			ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Пуск.ИдентификаторЗадания);
			ФоновоеЗадание.ОжидатьЗавершения(10);
		Исключение
			// Ошибка задания или таймаут; состояние проверяется ниже.
		КонецПопытки;
		Пуск.Статус = СостояниеЗаданияПлатформы(Пуск.ИдентификаторЗадания).Статус;
		Если Пуск.Статус = "Выполняется" Тогда
			Результат.Текст = "Пробное задание БСП 2.1 не завершилось за отведенное время";
			ОтменитьЗадание(Пуск.ИдентификаторЗадания, Пуск.АдресРезультата);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Опрос — тем же вызовом, что и для боевых заданий: иначе несовместимость опроса
	// с версией БСП проявилась бы только на первом настоящем запросе.
	Если НЕ Пуск.БезФоновогоЗадания Тогда

		Задания = Новый Массив;
		Задания.Добавить(Новый Структура("ИдЗапроса, ИдентификаторЗадания, Механизм",
			"probe", Пуск.ИдентификаторЗадания, Механизм));
		Для Каждого Готовое Из ОпроситьЗадания(Задания) Цикл

			Если Готовое.Ошибка Тогда
				Результат.Текст = Готовое.Текст;
				Возврат Результат;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	// Задание либо уже отработало, либо еще считается — оба исхода означают, что запуск
	// состоялся. Сам результат не нужен: если он готов, освобождаем временное хранилище.
	Если ЗначениеЗаполнено(Пуск.АдресРезультата) И Пуск.Статус = "Выполнено" Тогда
		Попытка
			УдалитьИзВременногоХранилища(Пуск.АдресРезультата);
		Исключение
			// Адрес мог быть уже освобожден — на проверку это не влияет
		КонецПопытки;
	КонецЕсли;

	Результат.ВОсновномПотоке = Пуск.БезФоновогоЗадания;
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Полная проверка перед включением флажка: статическая диагностика плюс — когда
// обработка уже развернута на сервере — реальный пробный запуск фонового задания.
&НаКлиенте
Функция ПроверитьВозможностьПараллельногоВыполнения()

	Проверка = ДиагностикаБСПНаСервере();

	Если НЕ Проверка.Доступно Тогда
		Возврат Проверка;
	КонецЕсли;

	// Прокси-режим: флажок действует только для встроенного сервера. Не запрещаем —
	// пользователь вправе выставить его заранее, до переключения режима.
	Если РежимПодключения = 0 И НЕ ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
		Проверка.Причина = "ПроксиРежим";
		Проверка.Предупреждение =
			"Параллельное выполнение включено, но сейчас оно ни на что не влияет.
			|
			|Причина: выбран режим подключения «Прокси», а параллельный режим действует только для встроенного сервера.
			|
			|Что делать: переключить режим подключения на «Встроенный сервер» — флажок останется включенным и заработает.";
		Возврат Проверка;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресБинарникаОбработки) Тогда
		Если НЕ ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
			Проверка.Причина = "ОбработкаНеРазвернута";
			Проверка.Предупреждение =
				"Проверка выполнена частично: подходящий механизм БСП найден, но пробный запуск делать не на чем.
				|
				|Причина: обработка еще не развернута на сервере — это происходит при запуске встроенного сервера.
				|
				|Что делать: запустить сервер. Если развернуть обработку не удастся, в журнале появится строка
				|«Не удалось развернуть обработку на сервере», и запросы будут выполняться по одному, как раньше.";
		КонецЕсли;
		Возврат Проверка;
	КонецЕсли;

	Если Проверка.Механизм = "ДопОбработкаБСП21" Тогда
		Найденная = НайтиЗарегистрированнуюОбработку(Проверка.ВерсияБСП);
		Если НЕ ЗначениеЗаполнено(Найденная.Ссылка)
			Или НЕ ОбработкаЗарегистрированаАктуальная(Найденная.Ссылка, АдресБинарникаОбработки) Тогда
			Проверка.Доступно = Ложь;
			Проверка.Механизм = "";
			Проверка.Причина = "ДопОбработкаУстарела";
			Проверка.Текст = "Зарегистрированная сборка MCP Toolkit отличается от открытой."
				+ " Попросите администратора загрузить текущий файл .epf в карточку дополнительной обработки.";
			Возврат Проверка;
		КонецЕсли;
	КонецЕсли;

	// Кандидаты пробуются по очереди: наличие метода еще не значит, что задание стартует
	// (нет прав на фоновые задания, запрещены регламентные, файла нет на этом сервере).
	// Рабочим считается первый, чей пробный запуск прошел; он и запоминается на сеанс.
	ТекстПоследнейОшибки = "";
	Для Каждого Кандидат Из Проверка.Кандидаты Цикл

		Пробный = ПробныйЗапускФоновогоЗаданияНаСервере(АдресБинарникаОбработки,
			ЭтаФорма.УникальныйИдентификатор, Кандидат);

		Если НЕ Пробный.Успех Тогда
			ТекстПоследнейОшибки = Пробный.Текст;
			Продолжить;
		КонецЕсли;

		Проверка.Механизм = Кандидат;

		// Задание стартовало, но выполнилось в основном потоке: результаты будут
		// правильными, а ускорения не будет. Молчать нельзя — иначе включенный флажок
		// обещает то, чего нет.
		Если Пробный.ВОсновномПотоке И НЕ ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
			Проверка.Причина = "ВыполненоВОсновномПотоке";
			Проверка.Предупреждение =
				"Параллельное выполнение включено, но ускорения сейчас не будет.
				|
				|Причина: пробное задание выполнилось в основном потоке, а не в фоне. Так делает сама БСП,
				|когда платформа запущена в режиме отладки или когда в файловой базе уже занята очередь заданий.
				|
				|Что делать: для реальной параллельности запустить 1С без режима отладки и работать
				|в клиент-серверной базе. Ответы остаются корректными в любом случае.";
		КонецЕсли;

		Возврат Проверка;

	КонецЦикла;

	Проверка.Доступно = Ложь;
	Проверка.Механизм = "";
	Проверка.Причина  = "ПробныйЗапускНеУдался";
	Проверка.Текст =
		"Параллельное выполнение в этой базе невозможно.
		|
		|Причина: подходящий механизм БСП найден, но пробное фоновое задание не запустилось.
		|Ошибка: " + ТекстПоследнейОшибки + "
		|
		|Что делать: проверить, что у пользователя есть право на выполнение фоновых заданий, что в базе
		|не запрещены регламентные задания и что обработка развернулась на сервере (в журнале — строка
		|«Серверные команды идут через модуль объекта»).
		|До устранения причины флажок оставлен снятым: запросы выполняются по одному, как раньше.";

	Возврат Проверка;

КонецФункции

// Общий параметр вызова служебной процедуры ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки —
// нужен и механизму 2 (МодульОбъектаОбработки), и механизму 3 (ФоновоеЗаданиеПлатформы): она сама
// создает обработку из ФАЙЛА на сервере и вызывает метод модуля объекта, а не двоичные данные.
// Разворачиваем на том же сервере, откуда стартует задание.
&НаСервереБезКонтекста
Функция ПараметрыВызоваМодуляОбъекта(Команда, АдресБинарника)

	Путь = РазвернутьОбработкуНаСервере(АдресБинарника);
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		ВызватьИсключение "Не удалось развернуть обработку на сервере";
	КонецЕсли;

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыПроцедуры.Вставить("ИмяОбработки",        Путь);
	ПараметрыПроцедуры.Вставить("ИмяМетода",           "ВыполнитьКомандуВФонеМодульОбъекта");
	ПараметрыПроцедуры.Вставить("ПараметрыВыполнения", Команда);
	// Ложь по той же причине, что и в синхронном пути: в безопасном режиме execute_code
	// лишается привилегий, файлов и внешних компонент.
	ПараметрыПроцедуры.Вставить("БезопасныйРежим",     Ложь);
	// БСП 2.2 и 2.3 читают это поле напрямую, без Свойство(): без ключа падает "Поле объекта
	// не обнаружено (ДополнительнаяОбработкаСсылка)". Неопределено уводит их в ту же ветку
	// ВнешниеОбработки.Создать(ИмяОбработки), что и раньше — обработка все равно из файла.
	ПараметрыПроцедуры.Вставить("ДополнительнаяОбработкаСсылка", Неопределено);

	Возврат ПараметрыПроцедуры;

КонецФункции

// Механизм 3 (БСП 2.2.x): нет ВыполнитьВФоне/ПараметрыВыполненияВФоне, а единственный легаси-диспетчер
// БСП для этого случая — ДлительныеОперации.ЗапуститьВыполнениеВФоне — для фона непригоден: в файловой
// базе с занятой очередью или в режиме отладки он выполняет вызов синхронно в текущем сеансе, а иначе
// сам блокирует клиента на 2-4 с в Задание.ОжидатьЗавершения. Оба случая убивают параллельность.
// Поэтому вызываем платформу напрямую, без БСП: ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки
// — обычная экспортная процедура неглобального общего модуля начиная с БСП 2.2 (и на 2.2-2.3 она сама
// вызывает Обработка.<ИмяМетода>(ПараметрыВыполнения, АдресХранилища)), поэтому ФоновыеЗадания.Выполнить
// принимает ее имя как "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки" без участия
// модуля-обертки. Задание становится фоновым всегда: платформа никогда не выполняет его синхронно
// в вызывающем потоке, поэтому "БезФоновогоЗадания" ниже по коду для этой ветки всегда Ложь.
// Единственный оставшийся частный случай — файловая база, где задания просто встают в очередь
// друг за другом, и это уже покрыто общей оговоркой "ФайловаяБаза" в ДиагностикаБСПНаСервере.
// ОжидатьЗавершение (сек, 0 — не ждать) дает пробному запуску шанс увидеть настоящий результат
// вместо всегда-"Выполняется": Задание.ОжидатьЗавершения бросает исключение и на аварийном
// завершении задания, и по истечении таймаута (доступен с 8.1) — оба случая безопасно проглатываются
// здесь, а реальный статус (в т.ч. текст ошибки) берется у платформы через СостояниеЗаданияПлатформы,
// как и при обычном опросе. Если задание просто не успело завершиться за ОжидатьЗавершение секунд,
// статус останется "Выполняется" — так же, как для механизмов 1 и 2, чей аналог этого таймаута
// (ПараметрыВыполнения.ОжидатьЗавершение) тоже не гарантирует завершения, только не сообщает
// об этом как об ошибке (см. ОпроситьЗадания — "Выполняется" пропускается, а не считается отказом).
&НаСервереБезКонтекста
Функция ЗаданиеЧерезФоновоеЗаданиеПлатформы(ПараметрыПроцедуры, ИдентификаторФормы, Наименование, ОжидатьЗавершение)

	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);

	Параметры = Новый Массив;
	Параметры.Добавить(ПараметрыПроцедуры);
	Параметры.Добавить(АдресХранилища);

	Задание = ФоновыеЗадания.Выполнить("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		Параметры, , Наименование);

	Если ОжидатьЗавершение > 0 Тогда
		Попытка
			Задание.ОжидатьЗавершения(ОжидатьЗавершение);
		Исключение
			// Аварийное завершение или истечение таймаута — точный статус разберет
			// СостояниеЗаданияПлатформы ниже, по факту, а не по тексту этого исключения.
		КонецПопытки;
	КонецЕсли;

	Состояние = СостояниеЗаданияПлатформы(Задание.УникальныйИдентификатор);

	Возврат Новый Структура("Статус, ИдентификаторЗадания, АдресРезультата, КраткоеПредставлениеОшибки",
		Состояние.Статус, Задание.УникальныйИдентификатор, АдресХранилища, Состояние.КраткоеПредставлениеОшибки);

КонецФункции

&НаСервереБезКонтекста
Функция ЗаданиеЧерезДопОбработкуБСП21(Команда, ИдентификаторФормы, Наименование, ОжидатьЗавершение)

	Найденная = НайтиЗарегистрированнуюОбработку("2.1.");
	Если НЕ ЗначениеЗаполнено(Найденная.Ссылка) Тогда
		ВызватьИсключение ТекстНедоступностиДопОбработки(Найденная.Причина, " (2.1)");
	КонецЕсли;
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
	Пакет = Новый Структура("Команда, АдресРезультата", Команда, АдресРезультата);
	ПараметрыКоманды = Новый Структура("ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПакетMCP",
		Найденная.Ссылка, "ВыполнитьКомандуMCP", Пакет);
	Параметры = Новый Массив;
	Параметры.Добавить(ПараметрыКоманды);
	Параметры.Добавить(Неопределено);
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ДополнительныеОтчетыИОбработки.ВыполнитьКоманду",
			Параметры, , Наименование);
	Исключение
		УдалитьИзВременногоХранилища(АдресРезультата);
		ВызватьИсключение;
	КонецПопытки;
	Если ОжидатьЗавершение > 0 Тогда
		Попытка
			Задание.ОжидатьЗавершения(ОжидатьЗавершение);
		Исключение
			// Точное состояние задания проверяется ниже.
		КонецПопытки;
	КонецЕсли;
	Состояние = СостояниеЗаданияПлатформы(Задание.УникальныйИдентификатор);
	Возврат Новый Структура("Статус, ИдентификаторЗадания, АдресРезультата, КраткоеПредставлениеОшибки",
		Состояние.Статус, Задание.УникальныйИдентификатор, АдресРезультата, Состояние.КраткоеПредставлениеОшибки);

КонецФункции

// Единая точка старта фонового задания: все ветки механизма и общий разбор ответа БСП.
// Механизм выбирается заранее (см. ДиагностикаБСПНаСервере) и передается параметром —
// серверный вызов без контекста не видит состояние формы.
// &НаСервереБезКонтекста намеренно: контекстный вызов гонял бы через границу
// все реквизиты формы, включая ТаблицаМаппингов, на каждый параллельный запрос.
&НаСервереБезКонтекста
Функция ЗапуститьЗаданиеВФоне(Команда, АдресБинарника, ИдентификаторФормы, Механизм, Наименование, ОжидатьЗавершение)

	Результат = Новый Структура("Ошибка, Текст, ИдентификаторЗадания, АдресРезультата, БезФоновогоЗадания, Статус",
		Ложь, "", Неопределено, "", Ложь, "");

	Попытка
		Двоичные = ПолучитьИзВременногоХранилища(АдресБинарника);
	Исключение
		Двоичные = Неопределено;
	КонецПопытки;

	Если ТипЗнч(Двоичные) <> Тип("ДвоичныеДанные") Тогда
		Результат.Ошибка = Истина;
		Результат.Текст = "Бинарник обработки недоступен во временном хранилище";
		Возврат Результат;
	КонецЕсли;

	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");

		Если Механизм = "МодульОбъектаОбработки" Тогда

			// БСП без свойства ВнешнийОтчетОбработка принимает обработку только файлом.
			ПараметрыПроцедуры = ПараметрыВызоваМодуляОбъекта(Команда, АдресБинарника);

			ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
			ПараметрыВыполнения.ЗапуститьВФоне        = Истина;
			ПараметрыВыполнения.ОжидатьЗавершение     = ОжидатьЗавершение;
			ПараметрыВыполнения.НаименованиеФоновогоЗадания = Наименование;

			// Имя процедуры намеренно начинается с "ДлительныеОперации.", а не с "ВнешняяОбработка.":
			// на этих версиях БСП имена внешних обработок в фон не пускаются вовсе, и задание
			// молча выполнилось бы в основном потоке. Проверено на живой базе с БСП 3.1.5.317.
			Задание = МодульДлительныеОперации.ВыполнитьВФоне(
				"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
				ПараметрыПроцедуры, ПараметрыВыполнения);

		ИначеЕсли Механизм = "ФоновоеЗаданиеПлатформы" Тогда

			// БСП 2.2.x: та же служебная процедура ВыполнитьПроцедуруМодуляОбъектаОбработки, но
			// стартует напрямую платформой — см. комментарий у ЗаданиеЧерезФоновоеЗаданиеПлатформы.
			ПараметрыПроцедуры = ПараметрыВызоваМодуляОбъекта(Команда, АдресБинарника);
			Задание = ЗаданиеЧерезФоновоеЗаданиеПлатформы(ПараметрыПроцедуры, ИдентификаторФормы, Наименование,
				ОжидатьЗавершение);

		ИначеЕсли Механизм = "ДопОбработкаБСП21" Тогда

			Задание = ЗаданиеЧерезДопОбработкуБСП21(Команда, ИдентификаторФормы, Наименование, ОжидатьЗавершение);

		Иначе

			ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
			ПараметрыВыполнения.ВнешнийОтчетОбработка = Двоичные;
			ПараметрыВыполнения.ЗапуститьВФоне        = Истина;
			ПараметрыВыполнения.ОжидатьЗавершение     = ОжидатьЗавершение;
			ПараметрыВыполнения.НаименованиеФоновогоЗадания = Наименование;

			// Имя метода проверено на живой базе, не выведено из документации.
			// Принимается ТОЛЬКО четырехчастная форма: БСП разбирает "ВнешняяОбработка.Метод"
			// как «общий модуль + метод» и ищет общий модуль с таким именем, а трехчастную —
			// как менеджер объекта. MCPToolkit — имя обработки из MCPToolkit.xml.
			Задание = МодульДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
				"ВнешняяОбработка.MCPToolkit.МодульОбъекта.ВыполнитьКомандуНаСервере", Команда);

		КонецЕсли;
	Исключение
		Результат.Ошибка = Истина;
		Результат.Текст  = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Статус = "";
	Задание.Свойство("Статус", Статус);
	Результат.Статус = Статус;

	Идентификатор = Неопределено;
	Задание.Свойство("ИдентификаторЗадания", Идентификатор);
	Результат.ИдентификаторЗадания = Идентификатор;

	Адрес = "";
	Задание.Свойство("АдресРезультата", Адрес);
	Результат.АдресРезультата = Адрес;

	Если Статус = "Ошибка" Или Статус = "Отменено" Тогда
		Результат.Ошибка = Истина;
		Результат.Текст  = ТекстОшибкиЗадания(Задание);
		Возврат Результат;
	КонецЕсли;

	// Пустой идентификатор означает, что БСП выполнила вызов в ОСНОВНОМ потоке, а не в фоне:
	// платформа в режиме отладки и файловая база с занятой очередью заданий делают это молча.
	// Результат при этом корректен, но параллельности нет — вызывающий обязан это увидеть,
	// иначе флажок обещал бы несуществующее ускорение.
	Результат.БезФоновогоЗадания = НЕ ЗначениеЗаполнено(Идентификатор);

	Возврат Результат;

КонецФункции

// Фоновое задание не читает временное хранилище сеанса формы: чужой адрес молча дает Неопределено.
// Поэтому записи кэша расширения уходят в задание значением, а адреса остаются в параметрах:
// при попадании задание вернет тот же адрес, и клиент сохранит его. Индекс нужен только
// summary/list (без filter и attribute_mask), детали - только запросу с filter.
//
// Параметры:
//  ПараметрыКоманды - Структура - params команды get_metadata; дополняется строками значений кэша
//
&НаСервереБезКонтекста
Процедура ПередатьКэшРасширенияПоЗначению(ПараметрыКоманды)

	ПараметрыКоманды.Вставить("mcp_cache_by_value", Истина);
	ПередатьЗначениеКэша(ПараметрыКоманды, "mcp_cache_details_token", "mcp_cache_details_value");

	Фильтр = Неопределено;
	МаскаАтрибута = Неопределено;
	ПараметрыКоманды.Свойство("filter", Фильтр);
	ПараметрыКоманды.Свойство("attribute_mask", МаскаАтрибута);
	Если ПустаяСтрока(Строка(Фильтр)) И ПустаяСтрока(Строка(МаскаАтрибута)) Тогда

		ПередатьЗначениеКэша(ПараметрыКоманды, "mcp_cache_index_token", "mcp_cache_index_value");

	КонецЕсли;

КонецПроцедуры

// Читает значение кэша по адресу из параметров команды и кладет его строкой в те же параметры.
//
// Параметры:
//  ПараметрыКоманды - Структура - params команды get_metadata
//  ИмяТокена - Строка - имя параметра с адресом значения
//  ИмяЗначения - Строка - имя параметра, в который кладется значение строкой
//
&НаСервереБезКонтекста
Процедура ПередатьЗначениеКэша(ПараметрыКоманды, ИмяТокена, ИмяЗначения)

	Токен = Неопределено;
	Если НЕ ПараметрыКоманды.Свойство(ИмяТокена, Токен)
		Или ТипЗнч(Токен) <> Тип("Строка")
		Или НЕ ЭтоАдресВременногоХранилища(Токен) Тогда

		Возврат;

	КонецЕсли;

	Значение = ПолучитьИзВременногоХранилища(Токен);
	Если Значение <> Неопределено Тогда

		ПараметрыКоманды.Вставить(ИмяЗначения, ЗначениеВСтрокуВнутр(Значение));

	КонецЕсли;

КонецПроцедуры

// Запуск серверной команды в фоновом задании.
// Возвращает структуру с ИдентификаторЗадания и АдресРезультата,
// либо структуру с признаком Ошибка и текстом.
&НаСервереБезКонтекста
Функция ЗапуститьКомандуВФоне(Знач Команда, АдресБинарника, ИдентификаторФормы, Механизм)

	Если Команда.tool = "get_metadata" Тогда

		ПередатьКэшРасширенияПоЗначению(Команда.params);

	КонецЕсли;

	Возврат ЗапуститьЗаданиеВФоне(Команда, АдресБинарника, ИдентификаторФормы, Механизм,
		"MCP Toolkit: " + Команда.tool, 0);

КонецФункции

&НаКлиенте
Функция ЗапуститьВФонеИЗарегистрировать(Команда, ИмяИнструмента, Аргументы, ДанныеЗапроса, Режим, Ид, ИдПотокаSSE,
	КонтекстСтрогий = Неопределено)

	// В фон уходит РОВНО то, что ушло бы синхронно: ПодготовитьКомандуНаСервер добавляет
	// токены кэша расширений и принудительный include_schema, без которого точная
	// анонимизация execute_query остается без схемы и не срабатывает.
	Подготовка = ПодготовитьКомандуНаСервер(Команда);

	Пуск = ЗапуститьКомандуВФоне(Подготовка.КомандаНаСервер, АдресБинарникаОбработки,
		ЭтаФорма.УникальныйИдентификатор, МеханизмФоновогоЗапуска);
	Если Пуск.Ошибка Тогда
		ДобавитьВЛог("Не удалось запустить фоновое задание, выполняем синхронно: " + Пуск.Текст);
		Возврат Ложь;
	КонецЕсли;

	// Значения кэша расширения фонового пути лежат в хранилище формы до ее закрытия:
	// вытесненные из клиентского кэша адреса освобождает ОбновитьКэшТокеновРасширения.
	Подготовка.Вставить("ОсвобождатьКэшРасширения", Истина);

	Запись = Новый Структура;
	Запись.Вставить("ИдентификаторЗадания", Пуск.ИдентификаторЗадания);
	Запись.Вставить("АдресРезультата",      Пуск.АдресРезультата);
	// Замораживаем механизм на момент запуска: пользователь может снять флажок, пока задание
	// еще выполняется (МеханизмФоновогоЗапуска тогда обнулится), а опрос должен звать тот же
	// метод БСП, которым задание запускалось.
	Запись.Вставить("Механизм",             МеханизмФоновогоЗапуска);
	Запись.Вставить("ИмяИнструмента",       ИмяИнструмента);
	Запись.Вставить("Аргументы",            Аргументы);
	Запись.Вставить("Команда",              Команда);        // исходная — для lineage в хвосте
	Запись.Вставить("Подготовка",           Подготовка);
	Запись.Вставить("ДанныеЗапроса",        ДанныеЗапроса);
	Запись.Вставить("Режим",                Режим);          // "mcp" | "rest"
	Запись.Вставить("Ид",                   Ид);
	Запись.Вставить("ИдПотокаSSE",          ИдПотокаSSE);
	Запись.Вставить("Дедлайн",              ТекущаяДата() + ТаймаутЗапросаСек);
	Запись.Вставить("Эпоха",                ЭпохаЗащиты);    // эпоха защиты на момент запуска

	// Вызов строгого режима: ответ уходит через строгий хвост (Вызов, Проверка, Доставка), см. ДоставитьРезультатЗадания.
	Если КонтекстСтрогий <> Неопределено Тогда

		Запись.Вставить("Строгий", КонтекстСтрогий);

	КонецЕсли;

	// БСП могла выполнить вызов в основном потоке вместо фона (режим отладки платформы,
	// занятая очередь файловой базы). Результат уже готов и корректен — доставляем его
	// сразу. Повторять команду синхронно нельзя: у execute_code бывают побочные эффекты.
	Если Пуск.БезФоновогоЗадания Тогда
		ДобавитьВЛог("Фоновое задание не создано, команда выполнена в основном потоке:"
			+ " параллельности сейчас нет (обычная причина — режим отладки платформы).");
		ДоставитьРезультатЗадания(Запись, ЗабратьРезультатЗадания(Пуск.АдресРезультата, ЭтаФорма.УникальныйИдентификатор));
		Возврат Истина;
	КонецЕсли;

	АктивныеЗадания.Вставить(ДанныеЗапроса.id, Запись);
	ЗапуститьДоставкуЕслиНужно();

	Возврат Истина;

КонецФункции

// Обработчик доставки — однократный, перевзводит себя сам.
// Интервал меньше секунды платформа принимает ТОЛЬКО при Однократно = Истина,
// поэтому постоянный обработчик не опустился бы ниже 1 с. Фактический интервал
// не гарантирован: срабатывание идет только в состоянии покоя клиента.
&НаКлиенте
Процедура ЗапуститьДоставкуЕслиНужно()

	Если ОбработчикДоставкиАктивен Тогда
		Возврат;
	КонецЕсли;
	ОбработчикДоставкиАктивен = Истина;
	ПодключитьОбработчикОжидания("ДоставитьГотовыеРезультаты", 0.2, Истина);

КонецПроцедуры

// Состояние задания, запущенного напрямую платформой (см. ЗаданиеЧерезФоновоеЗаданиеПлатформы) —
// в тех же терминах {Статус, КраткоеПредставлениеОшибки}, что и ОперацияВыполнена БСП. Отдельного
// метода опроса в БСП для этого пути нет, поэтому опрашиваем платформу напрямую. Используется и
// при опросе (СостояниеЗадания), и сразу после запуска — чтобы пробный запуск видел настоящий
// результат, а не всегда "Выполняется" (см. ЗаданиеЧерезФоновоеЗаданиеПлатформы).
&НаСервереБезКонтекста
Функция СостояниеЗаданияПлатформы(ИдентификаторЗадания)

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Возврат Новый Структура("Статус, КраткоеПредставлениеОшибки", "Ошибка", "Фоновое задание не найдено");
	КонецЕсли;

	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Новый Структура("Статус, КраткоеПредставлениеОшибки", "Выполняется", "");
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Возврат Новый Структура("Статус, КраткоеПредставлениеОшибки", "Выполнено", "");
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Возврат Новый Структура("Статус, КраткоеПредставлениеОшибки", "Отменено", "");
	Иначе
		// ЗавершеноАварийно
		Представление = "";
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Представление = КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
		Возврат Новый Структура("Статус, КраткоеПредставлениеОшибки", "Ошибка", Представление);
	КонецЕсли;

КонецФункции

// Состояние одного задания в терминах, которые понимает ОпроситьЗадания/ТекстОшибкиЗадания:
// {Статус, КраткоеПредставлениеОшибки}. Статус для разных механизмов запуска определяется
// по-разному — здесь единственное место, где это учитывается.
&НаСервереБезКонтекста
Функция СостояниеЗадания(МодульДлительныеОперации, ИдентификаторЗадания, Механизм)

	Если Механизм = "ФоновоеЗаданиеПлатформы" Или Механизм = "ДопОбработкаБСП21" Тогда
		Возврат СостояниеЗаданияПлатформы(ИдентификаторЗадания);
	КонецЕсли;

	// ОперацияВыполнена, а не ЗаданиеВыполнено(Ид, Истина): второго параметра до БСП 3.1.10
	// нет, а ОперацияВыполнена возвращает ту же структуру во всей линейке
	// (проверено на живых базах с БСП 3.1.5.473 и 3.1.12.297).
	Возврат МодульДлительныеОперации.ОперацияВыполнена(ИдентификаторЗадания);

КонецФункции

// Опрос состояния заданий. ВОЗВРАЩАЕТ ТОЛЬКО ГОТОВЫЕ: реестр через границу
// клиент/сервер не гоняется. Именно неаккуратная маршализация большого
// соответствия стоила 6-12 с на запрос до шага 1 — не повторять.
// Задания — массив структур {ИдЗапроса, ИдентификаторЗадания, Механизм}: механизм передается
// вместе с заданием, а не читается из реквизита формы — тот мог обнулиться, пока задание
// еще выполняется (флажок сняли на середине запроса).
&НаСервереБезКонтекста
Функция ОпроситьЗадания(Задания)

	Готовые = Новый Массив;

	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");
	Исключение
		ТекстНедоступности = "Библиотека стандартных подсистем недоступна: " + ОписаниеОшибки();
		Для Каждого Задание Из Задания Цикл
			Готовые.Добавить(Новый Структура("ИдЗапроса, Ошибка, Текст",
				Задание.ИдЗапроса, Истина, ТекстНедоступности));
		КонецЦикла;
		Возврат Готовые;
	КонецПопытки;

	Для Каждого Задание Из Задания Цикл

		Попытка
			Состояние = СостояниеЗадания(МодульДлительныеОперации, Задание.ИдентификаторЗадания, Задание.Механизм);
		Исключение
			Готовые.Добавить(Новый Структура("ИдЗапроса, Ошибка, Текст",
				Задание.ИдЗапроса, Истина, ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;

		Если Состояние.Статус = "Выполняется" Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура("ИдЗапроса, Ошибка, Текст", Задание.ИдЗапроса, Ложь, "");
		Если Состояние.Статус <> "Выполнено" Тогда
			Запись.Ошибка = Истина;
			Запись.Текст  = ТекстОшибкиЗадания(Состояние);
		КонецЕсли;
		Готовые.Добавить(Запись);

	КонецЦикла;

	Возврат Готовые;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиЗадания(Состояние)

	// КраткоеПредставлениеОшибки помечено в БСП как устаревшее, но присутствует
	// в структуре и не требует второго общего модуля (ОбработкаОшибок).
	Представление = "";
	Состояние.Свойство("КраткоеПредставлениеОшибки", Представление);

	Если ЗначениеЗаполнено(Представление) Тогда
		Возврат Представление;
	КонецЕсли;

	Возврат "Статус задания: " + Строка(Состояние.Статус);

КонецФункции

// Обратный путь кэша расширения: значение, собранное в фоновом задании, кладется в хранилище сеанса
// формы, а клиенту, как и в синхронном режиме, уходит только адрес. Строка значения удаляется всегда.
//
// Параметры:
//  Результат - Структура - результат фонового задания
//  ИмяЗначения - Строка - имя поля со значением кэша, сериализованным строкой
//  ИмяТокена - Строка - имя поля, в которое кладется адрес значения
//  ИдентификаторФормы - УникальныйИдентификатор - форма-владелец временного хранилища
//
&НаСервереБезКонтекста
Процедура ПоместитьЗначениеКэшаВХранилище(Результат, ИмяЗначения, ИмяТокена, ИдентификаторФормы)

	Значение = Неопределено;
	Если НЕ Результат.Свойство(ИмяЗначения, Значение) Тогда

		Возврат;

	КонецЕсли;

	Результат.Удалить(ИмяЗначения);
	Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда

		Результат.Вставить(ИмяТокена,
			ПоместитьВоВременноеХранилище(ЗначениеИзСтрокиВнутр(Значение), ИдентификаторФормы));

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗабратьРезультатЗадания(Адрес, Знач ИдентификаторФормы)

	Попытка
		Значение = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		Возврат Новый Структура("success, error", Ложь,
			"Результат фонового задания недоступен: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		// Адрес мог быть уже освобожден — на результат не влияет
	КонецПопытки;

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Новый Структура("success, error", Ложь,
			"Фоновое задание вернуло неожиданный тип результата");
	КонецЕсли;

	ПоместитьЗначениеКэшаВХранилище(Значение, "mcp_cache_details_value", "mcp_cache_details_token", ИдентификаторФормы);
	ПоместитьЗначениеКэшаВХранилище(Значение, "mcp_cache_index_value", "mcp_cache_index_token", ИдентификаторФормы);

	Возврат Значение;

КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьЗадание(ИдентификаторЗадания, Адрес)

	// ОтменитьВыполнениеЗадания на неизвестном ид не бросает (проверено),
	// но Попытка оставлена: задание могло завершиться между опросом и отменой.
	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");
		МодульДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	Исключение
		// Задание уже завершено, отменено, либо БСП недоступна
	КонецПопытки;

	Попытка
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		// Адрес мог быть уже освобожден
	КонецПопытки;

КонецПроцедуры

// Полная очистка реестра: старт и остановка встроенного сервера.
&НаКлиенте
Процедура СнятьВсеЗадания()

	Если АктивныеЗадания = Неопределено Или АктивныеЗадания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КлючЗначение Из АктивныеЗадания Цикл
		ОтменитьЗадание(КлючЗначение.Значение.ИдентификаторЗадания,
			КлючЗначение.Значение.АдресРезультата);
	КонецЦикла;
	ДобавитьВЛог("Реестр фоновых заданий очищен: " + АктивныеЗадания.Количество() + " шт.");
	АктивныеЗадания = Новый Соответствие;

КонецПроцедуры

&НаКлиенте
Процедура СнятьПросроченные()

	Сейчас = ТекущаяДата();
	КСнятию = Новый Массив;
	Для Каждого КлючЗначение Из АктивныеЗадания Цикл
		Если КлючЗначение.Значение.Дедлайн <= Сейчас Тогда
			КСнятию.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИдЗапроса Из КСнятию Цикл
		Запись = АктивныеЗадания.Получить(ИдЗапроса);
		АктивныеЗадания.Удалить(ИдЗапроса);
		ОтменитьЗадание(Запись.ИдентификаторЗадания, Запись.АдресРезультата);
		СверитьСостояниеПодтвержденногоВызова(Запись.ДанныеЗапроса);
		ДобавитьВЛог("Фоновое задание снято по дедлайну: " + Запись.ИмяИнструмента
			+ " (requestId " + Строка(ИдЗапроса) + ")");
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДоставитьГотовыеРезультаты() Экспорт

	ОбработчикДоставкиАктивен = Ложь;

	Если АктивныеЗадания.Количество() = 0 Тогда
		Возврат; // не перевзводимся: следующий запуск разбудит нас сам
	КонецЕсли;

	СнятьПросроченные();

	Задания = Новый Массив;
	Для Каждого КлючЗначение Из АктивныеЗадания Цикл
		Задания.Добавить(Новый Структура("ИдЗапроса, ИдентификаторЗадания, Механизм", КлючЗначение.Ключ,
			КлючЗначение.Значение.ИдентификаторЗадания, КлючЗначение.Значение.Механизм));
	КонецЦикла;

	Если Задания.Количество() > 0 Тогда

		Готовые = ОпроситьЗадания(Задания);

		Для Каждого Готово Из Готовые Цикл
			Запись = АктивныеЗадания.Получить(Готово.ИдЗапроса);
			Если Запись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			АктивныеЗадания.Удалить(Готово.ИдЗапроса);

			Если Запись.Свойство("Строгий") Тогда
				ДоставитьГотовыйРезультатСтрогий(Запись, Готово);
			Иначе
				ДоставитьРезультатЗадания(Запись, РезультатГотовогоЗадания(Запись, Готово));
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	ЗапуститьДоставкуЕслиНужно();

КонецПроцедуры

// Результат завершенного фонового задания: ошибка задания или результат из временного хранилища.
//
// Параметры:
//  Запись - Структура - запись реестра АктивныеЗадания
//  Готово - Структура - состояние задания из ОпроситьЗадания (Ошибка, Текст)
//
// Возвращаемое значение:
//  Произвольный - результат выполнения инструмента
//
&НаКлиенте
Функция РезультатГотовогоЗадания(Запись, Готово)

	Если Готово.Ошибка Тогда

		Возврат Новый Структура("success, error", Ложь, "Фоновое задание завершилось с ошибкой: " + Готово.Текст);

	КонецЕсли;

	Возврат ЗабратьРезультатЗадания(Запись.АдресРезультата, ЭтаФорма.УникальныйИдентификатор);

КонецФункции

// Доставка результата фонового задания строгого режима. Запись уже снята с реестра, поэтому сбой доставки
// отвечает клиенту E_EXECUTION, если ответ по доставке еще не дан (ОтветДоставкиДан), и не прерывает доставку
// остальных заданий.
//
// Параметры:
//  Запись - Структура - запись реестра АктивныеЗадания с полем Строгий (Вызов, Проверка, Доставка)
//  Готово - Структура - состояние задания из ОпроситьЗадания (Ошибка, Текст)
//
&НаКлиенте
Процедура ДоставитьГотовыйРезультатСтрогий(Запись, Готово)

	Попытка

		ДоставитьРезультатЗадания(Запись, РезультатГотовогоЗадания(Запись, Готово));

	Исключение

		ДобавитьВЛог("Строгий режим: сбой доставки результата фонового задания: " + ОписаниеОшибки());
		Доставка = Запись.Строгий.Доставка;

		Если НЕ ОтветДоставкиДан(Доставка) Тогда

			ОтправитьОтветШлюза(ОтветОшибкиСтрогогоДоставки("E_EXECUTION", "", Доставка), Доставка);

		КонецЕсли;

	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ДоставитьРезультатЗадания(Запись, Результат)

	СверитьСостояниеПодтвержденногоВызова(Запись.ДанныеЗапроса);

	Если Запись.Свойство("Эпоха") И Запись.Эпоха <> ЭпохаЗащиты Тогда

		ДобавитьВЛог("Результат фонового задания прошлой эпохи защиты отброшен");
		ОтправитьОшибкуЭпохи(ДоставкаИзЗаписиЗадания(Запись));
		Возврат;

	КонецЕсли;

	// Хвост ВыполнитьКомандуНаСервереСКэшированием: маркер _anon_schema_forced и учет
	// токенов кэша расширений. Синхронный путь проходит его всегда, фоновый обязан тоже,
	// иначе наружу уходят служебные поля mcp_cache_*, а кэш расширений не обновляется.
	Результат = ЗавершитьКомандуНаСервереСКэшированием(Результат, Запись.Подготовка);

	// _cmd_arguments_json НЕ выставляем здесь: для mcp его ставит ЗавершитьToolsCall,
	// а REST-хвост его не ставил и раньше. Двойная вставка изменила бы поведение.
	ДобавитьВЛог("Результат фонового задания получен" + Символы.ПС + ПолучитьТекстРезультата(Результат));

	Если Запись.Свойство("Строгий") Тогда

		ДоставитьРезультатСтрогий(Результат, Запись.Строгий);

		Возврат;

	КонецЕсли;

	Если Запись.Режим = "rest" Тогда
		Ответ = ЗавершитьRESTЗапрос(Результат, Запись.ИмяИнструмента, Запись.Команда, Запись.ДанныеЗапроса);
		Если Ответ <> Неопределено Тогда
			КомпонентаSendResponse(Запись.ДанныеЗапроса.id, Ответ.КодОтвета, ЗаголовкиJSON(), Ответ.Тело);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ТулКолРез = ЗавершитьToolsCall(Результат, Запись.ИмяИнструмента, Запись.Аргументы,
		Запись.Команда, Запись.ДанныеЗапроса, Запись.Ид, Запись.ИдПотокаSSE);
	Если ТулКолРез = Неопределено Тогда
		Возврат; // хвост ушел в свою async-ветку и отправит ответ сам
	КонецЕсли;

	ОтветJSON = СформироватьJSONRPCОтвет(Запись.Ид, ТулКолРез);
	Если ЗначениеЗаполнено(Запись.ИдПотокаSSE) Тогда
		КомпонентаSendSSEEvent(Запись.ИдПотокаSSE, ОтветJSON, "{}", "message");
	Иначе
		ОтправитьSSEОтвет(Запись.ДанныеЗапроса, ОтветJSON);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеJsonToToonREST(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = Структура("ДанныеЗапроса, Результат", ...)

	Если ОтветОтклоненПоЭпохе("rest", ДопПар.ДанныеЗапроса, "", "") Тогда

		Возврат;

	КонецЕсли;

	Доставка = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE", "rest", ДопПар.ДанныеЗапроса, "", "");

	Попытка

		Если ЗначениеЗаполнено(РезВызова) Тогда
			ДопПар.Результат.data = РезВызова;
		КонецЕсли;
		ДопПар.Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(ДопПар.Результат);
		Тело = ЗаписатьJSON2(ДопПар.Результат);
		Доставка.Вставить("Отвечено", Истина);
		КомпонентаSendResponse(ДопПар.ДанныеЗапроса.id, 200, ЗаголовкиJSON(), Тело);

	Исключение

		ДобавитьВЛог("Сбой продолжения конвертации TOON: " + ОписаниеОшибки());
		ОтправитьОшибкуВыполненияДоставки(Доставка);

	КонецПопытки;
КонецПроцедуры

