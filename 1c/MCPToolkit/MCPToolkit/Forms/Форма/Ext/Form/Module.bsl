КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьRESTGETОшибкаЦелого(ИмяПоля, СыройТекст)
	
	ИмяПоля = СокрЛП(Строка(ИмяПоля));
	СыройТекст = Строка(СыройТекст);
	
	Сообщение = "Ошибка валидации: " + ИмяПоля + " должен быть целым числом, получено '" + СыройТекст + "' / "
		+ "Validation error: " + ИмяПоля + " must be an integer, got '" + СыройТекст + "'";
	
	Лок = Новый Массив;
	Лок.Добавить(ИмяПоля);
	
	Детали = Новый Массив;
	Детали.Добавить(Новый Структура(
		"loc, msg, type, input",
		Лок,
		"value is not a valid integer",
		"int_parsing",
		СыройТекст
	));
	
	Возврат СформироватьRESTОшибка(422, Сообщение, Детали);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, ИмяПоля)
	
	// Если поле отсутствует — ок.
	// Если есть и это строка, но не целое — возвращает структуру REST ошибки (КодОтвета/Тело).
	// Если можно распарсить — заменяет значение на целое и возвращает Неопределено.
	
	Если RESTПараметры = Неопределено Или ТипЗнч(RESTПараметры) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ RESTПараметры.Свойство(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сырой = RESTПараметры[ИмяПоля];
	
	// Если пришло несколько значений — берём первое (как request.query_params.get в прокси).
	Если ТипЗнч(Сырой) = Тип("Массив") Или ТипЗнч(Сырой) = Тип("ФиксированныйМассив") Тогда
		Если Сырой.Количество() = 0 Тогда
			Сырой = "";
		Иначе
			Сырой = Сырой[0];
		КонецЕсли;
	КонецЕсли;
	
	Если Сырой = Null Или Сырой = Неопределено Тогда
		Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, "");
	КонецЕсли;
	
	Если ТипЗнч(Сырой) = Тип("Число") Тогда
		Если Сырой <> Цел(Сырой) Тогда
			Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, Строка(Сырой));
		КонецЕсли;
		RESTПараметры.Вставить(ИмяПоля, Цел(Сырой));
		Возврат Неопределено;
	КонецЕсли;
	
	СыройСтрока = СокрЛП(Строка(Сырой));
	Если ПустаяСтрока(СыройСтрока) Тогда
		Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, СыройСтрока);
	КонецЕсли;
	
	ЧислоЗначение = Неопределено;
	Попытка
		ЧислоЗначение = Число(СыройСтрока);
	Исключение
		ЧислоЗначение = Неопределено;
	КонецПопытки;
	
	Если ЧислоЗначение = Неопределено Или ЧислоЗначение <> Цел(ЧислоЗначение) Тогда
		Возврат СформироватьRESTGETОшибкаЦелого(ИмяПоля, СыройСтрока);
	КонецЕсли;
	
	RESTПараметры.Вставить(ИмяПоля, Цел(ЧислоЗначение));
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ОбработатьRESTЗапрос(ДанныеЗапроса)

	// path → tool: /api/execute_query → execute_query
	ИмяИнструмента = Сред(ДанныеЗапроса.path, 6); // убираем "/api/"

	// Формируем Команда
	Команда = Новый Структура;
	Команда.Вставить("id", ДанныеЗапроса.id);
	Команда.Вставить("tool", ИмяИнструмента);

	// REST: restart/close -- перехват ДО парсинга body (endpoint без параметров, пустой/любой POST валиден)
	Если ИмяИнструмента = "restart_1c_session" Тогда
		Если ДанныеЗапроса.method <> "POST" Тогда
			Возврат СформироватьRESTОшибка(405, "Method not allowed: restart_1c_session requires POST");
		КонецЕсли;
		// Двойной guard: ПерезапускВОжидании -- during active restart;
		// ЗавершениеПослеПерезапускаЗапущено -- during shutdown (after ПерезапускВОжидании reset)
		Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
			Возврат СформироватьRESTОшибка(500, "Restart or close already in progress");
		КонецЕсли;
		ВыполнитьПерезапускСессии("", ДанныеЗапроса, ДанныеЗапроса.id, "", Истина);
		Возврат Неопределено;
	КонецЕсли;
	Если ИмяИнструмента = "close_1c_session" Тогда
		Если ДанныеЗапроса.method <> "POST" Тогда
			Возврат СформироватьRESTОшибка(405, "Method not allowed: close_1c_session requires POST");
		КонецЕсли;
		Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
			Возврат СформироватьRESTОшибка(500, "Restart or close already in progress");
		КонецЕсли;
		ВыполнитьЗакрытиеСессии("", ДанныеЗапроса, ДанныеЗапроса.id, "", Истина);
		Возврат Неопределено;
	КонецЕсли;

	// POST-only для submit_for_deanonymization
	Если ИмяИнструмента = "submit_for_deanonymization" И ДанныеЗапроса.method <> "POST" Тогда
		Возврат СформироватьRESTОшибка(405, "Method not allowed: submit_for_deanonymization requires POST");
	КонецЕсли;

	// Параметры: GET из query, POST из body
	Если ДанныеЗапроса.method = "GET" Тогда
		RESTПараметры = Новый Структура;
		Попытка
			Для Каждого КлючЗначение Из ДанныеЗапроса.query Цикл
				ИмяПоля = КлючЗначение.Ключ;
				Значения = КлючЗначение.Значение;
				
				// channel — транспортный параметр прокси-режима (маршрутизация на разные БД).
				// Во встроенном сервере не используется и не должен попадать в params инструмента.
				Если ИмяПоля = "channel" Тогда
					Продолжить;
				КонецЕсли;
				
				// Списки: поддерживаем CSV и повторяющиеся параметры как в прокси.
				Если ИмяПоля = "meta_type"
					Или ИмяПоля = "sections"
					Или ИмяПоля = "levels"
					Или ИмяПоля = "events"
					Или ИмяПоля = "rights_filter"
					Или ИмяПоля = "roles_filter"
					Или ИмяПоля = "names"
				Тогда
					СписокЗначений = НормализоватьRESTQueryСписок(Значения);
					Если СписокЗначений <> Неопределено Тогда
						Если СписокЗначений.Количество() = 1 Тогда
							RESTПараметры.Вставить(ИмяПоля, СписокЗначений[0]);
						Иначе
							RESTПараметры.Вставить(ИмяПоля, СписокЗначений);
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли ТипЗнч(Значения) = Тип("Массив") И Значения.Количество() = 1 Тогда
					RESTПараметры.Вставить(ИмяПоля, Значения[0]);
				Иначе
					RESTПараметры.Вставить(ИмяПоля, Значения);
				КонецЕсли;
			КонецЦикла;
		Исключение
			// query может быть пустым
		КонецПопытки;
		
		// Числовые параметры из query: если не парсятся, отдаём ошибку как в прокси (422 + details).
		RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "limit");
		Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
		RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "offset");
		Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
		RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "same_second_offset");
		Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
		RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "limit_hits");
		Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
		RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "limit_per_meta");
		Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
		RESTОшибка = ПопробоватьРаспарситьRESTGETЦелоеПоле(RESTПараметры, "timeout_budget_sec");
		Если RESTОшибка <> Неопределено Тогда Возврат RESTОшибка КонецЕсли;
		
		Команда.Вставить("params", RESTПараметры);
	Иначе
		Попытка
			ТелоREST = ПрочитатьJSON2(ДанныеЗапроса.body);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Возврат СформироватьRESTОшибка(400,
				"Ошибка разбора JSON: " + ТекстОшибки + " / JSON parse error: " + ТекстОшибки);
		КонецПопытки;
		
		Если ТипЗнч(ТелоREST) <> Тип("Структура") Тогда
			Возврат СформироватьRESTОшибка(400,
				"Тело запроса должно быть JSON объектом / Request body must be a JSON object");
		КонецЕсли;
		
		// channel — транспортный параметр прокси-режима (маршрутизация на разные БД).
		// Во встроенном сервере не используется и не должен попадать в params инструмента.
		УдалитьПолеЕслиЕсть(ТелоREST, "channel");
		
		Команда.Вставить("params", ТелоREST);
	КонецЕсли;

	ДобавитьВЛог("Получена команда: " + ИмяИнструмента + Символы.ПС + ПолучитьТекстКоманды(Команда));

	// Деанонимизация входных параметров (встроенный сервер, точная анонимизация)
	Если ИспользоватьТочнуюАнонимизацию Тогда
		ДеАнонимизироватьПараметрыКомандыИВытеснить(Команда);
	КонецЕсли;

	// Валидация аргументов (строгие типы/дефолты): только для встроенного HTTP-сервера (REST).
	ПараметрыRESTЗапроса = Неопределено;
	Команда.Свойство("params", ПараметрыRESTЗапроса);

	Если ТипЗнч(ПараметрыRESTЗапроса) = Тип("Структура") Тогда
		ДетальОшибки = ПроверитьИНормализоватьАргументыИнструмента(ИмяИнструмента, ПараметрыRESTЗапроса);
		Если ДетальОшибки <> Неопределено Тогда
			СообщениеОшибки = "Ошибка валидации параметров: " + ДетальОшибки
				+ " / Parameter validation failed: " + ДетальОшибки;
			Возврат Новый Структура("КодОтвета, Тело", 422,
				ЗаписатьJSON2(Новый Структура("success, error", Ложь, СообщениеОшибки))
			);
		КонецЕсли;
	Иначе
		// Если параметры не объект, то не пытаемся "валидировать лимиты" по типам,
		// иначе будет неинформативная ошибка на неверный JSON. Лимит-поля всё равно не извлечь.
	КонецЕсли;

	// Проверка опасных операций для execute_code (REST)
	Если ИмяИнструмента = "execute_code" Тогда
		Код = "";
		Если ТипЗнч(Команда.params) = Тип("Структура") Тогда
			Команда.params.Свойство("code", Код);
		КонецЕсли;
		МассивОпасныхСлов = ПроверитьОпасныеСлова(Код);
		Если МассивОпасныхСлов.Количество() > 0 Тогда
			Если ВсеОперацииАвтоРазрешены(МассивОпасныхСлов) Тогда
				ДобавитьВЛог("REST: операции автоматически разрешены: " + СоединитьМассив(МассивОпасныхСлов, ", "));
			ИначеЕсли РазрешатьОпасныеОперацииСПодтверждением Тогда
				ОпасныеСлова = СоединитьМассив(МассивОпасныхСлов, ", ");
				ОжидающиеПодтверждения.Вставить(ДанныеЗапроса.id,
					Новый Структура(
						"Режим, ДанныеЗапроса, Команда, ОпасныеКлючевыеСлова, ОпасныеКлючевыеСловаТекст",
						"rest", ДанныеЗапроса, Команда, МассивОпасныхСлов, ОпасныеСлова));
				ОткрытьФорму(
					"ВнешняяОбработка.MCPToolkit.Форма.ФормаПодтверждения",
					Новый Структура("ОпасныеСлова, Код", ОпасныеСлова, Код),
					ЭтаФорма, , , ,
					Новый ОписаниеОповещения("ОбработатьРезультатПодтвержденияВстроенный",
						ЭтаФорма, Новый Структура("RequestId", ДанныеЗапроса.id)),
					РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
				Возврат Неопределено;
			Иначе
				КлючевыеСловаТекст = СоединитьМассив(МассивОпасныхСлов, ", ");
				Возврат СформироватьRESTОшибка(403,
					"Операция запрещена: код содержит опасные ключевые слова: " + КлючевыеСловаТекст
					+ " / Operation not allowed: code contains dangerous keywords: " + КлючевыеСловаТекст);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Выполнение
	Если ВыполнятьВФоне(ИмяИнструмента, Команда) Тогда
		Если ЗапуститьВФонеИЗарегистрировать(Команда, ИмяИнструмента, Неопределено,
				ДанныеЗапроса, "rest", "", "") Тогда
			Возврат Неопределено; // ответ уйдет из обработчика доставки
		КонецЕсли;
	КонецЕсли;

	Попытка
		Результат = ВыполнитьКомандуСУчетомКонтекста(Команда);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат СформироватьRESTОшибка(500,
			"Необработанное исключение сервера: " + ТекстОшибки
			+ " / Unhandled server exception: " + ТекстОшибки);
	КонецПопытки;

	Возврат ЗавершитьRESTЗапрос(Результат, ИмяИнструмента, Команда, ДанныеЗапроса);

КонецФункции

// Хвост обработки REST-запроса: анонимизация, lineage, TOON и формирование ответа.
// Вынесен отдельно, потому что при включенном параллельном режиме результат
// приходит из фонового задания и тот же хвост нужно выполнить позже (задача 000001, шаг 3).
&НаКлиенте
Функция ЗавершитьRESTЗапрос(Результат, ИмяИнструмента, Команда, ДанныеЗапроса)

	ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Команда);
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапросаLineage, Результат) Тогда
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат, ТекстЗапроса",
			"rest", ДанныеЗапроса, Результат, ТекстЗапросаLineage);
		НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоОбъект",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
			"rest", ДанныеЗапроса, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоFindReferences",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
			"rest", ДанныеЗапроса, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_event_log" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоGetEventLog",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
			"rest", ДанныеЗапроса, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат Неопределено;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "get_access_rights" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
			Результат.Вставить("_original_data_anon_marker", Истина);
		КонецЕсли;
		АнонимизироватьРезультатGetAccessRights(Результат);
		ОбновитьТаблицуМаппинговВстроенный();
		Если ПроверитьПодтверждениеАнонимизации(Результат, ДанныеЗапроса, "", "", "rest") Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И ИмяИнструмента = "execute_code" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		УжеАнонимизирован = Ложь;
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			ВремАнон = Неопределено;
			УжеАнонимизирован = Результат.Свойство("_original_data_json", ВремАнон) И ЗначениеЗаполнено(ВремАнон);
		КонецЕсли;
		Если НЕ УжеАнонимизирован Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			РегексКонтекст = Новый Структура(
				"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
			КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Результат",
				"rest", ДанныеЗапроса, Результат);
			РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
			ЗапуститьRegexФазу(РегексКонтекст);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	// Async-ветка для JsonToToon:
	Если ИспользоватьАсинхронноеПодключениеКомпонент И КомпонентаТун <> Неопределено
		И ФорматОтветаВстроенный = 1 И ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("success") И Результат.success И Результат.Свойство("data") Тогда
		КомпонентаТун.НачатьВызовJsonToToon(
			Новый ОписаниеОповещения("ПослеJsonToToonREST", ЭтаФорма,
				Новый Структура("ДанныеЗапроса, Результат", ДанныеЗапроса, Результат)),
			ЗаписатьJSON2(Результат.data));
		Возврат Неопределено;
	КонецЕсли;

	// sync path: оригинальный вызов ПрименитьТунКонвертацию и Возврат
	Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(Результат);
	ПрименитьТунКонвертацию(Результат);
	Возврат Новый Структура("КодОтвета, Тело", 200, ЗаписатьJSON2(Результат));

КонецФункции

// ============================================================================
// Параллельное выполнение (задача 000001, шаг 3).
// Серверные инструменты уходят в фоновое задание БСП, результат доставляется
// обработчиком ожидания и проходит тот же хвост, что и синхронный путь.
// ============================================================================

// Белый список инструментов, которые разрешено выполнять в фоновом задании.
// Только белый: черный список при появлении нового инструмента отдал бы молча
// неверный ответ вместо ошибки (get_bsl_syntax_help в фоне возвращает 0 тем).
&НаКлиенте
Функция ИнструментДопустимВФоне(ИмяИнструмента, Команда)

	Если ИмяИнструмента = "execute_code" Тогда
		// execution_context = "client" по определению требует клиентского контекста
		КонтекстВыполнения = "server";
		Если Команда.Свойство("params") И Команда.params <> Неопределено
			И Команда.params.Свойство("execution_context") Тогда
			КонтекстВыполнения = Команда.params.execution_context;
		КонецЕсли;
		Возврат КонтекстВыполнения <> "client";
	КонецЕсли;

	Возврат ИмяИнструмента = "execute_query"
		Или ИмяИнструмента = "get_metadata"
		Или ИмяИнструмента = "get_event_log"
		Или ИмяИнструмента = "find_references_to_object"
		Или ИмяИнструмента = "get_access_rights"
		Или ИмяИнструмента = "get_object_by_link"
		Или ИмяИнструмента = "get_link_of_object";

КонецФункции

&НаКлиенте
Функция ВыполнятьВФоне(ИмяИнструмента, Команда)

	Если НЕ ПараллельноеВыполнение Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РежимПодключения = 0 Тогда // только встроенный сервер
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ИнструментДопустимВФоне(ИмяИнструмента, Команда) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(АдресБинарникаОбработки) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Проверяется один раз за сеанс: без БСП каждый запрос иначе платил бы
	// лишний серверный вызов и строку в логе, прежде чем откатиться в синхронный путь.
	Если БСПДоступна = Неопределено Тогда
		БСПДоступна = БСПДоступнаНаСервере();
		Если НЕ БСПДоступна Тогда
			ДобавитьВЛог("Библиотека стандартных подсистем недоступна: параллельное выполнение отключено,"
				+ " запросы выполняются как раньше.");
		КонецЕсли;
	КонецЕсли;
	Если НЕ БСПДоступна Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// ДлительныеОперации берется через Вычислить(): прямое упоминание общего модуля
// сделало бы модуль некомпилируемым в базах без БСП, а со снятым флагом
// обработка обязана работать ровно как раньше.
&НаСервереБезКонтекста
Функция БСПДоступнаНаСервере()

	Возврат ДиагностикаБСПНаСервере().Доступно;

КонецФункции

// Почему параллельное выполнение возможно или невозможно именно в этой базе.
// Возвращает структуру: Доступно, Причина (короткий код для журнала),
// Текст (объяснение пользователю: что не так и что делать), Предупреждение
// (режим работает, но выигрыша не будет), ВерсияБСП.
//
// Проверяется не наличие БСП, а ее версия: на стенде 6004 общий модуль есть,
// а свойства ВнешнийОтчетОбработка в ПараметрыВыполненияФункции нет (проверено
// 2026-08-27) — фоновые задания там не запускаются. Без этой проверки пользователь
// видел бы включенный флажок при последовательной работе и считал бы механизм сломанным.
&НаСервереБезКонтекста
Функция ДиагностикаБСПНаСервере()

	Результат = Новый Структура("Доступно, Причина, Текст, Предупреждение, ВерсияБСП",
		Ложь, "", "", "", "");

	Попытка
		Результат.ВерсияБСП = Вычислить("СтандартныеПодсистемыСервер.ВерсияБиблиотеки()");
	Исключение
		Результат.ВерсияБСП = "";
	КонецПопытки;

	ВерсияВСкобках = ?(ЗначениеЗаполнено(Результат.ВерсияБСП), " (" + Результат.ВерсияБСП + ")", "");

	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");
	Исключение
		Результат.Причина = "НетБСП";
		Результат.Текст =
			"Параллельное выполнение в этой базе невозможно.
			|
			|Причина: в конфигурации нет библиотеки стандартных подсистем (БСП) — общий модуль ДлительныеОперации не найден.
			|Параллельный режим запускает серверные инструменты через ДлительныеОперации.ВыполнитьФункцию,
			|и без БСП запускать их нечем.
			|
			|Что делать: внедрить БСП в конфигурацию либо оставить флажок снятым. Со снятым флажком инструмент
			|исправен — запросы просто выполняются по одному, как и до появления этого режима.";
		Возврат Результат;
	КонецПопытки;

	Попытка
		Параметры = МодульДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
	Исключение
		Результат.Причина = "НетПараметровВыполненияФункции";
		Результат.Текст =
			"Параллельное выполнение в этой базе невозможно.
			|
			|Причина: версия БСП" + ВерсияВСкобках + " не содержит метод
			|ДлительныеОперации.ПараметрыВыполненияФункции — именно им описывается запуск функции в фоновом задании.
			|
			|Что делать: обновить БСП в конфигурации до актуального релиза 3.1 либо оставить флажок снятым:
			|со снятым флажком запросы выполняются по одному, как и до появления этого режима.";
		Возврат Результат;
	КонецПопытки;

	Попытка
		Параметры.ВнешнийОтчетОбработка = Неопределено;
	Исключение
		Результат.Причина = "СтараяБСП";
		Результат.Текст =
			"Параллельное выполнение в этой базе невозможно.
			|
			|Причина: версия БСП" + ВерсияВСкобках + " не умеет запускать ВНЕШНЮЮ обработку в фоновом задании:
			|у структуры ДлительныеОперации.ПараметрыВыполненияФункции нет свойства ВнешнийОтчетОбработка.
			|Через это свойство в фоновое задание передается сама обработка MCP Toolkit — без него выполнять там нечего.
			|
			|Что делать: обновить БСП в конфигурации до релиза, где свойство ВнешнийОтчетОбработка есть
			|(поздние версии 3.1; для сравнения, в 3.1.12 оно уже присутствует), либо оставить флажок снятым.
			|Со снятым флажком инструмент исправен: запросы выполняются по одному, как и до появления этого режима.";
		Возврат Результат;
	КонецПопытки;

	Результат.Доступно = Истина;

	// Файловая база режим не запрещает, но и не ускоряет: фоновые задания там идут
	// по очереди. Флажок остается включенным, пользователь предупрежден.
	Если СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") > 0 Тогда
		Результат.Причина = "ФайловаяБаза";
		Результат.Предупреждение =
			"Параллельное выполнение включено, но ускорения в этой базе не будет.
			|
			|Причина: база файловая, а в файловом режиме 1С выполняет фоновые задания по очереди, а не одновременно.
			|Ответы останутся корректными, но каждый запрос дополнительно потратит время на запуск фонового задания.
			|
			|Что делать: если параллельность нужна ради скорости — перевести базу в клиент-серверный режим.
			|Иначе флажок разумнее снять.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пробный запуск фонового задания тем же путем, каким пойдут боевые запросы.
// Ловит то, чего не видно статической проверкой: нет права на фоновые задания,
// запрещены регламентные задания в базе, обработка не развернулась на сервере.
// ОжидатьЗавершение = 3: ожидание идет на сервере, клиент не крутит цикл опроса.
&НаСервереБезКонтекста
Функция ПробныйЗапускФоновогоЗаданияНаСервере(АдресБинарника, ИдентификаторФормы)

	Результат = Новый Структура("Успех, Текст", Ложь, "");

	Попытка
		Двоичные = ПолучитьИзВременногоХранилища(АдресБинарника);
	Исключение
		Результат.Текст = "бинарник обработки недоступен во временном хранилище: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Двоичные) <> Тип("ДвоичныеДанные") Тогда
		Результат.Текст = "бинарник обработки недоступен во временном хранилище";
		Возврат Результат;
	КонецЕсли;

	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");

		ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
		ПараметрыВыполнения.ВнешнийОтчетОбработка = Двоичные;
		ПараметрыВыполнения.ЗапуститьВФоне        = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение     = 3;
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = "MCP Toolkit: проверка параллельного выполнения";

		Команда = Новый Структура("tool, params", "execute_code", Новый Структура("code", "Результат = 1;"));

		Задание = МодульДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ВнешняяОбработка.MCPToolkit.МодульОбъекта.ВыполнитьКомандуНаСервере", Команда);
	Исключение
		Результат.Текст = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Статус = "";
	Задание.Свойство("Статус", Статус);

	Если Статус = "Ошибка" Или Статус = "Отменено" Тогда
		Результат.Текст = ТекстОшибкиЗадания(Задание);
		Возврат Результат;
	КонецЕсли;

	// Задание либо уже отработало, либо еще считается — оба исхода означают, что запуск
	// состоялся. Сам результат не нужен: если он готов, освобождаем временное хранилище.
	АдресРезультата = "";
	Задание.Свойство("АдресРезультата", АдресРезультата);
	Если ЗначениеЗаполнено(АдресРезультата) И Статус = "Выполнено" Тогда
		Попытка
			УдалитьИзВременногоХранилища(АдресРезультата);
		Исключение
			// Адрес мог быть уже освобожден — на проверку это не влияет
		КонецПопытки;
	КонецЕсли;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Полная проверка перед включением флажка: статическая диагностика плюс — когда
// обработка уже развернута на сервере — реальный пробный запуск фонового задания.
&НаКлиенте
Функция ПроверитьВозможностьПараллельногоВыполнения()

	Проверка = ДиагностикаБСПНаСервере();

	Если НЕ Проверка.Доступно Тогда
		Возврат Проверка;
	КонецЕсли;

	// Прокси-режим: флажок действует только для встроенного сервера. Не запрещаем —
	// пользователь вправе выставить его заранее, до переключения режима.
	Если РежимПодключения = 0 И НЕ ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
		Проверка.Причина = "ПроксиРежим";
		Проверка.Предупреждение =
			"Параллельное выполнение включено, но сейчас оно ни на что не влияет.
			|
			|Причина: выбран режим подключения «Прокси», а параллельный режим действует только для встроенного сервера.
			|
			|Что делать: переключить режим подключения на «Встроенный сервер» — флажок останется включенным и заработает.";
		Возврат Проверка;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресБинарникаОбработки) Тогда
		Если НЕ ЗначениеЗаполнено(Проверка.Предупреждение) Тогда
			Проверка.Причина = "ОбработкаНеРазвернута";
			Проверка.Предупреждение =
				"Проверка выполнена частично: версия БСП подходит, но пробный запуск фонового задания делать не на чем.
				|
				|Причина: обработка еще не развернута на сервере — это происходит при запуске встроенного сервера.
				|
				|Что делать: запустить сервер. Если развернуть обработку не удастся, в журнале появится строка
				|«Не удалось развернуть обработку на сервере», и запросы будут выполняться по одному, как раньше.";
		КонецЕсли;
		Возврат Проверка;
	КонецЕсли;

	Пробный = ПробныйЗапускФоновогоЗаданияНаСервере(АдресБинарникаОбработки, ЭтаФорма.УникальныйИдентификатор);
	Если НЕ Пробный.Успех Тогда
		Проверка.Доступно = Ложь;
		Проверка.Причина  = "ПробныйЗапускНеУдался";
		Проверка.Текст =
			"Параллельное выполнение в этой базе невозможно.
			|
			|Причина: версия БСП подходит, но пробное фоновое задание не запустилось.
			|Ошибка: " + Пробный.Текст + "
			|
			|Что делать: проверить, что у пользователя есть право на выполнение фоновых заданий, что в базе
			|не запрещены регламентные задания и что обработка развернулась на сервере (в журнале — строка
			|«Серверные команды идут через модуль объекта»).
			|До устранения причины флажок оставлен снятым: запросы выполняются по одному, как раньше.";
	КонецЕсли;

	Возврат Проверка;

КонецФункции

// Запуск серверной команды в фоновом задании.
// Возвращает структуру с ИдентификаторЗадания и АдресРезультата,
// либо структуру с признаком Ошибка и текстом.
// &НаСервереБезКонтекста намеренно: контекстный вызов гонял бы через границу
// все реквизиты формы, включая ТаблицаМаппингов, на каждый параллельный запрос.
// УникальныйИдентификатор формы нужен как владелец адреса результата — передается параметром.
&НаСервереБезКонтекста
Функция ЗапуститьКомандуВФоне(Команда, АдресБинарника, ИдентификаторФормы)

	Результат = Новый Структура("Ошибка, Текст, ИдентификаторЗадания, АдресРезультата",
		Ложь, "", Неопределено, "");

	Попытка
		Двоичные = ПолучитьИзВременногоХранилища(АдресБинарника);
		Если ТипЗнч(Двоичные) <> Тип("ДвоичныеДанные") Тогда
			Результат.Ошибка = Истина;
			Результат.Текст = "Бинарник обработки недоступен во временном хранилище";
			Возврат Результат;
		КонецЕсли;

		МодульДлительныеОперации = Вычислить("ДлительныеОперации");

		ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
		ПараметрыВыполнения.ВнешнийОтчетОбработка = Двоичные;
		ПараметрыВыполнения.ЗапуститьВФоне        = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение     = 0;
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = "MCP Toolkit: " + Команда.tool;

		// Имя метода измерено на стенде 6010 (2026-08-27), не выведено из документации.
		// Принимается ТОЛЬКО четырехчастная форма: БСП разбирает "ВнешняяОбработка.Метод"
		// как «общий модуль + метод» и ищет общий модуль с таким именем, а трехчастную —
		// как менеджер объекта. MCPToolkit — имя обработки из MCPToolkit.xml.
		Задание = МодульДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ВнешняяОбработка.MCPToolkit.МодульОбъекта.ВыполнитьКомандуНаСервере", Команда);

		Результат.ИдентификаторЗадания = Задание.ИдентификаторЗадания;
		Результат.АдресРезультата      = Задание.АдресРезультата;
	Исключение
		Результат.Ошибка = Истина;
		Результат.Текст  = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ЗапуститьВФонеИЗарегистрировать(Команда, ИмяИнструмента, Аргументы, ДанныеЗапроса, Режим, Ид, ИдПотокаSSE)

	// В фон уходит РОВНО то, что ушло бы синхронно: ПодготовитьКомандуНаСервер добавляет
	// токены кэша расширений и принудительный include_schema, без которого точная
	// анонимизация execute_query остается без схемы и не срабатывает.
	Подготовка = ПодготовитьКомандуНаСервер(Команда);

	Пуск = ЗапуститьКомандуВФоне(Подготовка.КомандаНаСервер, АдресБинарникаОбработки,
		ЭтаФорма.УникальныйИдентификатор);
	Если Пуск.Ошибка Тогда
		ДобавитьВЛог("Не удалось запустить фоновое задание, выполняем синхронно: " + Пуск.Текст);
		Возврат Ложь;
	КонецЕсли;

	Запись = Новый Структура;
	Запись.Вставить("ИдентификаторЗадания", Пуск.ИдентификаторЗадания);
	Запись.Вставить("АдресРезультата",      Пуск.АдресРезультата);
	Запись.Вставить("ИмяИнструмента",       ИмяИнструмента);
	Запись.Вставить("Аргументы",            Аргументы);
	Запись.Вставить("Команда",              Команда);        // исходная — для lineage в хвосте
	Запись.Вставить("Подготовка",           Подготовка);
	Запись.Вставить("ДанныеЗапроса",        ДанныеЗапроса);
	Запись.Вставить("Режим",                Режим);          // "mcp" | "rest"
	Запись.Вставить("Ид",                   Ид);
	Запись.Вставить("ИдПотокаSSE",          ИдПотокаSSE);
	Запись.Вставить("Дедлайн",              ТекущаяДата() + ТаймаутЗапросаСек);

	АктивныеЗадания.Вставить(ДанныеЗапроса.id, Запись);
	ЗапуститьДоставкуЕслиНужно();

	Возврат Истина;

КонецФункции

// Обработчик доставки — однократный, перевзводит себя сам.
// Интервал меньше секунды платформа принимает ТОЛЬКО при Однократно = Истина,
// поэтому постоянный обработчик не опустился бы ниже 1 с. Фактический интервал
// не гарантирован: срабатывание идет только в состоянии покоя клиента.
&НаКлиенте
Процедура ЗапуститьДоставкуЕслиНужно()

	Если ОбработчикДоставкиАктивен Тогда
		Возврат;
	КонецЕсли;
	ОбработчикДоставкиАктивен = Истина;
	ПодключитьОбработчикОжидания("ДоставитьГотовыеРезультаты", 0.2, Истина);

КонецПроцедуры

// Опрос состояния заданий. ВОЗВРАЩАЕТ ТОЛЬКО ГОТОВЫЕ: реестр через границу
// клиент/сервер не гоняется. Именно неаккуратная маршализация большого
// соответствия стоила 6-12 с на запрос до шага 1 — не повторять.
&НаСервереБезКонтекста
Функция ОпроситьЗадания(Идентификаторы)

	Готовые = Новый Массив;

	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");
	Исключение
		ТекстНедоступности = "Библиотека стандартных подсистем недоступна: " + ОписаниеОшибки();
		Для Каждого КлючЗначение Из Идентификаторы Цикл
			Готовые.Добавить(Новый Структура("ИдЗапроса, Ошибка, Текст",
				КлючЗначение.Ключ, Истина, ТекстНедоступности));
		КонецЦикла;
		Возврат Готовые;
	КонецПопытки;

	Для Каждого КлючЗначение Из Идентификаторы Цикл

		Попытка
			Состояние = МодульДлительныеОперации.ЗаданиеВыполнено(КлючЗначение.Значение, Истина);
		Исключение
			Готовые.Добавить(Новый Структура("ИдЗапроса, Ошибка, Текст",
				КлючЗначение.Ключ, Истина, ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;

		Если Состояние.Статус = "Выполняется" Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура("ИдЗапроса, Ошибка, Текст", КлючЗначение.Ключ, Ложь, "");
		Если Состояние.Статус <> "Выполнено" Тогда
			Запись.Ошибка = Истина;
			Запись.Текст  = ТекстОшибкиЗадания(Состояние);
		КонецЕсли;
		Готовые.Добавить(Запись);

	КонецЦикла;

	Возврат Готовые;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиЗадания(Состояние)

	// КраткоеПредставлениеОшибки помечено в БСП как устаревшее, но присутствует
	// в структуре и не требует второго общего модуля (ОбработкаОшибок).
	Представление = "";
	Состояние.Свойство("КраткоеПредставлениеОшибки", Представление);

	Если ЗначениеЗаполнено(Представление) Тогда
		Возврат Представление;
	КонецЕсли;

	Возврат "Статус задания: " + Строка(Состояние.Статус);

КонецФункции

&НаСервереБезКонтекста
Функция ЗабратьРезультатЗадания(Адрес)

	Попытка
		Значение = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		Возврат Новый Структура("success, error", Ложь,
			"Результат фонового задания недоступен: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		// Адрес мог быть уже освобожден — на результат не влияет
	КонецПопытки;

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Новый Структура("success, error", Ложь,
			"Фоновое задание вернуло неожиданный тип результата");
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьЗадание(ИдентификаторЗадания, Адрес)

	// ОтменитьВыполнениеЗадания на неизвестном ид не бросает (проверено на 6010),
	// но Попытка оставлена: задание могло завершиться между опросом и отменой.
	Попытка
		МодульДлительныеОперации = Вычислить("ДлительныеОперации");
		МодульДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	Исключение
		// Задание уже завершено, отменено, либо БСП недоступна
	КонецПопытки;

	Попытка
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		// Адрес мог быть уже освобожден
	КонецПопытки;

КонецПроцедуры

// Полная очистка реестра: старт и остановка встроенного сервера.
&НаКлиенте
Процедура СнятьВсеЗадания()

	Если АктивныеЗадания = Неопределено Или АктивныеЗадания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КлючЗначение Из АктивныеЗадания Цикл
		ОтменитьЗадание(КлючЗначение.Значение.ИдентификаторЗадания,
			КлючЗначение.Значение.АдресРезультата);
	КонецЦикла;
	ДобавитьВЛог("Реестр фоновых заданий очищен: " + АктивныеЗадания.Количество() + " шт.");
	АктивныеЗадания = Новый Соответствие;

КонецПроцедуры

&НаКлиенте
Процедура СнятьПросроченные()

	Сейчас = ТекущаяДата();
	КСнятию = Новый Массив;
	Для Каждого КлючЗначение Из АктивныеЗадания Цикл
		Если КлючЗначение.Значение.Дедлайн <= Сейчас Тогда
			КСнятию.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИдЗапроса Из КСнятию Цикл
		Запись = АктивныеЗадания.Получить(ИдЗапроса);
		АктивныеЗадания.Удалить(ИдЗапроса);
		ОтменитьЗадание(Запись.ИдентификаторЗадания, Запись.АдресРезультата);
		ДобавитьВЛог("Фоновое задание снято по дедлайну: " + Запись.ИмяИнструмента
			+ " (requestId " + Строка(ИдЗапроса) + ")");
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДоставитьГотовыеРезультаты() Экспорт

	ОбработчикДоставкиАктивен = Ложь;

	Если АктивныеЗадания.Количество() = 0 Тогда
		Возврат; // не перевзводимся: следующий запуск разбудит нас сам
	КонецЕсли;

	СнятьПросроченные();

	Идентификаторы = Новый Соответствие;
	Для Каждого КлючЗначение Из АктивныеЗадания Цикл
		Идентификаторы.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение.ИдентификаторЗадания);
	КонецЦикла;

	Если Идентификаторы.Количество() > 0 Тогда

		Готовые = ОпроситьЗадания(Идентификаторы);

		Для Каждого Готово Из Готовые Цикл
			Запись = АктивныеЗадания.Получить(Готово.ИдЗапроса);
			Если Запись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			АктивныеЗадания.Удалить(Готово.ИдЗапроса);

			Если Готово.Ошибка Тогда
				Результат = Новый Структура("success, error", Ложь,
					"Фоновое задание завершилось с ошибкой: " + Готово.Текст);
			Иначе
				Результат = ЗабратьРезультатЗадания(Запись.АдресРезультата);
			КонецЕсли;

			ДоставитьРезультатЗадания(Запись, Результат);
		КонецЦикла;

	КонецЕсли;

	ЗапуститьДоставкуЕслиНужно();

КонецПроцедуры

&НаКлиенте
Процедура ДоставитьРезультатЗадания(Запись, Результат)

	// Хвост ВыполнитьКомандуНаСервереСКэшированием: маркер _anon_schema_forced и учет
	// токенов кэша расширений. Синхронный путь проходит его всегда, фоновый обязан тоже,
	// иначе наружу уходят служебные поля mcp_cache_*, а кэш расширений не обновляется.
	Результат = ЗавершитьКомандуНаСервереСКэшированием(Результат, Запись.Подготовка);

	// _cmd_arguments_json НЕ выставляем здесь: для mcp его ставит ЗавершитьToolsCall,
	// а REST-хвост его не ставил и раньше. Двойная вставка изменила бы поведение.
	ДобавитьВЛог("Результат фонового задания получен" + Символы.ПС + ПолучитьТекстРезультата(Результат));

	Если Запись.Режим = "rest" Тогда
		Ответ = ЗавершитьRESTЗапрос(Результат, Запись.ИмяИнструмента, Запись.Команда, Запись.ДанныеЗапроса);
		Если Ответ <> Неопределено Тогда
			КомпонентаSendResponse(Запись.ДанныеЗапроса.id, Ответ.КодОтвета, ЗаголовкиJSON(), Ответ.Тело);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ТулКолРез = ЗавершитьToolsCall(Результат, Запись.ИмяИнструмента, Запись.Аргументы,
		Запись.Команда, Запись.ДанныеЗапроса, Запись.Ид, Запись.ИдПотокаSSE);
	Если ТулКолРез = Неопределено Тогда
		Возврат; // хвост ушел в свою async-ветку и отправит ответ сам
	КонецЕсли;

	ОтветJSON = СформироватьJSONRPCОтвет(Запись.Ид, ТулКолРез);
	Если ЗначениеЗаполнено(Запись.ИдПотокаSSE) Тогда
		КомпонентаSendSSEEvent(Запись.ИдПотокаSSE, ОтветJSON, "{}", "message");
	Иначе
		ОтправитьSSEОтвет(Запись.ДанныеЗапроса, ОтветJSON);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеJsonToToonREST(РезВызова, ПарВызова, ДопПар) Экспорт
	// ДопПар = Структура("ДанныеЗапроса, Результат", ...)
	Если ЗначениеЗаполнено(РезВызова) Тогда
		ДопПар.Результат.data = РезВызова;
	КонецЕсли;
	ДопПар.Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(ДопПар.Результат);
	КомпонентаSendResponse(ДопПар.ДанныеЗапроса.id, 200,
		ЗаголовкиJSON(), ЗаписатьJSON2(ДопПар.Результат));
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовкиJSON()
	Возврат "{""Content-Type"":""application/json""}";
КонецФункции

&НаКлиенте
Функция СформироватьSSEЗаголовки(ДанныеЗапроса, ИдСессииДляЗаголовка = Неопределено, ЗакрытьСоединение = Ложь)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Cache-Control", "no-cache, no-transform");
	Заголовки.Вставить("Connection", ?(ЗакрытьСоединение, "close", "keep-alive"));

	// Источник mcp-session-id
	Если ИдСессииДляЗаголовка <> Неопределено Тогда
		Заголовки.Вставить("mcp-session-id", ИдСессииДляЗаголовка);
	Иначе
		ИдСессии = ДанныеЗапроса.headers["mcp-session-id"];
		Если ИдСессии <> Неопределено Тогда
			Заголовки.Вставить("mcp-session-id", ИдСессии);
		КонецЕсли;
	КонецЕсли;

	Возврат ЗаписатьJSON2(Заголовки);

КонецФункции

&НаКлиенте
Процедура ОтправитьSSEОтвет(ДанныеЗапроса, ОтветJSON, ИдСессииДляЗаголовка = Неопределено)
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		// CloseSSEStream вызывается в колбэке — гарантированный порядок
		Компонента.НачатьВызовSendSSEEvent(
			Новый ОписаниеОповещения("ПослеОтправкиSSEОтвета", ЭтаФорма, ДанныеЗапроса.id),
			ДанныеЗапроса.id, ОтветJSON,
			СформироватьSSEЗаголовки(ДанныеЗапроса, ИдСессииДляЗаголовка), "message");
	Иначе
		Компонента.SendSSEEvent(ДанныеЗапроса.id, ОтветJSON,
			СформироватьSSEЗаголовки(ДанныеЗапроса, ИдСессииДляЗаголовка));
		Компонента.CloseSSEStream(ДанныеЗапроса.id);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиSSEОтвета(РезВызова, ПарВызова, ДопПар) Экспорт
	КомпонентаCloseSSEStream(ДопПар); // ДопПар = ДанныеЗапроса.id
КонецПроцедуры

&НаКлиенте
Функция СформироватьОтветHealth()
	Ответ = Новый Структура;
	Ответ.Вставить("status", "healthy");
	Ответ.Вставить("mode", "native");
	Ответ.Вставить("port", ПортВстроенногоСервера);
	Возврат ЗаписатьJSON2(Ответ);
КонецФункции

&НаКлиенте
Функция СформироватьJSONRPCОтвет(Идентификатор, Результат)
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("result", Результат);
	Возврат ЗаписатьJSON2(Ответ);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьJSONRPCОшибку(Идентификатор, КодОшибки, Сообщение)
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Новый Структура("code, message", КодОшибки, Сообщение));
	Возврат ЗаписатьJSON2(Ответ, Истина);
КонецФункции

// ─────────────────────────────────────────────────────────────────────────────────
// REGEX-АНОНИМИЗАЦИЯ (нативная компонента PCRE2)
// ─────────────────────────────────────────────────────────────────────────────────

// ─── Загрузка компоненты ────────────────────────────────────────────────────────

&НаКлиенте
Процедура ПодключитьКомпонентуRegexСинхронно()
	Попытка
		// Попытка 1: по строке макета
		Если НЕ ПодключитьВнешнююКомпоненту(
				"ВнешняяОбработка.MCPToolkit.Макет.RegexHelper",
				"RegexH", ТипВнешнейКомпоненты.Native) Тогда
			// Попытка 2: через temp-файл
			ДвоичныеДанные = ПолучитьМакетRegexКомпонентыНаСервере();
			ВремФайл = ПолучитьИмяВременногоФайла("dll");
			ДвоичныеДанные.Записать(ВремФайл);
			ПодключитьВнешнююКомпоненту(ВремФайл, "RegexH", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		КомпонентаRegex = Новый("AddIn.RegexH.RegexHelper");
	Исключение
		КомпонентаRegex = Неопределено;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьRegexФазу(РегексКонтекст)
	// Fast-path: нет текстов для обработки → сразу продолжить
	Если НЕ РегексКонтекст.ЕстьТекстыДляRegex Тогда
		ПродолжитьПослеRegex(РегексКонтекст);
		Возврат;
	КонецЕсли;
	Если КомпонентаRegexНедоступна = Истина Тогда
		ПродолжитьПослеRegex(РегексКонтекст);
		Возврат;
	КонецЕсли;
	Если КомпонентаRegex <> Неопределено Тогда
		ВызватьRegexКомпоненту(РегексКонтекст);
		Возврат;
	КонецЕсли;
	// Нужна загрузка — только async (эта процедура вызывается только из async-пути)
	НачатьАсинхронноеПодключениеКомпоненты(
		Новый ОписаниеОповещения("ПослеПодключенияМакетаRegex", ЭтаФорма, РегексКонтекст),
		"ВнешняяОбработка.MCPToolkit.Макет.RegexHelper", "RegexH");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияМакетаRegex(Подключено, ДопПар) Экспорт // ДопПар = РегексКонтекст
	Если Подключено Тогда
		Попытка
			КомпонентаRegex = Новый("AddIn.RegexH.RegexHelper");
			ВызватьRegexКомпоненту(ДопПар);
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Fallback через temp-файл
	Попытка
		ДвоичныеДанные = ПолучитьМакетRegexКомпонентыНаСервере();
		ВремФайл = ПолучитьИмяВременногоФайла("dll");
		ДвоичныеДанные.Записать(ВремФайл);
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияФайлаRegex", ЭтаФорма, ДопПар),
			ВремФайл, "RegexH");
	Исключение
		ПродолжитьПослеRegex(ДопПар);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияФайлаRegex(Подключено, ДопПар) Экспорт // ДопПар = РегексКонтекст
	Если Подключено Тогда
		Попытка
			КомпонентаRegex = Новый("AddIn.RegexH.RegexHelper");
			ВызватьRegexКомпоненту(ДопПар);
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;
	КомпонентаRegexНедоступна = Истина;
	ПродолжитьПослеRegex(ДопПар);
КонецПроцедуры

&НаКлиенте
Процедура ВызватьRegexКомпоненту(РегексКонтекст)
	КомпонентаRegex.НачатьВызовFindMatchesInTexts(
		Новый ОписаниеОповещения("ПослеRegexАнонимизации", ЭтаФорма, РегексКонтекст),
		РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
КонецПроцедуры

&НаКлиенте
Процедура ПослеRegexАнонимизации(СовпаденияJSON, ПарВызова, РегексКонтекст) Экспорт
	Попытка
		ЭтоОбъект = Ложь;
		РегексКонтекст.Свойство("ЭтоОбъект", ЭтоОбъект);
		ЭтоFindReferences = Ложь;
		РегексКонтекст.Свойство("ЭтоFindReferences", ЭтоFindReferences);
		ЭтоGetEventLog = Ложь;
		РегексКонтекст.Свойство("ЭтоGetEventLog", ЭтоGetEventLog);
		ЭтоExecuteCode = Ложь;
		РегексКонтекст.Свойство("ЭтоExecuteCode", ЭтоExecuteCode);
		Если ЭтоGetEventLog Тогда
			ПрименитьRegexТокеныGetEventLog(РегексКонтекст, СовпаденияJSON);
		ИначеЕсли ЭтоFindReferences Тогда
			ПрименитьRegexТокеныFindReferences(РегексКонтекст, СовпаденияJSON);
		ИначеЕсли ЭтоОбъект Тогда
			ПрименитьRegexТокеныОбъект(РегексКонтекст, СовпаденияJSON);
		ИначеЕсли ЭтоExecuteCode Тогда
			ПрименитьRegexТокеныExecuteCode(РегексКонтекст, СовпаденияJSON);
		Иначе
			ПрименитьRegexТокены(РегексКонтекст, СовпаденияJSON);
		КонецЕсли;
	Исключение
	КонецПопытки;
	ПродолжитьПослеRegex(РегексКонтекст);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеRegex(РегексКонтекст)
	ОбновитьТаблицуМаппинговВстроенный(); // ПОСЛЕ regex-токенов

	КонтекстLineage = Неопределено;
	РегексКонтекст.Свойство("КонтекстLineage", КонтекстLineage);
	Если КонтекстLineage = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПродолжитьПослеRegexБезКонтекста(КонтекстLineage);
КонецПроцедуры

&НаСервере
Функция ПолучитьМакетRegexКомпонентыНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьМакет("RegexHelper");
КонецФункции

// ─── Хранение regex-правил ──────────────────────────────────────────────────────

&НаКлиенте
Функция ПолучитьRegexПравилаИзХранилища()
	Если КэшRegexПравил <> Неопределено Тогда
		Возврат КэшRegexПравил;
	КонецЕсли;

	СохранённыеПравила = ПолучитьRegexПравилаИзХранилищаНаСервере();
	Если СохранённыеПравила <> Неопределено И ТипЗнч(СохранённыеПравила) = Тип("Массив") Тогда
		КэшRegexПравил = СохранённыеПравила;
	Иначе
		КэшRegexПравил = ПолучитьRegexПравилаПоУмолчанию();
	КонецЕсли;
	Возврат КэшRegexПравил;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьRegexПравилаИзХранилищаНаСервере()
	Попытка
		ЗначениеJSON = ХранилищеОбщихНастроек.Загрузить("ExecuteQueryRegexRules.v1", "rules");
		Если ЗначениеJSON <> Неопределено И НЕ ПустаяСтрока(ЗначениеJSON) Тогда
			Данные = ПрочитатьJSON2(ЗначениеJSON);
			МассивПравил = Неопределено;
			Если ТипЗнч(Данные) = Тип("Структура") Тогда
				Данные.Свойство("rules", МассивПравил);
			ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
				МассивПравил = Данные["rules"];
			КонецЕсли;
			Если ТипЗнч(МассивПравил) = Тип("Массив") Тогда
				Возврат МассивПравил;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура СохранитьRegexПравилаВХранилище(Правила)
	СохранитьRegexПравилаВХранилищеНаСервере(ЗаписатьJSON2(Новый Структура("version, rules", 1, Правила)));
	КэшRegexПравил = Неопределено;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьRegexПравилаВХранилищеНаСервере(ЗначениеJSON)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("ExecuteQueryRegexRules.v1", "rules", ЗначениеJSON);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьRegexПравилаПоУмолчанию()
	ДанныеПравил = ПолучитьRegexПравилаПоУмолчаниюНаСервере();
	Если ДанныеПравил = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ДанныеПравил;
КонецФункции

&НаСервере
Функция ПолучитьRegexПравилаПоУмолчаниюНаСервере()
	Попытка
		Обработка = РеквизитФормыВЗначение("Объект");
		ДвоичныеДанные = Обработка.ПолучитьМакет("НастройкиRegexПоУмолчанию");
		ИмяФайла = ПолучитьИмяВременногоФайла("json");
		ДвоичныеДанные.Записать(ИмяФайла);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяФайла);
		Данные = ПрочитатьJSON2(ТекстовыйДокумент.ПолучитьТекст());
		ИсхМассив = Неопределено;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Данные.Свойство("rules", ИсхМассив);
		ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
			ИсхМассив = Данные["rules"];
		КонецЕсли;
		Если ТипЗнч(ИсхМассив) = Тип("Массив") Тогда
			МассивПравил = Новый Массив;
			Для Каждого Правило Из ИсхМассив Цикл
				Стр = Новый Структура("enabled, pattern, category, description", Ложь, "", "", "");
				Если ТипЗнч(Правило) = Тип("Структура") Или ТипЗнч(Правило) = Тип("Соответствие") Тогда
					ВклЗнч = Неопределено;
					ПатЗнч = Неопределено;
					КатЗнч = Неопределено;
					ОпиЗнч = Неопределено;
					Если ТипЗнч(Правило) = Тип("Структура") Тогда
						Правило.Свойство("enabled",     ВклЗнч);
						Правило.Свойство("pattern",     ПатЗнч);
						Правило.Свойство("category",    КатЗнч);
						Правило.Свойство("description", ОпиЗнч);
					Иначе
						ВклЗнч = Правило["enabled"];
						ПатЗнч = Правило["pattern"];
						КатЗнч = Правило["category"];
						ОпиЗнч = Правило["description"];
					КонецЕсли;
					Если ВклЗнч <> Неопределено Тогда Стр.enabled     = ВклЗнч; КонецЕсли;
					Если ПатЗнч <> Неопределено Тогда Стр.pattern     = ПатЗнч; КонецЕсли;
					Если КатЗнч <> Неопределено Тогда Стр.category    = КатЗнч; КонецЕсли;
					Если ОпиЗнч <> Неопределено Тогда Стр.description = ОпиЗнч; КонецЕсли;
				КонецЕсли;
				МассивПравил.Добавить(Стр);
			КонецЦикла;
			Возврат МассивПравил;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// ─── Фазы regex-анонимизации ────────────────────────────────────────────────────

&НаКлиенте
Процедура СобратьТекстыДляRegex(Результат, РегексКонтекст)
	// Получить включённые правила
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") И Правило.enabled = Истина Тогда
			ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
		КонецЕсли;
	КонецЦикла;

	Если ВключённыеПравила.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	// Сериализовать включённые правила в JSON
	МассивПравилJSON = Новый Массив;
	Для Каждого П Из ВключённыеПравила Цикл
		МассивПравилJSON.Добавить(Новый Структура("pattern, category", П.pattern, П.category));
	КонецЦикла;
	РегексКонтекст.ВключённыеПравилаJSON = ЗаписатьJSON2(МассивПравилJSON);

	// Собрать тексты из данных результата
	ТекстыМассив  = Новый Массив;
	МаппингИндексов = Новый Массив; // каждый элемент: Структура("СтрокаИндекс, ИмяКолонки, ТипЗначения")

	Данные = Неопределено;
	Если НЕ (ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("data", Данные)
		И ТипЗнч(Данные) = Тип("Массив")) Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	Схема = Неопределено;
	СоответствиеPolicy = Новый Соответствие;
	Если Результат.Свойство("schema", Схема)
		И ТипЗнч(Схема) = Тип("Структура") Тогда
		Колонки = Неопределено;
		Если Схема.Свойство("columns", Колонки) И ТипЗнч(Колонки) = Тип("Массив") Тогда
			Для Каждого Колонка Из Колонки Цикл
				Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				ИмяКолонки = "";
				Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
				Режим       = "default";
				РежимСсылки = "default";
				Колонка.Свойство("anonymization_mode",          Режим);
				Колонка.Свойство("reference_presentation_mode", РежимСсылки);
				СоответствиеPolicy.Вставить(ИмяКолонки,
					Новый Структура("mode, ref_mode", Режим, РежимСсылки));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Для СтрИндекс = 0 По Данные.Количество() - 1 Цикл
		Строка = Данные[СтрИндекс];
		Если ТипЗнч(Строка) <> Тип("Соответствие")
			И ТипЗнч(Строка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Строка) = Тип("Структура") Тогда
			МассивКлючей = Новый Массив;
			Для Каждого КвП Из Строка Цикл
				МассивКлючей.Добавить(КвП.Ключ);
			КонецЦикла;
		Иначе
			МассивКлючей = Новый Массив;
			Для Каждого КвП Из Строка Цикл
				МассивКлючей.Добавить(КвП.Ключ);
			КонецЦикла;
		КонецЕсли;
		Для Каждого ИмяКол Из МассивКлючей Цикл
			PolicyКол = СоответствиеPolicy.Получить(ИмяКол);
			МодКол    = "default";
			РефКол    = "default";
			Если ТипЗнч(PolicyКол) = Тип("Структура") Тогда
				PolicyКол.Свойство("mode",     МодКол);
				PolicyКол.Свойство("ref_mode", РефКол);
			КонецЕсли;
			Если МодКол = "force_keep" Тогда Продолжить; КонецЕсли;
			ЗначениеКолонки = Неопределено;
			Если ТипЗнч(Строка) = Тип("Структура") Тогда
				Если НЕ Строка.Свойство(ИмяКол, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
			Иначе
				ЗначениеКолонки = Строка[ИмяКол];
			КонецЕсли;
			Если ТипЗнч(ЗначениеКолонки) = Тип("Строка") Тогда
				ТекстыМассив.Добавить(ЗначениеКолонки);
				МаппингИндексов.Добавить(Новый Структура("СтрокаИндекс, ИмяКолонки, ТипЗначения",
					СтрИндекс, ИмяКол, "Строка"));
			ИначеЕсли (ТипЗнч(ЗначениеКолонки) = Тип("Структура")
					И ЗначениеКолонки.Свойство("Представление"))
				ИЛИ (ТипЗнч(ЗначениеКолонки) = Тип("Соответствие")
					И ЗначениеКолонки["Представление"] <> Неопределено) Тогда
				// Определить ТипОбъекта для enum-проверки
				ТипОбъектаЗнч = "";
				Если ТипЗнч(ЗначениеКолонки) = Тип("Структура") Тогда
					ЗначениеКолонки.Свойство("ТипОбъекта", ТипОбъектаЗнч);
				Иначе
					ТипОбъектаЗнч = ?(ЗначениеКолонки["ТипОбъекта"] <> Неопределено,
						ЗначениеКолонки["ТипОбъекта"], "");
				КонецЕсли;
				// Enum-ссылки и ref_mode = force_keep не трогаем
				// Планы счетов по умолчанию не анонимизируются, если нет явного force_anonymize
				РазрешеноМенять = НЕ (Найти(ТипОбъектаЗнч, "ПеречислениеСсылка.") = 1)
					И НЕ (Найти(ТипОбъектаЗнч, "ПланСчетовСсылка.") = 1
						И РефКол <> "force_anonymize" И МодКол <> "force_anonymize")
					И НЕ (РефКол = "force_keep");
				ПредставлениеЗнч = ?(ТипЗнч(ЗначениеКолонки) = Тип("Структура"),
					ЗначениеКолонки.Представление,
					ЗначениеКолонки["Представление"]);
				Если РазрешеноМенять И ТипЗнч(ПредставлениеЗнч) = Тип("Строка") Тогда
					ТекстыМассив.Добавить(ПредставлениеЗнч);
					МаппингИндексов.Добавить(Новый Структура("СтрокаИндекс, ИмяКолонки, ТипЗначения",
						СтрИндекс, ИмяКол, "Представление"));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	РегексКонтекст.ТекстыJSON      = ЗаписатьJSON2(ТекстыМассив);
	РегексКонтекст.МаппингИндексов = МаппингИндексов;
	РегексКонтекст.ЕстьТекстыДляRegex = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьRegexТокены(РегексКонтекст, СовпаденияJSON)
	Если НЕ ЗначениеЗаполнено(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	РезСовпадений = Неопределено;
	Попытка
		РезСовпадений = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(РезСовпадений) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	МаппингИндексов = РегексКонтекст.МаппингИндексов;
	Данные = РегексКонтекст.Результат.data;

	Для ТекстИнд = 0 По РезСовпадений.Количество() - 1 Цикл
		Если ТекстИнд >= МаппингИндексов.Количество() Тогда Прервать; КонецЕсли;
		ЭлСовпадений = РезСовпадений[ТекстИнд];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИнд];
		СтрИндекс  = МаппингЭлт.СтрокаИндекс;
		ИмяКолонки = МаппингЭлт.ИмяКолонки;
		ТипЗнчения = МаппингЭлт.ТипЗначения;

		Строка = Данные[СтрИндекс];

		ТекущийТекст = Неопределено;
		Если ТипЗнч(Строка) = Тип("Структура") Тогда
			Если НЕ Строка.Свойство(ИмяКолонки, ТекущийТекст) Тогда Продолжить; КонецЕсли;
		ИначеЕсли ТипЗнч(Строка) = Тип("Соответствие") Тогда
			ТекущийТекст = Строка[ИмяКолонки];
		Иначе
			Продолжить;
		КонецЕсли;

		Если ТипЗнчения = "Представление" Тогда
			Если ТипЗнч(ТекущийТекст) = Тип("Структура") И ТекущийТекст.Свойство("Представление") Тогда
				ТекущийТекст = ТекущийТекст.Представление;
			ИначеЕсли ТипЗнч(ТекущийТекст) = Тип("Соответствие") Тогда
				ТекущийТекст = ТекущийТекст["Представление"];
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Тогда Продолжить; КонецЕсли;

		// Совпадения отсортированы по start DESC — применяем справа налево
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = "";
			МатчТекст = "";
			Начало    = 0;
			Длина     = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			// Замена по позиции (0-based start, 1-based 1С Лев/Сред)
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		// Записать обратно
		Если ТипЗнчения = "Представление" Тогда
			// ЗначениеКолонки — Структура/Соответствие с полем "Представление"
			ЗначениеКолонки2 = Неопределено;
			Если ТипЗнч(Строка) = Тип("Структура") Тогда
				Строка.Свойство(ИмяКолонки, ЗначениеКолонки2);
				Если ТипЗнч(ЗначениеКолонки2) = Тип("Структура") Тогда
					ЗначениеКолонки2.Вставить("Представление", НовыйТекст);
				КонецЕсли;
			Иначе
				ЗначениеКолонки2 = Строка[ИмяКолонки];
				Если ТипЗнч(ЗначениеКолонки2) = Тип("Структура") Тогда
					ЗначениеКолонки2.Вставить("Представление", НовыйТекст);
				ИначеЕсли ТипЗнч(ЗначениеКолонки2) = Тип("Соответствие") Тогда
					ЗначениеКолонки2["Представление"] = НовыйТекст;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Строка) = Тип("Структура") Тогда
			Строка.Вставить(ИмяКолонки, НовыйТекст);
		Иначе
			Строка[ИмяКолонки] = НовыйТекст;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СобратьТекстыДляRegexОбъект(Результат, РегексКонтекст)
	// Получить включённые правила
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") И Правило.enabled = Истина Тогда
			ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
		КонецЕсли;
	КонецЦикла;
	Если ВключённыеПравила.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;
	МассивПравилJSON = Новый Массив;
	Для Каждого П Из ВключённыеПравила Цикл
		МассивПравилJSON.Добавить(Новый Структура("pattern, category", П.pattern, П.category));
	КонецЦикла;
	РегексКонтекст.ВключённыеПравилаJSON = ЗаписатьJSON2(МассивПравилJSON);

	Данные = Неопределено;
	Если НЕ (ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("data", Данные)
		И ТипЗнч(Данные) = Тип("Структура")) Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	Схема = Неопределено;
	Если НЕ (Результат.Свойство("schema", Схема) И ТипЗнч(Схема) = Тип("Структура")) Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	// Строим СоответствиеPolicy для основных полей
	СоответствиеPolicy = Новый Соответствие;
	Колонки = Неопределено;
	Если Схема.Свойство("columns", Колонки) И ТипЗнч(Колонки) = Тип("Массив") Тогда
		Для Каждого Колонка Из Колонки Цикл
			Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
			ИмяКолРег = "";
			Если НЕ Колонка.Свойство("name", ИмяКолРег) Тогда Продолжить; КонецЕсли;
			МодРег = "default"; РефРег = "default";
			Колонка.Свойство("anonymization_mode",          МодРег);
			Колонка.Свойство("reference_presentation_mode", РефРег);
			СоответствиеPolicy.Вставить(ИмяКолРег, Новый Структура("mode, ref_mode", МодРег, РефРег));
		КонецЦикла;
	КонецЕсли;

	// Строим СоответствиеPolicyТЧ: имя ТЧ → СоответствиеPolicy колонок ТЧ
	СоответствиеPolicyТЧ = Новый Соответствие;
	ТабЧасти = Неопределено;
	Если Схема.Свойство("tabular_sections", ТабЧасти) И ТипЗнч(ТабЧасти) = Тип("Соответствие") Тогда
		Для Каждого КВПТЧ Из ТабЧасти Цикл
			СхемаТЧ = КВПТЧ.Значение;
			PolicyТЧМп = Новый Соответствие;
			Если ТипЗнч(СхемаТЧ) = Тип("Структура") Тогда
				КолонкиТЧ = Неопределено;
				Если СхемаТЧ.Свойство("columns", КолонкиТЧ) И ТипЗнч(КолонкиТЧ) = Тип("Массив") Тогда
					Для Каждого КолТЧ Из КолонкиТЧ Цикл
						Если ТипЗнч(КолТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
						ИмяКолТЧРег = "";
						Если НЕ КолТЧ.Свойство("name", ИмяКолТЧРег) Тогда Продолжить; КонецЕсли;
						МодТЧРег = "default"; РефТЧРег = "default";
						КолТЧ.Свойство("anonymization_mode",          МодТЧРег);
						КолТЧ.Свойство("reference_presentation_mode", РефТЧРег);
						PolicyТЧМп.Вставить(ИмяКолТЧРег, Новый Структура("mode, ref_mode", МодТЧРег, РефТЧРег));
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			СоответствиеPolicyТЧ.Вставить(КВПТЧ.Ключ, PolicyТЧМп);
		КонецЦикла;
	КонецЕсли;

	ТекстыМассив    = Новый Массив;
	МаппингИндексов = Новый Массив;

	// Обходим поля data (Структура)
	Для Каждого КВП Из Данные Цикл
		ИмяПоля = КВП.Ключ;
		Значение = КВП.Значение;

		// Проверяем: это ТЧ?
		PolicyТЧ = СоответствиеPolicyТЧ.Получить(ИмяПоля);
		Если PolicyТЧ <> Неопределено И ТипЗнч(Значение) = Тип("Массив") Тогда
			// Обход строк ТЧ
			Для ИндексСтроки = 0 По Значение.Количество() - 1 Цикл
				СтрТЧ = Значение[ИндексСтроки];
				Если ТипЗнч(СтрТЧ) <> Тип("Структура") И ТипЗнч(СтрТЧ) <> Тип("Соответствие") Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого КВПСтр Из СтрТЧ Цикл
					ИмяКолТЧ   = КВПСтр.Ключ;
					ЗначениеТЧ = КВПСтр.Значение;
					PolicyКолТЧ = PolicyТЧ.Получить(ИмяКолТЧ);
					МодТЧ = "default"; РефТЧ = "default";
					Если ТипЗнч(PolicyКолТЧ) = Тип("Структура") Тогда
						PolicyКолТЧ.Свойство("mode",     МодТЧ);
						PolicyКолТЧ.Свойство("ref_mode", РефТЧ);
					КонецЕсли;
					Если МодТЧ = "force_keep" Тогда Продолжить; КонецЕсли;
					Если ТипЗнч(ЗначениеТЧ) = Тип("Строка") Тогда
						ТекстыМассив.Добавить(ЗначениеТЧ);
						МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяТЧ, ИндексСтроки, ИмяКолонки, ТипЗначения",
							"тч", ИмяПоля, ИндексСтроки, ИмяКолТЧ, "Строка"));
					ИначеЕсли (ТипЗнч(ЗначениеТЧ) = Тип("Структура") И ЗначениеТЧ.Свойство("Представление"))
						ИЛИ (ТипЗнч(ЗначениеТЧ) = Тип("Соответствие") И ЗначениеТЧ["Представление"] <> Неопределено) Тогда
						ТипОбъектаТЧ = "";
						Если ТипЗнч(ЗначениеТЧ) = Тип("Структура") Тогда
							ЗначениеТЧ.Свойство("ТипОбъекта", ТипОбъектаТЧ);
						Иначе
							ТипОбъектаТЧ = ?(ЗначениеТЧ["ТипОбъекта"] <> Неопределено, ЗначениеТЧ["ТипОбъекта"], "");
						КонецЕсли;
						РазрешеноТЧ = НЕ (Найти(ТипОбъектаТЧ, "ПеречислениеСсылка.") = 1)
							И НЕ (Найти(ТипОбъектаТЧ, "ПланСчетовСсылка.") = 1
								И РефТЧ <> "force_anonymize" И МодТЧ <> "force_anonymize")
							И НЕ (РефТЧ = "force_keep");
						ПредставлениеТЧ = ?(ТипЗнч(ЗначениеТЧ) = Тип("Структура"),
							ЗначениеТЧ.Представление, ЗначениеТЧ["Представление"]);
						Если РазрешеноТЧ И ТипЗнч(ПредставлениеТЧ) = Тип("Строка") Тогда
							ТекстыМассив.Добавить(ПредставлениеТЧ);
							МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяТЧ, ИндексСтроки, ИмяКолонки, ТипЗначения",
								"тч", ИмяПоля, ИндексСтроки, ИмяКолТЧ, "Представление"));
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		// Обычное поле (не ТЧ)
		PolicyПоля = СоответствиеPolicy.Получить(ИмяПоля);
		МодПоля = "default"; РефПоля = "default";
		Если ТипЗнч(PolicyПоля) = Тип("Структура") Тогда
			PolicyПоля.Свойство("mode",     МодПоля);
			PolicyПоля.Свойство("ref_mode", РефПоля);
		КонецЕсли;
		Если МодПоля = "force_keep" Тогда Продолжить; КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			ТекстыМассив.Добавить(Значение);
			МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ТипЗначения",
				"поле", ИмяПоля, "Строка"));
		ИначеЕсли (ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Представление"))
			ИЛИ (ТипЗнч(Значение) = Тип("Соответствие") И Значение["Представление"] <> Неопределено) Тогда
			ТипОбъектаПоля = "";
			Если ТипЗнч(Значение) = Тип("Структура") Тогда
				Значение.Свойство("ТипОбъекта", ТипОбъектаПоля);
			Иначе
				ТипОбъектаПоля = ?(Значение["ТипОбъекта"] <> Неопределено, Значение["ТипОбъекта"], "");
			КонецЕсли;
			РазрешеноПоле = НЕ (Найти(ТипОбъектаПоля, "ПеречислениеСсылка.") = 1)
				И НЕ (Найти(ТипОбъектаПоля, "ПланСчетовСсылка.") = 1
					И РефПоля <> "force_anonymize" И МодПоля <> "force_anonymize")
				И НЕ (РефПоля = "force_keep");
			ПредставлениеПоля = ?(ТипЗнч(Значение) = Тип("Структура"),
				Значение.Представление, Значение["Представление"]);
			Если РазрешеноПоле И ТипЗнч(ПредставлениеПоля) = Тип("Строка") Тогда
				ТекстыМассив.Добавить(ПредставлениеПоля);
				МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ТипЗначения",
					"поле", ИмяПоля, "Представление"));
			КонецЕсли;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") И МодПоля <> "force_keep" Тогда
			// Реквизит типа ФиксированныйМассив (строки или ссылки)
			Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
				Элт = Значение[ЭлтИнд];
				Если ТипЗнч(Элт) = Тип("Строка") Тогда
					ТекстыМассив.Добавить(Элт);
					МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ИндексЭлемента, ТипЗначения",
						"поле_массив", ИмяПоля, ЭлтИнд, "Строка"));
				ИначеЕсли ТипЗнч(Элт) = Тип("Структура") И Элт.Свойство("Представление") Тогда
					ТипОбъектаЭлт = "";
					Элт.Свойство("ТипОбъекта", ТипОбъектаЭлт);
					РазрешеноЭлт = НЕ (Найти(ТипОбъектаЭлт, "ПеречислениеСсылка.") = 1)
						И НЕ (Найти(ТипОбъектаЭлт, "ПланСчетовСсылка.") = 1
							И РефПоля <> "force_anonymize" И МодПоля <> "force_anonymize")
						И НЕ (РефПоля = "force_keep");
					Если РазрешеноЭлт И ТипЗнч(Элт.Представление) = Тип("Строка") Тогда
						ТекстыМассив.Добавить(Элт.Представление);
						МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ИндексЭлемента, ТипЗначения",
							"поле_массив", ИмяПоля, ЭлтИнд, "Представление"));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	РегексКонтекст.ТекстыJSON         = ЗаписатьJSON2(ТекстыМассив);
	РегексКонтекст.МаппингИндексов    = МаппингИндексов;
	РегексКонтекст.ЕстьТекстыДляRegex = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьRegexТокеныОбъект(РегексКонтекст, СовпаденияJSON)
	Если НЕ ЗначениеЗаполнено(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	РезСовпадений = Неопределено;
	Попытка
		РезСовпадений = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(РезСовпадений) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	МаппингИндексов = РегексКонтекст.МаппингИндексов;
	Данные = РегексКонтекст.Результат.data;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Для ТекстИнд = 0 По РезСовпадений.Количество() - 1 Цикл
		Если ТекстИнд >= МаппингИндексов.Количество() Тогда Прервать; КонецЕсли;
		ЭлСовпадений = РезСовпадений[ТекстИнд];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИнд];
		Уровень    = "";
		МаппингЭлт.Свойство("Уровень", Уровень);
		ТипЗнчения = МаппингЭлт.ТипЗначения;

		// Получить текущее текстовое значение
		ТекущийТекст = Неопределено;
		Если Уровень = "поле" Тогда
			ЗначениеПоля = Неопределено;
			Если НЕ Данные.Свойство(МаппингЭлт.ИмяПоля, ЗначениеПоля) Тогда Продолжить; КонецЕсли;
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(ЗначениеПоля) = Тип("Структура") И ЗначениеПоля.Свойство("Представление") Тогда
					ТекущийТекст = ЗначениеПоля.Представление;
				ИначеЕсли ТипЗнч(ЗначениеПоля) = Тип("Соответствие") Тогда
					ТекущийТекст = ЗначениеПоля["Представление"];
				КонецЕсли;
			Иначе
				Если ТипЗнч(ЗначениеПоля) = Тип("Строка") Тогда
					ТекущийТекст = ЗначениеПоля;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Уровень = "тч" Тогда
			МассивТЧ = Неопределено;
			Если НЕ Данные.Свойство(МаппингЭлт.ИмяТЧ, МассивТЧ) Тогда Продолжить; КонецЕсли;
			Если ТипЗнч(МассивТЧ) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексСтроки >= МассивТЧ.Количество() Тогда Продолжить; КонецЕсли;
			СтрокаТЧ = МассивТЧ[МаппингЭлт.ИндексСтроки];
			Если ТипЗнч(СтрокаТЧ) = Тип("Структура") Тогда
				ЗначениеТЧ = Неопределено;
				Если НЕ СтрокаТЧ.Свойство(МаппингЭлт.ИмяКолонки, ЗначениеТЧ) Тогда Продолжить; КонецЕсли;
			ИначеЕсли ТипЗнч(СтрокаТЧ) = Тип("Соответствие") Тогда
				ЗначениеТЧ = СтрокаТЧ[МаппингЭлт.ИмяКолонки];
			Иначе
				Продолжить;
			КонецЕсли;
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(ЗначениеТЧ) = Тип("Структура") И ЗначениеТЧ.Свойство("Представление") Тогда
					ТекущийТекст = ЗначениеТЧ.Представление;
				ИначеЕсли ТипЗнч(ЗначениеТЧ) = Тип("Соответствие") Тогда
					ТекущийТекст = ЗначениеТЧ["Представление"];
				КонецЕсли;
			Иначе
				Если ТипЗнч(ЗначениеТЧ) = Тип("Строка") Тогда
					ТекущийТекст = ЗначениеТЧ;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Уровень = "поле_массив" Тогда
			МассивПоля = Неопределено;
			Если НЕ Данные.Свойство(МаппингЭлт.ИмяПоля, МассивПоля) Тогда Продолжить; КонецЕсли;
			Если ТипЗнч(МассивПоля) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексЭлемента >= МассивПоля.Количество() Тогда Продолжить; КонецЕсли;
			Элт = МассивПоля[МаппингЭлт.ИндексЭлемента];
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(Элт) = Тип("Структура") И Элт.Свойство("Представление") Тогда
					ТекущийТекст = Элт.Представление;
				КонецЕсли;
			Иначе
				Если ТипЗнч(Элт) = Тип("Строка") Тогда ТекущийТекст = Элт; КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Тогда Продолжить; КонецЕсли;

		// Применяем совпадения справа налево
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = ""; МатчТекст = ""; Начало = 0; Длина = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		// Записать обратно в объект
		Если Уровень = "поле" Тогда
			Если ТипЗнчения = "Представление" Тогда
				ЗначениеПоля2 = Неопределено;
				Данные.Свойство(МаппингЭлт.ИмяПоля, ЗначениеПоля2);
				Если ТипЗнч(ЗначениеПоля2) = Тип("Структура") Тогда
					ЗначениеПоля2.Вставить("Представление", НовыйТекст);
				ИначеЕсли ТипЗнч(ЗначениеПоля2) = Тип("Соответствие") Тогда
					ЗначениеПоля2["Представление"] = НовыйТекст;
				КонецЕсли;
			Иначе
				Данные.Вставить(МаппингЭлт.ИмяПоля, НовыйТекст);
			КонецЕсли;
		ИначеЕсли Уровень = "тч" Тогда
			МассивТЧОбр = Неопределено;
			Данные.Свойство(МаппингЭлт.ИмяТЧ, МассивТЧОбр);
			Если ТипЗнч(МассивТЧОбр) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексСтроки >= МассивТЧОбр.Количество() Тогда Продолжить; КонецЕсли;
			СтрокаТЧОбр = МассивТЧОбр[МаппингЭлт.ИндексСтроки];
			Если ТипЗнчения = "Представление" Тогда
				ЗначениеТЧОбр = Неопределено;
				Если ТипЗнч(СтрокаТЧОбр) = Тип("Структура") Тогда
					СтрокаТЧОбр.Свойство(МаппингЭлт.ИмяКолонки, ЗначениеТЧОбр);
					Если ТипЗнч(ЗначениеТЧОбр) = Тип("Структура") Тогда
						ЗначениеТЧОбр.Вставить("Представление", НовыйТекст);
					КонецЕсли;
				ИначеЕсли ТипЗнч(СтрокаТЧОбр) = Тип("Соответствие") Тогда
					ЗначениеТЧОбр = СтрокаТЧОбр[МаппингЭлт.ИмяКолонки];
					Если ТипЗнч(ЗначениеТЧОбр) = Тип("Структура") Тогда
						ЗначениеТЧОбр.Вставить("Представление", НовыйТекст);
					ИначеЕсли ТипЗнч(ЗначениеТЧОбр) = Тип("Соответствие") Тогда
						ЗначениеТЧОбр["Представление"] = НовыйТекст;
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если ТипЗнч(СтрокаТЧОбр) = Тип("Структура") Тогда
					СтрокаТЧОбр.Вставить(МаппингЭлт.ИмяКолонки, НовыйТекст);
				ИначеЕсли ТипЗнч(СтрокаТЧОбр) = Тип("Соответствие") Тогда
					СтрокаТЧОбр[МаппингЭлт.ИмяКолонки] = НовыйТекст;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Уровень = "поле_массив" Тогда
			МассивПоляОбр = Неопределено;
			Данные.Свойство(МаппингЭлт.ИмяПоля, МассивПоляОбр);
			Если ТипЗнч(МассивПоляОбр) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексЭлемента >= МассивПоляОбр.Количество() Тогда Продолжить; КонецЕсли;
			ЭлтОбр = МассивПоляОбр[МаппингЭлт.ИндексЭлемента];
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(ЭлтОбр) = Тип("Структура") И ЭлтОбр.Свойство("Представление") Тогда
					ЭлтОбр.Вставить("Представление", НовыйТекст);
				КонецЕсли;
			Иначе
				МассивПоляОбр[МаппингЭлт.ИндексЭлемента] = НовыйТекст;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
