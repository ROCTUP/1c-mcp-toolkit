	Описание.Вставить("ВсегоТипов", Неопределено);
	Описание.Вставить("ПоказаноТипов", Неопределено);
	Описание.Вставить("ТекстОшибки", Набор.ТекстОшибки);

	Если НЕ ПустаяСтрока(Набор.ТекстОшибки) Тогда
		Возврат Описание;
	КонецЕсли;

	ВсегоТипов = Набор.Вектор.Количество();
	Описание.ВсегоТипов = ВсегоТипов;

	Если ВсегоТипов = 0 Тогда
		Описание.ПоказаноТипов = 0;
		Возврат Описание;
	КонецЕсли;

	Если ВсегоТипов <= 20 Тогда
		МассивПредставлений = Новый Массив;
		Для Каждого ЭлементВектора Из Набор.Вектор Цикл
			МассивПредставлений.Добавить(ЭлементВектора.Представление);
