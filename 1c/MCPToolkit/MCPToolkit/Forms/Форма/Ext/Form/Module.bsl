// Сбрасывает только response-контекст (ids, ДанныеЗапроса, флаг REST).
// НЕ трогает ПерезапускВОжидании — guard должен оставаться активным до завершения temp cleanup.
// НЕ трогает temp-file paths — их обнуляет ПроверитьСигналПерезапуска.
// Только для error/timeout/failed paths, где старая сессия продолжает работать.
&НаКлиенте
Процедура СброситьОтветныйКонтекстПерезапуска()
	ЭтоRESTЗапросПерезапуска            = Ложь;
	ИдКомандыПерезапуска                = "";
	ДанныеЗапросаПерезапуска            = Неопределено;
	ИдЗапросаПерезапуска                = "";
	ИдПотокаПерезапуска                = "";
	ИдRESTЗапросаПерезапуска           = "";
	ТаймаутПерезапуска                  = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПерезапускСессии(КомандаИД, ДанныеЗапросаEmb = Неопределено, ИдЗапросаEmb = "", ИдПотокаEmb = "", ВызовИзREST = Ложь)

	// Защита от повторного вызова или активного close
	Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
		Если РежимПодключения = 0 Тогда
			ОтправитьРезультатНаСервер(АдресСервера, КомандаИД,
				Новый Структура("success,error", Ложь, "Restart or close already in progress"));
		Иначе
			Сод = Новый Массив;
			Сод.Добавить(Новый Структура("type,text", "text", "Error: Restart or close already in progress"));
			ОтвJSON = СформироватьJSONRPCОтвет(ИдЗапросаEmb,
				Новый Структура("content,isError", Сод, Истина));
			Если ПустаяСтрока(ИдПотокаEmb) Тогда
				ОтправитьSSEОтвет(ДанныеЗапросаEmb, ОтвJSON);
			Иначе
				КомпонентаSendSSEEvent(ИдПотокаEmb, ОтвJSON, "{}", "message");
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Сохраняем контекст — режим вызова АТОМАРНО с остальным контекстом,
	// до любых операций которые могут бросить исключение
	ЭтоRESTЗапросПерезапуска    = ВызовИзREST;
	ИдКомандыПерезапуска        = КомандаИД;
	ДанныеЗапросаПерезапуска    = ДанныеЗапросаEmb;
	ИдЗапросаПерезапуска        = ИдЗапросаEmb;
	ИдПотокаПерезапуска         = ИдПотокаEmb;
	// Кэшируем REST request id для безопасного повторного доступа.
	// Попытка — ДанныеЗапросаEmb может не иметь поля id (embedded SSE путь).
	ИдRESTЗапросаПерезапуска = "";
	Если ВызовИзREST Тогда
		Попытка
			Если ДанныеЗапросаEmb <> Неопределено Тогда
				ИдRESTЗапросаПерезапуска = Строка(ДанныеЗапросаEmb.id);
			КонецЕсли;
		Исключение
			ИдRESTЗапросаПерезапуска = "";
		КонецПопытки;
	КонецЕсли;

	// Проверка ОС для Windows-auth
	СисИнфо    = Новый СистемнаяИнформация();
	ЭтоWindows = СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86
		Или СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86_64;
	Если РежимАутентификацииПерезапуска = 0 И НЕ ЭтоWindows Тогда
		ОтправитьОтветПерезапуска(Ложь, "Windows authentication is not available on the current OS");
		Возврат;
	КонецЕсли;

	// Серверная валидация
	ОшибкаВалидации = ПроверитьНастройкиПерезапускаНаСервере(
		РежимАутентификацииПерезапуска,
		ЗначениеЗаполнено(ПарольПерезапуска));
	Если ОшибкаВалидации <> "" Тогда
		ОтправитьОтветПерезапуска(Ложь, ОшибкаВалидации);
		Возврат;
	КонецЕсли;

	// Проверка пути к обработке
	ПутьОбработки = ПолучитьПутьКОбработкеНаСервере();
	Если НЕ ЗначениеЗаполнено(ПутьОбработки) Тогда
		ОтправитьОтветПерезапуска(Ложь, "Cannot restart: data processor path is not available (not running from file?)");
		Возврат;
	КонецЕсли;
	ФайлОбработкиПроверка = Новый Файл(ПутьОбработки);
	Если НЕ ФайлОбработкиПроверка.Существует() Тогда
		ОтправитьОтветПерезапуска(Ложь, "Cannot restart: data processor file not found: " + ПутьОбработки);
		Возврат;
	КонецЕсли;

	// Фаза 1: подготовка + запуск
	ПутьМаппингов  = "";
	ПутьНонса      = "";
	ФайлПараметров = "";
	ПутьСигнала    = "";
	ПутьClaimed    = "";
	Попытка

		ПутьМаппингов  = СохранитьМаппингиАнонимизацииВоВременныйФайл();
		ПутьСигнала    = ПолучитьИмяВременногоФайла("tmp");
		ПутьНонса      = ПолучитьИмяВременногоФайла("nonce");
		ФайлПараметров = ПолучитьИмяВременногоФайла("json");
		ПутьClaimed    = ПолучитьИмяВременногоФайла("claimed");

		ЗТ = Новый ЗаписьТекста(ПутьНонса, КодировкаТекста.UTF8);
		ЗТ.ЗаписатьСтроку("valid");
		ЗТ.Закрыть();

		МСПМассив = Новый Массив;
		Если РежимПодключения = 1 И МСПСессии <> Неопределено Тогда
			Для Каждого П Из МСПСессии Цикл
				МСПМассив.Добавить(П.Ключ);
			КонецЦикла;
		КонецЕсли;

		ЗашифрованныйПароль = ЗашифроватьПарольПерезапуска(
			?(РежимАутентификацииПерезапуска = 1, ПарольПерезапуска, ""));

		ПараметрыЗапуска = Новый Структура("signal_path,mappings_path,mcp_sessions,nonce_path,claimed_path,restart_password,danger_auto_write,danger_auto_priv,danger_confirm",
			ПутьСигнала, ПутьМаппингов, МСПМассив, ПутьНонса, ПутьClaimed, ЗашифрованныйПароль,
			АвтоРазрешитьЗаписать, АвтоРазрешитьПривилегированныйРежим, РазрешатьОпасныеОперацииСПодтверждением);
		ЗТПарам = Новый ЗаписьТекста(ФайлПараметров, КодировкаТекста.UTF8);
		Попытка
			ЗТПарам.Записать(ЗаписатьJSON2(ПараметрыЗапуска));
		Исключение
			Попытка ЗТПарам.Закрыть(); Исключение КонецПопытки;
			ВызватьИсключение;
		КонецПопытки;
		ЗТПарам.Закрыть();

		#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
			ИмяExe = "1cv8" + ?(ЭтоWindows, ".exe", "");
		#ИначеЕсли ТонкийКлиент Тогда
			ИмяExe = "1cv8c" + ?(ЭтоWindows, ".exe", "");
		#КонецЕсли

		ПутьExe  = КаталогПрограммы() + ИмяExe;
		СтрСоед  = СтрокаСоединенияИнформационнойБазы();
		ИмяПольз = ПолучитьИмяТекущегоПользователяНаСервере();

		СтрСоедЭкр = СтрЗаменить(СтрСоед, """", """""");

		МеткаВремени = Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
		КомандаЗапуска = """" + ПутьExe + """ ENTERPRISE"
			+ " /IBConnectionString """ + СтрСоедЭкр + """"
			+ " /Execute """            + ПутьОбработки + """"
			+ " /C ""autostart;"        + МеткаВремени + ";" + ФайлПараметров + """";

		Если РежимАутентификацииПерезапуска = 0 Тогда
			КомандаЗапуска = КомандаЗапуска + " /WA";
		Иначе
			ИмяЭкр = СтрЗаменить(ИмяПольз, """", """""");
			КомандаЗапуска = КомандаЗапуска + " /N """ + ИмяЭкр + """";
			Если ЗначениеЗаполнено(ПарольПерезапуска) Тогда
				ПарольЭкр = СтрЗаменить(ПарольПерезапуска, """", """""");
				КомандаЗапуска = КомандаЗапуска + " /P """ + ПарольЭкр + """";
			КонецЕсли;
		КонецЕсли;

		ЗапуститьПриложение(КомандаЗапуска);

	Исключение
		Попытка УдалитьФайлы(ФайлПараметров); Исключение КонецПопытки;
		Попытка УдалитьФайлы(ПутьМаппингов);  Исключение КонецПопытки;
		Попытка УдалитьФайлы(ПутьНонса);      Исключение КонецПопытки;
		Попытка УдалитьФайлы(ПутьClaimed);    Исключение КонецПопытки;
		ОтправитьОтветПерезапуска(Ложь, "Failed to launch new session: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Фаза 2: пост-запуск
	ПутьФайлаСигналаПерезапуска    = ПутьСигнала;
	ПутьФайлаПараметровПерезапуска = ФайлПараметров;
	ПутьНонсаПерезапуска           = ПутьНонса;
	ПутьФайлаМаппинговПерезапуска  = ПутьМаппингов;
	ПутьКлеймаПерезапуска          = ПутьClaimed;
	ТаймаутПерезапуска             = ТекущаяДата() + 120;
	ПерезапускВОжидании            = Истина;

	Попытка ОтключитьОбработчикОжидания("ЦиклОпроса"); Исключение КонецПопытки;
	ПодключитьОбработчикОжидания("ПроверитьСигналПерезапуска", 3);

КонецПроцедуры

&НаКлиенте
Функция ОтправитьОтветПерезапуска(Успех, Сообщение)
	Если РежимПодключения = 0 Тогда
		Результат = Новый Структура("success", Успех);
		Если Успех Тогда
			Результат.Вставить("data", Сообщение);
		Иначе
			Результат.Вставить("error", Сообщение);
		КонецЕсли;
		Попытка
			РезОтправки = ОтправитьРезультатНаСервер(АдресСервера, ИдКомандыПерезапуска, Результат);
			Если НЕ РезОтправки.Успех Тогда
				РезОтправки = ОтправитьРезультатНаСервер(АдресСервера, ИдКомандыПерезапуска, Результат);
			КонецЕсли;
			Возврат РезОтправки.Успех;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	Иначе
		Если ЭтоRESTЗапросПерезапуска Тогда
			// Success для REST не должен сюда попадать -- callback shutdown через
			// ОтправитьОтветПерезапускаИЗавершитьEmbedded. Если попал -- ошибка контракта,
			// делегируем в callback-path чтобы не оставлять две сессии.
			Если Успех Тогда
				ОтправитьОтветПерезапускаИЗавершитьEmbedded(Сообщение);
				Возврат Истина;
			КонецЕсли;
			// Error: fire-and-forget, сессия продолжает работать.
			// Попытка покрывает и ЗаписатьJSON2 и SendResponse --
			// в любом случае СброситьОтветныйКонтекстПерезапуска выполнится.
			// Используем ИдRESTЗапросаПерезапуска (кэш) вместо ДанныеЗапроса.id.
			Попытка
				Если ИдRESTЗапросаПерезапуска = "" Тогда
					ДобавитьВЛог("restart REST: error response impossible: request id lost");
				Иначе
					РезТело = ЗаписатьJSON2(Новый Структура("success,error", Ложь, Сообщение));
					КомпонентаSendResponse(ИдRESTЗапросаПерезапуска, 500, ЗаголовкиJSON(), РезТело);
				КонецЕсли;
			Исключение
				ДобавитьВЛог("restart REST: error response exception: " + ОписаниеОшибки());
			КонецПопытки;
			СброситьОтветныйКонтекстПерезапуска();
			Возврат Истина;
		КонецЕсли;
		// Embedded SSE (существующий код без изменений)
		ТекстОтвета = ?(Успех, Сообщение, "Error: " + Сообщение);
		Содержимое  = Новый Массив;
		Содержимое.Добавить(Новый Структура("type,text", "text", ТекстОтвета));
		РезультатMCP = Новый Структура("content,isError", Содержимое, НЕ Успех);
		ОтветJSON = СформироватьJSONRPCОтвет(ИдЗапросаПерезапуска, РезультатMCP);
		Если ПустаяСтрока(ИдПотокаПерезапуска) Тогда
			ОтправитьSSEОтвет(ДанныеЗапросаПерезапуска, ОтветJSON);
		Иначе
			КомпонентаSendSSEEvent(ИдПотокаПерезапуска, ОтветJSON, "{}", "message");
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ПроверитьСигналПерезапуска()
	Если НЕ ПерезапускВОжидании Тогда
		ОтключитьОбработчикОжидания("ПроверитьСигналПерезапуска");
		Возврат;
	КонецЕсли;

	Файл = Новый Файл(ПутьФайлаСигналаПерезапуска);
	СигналЗначение = ПрочитатьСигналПерезапуска(ПутьФайлаСигналаПерезапуска);

	Если Файл.Существует() И (СигналЗначение = "ready" Или Лев(СигналЗначение, 7) = "failed:") Тогда
		ОтключитьОбработчикОжидания("ПроверитьСигналПерезапуска");
		УдалитьФайлы(ПутьФайлаСигналаПерезапуска);

		Если СигналЗначение <> "ready" Тогда
			ОтправитьОтветПерезапуска(Ложь, "Restart failed in new session: " + Сред(СигналЗначение, 8));
			Попытка УдалитьФайлы(ПутьКлеймаПерезапуска);           Исключение КонецПопытки;
			ПутьКлеймаПерезапуска = "";
			Попытка УдалитьФайлы(ПутьФайлаМаппинговПерезапуска);   Исключение КонецПопытки;
			ПутьФайлаМаппинговПерезапуска = "";
			Попытка УдалитьФайлы(ПутьНонсаПерезапуска);             Исключение КонецПопытки;
			ПутьНонсаПерезапуска = "";
			Попытка УдалитьФайлы(ПутьФайлаПараметровПерезапуска);   Исключение КонецПопытки;
			ПутьФайлаПараметровПерезапуска = "";
			ПутьФайлаСигналаПерезапуска = "";
			ПерезапускВОжидании = Ложь;
			Если РежимПодключения = 0 Тогда
				ПодключитьОбработчикОжидания("ЦиклОпроса", ИнтервалОпроса, Ложь);
			КонецЕсли;
			Возврат;
		КонецЕсли;

		Если РежимПодключения = 0 Тогда
			ПерезапускВОжидании = Ложь;
			ОтправитьОтветПерезапуска(Истина,
			"Session restarted successfully."
			+ " Note: the first MCP request to the new session may fail - retry once if it does.");
			Попытка УдалитьФайлы(ПутьКлеймаПерезапуска); Исключение КонецПопытки;
			ПутьКлеймаПерезапуска          = "";
			Попытка УдалитьФайлы(ПутьФайлаПараметровПерезапуска); Исключение КонецПопытки;
			ПутьФайлаПараметровПерезапуска = "";
			Попытка УдалитьФайлы(ПутьНонсаПерезапуска); Исключение КонецПопытки;
			ПутьНонсаПерезапуска           = "";
			Попытка УдалитьФайлы(ПутьФайлаМаппинговПерезапуска); Исключение КонецПопытки;
			ПутьФайлаМаппинговПерезапуска  = "";
			Попытка ОтключитьсяОтСервера(); Исключение КонецПопытки;
			ЗавершитьРаботуСистемы(Ложь);
		Иначе
			ОтправитьОтветПерезапускаИЗавершитьEmbedded(
			"Session restarted successfully."
			+ " Note: the first MCP request to the new session may fail - retry once if it does.");
		КонецЕсли;

	ИначеЕсли ТекущаяДата() > ТаймаутПерезапуска Тогда
		ОтключитьОбработчикОжидания("ПроверитьСигналПерезапуска");

		ОтправитьОтветПерезапуска(Ложь, "Restart timeout: new session did not start in 120 seconds");

		Попытка УдалитьФайлы(ПутьНонсаПерезапуска);           Исключение КонецПопытки;
		Попытка УдалитьФайлы(ПутьФайлаПараметровПерезапуска); Исключение КонецПопытки;
		Попытка УдалитьФайлы(ПутьФайлаСигналаПерезапуска);    Исключение КонецПопытки;
		Если ПрочитатьСигналПерезапуска(ПутьКлеймаПерезапуска) <> "1" Тогда
			Попытка УдалитьФайлы(ПутьФайлаМаппинговПерезапуска); Исключение КонецПопытки;
		КонецЕсли;
		Попытка УдалитьФайлы(ПутьКлеймаПерезапуска);          Исключение КонецПопытки;
		ПутьФайлаСигналаПерезапуска    = "";
		ПутьФайлаПараметровПерезапуска = "";
		ПутьНонсаПерезапуска           = "";
		ПутьФайлаМаппинговПерезапуска  = "";
		ПутьКлеймаПерезапуска          = "";
		ПерезапускВОжидании = Ложь;

		Если РежимПодключения = 0 Тогда
			ПодключитьОбработчикОжидания("ЦиклОпроса", ИнтервалОпроса, Ложь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЭкранироватьPSОдинарнаяКавычка(Строка)
	Возврат СтрЗаменить(Строка, "'", "''");
КонецФункции

&НаКлиенте
Функция ЭкранироватьБашОдинарнаяКавычка(Строка)
	Возврат СтрЗаменить(Строка, "'", "'\''");
КонецФункции

&НаКлиенте
Функция СформироватьТекстЛаунчераХолодногоСтарта(ЭтоWindows, ПутьExe, СтрСоед, ПутьОбработки, ПутьПараметров, ИмяПольз, ЗашифрПароль, РежимАутентификации, ПутьСигнала)

	НуженПароль = (РежимАутентификации = 1) И ЗначениеЗаполнено(ЗашифрПароль);

	Если ЭтоWindows Тогда
		ЕPSExe      = ЭкранироватьPSОдинарнаяКавычка(ПутьExe);
		ЕPSПарамс   = ЭкранироватьPSОдинарнаяКавычка(ПутьПараметров);
		ЕPSСигнал   = ЭкранироватьPSОдинарнаяКавычка(ПутьСигнала);

		Если НЕ НуженПароль Тогда
			Текст =
"$paramsPath = '" + ЕPSПарамс + "'" + Символы.ПС
+ "$signalPath = '" + ЕPSСигнал + "'" + Символы.ПС
+ "try {" + Символы.ПС
+ "    $params = ConvertFrom-Json (Get-Content $paramsPath -Raw -Encoding UTF8 -ErrorAction Stop)" + Символы.ПС
+ "} catch {" + Символы.ПС
+ "    Write-Output ""Failed to read params file: $_""" + Символы.ПС
+ "    Remove-Item ($MyInvocation.MyCommand.Path) -Force -ErrorAction SilentlyContinue" + Символы.ПС
+ "    exit 1" + Символы.ПС
+ "}" + Символы.ПС
