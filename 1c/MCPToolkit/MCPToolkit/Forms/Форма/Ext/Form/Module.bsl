			Если КлючСекундыНачала <> ""
			   И КлючСекундыСтроки = КлючСекундыНачала
			   И ПропущеноВСекунде < СмещениеВСекунде Тогда
				ПропущеноВСекунде = ПропущеноВСекунде + 1;
				Продолжить;
			КонецЕсли;

			Если Счетчик >= Лимит Тогда
				Прервать;
			КонецЕсли;

			ЗаписьЖурнала = Новый Структура;
