		Компонента.НачатьВызовCloseSSEStream(
			Новый ОписаниеОповещения("ПослеЗакрытияПотокаПерезапуска", ЭтаФорма),
			РзId);
	Иначе
		Компонента.CloseSSEStream(РзId);
