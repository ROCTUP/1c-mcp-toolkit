// Проверка и решение о восстановлении отделены от транспорта и запуска процесса.
&НаКлиентеНаСервереБезКонтекста
Функция НовоеСостояниеКонтроляСервера()
	Возврат Новый Структура(
		"Статус,ПоследняяПроверка,НачалоИсправнойСвязи,ПодозрениеНаПотерю,ПопыткаИспользована,ОшибкаПерезапуска",
		"unknown", Неопределено, Неопределено, Ложь, Ложь, "");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОшибкаОтсутствияСервернойТочкиВхода(ТекстОшибки, ИмяФункции)
	ТекстНижний = НРег(ТекстОшибки);
	Если Найти(ТекстНижний, "неизвестный идентификатор формы") > 0
		Или Найти(ТекстНижний, "unknown form identifier") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	// Одна фраза "неизвестная функция" может быть ошибкой пользовательского кода.
	ЕстьПризнак = Найти(ТекстНижний, "неизвестная функция") > 0
		Или Найти(ТекстНижний, "неизвестная процедура") > 0
		Или Найти(ТекстНижний, "unknown function") > 0
		Или Найти(ТекстНижний, "unknown procedure") > 0;
	Возврат ЕстьПризнак И Найти(ТекстНижний, НРег(ИмяФункции)) > 0;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УчестьПроверкуСервера(СостояниеПроверки, Успех, НетТочкиВхода, МоментПроверки, ИнтервалПроверки)
	Если Успех Тогда
		// Пауза в наблюдении не считается доказательством непрерывного восстановления.
		Если СостояниеПроверки.НачалоИсправнойСвязи = Неопределено
			Или СостояниеПроверки.ПоследняяПроверка = Неопределено Тогда
			СостояниеПроверки.НачалоИсправнойСвязи = МоментПроверки;
		ИначеЕсли МоментПроверки - СостояниеПроверки.ПоследняяПроверка > Макс(30, ИнтервалПроверки * 2)
			Или МоментПроверки < СостояниеПроверки.ПоследняяПроверка Тогда
			СостояниеПроверки.НачалоИсправнойСвязи = МоментПроверки;
		КонецЕсли;
		СостояниеПроверки.Статус = "ok";
		СостояниеПроверки.ПодозрениеНаПотерю = Ложь;
		Если МоментПроверки - СостояниеПроверки.НачалоИсправнойСвязи >= 600 Тогда
			СостояниеПроверки.ПопыткаИспользована = Ложь;
			СостояниеПроверки.ОшибкаПерезапуска = "";
		КонецЕсли;
	Иначе
		СостояниеПроверки.НачалоИсправнойСвязи = Неопределено;
		Если НетТочкиВхода И СостояниеПроверки.ПодозрениеНаПотерю Тогда
			СостояниеПроверки.Статус = "lost";
		Иначе
			СостояниеПроверки.Статус = "unknown";
		КонецЕсли;
		// Любая неопределённая ошибка прерывает подтверждение потери контекста.
		СостояниеПроверки.ПодозрениеНаПотерю = НетТочкиВхода;
	КонецЕсли;
	СостояниеПроверки.ПоследняяПроверка = МоментПроверки;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НуженАвтоперезапускСервера(СостояниеПроверки, Разрешен, ПерезапускИлиЗакрытие)
	Возврат Разрешен И НЕ ПерезапускИлиЗакрытие
		И СостояниеПроверки.Статус = "lost" И НЕ СостояниеПроверки.ПопыткаИспользована;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СостояниеГотовностиСервера(СостояниеПроверки, МоментПроверки, ИнтервалПроверки, ИдетПерезапуск)
	Возраст = -1;
	СостояниеКонтекста = СостояниеПроверки.Статус;
	Если СостояниеПроверки.ПоследняяПроверка <> Неопределено Тогда
		Возраст = МоментПроверки - СостояниеПроверки.ПоследняяПроверка;
	КонецЕсли;
	Если СостояниеКонтекста = "ok" И (Возраст < 0 Или Возраст > Макс(30, ИнтервалПроверки * 2)) Тогда
		СостояниеКонтекста = "stale";
	КонецЕсли;
	Если ИдетПерезапуск Тогда СостояниеКонтекста = "restarting"; КонецЕсли;
	Готов = СостояниеКонтекста = "ok";
	Возврат Новый Структура("status,ready,server_context,last_check_age_seconds,recovery_attempt_used",
		?(Готов, "healthy", "degraded"), Готов, СостояниеКонтекста, Возраст, СостояниеПроверки.ПопыткаИспользована);
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьСервернуюЧастьНаСервере()
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПолучитьДанныеПерезапускаНаСервере()
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Возврат Новый Структура("ПутьОбработки,ИмяПользователя,ДоступнаWA,ДоступенПароль,ПарольУстановлен",
		РеквизитФормыВЗначение("Объект").ИспользуемоеИмяФайла, ПользовательИБ.Имя,
		ПользовательИБ.АутентификацияОС, ПользовательИБ.АутентификацияСтандартная, ПользовательИБ.ПарольУстановлен);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьДанныеАвтоперезапуска(ДанныеПерезапуска, РежимАутентификации, ПарольЗаполнен)
	Если ДанныеПерезапуска = Неопределено Тогда
		Возврат "Не удалось заранее получить данные для перезапуска. Требуется ручное восстановление.";
	КонецЕсли;
	Если РежимАутентификации = 0 И НЕ ДанныеПерезапуска.ДоступнаWA Тогда
		Возврат "Windows-аутентификация недоступна для текущего пользователя.";
	КонецЕсли;
	Если РежимАутентификации = 1 Тогда
		Если НЕ ДанныеПерезапуска.ДоступенПароль Тогда
			Возврат "Аутентификация по паролю недоступна для текущего пользователя.";
		КонецЕсли;
		Если ДанныеПерезапуска.ПарольУстановлен И НЕ ПарольЗаполнен Тогда
			Возврат "Не задан пароль в настройках перезапуска.";
		КонецЕсли;
		Если ПарольЗаполнен Тогда
			ПодготовленныйКлюч = Неопределено;
			Если НЕ ДанныеПерезапуска.Свойство("КлючШифрования", ПодготовленныйКлюч)
				Или ТипЗнч(ПодготовленныйКлюч) <> Тип("Строка")
				Или НЕ ЗначениеЗаполнено(ПодготовленныйКлюч) Тогда
				Возврат "Не подготовлен ключ для парольного автоперезапуска. Требуется обновить настройки при доступной серверной части.";
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли РежимАутентификации <> 0 Тогда
		Возврат "Неизвестный способ аутентификации при перезапуске.";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Процедура ОбновитьКэшДанныхПерезапуска()
	Если НЕ АвтоПерезапускПриПотереКонтекста Тогда
		КэшДанныхПерезапуска = Неопределено;
		Возврат;
	КонецЕсли;
	Попытка
		ДанныеПерезапуска = ПолучитьДанныеПерезапускаНаСервере();
		// Ключ тоже требует серверного вызова: получаем его заранее вместе с остальными данными.
		ДанныеПерезапуска.Вставить("КлючШифрования", ПолучитьКлючШифрования());
		КэшДанныхПерезапуска = ДанныеПерезапуска;
	Исключение
		// Не используем устаревшую авторизацию после неудачного обновления настроек.
		КэшДанныхПерезапуска = Неопределено;
		ДобавитьВЛог("Контроль сервера: не удалось подготовить данные автоперезапуска.");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусКонтроляСервера()
	ПредыдущийСтатус = СтатусКонтроляСервера;
	Если АвтоматическийПерезапуск Тогда
		СтатусКонтроляСервера = "Перезапуск сеанса клиента 1С";
	ИначеЕсли КонтрольСервера.Статус = "ok" Тогда
		СтатусКонтроляСервера = "Серверная часть доступна";
	ИначеЕсли КонтрольСервера.ОшибкаПерезапуска <> "" Тогда
		СтатусКонтроляСервера = "Автовосстановление не удалось; требуется ручное вмешательство";
	ИначеЕсли КонтрольСервера.Статус = "lost" Тогда
		СтатусКонтроляСервера = "Обнаружены признаки потери серверной части";
	Иначе
		СтатусКонтроляСервера = "Доступность серверной части не подтверждена";
	КонецЕсли;
	Если НЕ КонтролироватьСервер Тогда
		СтатусКонтроляСервера = СтатусКонтроляСервера + " (периодическая проверка выключена)";
	КонецЕсли;
	Если ПредыдущийСтатус <> СтатусКонтроляСервера Тогда
		ДобавитьВЛог("Контроль сервера: " + СтатусКонтроляСервера);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьСвязьСервернойЧасти()
	Успех = Ложь;
	НетТочкиВхода = Ложь;
	Попытка
		Успех = ПроверитьСервернуюЧастьНаСервере();
	Исключение
		НетТочкиВхода = ОшибкаОтсутствияСервернойТочкиВхода(ОписаниеОшибки(), "ПроверитьСервернуюЧастьНаСервере");
	КонецПопытки;
	УчестьПроверкуСервера(КонтрольСервера, Успех, НетТочкиВхода, ТекущаяДата(), ИнтервалКонтроляСервера);
	ОбновитьСтатусКонтроляСервера();
	Возврат Успех;
КонецФункции

&НаКлиенте
Функция ПроверитьГотовностьАвтовосстановления()
	Если НЕ СессияПослеАвтовосстановления Тогда Возврат Истина; КонецЕсли;
	Если ПроверитьСвязьСервернойЧасти() Тогда Возврат Истина; КонецЕсли;
	// Старая сессия получает failed и остаётся открытой. Новой нельзя сообщать ready.
	Если РежимПодключения = 0 Тогда
		Попытка ОтключитьсяОтСервера(); Исключение КонецПопытки;
	Иначе
		Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
	КонецЕсли;
	ЗавершитьАвтостартСОшибкой("Server-side readiness check failed after automatic recovery");
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ВосстановитьПризнакАвтовосстановления(ДанныеАвтостарта)
	Если ДанныеАвтостарта.Свойство("automatic_recovery") Тогда
		СессияПослеАвтовосстановления = ДанныеАвтостарта.automatic_recovery = Истина;
		КонтрольСервера.ПопыткаИспользована = СессияПослеАвтовосстановления;
	КонецЕсли;
КонецПроцедуры

// В строгом режиме параметр запуска или файл перезапуска может только ужесточить защиту.
// Ослабляющее значение записывается в журнал и не применяется.
//
// Параметры:
//  ИмяПараметра - Строка - имя параметра запуска или ключа файла перезапуска (для журнала).
//  Ослабляет - Булево - Истина, если значение ослабляет защиту.
//
// Возвращаемое значение:
//  Булево - Истина, если значение надо применить.
//
&НаКлиенте
Функция ПрименятьВнешнееЗначениеЗащиты(ИмяПараметра, Ослабляет)

	Если НЕ Ослабляет ИЛИ НЕ ПрочитатьВыборСтрогогоРежимаНаСервере() Тогда
		Возврат Истина;
	КонецЕсли;

	ДобавитьВЛог("Параметр запуска ослабляет защиту и проигнорирован: " + ИмяПараметра);
	Возврат Ложь;

КонецФункции

// Восстанавливает флаги опасных операций из файла параметров перезапуска.
// Свойство()-гарды - совместимость со старым форматом файла параметров.
// В строгом режиме применяются только значения, которые не ослабляют защиту.
//
// Параметры:
//  ПараметрыАвтостарта - Структура - прочитанное содержимое файла параметров перезапуска.
//
&НаКлиенте
Процедура ВосстановитьФлагиОпасныхОпераций(ПараметрыАвтостарта)

	Если ПараметрыАвтостарта.Свойство("danger_auto_write")
		И ПрименятьВнешнееЗначениеЗащиты("danger_auto_write", ПараметрыАвтостарта.danger_auto_write <> Ложь) Тогда
		АвтоРазрешитьЗаписать = ПараметрыАвтостарта.danger_auto_write;
	КонецЕсли;

	Если ПараметрыАвтостарта.Свойство("danger_auto_priv")
		И ПрименятьВнешнееЗначениеЗащиты("danger_auto_priv", ПараметрыАвтостарта.danger_auto_priv <> Ложь) Тогда
		АвтоРазрешитьПривилегированныйРежим = ПараметрыАвтостарта.danger_auto_priv;
	КонецЕсли;

	Если ПараметрыАвтостарта.Свойство("danger_confirm")
		И ПрименятьВнешнееЗначениеЗащиты("danger_confirm", ПараметрыАвтостарта.danger_confirm <> Истина) Тогда
		РазрешатьОпасныеОперацииСПодтверждением = ПараметрыАвтостарта.danger_confirm;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонтрольСервернойЧасти() Экспорт
	Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда Возврат; КонецЕсли;
	Если НЕ ВстроенныйСерверЗапущен И НЕ ФлагПодключения Тогда Возврат; КонецЕсли;
	Если КонтролироватьСервер Тогда
		Период = ?(КонтрольСервера.Статус = "ok", ИнтервалКонтроляСервера, 15);
		Если КонтрольСервера.ПоследняяПроверка = Неопределено Тогда
			ПроверитьСвязьСервернойЧасти();
		ИначеЕсли ТекущаяДата() - КонтрольСервера.ПоследняяПроверка >= Период
			Или ТекущаяДата() < КонтрольСервера.ПоследняяПроверка Тогда
			ПроверитьСвязьСервернойЧасти();
		КонецЕсли;
	КонецЕсли;
	// Запуск из обработчика ожидания позволяет сначала вернуть ошибку текущему запросу.
	Если НуженАвтоперезапускСервера(КонтрольСервера, АвтоПерезапускПриПотереКонтекста, Ложь) Тогда
		КонтрольСервера.ПопыткаИспользована = Истина;
		Попытка
			ВыполнитьПерезапускСессии("", Неопределено, "", "", Ложь, Истина);
		Исключение
			КонтрольСервера.ОшибкаПерезапуска = "Ошибка запуска автоматического восстановления";
			АвтоматическийПерезапуск = Ложь;
			ДобавитьВЛог(КонтрольСервера.ОшибкаПерезапуска);
		КонецПопытки;
		ОбновитьСтатусКонтроляСервера();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьСервернуюКомандуСКонтролем(КомандаНаСервер)
	Если АвтоматическийПерезапуск Тогда
		Возврат Новый Структура("success,error", Ложь, "1C session recovery is in progress. Command was not executed.");
	КонецЕсли;
	Попытка
		Результат = ВыполнитьКомандуМаршрутизировано(КомандаНаСервер);
	Исключение
		ИсходнаяОшибка = ОписаниеОшибки();
		НетТочкиВхода = ОшибкаОтсутствияСервернойТочкиВхода(ИсходнаяОшибка, "ВыполнитьКомандуЧерезМодульОбъекта");
		УчестьПроверкуСервера(КонтрольСервера, Ложь, НетТочкиВхода, ТекущаяДата(), ИнтервалКонтроляСервера);
		ПроверитьСвязьСервернойЧасти();
		Если КонтрольСервера.Статус = "lost" Тогда
			ИсходнаяОшибка = "1C server-side functions are unavailable (suspected form context loss). "
				+ ?(АвтоПерезапускПриПотереКонтекста И НЕ КонтрольСервера.ПопыткаИспользована,
				"Automatic session recovery is scheduled. ", "Manual session recovery may be required. ");
		КонецЕсли;
		Возврат Новый Структура("success,error", Ложь, ИсходнаяОшибка
			+ " Execution outcome may be unknown; the command has not been replayed. Check its effects before retrying.");
	КонецПопытки;
	// Возвращённая сервером ошибка запроса тоже подтверждает доступность точки входа.
	УчестьПроверкуСервера(КонтрольСервера, Истина, Ложь, ТекущаяДата(), ИнтервалКонтроляСервера);
	ОбновитьСтатусКонтроляСервера();
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура НастройкиКонтроляСервераПриИзменении(Элемент)
	ИнтервалКонтроляСервера = Макс(15, Мин(3600, Цел(ИнтервалКонтроляСервера)));
	Попытка
		СохранитьНастройкиКонтроляСервераНаСервере(КонтролироватьСервер, ИнтервалКонтроляСервера, АвтоПерезапускПриПотереКонтекста);
	Исключение
		ДобавитьВЛог("Настройки контроля действуют до закрытия формы: сохранить их на сервере не удалось.");
	КонецПопытки;
	ОбновитьКэшДанныхПерезапуска();
	ОбновитьСтатусКонтроляСервера();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкиКонтроляСервераНаСервере(Включен, Интервал, Автоперезапуск)
	НастройкиКонтроля = Новый Структура("Включен,Интервал,Автоперезапуск", Включен, Интервал, Автоперезапуск);
	ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "КонтрольСервера", НастройкиКонтроля);
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
// ─────────────────────────────────────────────────────────────────────────────────

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Загрузка сохранённого адреса сервера
	ЗагрузитьНастройки();
	
	// Установка начального статуса
	Статус = "Отключено";
	Подключено = Ложь;
	
	// Значение по умолчанию для адреса сервера
	Если ПустаяСтрока(АдресСервера) Тогда
		АдресСервера = "http://localhost:6003";
	КонецЕсли;

	// Значение по умолчанию для порта встроенного сервера
	Если ПортВстроенногоСервера = 0 Тогда
		ПортВстроенногоСервера = 6003;
	КонецЕсли;
	
	// ЛОКАЛЬНАЯ ПРАВКА (ветка local/request-timeout-900), в оригинале этого блока нет.
	// Собственный таймаут компоненты — 180 с (http_transport.h, request_timeout_sec_{180}).
	// Аналитические запросы к регистрам идут дольше, и клиент получает 504, хотя запрос
	// в 1С продолжает выполняться и досчитывается. Значение вынесено на форму.
	Если ТаймаутЗапросаСек = 0 Тогда
		// Значение, введенное пользователем, переживает закрытие формы; 180 —
		// только значение по умолчанию, столько ждет сама компонента.
		Попытка
			СохраненныйТаймаут = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ТаймаутЗапросаСек");
		Исключение
			СохраненныйТаймаут = Неопределено;
		КонецПопытки;

		Если ТипЗнч(СохраненныйТаймаут) = Тип("Число") И СохраненныйТаймаут > 0 Тогда
			ТаймаутЗапросаСек = СохраненныйТаймаут;
		Иначе
			ТаймаутЗапросаСек = 180;
		КонецЕсли;
	КонецЕсли;

	ТаймаутШлюзаСек = СохраненныйТаймаутШлюзаНаСервере();

	ОбновитьСводкуПравилТочнойАнонимизацииНаСервере();

	НастройкиАнонИнит = ПолучитьФлагиТочнойАнонимизацииИзХранилища();
	ПодтверждениеАнонимизации = НастройкиАнонИнит.ПодтверждениеАнонимизации;

	// Установка подсказок инструментов
	Элементы.ПолеИнструментExecuteQuery.Подсказка     = СоединитьМассив(ОписаниеToolExecuteQuery(),               Символы.ПС);
	Элементы.ПолеИнструментExecuteCode.Подсказка      = СоединитьМассив(ОписаниеToolExecuteCode(),                Символы.ПС);
	Элементы.ПолеИнструментGetMetadata.Подсказка      = СоединитьМассив(ОписаниеToolGetMetadata(),                Символы.ПС);
	Элементы.ПолеИнструментGetEventLog.Подсказка      = СоединитьМассив(ОписаниеToolGetEventLog(),                Символы.ПС);
	Элементы.ПолеИнструментGetObjectByLink.Подсказка  = СоединитьМассив(ОписаниеToolGetObjectByLink(),            Символы.ПС);
	Элементы.ПолеИнструментGetLinkOfObject.Подсказка  = СоединитьМассив(ОписаниеToolGetLinkOfObject(),            Символы.ПС);
	Элементы.ПолеИнструментFindReferences.Подсказка   = СоединитьМассив(ОписаниеToolFindReferencesToObject(),     Символы.ПС);
	Элементы.ПолеИнструментGetAccessRights.Подсказка  = СоединитьМассив(ОписаниеToolGetAccessRights(),            Символы.ПС);
	Элементы.ПолеИнструментGetBslSyntaxHelp.Подсказка = СоединитьМассив(ОписаниеToolGetBslSyntaxHelp(),           Символы.ПС);
	Элементы.ПолеИнструментSubmitDeanon.Подсказка     = СоединитьМассив(ОписаниеToolSubmitForDeanonymization(),   Символы.ПС);
	Элементы.ПолеИнструментGetScreenshot.Подсказка = СоединитьМассив(ОписаниеToolGetScreenshot(),         Символы.ПС);
	Элементы.ПолеИнструментRestart1cSession.Подсказка = СоединитьМассив(ОписаниеToolRestart1cSession(),      Символы.ПС);
	Элементы.ПолеИнструментClose1cSession.Подсказка  = СоединитьМассив(ОписаниеToolClose1cSession(),       Символы.ПС);

	// Загрузка шаблона HTML просмотра markdown
	ДД = РеквизитФормыВЗначение("Объект").ПолучитьМакет("MarkdownViewer");
	Поток = ДД.ОткрытьПотокДляЧтения();
	ЧтениеТекста = Новый ЧтениеТекста(Поток, КодировкаТекста.UTF8);
	ШаблонMarkdownПросмотра = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	Поток.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Состояние защиты строгого режима
	ЭпохаЗащиты = 0;
	ОжидающиеШлюза = Новый Соответствие;
	ОчередьШлюза = Новый Массив;
	СчетчикШлюза = 0;
	КлючОткрытогоШлюза = 0;
	СнимкиПодтвержденныхВызовов = Новый Соответствие;
	ОжидающиеПроверкиСтрогогоРежима = Новый Массив;
	ПроисхождениеТокенов = Новый Соответствие;
	СостояниеЗащиты = Новый Структура("Строгий, Активен, Переключение, ГарантияПриостановлена, ПричинаНеактивности",
		Ложь, Ложь, Ложь, Ложь, "");

	// Выбор строгого режима читается из хранилища один раз; дальше сессия его не перечитывает
	ВыборСтрогогоРежима = ПрочитатьВыборСтрогогоРежимаНаСервере();
	ВключитьСохраненныйСтрогийРежим(ВыборСтрогогоРежима);

	ИспользоватьАсинхронноеПодключениеКомпонент = ПроверитьНужноАсинхронноеПодключениеКомпонент();
	ЗапускСервераВПроцессе = Ложь;

	// Маркеры актуальности подключений и попыток инициализации компонент
	ПоколениеПодключенияСервер = 0;
	ПоколениеПодключенияПрокси = 0;
	ИдПопыткиSyntaxHelpСервер = 0;
	ИдПопыткиSyntaxHelpПрокси = 0;
	АктивныйЗахватСкриншота = Неопределено;
	МиллисекундыЧасовПроверены = Ложь;
	МиллисекундыЧасовДоступны = Ложь;
	ЗначениеЧасовКлиента = 0;

	// Инициализация переменных
	ФлагПодключения = Ложь;
	ИнтервалОпроса = 1; // секунды
	МаксимальноеКоличествоПопытокПереподключения = 5;
	ТекущееКоличествоПопытокПереподключения = 0;
	
	// Клиентский кэш токенов для расширений (адреса ВременногоХранилища)
	КэшТокеновМетаданныхРасширений = Новый Соответствие;

	// Инициализация переменных встроенного сервера
	МСПСессии = Новый Соответствие;
	SSEПотоки = Новый Соответствие;
	ОжидающиеПодтверждения = Новый Соответствие;
	КэшСхемИнструментов = Неопределено;
	АктивныеЗадания = Новый Соответствие;
	ОбработчикДоставкиАктивен = Ложь;
	БСПДоступна = Неопределено;
	МеханизмФоновогоЗапуска = "";

	// Инициализация состояния выбора адреса привязки встроенного сервера
	КэшАдресовВстроенногоСервера = Новый Соответствие;
	ЗагрузитьВыборАдресаВстроенногоСервера(); // канонический выбор из хранилища, ДО веток autostart/coldstart

	// Кэш маппингов анонимизации
	КэшМаппинговОтвет = Неопределено;

	// Инициализация переменных перезапуска сессии
	ПерезапускВОжидании               = Ложь;
	ИдКомандыПерезапуска              = "";
	ПутьФайлаСигналаПерезапуска       = "";
	ПутьФайлаПараметровПерезапуска    = "";
	ПутьНонсаПерезапуска              = "";
	ПутьФайлаМаппинговПерезапуска     = "";
	ПутьФайлаСигналаАвтостарта        = "";
	МаппингиДляВосстановления         = "";
	ПутьКлеймаАвтостарта              = "";
	СессийДляВосстановления           = Неопределено;
	ПутьКлеймаПерезапуска             = "";
	ДанныеЗапросаПерезапуска          = Неопределено;
	ИдЗапросаПерезапуска              = "";
	ИдПотокаПерезапуска               = "";
	ЗавершениеПослеПерезапускаЗапущено = Ложь;
	КлючШифрованияПерезапуска = "MCPToolkit-RestartKey-v1-x7Kq2mNp";
	ЭтоRESTЗапросПерезапуска            = Ложь;
	ИдRESTЗапросаПерезапуска            = "";
	ЗакрытиеСессииВПроцессе             = Ложь;
	ПутьФайлаСигналаХолодногоСтарта     = "";
	КонтрольСервера = НовоеСостояниеКонтроляСервера();
	КэшДанныхПерезапуска = Неопределено;
	АвтоматическийПерезапуск = Ложь;
	СессияПослеАвтовосстановления = Ложь;

	// Инициализация видимости элементов по текущему режиму
	ПриИзмененииРежимаПодключения(Неопределено);

	// Настройка доступности элементов перезапуска (зависит от типа платформы и прав пользователя)
	НастроитьДоступностьАутентификацииПерезапуска();
	ОбновитьКэшДанныхПерезапуска();
	ОбновитьСтатусКонтроляСервера();
	ПодключитьОбработчикОжидания("КонтрольСервернойЧасти", 5, Ложь);

	// Автозапуск при передаче параметра /C "autostart;<timestamp>;<путь к params JSON>"
	// или coldstart;<timestamp>;<путь к params JSON> — запуск после close_1c_session
	// Если params JSON удалён или повреждён — закрываем новую autostart-сессию;
	// старая сессия дождётся timeout и продолжит работать.
	// coldstart при stale/битом timestamp — пропускается, форма открывается нормально.
	Если ПараметрЗапуска = "startup" ИЛИ Лев(ПараметрЗапуска, СтрДлина("startup;")) = "startup;" Тогда

		СтартапОшибка = "";

		// Фаза 1: разбор и валидация в локальные сентинелы (без сайд-эффектов)
		НовыйРежим         = Неопределено;
		НовыйАдрес         = Неопределено;
		НовыйКанал         = Неопределено;
		НовыйПорт          = Неопределено;
		НовыйРежимАутентиф = Неопределено;
		НовыйПароль        = Неопределено;

		Попытка
			Если ПараметрЗапуска <> "startup" Тогда
				ОстатокПараметра = Сред(ПараметрЗапуска, СтрДлина("startup;") + 1);
				Пока ЗначениеЗаполнено(ОстатокПараметра) И ПустаяСтрока(СтартапОшибка) Цикл
					РазделительПоз = Найти(ОстатокПараметра, ";");
					Если РазделительПоз > 0 Тогда
						ПараЗначение     = Лев(ОстатокПараметра, РазделительПоз - 1);
						ОстатокПараметра = Сред(ОстатокПараметра, РазделительПоз + 1);
					Иначе
						ПараЗначение     = ОстатокПараметра;
						ОстатокПараметра = "";
					КонецЕсли;

					РавноПоз = Найти(ПараЗначение, "=");
					Если РавноПоз > 0 Тогда
						Ключ     = Лев(ПараЗначение, РавноПоз - 1);
						Значение = URLDecode(Сред(ПараЗначение, РавноПоз + 1));
					Иначе
						Ключ     = ПараЗначение;
						Значение = "";
					КонецЕсли;

					Если Ключ = "mode" Тогда
						Если Значение = "proxy" Тогда
							НовыйРежим = 0;
						ИначеЕсли Значение = "embedded" Тогда
							НовыйРежим = 1;
						Иначе
							СтартапОшибка = "startup: unknown mode=" + Значение;
						КонецЕсли;
					ИначеЕсли Ключ = "url" Тогда
						Если ПустаяСтрока(Значение) Тогда
							СтартапОшибка = "startup: url cannot be empty";
						Иначе
							НовыйАдрес = Значение;
						КонецЕсли;
					ИначеЕсли Ключ = "channel" Тогда
						НовыйКанал = Значение;
					ИначеЕсли Ключ = "port" Тогда
						НомПорт = 0;
						Попытка НомПорт = Число(Значение); Исключение КонецПопытки;
						Если НомПорт >= 1 И НомПорт <= 65535 Тогда
							НовыйПорт = НомПорт;
						Иначе
							СтартапОшибка = "startup: invalid port=" + Значение + " (expected 1..65535)";
						КонецЕсли;
					ИначеЕсли Ключ = "auth" Тогда
						Если Значение = "windows" Тогда
							НовыйРежимАутентиф = 0;
							НовыйПароль = "";
						ИначеЕсли Значение = "password" Тогда
							НовыйРежимАутентиф = 1;
						Иначе
							СтартапОшибка = "startup: unknown auth=" + Значение;
						КонецЕсли;
					ИначеЕсли Ключ = "pwd" Тогда
						НовыйПароль = Значение;
					Иначе
						ДобавитьВЛог("startup: unknown key '" + Ключ + "' — ignored");
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Исключение
			СтартапОшибка = ОписаниеОшибки();
		КонецПопытки;

		// Фаза 2: применить и сохранить только при полном успехе
		Если ПустаяСтрока(СтартапОшибка) Тогда
			Если НовыйРежим <> Неопределено И ПрименятьВнешнееЗначениеЗащиты("mode", НовыйРежим <> 1) Тогда
				РежимПодключения = НовыйРежим;
				СохранитьРежимПодключенияНаСервере(РежимПодключения);
			КонецЕсли;
			Если НовыйАдрес <> Неопределено И ПрименятьВнешнееЗначениеЗащиты("url", Истина) Тогда
				АдресСервера = НовыйАдрес;
				СохранитьНастройкиНаСервере(АдресСервера);
			КонецЕсли;
			Если НовыйКанал <> Неопределено Тогда
				ИдентификаторКанала = НовыйКанал;
				СохранитьИдентификаторКаналаНаСервере(ИдентификаторКанала);
			КонецЕсли;
			Если НовыйПорт <> Неопределено Тогда
				ПортВстроенногоСервера = НовыйПорт;
				СохранитьПортВстроенногоСервераНаСервере(ПортВстроенногоСервера);
			КонецЕсли;
			Если НовыйРежимАутентиф <> Неопределено Тогда
				РежимАутентификацииПерезапуска = НовыйРежимАутентиф;
				СохранитьРежимАутентификацииПерезапускаНаСервере(РежимАутентификацииПерезапуска);
			КонецЕсли;
			Если НовыйПароль <> Неопределено Тогда
				ПарольПерезапуска = НовыйПароль;
			КонецЕсли;

			ПриИзмененииРежимаПодключения(Неопределено);
			НастроитьДоступностьАутентификацииПерезапуска();
			// Режим подключения из параметра применен: строгий режим включается до запуска сервера
			ВключитьСохраненныйСтрогийРежим(ВыборСтрогогоРежима);
			Подключиться(Неопределено);
		Иначе
			ДобавитьВЛог(СтартапОшибка);
		КонецЕсли;

	ИначеЕсли Лев(ПараметрЗапуска, СтрДлина("autostart;")) = "autostart;" Тогда
		ВладениеПолучено = Ложь;
		Попытка
			ОстатокПараметра = Сред(ПараметрЗапуска, СтрДлина("autostart;") + 1);
			РазделительПоз = Найти(ОстатокПараметра, ";");
			Если РазделительПоз = 0 Тогда
				// Формат без timestamp — игнорируем autostart, открываем форму нормально
				Возврат;
			КонецЕсли;
			МеткаВременниСтрока = Лев(ОстатокПараметра, РазделительПоз - 1);
			ФайлПараметров = Сред(ОстатокПараметра, РазделительПоз + 1);

			РазницаСек = ТекущаяДата() - Дата(МеткаВременниСтрока);
			Если РазницаСек > 300 Тогда
				// Повторное открытие обработки в той же сессии — игнорируем autostart
				Возврат;
			КонецЕсли;

			ЧТ = Новый ЧтениеТекста(ФайлПараметров, КодировкаТекста.UTF8);
			Попытка
				ТекстJSON = ЧТ.Прочитать();
			Исключение
				Попытка ЧТ.Закрыть(); Исключение КонецПопытки;
				ВызватьИсключение;
			КонецПопытки;
			ЧТ.Закрыть();
			ПараметрыАвтостарта = ПрочитатьJSON2(ТекстJSON);
			УдалитьФайлы(ФайлПараметров);

			ПутьФайлаСигналаАвтостарта = ПараметрыАвтостарта.signal_path;

			Если ПрименятьВнешнееЗначениеЗащиты("mappings_path", ЗначениеЗаполнено(ПараметрыАвтостарта.mappings_path)) Тогда
				МаппингиДляВосстановления = ПараметрыАвтостарта.mappings_path;
			КонецЕсли;

			ПутьКлеймаАвтостарта       = ПараметрыАвтостарта.claimed_path;
			СессийДляВосстановления    = ПараметрыАвтостарта.mcp_sessions;

			НонсФайл    = Новый Файл(ПараметрыАвтостарта.nonce_path);
			НонсВалиден = НонсФайл.Существует();

			Если НонсВалиден Тогда
				КлеймЗаписан = Истина;
				Если ПараметрыАвтостарта.claimed_path <> "" Тогда
					Попытка
						ЗТ = Новый ЗаписьТекста(ПараметрыАвтостарта.claimed_path, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("1");
						ЗТ.Закрыть();
					Исключение
						КлеймЗаписан = Ложь;
					КонецПопытки;
				КонецЕсли;

				Если НЕ КлеймЗаписан Тогда
					Попытка
						ЗТ = Новый ЗаписьТекста(ПараметрыАвтостарта.signal_path, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("failed:Cannot write claimed marker — ownership protocol broken");
						ЗТ.Закрыть();
					Исключение
					КонецПопытки;
					Если МаппингиДляВосстановления <> "" Тогда
						Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
					КонецЕсли;
					Попытка УдалитьФайлы(ПараметрыАвтостарта.nonce_path); Исключение КонецПопытки;
					Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
					ПутьФайлаСигналаАвтостарта = "";
					МаппингиДляВосстановления  = "";
					ПутьКлеймаАвтостарта       = "";
					СессийДляВосстановления    = Неопределено;
					ЗавершитьРаботуСистемы(Ложь);
					Возврат;
				Иначе
					НФАвтостарт = Новый Файл(ПараметрыАвтостарта.nonce_path);
					НонсЕщеВалиден = НФАвтостарт.Существует();
					Если НЕ НонсЕщеВалиден Тогда
						Попытка УдалитьФайлы(ПараметрыАвтостарта.claimed_path); Исключение КонецПопытки;
						Попытка УдалитьФайлы(ПараметрыАвтостарта.mappings_path); Исключение КонецПопытки;
						ПутьФайлаСигналаАвтостарта = "";
						МаппингиДляВосстановления  = "";
						ПутьКлеймаАвтостарта       = "";
						СессийДляВосстановления    = Неопределено;
						ЗавершитьРаботуСистемы(Ложь);
						Возврат;
					КонецЕсли;
					Попытка УдалитьФайлы(ПараметрыАвтостарта.nonce_path); Исключение КонецПопытки;
					ВладениеПолучено = Истина;

					// Восстанавливаем пароль ПОСЛЕ double-check nonce
					ВосстановитьПризнакАвтовосстановления(ПараметрыАвтостарта);
					Если ЗначениеЗаполнено(ПараметрыАвтостарта.restart_password) Тогда
						Попытка
							ПарольПерезапуска = РасшифроватьПарольПерезапуска(ПараметрыАвтостарта.restart_password);
						Исключение
							Попытка
								ОшибкаСтрока = СтрЗаменить(ОписаниеОшибки(), Символы.ВК, " ");
								ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
								ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
								ЗТ = Новый ЗаписьТекста(ПараметрыАвтостарта.signal_path, КодировкаТекста.UTF8);
								ЗТ.ЗаписатьСтроку("failed:Password decrypt error: " + ОшибкаСтрока);
								ЗТ.Закрыть();
							Исключение
							КонецПопытки;
							Если МаппингиДляВосстановления <> Неопределено И МаппингиДляВосстановления <> "" Тогда
								Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
							КонецЕсли;
							Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
							ПутьФайлаСигналаАвтостарта = "";
							МаппингиДляВосстановления  = "";
							ПутьКлеймаАвтостарта       = "";
							СессийДляВосстановления    = Неопределено;
							ЗавершитьРаботуСистемы(Ложь);
							Возврат;
						КонецПопытки;
					КонецЕсли;

					// Восстанавливаем флаги опасных операций ПОСЛЕ double-check nonce
					// (тот же рубеж доверия, что и восстановление пароля выше).
					ВосстановитьФлагиОпасныхОпераций(ПараметрыАвтостарта);

					// Запускаем сервер/прокси
					Если РежимПодключения = 1 Тогда
						ЗапуститьВстроенныйСервер();
					Иначе
						Подключиться(Неопределено);
					КонецЕсли;
				КонецЕсли;
			Иначе
				// Nonce недействителен — таймаут старой сессии. Закрываем новую autostart-сессию.
				ПутьФайлаСигналаАвтостарта = "";
				Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
				ПутьКлеймаАвтостарта       = "";
				СессийДляВосстановления    = Неопределено;
				Если МаппингиДляВосстановления <> "" Тогда
					Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
					МаппингиДляВосстановления = "";
				КонецЕсли;
				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			КонецЕсли;
		Исключение
			Если ВладениеПолучено Тогда
				Попытка
					ОшибкаСтрока = СтрЗаменить(ОписаниеОшибки(), Символы.ВК, " ");
					ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
					ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
					Если ПутьФайлаСигналаАвтостарта <> "" Тогда
						ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
						ЗТ.Закрыть();
					КонецЕсли;
				Исключение КонецПопытки;
				Если МаппингиДляВосстановления <> "" Тогда
					Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
				КонецЕсли;
				Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
				ПутьФайлаСигналаАвтостарта = "";
				МаппингиДляВосстановления  = "";
				ПутьКлеймаАвтостарта       = "";
				СессийДляВосстановления    = Неопределено;
				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			Иначе
				ЕстьСигнал = ПутьФайлаСигналаАвтостарта <> "";

				Если ЕстьСигнал Тогда
					Попытка
						ОшибкаСтрока = СтрЗаменить(ОписаниеОшибки(), Символы.ВК, " ");
						ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
						ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
						ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
						ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
						ЗТ.Закрыть();
					Исключение КонецПопытки;
				КонецЕсли;

				Если МаппингиДляВосстановления <> "" Тогда
					Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
				КонецЕсли;

				ПутьФайлаСигналаАвтостарта = "";
				МаппингиДляВосстановления  = "";
				ПутьКлеймаАвтостарта       = "";
				СессийДляВосстановления    = Неопределено;

				Если ЕстьСигнал Тогда
					Попытка УдалитьФайлы(ПараметрыАвтостарта.nonce_path); Исключение КонецПопытки;
					Попытка УдалитьФайлы(ПараметрыАвтостарта.claimed_path); Исключение КонецПопытки;
				КонецЕсли;

				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			КонецЕсли;
		КонецПопытки;
	ИначеЕсли Лев(ПараметрЗапуска, СтрДлина("coldstart;")) = "coldstart;" Тогда
		ОстатокПараметра = Сред(ПараметрЗапуска, СтрДлина("coldstart;") + 1);
		РазделительПоз = Найти(ОстатокПараметра, ";");
		Если РазделительПоз > 0 Тогда
			МеткаВремениСтрока = Лев(ОстатокПараметра, РазделительПоз - 1);
			ФайлПараметров = Сред(ОстатокПараметра, РазделительПоз + 1);

			МеткаВалидна = Ложь;
			Попытка
				РазницаСек = ТекущаяДата() - Дата(МеткаВремениСтрока);
				МеткаВалидна = Истина;
			Исключение
			КонецПопытки;

			Если МеткаВалидна И РазницаСек >= 0 И РазницаСек <= 300 Тогда
				Попытка
					ЧТ = Новый ЧтениеТекста(ФайлПараметров, КодировкаТекста.UTF8);
					Попытка
						ТекстJSON = ЧТ.Прочитать();
					Исключение
						Попытка ЧТ.Закрыть(); Исключение КонецПопытки;
						ВызватьИсключение;
					КонецПопытки;
					ЧТ.Закрыть();
					ПараметрыАвтостарта = ПрочитатьJSON2(ТекстJSON);

					// signal_path присваиваем ПЕРВЫМ — catch-блок может записать failed-сигнал
					// только если ПутьФайлаСигналаХолодногоСтарта уже установлен
					Если ПараметрыАвтостарта.Свойство("signal_path") Тогда
						ПутьФайлаСигналаХолодногоСтарта = ПараметрыАвтостарта.signal_path;
					КонецЕсли;

					УдалитьФайлы(ФайлПараметров);

					СессийДляВосстановления = ПараметрыАвтостарта.mcp_sessions;
					Если ПараметрыАвтостарта.Свойство("mappings_path")
						И ПрименятьВнешнееЗначениеЗащиты("mappings_path",
							ЗначениеЗаполнено(ПараметрыАвтостарта.mappings_path)) Тогда
						МаппингиДляВосстановления = ПараметрыАвтостарта.mappings_path;
					КонецЕсли;

					Если ЗначениеЗаполнено(ПараметрыАвтостарта.restart_password) Тогда
						ПарольПерезапуска = РасшифроватьПарольПерезапуска(ПараметрыАвтостарта.restart_password);
					КонецЕсли;

					// Восстанавливаем флаги опасных операций ПОСЛЕ одноразового потребления файла
					// параметров (УдалитьФайлы выше) и в пределах двустороннего окна свежести.
					// Рубеж доверия coldstart — принятое ограничение модели угроз (локальный same-user launcher).
					ВосстановитьФлагиОпасныхОпераций(ПараметрыАвтостарта);

					Если РежимПодключения = 1 Тогда
						ЗапуститьВстроенныйСервер();
						// Сигнал пишется позже в ЗавершитьАвтостартПослеЗапускаВстроенногоСервера
					Иначе
						Подключиться(Неопределено);
						// Сигнал пишется в ЦиклОпроса на первом успешном poll
					КонецЕсли;
				Исключение
					ТекстОш = ОписаниеОшибки();
					ДобавитьВЛог("Cold start error: " + ТекстОш);
					Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
						Попытка
							ТекстОшСанит = СтрЗаменить(СтрЗаменить(ТекстОш, Символы.ВК, " "), Символы.ПС, " ");
							ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
							ЗТ.ЗаписатьСтроку("failed:Cold start error: " + ТекстОшСанит);
							ЗТ.Закрыть();
						Исключение КонецПопытки;
						ПутьФайлаСигналаХолодногоСтарта = "";
					КонецЕсли;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(Отказ)
	ОтключитьОбработчикОжидания("КонтрольСервернойЧасти");

	ЗапускСервераВПроцессе = Ложь; // колбэки async-цепочки получат Ложь и выйдут без ошибок

	// Отзыв всех маркеров актуальности — поздние колбэки не должны ничего делать
	ПоколениеПодключенияСервер = ПоколениеПодключенияСервер + 1;
	ПоколениеПодключенияПрокси = ПоколениеПодключенияПрокси + 1;

	ОтменитьАктивныйЗахватСкриншота(""); // закрытие формы отменяет любую операцию
	ИдПопыткиSyntaxHelpСервер = ИдПопыткиSyntaxHelpСервер + 1;
	ИдПопыткиSyntaxHelpПрокси = ИдПопыткиSyntaxHelpПрокси + 1;

	// Отключение при закрытии формы
	Если ФлагПодключения Тогда
		ОтключитьсяОтСервера();
	КонецЕсли;

	// Остановка встроенного сервера
	Если ВстроенныйСерверЗапущен Тогда
		ОстановитьВстроенныйСервер();
	КонецЕсли;

КонецПроцедуры


// ─────────────────────────────────────────────────────────────────────────────────
// КОМАНДЫ ФОРМЫ
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура Подключиться(Команда)

	Если РежимПодключения = 1 Тогда
		// Режим встроенного сервера — сначала отключиться от прокси
		Если ФлагПодключения Тогда
			ОтключитьсяОтСервера();
		КонецЕсли;
		ЗапуститьВстроенныйСервер();
		Возврат;
	КонецЕсли;

	// Новое подключение к прокси — отзыв предыдущего прокси-поколения
	ПоколениеПодключенияПрокси = ПоколениеПодключенияПрокси + 1;
	ОтменитьАктивныйЗахватСкриншота("proxy");

	// Режим прокси — сначала остановить встроенный сервер
	Если ВстроенныйСерверЗапущен Тогда
		ОстановитьВстроенныйСервер();
	КонецЕсли;

	Если ПустаяСтрока(АдресСервера) Тогда
		ПоказатьПредупреждение(, "Укажите адрес сервера");
		Возврат;
	КонецЕсли;

	// Сохранение адреса сервера
	СохранитьНастройкиНаСервере(АдресСервера);

	// Инициализация переменных если не были инициализированы
	Если ИнтервалОпроса = Неопределено Тогда
		ИнтервалОпроса = 1;
	КонецЕсли;

	// Запуск подключения
	ФлагПодключения = Истина;
	ТекущееКоличествоПопытокПереподключения = 0;

	УстановитьСтатус("Подключение...", Ложь);
	ДобавитьВЛог("Подключение к серверу: " + АдресСервера);

	// Подключение SyntaxHelpReader
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияМакетаSyntaxHelpProxy", ЭтаФорма,
				НовыйКонтекстПопыткиSyntaxHelp("proxy")),
			"ВнешняяОбработка.MCPToolkit.Макет.SyntaxHelpReader", "SyntaxH");
	Иначе
		ПодключитьКомпонентуSyntaxHelpСинхронно();
	КонецЕсли;

	// Подключение ScreenCapture
	Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		НачатьАсинхронноеПодключениеКомпоненты(
			Новый ОписаниеОповещения("ПослеПодключенияМакетаScreenCaptureProxy", ЭтаФорма),
			"ВнешняяОбработка.MCPToolkit.Макет.ScreenCapture", "ScreenCapture");
	Иначе
		ПодключитьКомпонентуScreenCaptureСинхронно();
	КонецЕсли;

	// Запуск цикла опроса
	ПодключитьОбработчикОжидания("ЦиклОпроса", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Отключиться(Команда)

	Если РежимПодключения = 1 Тогда
		ОстановитьВстроенныйСервер();
		Возврат;
	КонецЕсли;

	ОтключитьсяОтСервера();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурнал(Команда)
	
	Лог = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиТочнойАнонимизации(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеЗакрытияНастроекТочнойАнонимизации",
		ЭтаФорма);

	ПарамФормы = Новый Структура(
		"ИспользоватьАсинхронноеПодключениеКомпонент, РежимПодключения",
		ИспользоватьАсинхронноеПодключениеКомпонент,
		РежимПодключения);

	ОткрытьФорму(
		"ВнешняяОбработка.MCPToolkit.Форма.ФормаНастройкиТочнойАнонимизации",
		ПарамФормы,
		ЭтаФорма,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияНастроекТочнойАнонимизации(НастройкиСохранены, ДополнительныеДанные) Экспорт

	Если НастройкиСохранены <> Истина Тогда
		Возврат;
	КонецЕсли;

	КэшRegexПравил = Неопределено;                // инвалидировать кэши при изменении настроек
	КэшНастроекТочнойАнонимизации = Неопределено;

	ОбновитьСводкуПравилТочнойАнонимизацииНаСервере();

	НастройкиАнон = ПолучитьФлагиТочнойАнонимизацииИзХранилища();
	ПодтверждениеАнонимизации = НастройкиАнон.ПодтверждениеАнонимизации;

	Если ВстроенныйСерверЗапущен И ИспользоватьТочнуюАнонимизацию Тогда
		ПостроитьИЗаполнитьСловарьАнонимизации();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьсяОтСервера()
	
	// Отзыв маркеров актуальности прокси-подключения
	ПоколениеПодключенияПрокси = ПоколениеПодключенияПрокси + 1;
	ОтменитьАктивныйЗахватСкриншота("proxy");
	ИдПопыткиSyntaxHelpПрокси = ИдПопыткиSyntaxHelpПрокси + 1;

	ФлагПодключения = Ложь;
	
	Попытка
		ОтключитьОбработчикОжидания("ЦиклОпроса");
	Исключение
		// Обработчик уже отключен
	КонецПопытки;
	
	УстановитьСтатус("Отключено", Ложь);
	ДобавитьВЛог("Отключено от сервера");
	
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ЦИКЛ ОПРОСА (LONG POLLING)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ЦиклОпроса()
	
	Если Не ФлагПодключения Тогда
		Возврат;
	КонецЕсли;
	
	// Получение команды с сервера
	РезультатЗапроса = ПолучитьКомандуССервера(АдресСервера);
	
	Если РезультатЗапроса.Успех Тогда

		// Сброс счётчика попыток при успешном подключении
		ТекущееКоличествоПопытокПереподключения = 0;

		Если Не Подключено Тогда
			УстановитьСтатус("Подключено", Истина);
			ДобавитьВЛог("Успешное подключение к серверу");
		КонецЕсли;

		// Первый успешный poll после autostart — записываем сигнал "ready"
		Если ПутьФайлаСигналаАвтостарта <> Неопределено И ПутьФайлаСигналаАвтостарта <> "" Тогда
			Если НЕ ПроверитьГотовностьАвтовосстановления() Тогда Возврат; КонецЕсли;
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("ready");
				ЗТ.Закрыть();
				ПутьФайлаСигналаАвтостарта = "";
			Исключение
				ПутьФайлаСигналаАвтостарта = "";
				Попытка ОтключитьсяОтСервера(); Исключение КонецПопытки;
				ЗавершитьРаботуСистемы(Ложь);
			КонецПопытки;
		КонецЕсли;

		// Первый успешный poll после coldstart (proxy) — записываем сигнал "ready"
		Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("ready");
				ЗТ.Закрыть();
			Исключение КонецПопытки;
			ПутьФайлаСигналаХолодногоСтарта = "";
		КонецЕсли;

		Если РезультатЗапроса.ЕстьКоманда Тогда
			// Выполнение команды
			ОбработатьКоманду(РезультатЗапроса.Команда);
		КонецЕсли;

	Иначе
		// Ошибка подключения
		ОбработатьОшибкуПодключения(РезультатЗапроса.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработатьОшибкуПодключения(ОписаниеОшибки)
	
	// Инициализация если не были инициализированы
	Если ТекущееКоличествоПопытокПереподключения = Неопределено Тогда
		ТекущееКоличествоПопытокПереподключения = 0;
	КонецЕсли;
	Если МаксимальноеКоличествоПопытокПереподключения = Неопределено Тогда
		МаксимальноеКоличествоПопытокПереподключения = 5;
	КонецЕсли;
	
	ТекущееКоличествоПопытокПереподключения = ТекущееКоличествоПопытокПереподключения + 1;
	
	Если ТекущееКоличествоПопытокПереподключения >= МаксимальноеКоличествоПопытокПереподключения Тогда
		// Превышено количество попыток переподключения
		УстановитьСтатус("Ошибка: " + ОписаниеОшибки, Ложь);
		ДобавитьВЛог("Ошибка подключения: " + ОписаниеОшибки + ". Превышено количество попыток.");
		// В coldstart-режиме — failed: и закрыть новую сессию
		Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("failed:proxy connection failed");
				ЗТ.Закрыть();
			Исключение КонецПопытки;
			ПутьФайлаСигналаХолодногоСтарта = "";
			ЗавершитьРаботуСистемы(Ложь);
			Возврат;
		КонецЕсли;
		// В autostart-режиме — failed: и закрыть новую сессию
		Если ПутьФайлаСигналаАвтостарта <> Неопределено И ПутьФайлаСигналаАвтостарта <> "" Тогда
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("failed:Proxy connection failed — new session could not connect");
				ЗТ.Закрыть();
			Исключение
			КонецПопытки;
			ПутьФайлаСигналаАвтостарта = "";
			Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
			ПутьКлеймаАвтостарта = "";
			ЗавершитьРаботуСистемы(Ложь);
			Возврат;
		КонецЕсли;
		ОтключитьсяОтСервера();
	Иначе
		// Попытка переподключения
		УстановитьСтатус("Переподключение (" + ТекущееКоличествоПопытокПереподключения + "/" + МаксимальноеКоличествоПопытокПереподключения + ")...", Ложь);
		ДобавитьВЛог("Ошибка подключения: " + ОписаниеОшибки + ". Попытка переподключения...");
	КонецЕсли;
	
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// КЭШ ДЛЯ МЕТАДАННЫХ РАСШИРЕНИЙ (клиент хранит токены, сервер хранит данные во ВременномХранилище)
// Внешний API не меняется: токены не уходят наружу (в ОтправитьРезультатНаСервер есть whitelist полей).
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция ПолучитьКэшТокеновМетаданныхРасширений()
	Если КэшТокеновМетаданныхРасширений = Неопределено Тогда
		КэшТокеновМетаданныхРасширений = Новый Соответствие;
	КонецЕсли;
	Возврат КэшТокеновМетаданныхРасширений;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьКлючКэшаДеталейРасширения(Фильтр, Секции, НастройкиТипов = Неопределено)
	Ключ = ?(Фильтр = Неопределено, "", Строка(Фильтр));
	
	Если Секции <> Неопределено Тогда
		Попытка
			Если ТипЗнч(Секции) = Тип("Массив") Тогда
				СтрСекции = "";
				Для Каждого Секция Из Секции Цикл
					Секция = СокрЛП(Строка(Секция));
					Если ПустаяСтрока(Секция) Тогда
						Продолжить;
					КонецЕсли;
					СтрСекции = СтрСекции + ?(ПустаяСтрока(СтрСекции), "", ",") + Секция;
				КонецЦикла;
				Если НЕ ПустаяСтрока(СтрСекции) Тогда
					Ключ = Ключ + "|" + СтрСекции;
				КонецЕсли;
			Иначе
				Ключ = Ключ + "|" + Строка(Секции);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	
	Ключ = Ключ + "|v2";
	Если НастройкиТипов <> Неопределено И НастройкиТипов.ЗаданыПараметры Тогда
		Ключ = Ключ + "|types:" + XMLСтрока(НастройкиТипов.Лимит) + ":" + XMLСтрока(НастройкиТипов.Смещение);
	КонецЕсли;
	Возврат Ключ;

КонецФункции



// ─────────────────────────────────────────────────────────────────────────────────
// ДИСПЕТЧЕР КОМАНД КЛИЕНТА (КОНТЕКСТ ВЫПОЛНЕНИЯ)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция НовыйКонтекстВыполненияКоманды(Режим)
	КонтекстОтвета = Новый Структура;
	КонтекстОтвета.Вставить("Режим", Режим);
	КонтекстОтвета.Вставить("Отложено", Ложь);
	КонтекстОтвета.Вставить("ИдОперации", Строка(Новый УникальныйИдентификатор));
	Если Режим = "proxy" Тогда
		КонтекстОтвета.Вставить("ПоколениеПодключения", ПоколениеПодключенияПрокси);
		КонтекстОтвета.Вставить("КомандаId", Неопределено);
		КонтекстОтвета.Вставить("АдресПрокси", Неопределено);
	Иначе
		КонтекстОтвета.Вставить("ПоколениеПодключения", ПоколениеПодключенияСервер);
		КонтекстОтвета.Вставить("ДанныеЗапроса", Неопределено);
		КонтекстОтвета.Вставить("Ид", Неопределено);
		КонтекстОтвета.Вставить("ИдПотока", "");
	КонецЕсли;
	Возврат КонтекстОтвета;
КонецФункции

&НаКлиенте
Функция ВыполнитьКомандуСУчетомКонтекста(Команда, КонтекстВыполненияКоманды = Неопределено)

	Если Команда.tool = "execute_code" Тогда
		КонтекстВыполнения = "server";
		Если Команда.Свойство("params") И Команда.params <> Неопределено
			И Команда.params.Свойство("execution_context") Тогда
			КонтекстВыполнения = Команда.params.execution_context;
		КонецЕсли;
		Если КонтекстВыполнения = "client" Тогда
			Код = "";
			Если Команда.params.Свойство("code") Тогда Код = Команда.params.code; КонецЕсли;
			ЗначенияТокенов = Неопределено;
			Если СостояниеЗащиты.Строгий Тогда
				Команда.params.Свойство("mcp_bound_values", ЗначенияТокенов);
			КонецЕсли;
			РезультатКлиент = ВыполнитьКодНаКлиенте(Код, ЗначенияТокенов);
			// В async-режиме маркеры и анонимизацию создаёт внешний REST/MCP-диспетчер.
			Если ЛегасиМаскированиеАктивно()
				И НЕ ИспользоватьАсинхронноеПодключениеКомпонент Тогда
				Если ТипЗнч(РезультатКлиент) = Тип("Структура") И РезультатКлиент.Свойство("data") Тогда
					РезультатКлиент.Вставить("_original_data_json",        ЗаписатьJSON2(РезультатКлиент.data));
					РезультатКлиент.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				РегексКонтекст = Новый Структура(
					"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
					РезультатКлиент, "", "", Неопределено, Ложь, Истина);
				АнонимизироватьExecuteCodeВстроенный(РезультатКлиент, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						// НЕ выставляем КомпонентаRegexНедоступна — client-path не должен
						// блокировать async-режим на весь сеанс при одном неудачном sync-load
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныExecuteCode(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
			КонецЕсли;
			Возврат РезультатКлиент;
		КонецЕсли;
	КонецЕсли;

	// submit_for_deanonymization выполняется на клиенте (доступ к форменным атрибутам)
	Если Команда.tool = "submit_for_deanonymization" Тогда
		// Защита: инструмент недоступен при выключенной анонимизации даже при прямом вызове
		Если НЕ ИспользоватьТочнуюАнонимизацию Тогда
			Возврат Новый Структура("success, error", Ложь, "Tool is not available: anonymization is disabled");
		КонецЕсли;
		Текст = Неопределено;
		Если Команда.Свойство("params") И Команда.params <> Неопределено Тогда
			Команда.params.Свойство("text", Текст);
		КонецЕсли;
		// Валидация: "text" обязателен (схема required: ["text"]), но built-in tools/call
		// не валидирует аргументы — проверяем тип здесь. Пустая строка допустима.
		// Возвращаем обычную структуру success/error, а не СформироватьToolsCallОшибку —
		// та делает готовую MCP-обёртку, которая будет двойно упакована на уровне выше.
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат Новый Структура("success, error", Ложь, "Missing required parameter: text");
		КонецЕсли;
		Возврат ВыполнитьSubmitForDeanonymization(Текст);
	КонецЕсли;

	// get_bsl_syntax_help выполняется на клиенте (доступ к AddIn SyntaxHelpReader)
	Если Команда.tool = "get_bsl_syntax_help" Тогда
		ПараметрыBSL = Неопределено;
		Если Команда.Свойство("params") Тогда ПараметрыBSL = Команда.params; КонецЕсли;
		Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			Возврат НачатьПолучениеСправкиBSLАсинхронно(ПараметрыBSL, КонтекстВыполненияКоманды);
		КонецЕсли;
		Возврат ПолучитьСправкуПоBSL(ПараметрыBSL);
	КонецЕсли;

	// get_screenshot выполняется на клиенте (доступ к AddIn ScreenCapture и ПолучитьФорму)
	Если Команда.tool = "get_screenshot" Тогда
		ПараметрыSnap = Неопределено;
		Если Команда.Свойство("params") Тогда ПараметрыSnap = Команда.params; КонецЕсли;
		Возврат ВыполнитьПолучениеСкриншота(ПараметрыSnap, КонтекстВыполненияКоманды);
	КонецЕсли;

	Возврат ВыполнитьКомандуНаСервереСКэшированием(Команда);

КонецФункции

&НаКлиенте
Функция ВыполнитьКомандуНаСервереСКэшированием(Команда)

	Подготовка = ПодготовитьКомандуНаСервер(Команда);
	Результат = ВыполнитьСервернуюКомандуСКонтролем(Подготовка.КомандаНаСервер);
	Возврат ЗавершитьКомандуНаСервереСКэшированием(Результат, Подготовка);

КонецФункции

// Все, что делается ДО серверного вызова: копия params, токены кэша расширений и
// принудительный include_schema для execute_query. Вынесено отдельно, потому что
// фоновому заданию нужна ровно та же подготовленная команда: без include_schema
// точная анонимизация execute_query не имеет схемы и не срабатывает вовсе
// (задача 000001, шаг 3; поймано замером after_step3_on_serial).
&НаКлиенте
Функция ПодготовитьКомандуНаСервер(Команда)
	ИмяИнструмента = "";
	Попытка
		ИмяИнструмента = СокрЛП(Команда.tool);
	Исключение
		ИмяИнструмента = "";
	КонецПопытки;
	
	// Важно: Команда может быть фиксированной структурой (read-only), поэтому НЕ модифицируем ее.
	// Всегда работаем с копией params в обычной Структуре.
	ПараметрыИсходные = Неопределено;
	Если Команда.Свойство("params") Тогда
		ПараметрыИсходные = Команда.params;
	КонецЕсли;
	
	// ВАЖНО: имя "Параметры" в модуле формы может конфликтовать с одноименным
	// системным/форменным свойством (read-only). Используем уникальное имя.
	ПараметрыКоманды = Новый Структура;
	Если ПараметрыИсходные <> Неопределено Тогда
		Попытка
			Для Каждого Пара Из ПараметрыИсходные Цикл
				ПараметрыКоманды.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
		Исключение
			// Если params не коллекция/не итерируется - оставляем пустыми
		КонецПопытки;
	КонецЕсли;
	
	ИмяРасширения = Неопределено;
	Фильтр = "";
	Секции = Неопределено;
	
	Если ИмяИнструмента = "get_metadata" И ПараметрыКоманды <> Неопределено Тогда
		Если ПараметрыКоманды.Свойство("extension_name") Тогда
			ИмяРасширения = ПараметрыКоманды.extension_name;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("filter") Тогда
			Фильтр = ПараметрыКоманды.filter;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("sections") Тогда
			Секции = ПараметрыКоманды.sections;
		КонецЕсли;
		// Нормализованные настройки листания типов — общий helper с серверной валидацией;
		// при ошибке параметров ключ строится без types-суффикса: команда получит ошибку на сервере.
		НастройкиТиповКэша = Неопределено;
		ПроверкаТиповКэша = НормализоватьИПроверитьНастройкиТипов(ПараметрыКоманды);
		Если ПроверкаТиповКэша.ДетальОшибки = Неопределено Тогда
			НастройкиТиповКэша = ПроверкаТиповКэша.Настройки;
		КонецЕсли;

	КонецЕсли;
	
	КлючДеталей = "";
	
	// Добавляем токены кэша только для режима "объекты расширения" (extension_name="Имя")
	Если ИмяИнструмента = "get_metadata"
		И ИмяРасширения <> Неопределено
		И ТипЗнч(ИмяРасширения) = Тип("Строка")
		И НЕ ПустаяСтрока(ИмяРасширения) Тогда
		
		Кэш = ПолучитьКэшТокеновМетаданныхРасширений();
		Запись = Кэш.Получить(ИмяРасширения);
		
		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"hash, data_token, index_token, details, details_order",
				"",
				Неопределено,
				Неопределено,
				Новый Соответствие,
				Новый Массив
			);
			Кэш.Вставить(ИмяРасширения, Запись);
		КонецЕсли;
		
		Если Запись.hash <> "" Тогда
			ПараметрыКоманды.Вставить("mcp_cache_hash", Запись.hash);
		КонецЕсли;
		Если Запись.data_token <> Неопределено Тогда
			ПараметрыКоманды.Вставить("mcp_cache_data_token", Запись.data_token);
		КонецЕсли;
		Если Запись.index_token <> Неопределено Тогда
			ПараметрыКоманды.Вставить("mcp_cache_index_token", Запись.index_token);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(Фильтр) Тогда
			КлючДеталей = СформироватьКлючКэшаДеталейРасширения(Фильтр, Секции, НастройкиТиповКэша);
			ТокенДеталей = Запись.details.Получить(КлючДеталей);
			Если ТокенДеталей <> Неопределено Тогда
				ПараметрыКоманды.Вставить("mcp_cache_details_token", ТокенДеталей);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Передаем на сервер копию команды с измененными params (если добавили токены кэша)
	КомандаНаСервер = Новый Структура;
	Попытка
		Если Команда.Свойство("id") Тогда
			КомандаНаСервер.Вставить("id", Команда.id);
		КонецЕсли;
	Исключение
	КонецПопытки;
	АнонСхемаПринудительно = Ложь;
	Если РежимПодключения <> 0 И ИспользоватьТочнуюАнонимизацию
		И ИмяИнструмента = "execute_query" Тогда
		АнонАгентЗапросилСхему = ПараметрыКоманды.Свойство("include_schema")
			И ПараметрыКоманды.include_schema = Истина;
		Если НЕ АнонАгентЗапросилСхему Тогда
			ПараметрыКоманды.Вставить("include_schema", Истина);
			АнонСхемаПринудительно = Истина;
		КонецЕсли;
	КонецЕсли;
	КомандаНаСервер.Вставить("tool", ИмяИнструмента);
	КомандаНаСервер.Вставить("params", ПараметрыКоманды);

	Возврат Новый Структура("КомандаНаСервер, ПараметрыКоманды, АнонСхемаПринудительно, ИмяИнструмента, ИмяРасширения,
		|Фильтр, Секции, КлючДеталей, НастройкиТиповКэша",
		КомандаНаСервер, ПараметрыКоманды, АнонСхемаПринудительно, ИмяИнструмента, ИмяРасширения,
		Фильтр, Секции, КлючДеталей, НастройкиТиповКэша);

КонецФункции

// Все, что делается ПОСЛЕ серверного вызова: маркер _anon_schema_forced, синхронные
// ветки анонимизации и учет токенов кэша расширений. Фоновый путь обязан пройти
// этот же хвост, иначе get_metadata по расширению теряет кэш, а результат уносит
// наружу служебные поля mcp_cache_*.
&НаКлиенте
Функция ЗавершитьКомандуНаСервереСКэшированием(Результат, Подготовка)

	ПараметрыКоманды       = Подготовка.ПараметрыКоманды;
	АнонСхемаПринудительно = Подготовка.АнонСхемаПринудительно;
	ИмяИнструмента         = Подготовка.ИмяИнструмента;
	Если АнонСхемаПринудительно И Результат <> Неопределено
		И ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("success") И Результат.success
		И Результат.Свойство("schema") Тогда
		Результат.Вставить("_anon_schema_forced", Истина);
	КонецЕсли;
	Если НЕ ИспользоватьАсинхронноеПодключениеКомпонент И НЕ СостояниеЗащиты.Строгий Тогда
		ТекстЗапросаLineage = "";
		Если ПараметрыКоманды.Свойство("query") Тогда
			ТекстЗапросаLineage = ПараметрыКоманды.query;
		КонецЕсли;
		Если НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапросаLineage, Результат) Тогда
			Результат = ОбогатитьСхемуИсточниками(ТекстЗапросаLineage, Результат);
		КонецЕсли;
	КонецЕсли;
	Если НЕ ИспользоватьАсинхронноеПодключениеКомпонент И НЕ СостояниеЗащиты.Строгий Тогда
		Если ИмяИнструмента = "execute_query" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0
				И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			Результат = ПрименитьТочнуюPolicyКРезультатуExecuteQuery(Результат, РежимПодключения = 0,
				ПолучитьНастройкиТочнойАнонимизации(Результат));
			Если РежимПодключения <> 0 Тогда
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				АнонимизироватьРезультатВстроенный(Результат, РегексКонтекст);
				// Lazy-load и inline regex-фаза
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокены(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный(); // ПОСЛЕ regex-токенов
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("ЭтоОбъект",             Истина);
				АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныОбъект(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
				Попытка Результат.Удалить("schema");               Исключение КонецПопытки;
				Попытка Результат.Удалить("_anon_schema_forced");  Исключение КонецПопытки;
				// _original_data_json НЕ удаляем — ПолучитьТекстРезультата()
				// берёт его для журнала событий формы (отображаются НЕ анонимизированные данные).
				// Наружу (к AI) он не уйдёт — отфильтруется whitelist в финальном ответе.
				Попытка Результат.Удалить("_blind_anonymization"); Исключение КонецПопытки;
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("ЭтоFindReferences",     Истина);
				АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныFindReferences(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
				// _original_data_json НЕ удаляем - ПолучитьТекстРезультата()
				// берёт его для журнала событий формы (отображаются НЕ анонимизированные данные).
				// Наружу (к AI) он не уйдёт — отфильтруется whitelist в финальном ответе.
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "get_event_log" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("ЭтоGetEventLog",        Истина);
				АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныGetEventLog(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "get_access_rights" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				АнонимизироватьРезультатGetAccessRights(Результат);
				ОбновитьТаблицуМаппинговВстроенный();
				// _original_data_json НЕ удаляем — ПолучитьТекстРезультата()
				// берёт его для журнала событий формы (отображаются НЕ анонимизированные данные).
				// Наружу (к AI) он не уйдёт — отфильтруется whitelist в финальном ответе.
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "execute_code" И ИспользоватьТочнуюАнонимизацию И РежимПодключения <> 0 Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			РегексКонтекст = Новый Структура(
				"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
			Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
				Если КомпонентаRegex = Неопределено Тогда
					ПодключитьКомпонентуRegexСинхронно();
					Если КомпонентаRegex = Неопределено Тогда КомпонентаRegexНедоступна = Истина; КонецЕсли;
				КонецЕсли;
				Если КомпонентаRegex <> Неопределено Тогда
					СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
						РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
					ПрименитьRegexТокеныExecuteCode(РегексКонтекст, СовпаденияJSON);
				КонецЕсли;
			КонецЕсли;
			ОбновитьТаблицуМаппинговВстроенный();
		КонецЕсли;
	КонецЕсли;
	Если АнонСхемаПринудительно И НЕ ИспользоватьАсинхронноеПодключениеКомпонент И НЕ СостояниеЗащиты.Строгий
		И Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") Тогда
		Попытка Результат.Удалить("schema"); Исключение КонецПопытки;
		Попытка Результат.Удалить("_anon_schema_forced"); Исключение КонецПопытки;
	КонецЕсли;

	// Обновляем кэш по внутренним полям результата (они не уходят наружу из-за whitelist)
	ОбновитьКэшТокеновРасширения(Результат, Подготовка);
	
	Возврат Результат;
КонецФункции

// Учет токенов кэша расширений по служебным полям результата get_metadata и их удаление из результата
// (наружу они не уходят и так: whitelist полей). На фоновом пути освобождает вытесненные адреса.
//
// Параметры:
//  Результат - Структура - результат серверной команды; служебные поля mcp_cache_* удаляются
//  Подготовка - Структура - результат ПодготовитьКомандуНаСервер (+ ОсвобождатьКэшРасширения на фоновом пути)
//
&НаКлиенте
Процедура ОбновитьКэшТокеновРасширения(Результат, Подготовка)

	ИмяРасширения = Подготовка.ИмяРасширения;
	Если Подготовка.ИмяИнструмента <> "get_metadata" Или ТипЗнч(ИмяРасширения) <> Тип("Строка")
		Или ПустаяСтрока(ИмяРасширения) Или ТипЗнч(Результат) <> Тип("Структура") Тогда

		Возврат;

	КонецЕсли;

	Попытка
		Кэш = ПолучитьКэшТокеновМетаданныхРасширений();
		Запись = Кэш.Получить(ИмяРасширения);
		Если Запись = Неопределено Тогда

			Запись = Новый Структура("hash, data_token, index_token, details, details_order",
				"", Неопределено, Неопределено, Новый Соответствие, Новый Массив);

		КонецЕсли;
		Вытесненные = Новый Массив;
		Отправлено = Новый Структура("mcp_cache_index_token, mcp_cache_details_token");
		ЗаполнитьЗначенияСвойств(Отправлено, Подготовка.ПараметрыКоманды);
		ОбновитьХешЗаписиКэшаРасширения(Запись, Результат, Вытесненные);
		ОбновитьТокеныЗаписиКэшаРасширения(Запись, Результат, Подготовка, Отправлено, Вытесненные);
		Кэш.Вставить(ИмяРасширения, Запись);
		УдалитьСлужебныеПоляКэшаРасширения(Результат);
		Если Подготовка.Свойство("ОсвобождатьКэшРасширения") И Вытесненные.Количество() > 0 Тогда

			ОсвободитьАдресаКэшаРасширения(Вытесненные);

		КонецЕсли;
	Исключение
		// Учет кэша - best effort: его сбой не должен ломать ответ команды
	КонецПопытки;

КонецПроцедуры

// Регистрирует в записи кэша адреса data/index/details из результата команды.
//
// Параметры:
//  Запись - Структура - запись клиентского кэша расширения
//  Результат - Структура - результат серверной команды
//  Подготовка - Структура - результат ПодготовитьКомандуНаСервер
//  Отправлено - Структура - адреса индекса и деталей, отправленные в команде
//  Вытесненные - Массив - (выходной) адреса, покинувшие кэш
//
&НаКлиенте
Процедура ОбновитьТокеныЗаписиКэшаРасширения(Запись, Результат, Подготовка, Отправлено, Вытесненные)

	Если Результат.Свойство("mcp_cache_data_token") Тогда

		Запись.data_token = Результат.mcp_cache_data_token;

	КонецЕсли;
	Если Результат.Свойство("mcp_cache_index_token") Тогда

		ЗарегистрироватьТокенИндекса(Запись, Результат.mcp_cache_index_token,
			Отправлено.mcp_cache_index_token, Вытесненные);

	КонецЕсли;
	Если Результат.Свойство("mcp_cache_details_token") И НЕ ПустаяСтрока(Подготовка.Фильтр) Тогда

		ЗарегистрироватьТокенДеталей(Запись, КлючКэшаДеталейПодготовки(Подготовка),
			Результат.mcp_cache_details_token, Отправлено.mcp_cache_details_token, Вытесненные);

	КонецЕсли;

КонецПроцедуры

// Не светим токены в текстовых логах формы.
//
// Параметры:
//  Результат - Структура - результат серверной команды
//
&НаКлиенте
Процедура УдалитьСлужебныеПоляКэшаРасширения(Результат)

	ИменаПолей = Новый Структура("mcp_cache_hash, mcp_cache_data_token, mcp_cache_index_token, mcp_cache_details_token");
	Для Каждого ИмяПоля Из ИменаПолей Цикл

		Если Результат.Свойство(ИмяПоля.Ключ) Тогда

			Результат.Удалить(ИмяПоля.Ключ);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Новый хеш расширения из результата. Смена хеша сбрасывает запись кэша; адреса индекса
// и деталей прежней версии расширения попадают в Вытесненные.
//
// Параметры:
//  Запись - Структура - запись клиентского кэша расширения (hash, data_token, index_token, details, details_order)
//  Результат - Структура - результат серверной команды
//  Вытесненные - Массив - (выходной) адреса, покинувшие кэш
//
&НаКлиенте
Процедура ОбновитьХешЗаписиКэшаРасширения(Запись, Результат, Вытесненные)

	НовХеш = "";
	Если Результат.Свойство("mcp_cache_hash") Тогда

		НовХеш = Строка(Результат.mcp_cache_hash);

	КонецЕсли;
	Если ПустаяСтрока(НовХеш) Тогда

		Возврат;

	КонецЕсли;

	Если Запись.hash <> "" И Запись.hash <> НовХеш Тогда

		Для Каждого ЭлементДеталей Из Запись.details Цикл

			Вытесненные.Добавить(ЭлементДеталей.Значение);

		КонецЦикла;
		Если Запись.index_token <> Неопределено Тогда

			Вытесненные.Добавить(Запись.index_token);

		КонецЕсли;
		Запись.data_token = Неопределено;
		Запись.index_token = Неопределено;
		Запись.details = Новый Соответствие;
		Запись.details_order = Новый Массив;

	КонецЕсли;
	Запись.hash = НовХеш;

КонецПроцедуры

// Индекс расширения - одна запись на расширение, без очереди и предела. Попадание по адресу,
// который заменили, пока шло задание, не регистрируется: тот адрес уже освобожден.
//
// Параметры:
//  Запись - Структура - запись клиентского кэша расширения
//  Токен - Строка, Неопределено - адрес индекса из результата
//  ОтправленныйТокен - Строка, Неопределено - адрес индекса, отправленный в команде
//  Вытесненные - Массив - (выходной) адреса, покинувшие кэш
//
&НаКлиенте
Процедура ЗарегистрироватьТокенИндекса(Запись, Токен, ОтправленныйТокен, Вытесненные)

	Если Токен = Неопределено Или Токен = Запись.index_token Или Токен = ОтправленныйТокен Тогда

		Возврат;

	КонецЕсли;

	Если Запись.index_token <> Неопределено Тогда

		Вытесненные.Добавить(Запись.index_token);

	КонецЕсли;
	Запись.index_token = Токен;

КонецПроцедуры

// Детали расширения - LRU по details_order, не больше 50 ключей. Попадание по адресу, который
// покинул кэш, пока шло задание, не регистрируется и не продвигает ключ: адрес уже освобожден.
//
// Параметры:
//  Запись - Структура - запись клиентского кэша расширения
//  КлючДеталей - Строка - ключ кэша деталей (фильтр, секции, настройки типов)
//  Токен - Строка, Неопределено - адрес деталей из результата
//  ОтправленныйТокен - Строка, Неопределено - адрес деталей, отправленный в команде
//  Вытесненные - Массив - (выходной) адреса, покинувшие кэш
//
&НаКлиенте
Процедура ЗарегистрироватьТокенДеталей(Запись, КлючДеталей, Токен, ОтправленныйТокен, Вытесненные)

	СтарыйТокен = Запись.details.Получить(КлючДеталей);
	Если Токен = Неопределено Или (Токен = ОтправленныйТокен И СтарыйТокен <> Токен) Тогда

		Возврат;

	КонецЕсли;

	Если СтарыйТокен <> Неопределено И СтарыйТокен <> Токен Тогда

		Вытесненные.Добавить(СтарыйТокен);

	КонецЕсли;
	Запись.details.Вставить(КлючДеталей, Токен);

	Позиция = Запись.details_order.Найти(КлючДеталей);
	Если Позиция <> Неопределено Тогда

		Запись.details_order.Удалить(Позиция);

	КонецЕсли;
	Запись.details_order.Добавить(КлючДеталей);

	// Ограничиваем размер кэша деталей, чтобы не раздувать память/ВременноеХранилище бесконечно
	МаксДеталей = 50;
	Пока Запись.details_order.Количество() > МаксДеталей Цикл

		СтарыйКлюч = Запись.details_order[0];
		Запись.details_order.Удалить(0);
		СтарыйТокен = Запись.details.Получить(СтарыйКлюч);
		Если СтарыйТокен <> Неопределено Тогда

			Вытесненные.Добавить(СтарыйТокен);
			Запись.details.Удалить(СтарыйКлюч);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Ключ кэша деталей для подготовленной команды: заранее вычисленный или построенный по фильтру.
//
// Параметры:
//  Подготовка - Структура - результат ПодготовитьКомандуНаСервер
//
// Возвращаемое значение:
//  Строка - ключ кэша деталей расширения
//
&НаКлиенте
Функция КлючКэшаДеталейПодготовки(Подготовка)

	Если НЕ ПустаяСтрока(Подготовка.КлючДеталей) Тогда

		Возврат Подготовка.КлючДеталей;

	КонецЕсли;

	Возврат СформироватьКлючКэшаДеталейРасширения(Подготовка.Фильтр, Подготовка.Секции, Подготовка.НастройкиТиповКэша);

КонецФункции

// Освобождает адреса, покинувшие клиентский кэш расширений, одним серверным вызовом:
// УдалитьИзВременногоХранилища на клиенте обращается к серверу на каждый адрес.
//
// Параметры:
//  Адреса - Массив - адреса временного хранилища
//
&НаСервереБезКонтекста
Процедура ОсвободитьАдресаКэшаРасширения(Знач Адреса)

	Для Каждого Адрес Из Адреса Цикл

		Если ТипЗнч(Адрес) = Тип("Строка") И ЭтоАдресВременногоХранилища(Адрес) Тогда

			УдалитьИзВременногоХранилища(Адрес);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКоманду(Команда)

	// restart/close обрабатываются до обычного flow — отложенный ответ
	Если Команда.tool = "restart_1c_session" Тогда
		ВыполнитьПерезапускСессии(Команда.id);
		Возврат;
	КонецЕсли;
	Если Команда.tool = "close_1c_session" Тогда
		ВыполнитьЗакрытиеСессии(Команда.id);
		Возврат;
	КонецЕсли;

	// Формируем информативное сообщение о команде
	ТекстКоманды = ПолучитьТекстКоманды(Команда);
	ДобавитьВЛог("Получена команда: " + Команда.tool + Символы.ПС + ТекстКоманды);

	Если РежимПодключения <> 0 Тогда
		ДеАнонимизироватьПараметрыКомандыИВытеснить(Команда);
	КонецЕсли;

	// Проверка необходимости подтверждения опасной операции
	Если Команда.Свойство("params") И Команда.params <> Неопределено Тогда
		ПараметрыКоманды = Команда.params;
		
		Если ПараметрыКоманды.Свойство("requires_approval") И ПараметрыКоманды.requires_approval = Истина Тогда
			
			// Получение массива опасных ключевых слов
			МассивОпасныхСлов = Новый Массив;
			ОпасныеСлова = "";
			Если ПараметрыКоманды.Свойство("dangerous_keywords") Тогда
				Для Каждого Слово Из ПараметрыКоманды.dangerous_keywords Цикл
					МассивОпасныхСлов.Добавить(Слово);
					ОпасныеСлова = ОпасныеСлова + ?(ПустаяСтрока(ОпасныеСлова), "", ", ") + Слово;
				КонецЦикла;
			КонецЕсли;
			
 			// Проверка автоматического разрешения
 			Если ВсеОперацииАвтоРазрешены(МассивОпасныхСлов) Тогда
