// Нажатие в поле просмотра. В строгом режиме ссылки в просмотре инертны: переход по ним не выполняется,
// а действие "Открыть ссылку" передает адрес в форму подтверждения (режим open_link). В остальных режимах
// поведение просмотра прежнее.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML-документа
//  ДанныеСобытия - Структура - данные события нажатия (Href - адрес ссылки или Неопределено)
//  СтандартнаяОбработка - Булево - признак стандартной обработки нажатия
//
&НаКлиенте
Процедура ПолеТекстДляДеАнонимизацииHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если НЕ СостояниеЗащиты.Строгий Тогда

		Возврат;

	КонецЕсли;

	Href = ДанныеСобытия.Href;

	Если Href = Неопределено Тогда

		Возврат;

	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Адрес = АдресОткрытияСсылкиИзПросмотра(Href);

	Если ПустаяСтрока(Адрес) Тогда

		Возврат;

	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Инструмент", "submit_for_deanonymization");
	ПараметрыФормы.Вставить("ТекстКПодтверждению", Адрес);
	ПараметрыФормы.Вставить("Режим", "open_link");
	ЭкранироватьСтрокиПараметровФормы(ПараметрыФормы);
	Оповещение = Новый ОписаниеОповещения("ПослеРешенияОткрытияСсылки", ЭтаФорма, Адрес);
	ОткрытьФорму("ВнешняяОбработка.MCPToolkit.Форма.ФормаСтрогогоПодтверждения", ПараметрыФормы, ЭтаФорма,
		"open_link", , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Обработчик закрытия формы подтверждения открытия ссылки: переход выполняется только после подтверждения.
