|mcp_transition() {
|python3 - ""$MCP_OPERATION"" ""$1"" ""$2"" <<'MCP_COORDINATION'
|import fcntl
|from pathlib import Path
|import sys
|root, expected, target = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
|try:
|    with (root / 'guard').open('r+b') as guard:
|        fcntl.lockf(guard.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
|        state_path = root / 'state'
|        state = state_path.read_text(encoding='utf-8-sig').strip()
|        if state == expected:
|            state_path.write_text(target, encoding='utf-8')
|            print('won')
|        else:
|            print(state)
|except (OSError, UnicodeError):
|    print('unavailable')
|MCP_COORDINATION
|}
|mcp_stop() {
|    local outcome retry
|    for retry in {1..20}; do
|        outcome=$(mcp_transition pending revoked)
|        if [ ""$outcome"" != unavailable ]; then
|            case ""$outcome"" in
|                accepted) echo 'The operation was already accepted by 1C; readiness is unknown. No additional client was started.' ;;
|                won)
|                    [ -z ""$MCP_PARAMS"" ] || rm -f -- ""$MCP_PARAMS""
|                    [ -z ""$MCP_MAPPINGS"" ] || rm -f -- ""$MCP_MAPPINGS""
|                    echo 'The pending operation was revoked. A late client cannot accept it.' ;;
|                revoked) echo 'The pending operation was revoked. A late client cannot accept it.' ;;
|            esac
|            return
|        fi
|        sleep 0.05
|    done
|    echo 'Operation ownership is unavailable; readiness is unknown. Do not repeat this command.'
|}
|if [ ""$(mcp_transition prepared pending)"" != won ]; then
|    echo 'This launch operation was already started, revoked, or is unavailable. No new client was started.'
|    exit 1
|fi";
