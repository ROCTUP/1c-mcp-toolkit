	ШаблонСФлагом = СтрЗаменить(ШаблонMarkdownПросмотра, "{{INERT_MODE}}", ?(СостояниеЗащиты.Строгий, "1", "0"));
	ТекстДляДеАнонимизацииHTML = СтрЗаменить(ШаблонСФлагом, "{{HTML_ESCAPED_CONTENT}}", КонтентHTML);
