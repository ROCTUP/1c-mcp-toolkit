// Перехват и подтверждение анонимизации
// ─────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция ПроверитьПодтверждениеАнонимизации(Результат, ДанныеЗапроса, Ид, ИдПотока, Режим = "")
	Если НЕ ПодтверждениеАнонимизации Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Результат.Свойство("_original_data_anon_marker") Тогда
		Возврат Ложь;
	КонецЕсли;
	ДанныеРезультата = Неопределено;
	Если НЕ Результат.Свойство("data", ДанныеРезультата) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ДанныеРезультата = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(ДанныеРезультата) = Тип("Массив") И ДанныеРезультата.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ОригиналJSON = "";
	Результат.Свойство("_original_data_json", ОригиналJSON);
	АнонимJSON = ЗаписатьJSON2(Результат.data);

	HTMLДанные = СформироватьHTMLДляСравненияАнонимизации(ОригиналJSON, АнонимJSON);

	КонтекстОтвета = Новый Структура(
		"Результат, ДанныеЗапроса, Ид, ИдПотока, Режим",
		Результат, ДанныеЗапроса, Ид, ИдПотока, Режим);

	ТекстЗапросаДляФормы = "";
	Результат.Свойство("_cmd_arguments_json", ТекстЗапросаДляФормы);
	ТекстЗапросаДляФормы = СтрЗаменить(ТекстЗапросаДляФормы, "\n", Символы.ПС);
	ТекстЗапросаДляФормы = СтрЗаменить(ТекстЗапросаДляФормы, "\t", Символы.Таб);

	ОткрытьФорму(
		"ВнешняяОбработка.MCPToolkit.Форма.ФормаПодтверждениеАнонимизации",
		Новый Структура("HTMLОригинал, HTMLАнонимизированный, ТекстЗапроса",
			HTMLДанные.Оригинал, HTMLДанные.Анонимизированный, ТекстЗапросаДляФормы),
		ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ПослеПодтверждениеАнонимизации", ЭтаФорма, КонтекстОтвета),
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПослеПодтверждениеАнонимизации(РезультатФормы, КонтекстОтвета) Экспорт
	// REST-ветка: HTTP-ответ вместо SSE
	Если КонтекстОтвета.Режим = "rest" Тогда
		Если РезультатФормы = Истина Тогда
			Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(КонтекстОтвета.Результат);
			Если ИспользоватьАсинхронноеПодключениеКомпонент И КомпонентаТун <> Неопределено
				И ФорматОтветаВстроенный = 1 И ТипЗнч(Результат) = Тип("Структура")
				И Результат.Свойство("success") И Результат.success И Результат.Свойство("data") Тогда
				КомпонентаТун.НачатьВызовJsonToToon(
					Новый ОписаниеОповещения("ПослеJsonToToonREST", ЭтаФорма,
						Новый Структура("ДанныеЗапроса, Результат",
							КонтекстОтвета.ДанныеЗапроса, Результат)),
					ЗаписатьJSON2(Результат.data));
				Возврат;
			КонецЕсли;
			ПрименитьТунКонвертацию(Результат);
			КомпонентаSendResponse(КонтекстОтвета.ДанныеЗапроса.id, 200,
				ЗаголовкиJSON(), ЗаписатьJSON2(Результат));
		Иначе
			ОтветОтказ = Новый Структура("success, error", Ложь,
				"Пользователь отклонил передачу данных агенту.");
			КомпонентаSendResponse(КонтекстОтвета.ДанныеЗапроса.id, 200,
				ЗаголовкиJSON(), ЗаписатьJSON2(ОтветОтказ));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	// MCP/SSE-ветка
	Если РезультатФормы = Истина Тогда
		ТулКолРез = СформироватьToolsCallРезультат(
			КонтекстОтвета.Результат,
			КонтекстОтвета.ДанныеЗапроса,
			КонтекстОтвета.Ид,
			КонтекстОтвета.ИдПотока);
		Если ТулКолРез = Неопределено Тогда
			Возврат; // async TOON — уйдёт сам
		КонецЕсли;
		ОтветJSON = СформироватьJSONRPCОтвет(КонтекстОтвета.Ид, ТулКолРез);
	Иначе
		ОтветОтказ = Новый Структура("success, error", Ложь,
			"Пользователь отклонил передачу данных агенту.");
		ОтветJSON = СформироватьJSONRPCОтвет(КонтекстОтвета.Ид,
			СформироватьToolsCallРезультат(ОтветОтказ));
	КонецЕсли;

	Если ЗначениеЗаполнено(КонтекстОтвета.ИдПотока) Тогда
		КомпонентаSendSSEEvent(КонтекстОтвета.ИдПотока, ОтветJSON, "{}", "message");
	Иначе
		ОтправитьSSEОтвет(КонтекстОтвета.ДанныеЗапроса, ОтветJSON);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьТочнуюPolicyКSchema(Schema, ПравилаТочнойАнонимизации, КешРазыменования = Неопределено, АгрессивныйРежим = Ложь)

	Колонки = Неопределено;
	Если НЕ Schema.Свойство("columns", Колонки) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Колонка.Вставить("anonymization_mode", "default");
		Колонка.Вставить("reference_presentation_mode", "default");
		Если ЭтоБулеваКолонкаСхемы(Колонка) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоПеречислениеКолонкаСхемы(Колонка) Тогда
			Колонка.Вставить("anonymization_mode", "force_keep");
			Колонка.Вставить("reference_presentation_mode", "force_keep");
			Продолжить;
		КонецЕсли;

		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		ТекущийРежим = ВычислитьРежимПоSources(Sources, ПравилаТочнойАнонимизации);
		Если ТекущийРежим = "default" И КешРазыменования <> Неопределено Тогда
			ТекущийРежим = ВычислитьРежимПоSourcesИзКеша(Sources, ПравилаТочнойАнонимизации, КешРазыменования);
		КонецЕсли;
		// Строковые колонки, чьи источники через метаданные ведут к ПланыСчетов —
		// защищаем по умолчанию (например, СчетДт.Представление, СчетДт.Код).
		Если КолонкаСтроковаяПоСхеме(Колонка)
			И ТекущийРежим <> "force_anonymize"
			И ИсточникиВедутКПланамСчетов(Sources) Тогда
			Колонка.Вставить("anonymization_mode", "force_keep");
			Колонка.Вставить("reference_presentation_mode", "force_keep");
			Продолжить;
		КонецЕсли;
		Если АгрессивныйРежим И ТекущийРежим = "default" И КолонкаСтроковаяПоСхеме(Колонка) Тогда
			ТекущийРежим = "force_anonymize";
		КонецЕсли;
		РежимПредставленияСсылки = ВычислитьРежимПредставленияСсылки(Колонка, Sources, ПравилаТочнойАнонимизации);
		// Планы счетов — нормативные данные без персональных данных: по умолчанию не анонимизируем.
		// Оба режима уже вычислены из явных правил. Если нет явного force_anonymize — защищаем.
		Если ЭтоПланСчетовКолонкаСхемы(Колонка)
			И ТекущийРежим <> "force_anonymize"
			И РежимПредставленияСсылки <> "force_anonymize" Тогда
			Колонка.Вставить("anonymization_mode", "force_keep");
			Колонка.Вставить("reference_presentation_mode", "force_keep");
			Продолжить;
		КонецЕсли;
		Если АгрессивныйРежим И РежимПредставленияСсылки = "default" И КолонкаСсылочнаяПоСхеме(Колонка) Тогда
			РежимПредставленияСсылки = "force_anonymize";
		КонецЕсли;

		Если КолонкаСтроковаяПоСхеме(Колонка) И РежимПредставленияСсылки <> "default" Тогда
			ТекущийРежим = ОбъединитьРежимыPolicy(ТекущийРежим, РежимПредставленияСсылки);
		Иначе
			Колонка.Вставить("reference_presentation_mode", РежимПредставленияСсылки);
		КонецЕсли;

		Колонка.Вставить("anonymization_mode", ТекущийРежим);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НуженКешРазыменования(Schema, ПравилаТочнойАнонимизации)

	Колонки = Неопределено;
	Если НЕ Schema.Свойство("columns", Колонки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		Для Каждого SourcePath Из Sources Цикл
			Если ПравилаТочнойАнонимизации.Получить(SourcePath) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КоличествоТочек = СтрДлина(SourcePath) - СтрДлина(СтрЗаменить(SourcePath, ".", ""));
			Если КоличествоТочек >= 3 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиВКоллекцииПоИмени(Коллекция, ИмяПоля)
	Попытка
		Для Каждого Рекв Из Коллекция Цикл
			Если НРег(Рекв.Имя) = НРег(ИмяПоля) Тогда
				Возврат Рекв;
			КонецЕсли;
		КонецЦикла;
	Исключение КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиРеквизитВКоллекциях(ОбъектМД, ИмяПоля)

	Рекв = Неопределено;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.СтандартныеРеквизиты, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.Реквизиты, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.Измерения, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.Ресурсы, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Попытка
		Рекв = НайтиВКоллекцииПоИмени(ОбъектМД.РеквизитыАдресации, ИмяПоля);
	Исключение КонецПопытки;
	Если Рекв <> Неопределено Тогда Возврат Рекв; КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция РазрешитьВиртуальныйОбъектРегистраБухгалтерии(ОбъМД, ИмяСегмента)
	// Если текущий объект — РегистрБухгалтерии И сегмент — одно из виртуальных
	// полей счёта (Счет, СчетДт, СчетКт), возвращает объект метаданных плана счетов.
	// В остальных случаях возвращает Неопределено.
	Если ОбъМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПолноеИмя = "";
	Попытка
		ПолноеИмя = ОбъМД.ПолноеИмя();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Лев(ПолноеИмя, СтрДлина("РегистрБухгалтерии.")) <> "РегистрБухгалтерии." Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНиж = НРег(ИмяСегмента);
	Если ИмяНиж <> "счет" И ИмяНиж <> "счетдт" И ИмяНиж <> "счеткт" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПланМД = Неопределено;
	Попытка
		ПланМД = ОбъМД.ПланСчетов;
	Исключение
	КонецПопытки;

	Возврат ПланМД;

КонецФункции

&НаСервереБезКонтекста
Функция РазрешитьПутиРазыменования(SourcePath)

	Результат = Новый Массив;
	Части = РазделитьСтрокуПоРазделителю(SourcePath, ".");

	Если Части.Количество() <= 3 Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяОбъекта = Части[0] + "." + Части[1];
	ТекущийОбъект = Неопределено;
	Попытка
		ТекущийОбъект = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Исключение КонецПопытки;
	Если ТекущийОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ТекущиеОбъекты = Новый Массив;
	ТекущиеОбъекты.Добавить(ТекущийОбъект);

	КоличествоЧастей = Части.Количество();
	Для Инд = 2 По КоличествоЧастей - 2 Цикл
		СледующиеОбъектыСет = Новый Соответствие;
		Для Каждого ОбъМД Из ТекущиеОбъекты Цикл
			ИмяСегмента = Части[Инд];
			Реквизит = НайтиРеквизитВКоллекциях(ОбъМД, ИмяСегмента);
			Если Реквизит <> Неопределено Тогда
				Попытка
					Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
						СледОбъект = Неопределено;
						Попытка
							СледОбъект = Метаданные.НайтиПоТипу(Тип);
						Исключение КонецПопытки;
						Если СледОбъект <> Неопределено Тогда
							СледующиеОбъектыСет.Вставить(СледОбъект.ПолноеИмя(), СледОбъект);
						КонецЕсли;
					КонецЦикла;
				Исключение КонецПопытки;
			Иначе
				// Fallback: виртуальные поля счёта у РегистраБухгалтерии (СчетДт, СчетКт, Счет)
				ВиртуальныйОбъект = РазрешитьВиртуальныйОбъектРегистраБухгалтерии(ОбъМД, ИмяСегмента);
				Если ВиртуальныйОбъект <> Неопределено Тогда
					СледующиеОбъектыСет.Вставить(ВиртуальныйОбъект.ПолноеИмя(), ВиртуальныйОбъект);
				КонецЕсли;
			КонецЕсли;
			// Fallback: сегмент может быть табличной частью (Товары, Строки и т.п.)
			Попытка
				ТабЧасть = ОбъМД.ТабличныеЧасти.Найти(ИмяСегмента);
				Если ТабЧасть <> Неопределено Тогда
					СледующиеОбъектыСет.Вставить(ОбъМД.ПолноеИмя() + "." + ИмяСегмента, ТабЧасть);
				КонецЕсли;
			Исключение КонецПопытки;
			Попытка
				ТабЧасть = ОбъМД.СтандартныеТабличныеЧасти.Найти(ИмяСегмента);
				Если ТабЧасть <> Неопределено Тогда
					СледующиеОбъектыСет.Вставить(ОбъМД.ПолноеИмя() + "." + ИмяСегмента, ТабЧасть);
				КонецЕсли;
			Исключение КонецПопытки;
		КонецЦикла;
		СледующиеОбъекты = Новый Массив;
		Для Каждого КвП Из СледующиеОбъектыСет Цикл
			СледующиеОбъекты.Добавить(КвП.Значение);
		КонецЦикла;
		ТекущиеОбъекты = СледующиеОбъекты;
		Если ТекущиеОбъекты.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	ИмяПоследнегоПоля = Части[КоличествоЧастей - 1];
	РезультатСет = Новый Соответствие;
	Для Каждого ОбъМД Из ТекущиеОбъекты Цикл
		Попытка
			РезультатСет.Вставить(ОбъМД.ПолноеИмя() + "." + ИмяПоследнегоПоля, Истина);
		Исключение КонецПопытки;
	КонецЦикла;
	Для Каждого КвП Из РезультатСет Цикл
		Результат.Добавить(КвП.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ВычислитьКешРазыменованияДляSchema(Schema, ПравилаТочнойАнонимизации)

	Кеш = Новый Соответствие;
	Колонки = Неопределено;
	Если НЕ Schema.Свойство("columns", Колонки) Тогда
		Возврат Кеш;
	КонецЕсли;
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Кеш;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		Для Каждого SourcePath Из Sources Цикл
			Если Кеш.Получить(SourcePath) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ПравилаТочнойАнонимизации.Получить(SourcePath) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Части = РазделитьСтрокуПоРазделителю(SourcePath, ".");
			Если Части.Количество() <= 3 Тогда
				Продолжить;
			КонецЕсли;
			КандидатыВсе = РазрешитьПутиРазыменования(SourcePath);
			КандидатыПути = Новый Массив;
			Для Каждого КандидатПуть Из КандидатыВсе Цикл
				Если ПравилаТочнойАнонимизации.Получить(КандидатПуть) <> Неопределено Тогда
					КандидатыПути.Добавить(КандидатПуть);
				КонецЕсли;
			КонецЦикла;
			Кеш.Вставить(SourcePath, КандидатыПути);
		КонецЦикла;
	КонецЦикла;

	Возврат Кеш;

