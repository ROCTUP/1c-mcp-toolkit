+ "}" + Символы.ПС
+ "Write-Output ""Session start timeout after $timeout seconds""" + Символы.ПС
+ "Remove-Item ($MyInvocation.MyCommand.Path) -Force -ErrorAction SilentlyContinue" + Символы.ПС
+ "exit 1";
		КонецЕсли;
	Иначе
		// Linux/Mac — bash
		ЕБашExe    = ЭкранироватьБашОдинарнаяКавычка(ПутьExe);
		ЕБашПарамс = ЭкранироватьБашОдинарнаяКавычка(ПутьПараметров);
		ЕБашСигнал = ЭкранироватьБашОдинарнаяКавычка(ПутьСигнала);

		Если РежимАутентификации = 0 Тогда
			AUTH_ARGS = "/WA";
		Иначе
			AUTH_ARGS = "/N '" + ЭкранироватьБашОдинарнаяКавычка(ИмяПольз) + "'";
		КонецЕсли;

		Если НЕ НуженПароль Тогда
			Текст =
"#!/bin/bash" + Символы.ПС
+ "SIGNAL_PATH='" + ЕБашСигнал + "'" + Символы.ПС
+ "SCRIPT_PATH=""$0""" + Символы.ПС
+ "TS=$(date +%Y%m%d%H%M%S)" + Символы.ПС
+ "'" + ЕБашExe + "' ENTERPRISE /IBConnectionString '" + ЭкранироватьБашОдинарнаяКавычка(СтрСоед) + "' /Execute '" + ЭкранироватьБашОдинарнаяКавычка(ПутьОбработки) + "' /C 'coldstart;'" + """" + "$TS" + """" + "';'" + ЕБашПарамс + "' " + AUTH_ARGS + " &" + Символы.ПС
+ "TIMEOUT=120; ELAPSED=0" + Символы.ПС
+ "while [ $ELAPSED -lt $TIMEOUT ]; do" + Символы.ПС
+ "    if [ -f ""$SIGNAL_PATH"" ]; then" + Символы.ПС
+ "        CONTENT=$(cat ""$SIGNAL_PATH""); rm -f ""$SIGNAL_PATH""; rm -f ""$SCRIPT_PATH""" + Символы.ПС
+ "        [ ""$CONTENT"" = ""ready"" ] && echo 'Session started successfully. Note: the first MCP request to the new session may fail - retry once if it does.' && exit 0" + Символы.ПС
+ "        echo ""Session start failed: $CONTENT""; exit 1" + Символы.ПС
+ "    fi" + Символы.ПС
+ "    sleep 3; ELAPSED=$((ELAPSED + 3))" + Символы.ПС
+ "done" + Символы.ПС
+ "echo ""Session start timeout after ${TIMEOUT} seconds""; rm -f ""$SCRIPT_PATH""; exit 1";
		Иначе
			ЕБашПольз = ЭкранироватьБашОдинарнаяКавычка(ИмяПольз);
			Текст =
"#!/bin/bash" + Символы.ПС
+ "SCRIPT_PATH=""$0""" + Символы.ПС
+ "command -v python3 >/dev/null 2>&1 || { echo 'python3 not found on PATH'; rm -f ""$SCRIPT_PATH""; exit 127; }" + Символы.ПС
+ "ENC_PWD='" + ЗашифрПароль + "'" + Символы.ПС
+ "LAUNCH_PASSWORD=$(python3 - ""$ENC_PWD"" ""$1"" <<'PYEOF'" + Символы.ПС
+ "import sys, base64" + Символы.ПС
+ "try:" + Символы.ПС
+ "    data = base64.b64decode(sys.argv[1])" + Символы.ПС
+ "    key = ('MCPColdLaunch-v1-n8Tz5rWj-' + sys.argv[2]).encode()" + Символы.ПС
+ "    print(bytes(b ^ key[i % len(key)] for i,b in enumerate(data)).decode(), end='')" + Символы.ПС
+ "except Exception as e:" + Символы.ПС
+ "    sys.stderr.write(str(e)+'\\n'); sys.exit(1)" + Символы.ПС
+ "PYEOF" + Символы.ПС
+ ")" + Символы.ПС
+ "rc=$?" + Символы.ПС
+ "[ $rc -eq 0 ] || { echo 'password decrypt failed'; rm -f ""$SCRIPT_PATH""; exit 1; }" + Символы.ПС
+ "[ -n ""$LAUNCH_PASSWORD"" ] || { echo 'password decrypt failed: empty result'; rm -f ""$SCRIPT_PATH""; exit 1; }" + Символы.ПС
+ "SIGNAL_PATH='" + ЕБашСигнал + "'" + Символы.ПС
+ "TS=$(date +%Y%m%d%H%M%S)" + Символы.ПС
+ "'" + ЕБашExe + "' ENTERPRISE /IBConnectionString '" + ЭкранироватьБашОдинарнаяКавычка(СтрСоед) + "' /Execute '" + ЭкранироватьБашОдинарнаяКавычка(ПутьОбработки) + "' /C 'coldstart;'" + """" + "$TS" + """" + "';'" + ЕБашПарамс + "' /N '" + ЕБашПольз + "' /P ""$LAUNCH_PASSWORD"" &" + Символы.ПС
+ "TIMEOUT=120; ELAPSED=0" + Символы.ПС
+ "while [ $ELAPSED -lt $TIMEOUT ]; do" + Символы.ПС
+ "    if [ -f ""$SIGNAL_PATH"" ]; then" + Символы.ПС
+ "        CONTENT=$(cat ""$SIGNAL_PATH""); rm -f ""$SIGNAL_PATH""; rm -f ""$SCRIPT_PATH""" + Символы.ПС
+ "        [ ""$CONTENT"" = ""ready"" ] && echo 'Session started successfully. Note: the first MCP request to the new session may fail - retry once if it does.' && exit 0" + Символы.ПС
+ "        echo ""Session start failed: $CONTENT""; exit 1" + Символы.ПС
+ "    fi" + Символы.ПС
+ "    sleep 3; ELAPSED=$((ELAPSED + 3))" + Символы.ПС
+ "done" + Символы.ПС
+ "echo ""Session start timeout after ${TIMEOUT} seconds""; rm -f ""$SCRIPT_PATH""; exit 1";
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;
КонецФункции

&НаКлиенте
Функция ХолодныйВременныйФайл(Назначение)
	Возврат КаталогВременныхФайлов() + "cold_" + Строка(Новый УникальныйИдентификатор) + "_" + Назначение;
КонецФункции

&НаКлиенте
Процедура ВыполнитьЗакрытиеСессии(КомандаИД, ДанныеЗапросаEmb = Неопределено, ИдЗапросаEmb = "", ИдПотокаEmb = "", ВызовИзREST = Ложь, КонтекстИсточника = Неопределено,
	БезКартыТокенов = Ложь)
	Если КонтекстИсточника = Неопределено Тогда КонтекстИсточника = ДанныеЗапросаEmb; КонецЕсли;

	// Guard: отвечаем через сырые аргументы ДО установки глобалей — точно как restart
	Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
		Если РежимПодключения = 0 Тогда
			ОтправитьРезультатНаСервер(АдресСервера, КомандаИД,
				Новый Структура("success,error", Ложь, "Restart or close already in progress"), , , КонтекстИсточника);
		ИначеЕсли ВызовИзREST Тогда
			ИдRESTЗапр = "";
			Попытка
				Если ДанныеЗапросаEmb <> Неопределено Тогда
					ИдRESTЗапр = Строка(ДанныеЗапросаEmb.id);
				КонецЕсли;
			Исключение КонецПопытки;
			Если ЗначениеЗаполнено(ИдRESTЗапр) Тогда
				РезТело = ЗаписатьJSON2(РезультатСИсточникомБазы(
					Новый Структура("success,error", Ложь, "Restart or close already in progress"), КонтекстИсточника));
				Попытка
					КомпонентаSendResponse(ИдRESTЗапр, 500, ЗаголовкиJSON(), РезТело);
				Исключение
					ДобавитьВЛог("close REST guard: SendResponse error: " + ОписаниеОшибки());
				КонецПопытки;
			Иначе
				ДобавитьВЛог("close REST guard: request ID lost, cannot send error response");
			КонецЕсли;
		Иначе
			Сод = Новый Массив;
			Сод.Добавить(Новый Структура("type,text", "text", "Error: Restart or close already in progress"));
			ОтвJSON = СформироватьJSONRPCОтвет(ИдЗапросаEmb,
				СодержимоеСИсточникомБазы(Новый Структура("content,isError", Сод, Истина), КонтекстИсточника));
			Если ПустаяСтрока(ИдПотокаEmb) Тогда
				ОтправитьSSEОтвет(ДанныеЗапросаEmb, ОтвJSON);
			Иначе
				КомпонентаSendSSEEvent(ИдПотокаEmb, ОтвJSON, "{}", "message");
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗакрытиеСессииВПроцессе = Истина;

	// Устанавливаем глобали ПОСЛЕ guard (совпадает с паттерном restart)
	ЭтоRESTЗапросПерезапуска = ВызовИзREST;
	ИдКомандыПерезапуска     = КомандаИД;
	КонтекстИсточникаПерезапуска = КонтекстИсточника;
	СтрогийПриПерезапуске = СостояниеЗащиты.Строгий Или СостояниеЗащиты.Переключение;
	ДанныеЗапросаПерезапуска = ДанныеЗапросаEmb;
	ИдЗапросаПерезапуска     = ИдЗапросаEmb;
	ИдПотокаПерезапуска      = ИдПотокаEmb;
	ИдRESTЗапросаПерезапуска = "";
	Если ВызовИзREST Тогда
		Попытка
			Если ДанныеЗапросаEmb <> Неопределено Тогда
				ИдRESTЗапросаПерезапуска = Строка(ДанныеЗапросаEmb.id);
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЕсли;

	Если РежимПодключения <> 0 И ПоддерживаетсяОжиданиеФинальногоОтвета <> Истина Тогда
		ЗакрытиеСессииВПроцессе = Ложь;
		ОтправитьОтветПерезапуска(Ложь, "Embedded close/restart requires an updated MCPHttpTransport component with terminal response waiting support.");
		Возврат;
	КонецЕсли;

	ПутьПараметров = "";
	ПутьМаппингов  = "";
	ПутьСкрипта    = "";
	ПутьСигнала    = "";

	Попытка

		СисИнфо    = Новый СистемнаяИнформация();
		ЭтоWindows = СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86
			Или СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86_64;
		Если РежимАутентификацииПерезапуска = 0 И НЕ ЭтоWindows Тогда
			ЗакрытиеСессииВПроцессе = Ложь;
			ОтправитьОтветПерезапуска(Ложь, "Windows authentication is not available on the current OS");
			Возврат;
		КонецЕсли;
		ОшибкаВалидации = ПроверитьНастройкиПерезапускаНаСервере(
			РежимАутентификацииПерезапуска, ЗначениеЗаполнено(ПарольПерезапуска));
		Если ОшибкаВалидации <> "" Тогда
			ЗакрытиеСессииВПроцессе = Ложь;
			ОтправитьОтветПерезапуска(Ложь, ОшибкаВалидации);
			Возврат;
		КонецЕсли;
		ПодготовленныйИсточник = МКППодготовитьИсточникЗапуска();
		ПутьОбработки = ПодготовленныйИсточник.path;
		Если НЕ ЗначениеЗаполнено(ПутьОбработки) Тогда
			ЗакрытиеСессииВПроцессе = Ложь;
			ОтправитьОтветПерезапуска(Ложь, "Cannot close: data processor path not available");
			Возврат;
		КонецЕсли;
		ФайлОбработкиПроверка = Новый Файл(ПутьОбработки);
		Если НЕ ФайлОбработкиПроверка.Существует() Тогда
			ЗакрытиеСессииВПроцессе = Ложь;
			ОтправитьОтветПерезапуска(Ложь, "Cannot close: data processor file not found: " + ПутьОбработки);
			Возврат;
		КонецЕсли;

		ПутьПараметров = ХолодныйВременныйФайл("params.json");
		ПутьСигнала    = ХолодныйВременныйФайл("signal.txt");

		МСПМассив = Новый Массив;
		Если РежимПодключения = 1 И МСПСессии <> Неопределено Тогда
			Для Каждого П Из МСПСессии Цикл
				МСПМассив.Добавить(П.Ключ);
			КонецЦикла;
		КонецЕсли;

		ЗашифрованныйПароль = ЗашифроватьПарольПерезапуска(
			?(РежимАутентификацииПерезапуска = 1, ПарольПерезапуска, ""));

		ПутьМаппингов = "";
		Если РежимПодключения = 1 И КартаТокеновПишетсяВФайлПерезапуска(БезКартыТокенов) Тогда
			ПутьМаппингов = СохранитьМаппингиАнонимизацииВоВременныйФайл(ХолодныйВременныйФайл("maps.json"));
		КонецЕсли;

		НуженЛаунчерСПаролем = (РежимАутентификацииПерезапуска = 1) И ЗначениеЗаполнено(ПарольПерезапуска);

		ЗашифрПарольЗапуска = "";
		ЧастьКлюча2         = "";
		Если НуженЛаунчерСПаролем Тогда
			Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
			ГСЧ = Новый ГенераторСлучайныхЧисел();
			Для Счетчик = 1 По 20 Цикл
				ЧастьКлюча2 = ЧастьКлюча2 + Сред(Алфавит, ГСЧ.СлучайноеЧисло(1, 62), 1);
			КонецЦикла;
			ХолодныйКлюч = "MCPColdLaunch-v1-n8Tz5rWj-" + ЧастьКлюча2;
			ЗашифрПарольЗапуска = ЗашифроватьПарольПерезапуска(ПарольПерезапуска, ХолодныйКлюч);
		КонецЕсли;

		#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
			ИмяExe = "1cv8" + ?(ЭтоWindows, ".exe", "");
		#ИначеЕсли ТонкийКлиент Тогда
			ИмяExe = "1cv8c" + ?(ЭтоWindows, ".exe", "");
		#КонецЕсли
		ПутьExe  = КаталогПрограммы() + ИмяExe;
		СтрСоед  = СтрокаСоединенияИнформационнойБазы();
		ИмяПольз = ?(РежимАутентификацииПерезапуска = 1, ПолучитьИмяТекущегоПользователяНаСервере(), "");

		ПараметрыЗапуска = Новый Структура(
			"mcp_sessions,restart_password,mappings_path,launch_password,signal_path,conn_str,epf_path,username,auth_mode",
			МСПМассив, ЗашифрованныйПароль, ПутьМаппингов, ЗашифрПарольЗапуска, ПутьСигнала,
			СтрСоед, ПутьОбработки, ИмяПольз, РежимАутентификацииПерезапуска);
		ДобавитьФлагиОпасныхОперацийВПараметрыПерезапуска(ПараметрыЗапуска);
		МКПДополнитьДанныеЗапуска(ПараметрыЗапуска, ПодготовленныйИсточник, Истина);
		ЗТПараметры = Новый ЗаписьТекста(ПутьПараметров, КодировкаТекста.UTF8);
		Попытка
			ЗТПараметры.Записать(ЗаписатьJSON2(ПараметрыЗапуска));
		Исключение
			Попытка ЗТПараметры.Закрыть(); Исключение КонецПопытки;
			ВызватьИсключение;
		КонецПопытки;
		ЗТПараметры.Закрыть();

		ПутьСкрипта = ХолодныйВременныйФайл(?(ЭтоWindows, "launch.ps1", "launch.sh"));
		ТекстСкрипта = СформироватьТекстЛаунчераХолодногоСтарта(
			ЭтоWindows, ПутьExe, СтрСоед, ПутьОбработки, ПутьПараметров, ИмяПольз,
			ЗашифрПарольЗапуска, РежимАутентификацииПерезапуска, ПутьСигнала);
		Если ПараметрыЗапуска.Свойство("source") Тогда
			ТекстСкрипта = МКПСкриптРегистрационногоЗапуска(ТекстСкрипта, ЭтоWindows,
				ПараметрыЗапуска.operation_dir, ПутьПараметров, ПутьМаппингов);
		КонецЕсли;
		ЗТЛаунч = Новый ЗаписьТекста(ПутьСкрипта, КодировкаТекста.UTF8);
		Попытка
			ЗТЛаунч.Записать(ТекстСкрипта);
		Исключение
			Попытка ЗТЛаунч.Закрыть(); Исключение КонецПопытки;
			ВызватьИсключение;
		КонецПопытки;
		ЗТЛаунч.Закрыть();

		ПутьСкриптаEsc = ?(ЭтоWindows,
			СтрЗаменить(ПутьСкрипта, "'", "''"),
			СтрЗаменить(ПутьСкрипта, "'", "'\''"));
		ЧастьКлюча2Esc = "";
		Если НуженЛаунчерСПаролем Тогда
			ЧастьКлюча2Esc = ?(ЭтоWindows,
				СтрЗаменить(ЧастьКлюча2, "'", "''"),
				СтрЗаменить(ЧастьКлюча2, "'", "'\''"));
		КонецЕсли;
		КомандаЗапуска = ?(ЭтоWindows,
			"powershell -ExecutionPolicy Bypass -File '" + ПутьСкриптаEsc + "'"
				+ ?(НуженЛаунчерСПаролем, " '" + ЧастьКлюча2Esc + "'", ""),
			"bash '" + ПутьСкриптаEsc + "'"
				+ ?(НуженЛаунчерСПаролем, " '" + ЧастьКлюча2Esc + "'", ""));

		ТекстОтвета = "Session closed. To start a new session, run:"
			+ Символы.ПС + КомандаЗапуска
			+ Символы.ПС + "Run synchronously. Exit 0 = session ready. Non-zero = startup failed."
			+ " On Windows, run this command in PowerShell (not cmd.exe)."
			+ " On timeout: startup state is unknown — check whether 1C was already started before launching another."
			+ " This launch command is single-use. After a failure, prepare a new command; do not assume the client was closed.";

		Если РежимПодключения = 0 Тогда
			ДобавитьВЛог("close_1c_session launch command: " + КомандаЗапуска);
			ОтправитьОтветПерезапуска(Истина, ТекстОтвета);
			Попытка ОтключитьсяОтСервера(); Исключение КонецПопытки;
			ЗавершитьРаботуСистемы(Ложь);
		Иначе
			ОтправитьОтветПерезапускаИЗавершитьEmbedded(ТекстОтвета);
		КонецЕсли;

	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ДобавитьВЛог("close_1c_session error: " + ТекстОшибки);
		Попытка Если ЗначениеЗаполнено(ПутьСкрипта)    Тогда УдалитьФайлы(ПутьСкрипта);    КонецЕсли; Исключение КонецПопытки;
		Попытка Если ЗначениеЗаполнено(ПутьПараметров) Тогда УдалитьФайлы(ПутьПараметров); КонецЕсли; Исключение КонецПопытки;
		Попытка Если ЗначениеЗаполнено(ПутьМаппингов)  Тогда УдалитьФайлы(ПутьМаппингов);  КонецЕсли; Исключение КонецПопытки;
		Попытка Если ЗначениеЗаполнено(ПутьСигнала)    Тогда УдалитьФайлы(ПутьСигнала);    КонецЕсли; Исключение КонецПопытки;
		ЗакрытиеСессииВПроцессе = Ложь;
		ОтправитьОтветПерезапуска(Ложь, "close_1c_session error: " + ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСтаруюСессиюПослеОтвета()
	Если ЗавершениеПослеПерезапускаЗапущено Тогда
		Возврат;
	КонецЕсли;
	ЗавершениеПослеПерезапускаЗапущено = Истина;
	ПерезапускВОжидании = Ложь;
	Попытка ОтключитьОбработчикОжидания("АварийноЗавершитьСессиюПослеПерезапуска"); Исключение КонецПопытки;
	Попытка УдалитьФайлы(ПутьКлеймаПерезапуска); Исключение КонецПопытки;
	ПутьКлеймаПерезапуска = "";
	Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
	// Вызывается после отправки ответа: сбой завершения не должен дать вызывающему повод ответить второй раз.
	Попытка

		ЗавершитьРаботуСистемы(Ложь);

	Исключение

		ДобавитьВЛог("restart: shutdown after response failed: " + ОписаниеОшибки());

	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура АварийноЗавершитьСессиюПослеПерезапуска()
	ЗавершитьСтаруюСессиюПослеОтвета();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоддержкуФинальногоОтвета()
	ПоддерживаетсяОжиданиеФинальногоОтвета = Ложь;
	ИдПроверкиФинальногоОтвета = Строка(Новый УникальныйИдентификатор);
	Попытка
		Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
			Компонента.НачатьВызовGetRequestStates(
				Новый ОписаниеОповещения("ПослеПроверкиФинальногоОтвета", ЭтаФорма, ИдПроверкиФинальногоОтвета), "");
		Иначе
			ПослеПроверкиФинальногоОтвета(Компонента.GetRequestStates(""), Неопределено, ИдПроверкиФинальногоОтвета);
		КонецЕсли;
	Исключение
		ПоддерживаетсяОжиданиеФинальногоОтвета = Ложь;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиФинальногоОтвета(РезВызова, ПарВызова, ДопПар) Экспорт
	Если ДопПар <> ИдПроверкиФинальногоОтвета Тогда Возврат; КонецЕсли;
	Попытка
		Возможности = ПрочитатьJSON2(РезВызова);
		ВерсияОжидания = 0;
		ПоддерживаетсяОжиданиеФинальногоОтвета = Возможности.Свойство("terminal_response_wait_version", ВерсияОжидания)
			И ВерсияОжидания = 1;
	Исключение
		ПоддерживаетсяОжиданиеФинальногоОтвета = Ложь;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОтветПерезапускаИЗавершитьEmbedded(Сообщение)
	Если АвтоматическийПерезапуск Тогда
		ДобавитьВЛог("Автовосстановление: новая сессия готова, завершаем старую.");
		ЗавершитьСтаруюСессиюПослеОтвета();
		Возврат;
	КонецЕсли;
	ЗавершениеПослеПерезапускаЗапущено = Ложь;
	ИдОтправкиФинальногоОтвета = Строка(Новый УникальныйИдентификатор);
	АсинхроннаяОтправкаЗапущена = Ложь;
	Попытка
		ПодключитьОбработчикОжидания("АварийноЗавершитьСессиюПослеПерезапуска", 30);
		Оповещение = Новый ОписаниеОповещения("ПослеОтправкиФинальногоОтвета", ЭтаФорма, ИдОтправкиФинальногоОтвета);
		Если ЭтоRESTЗапросПерезапуска Тогда
			РезТело = ЗаписатьJSON2(РезультатСИсточникомБазы(
				Новый Структура("success,data", Истина, Сообщение), КонтекстИсточникаПерезапуска));
			Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
				АсинхроннаяОтправкаЗапущена = Истина;
				Компонента.НачатьВызовSendResponseAndWait(Оповещение,
					ИдRESTЗапросаПерезапуска, 200, ЗаголовкиJSON(), РезТело, 10000);
				Возврат;
			КонецЕсли;
			ИтогОтправки = Компонента.SendResponseAndWait(
				ИдRESTЗапросаПерезапуска, 200, ЗаголовкиJSON(), РезТело, 10000);
		Иначе
			Содержимое = Новый Массив;
			Содержимое.Добавить(Новый Структура("type,text", "text", Сообщение));
			РезультатMCP = СодержимоеСИсточникомБазы(
				Новый Структура("content,isError", Содержимое, Ложь), КонтекстИсточникаПерезапуска);
			ОтветJSON = СформироватьJSONRPCОтвет(ИдЗапросаПерезапуска, РезультатMCP);
			ИдПотока = ИдПотокаПерезапуска;
			ЗаголовкиОтвета = "{}";
			Если ПустаяСтрока(ИдПотока) Тогда
				ИдПотока = ДанныеЗапросаПерезапуска.id;
				ЗаголовкиОтвета = СформироватьSSEЗаголовки(ДанныеЗапросаПерезапуска, Неопределено, Истина);
			КонецЕсли;
			Если ИспользоватьАсинхронноеПодключениеКомпонент Тогда
				АсинхроннаяОтправкаЗапущена = Истина;
				Компонента.НачатьВызовSendSSEEventAndWait(Оповещение,
					ИдПотока, ОтветJSON, ЗаголовкиОтвета, "message", 10000);
				Возврат;
			КонецЕсли;
			ИтогОтправки = Компонента.SendSSEEventAndWait(
				ИдПотока, ОтветJSON, ЗаголовкиОтвета, "message", 10000);
		КонецЕсли;
	Исключение
		// Исключение Native API может содержать тело с командой запуска.
		ДобавитьВЛог("Не удалось передать ответ перед закрытием: ошибка вызова компоненты.");
		Если АсинхроннаяОтправкаЗапущена Тогда Возврат; КонецЕсли;
		ИтогОтправки = "failed";
	КонецПопытки;
	ПослеОтправкиФинальногоОтвета(ИтогОтправки, Неопределено, ИдОтправкиФинальногоОтвета);
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиФинальногоОтвета(РезВызова, ПарВызова, ДопПар) Экспорт
	Если ЗавершениеПослеПерезапускаЗапущено Или ДопПар <> ИдОтправкиФинальногоОтвета Тогда Возврат; КонецЕсли;
	Если РезВызова = "sent" Тогда
		ДобавитьВЛог("Ответ передан HTTP-транспортом.");
	ИначеЕсли РезВызова = "timeout" Тогда
		ДобавитьВЛог("Истёк срок ожидания отправки ответа перед закрытием.");
	Иначе
		ДобавитьВЛог("Не удалось передать ответ перед закрытием.");
	КонецЕсли;
	ЗавершитьСтаруюСессиюПослеОтвета();
КонецПроцедуры

// Вызывается из ПослеЗапускаВстроенногоСервера() и ЗапуститьВстроенныйСерверСинхронно()
// сразу после АнонимизаторОчистить(). Вне autostart — немедленный возврат.
&НаКлиенте
Процедура ЗавершитьАвтостартПослеЗапускаВстроенногоСервера()
	Если ЗначениеЗаполнено(ПутьФайлаСигналаАвтостарта) Тогда
		Если НЕ ПроверитьГотовностьАвтовосстановления() Тогда Возврат; КонецЕсли;
	КонецЕсли;
	Если ПутьФайлаСигналаАвтостарта = Неопределено Или ПутьФайлаСигналаАвтостарта = "" Тогда
		// Ранний выход если это не coldstart — сохраняем прежнее поведение для всех других сценариев
		Если НЕ ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Возврат;
		КонецЕсли;

		ОшибкаВосстановления = Ложь;
		Если ЗначениеЗаполнено(МаппингиДляВосстановления) Тогда
			Попытка
				ВосстановитьМаппингиАнонимизацииИзФайла(МаппингиДляВосстановления);
				ОбновитьТаблицуМаппинговВстроенный();
			Исключение
				ДобавитьВЛог("coldstart: mappings restore error: " + ОписаниеОшибки());
				ОшибкаВосстановления = Истина;
			КонецПопытки;
			Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
			МаппингиДляВосстановления = "";
		КонецЕсли;
		Если СессийДляВосстановления <> Неопределено Тогда
			Попытка
				ВосстановитьМСПСессии(СессийДляВосстановления);
			Исключение
				ДобавитьВЛог("coldstart: sessions restore error: " + ОписаниеОшибки());
				ОшибкаВосстановления = Истина;
			КонецПопытки;
			СессийДляВосстановления = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Попытка
				СигналСтрока = ?(ОшибкаВосстановления,
					"failed:coldstart restore error (see log)", "ready");
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку(СигналСтрока);
				ЗТ.Закрыть();
			Исключение КонецПопытки;
			ПутьФайлаСигналаХолодногоСтарта = "";
			Если ОшибкаВосстановления Тогда
				Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
				ЗавершитьРаботуСистемы(Ложь);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ОбщаяОшибка = "";
	МаппингиПуть = "";

	Если МаппингиДляВосстановления <> Неопределено И МаппингиДляВосстановления <> "" Тогда
		МаппингиПуть = МаппингиДляВосстановления;
		Попытка
			ВосстановитьМаппингиАнонимизацииИзФайла(МаппингиДляВосстановления);
			ОбновитьТаблицуМаппинговВстроенный();
		Исключение
			ОбщаяОшибка = "Mappings restore error: " + ОписаниеОшибки();
		КонецПопытки;
		МаппингиДляВосстановления = "";
	КонецЕсли;

	Если ОбщаяОшибка = "" И СессийДляВосстановления <> Неопределено Тогда
		Попытка
			ВосстановитьМСПСессии(СессийДляВосстановления);
		Исключение
			ОбщаяОшибка = "Sessions restore error: " + ОписаниеОшибки();
		КонецПопытки;
		СессийДляВосстановления = Неопределено;
	КонецЕсли;

	Если ОбщаяОшибка <> "" Тогда
		Попытка УдалитьФайлы(МаппингиПуть); Исключение КонецПопытки;
		ОшибкаСтрока = СтрЗаменить(ОбщаяОшибка, Символы.ВК, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
		Попытка
			ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
			ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
			ЗТ.Закрыть();
		Исключение
		КонецПопытки;
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
		ПутьФайлаСигналаАвтостарта = "";
		ПутьКлеймаАвтостарта       = "";
		Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Попытка
		ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
		ЗТ.ЗаписатьСтроку("ready");
		ЗТ.Закрыть();
		ПутьФайлаСигналаАвтостарта = "";
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
		ПутьКлеймаАвтостарта = "";
	Исключение
		ПутьФайлаСигналаАвтостарта = "";
		МаппингиДляВосстановления  = "";
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
		ПутьКлеймаАвтостарта       = "";
		СессийДляВосстановления    = Неопределено;
		Попытка УдалитьФайлы(МаппингиПуть); Исключение КонецПопытки;
		Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
	КонецПопытки;
КонецПроцедуры

// Пишет failed:-сигнал, удаляет mappings-файл и закрывает сессию.
// Вне autostart (ПутьФайлаСигналаАвтостарта пуст) — обновляет статус неудавшегося запуска.
&НаКлиенте
Процедура ЗавершитьАвтостартСОшибкой(Сообщение)
	Если Статус = "Запуск встроенного сервера..." Тогда
		УстановитьСтатус("Не удалось запустить встроенный сервер", Ложь);
	КонецЕсли;
	// Coldstart: cleanup и failed-сигнал — всегда, до раннего выхода
	Если ЗначениеЗаполнено(МаппингиДляВосстановления) Тогда
		Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
		МаппингиДляВосстановления = "";
	КонецЕсли;
	СессийДляВосстановления = Неопределено;
	Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
		Попытка
			ОшибкаСтрока = СтрЗаменить(СтрЗаменить(Сообщение, Символы.ВК, " "), Символы.ПС, " ");
			ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
			ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
			ЗТ.Закрыть();
		Исключение КонецПопытки;
		ПутьФайлаСигналаХолодногоСтарта = "";
		Попытка ОстановитьВстроенныйСервер(); Исключение КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Если ПутьФайлаСигналаАвтостарта = Неопределено Или ПутьФайлаСигналаАвтостарта = "" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОшибкаСтрока = СтрЗаменить(Сообщение, Символы.ВК, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.ПС, " ");
		ОшибкаСтрока = СтрЗаменить(ОшибкаСтрока, Символы.Таб, " ");
		ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
		ЗТ.ЗаписатьСтроку("failed:" + ОшибкаСтрока);
		ЗТ.Закрыть();
	Исключение
	КонецПопытки;
	Если МаппингиДляВосстановления <> Неопределено И МаппингиДляВосстановления <> "" Тогда
		Попытка УдалитьФайлы(МаппингиДляВосстановления); Исключение КонецПопытки;
	КонецЕсли;
	Если ПутьКлеймаАвтостарта <> Неопределено И ПутьКлеймаАвтостарта <> "" Тогда
		Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
	КонецЕсли;
	ПутьФайлаСигналаАвтостарта = "";
	МаппингиДляВосстановления  = "";
	ПутьКлеймаАвтостарта       = "";
	СессийДляВосстановления    = Неопределено;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры


