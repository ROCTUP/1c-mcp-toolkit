Процедура ОбработатьРезультатПодтвержденияВстроенный(РезультатВопроса, ДополнительныеПараметры) Экспорт

	RequestId = ДополнительныеПараметры.RequestId;
	Контекст = ОжидающиеПодтверждения.Получить(RequestId);
	ОжидающиеПодтверждения.Удалить(RequestId);

	Если Контекст = Неопределено Тогда Возврат КонецЕсли;

	// Безопасное извлечение режима и идентификаторов:
	// REST-контекст не содержит полей Ид и ИдПотокаSSE — прямой доступ к Контекст.Ид даст crash
	РежимКонтекста = "";
	Контекст.Свойство("Режим", РежимКонтекста);
	Если НЕ ЗначениеЗаполнено(РежимКонтекста) Тогда
		РежимКонтекста = "mcp";
	КонецЕсли;
	ИдКонтекст = "";
	Контекст.Свойство("Ид", ИдКонтекст);

	Разрешено = Ложь;
	Если ТипЗнч(РезультатВопроса) = Тип("Булево") Тогда
		Разрешено = РезультатВопроса;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Разрешено = Истина;
	КонецЕсли;

	ИдПотокаSSEКонтекст = "";
	Контекст.Свойство("ИдПотокаSSE", ИдПотокаSSEКонтекст);

	Если СостояниеЗащиты.Строгий Или СостояниеЗащиты.Переключение Тогда

		Если НЕ ПродолжитьПодтверждениеПараллельнойКоманды(Контекст.Команда, Ложь) Тогда

			ОтправитьОшибкуЭпохи(Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотокаSSE",
				РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст));

		КонецЕсли;

		Возврат;

	КонецЕсли;

	Если ПродолжитьПодтверждениеПараллельнойКоманды(Контекст.Команда, Разрешено) Тогда Возврат; КонецЕсли;

	Если ОтветОтклоненПоЭпохе(РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст) Тогда

		Возврат;

	КонецЕсли;
	Если Разрешено Тогда
		ОтказВызова = ПроверитьДоступностьИнструментаMCP(Контекст.Команда.tool);
		Если ОтказВызова <> Неопределено Тогда
			Если РежимКонтекста = "rest" Тогда
				ОшибкаОтвета = РезультатСИсточникомБазы(РезультатОтказаИнструментаMCP(ОтказВызова), Контекст.ДанныеЗапроса);
				КомпонентаSendResponse(RequestId, ОтказВызова.HTTPСтатус, ЗаголовкиJSON(), ЗаписатьJSON2(ОшибкаОтвета));
			Иначе
				КонтекстОтказа = НовыйКонтекстВыполненияКоманды("mcp", Контекст.Команда);
				КонтекстОтказа.ДанныеЗапроса = Контекст.ДанныеЗапроса;
				КонтекстОтказа.Ид = ИдКонтекст;
				КонтекстОтказа.ИдПотока = ИдПотокаSSEКонтекст;
				ОтправитьРезультатКомандыMCP(КонтекстОтказа, РезультатОтказаИнструментаMCP(ОтказВызова));
			КонецЕсли;
			Возврат;
		КонецЕсли;
		ДобавитьВЛог("Пользователь разрешил выполнение опасной операции");
		КонтекстОтвета = НовыйКонтекстВыполненияКоманды(РежимКонтекста, Контекст.Команда);
		КонтекстОтвета.ДанныеЗапроса = Контекст.ДанныеЗапроса;
		Если РежимКонтекста = "mcp" Тогда
			КонтекстОтвета.Ид = ИдКонтекст;
			КонтекстОтвета.ИдПотока = ИдПотокаSSEКонтекст;
		КонецЕсли;
		Попытка
			Результат = ВыполнитьКомандуСУчетомКонтекста(Контекст.Команда, КонтекстОтвета);
		Исключение
			Результат = Новый Структура("success, error", Ложь, "Error: " + ОписаниеОшибки());
		КонецПопытки;
		Если КонтекстОтвета.Отложено Тогда
			Возврат;
		КонецЕсли;
		Если ТипЗнч(Результат) = Тип("Структура") И ТипЗнч(Контекст.Команда) = Тип("Структура") Тогда
			Результат.Вставить("_cmd_arguments_json", """tool"": """ + Контекст.Команда.tool + """" + Символы.ПС + ЗаписатьJSON2(Контекст.Команда.params));
		КонецЕсли;
		ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
		ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Контекст.Команда);
		Если ИспользоватьАсинхронноеПодключениеКомпонент
			И НуженLineageДляРезультата(Контекст.Команда.tool, ТекстЗапросаLineage, Результат) Тогда
			КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат, ТекстЗапроса",
				РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст, Результат, ТекстЗапросаLineage);
			ПеренестиИсточникОтвета(КонтекстLineage, Контекст.Команда);
			НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
			Возврат;
		КонецЕсли;
		Если ИспользоватьАсинхронноеПодключениеКомпонент
			И Контекст.Команда.tool = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию
			И РежимПодключения <> 0 Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
			РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоОбъект",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
			КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
				РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст, Результат);
			ПеренестиИсточникОтвета(КонтекстLineage, Контекст.Команда);
			РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
			ЗапуститьRegexФазу(РегексКонтекст);
			Возврат;
		КонецЕсли;
		Если ИспользоватьАсинхронноеПодключениеКомпонент
			И Контекст.Команда.tool = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию
			И РежимПодключения <> 0 Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоFindReferences",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
			КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
				РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст, Результат);
			ПеренестиИсточникОтвета(КонтекстLineage, Контекст.Команда);
			РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
			ЗапуститьRegexФазу(РегексКонтекст);
			Возврат;
		КонецЕсли;
		Если ИспользоватьАсинхронноеПодключениеКомпонент
			И Контекст.Команда.tool = "execute_code" И ИспользоватьТочнуюАнонимизацию
			И РежимПодключения <> 0 Тогда
			УжеАнонимизирован = Ложь;
			Если ТипЗнч(Результат) = Тип("Структура") Тогда
				ВремАнон = Неопределено;
				УжеАнонимизирован = Результат.Свойство("_original_data_json", ВремАнон) И ЗначениеЗаполнено(ВремАнон);
			КонецЕсли;
			Если НЕ УжеАнонимизирован Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				РегексКонтекст = Новый Структура(
					"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
					Результат, "", "", Неопределено, Ложь, Истина);
				АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
				КонтекстLineage = Новый Структура("Режим, ДанныеЗапроса, Ид, ИдПотока, Результат",
					РежимКонтекста, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст, Результат);
				ПеренестиИсточникОтвета(КонтекстLineage, Контекст.Команда);
				РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
				ЗапуститьRegexФазу(РегексКонтекст);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		// Точка перехвата B: после dangerous-op approval
		Если ПроверитьПодтверждениеАнонимизации(Результат, Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст, РежимКонтекста) Тогда
			Возврат;
		КонецЕсли;
		// REST approve: HTTP-ответ вместо SSE (с поддержкой async Toon)
		Если РежимКонтекста = "rest" Тогда
			Результат = ОчиститьВнутренниеПоляPolicyВРезультатеExecuteQuery(Результат);
			Если ИспользоватьАсинхронноеПодключениеКомпонент И КомпонентаТун <> Неопределено
				И ФорматОтветаВстроенный = 1 И ТипЗнч(Результат) = Тип("Структура")
				И Результат.Свойство("success") И Результат.success И Результат.Свойство("data") Тогда
				КомпонентаТун.НачатьВызовJsonToToon(
					Новый ОписаниеОповещения("ПослеJsonToToonREST", ЭтаФорма,
						Новый Структура("ДанныеЗапроса, Результат", Контекст.ДанныеЗапроса, Результат)),
					ЗаписатьJSON2(Результат.data));
				Возврат;
			КонецЕсли;
			ПрименитьТунКонвертацию(Результат);
			КомпонентаSendResponse(Контекст.ДанныеЗапроса.id, 200,
				ЗаголовкиJSON(), ЗаписатьJSON2(РезультатСИсточникомБазы(Результат, Контекст.Команда)));
			Возврат;
		КонецЕсли;
		ТулКолРез = СформироватьToolsCallРезультат(Результат,
			Контекст.ДанныеЗапроса, ИдКонтекст, ИдПотокаSSEКонтекст);
		Если ТулКолРез = Неопределено Тогда Возврат КонецЕсли; // async Toon-конвертация сама отправит
		ОтветJSON = СформироватьJSONRPCОтвет(ИдКонтекст, ТулКолРез);
	Иначе
		ДобавитьВЛог("Пользователь отклонил выполнение опасной операции");
		// Возвращаем текст ошибки как в прокси-режиме (RU+EN + список ключевых слов)
		ОпасныеСловаТекст = "";
		Если Контекст.Свойство("ОпасныеКлючевыеСловаТекст") Тогда
			ОпасныеСловаТекст = Контекст.ОпасныеКлючевыеСловаТекст;
		ИначеЕсли Контекст.Свойство("ОпасныеКлючевыеСлова") Тогда
			ОпасныеСловаТекст = СоединитьМассив(Контекст.ОпасныеКлючевыеСлова, ", ");
		КонецЕсли;
		ТекстОшибкиОтклонено = "Операция отклонена пользователем. Код содержит опасные ключевые слова: " + ОпасныеСловаТекст
			+ " / Operation rejected by user. Code contains dangerous keywords: " + ОпасныеСловаТекст;
		ОшибкаОтклонено = Новый Структура("success, error", Ложь, ТекстОшибкиОтклонено);
		ОшибкаОтклонено = РезультатСИсточникомБазы(ОшибкаОтклонено, Контекст.Команда);
		// REST reject: HTTP-ответ напрямую (Результат здесь не существует)
		Если РежимКонтекста = "rest" Тогда
			КомпонентаSendResponse(Контекст.ДанныеЗапроса.id, 200,
				ЗаголовкиJSON(), ЗаписатьJSON2(ОшибкаОтклонено));
			Возврат;
		КонецЕсли;
		// success=Ложь → Toon async не нужен, параметры не передаём
		ОтветJSON = СформироватьJSONRPCОтвет(ИдКонтекст,
			СформироватьToolsCallРезультат(ОшибкаОтклонено));
	КонецЕсли;

	// Legacy SSE: ответ через GET-поток, не POST (который уже вернул 202)
	Если ЗначениеЗаполнено(ИдПотокаSSEКонтекст) Тогда
		КомпонентаSendSSEEvent(ИдПотокаSSEКонтекст, ОтветJSON, "{}", "message");
	Иначе
		ОтправитьSSEОтвет(Контекст.ДанныеЗапроса, ОтветJSON); // Streamable HTTP — не трогаем
	КонецЕсли;

