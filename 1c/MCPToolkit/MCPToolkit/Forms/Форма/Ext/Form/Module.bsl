Функция ПроверитьОписаниеОбъекта(ОписаниеОбъекта)
	
	// Порт validate_object_description_data из прокси (сообщения стараемся сохранить).
	
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат "object_description must be a dictionary";
	КонецЕсли;
	Если ТипЗнч(ОписаниеОбъекта) <> Тип("Структура") Тогда
		Возврат "object_description must be a dictionary";
	КонецЕсли;
	
	Если НЕ ОписаниеОбъекта.Свойство("_objectRef") Тогда
		Возврат "object_description must contain '_objectRef' field";
	КонецЕсли;
	Если ОписаниеОбъекта._objectRef <> Истина Тогда
		Возврат "object_description._objectRef must be true";
	КонецЕсли;
	
	Если НЕ ОписаниеОбъекта.Свойство("УникальныйИдентификатор") Тогда
		Возврат "object_description must contain 'УникальныйИдентификатор' field";
	КонецЕсли;
	UUIDЗначение = ОписаниеОбъекта.УникальныйИдентификатор;
	Если ТипЗнч(UUIDЗначение) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(UUIDЗначение)) Тогда
		Возврат "УникальныйИдентификатор must be a non-empty string";
	КонецЕсли;
	Если НЕ СтрокаСоответствуетUUID(UUIDЗначение) Тогда
		Возврат "УникальныйИдентификатор must be a valid UUID (format: 8-4-4-4-12), got: '" + UUIDЗначение + "'";
	КонецЕсли;
	
	Если НЕ ОписаниеОбъекта.Свойство("ТипОбъекта") Тогда
		Возврат "object_description must contain 'ТипОбъекта' field";
	КонецЕсли;
	ТипОбъекта = ОписаниеОбъекта.ТипОбъекта;
	Если ТипЗнч(ТипОбъекта) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(ТипОбъекта)) Тогда
		Возврат "ТипОбъекта must be a non-empty string";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьФорматНавигационнойСсылки(Ссылка, ПрефиксСообщения)
	
	// ПрефиксСообщения: "Link" или "link" (как в сообщениях прокси в разных моделях).
	Ссылка = СокрЛП(Строка(Ссылка));
	
	Префикс = "e1cib/data/";
	Если Лев(Ссылка, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат ПрефиксСообщения + " must start with 'e1cib/data/'";
	КонецЕсли;
	
	ПозицияRef = Найти(Ссылка, "?ref=");
	Если ПозицияRef = 0 Тогда
		Возврат ПрефиксСообщения + " must contain '?ref=' parameter";
	КонецЕсли;
	
	ЧастьRef = Сред(Ссылка, ПозицияRef + 5);
	Если СтрДлина(ЧастьRef) <> 32 Тогда
		Возврат "ref parameter must be exactly 32 hexadecimal characters, got " + Строка(СтрДлина(ЧастьRef));
	КонецЕсли;
	
	Если НЕ СтрокаСостоитИзHexСимволов(ЧастьRef) Тогда
		Возврат "ref parameter must contain only hexadecimal characters";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
// Нормализация и проверка селекторов цели get_screenshot (link/page_name) и их комбинаций
// с form_name. Общий helper обеих веток валидации. Возвращает Неопределено или строку
// error_detail. Null/Неопределено новых полей означает «не задано» (поле удаляется);
// пустая/пробельная строка — ошибка; нестроковые типы к строке не приводятся.
// Комбинации проверяются здесь же: ошибочный ввод отклоняется до любых UI-действий.
Функция ПроверитьИНормализоватьСелекторыСкриншота(АргументыЗапроса)

	Если АргументыЗапроса = Неопределено Или ТипЗнч(АргументыЗапроса) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если АргументыЗапроса.Свойство("link") Тогда
		СсылкаЗн = АргументыЗапроса.link;
		Если СсылкаЗн = Null Или СсылкаЗн = Неопределено Тогда
			УдалитьПолеЕслиЕсть(АргументыЗапроса, "link");
		ИначеЕсли ТипЗнч(СсылкаЗн) <> Тип("Строка") Тогда
			Возврат "Field 'link': Input should be a valid string";
		Иначе
			СсылкаЗн = СокрЛП(СсылкаЗн);
			Если ПустаяСтрока(СсылкаЗн) Тогда
				Возврат "link cannot be empty or whitespace only";
			КонецЕсли;
			// Внешние источники данных допускает get_object_by_link, но не снимок окна
			ПутьСсылки = СсылкаЗн;
			ПозВопросСсылки = Найти(ПутьСсылки, "?");
			Если ПозВопросСсылки > 0 Тогда
				ПутьСсылки = Лев(ПутьСсылки, ПозВопросСсылки - 1);
			КонецЕсли;
			ПрефиксВнешнегоИсточника = "e1cib/data/внешнийисточникданных.";
			Если НРег(Лев(ПутьСсылки, СтрДлина(ПрефиксВнешнегоИсточника))) = ПрефиксВнешнегоИсточника Тогда
				Возврат "get_screenshot does not support external data source links; only e1cib/data/<Type>.<Name>?ref=<32 hex> links of regular objects";
			КонецЕсли;
			// Строгая проверка hex-32 также отсекает лишние query-параметры после ref
			ДетальОшибки = ПроверитьФорматНавигационнойСсылки(СсылкаЗн, "link");
			Если ДетальОшибки <> Неопределено Тогда
				Возврат ДетальОшибки;
			КонецЕсли;
			АргументыЗапроса.Вставить("link", СсылкаЗн);
		КонецЕсли;
	КонецЕсли;

	Если АргументыЗапроса.Свойство("page_name") Тогда
		СтраницаЗн = АргументыЗапроса.page_name;
		Если СтраницаЗн = Null Или СтраницаЗн = Неопределено Тогда
			УдалитьПолеЕслиЕсть(АргументыЗапроса, "page_name");
		ИначеЕсли ТипЗнч(СтраницаЗн) <> Тип("Строка") Тогда
			Возврат "Field 'page_name': Input should be a valid string";
		Иначе
			СтраницаЗн = СокрЛП(СтраницаЗн);
			Если ПустаяСтрока(СтраницаЗн) Тогда
				Возврат "page_name cannot be empty or whitespace only";
			КонецЕсли;
			АргументыЗапроса.Вставить("page_name", СтраницаЗн);
		КонецЕсли;
	КонецЕсли;

	// Комбинации селекторов
	ФормаЗадана = АргументыЗапроса.Свойство("form_name")
		И ЗначениеЗаполнено(АргументыЗапроса.form_name);
	СсылкаЗадана = АргументыЗапроса.Свойство("link")
		И ЗначениеЗаполнено(АргументыЗапроса.link);
	СтраницаЗадана = АргументыЗапроса.Свойство("page_name")
		И ЗначениеЗаполнено(АргументыЗапроса.page_name);
	Если ФормаЗадана И СсылкаЗадана Тогда
		Возврат "form_name and link are mutually exclusive";
	КонецЕсли;
	Если СтраницаЗадана И НЕ ФормаЗадана И НЕ СсылкаЗадана Тогда
		Возврат "page_name requires form_name or link";
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьИНормализоватьЛимитыИнструмента(ИмяИнструмента, АргументыЗапроса)
	
	// Возвращает Неопределено или строку error_detail (без двуязычной обёртки).
	
	ИмяИнструмента = СокрЛП(Строка(ИмяИнструмента));
	
	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "limit", 100, 1, 1000);
		
	ИначеЕсли ИмяИнструмента = "get_metadata" Тогда
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "limit", 100, 1, 1000);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		Возврат ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "offset", 0, 0, 1000000);

	ИначеЕсли ИмяИнструмента = "get_bsl_syntax_help" Тогда
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "limit", 100, 1, 300);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "offset", 0, 0, 1000000);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		Возврат ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "content_page", 1, 1, 100000);

	ИначеЕсли ИмяИнструмента = "get_screenshot" Тогда
		// form_name опциональный: проверяем только если передан
		Если АргументыЗапроса.Свойство("form_name") Тогда
			ДетальОшибки = ПроверитьИНормализоватьНепустуюСтроку(
				АргументыЗапроса, "form_name",
				"form_name cannot be empty or whitespace only");
			Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		КонецЕсли;
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "scale_percent", 100, 10, 200);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		// Нормализация show_grid: полный паритет с Pydantic bool
		Если АргументыЗапроса.Свойство("show_grid") Тогда
			Зн = АргументыЗапроса.show_grid;
			Если ТипЗнч(Зн) = Тип("Булево") Тогда
				// уже Булево, ок
			ИначеЕсли ТипЗнч(Зн) = Тип("Число") Тогда
				// Pydantic принимает только 0 и 1; 2, -1, 42 → ValidationError
				Если Зн = 0 Тогда
					АргументыЗапроса.Вставить("show_grid", Ложь);
				ИначеЕсли Зн = 1 Тогда
					АргументыЗапроса.Вставить("show_grid", Истина);
				Иначе
					Возврат "Field 'show_grid': Input should be a valid boolean";
				КонецЕсли;
			ИначеЕсли ТипЗнч(Зн) = Тип("Строка") Тогда
				Сн = НРег(СокрЛП(Зн));
				Если Сн = "true" ИЛИ Сн = "1" ИЛИ Сн = "yes" ИЛИ Сн = "on" Тогда
					АргументыЗапроса.Вставить("show_grid", Истина);
				ИначеЕсли Сн = "false" ИЛИ Сн = "0" ИЛИ Сн = "no" ИЛИ Сн = "off" Тогда
					АргументыЗапроса.Вставить("show_grid", Ложь);
				Иначе
					Возврат "Field 'show_grid': Input should be a valid boolean";
				КонецЕсли;
			Иначе
				Возврат "Field 'show_grid': Input should be a valid boolean";
			КонецЕсли;
		КонецЕсли;
		// Валидация region
		Если АргументыЗапроса.Свойство("region") Тогда
			РегЗн = АргументыЗапроса.region;
			Если РегЗн <> Null И РегЗн <> Неопределено Тогда
				Если ТипЗнч(РегЗн) <> Тип("Структура") Тогда
					Возврат "Field 'region': must be an object with fields x, y, width, height";
				КонецЕсли;
				Рег = РегЗн;
				ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рег, "x",      0);
				Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
				ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рег, "y",      0);
				Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
				ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рег, "width",  1);
				Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
				ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рег, "height", 1);
				Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Валидация highlight_rects
		Если АргументыЗапроса.Свойство("highlight_rects") Тогда
			ХРЗн = АргументыЗапроса.highlight_rects;
			Если ХРЗн <> Null И ХРЗн <> Неопределено Тогда
				Если ТипЗнч(ХРЗн) <> Тип("Массив") Тогда
					Возврат "Field 'highlight_rects': must be an array";
				КонецЕсли;
				Если ХРЗн.Количество() > 20 Тогда
					Возврат "highlight_rects must not exceed 20 items";
				КонецЕсли;
				Для ИндексРект = 0 По ХРЗн.Количество() - 1 Цикл
					Рект = ХРЗн[ИндексРект];
					НомерРект = Формат(ИндексРект + 1, "ЧГ=");
					Если ТипЗнч(Рект) <> Тип("Структура") Тогда
						Возврат "Field 'highlight_rects[" + НомерРект + "]': must be an object with fields x, y, width, height";
					КонецЕсли;
					ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рект, "x",      0);
					Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
					ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рект, "y",      0);
					Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
					ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рект, "width",  1);
					Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
					ДетальОшибки = ПроверитьНормализоватьПолеРегиона(Рект, "height", 1);
					Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
				КонецЦикла;
				// Проверка пересечений
				Для ИндА = 0 По ХРЗн.Количество() - 1 Цикл
					А = ХРЗн[ИндА];
					Для ИндБ = ИндА + 1 По ХРЗн.Количество() - 1 Цикл
						Б = ХРЗн[ИндБ];
						Если НЕ (А.x + А.width <= Б.x ИЛИ Б.x + Б.width <= А.x
							ИЛИ А.y + А.height <= Б.y ИЛИ Б.y + Б.height <= А.y) Тогда
							Возврат "Rectangle " + Формат(ИндА + 1, "ЧГ=") + " and Rectangle " + Формат(ИндБ + 1, "ЧГ=") + " overlap";
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		ДетальОшибки = ПроверитьИНормализоватьСелекторыСкриншота(АргументыЗапроса);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		Возврат Неопределено;

	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "limit", 100, 1, 1000);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "same_second_offset", 0, 0, 10000);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		
		// same_second_offset requires start_date (как в Python-прокси GetEventLogParams.model_validator)
		СмещениеВСекунде = 0;
		Если АргументыЗапроса <> Неопределено И ТипЗнч(АргументыЗапроса) = Тип("Структура") Тогда
			Если АргументыЗапроса.Свойство("same_second_offset") Тогда
				СмещениеВСекунде = АргументыЗапроса.same_second_offset;
			КонецЕсли;
		КонецЕсли;
		
		Если СмещениеВСекунде > 0 Тогда
			ДатаНачалаСтрока = "";
			Если АргументыЗапроса <> Неопределено И ТипЗнч(АргументыЗапроса) = Тип("Структура") Тогда
				Если АргументыЗапроса.Свойство("start_date") Тогда
					ДатаНачалаСтрока = СокрЛП(Строка(АргументыЗапроса.start_date));
				КонецЕсли;
			КонецЕсли;
			
			Если ПустаяСтрока(ДатаНачалаСтрока) Тогда
				Возврат "Field 'same_second_offset': same_second_offset requires start_date to be specified";
			КонецЕсли;
		КонецЕсли;
		
		Возврат Неопределено;
		
	ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "limit_hits", 200, 1, 10000);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		
		ДетальОшибки = ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "limit_per_meta", 20, 1, 1000);
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки КонецЕсли;
		
		Возврат ПроверитьИНормализоватьЦелоеПоле(АргументыЗапроса, "timeout_budget_sec", 30, 5, 300);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьИНормализоватьАргументыИнструмента(ИмяИнструмента, АргументыЗапроса)
	
	// Централизованная валидация аргументов инструментов для встроенного HTTP-сервера.
	// Возвращает Неопределено или строку error_detail (без двуязычной обёртки).
	
	ДетальОшибки = ПроверитьИНормализоватьЛимитыИнструмента(ИмяИнструмента, АргументыЗапроса);
	Если ДетальОшибки <> Неопределено Тогда
		Возврат ДетальОшибки;
	КонецЕсли;
	
	ИмяИнструмента = СокрЛП(Строка(ИмяИнструмента));
	
	Если ИмяИнструмента = "execute_query" Тогда
		
		// query: обязательная непустая строка
		ДетальОшибки = ПроверитьИНормализоватьНепустуюСтроку(АргументыЗапроса, "query", "Query cannot be empty or whitespace only");
		Если ДетальОшибки <> Неопределено Тогда
			Возврат ДетальОшибки;
		КонецЕсли;
		
		// params: optional dict
		Если АргументыЗапроса <> Неопределено И ТипЗнч(АргументыЗапроса) = Тип("Структура") Тогда
			Если АргументыЗапроса.Свойство("params") Тогда
				ПарамЗапроса = АргументыЗапроса.params;
				Если ПарамЗапроса = Null Или ПарамЗапроса = Неопределено Тогда
					УдалитьПолеЕслиЕсть(АргументыЗапроса, "params");
				ИначеЕсли ТипЗнч(ПарамЗапроса) = Тип("Строка") Тогда
					// Агент может передать params как JSON-строку — пробуем распарсить
					Попытка
						РазобранныеПарамы = ПрочитатьJSON2(ПарамЗапроса);
						Если ТипЗнч(РазобранныеПарамы) = Тип("Структура")
							Или ТипЗнч(РазобранныеПарамы) = Тип("Соответствие") Тогда
							АргументыЗапроса.params = РазобранныеПарамы;
						Иначе
							Возврат "Field 'params': Params must be a dictionary";
						КонецЕсли;
					Исключение
						Возврат "Field 'params': Params must be a dictionary";
					КонецПопытки;
				ИначеЕсли ТипЗнч(ПарамЗапроса) <> Тип("Структура")
					И ТипЗнч(ПарамЗапроса) <> Тип("Соответствие") Тогда
					Возврат "Field 'params': Params must be a dictionary";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// include_schema: в прокси StrictBool (только boolean), default=False.
		Возврат ПроверитьИНормализоватьБулевоПоле(АргументыЗапроса, "include_schema", Ложь);
		
	ИначеЕсли ИмяИнструмента = "execute_code" Тогда

		// code: обязательная непустая строка
		ДетальОшибки = ПроверитьИНормализоватьНепустуюСтроку(АргументыЗапроса, "code", "Code cannot be empty or whitespace only");
		Если ДетальОшибки <> Неопределено Тогда Возврат ДетальОшибки; КонецЕсли;

		// execution_context: опциональный, только "server" или "client"
		Если АргументыЗапроса <> Неопределено И АргументыЗапроса.Свойство("execution_context") Тогда
			КонтекстЗнч = АргументыЗапроса.execution_context;
			Если КонтекстЗнч <> "server" И КонтекстЗнч <> "client" Тогда
				Возврат "execution_context must be 'server' or 'client'";
			КонецЕсли;
		КонецЕсли;

		Возврат Неопределено;

	ИначеЕсли ИмяИнструмента = "get_metadata" Тогда
		
		Если АргументыЗапроса = Неопределено Или ТипЗнч(АргументыЗапроса) <> Тип("Структура") Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// filter: Optional[str], "" или whitespace -> None
		Если АргументыЗапроса.Свойство("filter") Тогда
			ФильтрЗначение = АргументыЗапроса.filter;
			Если ФильтрЗначение = Null Или ФильтрЗначение = Неопределено Тогда
				УдалитьПолеЕслиЕсть(АргументыЗапроса, "filter");
			Иначе
				ФильтрЗначение = СокрЛП(Строка(ФильтрЗначение));
				Если ПустаяСтрока(ФильтрЗначение) Тогда
					УдалитьПолеЕслиЕсть(АргументыЗапроса, "filter");
				Иначе
					АргументыЗапроса.Вставить("filter", ФильтрЗначение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// meta_type: Optional[Union[str, List[str]]]
		Если АргументыЗапроса.Свойство("meta_type") Тогда
			ТипыМета = АргументыЗапроса.meta_type;
			Если ТипыМета = Null Или ТипыМета = Неопределено Или ТипыМета = "" Тогда
