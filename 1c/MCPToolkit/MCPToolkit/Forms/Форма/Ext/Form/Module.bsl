		Возврат;

	КонецЕсли;

	ЗафиксироватьИсточникОтвета(Команда);
	ОтказВызова = ПроверитьИмяИнструментаMCP(Команда.tool);
	Если ОтказВызова = Неопределено Тогда
		АргументыВызова = Новый Структура;
		Если НЕ Команда.Свойство("params", АргументыВызова) Тогда АргументыВызова = Новый Структура; КонецЕсли;
		ОтказВызова = ПроверитьВнешниеАргументыMCP(АргументыВызова);
	КонецЕсли;
	Если ОтказВызова <> Неопределено Тогда
		Если НЕ ЭтоИзвестныйИнструментMCP(Команда.tool) Тогда Команда.Удалить("ИсточникОтвета"); КонецЕсли;
		ОтправитьРезультатНаСервер(АдресСервера, Команда.id, РезультатОтказаИнструментаMCP(ОтказВызова), , , Команда);
