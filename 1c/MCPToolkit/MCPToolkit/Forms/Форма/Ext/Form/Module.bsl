				КомпонентаИсполнителяСправки = КомпонентаSyntaxHelp;
				ИсполнительСправкиФормы = СоздатьИсполнительСправки();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Параллельно = ПланировщикФормы.Режим = "enabled" И НЕ СправкаЗакрывается
		И КомпонентаИсполнителяСправки = КомпонентаSyntaxHelp И НЕ ИсполнительСправкиФормы.Свойство("ТранспортОстановлен");
