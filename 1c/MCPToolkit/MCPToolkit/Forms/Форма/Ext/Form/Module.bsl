		ЭтаФорма,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияНастроекТочнойАнонимизации(НастройкиСохранены, ДополнительныеДанные) Экспорт

	Если НастройкиСохранены <> Истина Тогда
		Возврат;
	КонецЕсли;

	КэшRegexПравил = Неопределено;                // инвалидировать кэши при изменении настроек
	КэшНастроекТочнойАнонимизации = Неопределено;

	ОбновитьСводкуПравилТочнойАнонимизацииНаСервере();

	НастройкиАнон = ПолучитьНастройкиТочнойАнонимизации();
	ПодтверждениеАнонимизации = НастройкиАнон.ПодтверждениеАнонимизации;

	Если ВстроенныйСерверЗапущен И ИспользоватьТочнуюАнонимизацию Тогда
		ПостроитьИЗаполнитьСловарьАнонимизации();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьсяОтСервера()
	
	ФлагПодключения = Ложь;
	
	Попытка
		ОтключитьОбработчикОжидания("ЦиклОпроса");
	Исключение
		// Обработчик уже отключен
	КонецПопытки;
	
	УстановитьСтатус("Отключено", Ложь);
	ДобавитьВЛог("Отключено от сервера");
	
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// ЦИКЛ ОПРОСА (LONG POLLING)
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура ЦиклОпроса()
	
	Если Не ФлагПодключения Тогда
		Возврат;
	КонецЕсли;
	
	// Получение команды с сервера
	РезультатЗапроса = ПолучитьКомандуССервера(АдресСервера);
	
	Если РезультатЗапроса.Успех Тогда

		// Сброс счётчика попыток при успешном подключении
		ТекущееКоличествоПопытокПереподключения = 0;

		Если Не Подключено Тогда
			УстановитьСтатус("Подключено", Истина);
			ДобавитьВЛог("Успешное подключение к серверу");
		КонецЕсли;

		// Первый успешный poll после autostart — записываем сигнал "ready"
		Если ПутьФайлаСигналаАвтостарта <> Неопределено И ПутьФайлаСигналаАвтостарта <> "" Тогда
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("ready");
				ЗТ.Закрыть();
				ПутьФайлаСигналаАвтостарта = "";
			Исключение
				ПутьФайлаСигналаАвтостарта = "";
				Попытка ОтключитьсяОтСервера(); Исключение КонецПопытки;
				ЗавершитьРаботуСистемы(Ложь);
			КонецПопытки;
		КонецЕсли;

		// Первый успешный poll после coldstart (proxy) — записываем сигнал "ready"
		Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("ready");
				ЗТ.Закрыть();
			Исключение КонецПопытки;
			ПутьФайлаСигналаХолодногоСтарта = "";
		КонецЕсли;

		Если РезультатЗапроса.ЕстьКоманда Тогда
			// Выполнение команды
			ОбработатьКоманду(РезультатЗапроса.Команда);
		КонецЕсли;

	Иначе
		// Ошибка подключения
		ОбработатьОшибкуПодключения(РезультатЗапроса.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработатьОшибкуПодключения(ОписаниеОшибки)
	
	// Инициализация если не были инициализированы
	Если ТекущееКоличествоПопытокПереподключения = Неопределено Тогда
		ТекущееКоличествоПопытокПереподключения = 0;
	КонецЕсли;
	Если МаксимальноеКоличествоПопытокПереподключения = Неопределено Тогда
		МаксимальноеКоличествоПопытокПереподключения = 5;
	КонецЕсли;
	
	ТекущееКоличествоПопытокПереподключения = ТекущееКоличествоПопытокПереподключения + 1;
	
	Если ТекущееКоличествоПопытокПереподключения >= МаксимальноеКоличествоПопытокПереподключения Тогда
		// Превышено количество попыток переподключения
		УстановитьСтатус("Ошибка: " + ОписаниеОшибки, Ложь);
		ДобавитьВЛог("Ошибка подключения: " + ОписаниеОшибки + ". Превышено количество попыток.");
		// В coldstart-режиме — failed: и закрыть новую сессию
		Если ЗначениеЗаполнено(ПутьФайлаСигналаХолодногоСтарта) Тогда
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаХолодногоСтарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("failed:proxy connection failed");
				ЗТ.Закрыть();
			Исключение КонецПопытки;
			ПутьФайлаСигналаХолодногоСтарта = "";
			ЗавершитьРаботуСистемы(Ложь);
			Возврат;
		КонецЕсли;
		// В autostart-режиме — failed: и закрыть новую сессию
		Если ПутьФайлаСигналаАвтостарта <> Неопределено И ПутьФайлаСигналаАвтостарта <> "" Тогда
			Попытка
				ЗТ = Новый ЗаписьТекста(ПутьФайлаСигналаАвтостарта, КодировкаТекста.UTF8);
				ЗТ.ЗаписатьСтроку("failed:Proxy connection failed — new session could not connect");
				ЗТ.Закрыть();
			Исключение
			КонецПопытки;
			ПутьФайлаСигналаАвтостарта = "";
			Попытка УдалитьФайлы(ПутьКлеймаАвтостарта); Исключение КонецПопытки;
			ПутьКлеймаАвтостарта = "";
			ЗавершитьРаботуСистемы(Ложь);
			Возврат;
		КонецЕсли;
		ОтключитьсяОтСервера();
	Иначе
		// Попытка переподключения
		УстановитьСтатус("Переподключение (" + ТекущееКоличествоПопытокПереподключения + "/" + МаксимальноеКоличествоПопытокПереподключения + ")...", Ложь);
		ДобавитьВЛог("Ошибка подключения: " + ОписаниеОшибки + ". Попытка переподключения...");
	КонецЕсли;
	
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────────────────────
// КЭШ ДЛЯ МЕТАДАННЫХ РАСШИРЕНИЙ (клиент хранит токены, сервер хранит данные во ВременномХранилище)
// Внешний API не меняется: токены не уходят наружу (в ОтправитьРезультатНаСервер есть whitelist полей).
// ─────────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция ПолучитьКэшТокеновМетаданныхРасширений()
	Если КэшТокеновМетаданныхРасширений = Неопределено Тогда
		КэшТокеновМетаданныхРасширений = Новый Соответствие;
	КонецЕсли;
	Возврат КэшТокеновМетаданныхРасширений;
КонецФункции

&НаКлиенте
Функция СформироватьКлючКэшаДеталейРасширения(Фильтр, Секции)
	Ключ = ?(Фильтр = Неопределено, "", Строка(Фильтр));
	
	Если Секции = Неопределено Тогда
		Возврат Ключ;
	КонецЕсли;
	
	Попытка
		Если ТипЗнч(Секции) = Тип("Массив") Тогда
			СтрСекции = "";
			Для Каждого Секция Из Секции Цикл
				Секция = СокрЛП(Строка(Секция));
				Если ПустаяСтрока(Секция) Тогда
					Продолжить;
				КонецЕсли;
				СтрСекции = СтрСекции + ?(ПустаяСтрока(СтрСекции), "", ",") + Секция;
			КонецЦикла;
			Если НЕ ПустаяСтрока(СтрСекции) Тогда
				Ключ = Ключ + "|" + СтрСекции;
			КонецЕсли;
		Иначе
			Ключ = Ключ + "|" + Строка(Секции);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Ключ;
КонецФункции

&НаКлиенте
Функция ВыполнитьКомандуСУчетомКонтекста(Команда)

	Если Команда.tool = "execute_code" Тогда
		КонтекстВыполнения = "server";
		Если Команда.Свойство("params") И Команда.params <> Неопределено
			И Команда.params.Свойство("execution_context") Тогда
			КонтекстВыполнения = Команда.params.execution_context;
		КонецЕсли;
		Если КонтекстВыполнения = "client" Тогда
			Код = "";
			Если Команда.params.Свойство("code") Тогда Код = Команда.params.code; КонецЕсли;
			РезультатКлиент = ВыполнитьКодНаКлиенте(Код);
			Если ИспользоватьТочнуюАнонимизацию И РежимПодключения <> 0 Тогда
				Если ТипЗнч(РезультатКлиент) = Тип("Структура") И РезультатКлиент.Свойство("data") Тогда
					РезультатКлиент.Вставить("_original_data_json",        ЗаписатьJSON2(РезультатКлиент.data));
					РезультатКлиент.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				РегексКонтекст = Новый Структура(
					"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
					РезультатКлиент, "", "", Неопределено, Ложь, Истина);
				АнонимизироватьExecuteCodeВстроенный(РезультатКлиент, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						// НЕ выставляем КомпонентаRegexНедоступна — client-path не должен
						// блокировать async-режим на весь сеанс при одном неудачном sync-load
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныExecuteCode(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
			КонецЕсли;
			Возврат РезультатКлиент;
		КонецЕсли;
	КонецЕсли;

	// submit_for_deanonymization выполняется на клиенте (доступ к форменным атрибутам)
	Если Команда.tool = "submit_for_deanonymization" Тогда
		// Защита: инструмент недоступен при выключенной анонимизации даже при прямом вызове
		Если НЕ ИспользоватьТочнуюАнонимизацию Тогда
			Возврат Новый Структура("success, error", Ложь, "Tool is not available: anonymization is disabled");
		КонецЕсли;
		Текст = Неопределено;
		Если Команда.Свойство("params") И Команда.params <> Неопределено Тогда
			Команда.params.Свойство("text", Текст);
		КонецЕсли;
		// Валидация: "text" обязателен (схема required: ["text"]), но built-in tools/call
		// не валидирует аргументы — проверяем тип здесь. Пустая строка допустима.
		// Возвращаем обычную структуру success/error, а не СформироватьToolsCallОшибку —
		// та делает готовую MCP-обёртку, которая будет двойно упакована на уровне выше.
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат Новый Структура("success, error", Ложь, "Missing required parameter: text");
		КонецЕсли;
		Возврат ВыполнитьSubmitForDeanonymization(Текст);
	КонецЕсли;

	// get_bsl_syntax_help выполняется на клиенте (доступ к AddIn SyntaxHelpReader)
	Если Команда.tool = "get_bsl_syntax_help" Тогда
		ПараметрыBSL = Неопределено;
		Если Команда.Свойство("params") Тогда ПараметрыBSL = Команда.params; КонецЕсли;
		Возврат ПолучитьСправкуПоBSL(ПараметрыBSL);
	КонецЕсли;

	// get_screenshot выполняется на клиенте (доступ к AddIn ScreenCapture и ОткрытьФорму)
	Если Команда.tool = "get_screenshot" Тогда
		ПараметрыSnap = Неопределено;
		Если Команда.Свойство("params") Тогда ПараметрыSnap = Команда.params; КонецЕсли;
		Возврат ПолучитьСкриншот(ПараметрыSnap);
	КонецЕсли;

	Возврат ВыполнитьКомандуНаСервереСКэшированием(Команда);

КонецФункции

&НаКлиенте
Функция ВыполнитьКомандуНаСервереСКэшированием(Команда)

	Подготовка = ПодготовитьКомандуНаСервер(Команда);
	Результат = ВыполнитьКомандуМаршрутизировано(Подготовка.КомандаНаСервер);
	Возврат ЗавершитьКомандуНаСервереСКэшированием(Результат, Подготовка);

КонецФункции

// Все, что делается ДО серверного вызова: копия params, токены кэша расширений и
// принудительный include_schema для execute_query. Вынесено отдельно, потому что
// фоновому заданию нужна ровно та же подготовленная команда: без include_schema
// точная анонимизация execute_query не имеет схемы и не срабатывает вовсе
// (задача 000001, шаг 3; поймано замером after_step3_on_serial).
&НаКлиенте
Функция ПодготовитьКомандуНаСервер(Команда)
	ИмяИнструмента = "";
	Попытка
		ИмяИнструмента = СокрЛП(Команда.tool);
	Исключение
		ИмяИнструмента = "";
	КонецПопытки;
	
	// Важно: Команда может быть фиксированной структурой (read-only), поэтому НЕ модифицируем ее.
	// Всегда работаем с копией params в обычной Структуре.
	ПараметрыИсходные = Неопределено;
	Если Команда.Свойство("params") Тогда
		ПараметрыИсходные = Команда.params;
	КонецЕсли;
	
	// ВАЖНО: имя "Параметры" в модуле формы может конфликтовать с одноименным
	// системным/форменным свойством (read-only). Используем уникальное имя.
	ПараметрыКоманды = Новый Структура;
	Если ПараметрыИсходные <> Неопределено Тогда
		Попытка
			Для Каждого Пара Из ПараметрыИсходные Цикл
				ПараметрыКоманды.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
		Исключение
			// Если params не коллекция/не итерируется - оставляем пустыми
		КонецПопытки;
	КонецЕсли;
	
	ИмяРасширения = Неопределено;
	Фильтр = "";
	Секции = Неопределено;
	
	Если ИмяИнструмента = "get_metadata" И ПараметрыКоманды <> Неопределено Тогда
		Если ПараметрыКоманды.Свойство("extension_name") Тогда
			ИмяРасширения = ПараметрыКоманды.extension_name;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("filter") Тогда
			Фильтр = ПараметрыКоманды.filter;
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("sections") Тогда
			Секции = ПараметрыКоманды.sections;
		КонецЕсли;
	КонецЕсли;
	
	КлючДеталей = "";
	
	// Добавляем токены кэша только для режима "объекты расширения" (extension_name="Имя")
	Если ИмяИнструмента = "get_metadata"
		И ИмяРасширения <> Неопределено
		И ТипЗнч(ИмяРасширения) = Тип("Строка")
		И НЕ ПустаяСтрока(ИмяРасширения) Тогда
		
		Кэш = ПолучитьКэшТокеновМетаданныхРасширений();
		Запись = Кэш.Получить(ИмяРасширения);
		
		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"hash, data_token, index_token, details, details_order",
				"",
				Неопределено,
				Неопределено,
				Новый Соответствие,
				Новый Массив
			);
			Кэш.Вставить(ИмяРасширения, Запись);
		КонецЕсли;
		
		Если Запись.hash <> "" Тогда
			ПараметрыКоманды.Вставить("mcp_cache_hash", Запись.hash);
		КонецЕсли;
		Если Запись.data_token <> Неопределено Тогда
			ПараметрыКоманды.Вставить("mcp_cache_data_token", Запись.data_token);
		КонецЕсли;
		Если Запись.index_token <> Неопределено Тогда
			ПараметрыКоманды.Вставить("mcp_cache_index_token", Запись.index_token);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(Фильтр) Тогда
			КлючДеталей = СформироватьКлючКэшаДеталейРасширения(Фильтр, Секции);
			ТокенДеталей = Запись.details.Получить(КлючДеталей);
			Если ТокенДеталей <> Неопределено Тогда
				ПараметрыКоманды.Вставить("mcp_cache_details_token", ТокенДеталей);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Передаем на сервер копию команды с измененными params (если добавили токены кэша)
	КомандаНаСервер = Новый Структура;
	Попытка
		Если Команда.Свойство("id") Тогда
			КомандаНаСервер.Вставить("id", Команда.id);
		КонецЕсли;
	Исключение
	КонецПопытки;
	АнонСхемаПринудительно = Ложь;
	Если РежимПодключения <> 0 И ИспользоватьТочнуюАнонимизацию
		И ИмяИнструмента = "execute_query" Тогда
		АнонАгентЗапросилСхему = ПараметрыКоманды.Свойство("include_schema")
			И ПараметрыКоманды.include_schema = Истина;
		Если НЕ АнонАгентЗапросилСхему Тогда
			ПараметрыКоманды.Вставить("include_schema", Истина);
			АнонСхемаПринудительно = Истина;
		КонецЕсли;
	КонецЕсли;
	КомандаНаСервер.Вставить("tool", ИмяИнструмента);
	КомандаНаСервер.Вставить("params", ПараметрыКоманды);

	Возврат Новый Структура("КомандаНаСервер, ПараметрыКоманды, АнонСхемаПринудительно, ИмяИнструмента, ИмяРасширения, Фильтр, Секции, КлючДеталей",
		КомандаНаСервер, ПараметрыКоманды, АнонСхемаПринудительно, ИмяИнструмента, ИмяРасширения, Фильтр, Секции, КлючДеталей);

КонецФункции

// Все, что делается ПОСЛЕ серверного вызова: маркер _anon_schema_forced, синхронные
// ветки анонимизации и учет токенов кэша расширений. Фоновый путь обязан пройти
// этот же хвост, иначе get_metadata по расширению теряет кэш, а результат уносит
// наружу служебные поля mcp_cache_*.
&НаКлиенте
Функция ЗавершитьКомандуНаСервереСКэшированием(Результат, Подготовка)

	ПараметрыКоманды       = Подготовка.ПараметрыКоманды;
	АнонСхемаПринудительно = Подготовка.АнонСхемаПринудительно;
	ИмяИнструмента         = Подготовка.ИмяИнструмента;
	ИмяРасширения          = Подготовка.ИмяРасширения;
	Фильтр                 = Подготовка.Фильтр;
	Секции                 = Подготовка.Секции;
	КлючДеталей            = Подготовка.КлючДеталей;
	Если АнонСхемаПринудительно И Результат <> Неопределено
		И ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("success") И Результат.success
		И Результат.Свойство("schema") Тогда
		Результат.Вставить("_anon_schema_forced", Истина);
	КонецЕсли;
	Если НЕ ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		ТекстЗапросаLineage = "";
		Если ПараметрыКоманды.Свойство("query") Тогда
			ТекстЗапросаLineage = ПараметрыКоманды.query;
		КонецЕсли;
		Если НуженLineageДляРезультата(ИмяИнструмента, ТекстЗапросаLineage, Результат) Тогда
			Результат = ОбогатитьСхемуИсточниками(ТекстЗапросаLineage, Результат);
		КонецЕсли;
	КонецЕсли;
	Если НЕ ИспользоватьАсинхронноеПодключениеКомпонент Тогда
		Если ИмяИнструмента = "execute_query" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0
				И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			Результат = ПрименитьТочнуюPolicyКРезультатуExecuteQuery(Результат, РежимПодключения = 0,
				ПолучитьНастройкиТочнойАнонимизации());
			Если РежимПодключения <> 0 Тогда
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				АнонимизироватьРезультатВстроенный(Результат, РегексКонтекст);
				// Lazy-load и inline regex-фаза
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокены(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный(); // ПОСЛЕ regex-токенов
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("ЭтоОбъект",             Истина);
				АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныОбъект(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
				Попытка Результат.Удалить("schema");               Исключение КонецПопытки;
				Попытка Результат.Удалить("_anon_schema_forced");  Исключение КонецПопытки;
				// _original_data_json НЕ удаляем — ПолучитьТекстРезультата()
				// берёт его для журнала событий формы (отображаются НЕ анонимизированные данные).
				// Наружу (к AI) он не уйдёт — отфильтруется whitelist в финальном ответе.
				Попытка Результат.Удалить("_blind_anonymization"); Исключение КонецПопытки;
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("ЭтоFindReferences",     Истина);
				АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныFindReferences(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
				// _original_data_json НЕ удаляем - ПолучитьТекстРезультата()
				// берёт его для журнала событий формы (отображаются НЕ анонимизированные данные).
				// Наружу (к AI) он не уйдёт — отфильтруется whitelist в финальном ответе.
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "get_event_log" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				РегексКонтекст = Новый Структура;
				РегексКонтекст.Вставить("Результат",            Результат);
				РегексКонтекст.Вставить("ВключённыеПравилаJSON", "");
				РегексКонтекст.Вставить("ТекстыJSON",            "");
				РегексКонтекст.Вставить("МаппингИндексов",       Неопределено);
				РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Ложь);
				РегексКонтекст.Вставить("ЭтоGetEventLog",        Истина);
				АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст);
				Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
					Если КомпонентаRegex = Неопределено Тогда
						ПодключитьКомпонентуRegexСинхронно();
						Если КомпонентаRegex = Неопределено Тогда
							КомпонентаRegexНедоступна = Истина;
						КонецЕсли;
					КонецЕсли;
					Если КомпонентаRegex <> Неопределено Тогда
						СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
							РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
						ПрименитьRegexТокеныGetEventLog(РегексКонтекст, СовпаденияJSON);
					КонецЕсли;
				КонецЕсли;
				ОбновитьТаблицуМаппинговВстроенный();
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "get_access_rights" И ИспользоватьТочнуюАнонимизацию Тогда
			Если РежимПодключения <> 0 Тогда
				Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
					Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
					Результат.Вставить("_original_data_anon_marker", Истина);
				КонецЕсли;
				АнонимизироватьРезультатGetAccessRights(Результат);
				ОбновитьТаблицуМаппинговВстроенный();
				// _original_data_json НЕ удаляем — ПолучитьТекстРезультата()
				// берёт его для журнала событий формы (отображаются НЕ анонимизированные данные).
				// Наружу (к AI) он не уйдёт — отфильтруется whitelist в финальном ответе.
			КонецЕсли;
		ИначеЕсли ИмяИнструмента = "execute_code" И ИспользоватьТочнуюАнонимизацию И РежимПодключения <> 0 Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json",        ЗаписатьJSON2(Результат.data));
				Результат.Вставить("_original_data_anon_marker", Истина);
			КонецЕсли;
			РегексКонтекст = Новый Структура(
				"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
			Если КомпонентаRegexНедоступна <> Истина И РегексКонтекст.ЕстьТекстыДляRegex Тогда
				Если КомпонентаRegex = Неопределено Тогда
					ПодключитьКомпонентуRegexСинхронно();
					Если КомпонентаRegex = Неопределено Тогда КомпонентаRegexНедоступна = Истина; КонецЕсли;
				КонецЕсли;
				Если КомпонентаRegex <> Неопределено Тогда
					СовпаденияJSON = КомпонентаRegex.НайтиСовпаденияВТекстах(
						РегексКонтекст.ВключённыеПравилаJSON, РегексКонтекст.ТекстыJSON);
					ПрименитьRegexТокеныExecuteCode(РегексКонтекст, СовпаденияJSON);
				КонецЕсли;
			КонецЕсли;
			ОбновитьТаблицуМаппинговВстроенный();
		КонецЕсли;
	КонецЕсли;
	Если АнонСхемаПринудительно И НЕ ИспользоватьАсинхронноеПодключениеКомпонент
		И Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") Тогда
		Попытка Результат.Удалить("schema"); Исключение КонецПопытки;
		Попытка Результат.Удалить("_anon_schema_forced"); Исключение КонецПопытки;
	КонецЕсли;

	// Обновляем кэш по внутренним полям результата (они не уходят наружу из-за whitelist)
	Если ИмяИнструмента = "get_metadata"
		И ИмяРасширения <> Неопределено
		И ТипЗнч(ИмяРасширения) = Тип("Строка")
		И НЕ ПустаяСтрока(ИмяРасширения) Тогда
		
		Попытка
			Если Результат <> Неопределено
				И ТипЗнч(Результат) = Тип("Структура") Тогда
				
				Кэш = ПолучитьКэшТокеновМетаданныхРасширений();
				Запись = Кэш.Получить(ИмяРасширения);
				Если Запись = Неопределено Тогда
					Запись = Новый Структура(
						"hash, data_token, index_token, details, details_order",
						"",
						Неопределено,
						Неопределено,
						Новый Соответствие,
						Новый Массив
					);
				КонецЕсли;
				
				НовХеш = "";
				Если Результат.Свойство("mcp_cache_hash") Тогда
					НовХеш = Строка(Результат.mcp_cache_hash);
				КонецЕсли;
				
				Если НЕ ПустаяСтрока(НовХеш) И Запись.hash <> "" И Запись.hash <> НовХеш Тогда
					Запись.hash = НовХеш;
					Запись.data_token = Неопределено;
					Запись.index_token = Неопределено;
					Запись.details = Новый Соответствие;
					Запись.details_order = Новый Массив;
				ИначеЕсли НЕ ПустаяСтрока(НовХеш) Тогда
					Запись.hash = НовХеш;
				КонецЕсли;
				
				Если Результат.Свойство("mcp_cache_data_token") Тогда
					Запись.data_token = Результат.mcp_cache_data_token;
				КонецЕсли;
				Если Результат.Свойство("mcp_cache_index_token") Тогда
					Запись.index_token = Результат.mcp_cache_index_token;
				КонецЕсли;
				
				Если Результат.Свойство("mcp_cache_details_token") И НЕ ПустаяСтрока(Фильтр) Тогда
					Если ПустаяСтрока(КлючДеталей) Тогда
						КлючДеталей = СформироватьКлючКэшаДеталейРасширения(Фильтр, Секции);
					КонецЕсли;
					ТокенДеталей = Результат.mcp_cache_details_token;
					Если ТокенДеталей <> Неопределено Тогда
						Запись.details.Вставить(КлючДеталей, ТокенДеталей);
						Запись.details_order.Добавить(КлючДеталей);
						
						// Ограничиваем размер кэша деталей, чтобы не раздувать память/ВременноеХранилище бесконечно
						МаксДеталей = 50;
						Если Запись.details_order.Количество() > МаксДеталей Тогда
							СтарыйКлюч = Запись.details_order[0];
							Запись.details_order.Удалить(0);
							Попытка
								Запись.details.Удалить(СтарыйКлюч);
							Исключение
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Кэш.Вставить(ИмяРасширения, Запись);
				
				// Не светим токены в текстовых логах формы
				Если Результат.Свойство("mcp_cache_hash") Тогда Результат.Удалить("mcp_cache_hash"); КонецЕсли;
				Если Результат.Свойство("mcp_cache_data_token") Тогда Результат.Удалить("mcp_cache_data_token"); КонецЕсли;
				Если Результат.Свойство("mcp_cache_index_token") Тогда Результат.Удалить("mcp_cache_index_token"); КонецЕсли;
				Если Результат.Свойство("mcp_cache_details_token") Тогда Результат.Удалить("mcp_cache_details_token"); КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОбработатьКоманду(Команда)

	// restart/close обрабатываются до обычного flow — отложенный ответ
	Если Команда.tool = "restart_1c_session" Тогда
		ВыполнитьПерезапускСессии(Команда.id);
		Возврат;
	КонецЕсли;
	Если Команда.tool = "close_1c_session" Тогда
		ВыполнитьЗакрытиеСессии(Команда.id);
		Возврат;
	КонецЕсли;

	// Формируем информативное сообщение о команде
	ТекстКоманды = ПолучитьТекстКоманды(Команда);
	ДобавитьВЛог("Получена команда: " + Команда.tool + Символы.ПС + ТекстКоманды);

	Если РежимПодключения <> 0 Тогда
		ДеАнонимизироватьПараметрыКомандыИВытеснить(Команда);
	КонецЕсли;

	// Проверка необходимости подтверждения опасной операции
	Если Команда.Свойство("params") И Команда.params <> Неопределено Тогда
		ПараметрыКоманды = Команда.params;
		
		Если ПараметрыКоманды.Свойство("requires_approval") И ПараметрыКоманды.requires_approval = Истина Тогда
			
			// Получение массива опасных ключевых слов
			МассивОпасныхСлов = Новый Массив;
			ОпасныеСлова = "";
			Если ПараметрыКоманды.Свойство("dangerous_keywords") Тогда
				Для Каждого Слово Из ПараметрыКоманды.dangerous_keywords Цикл
					МассивОпасныхСлов.Добавить(Слово);
					ОпасныеСлова = ОпасныеСлова + ?(ПустаяСтрока(ОпасныеСлова), "", ", ") + Слово;
				КонецЦикла;
			КонецЕсли;
			
 			// Проверка автоматического разрешения
 			Если ВсеОперацииАвтоРазрешены(МассивОпасныхСлов) Тогда
 				ДобавитьВЛог("Операции автоматически разрешены: " + ОпасныеСлова);
				Попытка
					Результат = ВыполнитьКомандуСУчетомКонтекста(Команда);
				Исключение
					ТекстОшибки = ОписаниеОшибки();
					ДобавитьВЛог("Ошибка выполнения команды на сервере 1С: " + ТекстОшибки);
					Результат = Новый Структура(
						"success, error",
						Ложь,
						"Ошибка выполнения команды на сервере 1С: " + ТекстОшибки
						+ " / Error executing command in 1C server: " + ТекстОшибки
					);
				КонецПопытки;
				ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Команда);
				Если ИспользоватьАсинхронноеПодключениеКомпонент
					И НуженLineageДляРезультата(Команда.tool, ТекстЗапросаLineage, Результат) Тогда
					КонтекстLineage = Новый Структура("Режим, КомандаId, Результат, ТекстЗапроса",
						"proxy", Команда.id, Результат, ТекстЗапросаLineage);
					НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
					Возврат;
				КонецЕсли;
  				РезультатОтправки = ОтправитьРезультатНаСервер(АдресСервера, Команда.id, Результат);
 				
 				Если РезультатОтправки.Успех Тогда
 					ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
				Иначе
					ДобавитьВЛог("Ошибка отправки результата: " + РезультатОтправки.ОписаниеОшибки);
				КонецЕсли;
 				
				Возврат;
			КонецЕсли;

			// Получение кода
			Код = "";
			Если ПараметрыКоманды.Свойство("code") Тогда
				Код = ПараметрыКоманды.code;
			КонецЕсли;
			
			ДобавитьВЛог("Требуется подтверждение пользователя. Опасные слова: " + ОпасныеСлова);
			
			// Показ формы подтверждения
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ОпасныеСлова", ОпасныеСлова);
			ПараметрыФормы.Вставить("Код", Код);
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОбработатьРезультатПодтверждения", 
				ЭтаФорма, 
				Новый Структура("Команда", Команда)
			);
			
			ОткрытьФорму(
				"ВнешняяОбработка.MCPToolkit.Форма.ФормаПодтверждения",
				ПараметрыФормы,
				ЭтаФорма,
				,
				,
				,
				ОписаниеОповещения,
				РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс
			);
			
			Возврат;
		КонецЕсли;
 	КонецЕсли;
 	
 	// Обычное выполнение без подтверждения
	Попытка
		Результат = ВыполнитьКомандуСУчетомКонтекста(Команда);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ДобавитьВЛог("Ошибка выполнения команды на сервере 1С: " + ТекстОшибки);
		Результат = Новый Структура(
			"success, error",
			Ложь,
			"Ошибка выполнения команды на сервере 1С: " + ТекстОшибки
			+ " / Error executing command in 1C server: " + ТекстОшибки
		);
	КонецПопытки;
	ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Команда);
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И НуженLineageДляРезультата(Команда.tool, ТекстЗапросаLineage, Результат) Тогда
		КонтекстLineage = Новый Структура("Режим, КомандаId, Результат, ТекстЗапроса",
			"proxy", Команда.id, Результат, ТекстЗапросаLineage);
		НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
		Возврат;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И Команда.tool = "get_object_by_link" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json", ЗаписатьJSON2(Результат.data));
		КонецЕсли;
		Результат = ПрименитьТочнуюPolicyКРезультатуGetObjectByLink(Результат);
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоОбъект",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, КомандаId, Результат",
			"proxy", Команда.id, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И Команда.tool = "find_references_to_object" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json", ЗаписатьJSON2(Результат.data));
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоFindReferences",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, КомандаId, Результат",
			"proxy", Команда.id, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И Команда.tool = "get_event_log" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json", ЗаписатьJSON2(Результат.data));
		КонецЕсли;
		РегексКонтекст = Новый Структура("Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингИндексов, ЕстьТекстыДляRegex, ЭтоGetEventLog",
			Результат, "", "", Неопределено, Ложь, Истина);
		АнонимизироватьРезультатGetEventLogВстроенный(Результат, РегексКонтекст);
		КонтекстLineage = Новый Структура("Режим, КомандаId, Результат",
			"proxy", Команда.id, Результат);
		РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
		ЗапуститьRegexФазу(РегексКонтекст);
		Возврат;
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И Команда.tool = "get_access_rights" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
			Результат.Вставить("_original_data_json", ЗаписатьJSON2(Результат.data));
		КонецЕсли;
		АнонимизироватьРезультатGetAccessRights(Результат);
		ОбновитьТаблицуМаппинговВстроенный();
		// _original_data_json НЕ удаляем — ПолучитьТекстРезультата()
		// берёт его для журнала событий формы (отображаются НЕ анонимизированные данные).
		// Наружу (к AI) он не уйдёт — отфильтруется whitelist в финальном ответе.
	КонецЕсли;
	Если ИспользоватьАсинхронноеПодключениеКомпонент
		И Команда.tool = "execute_code" И ИспользоватьТочнуюАнонимизацию
		И РежимПодключения <> 0 Тогда
		УжеАнонимизирован = Ложь;
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			ВремАнон = Неопределено;
			УжеАнонимизирован = Результат.Свойство("_original_data_json", ВремАнон) И ЗначениеЗаполнено(ВремАнон);
		КонецЕсли;
		Если НЕ УжеАнонимизирован Тогда
			Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("data") Тогда
				Результат.Вставить("_original_data_json", ЗаписатьJSON2(Результат.data));
			КонецЕсли;
			РегексКонтекст = Новый Структура(
				"Результат, ВключённыеПравилаJSON, ТекстыJSON, МаппингПутей, ЕстьТекстыДляRegex, ЭтоExecuteCode",
				Результат, "", "", Неопределено, Ложь, Истина);
			АнонимизироватьExecuteCodeВстроенный(Результат, РегексКонтекст);
			КонтекстLineage = Новый Структура("Режим, КомандаId, Результат",
				"proxy", Команда.id, Результат);
			РегексКонтекст.Вставить("КонтекстLineage", КонтекстLineage);
			ЗапуститьRegexФазу(РегексКонтекст);
			Возврат;
		КонецЕсли;
	КонецЕсли;

  	// Отправка результата на сервер
  	РезультатОтправки = ОтправитьРезультатНаСервер(АдресСервера, Команда.id, Результат);
	
	Если РезультатОтправки.Успех Тогда
		ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	Иначе
		ДобавитьВЛог("Ошибка отправки результата: " + РезультатОтправки.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатПодтверждения(Разрешено, ДополнительныеПараметры) Экспорт
	
	Команда = ДополнительныеПараметры.Команда;
	
 	Если Разрешено = Истина Тогда
 		ДобавитьВЛог("Пользователь разрешил выполнение опасной операции");
		Попытка
			Результат = ВыполнитьКомандуСУчетомКонтекста(Команда);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ДобавитьВЛог("Ошибка выполнения команды на сервере 1С: " + ТекстОшибки);
			Результат = Новый Структура(
				"success, error",
				Ложь,
				"Ошибка выполнения команды на сервере 1С: " + ТекстОшибки
				+ " / Error executing command in 1C server: " + ТекстОшибки
			);
		КонецПопытки;
		ТекстЗапросаLineage = ПолучитьТекстЗапросаLineageИзКоманды(Команда);
		Если ИспользоватьАсинхронноеПодключениеКомпонент
			И НуженLineageДляРезультата(Команда.tool, ТекстЗапросаLineage, Результат) Тогда
			КонтекстLineage = Новый Структура("Режим, КомандаId, Результат, ТекстЗапроса",
				"proxy", Команда.id, Результат, ТекстЗапросаLineage);
			НачатьАсинхронноеОбогащениеСхемыИсточниками(КонтекстLineage);
			Возврат;
		КонецЕсли;
  	Иначе
  		ДобавитьВЛог("Пользователь отклонил выполнение опасной операции");
		
		// Формирование списка опасных слов для сообщения
		ОпасныеСлова = "";
		Если Команда.Свойство("params") И Команда.params <> Неопределено Тогда
			ПараметрыКоманды = Команда.params;
			Если ПараметрыКоманды.Свойство("dangerous_keywords") Тогда
				Для Каждого Слово Из ПараметрыКоманды.dangerous_keywords Цикл
					ОпасныеСлова = ОпасныеСлова + ?(ПустаяСтрока(ОпасныеСлова), "", ", ") + Слово;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Результат = Новый Структура("success, error", Ложь, 
			"Операция отклонена пользователем. Код содержит опасные ключевые слова: " + ОпасныеСлова + 
			" / Operation rejected by user. Code contains dangerous keywords: " + ОпасныеСлова);
	КонецЕсли;
	
	// Отправка результата на сервер
	РезультатОтправки = ОтправитьРезультатНаСервер(АдресСервера, Команда.id, Результат);
	
	Если РезультатОтправки.Успех Тогда
		ДобавитьВЛог("Результат команды отправлен успешно" + Символы.ПС + ПолучитьТекстРезультата(Результат));
	Иначе
		ДобавитьВЛог("Ошибка отправки результата: " + РезультатОтправки.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВсеОперацииАвтоРазрешены(МассивОпасныхСлов)
	
	// Соответствие ключевых слов и флагов автоматического разрешения
	СоответствиеФлагов = Новый Соответствие;
	СоответствиеФлагов.Вставить("ЗАПИСАТЬ", АвтоРазрешитьЗаписать);
	СоответствиеФлагов.Вставить("WRITE", АвтоРазрешитьЗаписать);
	СоответствиеФлагов.Вставить("УСТАНОВИТЬПРИВИЛЕГИРОВАННЫЙРЕЖИМ", АвтоРазрешитьПривилегированныйРежим);
	СоответствиеФлагов.Вставить("SETPRIVILEGEDMODE", АвтоРазрешитьПривилегированныйРежим);
	
	// Проверка каждого опасного слова
	Для Каждого Слово Из МассивОпасныхСлов Цикл
		СловоВерхнийРегистр = ВРег(Слово);
		ФлагРазрешения = СоответствиеФлагов.Получить(СловоВерхнийРегистр);
		
		Если ФлагРазрешения = Неопределено Или ФлагРазрешения = Ложь Тогда
			Возврат Ложь; // Есть неразрешённая операция
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина; // Все операции автоматически разрешены
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекстКоманды(Команда)
	
	ТекстКоманды = "";
	Отступ = "    "; // 4 пробела
	
	Если Не Команда.Свойство("params") Или Команда.params = Неопределено Тогда
		Возврат Отступ + "(без параметров)";
	КонецЕсли;
	
	ПараметрыКоманды = Команда.params;
	
	Если Команда.tool = "execute_query" Тогда
		Если ПараметрыКоманды.Свойство("query") Тогда
			ТекстКоманды = ПараметрыКоманды.query;
		КонецЕсли;
	ИначеЕсли Команда.tool = "execute_code" Тогда
		Если ПараметрыКоманды.Свойство("code") Тогда
			ТекстКоманды = ПараметрыКоманды.code;
		КонецЕсли;
	ИначеЕсли Команда.tool = "get_metadata" Тогда
		ЧастиТекста = Новый Массив;
		Если ПараметрыКоманды.Свойство("filter") И Не ПустаяСтрока(ПараметрыКоманды.filter) Тогда
			ЧастиТекста.Добавить("фильтр: " + ПараметрыКоманды.filter);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("meta_type") И Не ПустаяСтрока(ПараметрыКоманды.meta_type) Тогда
			ЧастиТекста.Добавить("тип: " + ПараметрыКоманды.meta_type);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("name_mask") И Не ПустаяСтрока(ПараметрыКоманды.name_mask) Тогда
			ЧастиТекста.Добавить("маска: " + ПараметрыКоманды.name_mask);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("attribute_mask") И Не ПустаяСтрока(ПараметрыКоманды.attribute_mask) Тогда
			ЧастиТекста.Добавить("маска атрибута: " + ПараметрыКоманды.attribute_mask);
		КонецЕсли;
		Если ПараметрыКоманды.Свойство("extension_name") И ПараметрыКоманды.extension_name <> Неопределено Тогда
			ЧастиТекста.Добавить("расширение: " + ?(ПустаяСтрока(ПараметрыКоманды.extension_name), "(конфигурация)", ПараметрыКоманды.extension_name));
