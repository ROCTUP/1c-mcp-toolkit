					КонецЕсли;
				Исключение
					Реквизиты.Добавить(Новый Структура("Имя, Синоним, Тип, Стандартный", "", "", "", Ложь));
					СчётчикиТипов.Добавить(Новый Структура("ВсегоТипов, ПоказаноТипов, ТекстОшибки",
