	ТокенСервера = Строка(Новый УникальныйИдентификатор());
	НастройкаПриИзменении(Неопределено);
КонецПроцедуры

&НаСервере
Процедура РежимКомпонентПриИзмененииНаСервере()
	СнимокАдресовСервераJSON = "";
	ЗаполнитьСписокАдресовСервера(Новый Массив);
	ОбновитьПодсказкуАдресаСервера();
	ПроверитьИзмененияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РежимКомпонентПриИзменении(Элемент)
	РежимКомпонентПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)
	ПроверитьИзмененияНаСервере();
КонецПроцедуры

&НаСервере
Функция СобратьПрофильФормы()
	ОбработкаСервера = РеквизитФормыВЗначение("Объект");
	Правила = ОбработкаСервера.ПрочитатьJSON2(НастройкиПрофиляJSON);
	Настройки = Новый Структура("transport,parallel,anonymization,aggressive,format,allow_write,allow_privileged",
		?(РежимПодключения = 0, "proxy", "embedded"), ПараллельноеВыполнение, Анонимизация, АгрессивнаяАнонимизация, ФорматОтвета, РазрешитьЗапись, РазрешитьПривилегированный);
	Настройки.Вставить("proxy_url", АдресПрокси); Настройки.Вставить("proxy_channel", КаналПрокси);
	Настройки.Вставить("include_infobase", ДобавлятьИнформациюОБазе);
	Настройки.Вставить("deanonymization_api_enabled", ДеанонимизацияЧерезAPI);
	Настройки.Вставить("component_connection_mode", РежимПодключенияКомпонент);
	Настройки.Вставить("exact_rules", Правила.exact_rules); Настройки.Вставить("regex_rules", Правила.regex_rules);
	Инструменты = Новый Массив;
	Если ИнструментВключен_ExecuteQuery Тогда Инструменты.Добавить("execute_query"); КонецЕсли;
	Если ИнструментВключен_ExecuteCode Тогда Инструменты.Добавить("execute_code"); КонецЕсли;
	Если ИнструментВключен_GetMetadata Тогда Инструменты.Добавить("get_metadata"); КонецЕсли;
	Если ИнструментВключен_GetEventLog Тогда Инструменты.Добавить("get_event_log"); КонецЕсли;
	Если ИнструментВключен_GetObjectByLink Тогда Инструменты.Добавить("get_object_by_link"); КонецЕсли;
	Если ИнструментВключен_GetLinkOfObject Тогда Инструменты.Добавить("get_link_of_object"); КонецЕсли;
	Если ИнструментВключен_FindReferences Тогда Инструменты.Добавить("find_references_to_object"); КонецЕсли;
	Если ИнструментВключен_GetAccessRights Тогда Инструменты.Добавить("get_access_rights"); КонецЕсли;
	Если ИнструментВключен_GetBslSyntaxHelp Тогда Инструменты.Добавить("get_bsl_syntax_help"); КонецЕсли;
	Настройки.Вставить("tools", Инструменты);
	Возврат Новый Структура("port,bind,token,settings", ПортСервера, АдресПривязки, ТокенСервера, Настройки);
КонецФункции

&НаСервере
Процедура ПроверитьИзмененияНаСервере()
	ОбновитьПоляТранспорта();
	ЕстьИзменения = ИсходныйПрофиль <> ЗначениеВСтрокуВнутр(СобратьПрофильФормы())
		Или ИсходноеРасписание <> ЗначениеВСтрокуВнутр(Новый Структура("enabled,schedule", ЗапускатьПоРасписанию, РасписаниеСтрока));
	Модифицированность = ЕстьИзменения; ОбновитьПредставленияНастроек();
КонецПроцедуры

&НаСервере
Функция КлиентскиеНастройкиАнонимизации()
	ОбработкаСервера = РеквизитФормыВЗначение("Объект");
	Настройки = ОбработкаСервера.НастройкиСервераMCPПоУмолчанию();
	Настройки.aggressive = Ложь; Настройки.Вставить("defaults", Истина);
	Флаг = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ИспользоватьТочнуюАнонимизацию");
	Если ТипЗнч(Флаг) = Тип("Булево") Тогда Настройки.anonymization = Флаг; Настройки.defaults = Ложь; КонецЕсли;
	Набор = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v2");
	Если ТипЗнч(Набор) <> Тип("Структура") Или НЕ Набор.Свойство("Правила") Тогда Набор = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "ExecuteQueryFieldRules.v1"); КонецЕсли;
	Если ТипЗнч(Набор) = Тип("Структура") И Набор.Свойство("Правила") Тогда
		Настройки.exact_rules = ПравилаКлиентаДляПрофиля(Набор.Правила); Настройки.defaults = Ложь;
		Если Набор.Свойство("aggressive_mode") Тогда Настройки.aggressive = Набор.aggressive_mode; КонецЕсли;
	КонецЕсли;
	Регекс = ХранилищеОбщихНастроек.Загрузить("ExecuteQueryRegexRules.v1", "rules");
	Если ЗначениеЗаполнено(Регекс) Тогда Настройки.regex_rules = ОбработкаСервера.ПрочитатьJSON2(Регекс).rules; Настройки.defaults = Ложь; КонецЕсли;
	Возврат Настройки;
КонецФункции

&НаСервере
Функция ПравилаКлиентаДляПрофиля(ПравилаКлиента)
	Если ТипЗнч(ПравилаКлиента) = Тип("Массив") Тогда Возврат ПравилаКлиента; КонецЕсли;
	Если ТипЗнч(ПравилаКлиента) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Неверный формат сохранённых клиентских правил анонимизации.";
	КонецЕсли;
	ПравилаПрофиля = Новый Массив;
	ЕстьСловарь = ПравилаКлиента.Колонки.Найти("use_for_dictionary") <> Неопределено;
	ЕстьКатегория = ПравилаКлиента.Колонки.Найти("token_category") <> Неопределено;
	Для Каждого СтрокаПравила Из ПравилаКлиента Цикл
		Правило = Новый Структура("source_path,action,match_kind,use_for_dictionary,token_category",
			СтрокаПравила.source_path, СтрокаПравила.action, СтрокаПравила.match_kind, Ложь, "");
		Если ЕстьСловарь Тогда Правило.use_for_dictionary = СтрокаПравила.use_for_dictionary; КонецЕсли;
		Если ЕстьКатегория Тогда Правило.token_category = СтрокаПравила.token_category; КонецЕсли;
		ПравилаПрофиля.Добавить(Правило);
	КонецЦикла;
	Возврат ПравилаПрофиля;
КонецФункции

&НаСервере
Функция ЗначенияНастроекРавны(Первое, Второе)
	Если ТипЗнч(Первое) <> ТипЗнч(Второе) Тогда Возврат Ложь; КонецЕсли;
	Если ТипЗнч(Первое) = Тип("Структура") Тогда
		Если Первое.Количество() <> Второе.Количество() Тогда Возврат Ложь; КонецЕсли;
		Для Каждого Пара Из Первое Цикл
			ЗначениеВторого = Неопределено;
			Если НЕ Второе.Свойство(Пара.Ключ, ЗначениеВторого) Тогда Возврат Ложь; КонецЕсли;
			Если НЕ ЗначенияНастроекРавны(Пара.Значение, ЗначениеВторого) Тогда Возврат Ложь; КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	ИначеЕсли ТипЗнч(Первое) = Тип("Массив") Тогда
		Если Первое.Количество() <> Второе.Количество() Тогда Возврат Ложь; КонецЕсли;
		Для Индекс = 0 По Первое.Количество() - 1 Цикл Если НЕ ЗначенияНастроекРавны(Первое[Индекс], Второе[Индекс]) Тогда Возврат Ложь; КонецЕсли; КонецЦикла;
		Возврат Истина;
	КонецЕсли;
	Возврат Первое = Второе;
КонецФункции

&НаСервере
Процедура ОбновитьПредставленияНастроек()
	Элементы.КнопкаНастроитьРасписание.Доступность = ЗапускатьПоРасписанию;
	Профиль = СобратьПрофильФормы(); Настройки = Профиль.settings; Включено = 0;
	ИсходныеНастройки = ЗначениеИзСтрокиВнутр(ИсходныйПрофиль).settings;
	Части = Новый Структура("anonymization,aggressive,exact_rules,regex_rules", "использование анонимизации", "агрессивный режим", "явные правила", "Regex-правила");
	ИзмененаАнонимизация = Ложь;
	Для Каждого Пара Из Части Цикл
		Если НЕ ЗначенияНастроекРавны(Настройки[Пара.Ключ], ИсходныеНастройки[Пара.Ключ]) Тогда ИзмененаАнонимизация = Истина; Прервать; КонецЕсли;
	КонецЦикла;
	Для Каждого Правило Из Настройки.regex_rules Цикл Если НЕ Правило.Свойство("enabled") Или Правило.enabled Тогда Включено = Включено + 1; КонецЕсли; КонецЦикла;
	СводкаАнонимизации = ?(ИзмененаАнонимизация, "Несохранённые настройки", ?(ПрофильСохранен, "Сохранённые настройки", "Настройки по умолчанию"))
		+ " (" + Строка(Настройки.exact_rules.Количество()) + " явных правил, " + Строка(Настройки.regex_rules.Количество()) + " Regex-правил, из них включено " + Строка(Включено) + ")";
	Попытка
		Клиент = КлиентскиеНастройкиАнонимизации(); Отличия = "";
		Для Каждого Пара Из Части Цикл
			Если НЕ ЗначенияНастроекРавны(Настройки[Пара.Ключ], Клиент[Пара.Ключ]) Тогда Отличия = Отличия + ?(Отличия = "", "", ", ") + Пара.Значение; КонецЕсли;
		КонецЦикла;
		СравнениеАнонимизации = ?(Отличия = "", "Совпадают с клиентскими настройками текущего пользователя", "Отличаются от клиентских настроек текущего пользователя: " + Отличия) + ?(Клиент.defaults, " (по умолчанию)", "");
	Исключение СравнениеАнонимизации = "Не удалось сравнить с клиентскими настройками"; КонецПопытки;
	Расписание = ЗначениеИзСтрокиВнутр(РасписаниеСтрока);
	ПредставлениеРасписания = ?(Расписание = Неопределено, "Расписание не задано", Строка(Расписание));
	Если ИсходноеРасписание <> ЗначениеВСтрокуВнутр(Новый Структура("enabled,schedule", ЗапускатьПоРасписанию, РасписаниеСтрока)) Тогда ПредставлениеРасписания = "Не сохранено. " + ПредставлениеРасписания; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт
	ВопросОткрыт = Ложь;
	Если Ответ = КодВозвратаДиалога.Да Тогда ОбновитьНаСервере(Истина); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДействиеПослеСохранения(Действие)
	Если ЕстьИзменения Или НЕ ПрофильСохранен Тогда
		Если ВопросОткрыт Тогда Возврат; КонецЕсли;
		ВопросОткрыт = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗапуститьПослеВопроса", ЭтаФорма, Действие),
			?(Действие = "Запустить", "Сохранить изменения перед запуском?", "Сохранить изменения перед проверкой?"), РежимДиалогаВопрос.ДаНет);
	Иначе ДействиеНаСервере(Действие); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПослеВопроса(Ответ, Действие) Экспорт
	ВопросОткрыт = Ложь;
	Если Ответ <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	Попытка ДействиеНаСервере("Сохранить"); Исключение ПоказатьПредупреждение(Неопределено, ОписаниеОшибки()); Возврат; КонецПопытки;
	ДействиеНаСервере(Действие);
КонецПроцедуры

&НаСервере
Функция РасписаниеДляДиалога()
	Расписание = ЗначениеИзСтрокиВнутр(РасписаниеСтрока);
	Возврат ?(Расписание = Неопределено, Новый РасписаниеРегламентногоЗадания, Расписание);
КонецФункции

&НаСервере
Процедура ПринятьРасписание(Расписание)
	РасписаниеСтрока = ЗначениеВСтрокуВнутр(Расписание);
	ПроверитьИзмененияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписание(Команда)
	Если НЕ ЗапускатьПоРасписанию Тогда Возврат; КонецЕсли;
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеДляДиалога());
	Диалог.Показать(Новый ОписаниеОповещения("РасписаниеПослеДиалога", ЭтаФорма, Ложь));
КонецПроцедуры

&НаСервере
Функция РасписаниеУжеЗадано()
	ОбработкаСервера = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаСервера.РасписаниеСервераЗаданоMCP(ЗначениеИзСтрокиВнутр(РасписаниеСтрока));
КонецФункции

&НаКлиенте
Процедура РасписаниеПриИзменении(Элемент)
	Элементы.КнопкаНастроитьРасписание.Доступность = ЗапускатьПоРасписанию;
	Если ЗапускатьПоРасписанию И НЕ РасписаниеУжеЗадано() Тогда
		Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеДляДиалога());
		Диалог.Показать(Новый ОписаниеОповещения("РасписаниеПослеДиалога", ЭтаФорма, Истина));
	Иначе ПроверитьИзмененияНаСервере(); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасписаниеПослеДиалога(Расписание, Включение) Экспорт
	Если Расписание = Неопределено Тогда
		Если Включение Тогда ЗапускатьПоРасписанию = Ложь; КонецЕсли;
		ПроверитьИзмененияНаСервере(); Возврат;
	КонецЕсли;
	ПринятьРасписание(Расписание);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьЖурналНаСервере(ИдРегистрацииЖурнала, Поток, Позиция)
	Если НЕ ЗначениеЗаполнено(ИдРегистрацииЖурнала) Тогда ВызватьИсключение "Не указана регистрация обработки."; КонецЕсли;
	СсылкаРегистрации = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдРегистрацииЖурнала));
	ОбработкаСервера = ЗарегистрированныйСерверПоСсылке(СсылкаРегистрации);
	Возврат ОбработкаСервера.СобытияСервераMCP(СсылкаРегистрации, Поток, Позиция);
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗакрытиеРазрешено = Ложь; ВопросОткрыт = Ложь; ОбновлениеВыполняется = Ложь;
	ОбновлениеАдресовВыполняется = Ложь;
	НомераОпераций = Новый Соответствие; СледующийНомерОперации = 1;
	ЗавершенныеНомераОпераций = Новый Массив;
	Попытка
		Курсор = ПрочитатьЖурналНаСервере(ИдРегистрации, "", 0); ПотокЖурнала = Курсор.stream_id; ПозицияЖурнала = Курсор.cursor;
	Исключение ОшибкаЧтенияЖурнала = Истина; ДобавитьСтрокуЖурнала("Не удалось подключиться к журналу событий."); КонецПопытки;
	ПодключитьОбработчикОжидания("ОбновитьЖурнал", 1);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЖурнал() Экспорт
	Если ОбновлениеВыполняется Или ЗакрытиеРазрешено Тогда Возврат; КонецЕсли;
	ОбновлениеВыполняется = Истина;
	Попытка
		Порция = ПрочитатьЖурналНаСервере(ИдРегистрации, ПотокЖурнала, ПозицияЖурнала);
		Если Порция.reset И ПотокЖурнала <> "empty" Тогда ДобавитьСтрокуЖурнала("Поток событий изменился."); КонецЕсли;
		Если Порция.lost > 0 Тогда ДобавитьСтрокуЖурнала("Пропущено событий: " + Строка(Порция.lost)); КонецЕсли;
		Для Каждого Событие Из Порция.items Цикл
			ДобавитьСтрокуЖурнала(ПредставлениеСобытияЖурнала(Событие));
		КонецЦикла;
		ПотокЖурнала = Порция.stream_id; ПозицияЖурнала = Порция.cursor; ОшибкаЧтенияЖурнала = Ложь;
		Если Порция.Свойство("active") И Порция.Свойство("retained") Тогда
			ОчиститьНеактивныеНомераЖурнала(Порция.active, Порция.retained);
		КонецЕсли;
	Исключение
		Если НЕ ОшибкаЧтенияЖурнала Тогда ДобавитьСтрокуЖурнала("Не удалось обновить журнал событий."); КонецЕсли;
		ОшибкаЧтенияЖурнала = Истина;
	КонецПопытки;
	ОбновлениеВыполняется = Ложь;
КонецПроцедуры

&НаКлиенте
Функция ПредставлениеСобытияЖурнала(Событие)
	НомерОперации = "";
	Если Событие.operation <> "" Тогда
		Ключ = Событие.instance + ":" + Событие.operation;
		Если НомераОпераций[Ключ] = Неопределено Тогда
			НомераОпераций.Вставить(Ключ, СледующийНомерОперации);
			СледующийНомерОперации = СледующийНомерОперации + 1;
		КонецЕсли;
		Номер = Формат(НомераОпераций[Ключ], "ЧГ=0");
		Пока СтрДлина(Номер) < 5 Цикл Номер = "0" + Номер; КонецЦикла;
		НомерОперации = " [" + Номер + "]";
		Если Событие.kind = "Результат отправлен" Или Событие.kind = "Ошибка отправки результата"
			Или Событие.kind = "Запрос отменён" Или Событие.kind = "Запрос завершён: истёк срок или потеряно соединение" Тогда
			Если ЗавершенныеНомераОпераций.Найти(Ключ) = Неопределено Тогда ЗавершенныеНомераОпераций.Добавить(Ключ); КонецЕсли;
			Пока ЗавершенныеНомераОпераций.Количество() > 1000 Цикл
				НомераОпераций.Удалить(ЗавершенныеНомераОпераций[0]);
				ЗавершенныеНомераОпераций.Удалить(0);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	ЗаголовокСобытия = ?(Событие.kind = "Результат отправлен", "Результат команды отправлен успешно", Событие.kind);
	ТекстСобытия = Формат(Событие.time, "ДФ=HH:mm:ss") + НомерОперации + " " + ЗаголовокСобытия
		+ ?((Событие.kind = "Получена команда" Или Событие.kind = "Начато выполнение")
			И Событие.tool <> "", ": " + Событие.tool, "");
	Если Событие.Свойство("details") И ЗначениеЗаполнено(Событие.details) Тогда
		ТекстСобытия = ТекстСобытия + Символы.ПС + Событие.details;
	КонецЕсли;
	Возврат ТекстСобытия;
КонецФункции

&НаКлиенте
Процедура ОчиститьНеактивныеНомераЖурнала(Активные, СохраненныеКлючи = Неопределено)
	Удаляемые = Новый Массив;
	Для Каждого Пара Из НомераОпераций Цикл
		Если СохраненныеКлючи <> Неопределено И СохраненныеКлючи.Найти(Пара.Ключ) <> Неопределено Тогда Продолжить; КонецЕсли;
		Если Активные.Найти(Пара.Ключ) = Неопределено И ЗавершенныеНомераОпераций.Найти(Пара.Ключ) = Неопределено Тогда
			Удаляемые.Добавить(Пара.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из Удаляемые Цикл НомераОпераций.Удалить(Ключ); КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуЖурнала(Текст)
	Если ПустаяСтрока(ЖурналСобытий) Тогда
		ЖурналСобытий = Текст;
	Иначе
		ЖурналСобытий = Текст + Символы.ПС + ЖурналСобытий;
	КонецЕсли;
	Если СтрДлина(ЖурналСобытий) > 70000 Тогда
		ЖурналСобытий = Лев(ЖурналСобытий, 70000);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы = Ложь, ТекстПредупреждения = Неопределено, СтандартнаяОбработка = Истина)
	Если ЗакрытиеРазрешено Или НЕ ЕстьИзменения Тогда Возврат; КонецЕсли;
	Отказ = Истина;
	// В старой модели вторым аргументом передаётся СтандартнаяОбработка,
	// а третьего аргумента нет. Признак завершения учитываем только в новой модели.
	Если ТекстПредупреждения <> Неопределено И ЗавершениеРаботы Тогда
		СтандартнаяОбработка = Ложь;
		ТекстПредупреждения = "Настройки MCP на сервере 1С не сохранены. При завершении работы изменения будут потеряны. Чтобы сохранить настройки, продолжите работу и нажмите «Сохранить настройки».";
		Возврат;
	КонецЕсли;
	Если ВопросОткрыт Тогда Возврат; КонецЕсли;
	ВопросОткрыт = Истина;
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗакрытьПослеВопроса", ЭтаФорма), "Сохранить изменения?", РежимДиалогаВопрос.ДаНетОтмена);
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт
	ВопросОткрыт = Ложь;
	Если Ответ = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Попытка ДействиеНаСервере("Сохранить"); Исключение ПоказатьПредупреждение(Неопределено, ОписаниеОшибки()); Возврат; КонецПопытки;
	КонецЕсли;
	ЗакрытиеРазрешено = Истина; Модифицированность = Ложь; Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ЗакрытиеРазрешено = Истина; ОтключитьОбработчикОжидания("ОбновитьЖурнал");
КонецПроцедуры
