&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Заголовок = "MCP Toolkit — MCP на сервере 1С";
	ЗаполнитьПодсказкиИнструментов();
	ПортСервера = 6003;
	АдресПривязки = "127.0.0.1";
	ТокенСервера = Строка(Новый УникальныйИдентификатор);
	ИдОткрытия = "";
	Если Параметры.Свойство("ИдРегистрации", ИдОткрытия) Тогда ИдРегистрации = ИдОткрытия; КонецЕсли;
	СсылкаРегистрации = Неопределено;
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", СсылкаРегистрации) И ЗначениеЗаполнено(СсылкаРегистрации) Тогда
		ИдРегистрации = Строка(СсылкаРегистрации.УникальныйИдентификатор());
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдРегистрации) Тогда
		ОбновитьНаСервере(Истина);
	Иначе
		Отказ = Истина; ВызватьИсключение "Откройте управление из зарегистрированной дополнительной обработки.";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодсказкиИнструментов()
	ОбработкаСервера = РеквизитФормыВЗначение("Объект");
	Элементы.ПолеИнструментExecuteQuery.Подсказка = ОбработкаСервера.ОписаниеToolExecuteQuery();
	Элементы.ПолеИнструментExecuteCode.Подсказка = ОбработкаСервера.ОписаниеToolExecuteCode();
	Элементы.ПолеИнструментGetMetadata.Подсказка = ОбработкаСервера.ОписаниеToolGetMetadata();
	Элементы.ПолеИнструментGetEventLog.Подсказка = ОбработкаСервера.ОписаниеToolGetEventLog();
	Элементы.ПолеИнструментGetObjectByLink.Подсказка = ОбработкаСервера.ОписаниеToolGetObjectByLink();
	Элементы.ПолеИнструментGetLinkOfObject.Подсказка = ОбработкаСервера.ОписаниеToolGetLinkOfObject();
	Элементы.ПолеИнструментFindReferences.Подсказка = ОбработкаСервера.ОписаниеToolFindReferencesToObject();
	Элементы.ПолеИнструментGetAccessRights.Подсказка = ОбработкаСервера.ОписаниеToolGetAccessRights();
	Элементы.ПолеИнструментGetBslSyntaxHelp.Подсказка = ОбработкаСервера.ОписаниеToolGetBslSyntaxHelp();
КонецПроцедуры

&НаСервере
Функция РегистрацияСервера()
	Если НЕ ЗначениеЗаполнено(ИдРегистрации) Тогда ВызватьИсключение "Не указана регистрация обработки."; КонецЕсли;
	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдРегистрации));
КонецФункции

&НаСервере
Функция ЗарегистрированныйСервер()
	СсылкаРегистрации = РегистрацияСервера();
	Возврат ЗарегистрированныйСерверПоСсылке(СсылкаРегистрации);
КонецФункции

&НаСервереБезКонтекста
Функция ЗарегистрированныйСерверПоСсылке(СсылкаРегистрации)
	ИмяОбработки = "";
	// Отсутствие БСП не мешает компиляции и обычному клиентскому режиму обработки.
	Выполнить("ИмяОбработки = ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(СсылкаРегистрации);");
	Если НЕ ЗначениеЗаполнено(ИмяОбработки) Тогда ВызватьИсключение "Не удалось подключить зарегистрированную обработку."; КонецЕсли;
	ОбработкаСервера = ВнешниеОбработки.Создать(ИмяОбработки);
	Если ОбработкаСервера.Метаданные().Имя <> "MCPToolkit" Тогда ВызватьИсключение "Выбрана другая обработка."; КонецЕсли;
	Возврат ОбработкаСервера;
КонецФункции

&НаСервере
Процедура ЗагрузитьПоляПрофиля(ОбработкаСервера, Настройки)
	РежимПодключенияКомпонент = ОбработкаСервера.РежимПодключенияКомпонентСервераMCP(Настройки);
	НастройкиПрофиляJSON = ОбработкаСервера.ЗаписатьJSON2(Настройки);
	РежимПодключения = ?(Настройки.transport = "proxy", 0, 1);
	АдресПрокси = "http://127.0.0.1:6003";
	КаналПрокси = "default";
	Если Настройки.Свойство("proxy_url") Тогда АдресПрокси = Настройки.proxy_url; КонецЕсли;
	Если Настройки.Свойство("proxy_channel") Тогда КаналПрокси = Настройки.proxy_channel; КонецЕсли;
	ОбновитьПоляТранспорта();
	ПараллельноеВыполнение = Настройки.parallel;
	ДобавлятьИнформациюОБазе = Ложь;
	ДеанонимизацияЧерезAPI = Ложь;
	Если Настройки.Свойство("deanonymization_api_enabled") Тогда ДеанонимизацияЧерезAPI = Настройки.deanonymization_api_enabled = Истина; КонецЕсли;
	Если Настройки.Свойство("include_infobase") Тогда ДобавлятьИнформациюОБазе = Настройки.include_infobase; КонецЕсли;
	Анонимизация = Настройки.anonymization;
	АгрессивнаяАнонимизация = Настройки.aggressive;
	ФорматОтвета = Настройки.format;
	РазрешитьЗапись = Настройки.allow_write;
	РазрешитьПривилегированный = Настройки.allow_privileged;
	ИнструментВключен_ExecuteQuery = Настройки.tools.Найти("execute_query") <> Неопределено;
	ИнструментВключен_ExecuteCode = Настройки.tools.Найти("execute_code") <> Неопределено;
	ИнструментВключен_GetMetadata = Настройки.tools.Найти("get_metadata") <> Неопределено;
	ИнструментВключен_GetEventLog = Настройки.tools.Найти("get_event_log") <> Неопределено;
	ИнструментВключен_GetObjectByLink = Настройки.tools.Найти("get_object_by_link") <> Неопределено;
	ИнструментВключен_GetLinkOfObject = Настройки.tools.Найти("get_link_of_object") <> Неопределено;
	ИнструментВключен_FindReferences = Настройки.tools.Найти("find_references_to_object") <> Неопределено;
	ИнструментВключен_GetAccessRights = Настройки.tools.Найти("get_access_rights") <> Неопределено;
	ИнструментВключен_GetBslSyntaxHelp = Настройки.tools.Найти("get_bsl_syntax_help") <> Неопределено;
КонецПроцедуры

&НаСервере
Функция РазделитьСтрокуПоРазделителюФормы(Текст)
	ОбработкаСервера = РеквизитФормыВЗначение("Объект");
	// JSON-парсер проекта доступен и в старых режимах совместимости.
	Возврат ОбработкаСервера.ПрочитатьJSON2("[""" + СтрЗаменить(Текст, ",", """,""") + """]");
КонецФункции

&НаСервере
Процедура ОбновитьНаСервере(ЗагрузитьПрофиль)
	ОбработкаСервера = ЗарегистрированныйСервер();
	Состояние = ОбработкаСервера.СостояниеСервераMCP(РегистрацияСервера());
	Расписание = ОбработкаСервера.РасписаниеСервераMCP(РегистрацияСервера());
	ЗагруженнаяРегистрация = ИдРегистрации;
	Если ЗагрузитьПрофиль Тогда
		ПрофильСохранен = Состояние <> Неопределено; ПоколениеПрофиля = 0;
		Если ПрофильСохранен Тогда
			ПоколениеПрофиля = Состояние.settings_revision; ПортСервера = Состояние.port;
			АдресПривязки = Состояние.bind; ТокенСервера = Состояние.token; Настройки = Состояние.settings;
		Иначе Настройки = ОбработкаСервера.НастройкиСервераMCPПоУмолчанию(); КонецЕсли;
		ЗагрузитьПоляПрофиля(ОбработкаСервера, Настройки);
		ЗаполнитьСписокАдресовСервера(Новый Массив);
		СнимокАдресовСервераJSON = "";
		ОбновитьПодсказкуАдресаСервера();
		ЗапускатьПоРасписанию = Расписание.enabled; РасписаниеСтрока = ЗначениеВСтрокуВнутр(Расписание.schedule);
		СнимокРасписания = Расписание.snapshot;
		ИсходныйПрофиль = ЗначениеВСтрокуВнутр(СобратьПрофильФормы());
		ИсходноеРасписание = ЗначениеВСтрокуВнутр(Новый Структура("enabled,schedule", ЗапускатьПоРасписанию, РасписаниеСтрока));
		ЕстьИзменения = Ложь; Модифицированность = Ложь;
	КонецЕсли;
	Если Состояние = Неопределено Тогда
		СтатусСервера = "Состояние: Остановлен" + Символы.ПС + "Настройки ещё не сохранены.";
	Иначе
		ЭкземплярСервера = Состояние.instance; ПоколениеЭкземпляра = Состояние.epoch;
		Названия = Новый Структура("starting,running,draining,stopped,failed", "Запускается", "Работает", "Останавливается", "Остановлен", "Ошибка");
		ИмяСостояния = "Не определено"; Названия.Свойство(Состояние.state, ИмяСостояния);
		Если НЕ Состояние.desired И (Состояние.state = "running" Или Состояние.state = "starting") Тогда ИмяСостояния = "Останавливается"; КонецЕсли;
		Задание = Неопределено; ОшибкаЗадания = "";
		Если ЗначениеЗаполнено(Состояние.job_id) Тогда
			Попытка Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Состояние.job_id)); Исключение КонецПопытки;
			Если Задание = Неопределено Тогда ИмяСостояния = "Не определено"; ОшибкаЗадания = "Не удалось определить состояние фонового задания"; КонецЕсли;
		КонецЕсли;
		Пользователь = "Не удалось определить пользователя";
		Если Состояние.user_id = "" Тогда
			Пользователь = "Не указан";
		Иначе
			Попытка
				ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Состояние.user_id));
				Если ПользовательИБ <> Неопределено Тогда Пользователь = ПользовательИБ.Имя; КонецЕсли;
			Исключение КонецПопытки;
		КонецЕсли;
		СтатусСервера = "Состояние: " + ИмяСостояния + Символы.ПС + "Пользователь исполнения: " + Пользователь;
		Если Задание <> Неопределено И ЗначениеЗаполнено(Задание.Наименование) Тогда СтатусСервера = СтатусСервера + Символы.ПС + "Задание: " + Задание.Наименование; КонецЕсли;
		Если ОшибкаЗадания <> "" Тогда СтатусСервера = СтатусСервера + Символы.ПС + ОшибкаЗадания; КонецЕсли;
		Если Состояние.settings.transport = "proxy" Тогда
			СтатусСервера = СтатусСервера + Символы.ПС + "Прокси: " + Состояние.settings.proxy_url + "; канал: " + Состояние.settings.proxy_channel;
		Иначе
			СтатусСервера = СтатусСервера + Символы.ПС + "Адрес: http://" + Состояние.bind + ":" + Формат(Состояние.port, "ЧГ=0") + "/mcp";
		КонецЕсли;
		Если Состояние.error <> "" Тогда СтатусСервера = СтатусСервера + Символы.ПС + "Ошибка: " + Состояние.error; КонецЕсли;
		Если Состояние.Свойство("last_start_failure") Тогда
			СтатусСервера = СтатусСервера + Символы.ПС + "Последний запуск отклонён: " + Состояние.last_start_failure.error;
		КонецЕсли;
		Если Состояние.Свойство("syntax_help_status") Тогда
			СтатусСервера = СтатусСервера + Символы.ПС + "Справка BSL: " + Состояние.syntax_help_status;
			Если Состояние.Свойство("syntax_help_error") И Состояние.syntax_help_error <> "" Тогда
				СтатусСервера = СтатусСервера + Символы.ПС + "Ошибка справки: " + Состояние.syntax_help_error;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ОбновитьПредставленияНастроек();
КонецПроцедуры

&НаСервере
Процедура ДействиеНаСервере(Действие)
	Если ИдРегистрации <> ЗагруженнаяРегистрация Тогда ВызватьИсключение "Регистрация изменена. Откройте форму заново."; КонецЕсли;
	ОбработкаСервера = ЗарегистрированныйСервер(); СсылкаРегистрации = РегистрацияСервера();
	Если Действие = "Сохранить" Тогда
		Профиль = СобратьПрофильФормы();
		Расписание = Новый Структура("enabled,schedule", ЗапускатьПоРасписанию, ЗначениеИзСтрокиВнутр(РасписаниеСтрока));
		ИзмененПрофиль = НЕ ПрофильСохранен Или ИсходныйПрофиль <> ЗначениеВСтрокуВнутр(Профиль);
		ИзмененоРасписание = ИсходноеРасписание <> ЗначениеВСтрокуВнутр(Новый Структура("enabled,schedule", ЗапускатьПоРасписанию, РасписаниеСтрока));
		ОбработкаСервера.СохранитьНастройкиФормыСервераMCP(СсылкаРегистрации, Профиль, Расписание, СнимокРасписания, ИзмененПрофиль, ИзмененоРасписание, ПоколениеПрофиля);
	ИначеЕсли Действие = "Подготовить" Тогда
		ЖурналСобытий = ЖурналСобытий + Символы.ПС + ОбработкаСервера.ПодготовитьСерверMCP(СсылкаРегистрации);
		Пока СтрЧислоСтрок(ЖурналСобытий) > 500 Цикл ЖурналСобытий = Сред(ЖурналСобытий, Найти(ЖурналСобытий, Символы.ПС) + 1); КонецЦикла;
	ИначеЕсли Действие = "Запустить" Тогда
		ОбработкаСервера.ЗапуститьСерверMCP(СсылкаРегистрации);
	ИначеЕсли Действие = "Остановить" Тогда
		ОбработкаСервера.ОстановитьСерверMCP(СсылкаРегистрации, ЭкземплярСервера, ПоколениеЭкземпляра);
	КонецЕсли;
	ОбновитьНаСервере(Действие = "Сохранить");
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	Попытка ДействиеНаСервере("Сохранить"); Исключение ПоказатьПредупреждение(Неопределено, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Подготовить(Команда)
	ДействиеПослеСохранения("Подготовить");
КонецПроцедуры

&НаКлиенте
Процедура Запустить(Команда)
	ДействиеПослеСохранения("Запустить");
КонецПроцедуры

&НаКлиенте
Процедура Остановить(Команда)
	ДействиеНаСервере("Остановить");
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьЖурнал(Команда)
	ЖурналСобытий = "";
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере(Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокСетевыхАдресовСервера(Адреса, ТекущийАдрес)
	Список = Новый СписокЗначений;
	Список.Добавить("0.0.0.0", "0.0.0.0 — все интерфейсы");
	Список.Добавить("127.0.0.1", "127.0.0.1 — только локально");
	Упорядоченные = Новый ТаблицаЗначений;
	Упорядоченные.Колонки.Добавить("Имя"); Упорядоченные.Колонки.Добавить("Адрес");
	Для Каждого Адрес Из Адреса Цикл
		СтрокаАдреса = Упорядоченные.Добавить();
		СтрокаАдреса.Имя = Адрес.displayName; СтрокаАдреса.Адрес = Адрес.address;
	КонецЦикла;
	Упорядоченные.Сортировать("Имя, Адрес");
	Для Каждого СтрокаАдреса Из Упорядоченные Цикл
		Если Список.НайтиПоЗначению(СтрокаАдреса.Адрес) <> Неопределено Тогда Продолжить; КонецЕсли;
		ПредставлениеАдреса = СтрокаАдреса.Адрес + ?(ПустаяСтрока(СтрокаАдреса.Имя), "", " (" + СтрокаАдреса.Имя + ")");
		Список.Добавить(СтрокаАдреса.Адрес, ПредставлениеАдреса);
	КонецЦикла;
	Если ТекущийАдрес <> "" И Список.НайтиПоЗначению(ТекущийАдрес) = Неопределено Тогда
		Список.Добавить(ТекущийАдрес, ТекущийАдрес);
	КонецЕсли;
	Возврат Список;
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокАдресовСервера(Адреса)
	ТекущийАдрес = АдресПривязки;
	Список = СписокСетевыхАдресовСервера(Адреса, ТекущийАдрес);
	Элементы.ПолеАдресПривязки.СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из Список Цикл
		Элементы.ПолеАдресПривязки.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	АдресПривязки = ТекущийАдрес;
КонецПроцедуры

&НаСервере
Функция ОбновитьАдресаСервераНаСервере()
	Если РежимПодключения = 0 Тогда Возврат ""; КонецЕсли;
	Ответ = Новый Структура("success,server_name,addresses,error", Ложь, "", Новый Массив, "");
	Попытка
		ОбработкаСервера = ЗарегистрированныйСервер();
		Ответ = ОбработкаСервера.ПолучитьСетевыеАдресаСервераMCP(РегистрацияСервера(), РежимПодключенияКомпонент);
	Исключение
		Ответ.error = ОписаниеОшибки();
	КонецПопытки;
	ЗаполнитьСписокАдресовСервера(Ответ.addresses);
	ОбработкаФормы = РеквизитФормыВЗначение("Объект");
	СнимокАдресовСервераJSON = ОбработкаФормы.ЗаписатьJSON2(Ответ);
	ОбновитьПодсказкуАдресаСервера();
	Возврат Ответ.error;
КонецФункции

&НаСервереБезКонтекста
Функция ПодсказкаСетевыхАдресовСервера(Ответ, ТекущийАдрес)
	ПодсказкаАдреса = "Адрес прослушивания встроенного MCP-сервера.";
	Если Ответ = Неопределено Тогда
		Возврат ПодсказкаАдреса + " Нажмите «Обновить», чтобы получить адреса сетевых адаптеров сервера 1С.";
	КонецЕсли;
	Если Ответ.success Тогда
		ПодсказкаАдреса = ПодсказкаАдреса + Символы.ПС + "Список получен с сервера 1С: " + Ответ.server_name
			+ ". Фоновое задание может выполняться на другом сервере.";
		Если ТекущийАдрес <> "0.0.0.0" И ТекущийАдрес <> "127.0.0.1" И ТекущийАдрес <> "" Тогда
			АдресНайден = Ложь;
			Для Каждого Адрес Из Ответ.addresses Цикл
				Если Адрес.address = ТекущийАдрес Тогда АдресНайден = Истина; Прервать; КонецЕсли;
			КонецЦикла;
			Если НЕ АдресНайден Тогда ПодсказкаАдреса = ПодсказкаАдреса + Символы.ПС + "Адрес отсутствует в полученном списке."; КонецЕсли;
		КонецЕсли;
	Иначе
		ПодсказкаАдреса = ПодсказкаАдреса + Символы.ПС + "Список адресов не получен. Можно ввести адрес вручную или повторить обновление.";
	КонецЕсли;
	Возврат ПодсказкаАдреса;
КонецФункции

&НаСервере
Процедура ОбновитьПодсказкуАдресаСервера()
	Ответ = Неопределено;
	Если СнимокАдресовСервераJSON <> "" Тогда
		ОбработкаФормы = РеквизитФормыВЗначение("Объект");
		Ответ = ОбработкаФормы.ПрочитатьJSON2(СнимокАдресовСервераJSON);
	КонецЕсли;
	Элементы.ПолеАдресПривязки.Подсказка = ПодсказкаСетевыхАдресовСервера(Ответ, АдресПривязки);
КонецПроцедуры

&НаСервере
Процедура АдресПривязкиПриИзмененииНаСервере()
	ПроверитьИзмененияНаСервере();
	ОбновитьПодсказкуАдресаСервера();
КонецПроцедуры

&НаКлиенте
Процедура АдресПривязкиПриИзменении(Элемент)
	АдресПривязкиПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьАдресаСервера(Команда)
	Если ОбновлениеАдресовВыполняется Или РежимПодключения = 0 Тогда Возврат; КонецЕсли;
	ОбновлениеАдресовВыполняется = Истина;
	ОшибкаОбновления = "";
	Попытка ОшибкаОбновления = ОбновитьАдресаСервераНаСервере();
	Исключение ОшибкаОбновления = ОписаниеОшибки(); КонецПопытки;
	ОбновлениеАдресовВыполняется = Ложь;
	Если ОшибкаОбновления <> "" Тогда
		ДобавитьСтрокуЖурнала(Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + " Не удалось получить список адресов сервера 1С: " + ОшибкаОбновления);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	Если ЕстьИзменения Тогда
		Если ВопросОткрыт Тогда Возврат; КонецЕсли;
		ВопросОткрыт = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПеречитатьПослеВопроса", ЭтаФорма), "Перечитать настройки? Несохранённые изменения будут потеряны.", РежимДиалогаВопрос.ДаНет);
	Иначе ОбновитьНаСервере(Истина); КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура КопироватьПравилаНаСервере()
	Клиент = КлиентскиеНастройкиАнонимизации();
	ОбработкаСервера = РеквизитФормыВЗначение("Объект");
	Настройки = ОбработкаСервера.ПрочитатьJSON2(НастройкиПрофиляJSON);
	Настройки.exact_rules = Клиент.exact_rules; Настройки.regex_rules = Клиент.regex_rules;
	НастройкиПрофиляJSON = ОбработкаСервера.ЗаписатьJSON2(Настройки);
	ПроверитьИзмененияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КопироватьПравила(Команда)
	КопироватьПравилаНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьПоляТранспортаНаФорме(Форма)
	Форма.Элементы.ГруппаПрокси.Видимость = Форма.РежимПодключения = 0;
	Форма.Элементы.ГруппаВстроенногоСервера.Видимость = Форма.РежимПодключения <> 0;
	Форма.Элементы.ГруппаАнонимизации.Видимость = Форма.РежимПодключения <> 0;
	Форма.Элементы.ГруппаФормата.Видимость = Форма.РежимПодключения <> 0;
	Форма.Элементы.ГруппаИнструментов.Видимость = Форма.РежимПодключения <> 0;
	Если Форма.РежимПодключения = 0 Тогда
		Форма.Команды.Запустить.Подсказка = "Запустить фоновое задание на сервере 1С и подключить его к прокси с сохранёнными настройками.";
		Форма.Команды.Остановить.Подсказка = "Отключить обработку от прокси и остановить её фоновое задание на сервере 1С.";
	Иначе
		Форма.Команды.Запустить.Подсказка = "Запустить встроенный MCP-сервер в фоновом задании на сервере 1С с сохранёнными настройками.";
		Форма.Команды.Остановить.Подсказка = "Остановить встроенный MCP-сервер и его фоновое задание на сервере 1С.";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоляТранспорта()
	ОбновитьПоляТранспортаНаФорме(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СгенерироватьКанал(Команда)
	КаналПрокси = Строка(Новый УникальныйИдентификатор());
	НастройкаПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
