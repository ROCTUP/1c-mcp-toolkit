// kind: code
// expect: safe
З = Новый Запрос;
З.Текст =
"ВЫБРАТЬ
|    Реализация.Ссылка КАК Объект,
|    Реализация.Номер КАК Номер,
|    Реализация.Контрагент КАК Контрагент
|ИЗ
|    Документ.Реализация КАК Реализация
|ГДЕ
|    Реализация.Дата >= &П";
З.УстановитьПараметр("П", Дата(2020, 1, 1));
Таблица = З.Выполнить().Выгрузить();
Результат = Новый Массив;
Для Каждого Строка Из Таблица Цикл
    Результат.Добавить(Новый Структура("Номер, Контрагент", Строка.Номер, Строка.Контрагент));
КонецЦикла;
