// kind: code
// expect: safe
З = Новый Запрос;
З.Текст =
"ВЫБРАТЬ
|    Реализация.Ссылка КАК Объект,
|    Реализация.Номер КАК Номер,
|    Реализация.Контрагент КАК Контрагент
|ИЗ
|    Документ.Реализация КАК Реализация
|ГДЕ
|    Реализация.Дата >= &П";
З.УстановитьПараметр("П", Дата(2020, 1, 1));
Выборка = З.Выполнить().Выбрать();
Данные = Новый Массив;
Пока Выборка.Следующий() Цикл
    Строка = Новый Структура;
    Строка.Вставить("Объект", Выборка.Объект);
    Строка.Вставить("Контрагент", Выборка.Контрагент);
    Данные.Добавить(Строка);
КонецЦикла;
Результат = Данные;
