// kind: query
// expect: safe
ВЫБРАТЬ
	КОЛИЧЕСТВО(*) КАК ПарСДублями,
	ЕСТЬNULL(СУММА(ПоПарам.Строк - 1), 0) КАК ЛишнихСтрок
ИЗ
	(ВЫБРАТЬ
		НеотправленныеСтроки.Владелец КАК Владелец,
		НеотправленныеСтроки.ИмяТипа КАК ИмяТипа,
		КОЛИЧЕСТВО(*) КАК Строк
	ИЗ
		(ВЫБРАТЬ
			ОчередьОтправки.ВладелецОбъекта КАК Владелец,
			ВЫРАЗИТЬ(ОчередьОтправки.ИмяТипаОбъекта КАК СТРОКА(150)) КАК ИмяТипа
		ИЗ
			РегистрСведений.ОчередьОтправки КАК ОчередьОтправки
				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьОтправкиОтправленные КАК ОчередьОтправкиОтправленные
				ПО ОчередьОтправки.ИдентификаторПопытки = ОчередьОтправкиОтправленные.ИдентификаторПопытки
		ГДЕ
			ОчередьОтправки.ДатаОбъекта = ДАТАВРЕМЯ(2026,7,1)
			И ОчередьОтправкиОтправленные.ИдентификаторПопытки ЕСТЬ NULL
			И НЕ ВЫРАЗИТЬ(ОчередьОтправки.ИмяТипаОбъекта КАК СТРОКА(150)) ПОДОБНО "Документ.%"
			И НЕ ОчередьОтправки.ВладелецОбъекта ЕСТЬ NULL) КАК НеотправленныеСтроки
	СГРУППИРОВАТЬ ПО
		НеотправленныеСтроки.Владелец,
		НеотправленныеСтроки.ИмяТипа
	ИМЕЮЩИЕ
		КОЛИЧЕСТВО(*) > 1) КАК ПоПарам
