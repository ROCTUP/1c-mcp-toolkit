// kind: query
// expect: safe
ВЫБРАТЬ
	КОЛИЧЕСТВО(*) КАК СтрокЧужихРегистров
ИЗ
	РегистрСведений.ОчередьОтправки КАК ОчередьОтправки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьОтправкиОтправленные КАК ОчередьОтправкиОтправленные
		ПО ОчередьОтправки.ИдентификаторПопытки = ОчередьОтправкиОтправленные.ИдентификаторПопытки
ГДЕ
	ОчередьОтправки.ДатаОбъекта = ДАТАВРЕМЯ(2026,7,1)
	И ОчередьОтправкиОтправленные.ИдентификаторПопытки ЕСТЬ NULL
	И НЕ ВЫРАЗИТЬ(ОчередьОтправки.ИмяТипаОбъекта КАК СТРОКА(150)) ПОДОБНО "Документ.%"
	И НЕ ОчередьОтправки.ВладелецОбъекта ЕСТЬ NULL
	И НЕ ВЫРАЗИТЬ(ОчередьОтправки.ИмяТипаОбъекта КАК СТРОКА(150)) В ("РегистрБухгалтерии.Хозрасчетный", "РегистрНакопления.НДСПредъявленный", "РегистрНакопления.НДСЗаписиКнигиПокупок", "РегистрНакопления.НДСЗаписиКнигиПродаж", "РегистрНакопления.ЖурналУчетаСчетовФактур")
